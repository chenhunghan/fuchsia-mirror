# We need to bundle images with our test to run on CQ but GN doesn't support
# wildcards. The workaround is to regenerate a gni file containing all images
# whenever `fx fxfs create_golden` is run.
import("images.gni")

generated_file("golden_image_manifest_gen") {
  visibility = [ ":*" ]
  output_conversion = "json"
  contents = fxfs_golden_images
  outputs = [ "$target_gen_dir/golden_image_manifest.json" ]
}

