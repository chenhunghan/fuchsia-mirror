import("//build/tools/bazel2gn/bazel_migration.gni")

resource("golden_images") {
  sources = fxfs_golden_images
  outputs = [ "data/fxfs_golden_images/{{source_file_part}}" ]
  visibility = [
    ":*",
    "//src/storage/fxfs/tools:*",
  ]
}

resource("golden_image_manifest") {
  sources = [ "$target_gen_dir/golden_image_manifest.json" ]
  outputs = [ "data/fxfs_golden_images/{{source_file_part}}" ]
  visibility = [
    ":*",
    "//src/storage/fxfs/tools:*",
  ]
  deps = [ ":golden_image_manifest_gen" ]
}
