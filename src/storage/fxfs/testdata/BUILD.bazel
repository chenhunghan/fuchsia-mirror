load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//build/bazel/rules/packages:resources.bzl", "resource")
load(":images.bzl", fxfs_golden_images = "FXFS_GOLDEN_IMAGES")

package(default_applicable_licenses = ["//:license"])

# We need to bundle images with our test to run on CQ but GN doesn't support
# wildcards and Fuchsia's Bazel style forbids `glob()`. The workaround is to
# regenerate `images.gni` (for GN) and `images.bzl` (for Bazel) whenever
# `fx fxfs create_golden` is run.

resource(
    name = "golden_images",
    srcs = fxfs_golden_images,
    outputs = ["data/fxfs_golden_images/{{source_file_part}}"],
    visibility = ["//src/storage/fxfs/tools:__pkg__"],
)

# GN keeps `generated_file("golden_image_manifest_gen")` above the sentinel
# because `bazel2gn` does not convert `write_file()`.
# @bazel2gn:skip
write_file(
    name = "golden_image_manifest_gen",
    out = "golden_image_manifest.json",
    content = [json.encode(fxfs_golden_images)],
)

resource(
    name = "golden_image_manifest",
    srcs = [
        # TODO(https://fxbug.dev/584478079): GN produces the manifest via
        # `generated_file("golden_image_manifest_gen")` in `$target_gen_dir`.
        "golden_image_manifest.json",  # @bazel2gn:path_overwrite:$target_gen_dir/golden_image_manifest.json
    ],
    outputs = ["data/fxfs_golden_images/{{source_file_part}}"],
    visibility = ["//src/storage/fxfs/tools:__pkg__"],
    deps = [":golden_image_manifest_gen"],
)
