import("//build/components.gni")

# Kept in BUILD.gn because GN test packages (such as under //src/starnix/tests)
# still depend on :test-fxfs-package via subpackages.
fuchsia_package("test-fxfs-package") {
  package_name = "test-fxfs"
  deps = [
    ":test-fxfs",
    "//src/storage/crypt/fxfs",
  ]
  testonly = true
}

