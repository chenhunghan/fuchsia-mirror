    name = "fxfs_manifest",
    component_name = "fxfs",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
        "//sdk/lib/trace:client.shard",
    ],
    manifest = "meta/fxfs.cml",
)

fuchsia_structured_config_rust_lib(
    name = "fxfs_config",
    cm_label = ":fxfs_manifest",
)

# As this is a large binary that uses many resources to compile (and takes
# minutes when LTO is enabled, shift it to the large RBE worker pool)
# @bazel2gn:raw_attribute:_concurrent_jobs = concurrent_jobs.link_highmem
# @bazel2gn:raw_attribute:configs += _concurrent_jobs.configs
# @bazel2gn:raw_attribute:forward_variables_from(_concurrent_jobs.vars, "*")
rustc_binary(
    name = "fxfs",
    srcs = ["src/main.rs"],
    build_flags = ["//build/config/rust:bootfs"],
    edition = "2024",
    # Fxfs depends on the vfs rlib instead of the dylib for performance. If any
    # dependency of fxfs depends on the vfs dylib then all of the vfs'
    # dependencies will be dynamically linked in fxfs which degrades performance.
    tags = [
        "assert_no_deps=//src/storage/lib/vfs/rust:vfs",
        "manual",
    ],
    visibility = ["//:__subpackages__"],
    deps = [
        ":fxfs_config",
        ":lib",
        "//sdk/rust/zx",
        "//src/lib/diagnostics/inspect/runtime/rust",
        "//src/lib/diagnostics/inspect/rust:fuchsia-inspect",  # @bazel2gn:path_overwrite://src/lib/diagnostics/inspect/rust
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-runtime",
        "//src/lib/trace/rust:trace-provider",
        "//src/storage/fxfs/platform",
        "//third_party/rust_crates/vendor:anyhow",
    ],
)

fx_packaged_binary(
    name = "fxfs_packaged_bin",
    binary = ":fxfs",
    binary_name = "fxfs",
)

fx_component(
    name = "fxfs_component",
    compiled_manifest = ":fxfs_manifest",
    visibility = ["//:__subpackages__"],
    deps = [":fxfs_packaged_bin"],
)
