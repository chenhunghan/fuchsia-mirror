load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [
        ":blob-metadata-tests",
    ],
    visibility = ["//src/storage:__pkg__"],
)

rustc_library(
    name = "blob_metadata",
    srcs = [
        "src/lib.rs",
        "src/zerocopy_serialization.rs",
    ],
    edition = "2024",
    proc_macro_deps = [
        "//src/storage/fxfs:fxfs_macros",
    ],
    visibility = [
        "//src/storage/fxfs:__pkg__",
        "//src/storage/lib:__subpackages__",
    ],
    with_unit_tests = True,
    deps = [
        "//src/storage/lib/delivery_blob",
        "//src/storage/type-fprint:fprint",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:static_assertions",
        "//third_party/rust_crates/vendor:zerocopy",
    ],
)

fx_unittest_package(
    name = "blob-metadata-tests",
    unit_tests = [":blob_metadata_test"],
)
