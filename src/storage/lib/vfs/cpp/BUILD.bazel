fx_cc_library(
    name = "test_support",
    testonly = True,
    hdrs = ["tests/dir_test_util.h"],
    visibility = [
        ":__pkg__",
    ],
    deps = [
        ":cpp",
        "@com_google_googletest//:gtest",
    ],
    alwayslink = True,
)

fx_cc_test_binary(
    name = "fs-vnode-test",
    srcs = [
        "tests/lazy_dir_tests.cc",
        "tests/pseudo_dir_tests.cc",
        "tests/pseudo_file_tests.cc",
        "tests/remote_dir_tests.cc",
        "tests/service_tests.cc",
        "tests/teardown_tests.cc",
        "tests/vfs_tests.cc",
        "tests/vmo_file_tests.cc",
        "tests/watcher_test.cc",
    ],
    aspect_hints = [":death_test"],
    # tests/dir_test_util.h uses `#include <src/storage/lib/vfs/cpp/vfs_types.h>`
    # relative to workspace root; GN adds `-I.` via default_include_dirs.
    # @bazel2gn:skip
    copts = ["-I."],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        ":cpp",
        ":test_support",
        "//sdk/fidl/fuchsia.io:fuchsia.io_cpp",
        "//sdk/fidl/fuchsia.io:fuchsia.io_cpp_testing",
        "//sdk/lib/async:async-cpp",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        "//sdk/lib/async-testing",
        "//sdk/lib/fdio",
        "//sdk/lib/fidl",
        "//src/lib/fxl/test:gtest_main",
        "//zircon/system/ulib/fbl",
        "//zircon/system/ulib/sync:sync-cpp",
        "//zircon/system/ulib/zx",
        # @com_google_googletest//:gtest bundles GoogleMock.
        "@com_google_googletest//:gtest",  # @bazel2gn:path_overwrite://third_party/googletest:gmock
    ],
)

expect_includes(
    name = "death_test",
    includes = ["//src/sys/test_runners/gtest:death_test.shard.cml"],
)

fx_cc_test_binary(
