load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":name-unittests"],
    visibility = ["//src/storage:__pkg__"],
)

rustc_library(
    name = "name",
    srcs = [
        "src/lib.rs",
        "src/repr.rs",
    ],
    edition = "2024",
    visibility = [
        "//src/storage/lib/vfs/rust:__pkg__",
        "//src/sys/lib/cm_types:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust_common",
        "//sdk/rust/zx-status",
        "//third_party/rust_crates/vendor:memchr",
        "//third_party/rust_crates/vendor:static_assertions",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

rustc_test(
    name = "name_test",
    crate = ":name",
    tags = ["manual"],
    deps = [
        "//third_party/rust_crates/vendor:assert_matches",
    ],
)

fx_unittest_package(
    name = "name-unittests",
    unit_tests = [":name_test"],
)
