load("//build/bazel/rules/components:cml_shard.bzl", "cml_shard")
load("//build/bazel/rules/components:expect_includes.bzl", "expect_includes")

package(default_applicable_licenses = ["//:license"])

exports_files(
    ["client.shard.cml"],
    visibility = [
        "//bundles/assembly:__subpackages__",
        "//src/storage/benchmarks/fuchsia/pkgdir-component:__pkg__",
        "//src/storage/fvm:__pkg__",
        "//src/storage/fxfs/test:__pkg__",
        "//src/sys/pkg/bin/system-updater:__pkg__",
        "//src/sys/pkg/lib/package-directory:__pkg__",
        "//src/sys/pkg/tests/pkgdir/test_realm_proxy:__pkg__",
        "//src/sys/pkg/tests/system-update-checker:__pkg__",
        "//vendor/google:__subpackages__",
    ],
)

cml_shard(
    name = "client.shard",
    includes = ["//sdk/lib/syslog:client.shard"],
    shard = "client.shard.cml",
    visibility = ["//:__subpackages__"],
)

expect_includes(
    name = "fs_management_shard",
    includes = [":client.shard"],
    visibility = [
        "//src/storage/blobfs/bin:__pkg__",
        "//src/storage/fs_test:__pkg__",
        "//src/storage/fvm:__pkg__",
        "//src/storage/gpt/component:__pkg__",
        "//src/storage/minfs/bin:__pkg__",
    ],
)
