load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "wrap_host_rust_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":fsverity-merkle-tests"],
    visibility = ["//src/storage:__pkg__"],
)

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [":fsverity-merkle_host_test"],
    visibility = ["//src/storage:__pkg__"],
)

rustc_library(
    name = "fsverity-merkle",
    srcs = [
        "src/builder.rs",
        "src/lib.rs",
        "src/tree.rs",
        "src/util.rs",
        "src/verifier.rs",
    ],
    edition = "2024",
    visibility = [
        "//sdk/lib/zxio/tests:__pkg__",
        "//src/storage/f2fs_reader:__pkg__",
        "//src/storage/fxfs:__subpackages__",
        "//src/storage/lib/dm_verity:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust_common",
        "//sdk/rust/zx-status",
        "//src/lib/mundane",
        "//src/storage/lib/ptr_slice",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:zerocopy",
    ],
)

rustc_test(
    name = "fsverity-merkle_test",
    crate = ":fsverity-merkle",
    tags = ["manual"],
    deps = [
        "//third_party/rust_crates/vendor:hex",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

wrap_host_rust_test(
    name = "fsverity-merkle_host_test",
    binary_name = "fsverity-merkle_test",
)

fx_unittest_package(
    name = "fsverity-merkle-tests",
    unit_tests = [":fsverity-merkle_test"],
)
