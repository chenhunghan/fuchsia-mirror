load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "block_matcher",
    srcs = ["src/lib.rs"],
    edition = "2024",
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = [
        "//src/storage/benchmarks/fuchsia:__pkg__",
        "//src/storage/blackout/target/lib:__pkg__",
        "//src/storage/fshost/integration:__pkg__",
        "//src/storage/fxfs/test:__pkg__",
        "//src/storage/stress-tests/utils:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_rust",
        "//sdk/fidl/fuchsia.storage.partitions:fuchsia.storage.partitions_rust",
        "//sdk/rust/zx",
        "//src/lib/fuchsia-component",
        "//src/storage/lib/fs_management/rust:fs_management",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:uuid",
    ],
)
