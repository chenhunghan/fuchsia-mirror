import("//build/testing/host_test.gni")

# Hand-written config() because public_configs is not converted to Bazel
config("enable_tracing") {
  visibility = [ ":*" ]
  defines = [ "STORAGE_ENABLE_TRACING" ]
}

if (is_host) {
  host_test("storage_trace_cpp_host_test") {
    binary_path = "$root_out_dir/storage_trace_cpp_test"
    deps = [ ":storage_trace_cpp_test" ]
    target = get_label_info(":storage_trace_cpp_test", "label_with_toolchain")
  }
}

group("tests") {
  testonly = true
  deps = [
    ":storage_trace_cpp_host_test($host_toolchain)",
    ":storage_trace_host_test($host_toolchain)",
    ":storage_trace_tests_pkg",
  ]
}

