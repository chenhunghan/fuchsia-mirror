load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")

package(default_applicable_licenses = ["//:license"])

fx_cc_library(
    name = "operation",
    srcs = [
        "operation.cc",
    ] + select({
        "@platforms//os:fuchsia": [
            "unbuffered_operations_builder.cc",
        ],
        "//conditions:default": [],
    }),
    hdrs = [
        "operation.h",
        "operation_tree.h",
    ] + select({
        "@platforms//os:fuchsia": [
            "unbuffered_operation.h",
            "unbuffered_operations_builder.h",
        ],
        "//conditions:default": [],
    }),
    implementation_deps = select({
        "@platforms//os:fuchsia": [
            "//sdk/lib/fit",
        ],
        "//conditions:default": [],
    }) + select({
        "//build/bazel/platforms:is_fuchsia_platform": [
            "//sdk/lib/fdio",
        ],
        "//build/bazel/platforms:is_fuchsia_with_sdk_rules": [
            # Bazel targets built with SDK rules (at an SDK API level rather
            # than PLATFORM) cannot build //sdk/lib/fdio's transitive
            # //sdk/lib/zxio dep and must use @fuchsia_sdk//pkg/fdio instead;
            # GN only builds platform targets and uses //sdk/lib/fdio.
            # @bazel2gn:skip
            "@fuchsia_sdk//pkg/fdio",
        ],
        "//conditions:default": [],
    }),
    visibility = [
        "//src/storage/blobfs:__subpackages__",
        "//src/storage/f2fs/test:__pkg__",
        "//src/storage/lib:__subpackages__",
        "//src/storage/minfs:__pkg__",
    ],
    deps = [
        "//sdk/lib/stdcompat",
        "//src/storage/lib/range",
        "//zircon/third_party/ulib/safemath",
    ] + select({
        "@platforms//os:fuchsia": [
            "//zircon/system/ulib/zx",
        ],
        "//conditions:default": [],
    }),
    alwayslink = True,
)
