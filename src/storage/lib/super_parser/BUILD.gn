import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("super_parser") {
  sources = [
    "src/format.rs",
    "src/lib.rs",
    "src/metadata.rs",
  ]
  edition = "2024"
  proc_macro_deps = [ "//third_party/rust_crates:async-trait" ]
  visibility = [
    ":*",
    "//vendor/google/*",
  ]
  deps = [
    "//src/storage/lib/storage_device",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:bitflags",
    "//third_party/rust_crates:sha2",
    "//third_party/rust_crates:static_assertions",
    "//third_party/rust_crates:zerocopy",
  ]
}

rustc_test("super_parser_test") {
  sources = [
    "src/format.rs",
    "src/lib.rs",
    "src/metadata.rs",
  ]
  edition = "2024"
  proc_macro_deps = [ "//third_party/rust_crates:async-trait" ]
  deps = [
           "//src/storage/lib/storage_device",
           "//third_party/rust_crates:anyhow",
           "//third_party/rust_crates:bitflags",
           "//third_party/rust_crates:sha2",
           "//third_party/rust_crates:static_assertions",
           "//third_party/rust_crates:zerocopy",
         ] +
         [
           "//src/lib/fuchsia",
           "//third_party/rust_crates:rand",
           "//third_party/rust_crates:zstd",
         ]
  non_rust_deps = [ ":test_images" ]
  link_deps = [ "//third_party/zstd" ]
}

rustc_binary("super_parser_tool") {
  sources = [ "src/main.rs" ]
  edition = "2024"
  deps = [
    ":super_parser",
    "//src/storage/lib/storage_device",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
    "//third_party/rust_crates:futures",
  ]
}

fuchsia_unittest_package("super_parser_tests") {
  package_name = "super_parser_tests-gn"
  component_name = "super_parser_tests"
  deps = [ ":super_parser_test" ]
  visibility = [
    ":*",
    "//src/storage:*",
  ]
}
