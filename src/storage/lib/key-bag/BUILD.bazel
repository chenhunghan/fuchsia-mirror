load("@fuchsia_rules_common//packages:resources.bzl", "resource")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "key-bag",
    srcs = ["src/lib.rs"],
    edition = "2024",
    visibility = [
        "//src/storage/fshost:__subpackages__",
        "//src/storage/stress-tests/genericfs:__pkg__",
    ],
    deps = [
        "//sdk/rust/zx",
        "//third_party/rust_crates/vendor:aes-gcm-siv",
        "//third_party/rust_crates/vendor:hex",
        "//third_party/rust_crates/vendor:itertools",
        "//third_party/rust_crates/vendor:openat",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

rustc_test(
    name = "key-bag_test",
    # Propagates `tmp_storage.shard.cml` to `fx_unittest_package` in Bazel and
    # maps to `deps` in GN via bazel2gn.
    aspect_hints = ["//src/sys/test_runners:tmp_storage"],
    crate = ":key-bag",
    deps = [
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:tempfile",
    ],
)

# bazel2gn can't translate resource() or packages with resources, so the GN copy
# of this test is packaged by hand in BUILD.gn.
# @bazel2gn:skip
resource(
    name = "testdata",
    testonly = True,
    src = "testdata/key_bag.json",
    dest = "data/key_bag.json",
)

# @bazel2gn:skip
fx_unittest_package(
    name = "key-bag-tests",
    resources = [":testdata"],
    unit_tests = [":key-bag_test"],
    visibility = ["//src/storage:__pkg__"],
)
