import("//build/components.gni")
import("//build/dist/resource.gni")

# GN copy of the Bazel test "key-bag-tests", while the library is used in both
# build systems. bazel2gn can't translate resource() or packages with resources.
resource("testdata") {
  testonly = true
  sources = [ "testdata/key_bag.json" ]
  outputs = [ "data/{{source_file_part}}" ]
}

fuchsia_unittest_package("key-bag-tests") {
  package_name = "key-bag-tests-gn"
  component_name = "key-bag-tests"
  deps = [
    ":key-bag_test",
    ":testdata",
  ]
}

group("tests") {
  testonly = true
  deps = [ ":key-bag-tests" ]
}

