load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "wrap_host_rust_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":ptr-slice-test"],
    visibility = ["//src/storage:__pkg__"],
)

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [":ptr_slice_host_test"],
    visibility = ["//src/storage:__pkg__"],
)

rustc_library(
    name = "ptr_slice",
    srcs = ["src/lib.rs"],
    crate_name = "storage_ptr_slice",
    edition = "2024",
    visibility = [
        "//src/storage/fvm:__pkg__",
        "//src/storage/fxfs:__subpackages__",
        "//src/storage/lib:__subpackages__",
        "//src/sys/pkg/lib/fuchsia-merkle:__pkg__",
        "//vendor/google:__subpackages__",
    ],
    deps = ["//third_party/rust_crates/vendor:zerocopy"] + select({
        "@platforms//os:fuchsia": ["//sdk/rust/zx"],
        "//conditions:default": [],
    }),
)

rustc_test(
    name = "ptr_slice_test",
    crate = ":ptr_slice",
    tags = ["manual"],
)

wrap_host_rust_test(
    name = "ptr_slice_host_test",
    binary_name = "ptr_slice_test",
)

fx_unittest_package(
    name = "ptr-slice-test",
    unit_tests = [":ptr_slice_test"],
)
