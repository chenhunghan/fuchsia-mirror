load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")

package(default_applicable_licenses = ["//:license"])

# Storage tests defined in Bazel. These are exported to `fx test` and infra
# builders through `:bazel_tests` in BUILD.gn.
test_suite(
    name = "target_tests",
    target_compatible_with = ["@platforms//os:fuchsia"],
    tests = [
        "//src/storage/benchmarks:storage-benchmarks-framework-tests",
        "//src/storage/conformance:tests",
        "//src/storage/crypt/zxcrypt:tests",
        "//src/storage/erofs/serializer:tests",
        "//src/storage/ext4/lib/parser:tests",
        "//src/storage/fxfs/remote_volume:fxfs-remote-volume-tests",
        "//src/storage/fxfs/trace:fxfs-trace-tests-package",
        "//src/storage/lib/key-bag:key-bag-tests",
        "//src/storage/lib/range/test:range-test-pkg",
        "//src/storage/lib/sparse/rust:sparse-test",
        "//src/storage/lib/super_parser:super_parser_tests",
        "//src/storage/lib/trace:tests",
        "//src/storage/lib/units:storage-units-tests",
    ],
)

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_CONSTRAINTS,
    tests = [
        "//src/storage/fxfs/trace:fxfs-trace-host-tests",
        "//src/storage/lib/sparse/rust:lib_test",
        "//src/storage/lib/trace:host_tests",
        "//src/storage/lib/units:units_host_test",
    ],
)
