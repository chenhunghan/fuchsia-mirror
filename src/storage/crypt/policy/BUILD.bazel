load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "lib",
    srcs = ["src/lib.rs"],
    crate_name = "crypt_policy",
    edition = "2024",
    visibility = [
        "//:__subpackages__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.security.keymint:fuchsia.security.keymint_rust",
        "//sdk/rust/zx",
        "//src/lib/fuchsia-fs",
        "//src/security/lib/kms-stateless/rust",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:tracing",
    ],
)

alias(
    name = "policy",
    actual = ":lib",
    visibility = [
        "//:__subpackages__",
    ],
)
