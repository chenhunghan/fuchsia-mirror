import("//build/testing/perf/test.gni")

if (target_cpu == "riscv64") {
  # This empty group acts as a stub for unsupported configurations (e.g.,
  # riscv64) to prevent build failures when referenced by higher-level
  # test groups like //src/tests/end_to_end/perf:benchmarks.
  group("io_stress_perf_test") {
    testonly = true
  }
} else {
  fuchsia_component_perf_test("io_stress_perf_test") {
    package = ":io-stress-test"
    package_name = "io-stress-test-gn"
    component_name = "io_stress_suite"
    expected_metric_names_filepath = "//src/tests/end_to_end/perf/expected_metric_names/fuchsia.io_stress.txt"
    results_path_test_arg = "--output-fuchsiaperf"
    test_type = "system"
    environments = performance_testing_environments
  }
}

group("tests") {
  testonly = true
  deps = []

  # Disabled on riscv64 due to QEMU timeouts, mirroring the build_only guard on
  # io-stress-unittests and io-stress-test_test in BUILD.bazel.
  if (target_cpu != "riscv64") {
    deps += [
      ":io-stress-test",
      ":io-stress-unittests",
    ]
  }
}

