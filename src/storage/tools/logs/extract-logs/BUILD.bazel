load("//build/bazel/rules/host:defs.bzl", "rustc_binary_host_tool")

package(default_applicable_licenses = ["//:license"])

# Bridged to GN via `bazel_host_tool` in `BUILD.gn`.
# @bazel2gn:skip
rustc_binary_host_tool(
    name = "extract-logs",
    srcs = ["src/main.rs"],
    edition = "2024",
    visibility = ["//src/tests/disable_syscalls:__pkg__"],
    deps = [
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:byteorder",
    ],
)
