}

fuchsia_component_manifest("manifest") {
  component_name = "gpt2"
  manifest = "meta/gpt2.cml"
}

fuchsia_component("component") {
  cm_label = ":manifest"
  visibility = [
    ":*",
    "//src/storage/*",
