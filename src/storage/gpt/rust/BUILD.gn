import("//build/components.gni")
import("//build/components/fuchsia_unittest_package.gni")
import("//build/rust/rustc_test.gni")

group("rust") {
  public_deps = [ ":gpt" ]
}

# Kept in GN because it depends on //src/storage/gpt:golden_images.
rustc_test("gpt_test") {
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_rust",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-sync",
    "//src/storage/gpt:golden_images",
    "//src/storage/lib/block_client/rust",
    "//src/storage/lib/block_server",
    "//src/storage/lib/block_server/vmo_backed:test_vmo_backed_block_server",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:crc",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:thiserror",
    "//third_party/rust_crates:uuid",
    "//third_party/rust_crates:zerocopy",
  ]
  sources = [
    "src/format.rs",
    "src/lib.rs",
  ]
}

fuchsia_unittest_package("gpt-rust-test") {
  deps = [ ":gpt_test" ]
  data_deps = [ "//src/storage/gpt:golden_images" ]
}

group("tests") {
  testonly = true
  deps = [ ":gpt-rust-test" ]
}

