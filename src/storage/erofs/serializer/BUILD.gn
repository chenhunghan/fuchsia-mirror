import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("serializer") {
  testonly = true
  sources = [ "src/lib.rs" ]
  crate_name = "erofs_serializer"
  edition = "2024"
  visibility = [ "//*" ]
  deps = [
    "//src/storage/erofs",
    "//third_party/rust_crates:zerocopy",
  ]
}
if (is_fuchsia) {
  rustc_test("serializer_test") {
    sources = [ "src/lib.rs" ]
    edition = "2024"
    deps = [
             "//src/storage/erofs",
             "//third_party/rust_crates:zerocopy",
           ] + [ "//src/lib/fuchsia" ]
    output_name = "erofs_serializer_lib_test"
  }
}

fuchsia_unittest_package("erofs-serializer-tests") {
  package_name = "erofs-serializer-tests-gn"
  component_name = "erofs-serializer-tests"
  deps = [ ":serializer_test" ]
}
