  rustc_binary("bin") {
    sources = [ "src/main.rs" ]
    output_name = "erofs_component"
    edition = "2024"
    deps = [
      ":lib",
      "//sdk/fidl/fuchsia.erofs:fuchsia.erofs_rust",
      "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
      "//sdk/rust/zx",
      "//src/lib/fidl/rust/fidl",
      "//src/lib/fuchsia",
