import("//build/components.gni")

group("tests") {
  testonly = true
  deps = [ ":erofs_integration_tests" ]
}

# Kept in GN while GN subpackages and assembly callers remain and `:bin` links
# the dual-built `rustc_dylib` `//src/storage/lib/vfs/rust:vfs`.
fuchsia_package("erofs") {
  deps = [ ":erofs_component" ]
}

# Kept in GN because `fx_unittest_package` does not support helper
# components (`:erofs_component`), and `bazel2gn` does not yet support
# `resources` on `fx_package()`.
fuchsia_unittest_package("erofs_integration_tests") {
  package_name = "erofs_integration_tests-gn"
  component_name = "erofs_integration_tests"
  deps = [
    ":erofs_component",
    ":erofs_integration_test_bin",
    "//src/storage/erofs/testing:simple_erofs_image",
    "//src/storage/erofs/testing:simple_raw_files",
  ]
}

