load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")
load(
    "//build/bazel/rules/testing:fx_unittest_component.bzl",
    "fx_unittest_component",
)

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":erofs_integration_tests"],
    visibility = ["//src/storage:__pkg__"],
)

exports_files(
    [
        "meta/erofs.core_shard.cml",
    ],
    visibility = ["//bundles/assembly:__subpackages__"],
)

rustc_library(
    name = "lib",
    srcs = [
        "src/directory.rs",
        "src/file.rs",
        "src/lib.rs",
        "src/pager.rs",
        "src/symlink.rs",
        "src/volume.rs",
    ],
    crate_name = "erofs_component",
    edition = "2024",
    visibility = [
        "//src/storage/conformance/conformance_harness/erofs:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.fs:fuchsia.fs_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-sync",
        "//src/storage/erofs",
        "//src/storage/lib/trace",
        "//src/storage/lib/vfs/rust:vfs",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:log",
    ],
)

rustc_binary(
    name = "bin",
    srcs = ["src/main.rs"],
    binary_name = "erofs_component",
    edition = "2024",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        ":lib",
        "//sdk/fidl/fuchsia.erofs:fuchsia.erofs_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-runtime",
        "//src/lib/trace/rust:trace-provider",
        "//src/storage/erofs",
        "//src/storage/lib/vfs/rust:vfs",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

fx_packaged_binary(
    name = "erofs_packaged_bin",
    binary = ":bin",
    binary_name = "erofs_component",
)

fx_component_manifest(
    name = "erofs_manifest",
    component_name = "erofs",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//sdk/lib/trace:client.shard",
    ],
    manifest = "meta/erofs.cml",
)

fx_component(
    name = "erofs_component",
    compiled_manifest = ":erofs_manifest",
    deps = [":erofs_packaged_bin"],
)

rustc_test(
    name = "erofs_integration_test_bin",
    srcs = ["tests/integration_test.rs"],
    crate_name = "erofs_integration_test",
    crate_root = "tests/integration_test.rs",
    edition = "2024",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//sdk/fidl/fuchsia.erofs:fuchsia.erofs_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/rust/zx",
        "//src/lib/fdio/rust:fdio",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component-test",
        "//src/lib/fuchsia-fs",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

fx_unittest_component(
    name = "erofs_integration_test_component",
    binary = ":erofs_integration_test_bin",
    component_name = "erofs_integration_tests",
)

# @bazel2gn:skip
fx_package(
    name = "erofs_integration_tests_package",
    package_name = "erofs_integration_tests",
    testonly = True,
    components = [
        ":erofs_component",
        "//src/lib/fuchsia-component-test/realm_builder_server:realm_builder_server_component",
    ],
    resources = [
        "//src/storage/erofs/testing:simple_erofs_image",
        "//src/storage/erofs/testing:simple_raw_files",
    ],
    test_components = [":erofs_integration_test_component"],
)

fx_test(
    name = "erofs_integration_tests",
    package = ":erofs_integration_tests_package",
)
