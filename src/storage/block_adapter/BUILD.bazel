load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "block_adapter_lib",
    srcs = ["src/lib.rs"],
    crate_name = "block_adapter",
    edition = "2024",
    visibility = ["//src/storage/fuchsia-fatfs:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_rust",
        "//sdk/rust/zx",
        "//src/lib/fdio/rust:fdio",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-runtime",
        "//src/storage/lib/block_client/rust:block-client",
        "//src/storage/lib/vfs/rust:vfs",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
    ],
)

rustc_binary(
    name = "block_adapter",
    srcs = ["src/main.rs"],
    edition = "2024",
    visibility = ["//src/storage/fuchsia-fatfs:__pkg__"],
    deps = [
        ":block_adapter_lib",
        "//sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-runtime",
        "//third_party/rust_crates/vendor:anyhow",
    ],
)
