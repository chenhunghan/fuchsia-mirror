load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)

package(default_applicable_licenses = ["//:license"])

fx_packaged_binary(
    name = "fsck",
    binary = "//src/storage/bin/fsck",
    binary_name = "fsck",
)

fx_packaged_binary(
    name = "mkfs",
    binary = "//src/storage/bin/mkfs",
    binary_name = "mkfs",
)

fx_packaged_binary(
    name = "mount",
    binary = "//src/storage/bin/mount",
    binary_name = "mount",
)

fx_packaged_binary(
    name = "umount",
    binary = "//src/storage/bin/umount",
    binary_name = "umount",
)

fx_package(
    name = "fs_realm_tools",
    package_repository_name = "fuchsia.com",
    resources = [
        ":fsck",
        ":mkfs",
        ":mount",
        ":umount",
    ],
    visibility = ["//bundles/assembly:__subpackages__"],
)
