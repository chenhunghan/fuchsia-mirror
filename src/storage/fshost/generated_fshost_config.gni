import("//build/components.gni")
import("//build/images/args.gni")

declare_args() {
  # Set to one of "minfs", "fxfs", "f2fs".
  # If set to anything other than "minfs", any existing minfs partition will be
  # migrated in-place to the specified format when fshost mounts it.
  data_filesystem_format = "fxfs"

  # Use Fxfs's blob implementation
  # Changes the flashing logic because the outputs changed.
  # Toggles a bunch of tests to use fxfs.
  fxfs_blob = true
}

# Generates a structured configuration component for fshost from
# //src/storage/fshost/meta/config.cml.
# The name of the compiled component is "{component_name}_config.cm" and the
# config capabilities can be routed from it.
#
# Parameters:
#
#   component_name (optional)
#     [string] The name of the component for which to produce config, defaults to "fshost_config".
#
#   options (optional)
#     [scope] A block of fshost configuration options to include in the config file.
#     Unrecognized options cause errors. Later options override earlier options. The provided
#     values override all other values, including defaults and build args.
#
template("generated_fshost_config") {
  _component_name = "fshost_config"
  if (defined(invoker.component_name)) {
    _component_name = invoker.component_name
  }

  _schema = "//src/storage/fshost/meta/config.cml"
  _values_target = "${target_name}_values"
  _values_json = "${target_gen_dir}/${target_name}_values.json"
  _manifest_target = "${target_name}_manifest"
  _generated_cml = "${target_gen_dir}/${target_name}.cml"

  generated_file(_values_target) {
    forward_variables_from(invoker, [ "testonly" ])
    visibility = [ ":*" ]
    outputs = [ _values_json ]
    output_conversion = "json"
    contents = {
      # Defaults
      blobfs = true
      blob_max_bytes = 0
      check_filesystems = true
      data = true
      data_max_bytes = 0
      disable_block_watcher = false
      factory = false
      fvm = true
      ramdisk_image = false
      fxfs_blob = true
      fxfs_crypt_url = "fuchsia-boot:///fxfs-crypt#meta/fxfs-crypt.cm"
      gpt = true
      gpt_all = false
      merge_super_and_userdata = false
      no_zxcrypt = false
      fvm_slice_size = 8388608
      blobfs_initial_inodes = 0
      blobfs_use_deprecated_padded_format = false
      data_filesystem_format = "fxfs"
      format_data_on_corruption = true
      disable_automount = false
      starnix_volume_name = ""
      inline_crypto = false
      provision_fxfs = false
      startup_profiling_seconds = 0

      if (defined(invoker.options)) {
        forward_variables_from(invoker.options, "*")
      }

      # `fxfs_blob` defaults to `true` above, but `invoker.options` may override
      # it. Default `use_driver_blob_paging` to the resultant value of
      # `fxfs_blob` unless explicitly overridden in `invoker.options`.
      if (!defined(use_driver_blob_paging)) {
        use_driver_blob_paging = fxfs_blob
      }
    }
  }

  python_action(_manifest_target) {
    forward_variables_from(invoker, [ "testonly" ])
    visibility = [ ":*" ]
    binary_label = "//src/starnix/build:generate_container_config_component"
    inputs = [
      _schema,
      _values_json,
    ]
    outputs = [ _generated_cml ]
    args = [
      "--schema",
      rebase_path(_schema, root_build_dir),
      "--overrides",
      rebase_path(_values_json, root_build_dir),
      "--output",
      rebase_path(_generated_cml, root_build_dir),
    ]
    deps = [ ":$_values_target" ]
  }

  fuchsia_component(target_name) {
    forward_variables_from(invoker,
                           [
                             "testonly",
                             "visibility",
                           ])
    component_name = _component_name + "_config"
    manifest = _generated_cml
    manifest_deps = [ ":$_manifest_target" ]
  }
}
