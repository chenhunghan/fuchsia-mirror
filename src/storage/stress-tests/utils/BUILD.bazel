load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "utils",
    testonly = True,
    srcs = [
        "data.rs",
        "fvm.rs",
        "io.rs",
        "mod.rs",
    ],
    crate_name = "storage_stress_test_utils",
    crate_root = "mod.rs",
    edition = "2024",
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = [
        "//src/storage/stress-tests/blobfs:__pkg__",
        "//src/storage/stress-tests/fvm:__pkg__",
        "//src/storage/stress-tests/genericfs:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-fs",
        "//src/storage/fidl/fuchsia.fs.startup:fuchsia.fs.startup_rust",
        "//src/storage/lib/block_matcher",
        "//src/storage/lib/fs_management/rust:fs_management",
        "//src/storage/lib/ramdevice_client",
        "//third_party/rust_crates/vendor:log",  # for recording messages
        "//third_party/rust_crates/vendor:rand",
    ],
)
