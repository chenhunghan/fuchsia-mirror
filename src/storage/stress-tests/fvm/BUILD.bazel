    visibility = ["//src/storage/stress-tests:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_rust",
        "//sdk/rust/zx",
        "//src/lib/diagnostics/log/rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/storage/lib/block_client/rust:block-client",
        "//src/storage/lib/fs_management/rust:fs_management",
        "//src/storage/stress-tests/utils",
        "//src/sys/lib/stress-test",
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:rand",
    ],
