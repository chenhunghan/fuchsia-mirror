import("//build/components.gni")

# TODO(https://fxbug.dev/570694755): bazel2gn does not yet support resources or
# parallel on fx_unittest_package(), so the GN copy is defined by hand here
# while GN callers remain.
# LINT.IfChange(f2fs_reader_tests)
fuchsia_unittest_package("f2fs-reader-tests") {
  package_name = "f2fs-reader-tests-gn"
  component_name = "f2fs-reader-tests"
  deps = [
    ":f2fs_reader_test",
    "//src/storage/f2fs_reader/testdata:images",
  ]
  test_specs = {
    # Several tests load the f2fs.img.zst image which expands to 256MiB. Running
    # the tests in parallel can cause the system to OOM.
    parallel = 1
  }
}

# LINT.ThenChange(BUILD.bazel:f2fs_reader_tests)

group("tests") {
  testonly = true
  deps = [
    ":f2fs-reader-tests",
    "//src/storage/f2fs_reader/fuzzers:f2fs_reader-fuzzers",
  ]
}

