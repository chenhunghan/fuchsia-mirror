import("//build/components.gni")
import("//build/dist/resource.gni")

assert(is_fuchsia, "parser is target-only")

# TODO(https://fxbug.dev/570694755): bazel2gn does not yet support fuchsia_package_resource_group() or resources on fx_unittest_package(), so the GN copy of this test is packaged by hand in BUILD.gn.
# LINT.IfChange(test_images)
resource("test-images") {
  testonly = true
  sources = [
    "../../test_files/1file.img",
    "../../test_files/dac_attributes.img",
    "../../test_files/nest.img",
    "../../test_files/symlink.img",
  ]
  outputs = [ "data/{{source_file_part}}" ]
}

fuchsia_unittest_package("tests") {
  package_name = "storage-ext4-parser-tests-gn"
  component_name = "storage-ext4-parser-tests-gn"
  deps = [
    ":parser_test",
    ":test-images",
  ]
}

# LINT.ThenChange(BUILD.bazel:test_images)

