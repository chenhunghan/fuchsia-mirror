rustc_binary("bin") {
  sources = [ "src/main.rs" ]
  output_name = "ext4_server"
  edition = "2024"
  visibility = [
    ":*",
    "//src/storage/ext4:*",
  ]
  deps = [
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_rust",
    "//src/lib/diagnostics/inspect/runtime/rust",
    "//src/lib/diagnostics/inspect/rust",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-runtime",
    "//src/storage/ext4/lib/parser",
    "//src/storage/lib/vfs/rust:vfs",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:log",
  ]
}

fuchsia_component_manifest("ext4_server_manifest") {
  component_name = "ext4_server"
  manifest = "meta/ext4.cml"
}

fuchsia_component("ext4_server_comp") {
  cm_label = ":ext4_server_manifest"
  deps = [ ":bin" ]
}

fuchsia_component_manifest("ext4_readonly_manifest") {
  component_name = "ext4_readonly"
  manifest = "meta/ext4_readonly.cml"
}

fuchsia_component("ext4_readonly_comp") {
  cm_label = ":ext4_readonly_manifest"
  deps = [ ":bin" ]
}
