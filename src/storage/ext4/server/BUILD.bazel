load(
    "@fuchsia_rules_common//packages:resources.bzl",
    "fuchsia_package_resource_group",
)
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")
load(
    "//build/bazel/rules/testing:fx_unittest_component.bzl",
    "fx_unittest_component",
)

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":ext4_server_integration_tests"],
    visibility = ["//src/storage:__pkg__"],
)

rustc_binary(
    name = "bin",
    srcs = ["src/main.rs"],
    binary_name = "ext4_server",
    edition = "2024",
    visibility = ["//src/storage/ext4:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_rust",
        "//src/lib/diagnostics/inspect/runtime/rust",
        "//src/lib/diagnostics/inspect/rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-runtime",
        "//src/storage/ext4/lib/parser",
        "//src/storage/lib/vfs/rust:vfs",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:log",
    ],
)

fx_packaged_binary(
    name = "ext4_server_packaged_bin",
    binary = ":bin",
    binary_name = "ext4_server",
)

fx_component_manifest(
    name = "ext4_server_manifest",
    component_name = "ext4_server",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/ext4.cml",
)

fx_component(
    name = "ext4_server_comp",
    compiled_manifest = ":ext4_server_manifest",
    deps = [":ext4_server_packaged_bin"],
)

fx_component_manifest(
    name = "ext4_readonly_manifest",
    component_name = "ext4_readonly",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/ext4_readonly.cml",
)

fx_component(
    name = "ext4_readonly_comp",
    compiled_manifest = ":ext4_readonly_manifest",
    deps = [":ext4_server_packaged_bin"],
)

rustc_test(
    name = "ext4_server_integration_test",
    srcs = ["tests/ext4_server_test.rs"],
    crate_root = "tests/ext4_server_test.rs",
    edition = "2024",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component-test",
        "//src/lib/fuchsia-fs",
        "//src/storage/lib/block_server/vmo_backed:test_vmo_backed_block_server",
        "//src/storage/lib/vfs/rust:vfs",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:hex",
        "//third_party/rust_crates/vendor:maplit",
        "//third_party/rust_crates/vendor:sha2",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

fx_unittest_component(
    name = "ext4_server_integration_test_component",
    binary = ":ext4_server_integration_test",
    component_name = "ext4_server_integration_test",
)

# TODO(https://fxbug.dev/570694755): bazel2gn does not yet support
# fuchsia_package_resource_group() or resources on fx_package(), so the GN copy
# of this test package is defined by hand in BUILD.gn.
# LINT.IfChange(test_data)
# @bazel2gn:skip
fuchsia_package_resource_group(
    name = "ext4_server_integration_test_data_bazel",
    testonly = True,
    srcs = [
        "//src/storage/ext4:test_files/1file.img",
        "//src/storage/ext4:test_files/extents.img",
        "//src/storage/ext4:test_files/nest.img",
    ],
    basename_only = True,
    dest = "data",
)
# LINT.ThenChange(BUILD.gn:test_data)

# @bazel2gn:skip
fx_package(
    name = "ext4_server_integration_tests_package",
    package_name = "ext4_server_integration_tests",
    testonly = True,
    components = [
        ":ext4_readonly_comp",
        ":ext4_server_comp",
        "//src/lib/fuchsia-component-test/realm_builder_server:realm_builder_server_component",
    ],
    resources = [":ext4_server_integration_test_data_bazel"],
    test_components = [":ext4_server_integration_test_component"],
)

fx_test(
    name = "ext4_server_integration_tests",
    package = ":ext4_server_integration_tests_package",
)
