load("//build/bazel/rules/fidl:fidl_library.bzl", "fidl_library")

package(default_applicable_licenses = ["//:license"])

fidl_library(
    name = "fuchsia.fs.realm",
    srcs = [
        "realm.fidl",
    ],
    visibility = [
        "//src/storage/bin/fsck:__pkg__",
        "//src/storage/bin/mkfs:__pkg__",
        "//src/storage/bin/mount:__pkg__",
        "//src/storage/bin/umount:__pkg__",
        "//src/storage/fs_realm:__pkg__",
