import("//build/tools/bazel2gn/bazel_migration.gni")

fidl("test.storage") {
  testonly = true
  sources = [ "storage.test.fidl" ]
  enable_rust = true
  visibility = [ "//*" ]
}

rustc_library("settings_storage") {
  sources = [
    "src/device_storage.rs",
    "src/fidl_storage.rs",
    "src/lib.rs",
    "src/stash_logger.rs",
    "src/storage_factory.rs",
  ]
  configs += [ "//build/config/rust/lints:deny_unused_results" ]
  edition = "2024"
  lint_config = "//build/config/rust/lints:clippy_warn_all"
  visibility = [
    ":*",
    "//src/settings/accessibility:*",
    "//src/settings/audio:*",
    "//src/settings/display:*",
    "//src/settings/do_not_disturb:*",
    "//src/settings/factory_reset:*",
    "//src/settings/input:*",
    "//src/settings/intl:*",
    "//src/settings/keyboard:*",
    "//src/settings/light:*",
    "//src/settings/night_mode:*",
    "//src/settings/privacy:*",
    "//src/settings/service:*",
    "//src/settings/setup:*",
    "//src/settings/test_common:*",
  ]
  deps = [
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/fidl/fuchsia.stash:fuchsia.stash_rust",
    "//sdk/rust/zx",
    "//src/lib/diagnostics/inspect/derive",
    "//src/lib/diagnostics/inspect/rust",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-fs",
    "//src/settings/inspect_utils:settings_inspect_utils",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:serde",
    "//third_party/rust_crates:serde_json",
  ]
}
if (is_fuchsia) {
  rustc_test("settings_storage_lib_test") {
    sources = [
      "src/device_storage.rs",
      "src/fidl_storage.rs",
      "src/lib.rs",
      "src/stash_logger.rs",
      "src/storage_factory.rs",
    ]
    edition = "2024"
    deps = [
             "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
             "//sdk/fidl/fuchsia.stash:fuchsia.stash_rust",
             "//sdk/rust/zx",
             "//src/lib/diagnostics/inspect/derive",
             "//src/lib/diagnostics/inspect/rust",
             "//src/lib/fidl/rust/fidl",
             "//src/lib/fuchsia-async",
             "//src/lib/fuchsia-fs",
             "//src/settings/inspect_utils:settings_inspect_utils",
             "//third_party/rust_crates:anyhow",
             "//third_party/rust_crates:futures",
             "//third_party/rust_crates:log",
             "//third_party/rust_crates:serde",
             "//third_party/rust_crates:serde_json",
           ] + [
             ":test.storage_rust",
             "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
             "//src/lib/fuchsia",
             "//third_party/rust_crates:assert_matches",
             "//third_party/rust_crates:tempfile",
             "//third_party/rust_crates:test-case",
           ]
    configs += [ "//build/config/rust/lints:deny_unused_results" ]
    lint_config = "//build/config/rust/lints:clippy_warn_all"
  }
}

fuchsia_component_manifest("settings_storage_tests_manifest") {
  testonly = true
  component_name = "settings_storage_test"
  manifest = "meta/settings_storage_tests.cml"
}

fuchsia_test_component("settings_storage_tests_component") {
  cm_label = ":settings_storage_tests_manifest"
  deps = [ ":settings_storage_lib_test" ]
}

fuchsia_test_package("settings_storage_tests-package") {
  package_name = "settings_storage_tests-gn"
  test_components = [ ":settings_storage_tests_component" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
