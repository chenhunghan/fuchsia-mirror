    ":*",
    "//src/settings/service:*",
  ]
  deps = [
    "//sdk/fidl/fuchsia.hardware.power.statecontrol:fuchsia.hardware.power.statecontrol_rust",
    "//sdk/fidl/fuchsia.settings:fuchsia.settings_rust",
    "//sdk/rust/zx",
    "//src/lib/async-utils",
    "//src/lib/fuchsia-async",
    "//src/settings/common:settings_common",
    "//src/settings/storage:settings_storage",
    "//src/sys/lib/bitflags-serde-legacy",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:bitflags",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:serde",
    "//third_party/rust_crates:thiserror",
  ]
}
if (is_fuchsia) {
  rustc_test("settings_setup_lib_test") {
    sources = [
      "src/lib.rs",
      "src/setup_controller.rs",
      "src/setup_fidl_handler.rs",
      "src/types.rs",
    ]
    edition = "2024"
    deps = [
      "//sdk/fidl/fuchsia.hardware.power.statecontrol:fuchsia.hardware.power.statecontrol_rust",
      "//sdk/fidl/fuchsia.settings:fuchsia.settings_rust",
      "//sdk/rust/zx",
      "//src/lib/async-utils",
      "//src/lib/fuchsia-async",
      "//src/settings/common:settings_common",
      "//src/settings/storage:settings_storage",
      "//src/sys/lib/bitflags-serde-legacy",
      "//third_party/rust_crates:anyhow",
      "//third_party/rust_crates:bitflags",
      "//third_party/rust_crates:futures",
      "//third_party/rust_crates:log",
      "//third_party/rust_crates:serde",
      "//third_party/rust_crates:thiserror",
    ]
    configs += [ "//build/config/rust/lints:deny_unused_results" ]
    lint_config = "//build/config/rust/lints:clippy_warn_all"
  }
}

fuchsia_component_manifest("settings_setup_tests_manifest") {
  testonly = true
  component_name = "settings_setup_test"
  manifest = "meta/settings_setup_tests.cml"
}

fuchsia_test_component("settings_setup_tests_component") {
  cm_label = ":settings_setup_tests_manifest"
  deps = [ ":settings_setup_lib_test" ]
}

fuchsia_test_package("settings_setup_tests-package") {
  package_name = "settings_setup_tests-gn"
  test_components = [ ":settings_setup_tests_component" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
