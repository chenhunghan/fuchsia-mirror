load("//build/bazel/rules/components:fx_component.bzl", "fx_component_manifest", "fx_test_component")
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")
load("//build/bazel/rules/packages:resources.bzl", "resource")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":settings_display_tests"],
    visibility = ["//src/settings:__pkg__"],
)

rustc_library(
    name = "settings_display",
    srcs = [
        "src/display_configuration.rs",
        "src/display_controller.rs",
        "src/display_fidl_handler.rs",
        "src/lib.rs",
        "src/test_fakes.rs",
        "src/test_fakes/brightness_service.rs",
        "src/types.rs",
    ],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    proc_macro_deps = ["//third_party/rust_crates/vendor:async-trait"],
    visibility = ["//src/settings/service:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.settings:fuchsia.settings_rust",
        "//sdk/fidl/fuchsia.ui.brightness:fuchsia.ui.brightness_rust",
        "//src/lib/async-utils",
        "//src/lib/fuchsia-async",
        "//src/settings/common:settings_common",
        "//src/settings/storage:settings_storage",
        "//src/sys/lib/bitflags-serde-legacy",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:bitflags",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

# The bare binary only runs inside its custom-manifest
# component; the test runs through the :settings_display_tests fx_test.
rustc_test(
    name = "settings_display_lib_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":settings_display",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//sdk/rust/zx",
        "//src/lib/diagnostics/inspect/rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/settings/test_common:settings_test_common",
    ],
)

resource(
    name = "tests_config",
    srcs = ["test_data/display_configuration.json"],
    outputs = ["settings_display_lib_test_config_data/{{source_file_part}}"],
)

fx_packaged_binary(
    name = "settings_display_lib_test_packaged_bin",
    testonly = True,
    binary = ":settings_display_lib_test",
    binary_name = "settings_display_lib_test",
)

fx_component_manifest(
    name = "settings_display_tests_manifest",
    testonly = True,
    component_name = "settings_display_test",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/settings_display_tests.cml",
)

fx_test_component(
    name = "settings_display_tests_component",
    compiled_manifest = ":settings_display_tests_manifest",
    deps = [":settings_display_lib_test_packaged_bin"],
)

fx_package(
    name = "settings_display_tests-package",
    package_name = "settings_display_tests",
    resources = [":tests_config"],
    test_components = [":settings_display_tests_component"],
)

fx_test(
    name = "settings_display_tests",
    max_log_severity = "ERROR",
    package = ":settings_display_tests-package",
)
