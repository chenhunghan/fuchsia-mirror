load("//build/bazel/rules/components:fx_component.bzl", "fx_component_manifest", "fx_test_component")
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":settings_test_common_tests"],
    visibility = ["//src/settings:__pkg__"],
)

rustc_library(
    name = "settings_test_common",
    testonly = True,
    srcs = [
        "src/fakes.rs",
        "src/fakes/camera3_service.rs",
        "src/fakes/input_device_registry_service.rs",
        "src/fakes/service.rs",
        "src/helpers.rs",
        "src/lib.rs",
        "src/storage.rs",
    ],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    visibility = [
        "//src/settings/audio:__pkg__",
        "//src/settings/camera_watcher_agent:__pkg__",
        "//src/settings/common:__pkg__",
        "//src/settings/display:__pkg__",
        "//src/settings/input:__pkg__",
        "//src/settings/intl:__pkg__",
        "//src/settings/keyboard:__pkg__",
        "//src/settings/light:__pkg__",
        "//src/settings/media_buttons_agent:__pkg__",
        "//src/settings/privacy:__pkg__",
        "//src/settings/service:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.camera3:fuchsia.camera3_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.mem:fuchsia.mem_rust",
        "//sdk/fidl/fuchsia.stash:fuchsia.stash_rust",
        "//sdk/fidl/fuchsia.ui.input:fuchsia.ui.input_rust",
        "//sdk/fidl/fuchsia.ui.policy:fuchsia.ui.policy_rust",
        "//sdk/rust/zx",
        "//src/lib/diagnostics/inspect/rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-fs",
        "//src/lib/fuchsia-sync",
        "//src/settings/camera:settings_camera",
        "//src/settings/common:settings_common",
        "//src/settings/storage:settings_storage",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:tempfile",
    ],
)

# The bare binary only runs inside its custom-manifest
# component; the test runs through the :settings_test_common_tests fx_test.
rustc_test(
    name = "settings_test_common_lib_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":settings_test_common",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:serde",
    ],
)

fx_packaged_binary(
    name = "settings_test_common_lib_test_packaged_bin",
    testonly = True,
    binary = ":settings_test_common_lib_test",
    binary_name = "settings_test_common_lib_test",
)

fx_component_manifest(
    name = "settings_test_common_tests_manifest",
    testonly = True,
    component_name = "settings_test_common_test",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/settings_test_common_tests.cml",
)

fx_test_component(
    name = "settings_test_common_tests_component",
    compiled_manifest = ":settings_test_common_tests_manifest",
    deps = [":settings_test_common_lib_test_packaged_bin"],
)

fx_package(
    name = "settings_test_common_tests-package",
    package_name = "settings_test_common_tests",
    test_components = [":settings_test_common_tests_component"],
)

fx_test(
    name = "settings_test_common_tests",
    max_log_severity = "ERROR",
    package = ":settings_test_common_tests-package",
)
