load("//build/bazel/rules/components:fx_component.bzl", "fx_component_manifest", "fx_test_component")
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":settings_input_tests"],
    visibility = ["//src/settings:__pkg__"],
)

rustc_library(
    name = "settings_input",
    srcs = [
        "src/input_controller.rs",
        "src/input_device_configuration.rs",
        "src/input_device_limit_tests.rs",
        "src/input_fidl_handler.rs",
        "src/input_test_environment.rs",
        "src/input_tests.rs",
        "src/lib.rs",
        "src/types.rs",
    ],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    visibility = ["//src/settings/service:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.settings:fuchsia.settings_rust",
        "//src/lib/async-utils",
        "//src/lib/fuchsia-async",
        "//src/settings/camera:settings_camera",
        "//src/settings/common:settings_common",
        "//src/settings/media_buttons:settings_media_buttons",
        "//src/settings/storage:settings_storage",
        "//src/sys/lib/bitflags-serde-legacy",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:bitflags",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

# The bare binary only runs inside its custom-manifest
# component; the test runs through the :settings_input_tests fx_test.
rustc_test(
    name = "settings_input_lib_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":settings_input",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//sdk/fidl/fuchsia.camera3:fuchsia.camera3_rust",
        "//sdk/rust/zx",
        "//src/lib/diagnostics/inspect/rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//src/settings/camera_watcher_agent:settings_camera_watcher_agent",
        "//src/settings/media_buttons_agent:settings_media_buttons_agent",
        "//src/settings/test_common:settings_test_common",
    ],
)

fx_packaged_binary(
    name = "settings_input_lib_test_packaged_bin",
    testonly = True,
    binary = ":settings_input_lib_test",
    binary_name = "settings_input_lib_test",
)

fx_component_manifest(
    name = "settings_input_tests_manifest",
    testonly = True,
    component_name = "settings_input_test",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/settings_input_tests.cml",
)

fx_test_component(
    name = "settings_input_tests_component",
    compiled_manifest = ":settings_input_tests_manifest",
    deps = [":settings_input_lib_test_packaged_bin"],
)

fx_package(
    name = "settings_input_tests-package",
    package_name = "settings_input_tests",
    test_components = [":settings_input_tests_component"],
)

fx_test(
    name = "settings_input_tests",
    max_log_severity = "ERROR",
    package = ":settings_input_tests-package",
)
