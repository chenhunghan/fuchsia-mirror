load("//build/bazel/rules/components:fx_component.bzl", "fx_component_manifest", "fx_test_component")
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")
load("//build/bazel/rules/packages:resources.bzl", "resource")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":settings_audio_tests"],
    visibility = ["//src/settings:__pkg__"],
)

rustc_library(
    name = "settings_audio",
    srcs = [
        "src/audio_controller.rs",
        "src/audio_default_settings.rs",
        "src/audio_fidl_handler.rs",
        "src/lib.rs",
        "src/stream_volume_control.rs",
        "src/test_fakes.rs",
        "src/test_fakes/audio_core_service.rs",
        "src/types.rs",
        "src/utils.rs",
    ],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    visibility = ["//src/settings/service:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.media.audio:fuchsia.media.audio_rust",
        "//sdk/fidl/fuchsia.media:fuchsia.media_rust",
        "//sdk/fidl/fuchsia.settings:fuchsia.settings_rust",
        "//src/lib/async-utils",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//src/lib/trace/rust:trace",
        "//src/settings/common:settings_common",
        "//src/settings/storage:settings_storage",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

# The bare binary only runs inside its custom-manifest
# component; the test runs through the :settings_audio_tests fx_test.
rustc_test(
    name = "settings_audio_lib_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":settings_audio",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//sdk/rust/zx",
        "//src/lib/diagnostics/inspect/rust",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-sync",
        "//src/settings/test_common:settings_test_common",
        "//third_party/rust_crates/vendor:assert_matches",
    ],
)

resource(
    name = "tests_config",
    srcs = ["test_data/audio_config_data.json"],
    outputs = ["settings_audio_lib_test_config_data/{{source_file_part}}"],
)

fx_packaged_binary(
    name = "settings_audio_lib_test_packaged_bin",
    testonly = True,
    binary = ":settings_audio_lib_test",
    binary_name = "settings_audio_lib_test",
)

fx_component_manifest(
    name = "settings_audio_tests_manifest",
    testonly = True,
    component_name = "settings_audio_test",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/settings_audio_tests.cml",
)

fx_test_component(
    name = "settings_audio_tests_component",
    compiled_manifest = ":settings_audio_tests_manifest",
    deps = [":settings_audio_lib_test_packaged_bin"],
)

fx_package(
    name = "settings_audio_tests-package",
    package_name = "settings_audio_tests",
    resources = [":tests_config"],
    test_components = [":settings_audio_tests_component"],
)

fx_test(
    name = "settings_audio_tests",
    max_log_severity = "ERROR",
    package = ":settings_audio_tests-package",
)
