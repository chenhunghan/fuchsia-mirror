load("//build/bazel/rules/components:fx_component.bzl", "fx_component_manifest", "fx_test_component")
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "settings_media_buttons",
    srcs = ["src/lib.rs"],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    visibility = [
        "//src/settings/input:__pkg__",
        "//src/settings/light:__pkg__",
        "//src/settings/media_buttons_agent:__pkg__",
        "//src/settings/service:__pkg__",
    ],
    deps = ["//sdk/fidl/fuchsia.ui.input:fuchsia.ui.input_rust"],
)

rustc_test(
    name = "settings_media_buttons_lib_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":settings_media_buttons",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    target_compatible_with = ["@platforms//os:fuchsia"],
)

fx_packaged_binary(
    name = "settings_media_buttons_lib_test_packaged_bin",
    testonly = True,
    binary = ":settings_media_buttons_lib_test",
    binary_name = "settings_media_buttons_lib_test",
)

fx_component_manifest(
    name = "settings_media_buttons_tests_manifest",
    testonly = True,
    component_name = "settings_media_buttons_test",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/settings_media_buttons_tests.cml",
)

fx_test_component(
    name = "settings_media_buttons_tests_component",
    compiled_manifest = ":settings_media_buttons_tests_manifest",
    deps = [":settings_media_buttons_lib_test_packaged_bin"],
)

fx_package(
    name = "settings_media_buttons_tests-package",
    package_name = "settings_media_buttons_tests",
    test_components = [":settings_media_buttons_tests_component"],
)

fx_test(
    name = "settings_media_buttons_tests",
    max_log_severity = "ERROR",
    package = ":settings_media_buttons_tests-package",
    visibility = ["//src/settings:__pkg__"],
)
