rustc_library("settings_media_buttons") {
  sources = [ "src/lib.rs" ]
  configs += [ "//build/config/rust/lints:deny_unused_results" ]
  edition = "2024"
  lint_config = "//build/config/rust/lints:clippy_warn_all"
  visibility = [
    ":*",
    "//src/settings/input:*",
    "//src/settings/light:*",
    "//src/settings/media_buttons_agent:*",
    "//src/settings/service:*",
  ]
  deps = [ "//sdk/fidl/fuchsia.ui.input:fuchsia.ui.input_rust" ]
}
if (is_fuchsia) {
  rustc_test("settings_media_buttons_lib_test") {
    sources = [ "src/lib.rs" ]
    edition = "2024"
    deps = [ "//sdk/fidl/fuchsia.ui.input:fuchsia.ui.input_rust" ]
    configs += [ "//build/config/rust/lints:deny_unused_results" ]
    lint_config = "//build/config/rust/lints:clippy_warn_all"
  }
}

fuchsia_component_manifest("settings_media_buttons_tests_manifest") {
  testonly = true
  component_name = "settings_media_buttons_test"
  manifest = "meta/settings_media_buttons_tests.cml"
}

fuchsia_test_component("settings_media_buttons_tests_component") {
  cm_label = ":settings_media_buttons_tests_manifest"
  deps = [ ":settings_media_buttons_lib_test" ]
}

fuchsia_test_package("settings_media_buttons_tests-package") {
  package_name = "settings_media_buttons_tests-gn"
  test_components = [ ":settings_media_buttons_tests_component" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
