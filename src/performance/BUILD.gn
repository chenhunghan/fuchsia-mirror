import("//build/bazel/bazel_test_suite.gni")

group("tools") {
  deps = [
    "fxtdump",
    "perf-analyze",
    "trace2json",
  ]
}

bazel_test_suite("bazel_tests") {
  host_tests = [ "//src/performance:host_tests" ]
  target_tests = [ "//src/performance:performance_tests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    "cpu_profiler:tests",
    "ktrace_provider:tests",
    "lib:tests",
    "perf-analyze:tests",
    "perfetto-bridge:tests",
    "profiler_session_manager:tests",
    "trace/tests",
    "trace_bench:tests",
    "trace_manager:tests",
    "trace_session_manager:tests",
  ]
}
