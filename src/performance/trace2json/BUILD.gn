import("//build/bazel/bazel_host_tool.gni")
import("//build/sdk/sdk_host_tool.gni")
import("//build/testing/host_test_data.gni")

if (is_host) {
  bazel_host_tool("bin") {
    bazel_target = ":bin"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/bin"
    output_name = "trace2json"
    install_host_tool = true
  }

  # TODO(https://fxbug.dev/438572714): Remove once the IDK uses the Bazel atom.
  sdk_host_tool("bin_sdk") {
    category = "partner"
    output_name = "trace2json"
    sdk_area = "Diagnostics"
    deps = [ ":bin" ]
  }
}

group("trace2json") {
  if (is_host) {
    public_deps = [ ":bin" ]
  } else {
    public_deps = [ ":bin($host_toolchain)" ]
  }
}

# Keep test data file list in sync with BUILD.bazel.
# LINT.IfChange
if (is_host) {
  host_test_data("test_data") {
    sources = [
      "test_data/example_benchmark.fxt",
      "test_data/example_benchmark_expected.json",
      "test_data/multi_category.fxt",
      "test_data/multi_category_expected.json",
      "test_data/multi_category_filtered_expected.json",
      "test_data/no_magic.fxt",
      "test_data/simple_trace.fxt",
      "test_data/simple_trace.fxt.gz",
      "test_data/simple_trace_exact_filtered_expected.json",
      "test_data/simple_trace_expected.json",
      "test_data/simple_trace_expected.json.gz",
      "test_data/simple_trace_filtered_expected.json",
      "test_data/simple_trace_multi_filtered_expected.json",
      "test_data/simple_trace_no_events_expected.json",
      "test_data/simple_trace_split_main_expected.json",
      "test_data/simple_trace_split_system_expected.jsonlines",
    ]

    outputs = [ "$root_out_dir/test_data/trace2json/{{source_file_part}}" ]
  }
}
# LINT.ThenChange(BUILD.bazel)
