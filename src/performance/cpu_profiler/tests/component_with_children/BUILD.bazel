load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")

package(default_applicable_licenses = ["//:license"])

fx_cc_binary(
    name = "parent_bin",
    testonly = True,
    srcs = ["parent.cc"],
    deps = [
        "//examples/fidl/fuchsia.examples:fuchsia.examples_cpp",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        "//sdk/lib/component/incoming/cpp",
        "//sdk/lib/syslog/cpp",
    ],
)

fx_packaged_binary(
    name = "parent_packaged_bin",
    testonly = True,
    binary = ":parent_bin",
    binary_name = "parent",
)

fx_cc_binary(
    name = "child_bin",
    testonly = True,
    srcs = ["child.cc"],
    deps = [
        "//examples/fidl/fuchsia.examples:fuchsia.examples_cpp",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        "//sdk/lib/component/outgoing/cpp",
        "//sdk/lib/syslog/cpp",
    ],
)

fx_packaged_binary(
    name = "child_packaged_bin",
    testonly = True,
    binary = ":child_bin",
    binary_name = "child_bin",
)

fx_component_manifest(
    name = "child_manifest",
    testonly = True,
    component_name = "child",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/child.cml",
)

fx_component(
    name = "child",
    testonly = True,
    compiled_manifest = ":child_manifest",
    deps = [":child_packaged_bin"],
)

fx_component_manifest(
    name = "component_with_children_manifest",
    testonly = True,
    component_name = "component_with_children",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/component_with_children.cml",
)

fx_component(
    name = "component_with_children_component",
    testonly = True,
    compiled_manifest = ":component_with_children_manifest",
    deps = [":parent_packaged_bin"],
)

# LINT.IfChange
fx_package(
    name = "component_with_children",
    testonly = True,
    components = [
        ":child",
        ":component_with_children_component",
    ],
)

# LINT.ThenChange(BUILD.gn)
