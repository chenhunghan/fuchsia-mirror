{
    include: [ "trace/client.shard.cml" ],
    program: {
        runner: "elf",
        binary: "bin/tracee",
    },
    use: [
        // Whether the tracee component should continuously emit trace events
        // (false for idle provider configuration benchmarks, routed as true by
        // trace_bench.cml for streaming throughput benchmarks).
        {
            config: "fuchsia.trace.test.EmitTraceData",
            key: "emit_trace_data",
            type: "bool",
            availability: "transitional",
            default: false,
        },
    ],
}
