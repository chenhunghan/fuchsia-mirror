import("//build/bazel/bazel_fuchsia_package.gni")

# Expose the Bazel package to GN while //src/performance/trace_manager and
# //src/performance/ktrace_provider/tests reference it in GN subpackages.
bazel_fuchsia_package("ktrace_provider") {
  bazel_config = "fuchsia_platform"
}

group("tests") {
  testonly = true
  deps = [ "tests" ]
}

