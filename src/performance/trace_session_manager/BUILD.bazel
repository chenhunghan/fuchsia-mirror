load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load(
    "//build/bazel/rules/testing:fx_unittest_package.bzl",
    "fx_unittest_package",
)

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [],  # Include all tests in the package.
    visibility = ["//src/performance:__pkg__"],
)

rustc_binary(
    name = "bin",
    srcs = [
        "src/data.rs",
        "src/main.rs",
        "src/tracing_protocol.rs",
    ],
    binary_name = "trace_session_manager",
    edition = "2024",
    deps = [
        "//sdk/fidl/fuchsia.tracing.controller:fuchsia.tracing.controller_rust",
        "//sdk/fidl/fuchsia.tracing:fuchsia.tracing_rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/performance/trace_task",
        "//third_party/rust_crates/vendor:async-lock",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:serde_json",
    ],
)

rustc_test(
    name = "bin_test",
    crate = ":bin",
    # Preserves the GN test binary name from `rustc_binary(name = "trace_session_manager", with_unit_tests = true)`.
    crate_name = "trace_session_manager_bin_test",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
)

fx_unittest_package(
    name = "trace_session_manager-tests",
    unit_tests = [":bin_test"],
)

fx_packaged_binary(
    name = "bin_packaged_bin",
    binary = ":bin",
    binary_name = "trace_session_manager",
)

fx_component_manifest(
    name = "manifest",
    component_name = "trace_session_manager",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/trace_session_manager.cml",
)

fx_component(
    name = "component",
    compiled_manifest = ":manifest",
    deps = [":bin_packaged_bin"],
)
