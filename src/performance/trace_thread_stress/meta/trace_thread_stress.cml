{
    include: [
        "syslog/client.shard.cml",
        "trace/client.shard.cml",
    ],
    program: {
        runner: "elf",
        binary: "bin/trace_thread_stress",
    },
    use: [
        {
            config: "fuchsia.performance.trace_thread_stress.ThreadCount",
            key: "thread_count",
            type: "uint32",
            availability: "transitional",
            default: 100,
        },
        {
            config: "fuchsia.performance.trace_thread_stress.DurationMs",
            key: "duration_ms",
            type: "uint64",
            availability: "transitional",
            default: 10000,
        },
        {
            config: "fuchsia.performance.trace_thread_stress.IntervalMs",
            key: "interval_ms",
            type: "uint64",
            availability: "transitional",
            default: 10,
        },
    ],
}
