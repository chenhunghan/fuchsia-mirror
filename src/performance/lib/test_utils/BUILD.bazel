    testonly = True,
    srcs = ["run_program.cc"],
    hdrs = ["run_program.h"],
    implementation_deps = ["//src/lib/fsl"],
    visibility = [
        "//src/performance/perfetto-bridge/tests:__pkg__",
        "//src/performance/trace/tests:__pkg__",
    ],
    deps = [
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/fdio",
        "//sdk/lib/sys/cpp",
        "//src/lib/fxl",
        "//src/lib/fxl:cli",
        "//zircon/system/ulib/zx",
    ],
    alwayslink = True,
)

fx_cc_binary(
    name = "tracing_test_utils_tests_app",
    testonly = True,
    srcs = ["run_program_tests.cc"],
    gn_output_name = "tracing_test_utils_tests",
    deps = [
        ":test_utils",
        "//src/lib/fxl/test:gtest_main",
