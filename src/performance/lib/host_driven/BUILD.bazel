    name = "host_driven",
    testonly = True,
    srcs = [
        "__init__.py",
        "run_test_component.py",
    ],
    imports = [".."],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//:__subpackages__"],
