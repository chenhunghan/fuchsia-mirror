    ":*",
    "//src/performance/trace:*",
    "//src/performance/trace2json:*",
  ]
  public_deps = [
    "//sdk/lib/syslog/cpp",
    "//third_party/rapidjson",
    "//zircon/system/ulib/trace-reader",
  ]
}

cc_test_executable("chromium_unittests") {
  sources = [ "chromium_exporter_unittest.cc" ]
  output_name = "chromium_exporter_unittests"
  deps = [
    ":chromium",
    "//src/lib/fxl/test:gtest_main",
    "//third_party/googletest:gtest",
  ]
  testonly = true
  emit_tool_path = false
}

renamed_binary("chromium_unittests_packaged_bin") {
  testonly = true
  source = "$root_out_dir/chromium_exporter_unittests"
  source_deps = [ ":chromium_unittests" ]
  dest = "test/chromium_exporter_unittests"
}

fuchsia_component_manifest("chromium_unittests_manifest") {
  testonly = true
  component_name = "trace_converter_tests"
  manifest = "meta/chromium_unittests.cml"
}

fuchsia_test_component("chromium_unittests_component") {
  cm_label = ":chromium_unittests_manifest"
  deps = [ ":chromium_unittests_packaged_bin" ]
}

fuchsia_test_package("trace_converter_tests") {
  package_name = "trace_converter_tests-gn"
