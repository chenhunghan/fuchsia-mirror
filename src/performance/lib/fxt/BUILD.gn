library_headers("headers") {
  public = [
    "include/lib/fxt/argument.h",
    "include/lib/fxt/fields.h",
    "include/lib/fxt/interned_category.h",
    "include/lib/fxt/interned_string.h",
    "include/lib/fxt/map_macro.h",
    "include/lib/fxt/map_macro_internal.h",
    "include/lib/fxt/record_types.h",
    "include/lib/fxt/section_symbols.h",
    "include/lib/fxt/serializer.h",
    "include/lib/fxt/string_ref.h",
    "include/lib/fxt/thread_ref.h",
    "include/lib/fxt/trace_base.h",
    "include/lib/fxt/writer_internal.h",
  ]
  visibility = [
    ":*",
    "//src/lib/lockdep:*",
    "//zircon/kernel/lib/ktrace:*",
    "//zircon/kernel/lib/percpu_writer:*",
  ]
  public_deps = [
    "//sdk/lib/fit",
    "//sdk/lib/stdcompat",
    "//zircon/kernel/lib/special-sections",
    "//zircon/system/ulib/zx",
  ]
}

source_set("fxt") {
  public_configs = [ ":config" ]
  visibility = [
    ":*",
    "//src/lib/kstring:*",
    "//src/lib/lockdep:*",
    "//src/performance/cpu_profiler/*",
    "//src/performance/ktrace_provider:*",
    "//src/testing/loadbench:*",
    "//zircon/system/utest/core/thread-sampler:*",
  ]
  public_deps = [ ":headers" ]
}

cc_test_executable("fxt_tests_app") {
  sources = [
    "deduction_tests.cc",
    "fields_tests.cc",
    "interned_category_tests.cc",
    "interned_string_tests.cc",
    "macro_tests.cc",
    "serializer_test.cc",
    "trace_base_tests.cc",
  ]
  output_name = "fxt_tests"
  deps = [
    ":fxt",
    "//sdk/lib/fdio",
    "//src/lib/fxl",
    "//src/lib/fxl/test:gtest_main",
    "//third_party/googletest:gtest",
  ]
  testonly = true
  emit_tool_path = false
}

fuchsia_unittest_package("fxt_tests") {
  package_name = "fxt_tests-gn"
  component_name = "fxt_tests"
  deps = [ ":fxt_tests_app" ]
}
