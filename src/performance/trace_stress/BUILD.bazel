load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")

package(default_applicable_licenses = ["//:license"])

fx_cc_binary(
    name = "bin",
    srcs = ["main.cc"],
    tags = ["manual"],
    deps = [
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        "//src/lib/fxl:fxl_cli",
        "//zircon/system/ulib/trace",
        "//zircon/system/ulib/trace-provider",
    ],
)

fx_packaged_binary(
    name = "trace_stress_packaged_bin",
    binary = ":bin",
    binary_name = "trace_stress",
)

fx_package(
    name = "trace_stress",
    resources = [":trace_stress_packaged_bin"],
)
