test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [
        "//src/performance/memory/heapdump/lib/heapdump_snapshot:heapdump_snapshot_fdomain_test",
        "//src/performance/memory/stacktrack/lib/stacktrack_snapshot:stacktrack_snapshot_fdomain_test",
    ],
)
