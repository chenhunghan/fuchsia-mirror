load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "target_tests",
    tests = [
        "//src/performance/memory/attribution/processing:tests",
        "//src/performance/memory/heapdump/instrumentation:rust-tests",
        "//src/performance/memory/heapdump/lib/heapdump_snapshot:heapdump-snapshot-tests",
        "//src/performance/memory/heapdump/lib/heapdump_vmo:tests",
        "//src/performance/memory/stacktrack/lib/stacktrack_snapshot:stacktrack-snapshot-tests",
        "//src/performance/memory/stacktrack/lib/stacktrack_vmo:tests",
    ],
