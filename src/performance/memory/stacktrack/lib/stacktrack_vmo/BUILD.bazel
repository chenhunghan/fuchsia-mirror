load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "stacktrack_vmo",
    srcs = [
        "src/lib.rs",
        "src/threads_table_v1.rs",
    ],
    edition = "2024",
    visibility = ["//src/performance/memory/stacktrack:__subpackages__"],
    deps = [
        "//sdk/rust/zx",
        "//src/performance/memory/memory_mapped_vmo",
        "//third_party/rust_crates/vendor:static_assertions",
        "//third_party/rust_crates/vendor:thiserror",
        "//third_party/rust_crates/vendor:zerocopy",
    ],
)

rustc_test(
    name = "stacktrack_vmo_test",
    crate = ":stacktrack_vmo",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = ["//third_party/rust_crates/vendor:itertools"],
)

fx_unittest_package(
    name = "tests",
    package_name = "stacktrack-vmo-tests",
    unit_tests = [":stacktrack_vmo_test"],
    visibility = ["//src/performance/memory:__subpackages__"],
)
