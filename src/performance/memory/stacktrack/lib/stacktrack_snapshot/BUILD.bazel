load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")
load("//tools/fidl/measure-tape:measure_tape.bzl", "measure_tape")

package(default_applicable_licenses = ["//:license"])

measure_tape(
    name = "measure_tape_for_snapshot_element",
    fidls = ["//sdk/fidl/fuchsia.memory.stacktrack.client"],
    target_binding = "rust",
    target_types = ["fuchsia.memory.stacktrack.client/SnapshotElement"],
)

rustc_library(
    name = "stacktrack_snapshot",
    srcs = [
        "src/lib.rs",
        "src/snapshot.rs",
        "src/streamer.rs",
    ],
    edition = "2024",
    visibility = ["//src/performance/memory/stacktrack/collector:__pkg__"],
    deps = [
        ":measure_tape_for_snapshot_element",
        "//sdk/fidl/fuchsia.memory.stacktrack.client:fuchsia.memory.stacktrack.client_rust_flex",
        "//sdk/rust/zx-types",
        "//src/lib/fidl/rust/fidl",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

rustc_library(
    name = "stacktrack_snapshot_fdomain",
    srcs = [
        "src/lib.rs",
        "src/snapshot.rs",
        "src/streamer.rs",
    ],
    crate_features = ["fdomain"],
    edition = "2024",
    visibility = ["//src/developer/ffx/plugins/profile/stacktrack:__subpackages__"],
    deps = [
        ":measure_tape_for_snapshot_element",
        "//sdk/fidl/fuchsia.memory.stacktrack.client:fuchsia.memory.stacktrack.client_rust_fdomain_flex",
        "//sdk/rust/zx-types",
        "//src/lib/fdomain/client",
        "//src/lib/fidl/rust/fidl",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

rustc_test(
    name = "stacktrack_snapshot_test",
    crate = ":stacktrack_snapshot",
    deps = [
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

host_rustc_test(
    name = "stacktrack_snapshot_fdomain_test",
    crate = ":stacktrack_snapshot_fdomain",
    crate_features = ["fdomain"],
    visibility = ["//src/performance/memory:__pkg__"],
    deps = [
        "//src/lib/fdomain/local",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

fx_unittest_package(
    name = "stacktrack-snapshot-tests",
    package_name = "stacktrack-snapshot-tests",
    unit_tests = [":stacktrack_snapshot_test"],
    visibility = ["//src/performance/memory:__pkg__"],
)
