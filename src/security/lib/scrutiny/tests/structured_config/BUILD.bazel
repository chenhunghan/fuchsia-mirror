load(
    "@fuchsia_rules_common//packages:resources.bzl",
    "resource",
)
load(
    "@rules_fuchsia//fuchsia:assembly.bzl",
    "fuchsia_board_configuration",
    "fuchsia_product",
    "fuchsia_product_bundle",
)

# This test uses the non-sdk version of the product_configuration rule
# so that the generated example AIB can be used.
load(
    "//build/bazel/rules/assembly:product_configuration.bzl",
    "product_configuration",
)
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/packages:fx_package.bzl",
    "fx_package",
)

package(
    default_applicable_licenses = ["//:license"],
)

# We don't intend to run this component, just make its manifest and packaged
# structured config (both immutable and mutable-by-parent fields) visible to
# scrutiny.
fx_component_manifest(
    name = "packaged_config_component_manifest",
    component_name = "packaged_config_component",
    manifest = "meta/packaged_config_component.cml",
)

fx_component(
    name = "packaged_config_component",
    compiled_manifest = ":packaged_config_component_manifest",
)

# TODO(https://fxbug.dev/543568916): Switch to an in-tree platform
# `fuchsia_structured_config_values` Bazel rule once available under
# `//build/bazel/rules/components` (loading it from `@rules_fuchsia` is
# disallowed in platform code by the `bazel_repository_paths` shac check).
resource(
    name = "packaged_config_values",
    src = "@gn_targets//src/security/lib/scrutiny/tests/structured_config:packaged_config_cvf",
    dest = "meta/packaged_config_component.cvf",
)

fx_package(
    name = "package",
    package_name = "package_for_scrutiny_testing",
    components = [
        ":packaged_config_component",
    ],
    resources = [
        ":packaged_config_values",
    ],
)

fuchsia_board_configuration(
    name = "board_config",
    board_name = "test",
    partitions_configuration = "//build/bazel/assembly/partitions_configurations:default",
    version = "fake_version",
)

product_configuration(
    name = "product_config",
    base_packages = [
        ":package",
    ],
    enable_example_aib = True,
    product_config_json = {
        "platform": {
            "build_type": "user",
            "feature_set_level": "utility",
            "example_config": {
                "include_example_aib": True,
            },
        },
    },
)

fuchsia_product(
    name = "main_image",
    board_config = ":board_config",
    platform_artifacts = "//build/bazel/assembly/assembly_input_bundles:platform_user",
    product_config = ":product_config",
)

fuchsia_product_bundle(
    name = "product_bundle",
    testonly = True,
    main = ":main_image",
    product_bundle_name = "scrutiny-structured-config-test",
    repository_keys = "//src/sys/pkg/repositories/devhost/keys:keys",
    update_epoch = "1",
)
