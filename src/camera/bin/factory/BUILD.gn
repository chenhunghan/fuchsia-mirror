import("//build/components.gni")

group("factory") {
  deps = [ ":camera_factory" ]
}

# TODO(https://fxbug.dev/570694755): Migrate this package to Bazel. It
# stays in GN because //src/camera/bin:bin (pulled into
# //bundles/kitchen_sink via //src/camera) still depends on it through
# group("factory").
fuchsia_package_with_single_component("camera_factory") {
  manifest = "meta/camera_factory.cml"
  deps = [ ":camera_factory_bin" ]
}

