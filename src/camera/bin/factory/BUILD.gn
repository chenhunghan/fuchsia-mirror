import("//build/tools/bazel2gn/bazel_migration.gni")

source_set("lib") {
  sources = [
    "capture.cc",
    "factory_server.cc",
    "streamer.cc",
    "web_ui.cc",
  ]
  public = [
    "capture.h",
    "factory_server.h",
    "streamer.h",
    "web_ui.h",
  ]
  deps = [
    "//sdk/fidl/fuchsia.sysmem2:fuchsia.sysmem2_cpp_hlcpp_conversion",
    "//sdk/lib/fdio",
    "//src/lib/files",
  ]
  visibility = [
    ":*",
    "//build/cpp:*",
  ]
  public_deps = [
    ":fuchsia.factory.camera_hlcpp",
    "//sdk/fidl/fuchsia.camera3:fuchsia.camera3_hlcpp",
    "//sdk/fidl/fuchsia.ui.app:fuchsia.ui.app_hlcpp",
    "//sdk/fidl/fuchsia.ui.views:fuchsia.ui.views_hlcpp",
    "//sdk/lib/async-loop:async-loop-cpp",
    "//sdk/lib/async-loop:async-loop-default",
    "//sdk/lib/fit",
    "//sdk/lib/fit-promise",
    "//sdk/lib/sys/cpp",
    "//sdk/lib/syslog/cpp",
    "//sdk/lib/ui/scenic/cpp",
    "//src/lib/fsl",
    "//third_party/libpng",
    "//zircon/system/ulib/sysmem-version",
  ]
}

executable("camera_factory_bin") {
  sources = [ "main.cc" ]
  deps = [ ":lib" ]
}

fidl("fuchsia.factory.camera") {
  sources = [ "factory.fidl" ]
  enable_hlcpp = true
  excluded_checks = [
    "string-bounds-not-specified",
    "invalid-case-for-decl-name",
  ]
  visibility = [
    ":*",
    "//build/cpp:*",
    "//src/camera/bin/factory_cli:*",
  ]
  public_deps = [ "//sdk/fidl/fuchsia.images" ]
}
