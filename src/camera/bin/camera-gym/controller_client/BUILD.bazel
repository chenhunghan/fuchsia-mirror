load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")

package(default_applicable_licenses = ["//:license"])

fx_cc_library(
    name = "lib",
    srcs = ["controller_client_app.cc"],
    hdrs = ["controller_client_app.h"],
    deps = [
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        "//sdk/lib/sys/cpp",
        "//sdk/lib/syslog/cpp",
        "//src/camera/bin/camera-gym/controller_error:lib",
        "//src/camera/bin/camera-gym/fidl:controller_hlcpp",
        "//src/lib/fxl:fxl_cli",
        "//third_party/re2",
    ],
    alwayslink = True,
)

fx_cc_binary(
    name = "bin",
    srcs = ["main.cc"],
    gn_output_name = "camera-gym-ctl",
    visibility = ["//src/camera/bin/camera-gym:__pkg__"],
    deps = [
        ":lib",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        "//sdk/lib/sys/cpp",
        "//src/camera/bin/camera-gym/controller_parser:lib",
        "//src/lib/fxl:fxl_cli",
    ],
)
