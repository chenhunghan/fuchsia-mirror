import("//build/components/fuchsia_package.gni")

group("factory_cli") {
  deps = [ ":camera_factory_cli" ]
}

# TODO(https://fxbug.dev/570694755): Migrate this package to Bazel. It
# stays in GN because //src/camera/bin:bin (pulled into
# //bundles/kitchen_sink via //src/camera) still depends on it through
# group("factory_cli").
fuchsia_package("camera_factory_cli") {
  deps = [ ":camera_factory_cli_bin" ]
}

