# TODO(https://fxbug.dev/570694755): Preserve GN cflags_cc = [ "--std=c++20" ]
# alongside disable_build_flags = ["//build/config:language"] until
# bazel2gn can map copts to cflags_cc.
# @bazel2gn:raw_attribute:cflags_cc = [ "--std=c++20" ]
fx_cc_test_binary(
    name = "raw_unittests_bin",
    srcs = [
        "raw10_unittest.cc",
        "raw_formats_unittest.cc",
        "raw_ipu3_unittest.cc",
        "raw_unittest.cc",
    ],
    # The tests use EXPECT_DEATH, so the generated manifest needs the gtest
    # death test shard.
    aspect_hints = ["//src/sys/test_runners/gtest:death_test"],
    copts = [
        # TODO(https://fxbug.dev/570694755): bazel2gn maps copts to GN
        # configs += [...]; cflags_cc is emitted via raw_attribute above.
        # @bazel2gn:skip
        "--std=c++20",
        # TODO(https://fxbug.dev/42085293): delete the below and fix compiler warnings
        "-Wno-vla-cxx-extension",
    ],
    disable_build_flags = ["//build/config:language"],
    deps = [
        ":format_collection",
        ":lookups",
        "//sdk/lib/syslog/cpp",
        "//src/lib/fxl/test:gtest_main",
        # Bazel's gtest target bundles gmock; GN's :gmock publicly depends on :gtest.
        "@com_google_googletest//:gtest",  # @bazel2gn:path_overwrite://third_party/googletest:gmock
    ],
)

fx_unittest_package(
    name = "raw_unittests",
    unit_tests = [":raw_unittests_bin"],
)
