load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":raw_unittests"],
    visibility = ["//src/camera:__pkg__"],
)

# TODO(https://fxbug.dev/570694755): Preserve GN cflags_cc = [ "--std=c++20" ]
# alongside disable_build_flags = ["//build/config:language"] until
# bazel2gn can map copts to cflags_cc.
# @bazel2gn:raw_attribute:cflags_cc = [ "--std=c++20" ]
fx_cc_library(
    name = "base",
    srcs = [
        "pointer_list.h",
        "raw.cc",
        "raw_bit_depth.h",
        "raw_color_filter.h",
        "raw_hash.h",
        "raw_packing.h",
    ],
    hdrs = ["raw.h"],
    # TODO(https://fxbug.dev/570694755): bazel2gn maps copts to GN
    # configs += [...]; cflags_cc is emitted via raw_attribute above.
    # @bazel2gn:skip
    copts = ["--std=c++20"],
    disable_build_flags = ["//build/config:language"],
    implementation_deps = [
        "//sdk/lib/syslog/cpp",
        "//zircon/system/ulib/zx",
    ],
    visibility = ["//visibility:private"],
    alwayslink = True,
)

# TODO(https://fxbug.dev/570694755): Preserve GN cflags_cc = [ "--std=c++20" ]
# alongside disable_build_flags = ["//build/config:language"] until
# bazel2gn can map copts to cflags_cc.
# @bazel2gn:raw_attribute:cflags_cc = [ "--std=c++20" ]
fx_cc_library(
    name = "raw10",
    hdrs = ["raw10.h"],
    # TODO(https://fxbug.dev/570694755): bazel2gn maps copts to GN
    # configs += [...]; cflags_cc is emitted via raw_attribute above.
    # @bazel2gn:skip
    copts = ["--std=c++20"],
    disable_build_flags = ["//build/config:language"],
    visibility = ["//src/camera:__subpackages__"],
    deps = [":base"],
    alwayslink = True,
)

# TODO(https://fxbug.dev/570694755): Preserve GN cflags_cc = [ "--std=c++20" ]
