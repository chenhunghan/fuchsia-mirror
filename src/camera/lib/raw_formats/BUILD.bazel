# TODO(https://fxbug.dev/570694755): Preserve GN cflags_cc = [ "--std=c++20" ]
# alongside disable_build_flags = ["//build/config:language"] until
# bazel2gn can map copts to cflags_cc.
# @bazel2gn:raw_attribute:cflags_cc = [ "--std=c++20" ]
fx_cc_library(
    name = "lookups",
    srcs = ["raw_lookups.cc"],
    hdrs = ["raw_lookups.h"],
    # TODO(https://fxbug.dev/570694755): bazel2gn maps copts to GN
    # configs += [...]; cflags_cc is emitted via raw_attribute above.
    # @bazel2gn:skip
    copts = ["--std=c++20"],
    disable_build_flags = ["//build/config:language"],
    visibility = ["//src/camera:__subpackages__"],
    deps = [":base"],
