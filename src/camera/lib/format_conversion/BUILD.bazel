    name = "format_conversion",
    srcs = ["format_conversion.cc"],
    hdrs = ["format_conversion.h"],
    implementation_deps = [
        "//sdk/fidl/fuchsia.sysmem:fuchsia.sysmem_cpp_hlcpp_conversion",
