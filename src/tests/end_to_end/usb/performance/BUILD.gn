import("//build/testing/environments.gni")
import("//build/testing/perf/test.gni")

_honeydew_config = {
  affordances = {
    tracing = {
      implementation = "ffx"
    }
  }
  transports = {
    adb = {
      attempts = 1
    }
  }
}

python_perf_test("adb_throughput_test") {
  main_source = "test_adb_throughput.py"
  honeydew_config = _honeydew_config
  expected_metric_names_filepaths = [
    "//src/tests/end_to_end/perf/expected_metric_names/fuchsia.usb.adb.pull.txt",
    "//src/tests/end_to_end/perf/expected_metric_names/fuchsia.usb.adb.pull_storage.txt",
    "//src/tests/end_to_end/perf/expected_metric_names/fuchsia.usb.adb.push.txt",
    "//src/tests/end_to_end/perf/expected_metric_names/fuchsia.usb.adb.push_storage.txt",
  ]
  libraries = [
    "//src/performance/lib/perf_publish",
    "//src/performance/lib/reporting",
    "//src/performance/lib/trace_processing",
    "//src/testing/end_to_end/honeydew",
    "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
  ]
  params = {
    # Default transfer file sizes in bytes (50 MB)
    transfer_file_size_bytes = 50000000
    storage_transfer_file_size_bytes = 50000000
  }
  environments = [ sorrel_env ]
}

# Large variation with larger storage transfer size (500 MB)
python_perf_test("adb_throughput_large_test") {
  main_source = "test_adb_throughput.py"
  honeydew_config = _honeydew_config
  expected_metric_names_filepaths = [
    "//src/tests/end_to_end/perf/expected_metric_names/fuchsia.usb.adb.pull.txt",
    "//src/tests/end_to_end/perf/expected_metric_names/fuchsia.usb.adb.pull_storage.txt",
    "//src/tests/end_to_end/perf/expected_metric_names/fuchsia.usb.adb.push.txt",
    "//src/tests/end_to_end/perf/expected_metric_names/fuchsia.usb.adb.push_storage.txt",
  ]
  libraries = [
    "//src/performance/lib/perf_publish",
    "//src/performance/lib/reporting",
    "//src/performance/lib/trace_processing",
    "//src/testing/end_to_end/honeydew",
    "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
  ]
  params = {
    transfer_file_size_bytes = 50000000
    storage_transfer_file_size_bytes = 500000000
  }
  environments = [ iris_env ]
}

_zero_function_throughput_common = {
  main_source = "test_zero_function_throughput.py"
  honeydew_config = _honeydew_config
  expected_metric_names_filepaths = [
    "//src/tests/end_to_end/perf/expected_metric_names/fuchsia.usb.zero.bidirectional.txt",
    "//src/tests/end_to_end/perf/expected_metric_names/fuchsia.usb.zero.bulk_in.txt",
    "//src/tests/end_to_end/perf/expected_metric_names/fuchsia.usb.zero.bulk_out.txt",
  ]
  libraries = [
    "//src/performance/lib/perf_publish",
    "//src/performance/lib/reporting",
    "//src/testing/end_to_end/honeydew",
    "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
    "//src/tests/end_to_end/usb/lib:usb_lib",
    "//src/tests/end_to_end/usb/lib/testusb:testusb",
    "//src/tests/end_to_end/usb/lib/zero_function",
  ]
  package_deps = [ "//src/devices/usb/drivers/usb-zero-function:package" ]

  # `setup_class` registers the usb-zero-function driver ephemerally via
  # `ffx driver register`, so the subtool has to ship with the test.
  test_data_deps =
      [ "//src/developer/ffx/tools/driver:ffx_driver_tool_test_data" ]

  # This test drives the DUT's USB peripheral from the host, so it can only
  # run on Iris devices hosted by a Fuchsia cell.
  environments = [ iris_env ]
}

python_perf_test("zero_function_throughput_test") {
  forward_variables_from(_zero_function_throughput_common, "*")
  params = {
    total_transfer_bytes = 52428800  # 50 MiB
  }
}

python_perf_test("zero_function_throughput_large_test") {
  forward_variables_from(_zero_function_throughput_common, "*")
  params = {
    total_transfer_bytes = 1073741824  # 1 GiB
  }
}

group("tests") {
  testonly = true
  public_deps = [
    ":adb_throughput_large_test",
    ":adb_throughput_test",
    ":zero_function_throughput_large_test",
    ":zero_function_throughput_test",
  ]
}
