load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_py_test.bzl", "host_py_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [":testusb_test"],
    visibility = ["//src/tests:__pkg__"],
)

py_library(
    name = "testusb",
    testonly = True,
    srcs = [
        "__init__.py",
        "backend.py",
        "cli.py",
        "ioctl.py",
        "models.py",
        "runner.py",
    ],
    imports = [".."],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//src/tests/end_to_end/usb/functional/zero_function:__pkg__",
        "//src/tests/end_to_end/usb/lib:__subpackages__",
        "//src/tests/end_to_end/usb/performance:__pkg__",
        "//src/tests/end_to_end/usb/stress/zero_function:__pkg__",
    ],
)

# Standalone binary for host execution.
# @bazel2gn:raw_attribute:output_name = "testusb.pyz"
py_binary(
    name = "testusb_bin",
    testonly = True,
    srcs = ["cli.py"],
    main = "cli.py",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [":testusb"],
)

host_py_test(
    name = "testusb_test",
    testonly = True,
    srcs = ["testusb_test.py"],
    main = "testusb_test.py",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [":testusb"],
)
