if (is_host) {
  python_library("testusb") {
    testonly = true
    sources = [
      "__init__.py",
      "backend.py",
      "cli.py",
      "ioctl.py",
      "models.py",
      "runner.py",
    ]
    imports = [ ".." ]
    visibility = [
      ":*",
      "//src/tests/end_to_end/usb/functional/zero_function:*",
      "//src/tests/end_to_end/usb/lib/*",
      "//src/tests/end_to_end/usb/performance:*",
      "//src/tests/end_to_end/usb/stress/zero_function:*",
    ]
    enable_mypy = false
  }
}
if (is_host) {
  python_binary("testusb_bin") {
    testonly = true
    sources = [ "cli.py" ]
    main_source = "cli.py"
    deps = [ ":testusb" ]
    enable_mypy = false
    output_name = "testusb.pyz"
  }
}
