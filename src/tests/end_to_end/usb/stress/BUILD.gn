  python_mobly_test("usb_disconnect_stress_test") {
    main_source = "test_usb_disconnect.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
      "//src/tests/end_to_end/usb/lib:usb_lib",
    ]

    # The DWC3 IRQ check reads Inspect through `ffx inspect`.
    test_data_deps =
        [ "//src/developer/ffx/plugins/inspect:ffx_inspect_tool_test_data" ]
    params = {
      num_usb_disconnects = 100
      verify_mdns = true
      mdns_timeout_sec = 12

      # Soaked on Iris in usb_disconnect_irq_storm_test; a DWC3 or PMIC IRQ
      # spin-loop is most likely to show up over 100 replugs.
      verify_no_irq_storm = true

      # Vary both off-time (dwell) and connected-time (settle) across stratified
      # buckets so 100 iterations sample short, medium, and long regimes evenly
      # without locking into one phase of the DUT's periodic work. The seed and
      # exact per-iteration draws are logged and recorded for replay.
      dwell_ranges = [
        [
          "500ms",
          "2s",
        ],
        [
          "2s",
          "8s",
        ],
        [
          "8s",
          "20s",
        ],
      ]
      settle_delay_ranges = [
        [
          "0s",
          "500ms",
        ],
        [
          "1s",
          "4s",
        ],
        [
          "5s",
          "15s",
        ],
      ]
    }
    local_config_source = "UsbDisconnectTestbed.yaml"
    environments = [ iris_env ]
    timeout_secs = 3900
    honeydew_config = _honeydew_config
  }

  # Verifies that the device stays discoverable over mDNS across repeated
  # physical cable replugs with a shorter disconnect window.
  python_mobly_test("usb_mdns_hotplug_test") {
    main_source = "test_usb_disconnect.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
      "//src/tests/end_to_end/usb/lib:usb_lib",
    ]
    params = {
      num_iterations = 10
      disconnect_duration_sec = 2
      verify_mdns = true
      mdns_timeout_sec = 12

      # Each case also checks mDNS, so don't name it test_usb_disconnect_N.
      test_case_prefix = "test_usb_mdns_hotplug"
    }
    local_config_source = "UsbDisconnectTestbed.yaml"
    environments = [
      iris_env,
      sorrel_env,
    ]
    timeout_secs = 1800
    honeydew_config = _honeydew_config
  }

  # Verifies that no unhandled IRQ storm or driver dispatcher spin-loop occurs
  # across repeated physical cable replugs. A separate target so that the other
  # test_usb_disconnect.py targets are unaffected (verify_no_irq_storm defaults
  # to false).
  python_mobly_test("usb_disconnect_irq_storm_test") {
    main_source = "test_usb_disconnect.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
      "//src/tests/end_to_end/usb/lib:usb_lib",
    ]

    # The DWC3 IRQ check reads Inspect through `ffx inspect`.
    test_data_deps =
        [ "//src/developer/ffx/plugins/inspect:ffx_inspect_tool_test_data" ]
    params = {
      num_iterations = 10
      verify_no_irq_storm = true

      # Each case also checks for IRQ storms, so don't name it
      # test_usb_disconnect_N.
      test_case_prefix = "test_usb_disconnect_irq_storm"
    }
    local_config_source = "UsbDisconnectTestbed.yaml"
    environments = [
      iris_env,
      sorrel_env,
    ]
    timeout_secs = 1200
    honeydew_config = _honeydew_config
  }

  # Verifies that CDC and ADB still carry bulk data, and that no DWC3
  # endpoint is left stuck, after every physical cable replug. A separate
  # target so that it can soak on FYI before verify_traffic is enabled on
  # usb_disconnect_test.
  python_mobly_test("usb_disconnect_traffic_test") {
    main_source = "test_usb_disconnect.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
      "//src/tests/end_to_end/usb/lib:usb_lib",
    ]
    test_data_deps =
        [ "//src/developer/ffx/plugins/inspect:ffx_inspect_tool_test_data" ]
    params = {
      num_iterations = 10
      verify_traffic = true
      traffic_functions = [
        "cdc",
        "adb",
      ]
      traffic_size_mb = 5

      # Assert the link comes back at HighSpeed after every reconnect.
      expected_usb_link_speed = "high"

      # Each case also moves traffic, so don't name it test_usb_disconnect_N.
      test_case_prefix = "test_usb_disconnect_traffic"
    }
    local_config_source = "UsbDisconnectTestbed.yaml"
    environments = [
      iris_env,
      sorrel_env,
    ]
    timeout_secs = 1800
    honeydew_config = _honeydew_config
  }

