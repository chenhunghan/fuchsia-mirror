  template("_usb_soak_test") {
    assert(defined(invoker.num_epochs), "num_epochs must be defined")
    assert(defined(invoker.epoch_duration_sec),
           "epoch_duration_sec must be defined")
    assert(defined(invoker.timeout_secs), "timeout_secs must be defined")

    python_mobly_test(target_name) {
      forward_variables_from(invoker,
                             [
                               "testonly",
                               "timeout_secs",
                               "visibility",
                             ])
      main_source = "test_usb_soak.py"
      libraries = [
        "//src/testing/end_to_end/honeydew",
        "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
        "//src/tests/end_to_end/usb/lib:usb_lib",
      ]
      test_data_deps = [
        "//src/developer/ffx/plugins/inspect:ffx_inspect_tool_test_data",
        "//src/developer/ffx/plugins/profile:ffx_profile_tool_test_data",
      ]

      # Only overrides parameters that differ from UsbSoakTest defaults;
      # unlisted parameters (circuit_breaker_threshold,
      # reconnect_between_epochs, reconnect_timeout_sec, require_adb,
      # verify_no_irq_storm) use class defaults.
      params = {
        num_epochs = invoker.num_epochs
        epoch_duration_sec = invoker.epoch_duration_sec
        if (defined(invoker.disconnect_duration_sec)) {
          disconnect_duration_sec = invoker.disconnect_duration_sec
        } else {
          disconnect_duration_sec = 2
        }
        if (defined(invoker.reconnect_between_epochs)) {
          reconnect_between_epochs = invoker.reconnect_between_epochs
        }
        expected_usb_link_speed = "high"
      }
      local_config_source = "UsbDisconnectTestbed.yaml"
      environments = [ iris_env ]
      honeydew_config = _honeydew_config
    }
  }

  _usb_soak_test("usb_soak_test") {
    num_epochs = 3
    epoch_duration_sec = 15
    timeout_secs = 600
