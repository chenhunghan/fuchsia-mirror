import("//build/components.gni")

# Kept in GN because there is no in-tree
# `fuchsia_structured_config_cpp_elf_lib` Bazel rule for `:params` (`:bin`
# depends on `:params`).
executable("bin") {
  output_name = "load_generator"

  sources = [ "main.cc" ]

  deps = [
    ":params",
    "//sdk/lib/syslog/cpp",
  ]
}

# LINT.IfChange
fuchsia_component_manifest("manifest") {
  component_name = "load_generator"
  manifest = "meta/load_generator.cml"
}

# LINT.ThenChange(BUILD.bazel)

fuchsia_structured_config_cpp_elf_lib("params") {
  cm_label = ":manifest"
}

fuchsia_package_with_single_component("load_generator") {
  cm_label = ":manifest"
  deps = [ ":bin" ]
}
