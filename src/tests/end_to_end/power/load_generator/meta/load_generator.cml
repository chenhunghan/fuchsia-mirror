{
    include: [ "syslog/client.shard.cml" ],
    program: {
        runner: "elf",
        binary: "bin/load_generator",
    },
    use: [
        {
            config: "fuchsia.power.LoadPattern",
            key: "load_pattern",
            type: "vector",
            max_count: 100,
            element: { type: "uint64" },
            availability: "transitional",
            default: [],
        },
    ],
}
