import("//build/python/python_mobly_test.gni")
import("//build/testing/environments.gni")

if (is_host) {
  python_mobly_test("odpm_telemetry_test") {
    main_source = "odpm_telemetry_test.py"
    sources = [ "utils.py" ]
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
    ]
    test_data_deps =
        [ "//src/developer/ffx/plugins/inspect:ffx_inspect_tool_test_data" ]
    environments = [ iris_env ]
  }

  python_mobly_test("powerstats_and_cpuidle_test") {
    main_source = "powerstats_and_cpuidle_test.py"
    sources = [ "utils.py" ]
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
    ]
    environments = [ iris_env ]
  }
}

group("tests") {
  testonly = true
  public_deps = [
    ":odpm_telemetry_test($host_toolchain)",
    ":powerstats_and_cpuidle_test($host_toolchain)",
  ]
}
