import("//build/tools/bazel2gn/bazel_migration.gni")

if (is_fuchsia) {
  executable("kernel-boot-stats") {
    testonly = true
    sources = [ "kernel_boot_stats.cc" ]
    deps = [
      "//sdk/fidl/fuchsia.kernel:fuchsia.kernel_hlcpp",
      "//sdk/lib/sys/cpp",
      "//zircon/system/ulib/inspect",
      "//zircon/system/ulib/perftest",
    ]
  }
}

fuchsia_component_manifest("kernel-boot-benchmarks_manifest") {
  testonly = true
  component_name = "kernel-boot-benchmarks"
  manifest = "meta/kernel-boot-benchmarks.cml"
}

fuchsia_component("kernel-boot-benchmarks_component") {
  testonly = true
  cm_label = ":kernel-boot-benchmarks_manifest"
  deps = [ ":kernel-boot-stats" ]
}
