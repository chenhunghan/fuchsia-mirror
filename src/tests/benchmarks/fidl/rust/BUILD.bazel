load("@rules_python//python:defs.bzl", "py_binary")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load(
    "//src/tests/benchmarks/fidl/benchmark_suite:benchmark_suite.bzl",
    "BENCHMARK_SUITES",
)
load("//tools/fidl/gidl:gidl.bzl", "gidl")

package(default_applicable_licenses = ["//:license"])

# LINT.IfChange
_GIDL_LIB_DEPS = [
    ":benchmark_suite__%s" % suite["name"]
    for suite in BENCHMARK_SUITES
]

_GIDL_PKG_NAMES = [
    "benchmark_suite_%s" % suite["name"]
    for suite in BENCHMARK_SUITES
]

[
    gidl(
        name = "benchmark_suite__%s__gidl" % suite["name"],
        extra_args = [
            "-rust-benchmarks-fidl-library",
            suite["fidl_library_suffix"],
        ],
        fidl = suite["fidl_target"],
        inputs = suite["gidl"],
        language = "rust",
        output = "src/benchmark_suite__%s.rs" % suite["name"],
        target_compatible_with = ["@platforms//os:fuchsia"],
        type = "benchmark",
        visibility = ["//visibility:private"],
    )
    for suite in BENCHMARK_SUITES
]

[
    rustc_library(
        name = "benchmark_suite__%s" % suite["name"],
        testonly = True,
        srcs = ["src/benchmark_suite__%s.rs" % suite["name"]],
        crate_name = "benchmark_suite_%s" % suite["name"],
        crate_root = "src/benchmark_suite__%s.rs" % suite["name"],
        edition = "2024",
        target_compatible_with = ["@platforms//os:fuchsia"],
        visibility = ["//visibility:private"],
        deps = [
            "//sdk/rust/zx",
            "//src/developer/fuchsia-criterion",
            "//src/lib/fidl/rust/fidl",
            "//src/lib/fidl/rust/gidl_util",
            "//src/lib/fuchsia-async",
            "//third_party/rust_crates/vendor:futures",
            suite["fidl_target"] + "_rust",
        ],
    )
    for suite in BENCHMARK_SUITES
]

py_binary(
    name = "gen_benchmark_suite_lib",
    srcs = ["gen_benchmark_suite_lib.py"],
    main = "gen_benchmark_suite_lib.py",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//visibility:private"],
)

genrule(
    name = "benchmark_suite_rust_lib_gen",
    outs = ["benchmark_suite.rs"],
    cmd = "$(location :gen_benchmark_suite_lib) $@ " + " ".join(_GIDL_PKG_NAMES),
    tools = [":gen_benchmark_suite_lib"],
    visibility = ["//visibility:private"],
)

rustc_library(
    name = "benchmark_suite_rust_lib",
    testonly = True,
    srcs = ["benchmark_suite.rs"],
    crate_name = "benchmark_suite",
    crate_root = "benchmark_suite.rs",
    edition = "2024",
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = ["//visibility:private"],
    deps = ["//src/developer/fuchsia-criterion"] + _GIDL_LIB_DEPS,
)

rustc_binary(
    name = "rust_fidl_microbenchmarks_bin",
    testonly = True,
    srcs = ["src/main.rs"],
    crate_name = "rust_fidl_microbenchmarks",
    edition = "2024",
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = ["//visibility:private"],
    deps = [
        ":benchmark_suite_rust_lib",
        "//src/developer/fuchsia-criterion",
        "//third_party/rust_crates/vendor:criterion",
    ],
)

fx_packaged_binary(
    name = "rust_fidl_microbenchmarks_bin_packaged",
    testonly = True,
    binary = ":rust_fidl_microbenchmarks_bin",
    binary_name = "rust_fidl_microbenchmarks",
    visibility = ["//visibility:private"],
)

fx_component_manifest(
    name = "benchmark_manifest",
    testonly = True,
    component_name = "benchmark",
    includes = ["//src/tests/benchmarks/fidl:meta/benchmark.shard"],
    manifest = "meta/benchmark.cml",
    visibility = ["//visibility:private"],
)

fx_component(
    name = "benchmark",
    testonly = True,
    compiled_manifest = ":benchmark_manifest",
    visibility = ["//visibility:private"],
    deps = [":rust_fidl_microbenchmarks_bin_packaged"],
)

fx_package(
    name = "fidl_microbenchmarks_rust",
    package_name = "fidl_microbenchmarks_rust",
    testonly = True,
    components = [":benchmark"],
    visibility = ["//src/tests/benchmarks:__subpackages__"],
)
# LINT.ThenChange(//src/tests/benchmarks/fidl/rust/BUILD.gn)
