import("//build/bazel/bazel_fuchsia_package.gni")
import("//build/testing/perf/test.gni")

_tests = [
  "cpp",
  "driver_cpp",
  "driver_cpp_wire",
  "hlcpp",
  "libfidl",
  "cpp_wire",
  "reference",
  "rust",
]

_benchmarks = []
_test_packages = []

foreach(test, _tests) {
  _benchmark_name = "fidl_microbenchmarks_${test}"
  _package_target = "${_benchmark_name}_pkg"

  bazel_fuchsia_package(_package_target) {
    testonly = true
    bazel_config = "fuchsia_platform"
    bazel_target = "//src/tests/benchmarks/fidl/${test}:${_benchmark_name}"
    package_name = _benchmark_name
  }

  fuchsia_component_perf_test(_benchmark_name) {
    package = ":${_package_target}"
    package_name = _benchmark_name
    component_name = "benchmark"
    expected_metric_names_filepath = "//src/tests/end_to_end/perf/expected_metric_names/fuchsia.fidl_microbenchmarks.${test}.txt"

    if (test == "rust") {
      process_runs = 1
    } else {
      process_runs = 6
      results_path_test_arg = "--out"
      test_component_args = [
        "-p",
        "--quiet",
      ]
    }
  }

  _test_packages += [ ":${_package_target}" ]

  _benchmarks += [ ":${_benchmark_name}" ]
}

bazel_fuchsia_package("fidlc_microbenchmarks") {
  testonly = true
  bazel_config = "fuchsia_platform"
  bazel_target = "//src/tests/benchmarks/fidl/fidlc:fidlc_microbenchmarks"
  package_name = "fidlc_microbenchmarks"
}

fuchsia_component_perf_test("fidlc_microbenchmarks_test") {
  package = ":fidlc_microbenchmarks"
  component_name = "fidlc_microbenchmarks"
  expected_metric_names_filepath = "//src/tests/end_to_end/perf/expected_metric_names/fuchsia.fidlc_microbenchmarks.txt"
  test_component_args = [
    "-p",
    "--quiet",
  ]
  results_path_test_arg = "--out"
}

group("benchmarks") {
  testonly = true
  deps = [ ":fidlc_microbenchmarks_test" ] + _benchmarks
}

group("tests") {
  testonly = true
  deps = [ ":fidlc_microbenchmarks" ] + _test_packages
}
