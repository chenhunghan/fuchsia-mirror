load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")

package(default_applicable_licenses = ["//:license"])

# LINT.IfChange
fx_cc_binary(
    name = "bin",
    testonly = True,
    srcs = [
        "benchmarks.h",
        "main.cc",
    ],
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = ["//visibility:private"],
    deps = [
        "//tools/fidl/fidlc:lib",
        "//zircon/system/ulib/perftest",
    ],
)

fx_packaged_binary(
    name = "bin_packaged",
    testonly = True,
    binary = ":bin",
    binary_name = "fidlc_microbenchmarks",
    visibility = ["//visibility:private"],
)

fx_component_manifest(
    name = "fidlc_microbenchmarks_manifest",
    testonly = True,
    component_name = "fidlc_microbenchmarks",
    includes = [
        "//sdk/lib/sys/testing:elf_test_runner.shard.cml",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/fidlc_microbenchmarks.cml",
    visibility = ["//visibility:private"],
)

fx_component(
    name = "fidlc_microbenchmarks_component",
    testonly = True,
    compiled_manifest = ":fidlc_microbenchmarks_manifest",
    visibility = ["//visibility:private"],
    deps = [":bin_packaged"],
)

fx_package(
    name = "fidlc_microbenchmarks",
    package_name = "fidlc_microbenchmarks",
    testonly = True,
    components = [":fidlc_microbenchmarks_component"],
    visibility = ["//src/tests/benchmarks:__subpackages__"],
)
# LINT.ThenChange(//src/tests/benchmarks/fidl/fidlc/BUILD.gn)
