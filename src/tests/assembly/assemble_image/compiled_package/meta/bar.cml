{
    include: [ "test/include.cml" ],

    // verifying config in product assembly checks that a supported runner is specified
    program: {
        runner: "elf",
    },
    collections: [
        {
            name: "scrutiny_test_collection",
            durability: "transient",
        },
    ],
    use: [
        {
            config: "fuchsia.example.AssertedByScrutinyTest",
            key: "asserted_by_scrutiny_test",
            type: "string",
            max_size: 30,
        },
    ],
}
