    name = "run_assembly",
    testonly = True,
    srcs = [
        "__init__.py",
        "lib.py",
    ],
    imports = [".."],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//src/tests/assembly/assemble_image:__subpackages__"],
)
