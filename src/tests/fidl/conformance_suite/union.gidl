// Exercises zero-member resource union unknown envelope decoding across ALL
// bindings (including cpp_wire and hlcpp) by triggering a later decode failure.
decode_failure("EmptyFlexibleResourceUnionUnknownHandleBeforeInvalidBool") {
    handle_defs = {
        #0 = event(),
        #1 = channel(),
    },
    type = EmptyFlexibleResourceUnionThenHandle,
    bytes = {
        v2 = [
            num(1):8,
            num(8):4, num(1):2, num(0):2, // u: unknown OOL 8B + #0
            0x02, padding:3, // valid: invalid boolean
            repeat(0xff):4, // after: #1
            repeat(0xff):4, padding:4, // u payload
        ],
    },
    handles = {
        v2 = [#0, #1],
    },
    err = INVALID_BOOLEAN,
}

decode_success("EmptyFlexibleResourceUnionUnknownHandleThenKnownHandle") {
    // TODO(https://fxbug.dev/42166276): Support unknown union variants in remaining GIDL backends.
    bindings_allowlist = [cpp, rust, rust_codec, rust_next],
    handle_defs = {
        #0 = event(),
        #1 = channel(),
    },
    value = EmptyFlexibleResourceUnionThenHandle{
        u: EmptyFlexibleResourceUnion{
            1: null,
        },
        valid: true,
        after: #1,
    },
    bytes = {
        v2 = [
            num(1):8,
            num(8):4, num(1):2, num(0):2, // u: unknown OOL 8B + #0
            0x01, padding:3, // valid = true
            repeat(0xff):4, // after: #1
            repeat(0xff):4, padding:4, // u payload
        ],
    },
    handles = {
        v2 = [#0, #1],
    },
}

//Unknown handles #0 and #1 are valid channels, while #2 (meant for `after:
// handle:CHANNEL`) is an event. Decoders must close #0 and #1 without checking
// handle subtype and advance the handle cursor to #2, failing with
// INCORRECT_HANDLE_TYPE (and closing #2 as well).
decode_failure("EmptyFlexibleResourceUnionUnknownHandlesThenWrongHandleType") {
    // TODO(https://fxbug.dev/579572148): Validate handle subtype in rust_codec.
    bindings_allowlist = [cpp_wire, hlcpp, cpp, rust, dart],
    handle_defs = {
        #0 = channel(),
        #1 = channel(),
        #2 = event(),
    },
    type = EmptyFlexibleResourceUnionThenHandle,
    bytes = {
        v2 = [
            num(1):8,
            num(8):4, num(2):2, num(0):2, // u: unknown OOL 8B + #0, #1
            0x01, padding:3, // valid = true
            repeat(0xff):4, // after: #2 (wrong subtype: event instead of channel)
            repeat(0xff):8, // u payload
        ],
    },
    handles = {
        v2 = [#0, #1, #2],
    },
    err = INCORRECT_HANDLE_TYPE,
}

decode_failure("EmptyFlexibleResourceUnionUnknownBadOutlinedFlags") {
    type = StructOfEmptyFlexibleResourceUnion,
    bytes = {
        v2 = [
            num(1):8,
            num(8):4, num(0):2, 0x02, 0x00,
            repeat(0):8,
        ],
    },
    err = INVALID_INLINE_MARKER_IN_ENVELOPE,
}

