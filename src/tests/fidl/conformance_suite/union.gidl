    bindings_denylist = [rust_next],
    type = TestFlexibleUnionInStruct,
    bytes = {
        v2 = [
            num(0):8, // zero ordinal
            num(24):4, num(0):2, repeat(0):2, // envelope
            repeat(0xab):20, padding:4, // unknown bytes
        ],
