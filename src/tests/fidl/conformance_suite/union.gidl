decode_success("VectorOfFlexibleResourceUnionMixedKnownAndUnknown") {
    // TODO(https://fxbug.dev/42166276): Support unknown union variants in remaining GIDL backends.
    bindings_allowlist = [cpp, rust, rust_codec, rust_next],
    handle_defs = {
        #0 = event(),
        #1 = event(),
        #2 = channel(),
    },
    value = VectorOfFlexibleResourceUnionStruct{
        v: [
            SampleResourceUnion{
                u: 10,
            },
            SampleResourceUnion{
                77: null,
            },
            SampleResourceUnion{
                88: null,
            },
            SampleResourceUnion{
                st: SimpleTable{
                    x: 99,
                },
            },
        ],
    },
    bytes = {
        v2 = [
            // primary: vector header (count = 4)
            num(4):8, repeat(0xff):8,
            // secondary 1: 4 union headers (64 bytes)
            num(1):8, num(10):4, num(0):2, num(1):2, // [0]: known inline u=10
            num(77):8, repeat(0xff):4, num(1):2, num(1):2, // [1]: unknown inline + #0
            num(88):8, num(16):4, num(2):2, num(0):2, // [2]: unknown OOL 16B + #1, #2
            num(3):8, num(32):4, num(0):2, num(0):2, // [3]: known OOL SimpleTable (32B)
            // secondary 2: [2] unknown OOL 16B
            repeat(0xff):8, repeat(0xcd):8,
            // secondary 3: [3] SimpleTable{ x: 99 } (16B header + 8B env + 8B int64)
            num(1):8, repeat(0xff):8,
            num(8):4, num(0):2, num(0):2,
            num(99):8,
        ],
    },
    handles = {
        v2 = [#0, #1, #2],
    },
}

// Exercises flexible value union unknown OOL byte advancement and handle closing
// across ALL bindings (including cpp_wire and hlcpp): xu's 8 unknown bytes are
// valid ASCII, followed by invalid UTF-8 for s_after. If xu fails to advance the
// OOL cursor by 8 bytes, s_after reads valid ASCII and misses STRING_NOT_UTF8;
// if handle cleanup double-closes #1 or leaks #0/#2, handle checks fail.
decode_failure("FlexibleValueUnionSandwichUnknownHandleThenInvalidUtf8") {
    handle_defs = {
        #0 = event(),
        #1 = event(),
        #2 = channel(),
    },
    type = FlexibleValueUnionSandwich,
    bytes = {
        v2 = [
            repeat(0xff):4, padding:4, // before (#0)
            num(2):8, repeat(0xff):8, // s_before ("ok")
            num(99):8, num(8):4, num(1):2, num(0):2, // xu (unknown OOL 8B + #1)
            num(2):8, repeat(0xff):8, // s_after (invalid UTF-8)
            repeat(0xff):4, padding:4, // after (#2)
            'o', 'k', padding:6, // s_before payload
            'a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', // xu unknown OOL payload (valid ASCII)
            0xff, 0xff, padding:6, // s_after payload (invalid UTF-8)
        ],
    },
    handles = {
        v2 = [#0, #1, #2],
    },
    err = STRING_NOT_UTF8,
}

// Known union variant `st` (a value table) containing both a known field (`x`)
// and unknown inline and out-of-line envelopes carrying handles. The outer
// union envelope on a value union must account for all nested unknown bytes and
// handles, and decoders must drop both handles cleanly.
decode_success("UnionKnownTableVariantWithInnerUnknownEnvelopesAndHandles") {
    handle_defs = {
        #0 = event(),
        #1 = channel(),
    },
    value = TestFlexibleUnionInStruct{
        xu: SampleUnion{
            st: SimpleTable{
                x: 42,
            },
        },
    },
    bytes = {
        v2 = [
            num(3):8, // ord 3: st (SimpleTable)
            num(56):4, num(2):2, num(0):2, // 16B hdr + 24B envs + 8B x + 8B unk = 56B, 2 handles
            num(3):8, repeat(0xff):8, // SimpleTable header (max_ordinal = 3)
            num(8):4, num(0):2, num(0):2, // ord 1 (known x): 8B OOL
            repeat(0xff):4, num(1):2, num(1):2, // ord 2 (unknown): inline + #0
            num(8):4, num(1):2, num(0):2, // ord 3 (unknown): 8B OOL + #1
            num(42):8, // ord 1 payload (x = 42)
            repeat(0xff):4, repeat(0xab):4, // ord 3 unknown OOL payload
        ],
    },
    handles = {
        v2 = [#0, #1],
    },
}

// Outer known union envelope overclaims 48 bytes while inner SimpleTable with
// an unknown OOL envelope only consumes 40 bytes.
decode_failure("UnionOuterEnvelopeByteMismatchOnInnerTableUnknownEnvelope") {
    // TODO(https://fxbug.dev/579582163): Validate envelope byte count in rust_next.
    bindings_denylist = [rust_next],
    type = TestFlexibleUnionInStruct,
    bytes = {
        v2 = [
            num(3):8, // ord 3: st
            num(48):4, num(0):2, num(0):2, // claims 48 bytes instead of 40
            num(2):8, repeat(0xff):8, // SimpleTable header (16B)
            repeat(0x00):8, // ord 1: absent (8B)
            num(8):4, num(0):2, num(0):2, // ord 2 (unknown): 8B OOL (8B)
            repeat(0xab):8, // ord 2 unknown payload (8B -> 40B total)
            num(0):8, // trailing bytes matching claimed 48
        ],
    },
    err = INVALID_NUM_BYTES_IN_ENVELOPE,
}

// Flexible value union (`SampleUnion`) receiving 2 unknown channel handles
// before a known `handle:CHANNEL` field given an event (#2); proves C++ and
// Rust decoders skip subtype validation on unknown handles in value unions and
// advance the handle cursor past all of them.
decode_failure("FlexibleValueUnionUnknownHandlesThenWrongHandleType") {
    // TODO(https://fxbug.dev/579572148): Validate handle subtype in rust_codec.
    bindings_allowlist = [cpp_wire, hlcpp, cpp, rust, dart],
    handle_defs = {
        #0 = channel(),
        #1 = channel(),
        #2 = event(),
    },
    type = FlexibleValueUnionThenResourceHandle,
    bytes = {
        v2 = [
            num(99):8,
            num(8):4, num(2):2, num(0):2, // xu: unknown OOL 8B + #0, #1
            repeat(0xff):4, padding:4, // after: #2 (event instead of channel)
            repeat(0xff):8, // xu payload
        ],
    },
    handles = {
        v2 = [#0, #1, #2],
    },
    err = INCORRECT_HANDLE_TYPE,
}

// Outer known union envelope claims 0 handles while an unknown inline envelope
// inside SimpleTable consumes 1 handle.
decode_failure("UnionOuterEnvelopeHandleUnderclaimOnInnerTableUnknownHandle") {
    handle_defs = {
        #0 = event(),
    },
    type = TestFlexibleResourceUnionInStruct,
    bytes = {
        v2 = [
            num(3):8, // ord 3: st
            num(32):4, num(0):2, num(0):2, // claims 0 handles instead of 1
            num(2):8, repeat(0xff):8, // SimpleTable header (16B)
            repeat(0x00):8, // ord 1: absent
            repeat(0xff):4, num(1):2, num(1):2, // ord 2 (unknown): inline + #0
        ],
    },
    handles = {
        v2 = [#0],
    },
    err = INVALID_NUM_HANDLES_IN_ENVELOPE,
}

// Outer known union envelope claims 2 handles while an unknown inline envelope
// inside SimpleTable only consumes 1 handle; both #0 and unconsumed #1 must be closed.
decode_failure("UnionOuterEnvelopeHandleOverclaimOnInnerTableUnknownHandle") {
    handle_defs = {
        #0 = event(),
        #1 = channel(),
    },
    type = TestFlexibleResourceUnionInStruct,
    bytes = {
        v2 = [
            num(3):8, // ord 3: st
            num(32):4, num(2):2, num(0):2, // claims 2 handles instead of 1
            num(2):8, repeat(0xff):8, // SimpleTable header (16B)
            repeat(0x00):8, // ord 1: absent
            repeat(0xff):4, num(1):2, num(1):2, // ord 2 (unknown): inline + #0
        ],
    },
    handles = {
        v2 = [#0, #1],
    },
    err = INVALID_NUM_HANDLES_IN_ENVELOPE,
}
