// Primary struct is 16 bytes; num_bytes = 0xfffffff8 is 8-byte aligned and wraps
// 16 + 0xfffffff8 in 32-bit arithmetic to 8 <= 24 (total buffer size).
decode_failure("UnionUnknownOutOfLineEnvelopeBytesUint32Overflow") {
    // TODO(https://fxbug.dev/42169965): Return INVALID_NUM_BYTES_IN_ENVELOPE in rust.
    // TODO(https://fxbug.dev/579582163): Return InvalidEnvelopeSize in rust_next.
    bindings_denylist = [rust, rust_next],
    type = TestFlexibleUnionInStruct,
    bytes = {
        v2 = [
            num(1234):8,
            num(0xfffffff8):4, num(0):2, num(0):2,
            repeat(0):8,
        ],
    },
    err = ENVELOPE_BYTES_EXCEED_MESSAGE_LENGTH,
}

