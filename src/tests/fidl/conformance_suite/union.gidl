// ======== TRAVERSAL ORDER (SANDWICH STRUCTS & VECTORS) WITH UNIONS ========

decode_success("FlexibleValueUnionSandwichUnknownInlineWithHandle") {
    // TODO(https://fxbug.dev/42166276): Support unknown union variants in remaining GIDL backends.
    bindings_allowlist = [cpp, rust, rust_codec, rust_next],
    handle_defs = {
        #0 = event(),
        #1 = channel(),
        #2 = channel(),
    },
    value = FlexibleValueUnionSandwich{
        before: #0,
        s_before: "hi",
        xu: SampleUnion{
            99: null,
        },
        s_after: "bye",
        after: #2,
    },
    bytes = {
        v2 = [
            // primary struct (64 bytes)
            repeat(0xff):4, padding:4, // before (#0)
            num(2):8, repeat(0xff):8, // s_before ("hi")
            num(99):8, repeat(0xff):4, num(1):2, num(1):2, // xu (unknown inline + #1)
            num(3):8, repeat(0xff):8, // s_after ("bye")
            repeat(0xff):4, padding:4, // after (#2)
            // secondary objects
            'h', 'i', padding:6,
            'b', 'y', 'e', padding:5,
        ],
    },
    handles = {
        v2 = [#0, #1, #2],
    },
}

decode_success("FlexibleValueUnionSandwichUnknownOutOfLineWithHandles") {
    // TODO(https://fxbug.dev/42166276): Support unknown union variants in remaining GIDL backends.
    bindings_allowlist = [cpp, rust, rust_codec, rust_next],
    handle_defs = {
        #0 = event(),
        #1 = event(),
        #2 = channel(),
        #3 = channel(),
    },
    value = FlexibleValueUnionSandwich{
        before: #0,
        s_before: "alpha",
        xu: SampleUnion{
            99: null,
        },
        s_after: "omega",
        after: #3,
    },
    bytes = {
        v2 = [
            // primary struct (64 bytes)
            repeat(0xff):4, padding:4, // before (#0)
            num(5):8, repeat(0xff):8, // s_before ("alpha")
            num(99):8, num(16):4, num(2):2, num(0):2, // xu (unknown OOL 16B + #1, #2)
            num(5):8, repeat(0xff):8, // s_after ("omega")
            repeat(0xff):4, padding:4, // after (#3)
            // secondary objects in depth-first order
            'a', 'l', 'p', 'h', 'a', padding:3,
            repeat(0xff):8, repeat(0xab):8,
            'o', 'm', 'e', 'g', 'a', padding:3,
        ],
    },
    handles = {
        v2 = [#0, #1, #2, #3],
    },
}

