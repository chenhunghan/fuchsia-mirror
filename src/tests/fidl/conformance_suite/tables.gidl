        v2 = [
            num(65):8, // max ordinal
            repeat(0xff):8, // alloc present
            repeat(0x00):496, // absent envelopes 1..62
            0xaa, padding:3, num(0):2, num(1):2, // envelope 63 (inlined)
            0xbb, padding:3, num(0):2, num(1):2, // envelope 64 (inlined)
            0xcc, padding:3, num(0):2, num(1):2, // envelope 65 (unknown inlined)
        ],
    },
}

decode_success("SimpleTableMaxOrdinalInGap") {
    // TODO(https://fxbug.dev/579582293): Fix table decoder gap loop in rust.
    bindings_denylist = [rust],
    value = StructOfSimpleTable{
        table: SimpleTable{
            x: 42,
        },
    },
    bytes = {
        v2 = [
            num(2):8, // max ordinal (falls in gap 2..4 before known ordinal 5)
            repeat(0xff):8, // alloc present
            num(8):4, num(0):2, num(0):2, // envelope 1 (x: 42)
            num(99):4, num(0):2, num(1):2, // envelope 2 (unknown inlined)
            num(42):8, // field X
        ],
    },
}

