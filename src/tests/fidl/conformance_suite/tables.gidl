// Fails AFTER unknown inline (#1) and unknown OOL (#2) handles were closed while
// walking the table, with #0 already decoded into `before` and #3 not yet
// consumed for `after`. Verifies all handles #0..#3 are closed exactly once.
decode_failure("TableDecodeFailureAfterClosingUnknownHandlesClosesAllOnce") {
    handle_defs = {
        #0 = event(),
        #1 = event(),
        #2 = channel(),
        #3 = channel(),
    },
    type = StructOfTableAndTrigger,
    bytes = {
        v2 = [
            repeat(0xff):4, padding:4, // before (#0)
            num(2):8, repeat(0xff):8, // table
            0x02, padding:3, // invalid bool (triggers INVALID_BOOLEAN)
            repeat(0xff):4, // after (#3)
            repeat(0xff):4, num(1):2, num(1):2, // ord 1: unknown inline handle (#1)
            num(8):4, num(1):2, num(0):2, // ord 2: unknown OOL handle (#2)
            repeat(0xff):4, padding:4, // ord 2 payload
        ],
    },
    handles = {
        v2 = [#0, #1, #2, #3],
    },
    err = INVALID_BOOLEAN,
}

decode_failure("TableDecodeFailureInUnknownEnvelopeClosesSurroundingHandles") {
    handle_defs = {
        #0 = event(),
        #1 = event(),
        #2 = channel(),
    },
    type = StructOfTableAndTrigger,
    bytes = {
        v2 = [
            repeat(0xff):4, padding:4, // before (#0)
            num(1):8, repeat(0xff):8, // table
            0x01, padding:3, // valid = true
            repeat(0xff):4, // after (#2)
            repeat(0xff):4, num(1):2, 0x01, 0xee, // bad inline marker
        ],
    },
    handles = {
        v2 = [#0, #1, #2],
    },
    err = INVALID_INLINE_MARKER_IN_ENVELOPE,
}

// Outer known table envelope (`xu`) overclaims 32 bytes while inner flexible
// union's unknown envelope only consumes 24 bytes total (16B union + 8B OOL).
decode_failure("TableOuterEnvelopeByteOverclaimOnInnerUnionUnknownEnvelope") {
    // TODO(https://fxbug.dev/579582163): Validate envelope byte count in rust_next.
    bindings_denylist = [rust_next],
    type = TestUnionInTable,
    bytes = {
        v2 = [
            num(2):8, repeat(0xff):8, // table header
            repeat(0x00):8, // ord 1: absent
            num(32):4, num(0):2, num(0):2, // ord 2: xu claims 32 bytes instead of 24
            num(99):8, num(8):4, num(0):2, num(0):2, // SampleUnion unknown OOL (8B)
            repeat(0xab):8, // unknown OOL payload (24 bytes consumed in xu)
            num(0):8, // trailing bytes matching claimed 32
        ],
    },
    err = INVALID_NUM_BYTES_IN_ENVELOPE,
}

// Outer known table envelope (`xu`) underclaims 16 bytes (ignoring the 8 OOL
// bytes consumed by the inner flexible union's unknown envelope).
decode_failure("TableOuterEnvelopeByteUnderclaimOnInnerUnionUnknownEnvelope") {
    // TODO(https://fxbug.dev/579582163): Validate envelope byte count in rust_next.
    bindings_denylist = [rust_next],
    type = TestUnionInTable,
    bytes = {
        v2 = [
            num(3):8, repeat(0xff):8, // table header
            repeat(0x00):8, // ord 1: absent
            num(16):4, num(0):2, num(0):2, // ord 2: xu claims 16 bytes instead of 24
            num(24):4, num(0):2, num(0):2, // ord 3: after ("post")
            num(99):8, num(8):4, num(0):2, num(0):2, // SampleUnion unknown OOL (8B)
            repeat(0xab):8, // unknown OOL payload (makes xu consume 24 bytes)
            num(4):8, repeat(0xff):8,
            'p', 'o', 's', 't', padding:4,
        ],
    },
    err = INVALID_NUM_BYTES_IN_ENVELOPE,
}

// Outer known table envelope (`xu`) claims 0 handles while inner flexible
// union's unknown inline envelope consumes 1 handle.
decode_failure("TableOuterEnvelopeHandleMismatchOnInnerUnionUnknownHandle") {
    handle_defs = {
        #0 = event(),
    },
    type = TestUnionInTable,
    bytes = {
        v2 = [
            num(2):8, repeat(0xff):8, // table header
            repeat(0x00):8, // ord 1: absent
            num(16):4, num(0):2, num(0):2, // ord 2: xu claims 0 handles instead of 1
            num(99):8, repeat(0xff):4, num(1):2, num(1):2, // SampleUnion unknown inline (#0)
        ],
    },
    handles = {
        v2 = [#0],
    },
    err = INVALID_NUM_HANDLES_IN_ENVELOPE,
}

// Zero-member value table (`EmptyTable`) receiving unknown inline, absent gap,
// and out-of-line envelopes.
decode_success("EmptyTableWithUnknownInlineAndOutOfLine") {
    value = StructOfEmptyTable{
        table: EmptyTable{},
    },
    bytes = {
        v2 = [
            num(3):8, repeat(0xff):8, // max_ordinal = 3
            0x01, 0x02, 0x03, 0x04, num(0):2, num(1):2, // ord 1: unknown inline
            repeat(0x00):8, // ord 2: absent gap
            num(16):4, num(0):2, num(0):2, // ord 3: unknown OOL 16B
            repeat(0xab):16,
        ],
    },
}

// Zero-member value table (`EmptyTable`) carrying unknown inline and OOL handles
// before a subsequent struct handle; both unknown handles must be closed and the
// handle cursor must advance so `after` receives #2.
decode_success("EmptyValueTableUnknownHandlesThenKnownHandle") {
    // TODO(https://fxbug.dev/579582742): Advance handle_index_ for unknown handles in value tables in hlcpp.
    bindings_denylist = [hlcpp],
    handle_defs = {
        #0 = event(),
        #1 = event(),
        #2 = channel(),
    },
    value = EmptyValueTableThenHandle{
        t: EmptyTable{},
        after: #2,
    },
    bytes = {
        v2 = [
            // primary struct (24 bytes)
            num(2):8, repeat(0xff):8, // t: max_ordinal = 2
            repeat(0xff):4, padding:4, // after (#2)
            // secondary objects: t envelopes + OOL payload
            repeat(0xff):4, num(1):2, num(1):2, // ord 1: unknown inline (#0)
            num(8):4, num(1):2, num(0):2, // ord 2: unknown OOL 8B (#1)
            repeat(0xff):4, padding:4, // ord 2 payload
        ],
    },
    handles = {
        v2 = [#0, #1, #2],
    },
}

// Zero-member resource table (`EmptyResourceTable`) carrying unknown inline,
// absent gap, and unknown OOL bytes/handles before subsequent known OOL string
// and handle fields.
decode_success("EmptyResourceTableUnknownInlineAndOutOfLineBeforeKnownFields") {
    handle_defs = {
        #0 = event(),
        #1 = event(),
        #2 = channel(),
    },
    value = EmptyResourceTableThenHandle{
        t: EmptyResourceTable{},
        s: "ok",
        after: #2,
    },
    bytes = {
        v2 = [
            // primary struct (40 bytes)
            num(3):8, repeat(0xff):8, // t: max_ordinal = 3
            num(2):8, repeat(0xff):8, // s ("ok")
            repeat(0xff):4, padding:4, // after (#2)
            // secondary 1: t envelope vector (24 bytes)
            repeat(0xff):4, num(1):2, num(1):2, // ord 1: unknown inline (#0)
            repeat(0x00):8, // ord 2: absent gap
            num(16):4, num(1):2, num(0):2, // ord 3: unknown OOL 16B (#1)
            // secondary 2: t ord 3 payload (16 bytes)
            repeat(0xff):4, repeat(0xcd):12,
            // secondary 3: s payload (8 bytes)
            'o', 'k', padding:6,
        ],
    },
    handles = {
        v2 = [#0, #1, #2],
    },
}
