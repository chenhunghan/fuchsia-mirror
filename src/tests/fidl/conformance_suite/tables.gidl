decode_success("ValueTableWithUnknownHandlesThenResourceTableWithHandle") {
    // TODO(https://fxbug.dev/579582742): Advance handle_index_ for unknown handles in value tables in hlcpp.
    bindings_denylist = [hlcpp],
    handle_defs = {
        #0 = event(),
        #1 = channel(),
    },
    value = ValueTableThenResourceTable{
        first: SimpleTable{
            x: 42,
        },
        second: TableFieldInlinedHandle{
            f: #1,
        },
    },
    bytes = {
        v2 = [
            // primary object: first (SimpleTable) header
            num(6):8, // max ordinal
            repeat(0xff):8, // alloc present
            // primary object: second (TableFieldInlinedHandle) header
            num(1):8, // max ordinal
            repeat(0xff):8, // alloc present
            // first envelopes
            num(8):4, num(0):2, num(0):2, // envelope 1 (x: 42)
            num(0):8, // envelope 2 (absent)
            num(0):8, // envelope 3 (absent)
            num(0):8, // envelope 4 (absent)
            num(0):8, // envelope 5 (absent)
            repeat(0xff):4, num(1):2, num(1):2, // envelope 6 (unknown inline handle #0)
            // first out-of-line payload for envelope 1
            num(42):8,
            // second envelopes
            repeat(0xff):4, num(1):2, num(1):2, // envelope 1 (f: #1)
        ],
    },
    handles = {
        v2 = [#0, #1],
    },
}

// An inline unknown envelope with an all-zero 4-byte payload (e.g. uint32(0),
// bool(false), or EmptyStruct{}) is still present because the inline bit is 1.
decode_success("TableUnknownInlineZeroValueDropped") {
    value = TableFieldUnknownStruct{
        t: TableFieldUnknown{},
    },
    bytes = {
        v2 = [
            num(1):8,
            repeat(0xff):8,
            num(0):4, num(0):2, num(1):2,
        ],
    },
}

decode_success("ResourceTableUnknownInlineZeroValueDropped") {
    value = TableFieldUnknownResourceStruct{
        t: TableFieldUnknownResource{},
    },
    bytes = {
        v2 = [
            num(1):8,
            repeat(0xff):8,
            num(0):4, num(0):2, num(1):2,
        ],
    },
}

// Decoders do not know the static type of an unknown inline envelope and must
// not assume any of the 4 inline value bytes are padding.
decode_success("TableUnknownInlineAllBytesNonZeroDropped") {
    value = TableFieldUnknownStruct{
        t: TableFieldUnknown{},
    },
    bytes = {
        v2 = [
            num(1):8,
            repeat(0xff):8,
            0x01, 0xff, 0xfe, 0xfd, num(0):2, num(1):2,
        ],
    },
}

// Decoders do not know the static layout of an unknown out-of-line envelope and
// must not enforce internal padding bytes inside its 8-byte-aligned payload.
decode_success("TableUnknownOutOfLineAllOnesPayloadDropped") {
    value = TableFieldUnknownStruct{
        t: TableFieldUnknown{},
    },
    bytes = {
        v2 = [
            num(1):8,
            repeat(0xff):8,
            num(16):4, num(0):2, num(0):2,
            repeat(0xff):16,
        ],
    },
}

// Tests closing a handle inside an unknown inlined envelope on a non-resource table.
decode_success("ValueTableUnknownInlineHandleDropped") {
    handle_defs = {
        #0 = event(),
    },
    value = StructOfSimpleTable{
        table: SimpleTable{},
    },
    bytes = {
        v2 = [
            num(2):8,
            repeat(0xff):8,
            num(0):8, // ordinal 1 absent
            repeat(0xff):4, num(1):2, num(1):2, // ordinal 2 unknown inline handle
        ],
    },
    handles = {
        v2 = [#0],
    },
}

encode_success("ValueTableUnknownInlineHandleDropped") {
    // TODO(https://fxbug.dev/42067496): Implement the decode function in all backends.
    bindings_allowlist = [rust],
    handle_defs = {
        #0 = event(),
    },
    value = StructOfSimpleTable{
        table: decode({
            type = SimpleTable,
            bytes = {
                v2 = [
                    num(2):8,
                    repeat(0xff):8,
                    num(0):8,
                    repeat(0xff):4, num(1):2, num(1):2,
                ],
            },
            handles = {
                v2 = [#0],
            },
        }),
    },
    bytes = {
        v2 = [
            num(0):8, repeat(0xff):8,
        ],
    },
}

// TableWithGaps starts at ordinal 2; test max_ordinal = 1 with only an unknown
// envelope in the initial gap (shorter than the first known ordinal).
decode_success("TableWithGapsOnlyFirstGapUnknownOutOfLine") {
    value = StructOfTableWithGaps{
        table: TableWithGaps{},
    },
    bytes = {
        v2 = [
            num(1):8, repeat(0xff):8,
            num(8):4, num(0):2, num(0):2, // ordinal 1 unknown out-of-line
            repeat(0xab):8,
        ],
    },
}

decode_success("TableWithGapsOnlyFirstGapUnknownInline") {
    value = StructOfTableWithGaps{
        table: TableWithGaps{},
    },
    bytes = {
        v2 = [
            num(1):8, repeat(0xff):8,
            num(0):4, num(0):2, num(1):2, // ordinal 1 unknown inline (zero value)
        ],
    },
}

decode_success("TableWithGapsUnknownInAllGapsAndTrailing") {
    value = StructOfTableWithGaps{
        table: TableWithGaps{
            second: 10,
            fourth: 20,
        },
    },
    bytes = {
        v2 = [
            num(5):8, repeat(0xff):8,
            num(8):4, num(0):2, num(0):2, // ordinal 1: unknown out-of-line
            num(10):4, num(0):2, num(1):2, // ordinal 2: second (inlined)
            num(0):4, num(0):2, num(1):2, // ordinal 3: unknown inline (zero value)
            num(20):4, num(0):2, num(1):2, // ordinal 4: fourth (inlined)
            num(16):4, num(0):2, num(0):2, // ordinal 5: unknown out-of-line
            repeat(0xaa):8, // ordinal 1 payload
            repeat(0xbb):16, // ordinal 5 payload
        ],
    },
}

// Decoders accept non-minimal envelope vectors containing trailing absent
// envelopes after an unknown envelope.
decode_success("TableTrailingEmptyEnvelopesAfterUnknownDropped") {
    value = TableFieldUnknownStruct{
        t: TableFieldUnknown{},
    },
    bytes = {
        v2 = [
            num(3):8, repeat(0xff):8,
            num(8):4, num(0):2, num(0):2, // ordinal 1: unknown out-of-line
            num(0):8, // ordinal 2: trailing absent envelope
            num(0):8, // ordinal 3: trailing absent envelope
            repeat(0xcc):8,
        ],
    },
}

decode_success("TableWithUnknown65thAnd66thOrdinalsOutOfLineAndHandles") {
    handle_defs = {
        #0 = event(),
        #1 = channel(),
    },
    value = StructOfTableWith64Ordinals{
        t: TableWith64Ordinals{
            v63: 0xaa,
            v64: 0xbb,
        },
    },
    bytes = {
        v2 = [
            num(66):8, // max ordinal
            repeat(0xff):8, // alloc present
            repeat(0x00):496, // absent envelopes 1..62
            0xaa, padding:3, num(0):2, num(1):2, // envelope 63 (inlined)
            0xbb, padding:3, num(0):2, num(1):2, // envelope 64 (inlined)
            num(8):4, num(1):2, num(0):2, // envelope 65 (unknown OOL + 1 handle)
            repeat(0xff):4, num(1):2, num(1):2, // envelope 66 (unknown inline + 1 handle)
            repeat(0xff):4, repeat(0xdd):4, // envelope 65 payload
        ],
    },
    handles = {
        v2 = [#0, #1],
    },
}

decode_success("SimpleTableWithUnknownEnvelopesThenUint64") {
    value = SimpleTableThenUint64{
        table: SimpleTable{
            y: 67,
        },
        number: 0x0102030405060708,
    },
    bytes = {
        v2 = [
            num(6):8, repeat(0xff):8, // table header
            num(0x0102030405060708):8, // number (inline in struct)
            num(0):8, // envelope 1 (x absent)
            num(99):4, num(0):2, num(1):2, // envelope 2 (unknown inline)
            num(8):4, num(0):2, num(0):2, // envelope 3 (unknown OOL 8B)
            num(0):8, // envelope 4 (absent)
            num(8):4, num(0):2, num(0):2, // envelope 5 (y: 67)
            num(16):4, num(0):2, num(0):2, // envelope 6 (unknown OOL 16B)
            repeat(0xaa):8, // envelope 3 payload
            num(67):8, // envelope 5 payload (y)
            repeat(0xbb):16, // envelope 6 payload
        ],
    },
}

decode_success("TableWithStringAndVectorInterleavedUnknownEnvelopes") {
    value = StructOfTableWithStringAndVector{
        table: TableWithStringAndVector{
            foo: "hi",
            bar: 7,
            baz: [9, 8, 7],
        },
    },
    bytes = {
        v2 = [
            num(5):8, repeat(0xff):8,
            num(24):4, num(0):2, num(0):2, // envelope 1: foo ("hi")
            num(7):4, num(0):2, num(1):2, // envelope 2: bar (7, inlined)
            num(24):4, num(0):2, num(0):2, // envelope 3: baz ([9, 8, 7])
            num(0):4, num(0):2, num(1):2, // envelope 4: unknown inline (zero)
            num(24):4, num(0):2, num(0):2, // envelope 5: unknown OOL 24B
            // foo
            num(2):8, repeat(0xff):8,
            'h', 'i', padding:6,
            // baz
            num(3):8, repeat(0xff):8,
            9, 8, 7, padding:5,
            // unknown ordinal 5
            repeat(0xee):24,
        ],
    },
}

// Interleaves known and unknown envelopes (both inline and out-of-line) with
// handles and secondary string objects, surrounded by struct handles, to verify
// exact depth-first byte and handle traversal order.
decode_success("ResourceTableInterleavedKnownAndUnknownBytesAndHandles") {
    handle_defs = {
        #0 = event(),
        #1 = event(),
        #2 = channel(),
        #3 = event(),
        #4 = event(),
        #5 = event(),
        #6 = channel(),
        #7 = channel(),
        #8 = channel(),
    },
    value = StructOfResourceTableWithHandlesAndVectors{
        before: #0,
        table: ResourceTableWithHandlesAndVectors{
            first_handle: #1,
            middle: [#4],
            last_handle: #6,
        },
        after: #8,
    },
    bytes = {
        v2 = [
            // primary struct (32 bytes)
            repeat(0xff):4, padding:4, // before (#0)
            num(6):8, repeat(0xff):8, // table header
            repeat(0xff):4, padding:4, // after (#8)
            // table envelopes (6 * 8 = 48 bytes)
            repeat(0xff):4, num(1):2, num(1):2, // ord 1: first_handle (#1)
            num(8):4, num(2):2, num(0):2, // ord 2: unknown OOL (8B, #2, #3)
            num(24):4, num(1):2, num(0):2, // ord 3: middle ([#4]: 16B hdr + 8B elem)
            repeat(0xff):4, num(1):2, num(1):2, // ord 4: unknown inline (#5)
            repeat(0xff):4, num(1):2, num(1):2, // ord 5: last_handle (#6)
            num(16):4, num(1):2, num(0):2, // ord 6: unknown OOL (16B, #7)
            // ord 2 unknown OOL payload
            repeat(0xff):8,
            // ord 3 middle (vector header 16B + 1 handle element padded to 8B = 24B)
            num(1):8, repeat(0xff):8,
            repeat(0xff):4, padding:4, // middle[0] (#4)
            // ord 6 unknown OOL payload
            repeat(0xff):4, repeat(0xab):12,
        ],
    },
    handles = {
        v2 = [#0, #1, #2, #3, #4, #5, #6, #7, #8],
    },
}

// Handles in unknown envelopes must be closed without checking subtype or rights,
// even when they have reduced or empty rights.
decode_success("ResourceTableUnknownHandlesWithReducedAndEmptyRightsDropped") {
    handle_defs = {
        #0 = event(rights: transfer),
        #1 = channel(rights: none),
    },
    value = TableFieldUnknownResourceStruct{
        t: TableFieldUnknownResource{},
    },
    bytes = {
        v2 = [
            num(2):8, repeat(0xff):8,
            repeat(0xff):4, num(1):2, num(1):2, // ord 1: inline handle #0
            num(8):4, num(1):2, num(0):2, // ord 2: OOL handle #1
            repeat(0xff):4, padding:4,
        ],
    },
    handles = {
        v2 = [#0, #1],
    },
}

// Tests a known table out-of-line envelope wrapping a flexible union whose own
// envelope is an unknown out-of-line payload with a handle, sandwiched between
// two known table fields carrying out-of-line handle vectors. Verifies
// outer-envelope byte/handle accounting across an inner discarded unknown envelope.
decode_success("TableWithNestedUnionUnknownEnvelopeSandwiched") {
    // TODO(https://fxbug.dev/42166276): Support unknown union variants in remaining GIDL backends.
    bindings_allowlist = [cpp, rust, rust_codec, rust_next],
    handle_defs = {
        #0 = event(),
        #1 = channel(),
        #2 = event(),
    },
    value = StructOfTableWithNestedFlexibleResourceUnion{
        value: TableWithNestedFlexibleResourceUnion{
            before: [#0],
            xu: SampleResourceUnion{
                99: null,
            },
            after: [#2],
        },
    },
    bytes = {
        v2 = [
            num(3):8, repeat(0xff):8, // table header
            num(24):4, num(1):2, num(0):2, // ord 1: before ([#0])
            num(24):4, num(1):2, num(0):2, // ord 2: xu (16B union + 8B unknown, 1 handle #1)
            num(24):4, num(1):2, num(0):2, // ord 3: after ([#2])
            // ord 1: vector<handle:EVENT> ([#0])
            num(1):8, repeat(0xff):8,
            repeat(0xff):4, padding:4,
            // ord 2: SampleResourceUnion (unknown ordinal 99, 8B OOL, 1 handle #1)
            num(99):8,
            num(8):4, num(1):2, num(0):2,
            repeat(0xff):4, repeat(0xab):4,
            // ord 3: vector<handle:EVENT> ([#2])
            num(1):8, repeat(0xff):8,
            repeat(0xff):4, padding:4,
        ],
    },
    handles = {
        v2 = [#0, #1, #2],
    },
}

// Also test a value table (`UnionInTable`) with an inner flexible value union
// (`SampleUnion`) carrying an unknown handle, verifying outer envelope
// accounting on non-resource types via decode_failure on a subsequent UTF-8 string.
decode_failure("ValueTableNestedValueUnionUnknownHandleBeforeInvalidUtf8") {
    handle_defs = {
        #0 = event(),
    },
    type = TestUnionInTable,
    bytes = {
        v2 = [
            num(3):8, repeat(0xff):8, // table header
            num(24):4, num(0):2, num(0):2, // ord 1: before ("pre")
            num(24):4, num(1):2, num(0):2, // ord 2: xu (16B union + 8B valid ASCII, 1 handle #0)
            num(24):4, num(0):2, num(0):2, // ord 3: after (invalid UTF-8)
            // ord 1: "pre"
            num(3):8, repeat(0xff):8,
            'p', 'r', 'e', padding:5,
            // ord 2: SampleUnion (unknown ordinal 99, 8B OOL ASCII, 1 handle #0)
            num(99):8,
            num(8):4, num(1):2, num(0):2,
            'a', 'b', 'c', 'd', 'e', 'f', 'g', 'h',
            // ord 3: invalid UTF-8
            num(2):8, repeat(0xff):8,
            0xff, 0xff, padding:6,
        ],
    },
    handles = {
        v2 = [#0],
    },
    err = STRING_NOT_UTF8,
}

