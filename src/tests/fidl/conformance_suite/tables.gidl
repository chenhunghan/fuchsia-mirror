decode_failure("TableCountOverflow") {
    bindings_denylist = [rust_next],
    type = StructOfSimpleTable,
    bytes = {
        v2 = [
            // count/max ordinal: 0x2000000000000001
            0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x20,
            // presence: FIDL_ALLOC_PRESENT
            0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
            // out-of-line envelope table body: 8 bytes (matching the overflowed size 8)
            0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        ],
    },
    err = TABLE_COUNT_EXCEEDS_32_BIT_LIMIT,
}

success("TableWith64Ordinals") {
    value = StructOfTableWith64Ordinals{
        t: TableWith64Ordinals{
            v63: 0xaa,
            v64: 0xbb,
        },
    },
    bytes = {
        v2 = [
            num(64):8, // max ordinal
            repeat(0xff):8, // alloc present
            repeat(0x00):496, // absent envelopes 1..62 (62 * 8 = 496 bytes)
            0xaa, padding:3, num(0):2, num(1):2, // envelope 63 (inlined)
            0xbb, padding:3, num(0):2, num(1):2, // envelope 64 (inlined)
        ],
    },
}

decode_success("TableWithUnknown65thOrdinal") {
