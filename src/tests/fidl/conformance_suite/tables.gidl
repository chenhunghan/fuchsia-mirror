// num_bytes = 0xfffffff8 is 8-byte aligned; at out-of-line offset 24,
// 24 + 0xfffffff8 wraps in 32-bit arithmetic to 16 <= 32 (message length).
decode_failure("TableUnknownOutOfLineEnvelopeBytesUint32Overflow") {
    // TODO(https://fxbug.dev/42169965): Return INVALID_NUM_BYTES_IN_ENVELOPE in rust.
    // TODO(https://fxbug.dev/579582163): Return InvalidEnvelopeSize in rust_next.
    bindings_denylist = [rust, rust_next],
