load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")

package(default_applicable_licenses = ["//:license"])

fx_cc_binary(
    name = "bin",
    testonly = True,
    srcs = [
        "main.cc",
    ],
    gn_output_name = "client_suite_under_test_hlcpp_async",
    visibility = [":__pkg__"],
    deps = [
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        "//sdk/lib/sys/cpp",
        "//src/tests/fidl/dynsuite/client_suite/fidl:fidl.clientsuite_hlcpp",
        "//src/tests/fidl/dynsuite/client_suite/runners/hlcpp_util",
    ],
)

fx_packaged_binary(
    name = "bin_packaged",
    testonly = True,
    binary = ":bin",
    binary_name = "client_suite_under_test_hlcpp_async",
    visibility = [":__pkg__"],
)

fx_component_manifest(
    name = "manifest",
    testonly = True,
    component_name = "client",
    includes = [
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/client.cml",
    visibility = [":__pkg__"],
)

fx_component(
    name = "client",
    testonly = True,
    compiled_manifest = ":manifest",
    visibility = [":__pkg__"],
    deps = [
        ":bin_packaged",
    ],
)

fx_package(
    name = "hlcpp_async",
    package_name = "fidl_client_suite_hlcpp_async_client",
    testonly = True,
    components = [
        ":client",
    ],
    visibility = [
        "//src/tests/fidl/dynsuite/client_suite:__pkg__",
    ],
)
