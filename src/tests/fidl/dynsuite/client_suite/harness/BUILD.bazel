load("@rules_fuchsia//fuchsia:assembly.bzl", "fuchsia_prebuilt_package")
load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")

package(default_applicable_licenses = ["//:license"])

fx_cc_binary(
    name = "bin",
    testonly = True,
    srcs = [
        "harness.cc",
        "harness.h",
        "ordinals.h",
        "tests/basic_tests.cc",
        "tests/coding_tests.cc",
        "tests/message_header_tests.cc",
        "tests/peer_closed_tests.cc",
        "tests/unknown_interactions_tests.cc",
    ],
    gn_output_name = "client_suite_harness",
    visibility = [":__pkg__"],
    deps = [
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        "//sdk/lib/component/incoming/cpp",
        "//sdk/lib/fdio",
        "//sdk/lib/fidl",
        "//src/lib/fxl",
        "//src/lib/fxl/test:gtest_main",
        "//src/lib/testing/loop_fixture",
        "//src/lib/testing/predicates",
        "//src/tests/fidl/dynsuite/channel_util",
        "//src/tests/fidl/dynsuite/client_suite/fidl:fidl.clientsuite_cpp",
    ],
)

fx_packaged_binary(
    name = "bin_packaged",
    testonly = True,
    binary = ":bin",
    binary_name = "client_suite_harness",
    visibility = [":__pkg__"],
)

fx_component_manifest(
    name = "manifest",
    testonly = True,
    component_name = "harness",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/gtest:default",
    ],
    manifest = "meta/harness.cml",
    visibility = [":__pkg__"],
)

fx_component(
    name = "component",
    testonly = True,
    compiled_manifest = ":manifest",
    visibility = [":__pkg__"],
    deps = [
        ":bin_packaged",
    ],
)

# `fuchsia_prebuilt_package` wraps the GN-built package for Bazel product
# assembly while `fuchsia_package("harness")` remains in `BUILD.gn`.
# @bazel2gn:skip
fuchsia_prebuilt_package(
    name = "harness",
    archive = "@gn_targets//src/tests/fidl/dynsuite/client_suite/harness",
    visibility = ["//products/terminal:__pkg__"],
)
