load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "bin",
    testonly = True,
    srcs = [
        "src/main.rs",
    ],
    binary_name = "server_suite_under_test_rust",
    edition = "2024",
    visibility = [":__pkg__"],
    deps = [
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//src/tests/fidl/dynsuite/server_suite/fidl:fidl.serversuite_rust",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

fx_packaged_binary(
    name = "bin_packaged",
    testonly = True,
    binary = ":bin",
    binary_name = "server_suite_under_test_rust",
    visibility = [":__pkg__"],
)

fx_component_manifest(
    name = "manifest",
    testonly = True,
    component_name = "server",
    includes = [
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/server.cml",
    visibility = [":__pkg__"],
)

fx_component(
    name = "server",
    testonly = True,
    compiled_manifest = ":manifest",
    visibility = [":__pkg__"],
    deps = [
        ":bin_packaged",
    ],
)

fx_package(
    name = "rust",
    package_name = "fidl_server_suite_rust_server",
    testonly = True,
    components = [
        ":server",
    ],
    visibility = [
        "//src/tests/fidl/dynsuite/server_suite:__pkg__",
    ],
)
