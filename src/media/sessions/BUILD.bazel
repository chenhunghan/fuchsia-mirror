load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":mediasession_tests"],
    visibility = ["//src/media:__pkg__"],
)

exports_files(
    ["meta/mediasession.core_shard.cml"],
    visibility = ["//bundles/assembly:__subpackages__"],
)

rustc_binary(
    name = "bin",
    srcs = [
        "src/id.rs",
        "src/interrupter.rs",
        "src/main.rs",
        "src/proxies.rs",
        "src/proxies/observer.rs",
        "src/proxies/player.rs",
        "src/services.rs",
        "src/services/active_session.rs",
        "src/services/discovery.rs",
        "src/services/discovery/filter.rs",
        "src/services/discovery/watcher.rs",
        "src/services/publisher.rs",
        "src/test.rs",
        "src/test/integration.rs",
    ],
    binary_name = "mediasession",
    edition = "2024",
    deps = [
        "//sdk/fidl/fuchsia.media.audio:fuchsia.media.audio_rust",
        "//sdk/fidl/fuchsia.media:fuchsia.media_rust",
        "//sdk/fidl/fuchsia.media.sessions2:fuchsia.media.sessions2_rust",
        "//sdk/rust/zx",
        "//src/lib/async-utils",
        "//src/lib/diagnostics/inspect/runtime/rust",
        "//src/lib/diagnostics/inspect/rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fidl_table_validation",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/mpmc",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

fx_packaged_binary(
    name = "bin_packaged",
    binary = ":bin",
    binary_name = "mediasession",
)

fx_component_manifest(
    name = "component_manifest",
    component_name = "mediasession",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/mediasession.cml",
)

fx_component(
    name = "component",
    compiled_manifest = ":component_manifest",
    deps = [":bin_packaged"],
)

rustc_test(
    name = "bin_test",
    crate = ":bin",
    # Sets GN output_name via bazel2gn to match the original with_unit_tests binary name.
    crate_name = "mediasession_bin_test",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust",
        "//sdk/fidl/fuchsia.logger:fuchsia.logger_rust",
        "//src/lib/diagnostics/reader/rust",
        "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
        "//src/lib/fuchsia-component-test",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:futures-test",
    ],
)

fx_packaged_binary(
    name = "bin_test_packaged",
    testonly = True,
    binary = ":bin_test",
    binary_name = "mediasession_bin_test",
)

fx_component_manifest(
    name = "mediasession_tests_manifest",
    testonly = True,
    component_name = "mediasession_tests",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/sys/component:realm_builder.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/mediasession_bin_test.cml",
)

fx_test_component(
    name = "mediasession_tests_component",
    compiled_manifest = ":mediasession_tests_manifest",
    deps = [":bin_test_packaged"],
)

fx_package(
    name = "mediasession_tests_package",
    package_name = "mediasession_tests",
    components = [
        ":component",
        "//src/lib/fuchsia-component-test/realm_builder_server:realm_builder_server_component",
    ],
    test_components = [":mediasession_tests_component"],
)

fx_test(
    name = "mediasession_tests",
    package = ":mediasession_tests_package",
)
