import("//build/components.gni")
import("//build/test.gni")
import("//build/testing/cc_test_executable.gni")
import("//src/media/audio/hardware.gni")

group("tests") {
  testonly = true

  # This preserves the default audio driver testing (for now).
  deps = [ ":basic" ]
}

group("all") {
  testonly = true

  deps = [
    ":admin",
    ":basic",
  ]

  # Certain test cases (e.g. position accuracy) are disabled by default (enabled
  # by cmdline flag). They have hard realtime constraints; debug and asan builds
  # are too slow.
  if (!is_debug && !is_asan) {
    deps += [ ":realtime" ]
  }
}

fuchsia_unittest_package("basic") {
  package_name = "audio_driver_basic_tests"
  manifest = "meta/audio_driver_basic_tests.cml"
  deps = [
    ":audio_driver_tests_bin",
    "//src/connectivity/bluetooth/tests/audio-device-output-harness",
    "//src/media/audio/drivers/virtual-audio:virtual-audio-driver-component",
    "//src/media/audio/drivers/virtual-audio-legacy:virtual-audio-legacy-driver-component",
  ]

  # This test runs on real hardware or x64 emulators (which include a virtio
  # audio device). It tests real drivers, virtual_audio instances and a
  # virtualized Bluetooth audio driver. This test suite can run on any product,
  # regardless of whether an audio service is already running.
  test_specs = {
    environments = hardware_envs
    if (target_cpu == "x64") {
      environments += [ emu_env ]
    }
  }

  # This non-hermetic suite tests all audio drivers detected on this device, as
  # well as virtual_audio instances and the Bluetooth audio driver library.
  test_type = "device"
}

fuchsia_unittest_package("admin") {
  package_name = "audio_driver_admin_tests"
  manifest = "meta/audio_driver_admin_tests.cml"
  deps = [
    ":audio_driver_tests_bin",
    "//src/connectivity/bluetooth/tests/audio-device-output-harness",
    "//src/media/audio/drivers/virtual-audio:virtual-audio-driver-component",
    "//src/media/audio/drivers/virtual-audio-legacy:virtual-audio-legacy-driver-component",
  ]

  # This test runs on real hardware or x64 emulators (which include a virtio
  # audio device). It tests real drivers, virtual_audio instances and a
  # virtualized Bluetooth audio driver. This test suite can only run on
  # products which do not include audio_device_registry or audio_core.
  test_specs = {
    environments = hardware_envs
    if (target_cpu == "x64") {
      environments += [ emu_env ]
    }
  }

  # This non-hermetic suite tests all audio drivers detected on this device, as
  # well as virtual_audio instances and the Bluetooth audio driver library.
  test_type = "device"
}

fuchsia_unittest_package("realtime") {
  package_name = "audio_driver_realtime_tests"
  manifest = "meta/audio_driver_realtime_tests.cml"
  deps = [
    ":audio_driver_tests_bin",
    "//src/connectivity/bluetooth/tests/audio-device-output-harness",
    "//src/media/audio/drivers/virtual-audio:virtual-audio-driver-component",
    "//src/media/audio/drivers/virtual-audio-legacy:virtual-audio-legacy-driver-component",
  ]

  # This test requires real-time response and thus runs only on real hardware.
  # It tests real drivers, virtual_audio instances and a virtualized Bluetooth
  # audio driver. Like audio_driver_admin_tests, this test suite can run only
  # on products which do not include audio_device_registry or audio_core (or on
  # custom builds that explicitly disable those services).
  test_specs = {
    environments = hardware_envs
  }

  # This non-hermetic suite tests all audio drivers detected on this device, as
  # well as virtual_audio instances and the Bluetooth audio driver library.
  test_type = "device"
}

cc_test_executable("audio_driver_tests_bin") {
  testonly = true
  output_name = "audio_driver_tests"

  sources = [
    "admin_test.cc",
    "admin_test.h",
    "audio_device_enumerator_stub.cc",
    "audio_device_enumerator_stub.h",
    "basic_test.cc",
    "basic_test.h",
    "device_host.cc",
    "device_host.h",
    "durations.h",
    "main.cc",
    "position_test.cc",
    "position_test.h",
    "test_base.cc",
    "test_base.h",
  ]

  # TODO(https://fxbug.dev/483395274): Move fidl dependencies from HLCPP to Natural bindings.
  deps = [
    "//sdk/fidl/fuchsia.component:fuchsia.component_hlcpp",
    "//sdk/fidl/fuchsia.driver.development:fuchsia.driver.development_cpp",
    "//sdk/fidl/fuchsia.driver.framework:fuchsia.driver.framework_cpp",
    "//sdk/fidl/fuchsia.driver.registrar:fuchsia.driver.registrar_cpp",
    "//sdk/fidl/fuchsia.hardware.audio:fuchsia.hardware.audio_cpp",
    "//sdk/fidl/fuchsia.hardware.audio:fuchsia.hardware.audio_hlcpp",
    "//sdk/fidl/fuchsia.logger:fuchsia.logger_hlcpp",
    "//sdk/fidl/fuchsia.media:fuchsia.media_hlcpp",
    "//sdk/fidl/fuchsia.virtualaudio:fuchsia.virtualaudio_hlcpp",
    "//sdk/lib/component/incoming/cpp",
    "//sdk/lib/sys/component/cpp/testing:cpp_library",
    "//sdk/lib/sys/cpp",
    "//src/devices/bind/fuchsia:fuchsia_cpp",
    "//src/lib/fsl",
    "//src/lib/fuchsia-component-test/realm_builder_server:realm_builder_server_component",
    "//src/lib/fxl:fxl_cli",
    "//src/lib/fxl/test:test_settings",
    "//src/lib/testing/loop_fixture",
    "//src/media/audio/lib/test:test_fixture",
    "//zircon/system/public",
    "//zircon/system/ulib/fzl",
    "//zircon/system/ulib/sync:sync-cpp",
  ]
}
