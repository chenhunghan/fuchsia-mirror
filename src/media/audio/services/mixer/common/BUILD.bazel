load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":audio_services_mixer_common_unittests"],
    visibility = ["//src/media:__pkg__"],
)

fx_cc_library(
    name = "common",
    srcs = [
        "global_task_queue.cc",
    ],
    hdrs = [
        "atomic_optional.h",
        "basic_types.h",
        "global_task_queue.h",
        "thread_safe_queue.h",
    ],
    visibility = ["//src/media/audio/services/mixer:__subpackages__"],
    deps = [
        "//sdk/fidl/fuchsia.audio.mixer:fuchsia.audio.mixer_cpp",
        "//sdk/lib/fidl/cpp",
        "//sdk/lib/syslog/cpp",
        "//src/media/audio/lib/clock",
        "//src/media/audio/lib/format2",
        "//src/media/audio/lib/timeline",
    ],
    alwayslink = True,
)

fx_cc_test_binary(
    name = "common_unittests",
    srcs = [
        "atomic_optional_unittest.cc",
        "global_task_queue_unittest.cc",
        "thread_safe_queue_unittest.cc",
    ],
    gn_output_name = "audio_services_mixer_common_unittests",
    deps = [
        ":common",
        "//src/lib/fxl/test:gtest_main",
        # Bazel's gtest target bundles gmock, whereas GN defines gmock separately.
        "@com_google_googletest//:gtest",  # @bazel2gn:path_overwrite://third_party/googletest:gmock
    ],
)

fx_unittest_package(
    name = "audio_services_mixer_common_unittests",
    parallel = 4,
    unit_tests = [":common_unittests"],
)
