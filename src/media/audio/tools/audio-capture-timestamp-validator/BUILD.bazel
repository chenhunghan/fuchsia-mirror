load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")

package(default_applicable_licenses = ["//:license"])

fx_cc_binary(
    name = "bin",
    srcs = ["main.cc"],
    gn_output_name = "audio-capture-timestamp-validator",
    # Uses Zircon and fuchsia.media FIDL APIs, so it only builds for Fuchsia.
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//sdk/fidl/fuchsia.media:fuchsia.media_hlcpp",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        "//sdk/lib/media/audio/cpp",
        "//sdk/lib/sys/cpp",
        "//src/lib/fxl:fxl_cli",
        "//src/media/audio/lib/analysis",
        "//src/media/audio/lib/clock",
        "//src/media/audio/lib/format",
        "//src/media/audio/lib/logging:cli",
        "//src/media/audio/lib/wav",
        "//zircon/system/ulib/fzl",
    ],
)
