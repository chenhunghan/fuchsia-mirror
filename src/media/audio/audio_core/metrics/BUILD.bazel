load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")

package(default_applicable_licenses = ["//:license"])

fx_cc_library(
    name = "metrics",
    srcs = ["metrics_impl.cc"],
    hdrs = [
        "metrics.h",
        "metrics_impl.h",
    ],
    implementation_deps = [
        "//sdk/lib/fdio",
        "//src/lib/callback",
    ],
    visibility = ["//src/media/audio/audio_core:__subpackages__"],
    deps = [
        "//sdk/fidl/fuchsia.metrics:fuchsia.metrics_cpp",
        "//sdk/lib/component/incoming/cpp",
        "//sdk/lib/sys/cpp",
        "//src/lib/fidl/contrib/connection:service_hub_connector",
    ],
    alwayslink = True,
)
