load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":audio_mixer_unittests"],
    visibility = ["//src/media:__pkg__"],
)

fx_cc_library(
    name = "constants",
    hdrs = ["constants.h"],
    deps = ["//src/media/audio/lib/format:constants"],
    alwayslink = True,
)

# TODO(https://fxbug.dev/570694755): Add a //build/config:fast-math build_flags() target.
# @bazel2gn:raw_attribute:configs += ["//build/config:fast-math"]
fx_cc_library(
    name = "mixer",
    srcs = [
        "gain.cc",
        "intersect.cc",
        "mixer.cc",
        "output_producer.cc",
    ],
    hdrs = [
        "gain.h",
        "intersect.h",
        "logging_flags.h",
        "mixer.h",
        "no_op_sampler.h",
        "output_producer.h",
    ],
    # Building without optimizations causes significant slowdowns for these
    # components; the additional CPU load may lead to audio glitches on debug
    # builds. These config settings enable the needed code optimization while
    # maintaining other 'debug' aspects (e.g. DCHECK is still enabled).
    build_flags = ["//build/config:optimize_speed"],
    # Allow some of our loops to be vectorized by the compiler.
    # These flags match //build/config:fast-math in GN.
    # @bazel2gn:skip
    copts = [
        "-fno-math-errno",
        "-fno-rounding-math",
        "-funsafe-math-optimizations",
        "-fno-finite-math-only",
    ],
    implementation_deps = [
        "//src/lib/fxl",
    ],
    visibility = ["//src/media/audio/audio_core:__subpackages__"],
    deps = [
        ":constants",
        "//sdk/fidl/fuchsia.media:fuchsia.media_hlcpp",
        "//sdk/lib/syslog/cpp",
        "//src/media/audio/lib/format",
        "//src/media/audio/lib/format2",
        "//src/media/audio/lib/processing",
        "//src/media/audio/lib/timeline",
        "//zircon/system/ulib/fbl",
        "//zircon/system/ulib/ffl",
        "//zircon/system/ulib/trace",
    ],
    alwayslink = True,
)

fx_cc_test_binary(
    name = "mixer_unittest_bin",
    srcs = [
        "gain_unittest.cc",
        "intersect_unittest.cc",
        "output_producer_unittest.cc",
    ],
    gn_output_name = "audio_mixer_unittests",
    deps = [
        ":mixer",
        "//src/lib/fxl/test:gtest_main",
        "//src/media/audio/lib/format",
        "//src/media/audio/lib/format2",
        "//src/media/audio/lib/processing",
        "//src/media/audio/lib/processing:prebuilt_coefficient_tables",
        "//src/media/audio/lib/test:constants",
        "//zircon/system/ulib/fbl",
        "@com_google_googletest//:gtest",
    ],
)

# TODO(https://fxbug.dev/570694755): Map fx_unittest_package parallel to GN test_specs in bazel2gn.
fx_unittest_package(
    name = "audio_mixer_unittests",
    # @bazel2gn:skip
    parallel = 4,
    unit_tests = [":mixer_unittest_bin"],
)
