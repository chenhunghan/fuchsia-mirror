import("//build/components/fuchsia_package.gni")

group("consumer") {
  deps = [ ":audio_consumer" ]
}

group("tests") {
  testonly = true
  deps = [ ":audio_consumer_tests" ]
}

# TODO(https://fxbug.dev/570694755): Move this package to Bazel once
# //src/media/audio/consumer/bundles:services no longer consumes it in GN.
# This package stays in GN because it is consumed by GN bundles
# (//src/media/audio/consumer/bundles:services) rather than by Bazel assembly.
fuchsia_package("audio_consumer") {
  deps = [ ":audio_consumer_component" ]
}

