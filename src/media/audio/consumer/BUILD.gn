import("//build/tools/bazel2gn/bazel_migration.gni")

executable("audio_consumer_bin") {
  sources = [
    "consumer.cc",
    "consumer.h",
    "consumer_creator.cc",
    "consumer_creator.h",
    "main.cc",
  ]
  output_name = "audio_consumer"
  deps = [
    "//sdk/fidl/fuchsia.media:fuchsia.media_cpp",
    "//sdk/lib/async-loop:async-loop-cpp",
    "//sdk/lib/async-loop:async-loop-default",
    "//sdk/lib/component/incoming/cpp",
    "//sdk/lib/component/outgoing/cpp",
    "//sdk/lib/fit",
    "//sdk/lib/fit-promise",
    "//sdk/lib/media/cpp:no_converters",
    "//sdk/lib/sys/cpp",
    "//src/lib/fsl",
    "//src/lib/fxl",
  ]
}

fuchsia_component_manifest("audio_consumer_manifest") {
  component_name = "audio_consumer"
  manifest = "meta/audio_consumer.cml"
}

fuchsia_component("audio_consumer_component") {
  cm_label = ":audio_consumer_manifest"
  deps = [ ":audio_consumer_bin" ]
}

cc_test_executable("audio_consumer_tests_bin") {
  sources = [
    "consumer.cc",
    "consumer.h",
    "test/audio_consumer_tests.cc",
    "test/fake_audio_core.h",
    "test/fake_audio_renderer.h",
    "test/fake_gain_control.h",
    "test/get_koid.cc",
    "test/get_koid.h",
  ]
  output_name = "audio_consumer_tests"
  deps = [
    "//sdk/fidl/fuchsia.media:fuchsia.media_cpp",
    "//sdk/lib/component/incoming/cpp",
    "//sdk/lib/media/cpp:no_converters",
    "//sdk/lib/sys/cpp",
    "//sdk/lib/syslog/cpp",
    "//src/lib/fxl/test:gtest_main",
    "//src/lib/testing/loop_fixture",
  ]
  testonly = true
  emit_tool_path = false
}

fuchsia_unittest_package("audio_consumer_tests") {
  package_name = "audio_consumer_tests-gn"
  component_name = "audio_consumer_tests"
  deps = [ ":audio_consumer_tests_bin" ]
  test_specs = {
    parallel = 4
  }
}
