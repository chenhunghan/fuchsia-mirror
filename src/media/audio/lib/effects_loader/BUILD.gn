import("//build/components.gni")

# bazel2gn does not translate fx_unittest_package(resources = ...) or
# fx_packaged_binary(), so keep the GN test package hand-written while
# :effects_loader has GN callers.
fuchsia_unittest_package("audio_effects_loader_unittests") {
  package_name = "audio_effects_loader_unittests-gn"
  component_name = "audio_effects_loader_unittests"
  deps = [
    ":test",
    "//src/media/audio/effects/test_effects:test_effects_v1",
  ]

  test_specs = {
    environments = [ emu_env ]
    log_settings = {
      max_severity = "ERROR"
    }
    parallel = 4
  }
}

group("tests") {
  testonly = true
  deps = [ ":audio_effects_loader_unittests" ]
}

