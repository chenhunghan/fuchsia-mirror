load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":audio_effects_loader_unittests"],
    visibility = ["//src/media:__pkg__"],
)

fx_cc_library(
    name = "effects_loader",
    srcs = [
        "effect_v1.cc",
        "effects_loader_v1.cc",
        "effects_loader_v2.cc",
        "effects_module.cc",
        "effects_processor_v1.cc",
    ],
    hdrs = [
        "effect_v1.h",
        "effects_loader_v1.h",
        "effects_loader_v2.h",
        "effects_module.h",
        "effects_processor_v1.h",
    ],
    implementation_deps = [
        "//sdk/lib/component/incoming/cpp",
        "//src/media/audio/lib/timeline",
        "//zircon/system/ulib/trace",
    ],
    # Uses Zircon/FIDL headers and Fuchsia-only //sdk/lib/sys/cpp.
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = [
        "//src/media/audio:__subpackages__",
        "//vendor/google:__subpackages__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.audio.effects:fuchsia.audio.effects_cpp",
        "//sdk/fidl/fuchsia.audio.effects:fuchsia.audio.effects_hlcpp",
        "//sdk/fidl/fuchsia.media:fuchsia.media_hlcpp",
        "//sdk/lib/media/audio/effects",
        "//sdk/lib/sys/cpp",
        "//sdk/lib/syslog/cpp",
        "//zircon/system/ulib/fbl",
    ],
    alwayslink = True,
)

fx_cc_test_binary(
    name = "test",
    srcs = [
        "effect_v1_unittest.cc",
        "effects_loader_v1_unittest.cc",
        "effects_loader_v2_unittest.cc",
        "effects_module_unittest.cc",
        "effects_processor_v1_unittest.cc",
    ],
    gn_output_name = "audio_effects_loader_unittests",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        ":effects_loader",
        "//src/lib/fxl/test:gtest_main",
        "//src/media/audio/effects/test_effects:test_effects_v2",
        "//src/media/audio/lib/effects_loader/testing",
        "//zircon/system/ulib/fzl",
        "@com_google_googletest//:gtest",
    ],
)

# bazel2gn does not translate fx_packaged_binary() or
# fx_unittest_package(resources = ...); the GN test package is defined above
# the sentinel in BUILD.gn while :effects_loader has GN callers.
# @bazel2gn:skip
fx_packaged_binary(
    name = "test_effects_v1_packaged",
    testonly = True,
    binary = "//src/media/audio/effects/test_effects:test_effects_v1",
    binary_name = "test_effects_v1.so",
    install_root = "lib/",
    target_compatible_with = ["@platforms//os:fuchsia"],
)

# @bazel2gn:skip
fx_unittest_package(
    name = "audio_effects_loader_unittests",
    environments = ["//build/testing/environments:emu_env"],
    max_log_severity = "ERROR",
    parallel = 4,
    resources = [":test_effects_v1_packaged"],
    unit_tests = [":test"],
)
