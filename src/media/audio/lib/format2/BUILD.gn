    ":format2",
    "//src/lib/fxl/test:gtest_main",
    "//third_party/googletest:gmock",
  ]
  testonly = true
  emit_tool_path = false
}

fuchsia_unittest_package("audio_lib_format2_unittests") {
  package_name = "audio_lib_format2_unittests-gn"
  component_name = "audio_lib_format2_unittests"
  deps = [ ":unittest-bin" ]
}
