    "channel_mapper.h",
    "format.h",
    "sample_converter.h",
    "stream_converter.h",
  ]
  configs += [ "//build/config:optimize_speed" ]
  deps = [ "//sdk/lib/syslog/cpp" ]
  visibility = [
    ":*",
    "//src/media/audio/*",
  ]
  public_deps = [
    ":fixed",
    "//sdk/fidl/fuchsia.audio:fuchsia.audio_cpp",
    "//sdk/fidl/fuchsia.hardware.audio:fuchsia.hardware.audio_cpp",
    "//sdk/fidl/fuchsia.media:fuchsia.media_cpp",
    "//sdk/fidl/fuchsia.mediastreams:fuchsia.mediastreams_cpp",
    "//sdk/lib/fidl/cpp",
    "//sdk/lib/fit-promise",
    "//src/media/audio/lib/timeline",
  ]
  configs += [ "//build/config:fast-math" ]
}

