import("//build/tools/bazel2gn/bazel_migration.gni")

source_set("coefficient_table") {
  sources = [ "coefficient_table.cc" ]
  public = [ "coefficient_table.h" ]
  visibility = [
    ":*",
    "//src/media/audio/audio_core/test/api:*",
  ]
  public_deps = [
    "//sdk/lib/stdcompat",
    "//sdk/lib/syslog/cpp",
    "//src/media/audio/lib/format2:fixed",
  ]
}

source_set("processing") {
  sources = [
    "filter.cc",
    "point_sampler.cc",
    "position_manager.cc",
    "sampler.cc",
    "sinc_sampler.cc",
  ]
  public = [
    "channel_strip.h",
    "coefficient_table_cache.h",
    "filter.h",
    "flags.h",
    "gain.h",
    "point_sampler.h",
    "position_manager.h",
    "sampler.h",
    "sinc_sampler.h",
  ]
  configs += [
    "//build/config:optimize_speed",
    "//build/config:fast-math",
  ]
  configs -= [ "//build/config:default_optimize" ]
  deps = [
    "//sdk/fidl/fuchsia.audio:fuchsia.audio_cpp",
    "//sdk/lib/syslog/cpp",
    "//zircon/system/ulib/trace",
  ]
  visibility = [
    ":*",
    "//src/media/audio/*",
  ]
  public_deps = [
    ":coefficient_table",
    "//src/lib/fxl",
    "//src/media/audio/lib/format2",
  ]
}

executable("gen_audio_filter_coefficient_tables") {
  sources = [
    "coefficient_table.cc",
    "coefficient_table.h",
    "gen_coefficient_tables.cc",
  ]
  defines = [ "BUILDING_FUCHSIA_AUDIO_HOST_TOOL=1" ]
  deps = [
    "//sdk/lib/stdcompat",
    "//src/media/audio/lib/format2:fixed",
  ]
}

compiled_action("build_coefficient_table_data_prebuilt_cc") {
  outputs = [ "$target_gen_dir/coefficient_table_data_prebuilt.cc" ]
  args = [ rebase_path("$target_gen_dir/coefficient_table_data_prebuilt.cc",
                       root_build_dir) ]
  tool = ":gen_audio_filter_coefficient_tables"
}

cc_test_executable("unittest-bin") {
  sources = [
    "channel_strip_unittest.cc",
    "coefficient_table_cache_unittest.cc",
    "coefficient_table_unittest.cc",
    "filter_unittest.cc",
    "gain_unittest.cc",
    "point_sampler_unittest.cc",
    "position_manager_unittest.cc",
    "sampler_unittest.cc",
    "sinc_sampler_unittest.cc",
  ]
  output_name = "audio_lib_processing_unittests"
  deps = [
    ":coefficient_table",
    ":prebuilt_coefficient_tables",
    ":processing",
    "//sdk/lib/syslog/cpp",
    "//src/lib/fxl/test:gtest_main",
    "//src/media/audio/lib/format2",
    "//third_party/googletest:gtest",
    "//zircon/system/ulib/trace",
  ]
  testonly = true
  emit_tool_path = false
}

fuchsia_unittest_package("audio_lib_processing_unittests") {
  package_name = "audio_lib_processing_unittests-gn"
  component_name = "audio_lib_processing_unittests"
  deps = [ ":unittest-bin" ]
  test_specs = {
    parallel = 4
  }
}

cc_test_executable("death-unittest-bin") {
  sources = [ "sampler_death_unittest.cc" ]
  output_name = "audio_lib_processing_death_unittests"
  deps = [
    ":prebuilt_coefficient_tables",
    ":processing",
    "//sdk/lib/syslog/cpp",
    "//src/lib/fxl/test:gtest_main",
    "//src/media/audio/lib/format2",
    "//third_party/googletest:gtest",
  ]
  testonly = true
  emit_tool_path = false
}

fuchsia_component_manifest("audio_lib_processing_death_unittests_manifest") {
  testonly = true
  component_name = "audio_lib_processing_death_unittests"
  manifest = "meta/audio_libprocessing_death_unittests.cml"
}

fuchsia_test_component("audio_lib_processing_death_unittests_component") {
  cm_label = ":audio_lib_processing_death_unittests_manifest"
  deps = [ ":death-unittest-bin" ]
}

fuchsia_test_package("audio_lib_processing_death_unittests") {
  package_name = "audio_lib_processing_death_unittests-gn"
  test_components = [ ":audio_lib_processing_death_unittests_component" ]
  test_specs = {
    log_settings = {
      max_severity = "FATAL"
    }
    parallel = 4
  }
}
