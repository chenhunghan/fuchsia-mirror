# Clock-related utility functions, for audio tests, tools or drivers

load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":audio_lib_clock_unittests"],
    visibility = ["//src/media:__pkg__"],
)

fx_cc_library(
    name = "clock",
    srcs = [
        "clock_snapshot.cc",
        "clock_synchronizer.cc",
        "clone_mono.cc",
        "logging.cc",
        "pid_control.cc",
        "real_clock.cc",
        "real_timer.cc",
        "recovered_clock.cc",
        "synthetic_clock.cc",
        "synthetic_clock_realm.cc",
        "synthetic_timer.cc",
        "utils.cc",
    ],
    hdrs = [
        "audio_clock_coefficients.h",
        "clock.h",
        "clock_snapshot.h",
        "clock_synchronizer.h",
        "clone_mono.h",
        "logging.h",
        "pid_control.h",
        "real_clock.h",
        "real_timer.h",
        "recovered_clock.h",
        "scoped_unique_lock.h",
        "synthetic_clock.h",
        "synthetic_clock_realm.h",
        "synthetic_timer.h",
        "timer.h",
        "unadjustable_clock_wrapper.h",
        "unreadable_clock.h",
        "utils.h",
    ],
    visibility = [
        "//src/media/audio:__subpackages__",
        "//vendor/google:__subpackages__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.hardware.audio:fuchsia.hardware.audio_hlcpp",
        "//sdk/lib/fit-promise",
        "//sdk/lib/syslog/cpp",
        "//src/lib/fxl",
        "//src/media/audio/lib/timeline",
        "//zircon/system/ulib/affine",
        "//zircon/system/ulib/zircon-internal",
        "//zircon/system/ulib/zx",
        "@com_google_googletest//:gtest_prod",
    ],
    alwayslink = True,
)

fx_cc_test_binary(
    name = "unittest_bin",
    srcs = [
        "clock_snapshot_unittest.cc",
        "clock_synchronizer_unittest.cc",
        "clock_unittest.cc",
        "clone_mono_unittest.cc",
        "pid_control_unittest.cc",
        "real_clock_unittest.cc",
        "real_timer_unittest.cc",
        "recovered_clock_unittest.cc",
        "synthetic_clock_realm_unittest.cc",
        "synthetic_clock_unittest.cc",
        "synthetic_timer_unittest.cc",
        "unadjustable_clock_wrapper_unittest.cc",
        "utils_unittest.cc",
    ],
    gn_output_name = "audio_lib_clock_unittests",
    deps = [
        ":clock",
        "//sdk/lib/syslog/cpp",
        "//src/lib/fxl/test:gtest_main",
        "//src/media/audio/lib/clock/testing",
        "//src/zircon/lib/zircon",
        "//zircon/system/ulib/sync:sync-cpp",
        "@com_google_googletest//:gtest",
    ],
)

fx_unittest_package(
    name = "audio_lib_clock_unittests",
    parallel = 4,
    unit_tests = [":unittest_bin"],
)
