if (is_fuchsia) {
  rustc_test("bin") {
    sources = [
      "src/main.rs",
      "src/test_filing_enable.rs",
      "src/test_snapshot_sanitizing.rs",
      "src/test_snapshot_throttle.rs",
      "src/test_trigger_truth.rs",
    ]
    output_name = "diagnostics_detect_test_cases_bin"
    source_root = "src/main.rs"
    edition = "2024"
    lint_config = "//build/config/rust/lints:clippy_warn_all"
    deps = [
      "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
      "//sdk/fidl/fuchsia.testing.harness:fuchsia.testing.harness_rust",
      "//sdk/rust/zx",
      "//src/diagnostics/detect/integration/realm_factory/fidl/test.detect.factory:fidl_rust",
      "//src/lib/fake-clock/fidl:fidl_rust",
      "//src/lib/fidl/rust/fidl",
      "//src/lib/fuchsia",
      "//src/lib/fuchsia-component",
      "//src/testing/realm_proxy/client",
      "//third_party/rust_crates:anyhow",
      "//third_party/rust_crates:futures",
      "//third_party/rust_crates:log",
      "//third_party/rust_crates:test-case",
    ]
  }
}

fuchsia_component_manifest("component-manifest") {
  testonly = true
  component_name = "test_cases"
  manifest = "meta/test_cases.cml"
}

fuchsia_component("component") {
  testonly = true
  cm_label = ":component-manifest"
  deps = [ ":bin" ]
}
