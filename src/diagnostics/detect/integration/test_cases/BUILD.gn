import("//build/components.gni")

# Kept in GN because //src/diagnostics/detect/integration:pkg references
# :pkg as a subpackage and bazel2gn does not convert non-test fx_package().
fuchsia_package("pkg") {
  testonly = true
  package_name = "diagnostics_detect_test_cases"
  deps = [ ":component" ]
}

