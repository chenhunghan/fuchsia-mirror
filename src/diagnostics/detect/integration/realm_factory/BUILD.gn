import("//build/components.gni")

# Kept in GN because //src/diagnostics/detect/integration:pkg references
# :pkg as a subpackage, its subpackages (//src/lib/fake-clock/svc:pkg and
# ../target:pkg) remain GN-only, and bazel2gn does not convert non-test
# fx_package().
fuchsia_package("pkg") {
  testonly = true
  package_name = "diagnostics_detect_realm_factory"
  deps = [ ":component" ]
  subpackages = [
    "//src/lib/fake-clock/svc:pkg",
    "../target:pkg",
  ]
}

