load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "bin",
    testonly = True,
    srcs = ["src/main.rs"],
    crate_name = "stop_watcher",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    deps = [
        "//src/diagnostics/archivist/tests/integration/realm_factory/fidl:fuchsia.archivist.test_rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/sys/lib/component-events",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

fx_packaged_binary(
    name = "bin_packaged",
    testonly = True,
    binary = ":bin",
    binary_name = "stop_watcher",
)

fx_component_manifest(
    name = "stop-watcher-manifest",
    testonly = True,
    component_name = "stop_watcher",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/stop_watcher.cml",
)

fx_component(
    name = "stop-watcher-component",
    testonly = True,
    compiled_manifest = ":stop-watcher-manifest",
    deps = [":bin_packaged"],
)

fx_package(
    name = "stop_watcher",
    testonly = True,
    components = [":stop-watcher-component"],
    visibility = ["//src/diagnostics/archivist/tests/integration/realm_factory:__pkg__"],
)
