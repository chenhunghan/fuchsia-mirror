load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "bin",
    testonly = True,
    srcs = ["src/main.rs"],
    crate_name = "archivist_test_puppet",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//sdk/fidl/fuchsia.diagnostics.types:fuchsia.diagnostics.types_rust",
        "//sdk/rust/zx",
        "//src/diagnostics/archivist/tests/integration/realm_factory/fidl:fuchsia.archivist.test_rust",
        "//src/lib/diagnostics/hierarchy/rust:diagnostics-hierarchy",
        "//src/lib/diagnostics/inspect/runtime/rust",
        "//src/lib/diagnostics/inspect/rust",
        "//src/lib/diagnostics/inspect/rust/testing:inspect_testing",
        "//src/lib/diagnostics/log/encoding/rust",
        "//src/lib/diagnostics/log/rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fidl_table_validation",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

fx_packaged_binary(
    name = "bin_packaged",
    testonly = True,
    binary = ":bin",
    binary_name = "archivist_test_puppet",
)

fx_component_manifest(
    name = "puppet-manifest",
    testonly = True,
    component_name = "puppet",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/puppet.cml",
)

fx_component(
    name = "puppet-component",
    testonly = True,
    compiled_manifest = ":puppet-manifest",
    deps = [":bin_packaged"],
)

fx_package(
    name = "puppet",
    testonly = True,
    components = [":puppet-component"],
    visibility = ["//src/diagnostics/archivist/tests/integration/realm_factory:__pkg__"],
)
