load("@fuchsia_build_info//:args.bzl", "current_build_target_api_level")
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//sdk/ctf/build:ctf_fx_package.bzl", "ctf_fx_package")

package(default_applicable_licenses = ["//:license"])

rustc_test(
    name = "bin",
    srcs = [
        "src/assert.rs",
        "src/inspect/mod.rs",
        "src/inspect/reader.rs",
        "src/inspect/recursive_glob.rs",
        "src/inspect/truncation.rs",
        "src/lib.rs",
        "src/logs/attribution.rs",
        "src/logs/basic.rs",
        "src/logs/common.rs",
        "src/logs/crash.rs",
        "src/logs/host.rs",
        "src/logs/interest.rs",
        "src/logs/lifecycle.rs",
        "src/logs/lifecycle_stop.rs",
        "src/logs/mod.rs",
        "src/logs/selectors.rs",
        "src/logs/utils.rs",
        "src/puppet.rs",
        "src/test_topology.rs",
        "src/utils.rs",
    ] + ([
        "src/inspect/escrow.rs",
        "src/inspect/sample.rs",
        "src/logs/budget.rs",
    ] if current_build_target_api_level == "PLATFORM" or current_build_target_api_level == "HEAD" else []),
    compile_data = [
        "test_data/pipeline_reader_all_golden.json",
        "test_data/pipeline_reader_nonoverlapping_selectors_golden.json",
        "test_data/pipeline_reader_single_value_golden.json",
        "test_data/unified_reader_all_golden.json",
        "test_data/unified_reader_full_filter_golden.json",
        "test_data/unified_reader_single_value_golden.json",
    ],
    crate_name = "archivist_integration_test_cases",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    proc_macro_deps = [
        "//third_party/rust_crates/vendor:async-trait",
    ],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust",
        "//sdk/fidl/fuchsia.diagnostics.host:fuchsia.diagnostics.host_rust",
        "//sdk/fidl/fuchsia.diagnostics.types:fuchsia.diagnostics.types_rust",
        "//sdk/fidl/fuchsia.logger:fuchsia.logger_rust",
        "//sdk/fidl/fuchsia.testing.harness:fuchsia.testing.harness_rust",
        "//sdk/rust/zx",
        "//src/diagnostics/archivist/tests/integration/realm_factory/fidl:fuchsia.archivist.test_rust",
        "//src/diagnostics/lib/log-command:log-command-ctf",
        "//src/lib/diagnostics/data/rust",
        "//src/lib/diagnostics/reader/rust",
        "//src/lib/diagnostics/selectors",
        "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-runtime",
        "//src/lib/syslog/rust:syslog-listener",
        "//src/testing/realm_proxy/client",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:itertools",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:rand",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:test-case",
    ] + ([
        "//src/lib/diagnostics/inspect/rust",
        "//src/lib/diagnostics/log/message/rust",
        "//third_party/rust_crates/vendor:bumpalo",
    ] if current_build_target_api_level == "PLATFORM" or current_build_target_api_level == "HEAD" else []),
)

fx_packaged_binary(
    name = "bin_packaged_bin",
    testonly = True,
    binary = ":bin",
    binary_name = "archivist_integration_test_cases",
)

fx_component_manifest(
    name = "archivist_integration_test_cases_manifest",
    testonly = True,
    component_name = "test_cases",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
        "//src/testing/realm_client:meta/realm_client.shard.cml",
    ],
    manifest = "meta/test_cases.cml",
)

fx_component(
    name = "archivist_integration_test_cases_component",
    testonly = True,
    compiled_manifest = ":archivist_integration_test_cases_manifest",
    deps = [":bin_packaged_bin"],
)

ctf_fx_package(
    name = "pkg",
    package_name = "archivist_integration_test_cases",
    components = [":archivist_integration_test_cases_component"],
)
