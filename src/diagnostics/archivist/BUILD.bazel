load("@rules_fuchsia//fuchsia:assembly.bzl", "fuchsia_prebuilt_package")
load("//tools/fidl/measure-tape:measure_tape.bzl", "measure_tape")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

exports_files(
    ["meta/archivist.bootstrap_shard.cml"],
    visibility = ["//bundles/assembly:__subpackages__"],
)

# @bazel2gn:skip
fuchsia_prebuilt_package(
    name = "archivist-for-embedding",
    archive = "@gn_targets//src/diagnostics/archivist:archivist-for-embedding",
)

measure_tape(
    name = "logmessage_measure_tape",
    fidls = ["//sdk/fidl/fuchsia.logger"],
    target_binding = "rust",
    target_types = ["fuchsia.logger/LogMessage"],
)
