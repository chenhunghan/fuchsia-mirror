load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

# Any component that formats sensitive network identifiers may call
# `redactor_client::enable` at startup.
rustc_library(
    name = "redactor_client",
    srcs = ["src/lib.rs"],
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    visibility = [
        "//src:__subpackages__",
        "//vendor:__subpackages__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust",
        "//src/diagnostics/lib/redactor",
        "//src/lib/fuchsia-component",
        "//third_party/rust_crates/vendor:log",
    ],
)

rustc_test(
    name = "redactor_client_test",
    crate = ":redactor_client",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    deps = [
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:futures",
    ],
)

fx_unittest_package(
    name = "redactor-client-tests",
    unit_tests = [":redactor_client_test"],
    visibility = ["//src/diagnostics:__subpackages__"],
)
