rustc_library("redactor_client") {
  sources = [ "src/lib.rs" ]
  edition = "2024"
  lint_config = "//build/config/rust/lints:clippy_warn_all"
  visibility = [
    ":*",
    "//src/*",
    "//vendor/*",
  ]
  deps = [
    "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust",
    "//src/diagnostics/lib/redactor",
    "//src/lib/fuchsia-component",
    "//third_party/rust_crates:log",
  ]
}

rustc_test("redactor_client_test") {
  sources = [ "src/lib.rs" ]
  edition = "2024"
  deps = [
           "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust",
           "//src/diagnostics/lib/redactor",
           "//src/lib/fuchsia-component",
           "//third_party/rust_crates:log",
         ] +
         [
           "//src/lib/fidl/rust/fidl",
           "//src/lib/fuchsia",
           "//third_party/rust_crates:futures",
         ]
  lint_config = "//build/config/rust/lints:clippy_warn_all"
}

fuchsia_unittest_package("redactor-client-tests") {
  package_name = "redactor-client-tests-gn"
  component_name = "redactor-client-tests"
  deps = [ ":redactor_client_test" ]
  visibility = [
    ":*",
    "//src/diagnostics/*",
  ]
}
