load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")
load(
    "//build/bazel/rules/testing:fx_unittest_package.bzl",
    "fx_unittest_package",
)

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [
        ":inspect-system-tests",
        ":unittests",
    ],
    visibility = ["//src/diagnostics:__pkg__"],
)

rustc_binary(
    name = "bin",
    srcs = [
        "src/diagnostics.rs",
        "src/main.rs",
        "src/metrics.rs",
    ],
    crate_name = "inspect_system",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    deps = [
        "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust",
        "//sdk/fidl/fuchsia.test:fuchsia.test_rust",
        "//sdk/fidl/fuchsia.test:rust_measure_tape_for_case",
        "//sdk/rust/zx",
        "//src/lib/diagnostics/reader",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/performance/lib/fuchsiaperf",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:serde_json",
    ],
)

fx_packaged_binary(
    name = "bin_packaged",
    testonly = True,
    binary = ":bin",
    binary_name = "inspect_system",
)

fx_component_manifest(
    name = "component_manifest",
    testonly = True,
    component_name = "inspect-system",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/inspect_system.cml",
)

fx_test_component(
    name = "component",
    compiled_manifest = ":component_manifest",
    test_type = "system",
    deps = [":bin_packaged"],
)

fx_package(
    name = "package",
    package_name = "inspect-system-tests",
    test_components = [":component"],
)

# Run with `fx test inspect-system-tests`.
fx_test(
    name = "inspect-system-tests",
    package = ":package",
)

rustc_test(
    name = "bin_test",
    crate = ":bin",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    tags = ["manual"],
)

# Run with `fx test inspect-system-unittests`
fx_unittest_package(
    name = "unittests",
    package_name = "inspect-system-unittests",
    unit_tests = [":bin_test"],
)
