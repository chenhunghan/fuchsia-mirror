load("//build/bazel/rules/fidl:fidl_library.bzl", "fidl_library")

package(default_applicable_licenses = ["//:license"])

fidl_library(
    name = "fuchsia.validate.logs",
    testonly = True,
    srcs = [
        "encoding.fidl",
        "record.fidl",
        "sink.fidl",
    ],
    enable_hlcpp = True,
    excluded_checks = [
        "string-bounds-not-specified",
        "invalid-case-for-constant",
    ],
    visibility = ["//src/diagnostics/validator/logs:__subpackages__"],
    deps = [
        "//sdk/fidl/fuchsia.diagnostics.types",
        "//sdk/fidl/fuchsia.mem",
        "//zircon/vdso/zx",
    ],
)
