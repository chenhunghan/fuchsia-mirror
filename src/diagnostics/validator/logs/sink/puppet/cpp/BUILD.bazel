load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")

package(default_applicable_licenses = ["//:license"])

fx_cc_binary(
    name = "cpp-puppet",
    testonly = True,
    srcs = ["puppet.cc"],
    gn_output_name = "sink_validator_cpp_puppet",
    deps = [
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        "//sdk/lib/fidl",
        "//sdk/lib/sys/cpp",
        "//sdk/lib/syslog/cpp",
        "//src/diagnostics/validator/logs/fidl:fuchsia.validate.logs_hlcpp",
    ],
)

fx_packaged_binary(
    name = "cpp-puppet_packaged",
    testonly = True,
    binary = ":cpp-puppet",
    binary_name = "sink_validator_cpp_puppet",
)

fx_component_manifest(
    name = "component_manifest",
    testonly = True,
    component_name = "puppet",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/puppet.cml",
)

fx_component(
    name = "component",
    testonly = True,
    compiled_manifest = ":component_manifest",
    visibility = ["//src/diagnostics/validator/logs/sink:__pkg__"],
    deps = [":cpp-puppet_packaged"],
)
