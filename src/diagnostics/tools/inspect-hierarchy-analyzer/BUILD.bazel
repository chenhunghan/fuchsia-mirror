load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "inspect-hierarchy-analyzer",
    srcs = ["src/main.rs"],
    edition = "2024",
    visibility = ["//src/diagnostics/tools:__pkg__"],
    deps = [
        "//src/lib/diagnostics/data/rust",
        "//src/lib/diagnostics/inspect/rust",
        "//src/sys/lib/moniker",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:serde_json5",
    ],
)

host_rustc_test(
    name = "inspect_hierarchy_analyzer_bin_test",
    crate = ":inspect-hierarchy-analyzer",
    edition = "2024",
    visibility = ["//src/diagnostics:__pkg__"],
    deps = [
        "//src/lib/diagnostics/hierarchy/rust:diagnostics-hierarchy",
        "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
        "//src/lib/fuchsia",
    ],
)
