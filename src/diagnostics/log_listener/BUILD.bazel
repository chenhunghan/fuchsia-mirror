load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":log_listener_tests"],
    visibility = ["//src/diagnostics:__pkg__"],
)

rustc_binary(
    name = "bin",
    srcs = ["src/main.rs"],
    binary_name = "log_listener",
    build_flags = ["//build/config/rust:bootfs"],
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = [
        "//src/diagnostics:__pkg__",
        "//src/sys/tools/debug-dash-launcher:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust",
        "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust",
        "//sdk/rust/zx",
        "//src/developer/lib/writer:lib",
        "//src/diagnostics/lib/log-command",
        "//src/lib/fdomain/client:flex_fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-runtime",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:argh",
    ],
)

rustc_test(
    name = "bin_test",
    build_flags = ["//build/config/rust:bootfs"],
    crate = ":bin",
    # Sets GN `output_name` to match `bin/log_listener_bin_test` in `meta/log_listener_bin_test.cml`.
    crate_name = "log_listener_bin_test",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
)

fx_packaged_binary(
    name = "bin_packaged_bin",
    testonly = True,
    binary = ":bin",
    binary_name = "log_listener",
)

fx_cc_test_binary(
    name = "log_listener_return_code_test",
    srcs = ["log_listener_return_code_test.cc"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_cpp",
        "//sdk/lib/async-default",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        "//sdk/lib/async_patterns/testing/cpp",
        "//sdk/lib/component/incoming/cpp",
        "//sdk/lib/component/outgoing/cpp",
        "//sdk/lib/fdio",
        "//src/lib/files",
        "//src/lib/fxl/test:gtest_main",
        "//src/zircon/lib/zircon",
        "//zircon/system/ulib/zx",
    ],
)

fx_packaged_binary(
    name = "bin_test_packaged_bin",
    testonly = True,
    binary = ":bin_test",
    binary_name = "log_listener_bin_test",
)

fx_component_manifest(
    name = "log_listener_bin_test_manifest",
    testonly = True,
    component_name = "log_listener_bin_test",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners:tmp_storage.shard.cml",
        "//src/sys/test_runners/rust:default",
    ],
    manifest = "meta/log_listener_bin_test.cml",
)

fx_test_component(
    name = "log_listener_bin_test",
    compiled_manifest = ":log_listener_bin_test_manifest",
    deps = [":bin_test_packaged_bin"],
)

fx_packaged_binary(
    name = "log_listener_return_code_test_packaged_bin",
    testonly = True,
    binary = ":log_listener_return_code_test",
    binary_name = "log_listener_return_code_test",
)

fx_component_manifest(
    name = "log_listener_return_code_test_manifest",
    testonly = True,
    component_name = "log_listener_return_code_test",
    includes = [
        "//sdk/lib/sys/testing:elf_test_runner",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/log_listener_return_code_test.cml",
)

fx_test_component(
    name = "log_listener_return_code_test_component",
    compiled_manifest = ":log_listener_return_code_test_manifest",
    deps = [":log_listener_return_code_test_packaged_bin"],
)

# Bazel-only because bazel2gn does not support `resources` on `fx_package` with `test_components`.
# @bazel2gn:skip
fx_package(
    name = "log_listener_tests_package",
    package_name = "log_listener_tests",
    resources = [":bin_packaged_bin"],
    test_components = [
        ":log_listener_bin_test",
        ":log_listener_return_code_test_component",
    ],
)

fx_test(
    name = "log_listener_tests",
    package = ":log_listener_tests_package",
)
