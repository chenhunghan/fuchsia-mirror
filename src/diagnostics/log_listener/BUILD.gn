import("//build/components.gni")
import("//build/dist/renamed_binary.gni")

renamed_binary("log_bin") {
  keep_original = true
  dest = "bin/log"
  source = "$root_out_dir/log_listener"
  source_deps = [ ":bin" ]
}

# Kept in GN because `:bin` depends on dual-built `rustc_dylib`
# `//src/storage/lib/vfs/rust:vfs`.
fuchsia_package("log_listener_shell_pkg") {
  package_name = "log_listener_shell"
  deps = [
    ":bin",
    ":log_bin",
  ]
}

fuchsia_component("log_listener_bin_test") {
  testonly = true
  manifest = "meta/log_listener_bin_test.cml"
  deps = [ ":bin_test" ]
}

fuchsia_component("log_listener_return_code_test_component") {
  testonly = true
  component_name = "log_listener_return_code_test"
  manifest = "meta/log_listener_return_code_test.cml"
  deps = [ ":log_listener_return_code_test" ]
}

fuchsia_test_package("log_listener_tests_package") {
  package_name = "log_listener_tests-gn"
  test_components = [
    ":log_listener_bin_test",
    ":log_listener_return_code_test_component",
  ]
  deps = [ ":bin" ]
}

group("tests") {
  testonly = true
  deps = [ ":log_listener_tests_package" ]
}

group("log_listener") {
  deps = [ ":bin" ]
}

