import("//build/components.gni")

# See the README for how to run this.
# TODO(https://fxbug.dev/570694755): Migrate fuchsia_package("magma-debug-utils")
# once //bundles/tools moves to Bazel.
fuchsia_package("magma-debug-utils") {
  testonly = true
  deps = [ ":magma-debug-utils-bin" ]
}

group("tools") {
  testonly = true
  deps = [ ":magma-debug-utils" ]
}

