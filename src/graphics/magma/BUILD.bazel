load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")

package(default_applicable_licenses = ["//:license"])

fx_cc_library(
    name = "msd",
    srcs = ["include/lib/magma_service/msd.cc"],
    hdrs = [
        "include/lib/magma_service/msd.h",
        "include/lib/magma_service/msd_c.h",
        "include/lib/magma_service/msd_defs.h",
    ],
    includes = ["include"],
    public_configs = [":msd_config"],
    visibility = [
        "//src/graphics/drivers:__subpackages__",
        "//src/graphics/magma:__subpackages__",
        "//vendor/google:__subpackages__",
    ],
    deps = [
        "//sdk/lib/async",
        "//sdk/lib/magma_common",
        "//sdk/lib/stdcompat",
        "//zircon/system/ulib/inspect",
        "//zircon/system/ulib/zx",
    ],
    alwayslink = True,
)
