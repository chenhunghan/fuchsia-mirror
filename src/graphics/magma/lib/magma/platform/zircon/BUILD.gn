    "//src/graphics/magma/lib/magma/util:short_macros",
    "//zircon/system/ulib/image-format",
    "//zircon/system/ulib/zx",
  ]

  # Fidl bindings should not introduce a dep on libasync-default.so
  assert_no_deps = [ "//sdk/lib/async-default" ]

