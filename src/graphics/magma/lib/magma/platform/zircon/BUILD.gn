  ]
}

# Like ":trace_provider", but uses the shared libtrace-engine.so instead of the
# static trace engine, for processes that already use libtrace-engine.so,
# which must not link a second, static trace engine.
source_set("trace_provider_shared_engine") {
  visibility = [ "..:trace_provider_shared_engine" ]

  configs += [
    "..:platform_include_config",
    "..:tracing",
  ]

  sources = [
    "zircon_platform_trace_provider.cc",
    "zircon_platform_trace_provider.h",
  ]

  deps = [
    "..:trace_provider_header",
    "//sdk/lib/async:async-cpp",
    "//src/graphics/magma/lib/magma/util:macros",
    "//src/graphics/magma/lib/magma/util:short_macros",
  ]

  public_deps = [
    "//sdk/lib/async-loop:async-loop-cpp",
    "//sdk/lib/fit",
    "//zircon/system/ulib/trace-provider",
  ]
}

source_set("trace_provider_with_fdio") {
  configs += [
    "..:platform_include_config",
    "..:tracing",
  ]

  sources = [ "zircon_platform_trace_provider_with_fdio.cc" ]

  deps = [
    ":trace_provider",
    "..:trace_provider_with_fdio_header",
    "//sdk/lib/fdio",
    "//src/graphics/magma/lib/magma/util:macros",
    "//src/graphics/magma/lib/magma/util:short_macros",
  ]

  public_deps = [ "//sdk/lib/fit" ]
}

