# TODO(https://fxbug.dev/570694755): Kept for generated GN :msd public_configs.
config("msd_config") {
  include_dirs = [ "include" ]
}

# TODO(https://fxbug.dev/570694755): Remove once GN callers under
# //src/graphics/magma migrate to Bazel.
config("src_config") {
  visibility = [ "./*" ]
  include_dirs = [ "." ]
}

# This config allows inclusion of headers via relative paths from tests.
# TODO(https://fxbug.dev/570694755): Remove once remaining GN callers migrate.
config("magma_tests_include_config") {
  include_dirs = [ "tests" ]
}

group("tests") {
  testonly = true
  deps = [
    "lib/magma_service/sys_driver_rust:tests",
    "tests",
  ]
}

