import("//build/components.gni")
import("//build/rust/rustc_test.gni")

# TODO(https://fxbug.dev/581431900): Move the integration test to BUILD.bazel
# once Bazel Rust builds set the variant_* cfg feature, so #[should_panic] tests
# don't report LeakSanitizer leaks on sanitizer builders.
rustc_test("globally_ordered_mock_mmio_integration_test_bin") {
  name = "globally_ordered_mock_mmio_integration_test"
  edition = "2024"
  source_root = "tests/integration_test.rs"
  sources = [ "tests/integration_test.rs" ]

  deps = [
    ":globally-ordered-mock-mmio",
    "//sdk/lib/driver/mmio/rust:mmio",
    "//src/lib/fuchsia",
    "//third_party/rust_crates:bitfield",
  ]
}

fuchsia_unittest_package("globally-ordered-mock-mmio-tests") {
  package_name = "globally-ordered-mock-mmio-tests"
  deps = [ ":globally_ordered_mock_mmio_integration_test_bin" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}

group("tests") {
  testonly = true
  deps = [
    ":globally-ordered-mock-mmio-tests",
    ":globally-ordered-mock-mmio-unittests",
  ]
}

