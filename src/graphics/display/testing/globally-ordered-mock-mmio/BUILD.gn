rustc_library("globally-ordered-mock-mmio") {
  testonly = true
  sources = [
    "src/data_access.rs",
    "src/expectation.rs",
    "src/formatting.rs",
    "src/history_entry.rs",
    "src/lib.rs",
    "src/mmio_operand_value.rs",
    "src/mock_builder.rs",
    "src/operation.rs",
    "src/scoreboard.rs",
    "src/source_info.rs",
    "src/trace_builder.rs",
  ]
  edition = "2024"
  visibility = [
    ":*",
    "//vendor/google/*",
  ]
  deps = [
    "//sdk/lib/driver/mmio/rust:mmio",
    "//src/lib/fuchsia-sync",
  ]
}
if (is_fuchsia) {
  rustc_test("globally_ordered_mock_mmio_lib_test") {
    sources = [
      "src/data_access.rs",
      "src/expectation.rs",
      "src/formatting.rs",
      "src/history_entry.rs",
      "src/lib.rs",
      "src/mmio_operand_value.rs",
      "src/mock_builder.rs",
      "src/operation.rs",
      "src/scoreboard.rs",
      "src/source_info.rs",
      "src/trace_builder.rs",
    ]
    edition = "2024"
    deps = [
             "//sdk/lib/driver/mmio/rust:mmio",
             "//src/lib/fuchsia-sync",
           ] +
           [
             "//src/lib/fuchsia",
             "//third_party/rust_crates:bitfield",
           ]
  }
}

fuchsia_unittest_package("globally-ordered-mock-mmio-unittests") {
  package_name = "globally-ordered-mock-mmio-unittests-gn"
  component_name = "globally-ordered-mock-mmio-unittests"
  deps = [ ":globally_ordered_mock_mmio_lib_test" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
  visibility = [
    ":*",
    "//src/graphics/display:*",
  ]
}
