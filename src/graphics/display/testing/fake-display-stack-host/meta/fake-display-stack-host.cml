{
    include: [
        "inspect/client.shard.cml",
        "syslog/client.shard.cml",
        "trace/use.shard.cml",
    ],
    program: {
        runner: "elf",
        binary: "bin/fake-display-stack-host",
    },
    capabilities: [
        { service: "fuchsia.hardware.display.Service" },
    ],
    use: [
        {
            protocol: [ "fuchsia.sysmem2.Allocator" ],
            from: "parent",
        },
        {
            config: "fuchsia.display.testing.ActiveWidthPx",
            key: "active_width_px",
            type: "uint32",
            availability: "transitional",
            default: 1280,
        },
        {
            config: "fuchsia.display.testing.ActiveHeightPx",
            key: "active_height_px",
            type: "uint32",
            availability: "transitional",
            default: 800,
        },
        {
            config: "fuchsia.display.testing.RefreshRateMillihertz",
            key: "refresh_rate_millihertz",
            type: "uint32",
            availability: "transitional",
            default: 60000,
        },
        {
            config: "fuchsia.display.testing.MaxLayerCount",
            key: "max_layer_count",
            type: "uint32",
            availability: "transitional",
            default: 1,
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.display.Service",
            from: "self",
        },
    ],
}
