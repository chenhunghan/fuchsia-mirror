load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":virtio-driver-test-package"],
    visibility = ["//src/graphics/display:__pkg__"],
)

# Driver-side implementation of the virtio 1.x PCI transport, shared by Rust
# virtio drivers.
rustc_library(
    name = "virtio-driver",
    srcs = [
        "src/common.rs",
        "src/common/device_status.rs",
        "src/common/feature_bits.rs",
        "src/common/queue.rs",
        "src/common/queue/abi.rs",
        "src/common/queue/buffer.rs",
        "src/common/queue/descriptor_table.rs",
        "src/common/queue/layout.rs",
        "src/common/queue/rings.rs",
        "src/lib.rs",
        "src/pci.rs",
        "src/pci/bar_map.rs",
        "src/pci/capabilities.rs",
        "src/pci/capability_type.rs",
        "src/pci/common_configuration.rs",
        "src/pci/device.rs",
        "src/pci/pci_notifications.rs",
        "src/pci/pci_queue.rs",
    ],
    edition = "2024",
    visibility = ["//src/graphics/display/drivers/virtio-gpu-display:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.hardware.pci:fuchsia.hardware.pci_rust_next",
        "//sdk/lib/driver/mmio/rust:mmio",
        "//sdk/rust/zx",
        "//sdk/rust/zx-sys",
        "//src/lib/fidl/rust_next/fidl_next",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-runtime",
        "//third_party/rust_crates/vendor:bitfield",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:zerocopy",
    ],
)

rustc_test(
    name = "virtio-driver_test",
    crate = ":virtio-driver",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = ["//src/lib/fuchsia"],
)

fx_unittest_package(
    name = "virtio-driver-test-package",
    package_name = "virtio-driver-rust-test",
    max_log_severity = "ERROR",
    unit_tests = [":virtio-driver_test"],
)
