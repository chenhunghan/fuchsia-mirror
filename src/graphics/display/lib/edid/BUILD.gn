    "eisa_vid_lut.h",
    "internal/iterators.h",
    "timings.h",
  ]
  visibility = [
    ":*",
    "//src/graphics/display/*",
    "//src/lib/eld:*",
    "//src/media/audio/drivers/intel-hda/codecs/hdmi:*",
    "//src/media/audio/drivers/lib/intel-hda:*",
  ]
  public_deps = [
    "//sdk/lib/driver/logging/cpp",
    "//src/graphics/display/lib/api-types/cpp",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/hwreg",
    "//zircon/system/ulib/zx",
  ]
}

cc_test_executable("edid-test") {
  sources = [
    "cta-timing-test.cc",
    "dmt-timing-test.cc",
    "unit-tests.cc",
  ]
  deps = [
    ":edid",
    "//sdk/lib/driver/testing/cpp:scoped_global_logger",
    "//src/graphics/display/lib/edid-values",
    "//src/lib/fxl",
    "//src/lib/fxl/test:gtest_main",
    "//src/lib/testing/predicates",
    "//third_party/googletest:gtest",
  ]
  testonly = true
  emit_tool_path = false
}

fuchsia_unittest_package("edid-test-package") {
  package_name = "edid-test-gn"
  component_name = "edid-test"
  deps = [ ":edid-test" ]
}
