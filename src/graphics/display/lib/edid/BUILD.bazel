load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [
        ":edid-test-package",
    ],
    visibility = ["//src/graphics/display:__pkg__"],
)

fx_cc_library(
    name = "edid",
    srcs = [
        "edid.cc",
        "eisa_vid_lut.cc",
        "internal/iterators.cc",
        "timings.cc",
    ],
    hdrs = [
        "cta-timing.h",
        "dmt-timing.h",
        "edid.h",
        "eisa_vid_lut.h",
        "internal/iterators.h",
        "timings.h",
    ],
    visibility = [
        "//src/graphics/display:__subpackages__",
        "//src/lib/eld:__pkg__",
        "//src/media/audio/drivers/intel-hda/codecs/hdmi:__pkg__",
        "//src/media/audio/drivers/lib/intel-hda:__pkg__",
    ],
    deps = [
        "//sdk/lib/driver/logging/cpp",
        "//src/graphics/display/lib/api-types/cpp",
        "//zircon/system/ulib/fbl",
        "//zircon/system/ulib/hwreg",
        "//zircon/system/ulib/zx",
    ],
    alwayslink = True,
)

fx_cc_test_binary(
    name = "edid-test",
    srcs = [
        "cta-timing-test.cc",
        "dmt-timing-test.cc",
        "unit-tests.cc",
    ],
    deps = [
        ":edid",
        "//sdk/lib/driver/testing/cpp:scoped_global_logger",
        "//src/graphics/display/lib/edid-values",
        "//src/lib/fxl",
        "//src/lib/fxl/test:gtest_main",
        "//src/lib/testing/predicates",
        "@com_google_googletest//:gtest",
    ],
)

fx_unittest_package(
    name = "edid-test-package",
    package_name = "edid-test",
    unit_tests = [":edid-test"],
)
