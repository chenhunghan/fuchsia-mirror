load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":logging-dfv2-tests-test"],
    visibility = ["//src/graphics/display:__pkg__"],
)

fx_cc_library(
    name = "logging",
    hdrs = ["logging.h"],
    deps = [
        # On Fuchsia, //zircon/system/public would shadow the sysroot's
        # <zircon/syscalls.h> without the generated syscalls/gen/*.inc files.
        "//src/zircon/lib/zircon:headers",  # @bazel2gn:path_overwrite://zircon/system/public
    ],
    alwayslink = True,
)

# Headers defining logging macros that are compatible with both DFv1 and DFv2
# runtimes.
fx_cc_library(
    name = "zxlogf",
    hdrs = ["zxlogf.h"],
    visibility = [
        "//src/devices/bus/lib/virtio:__pkg__",
        "//src/devices/lib/goldfish/pipe_io:__pkg__",
        "//src/graphics/display/lib/driver-framework-migration-utils/logging/testing:__pkg__",
    ],
    deps = [":logging"],
    alwayslink = True,
)

# Implementation of the logging compatibility layer for DFv1 drivers.
# If a DFv1 driver has `:zxlogf` in its dependency, it must also add this target
# to its `deps`.
fx_cc_library(
    name = "logging-dfv1",
    srcs = ["logging-dfv1.cc"],
    implementation_deps = [
        "//src/lib/ddk",
        "//zircon/system/public",
    ],
    visibility = [
        "//src/devices/bus/lib/virtio:__pkg__",
        "//src/devices/lib/goldfish/pipe_io:__pkg__",
    ],
    deps = [":logging"],
    alwayslink = True,
)

# Implementation of the logging compatibility layer for DFv2 drivers.
# If a DFv2 driver has `:zxlogf` in its dependency, it must also add this target
# to its `deps`.
fx_cc_library(
    name = "logging-dfv2",
    srcs = ["logging-dfv2.cc"],
    implementation_deps = [
        "//sdk/lib/driver/logging/cpp",
        # On Fuchsia, //zircon/system/public would shadow the sysroot's
        # <zircon/syscalls.h> without the generated syscalls/gen/*.inc files.
        "//src/zircon/lib/zircon:headers",  # @bazel2gn:path_overwrite://zircon/system/public
    ],
    visibility = [
        "//src/devices/bus/lib/virtio:__pkg__",
        "//src/graphics/display/drivers/goldfish-display:__pkg__",
    ],
    deps = [":logging"],
    alwayslink = True,
)

fx_cc_test_binary(
    name = "logging-dfv2-tests-bin",
    srcs = [
        "logging-dfv2-driver-test.cc",
        "logging-dfv2-hardware-module-test.cc",
    ],
    gn_output_name = "logging-dfv2-tests",
    deps = [
        ":logging-dfv2",
        "//sdk/fidl/fuchsia.logger:fuchsia.logger_cpp",
        "//sdk/lib/driver/component/cpp",
        "//sdk/lib/driver/testing/cpp",
        "//sdk/lib/driver/testing/cpp:scoped_global_logger",
        "//src/graphics/display/lib/driver-framework-migration-utils/logging/testing:dfv2-driver-with-logging",
        "//src/graphics/display/lib/driver-framework-migration-utils/logging/testing:logging-hardware-module",
        "//src/lib/diagnostics/fake-log-sink/cpp",
        "//src/lib/fxl/test:gtest_main",
        "//src/lib/testing/predicates",
        "//zircon/system/ulib/zx",
        "@com_google_googletest//:gtest",
    ],
)

fx_packaged_binary(
    name = "logging-dfv2-tests-packaged-bin",
    testonly = True,
    binary = ":logging-dfv2-tests-bin",
    binary_name = "logging-dfv2-tests",
    install_root = "test/",
)

fx_component_manifest(
    name = "logging-dfv2-tests-manifest",
    testonly = True,
    component_name = "logging-dfv2-tests",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/gtest:zxtest.shard.cml",
    ],
    manifest = "meta/logging-dfv2-tests.cml",
)

fx_test_component(
    name = "logging-dfv2-tests-component",
    compiled_manifest = ":logging-dfv2-tests-manifest",
    deps = [":logging-dfv2-tests-packaged-bin"],
)

fx_package(
    name = "logging-dfv2-tests",
    testonly = True,
    test_components = [":logging-dfv2-tests-component"],
)

fx_test(
    name = "logging-dfv2-tests-test",
    max_log_severity = "ERROR",
    package = ":logging-dfv2-tests",
)
