import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_binary("bin") {
  sources = [
    "src/commands.rs",
    "src/commands/bouncing_squares.rs",
    "src/commands/cadence.rs",
    "src/commands/display_color_layer.rs",
    "src/commands/frame_rate_test.rs",
    "src/commands/multilayer_squares.rs",
    "src/commands/static_config_vsync_loop.rs",
    "src/draw.rs",
    "src/fps.rs",
    "src/main.rs",
    "src/mode_selection.rs",
    "src/rgb.rs",
    "src/runner.rs",
    "src/runner_multilayer.rs",
  ]
  output_name = "display-tool"
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.hardware.display.types:fuchsia.hardware.display.types_rust",
    "//sdk/fidl/fuchsia.images2:fuchsia.images2_rust",
    "//sdk/fidl/fuchsia.math:fuchsia.math_rust",
    "//sdk/rust/zx",
    "//src/graphics/display/lib/rust/display-utils",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-image-format",
    "//src/lib/mapped-vmo",
    "//src/lib/trace/rust:trace",
    "//src/lib/trace/rust:trace-provider",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
    "//third_party/rust_crates:euclid",
    "//third_party/rust_crates:futures",
  ]
}
if (is_fuchsia) {
  rustc_test("display_tool_bin_test") {
    sources = [
      "src/commands.rs",
      "src/commands/bouncing_squares.rs",
      "src/commands/cadence.rs",
      "src/commands/display_color_layer.rs",
      "src/commands/frame_rate_test.rs",
      "src/commands/multilayer_squares.rs",
      "src/commands/static_config_vsync_loop.rs",
      "src/draw.rs",
      "src/fps.rs",
      "src/main.rs",
      "src/mode_selection.rs",
      "src/rgb.rs",
      "src/runner.rs",
      "src/runner_multilayer.rs",
    ]
    edition = "2024"
    deps = [
             "//sdk/fidl/fuchsia.hardware.display.types:fuchsia.hardware.display.types_rust",
             "//sdk/fidl/fuchsia.images2:fuchsia.images2_rust",
             "//sdk/fidl/fuchsia.math:fuchsia.math_rust",
             "//sdk/rust/zx",
             "//src/graphics/display/lib/rust/display-utils",
             "//src/lib/fuchsia",
             "//src/lib/fuchsia-async",
             "//src/lib/fuchsia-image-format",
             "//src/lib/mapped-vmo",
             "//src/lib/trace/rust:trace",
             "//src/lib/trace/rust:trace-provider",
             "//third_party/rust_crates:anyhow",
             "//third_party/rust_crates:argh",
             "//third_party/rust_crates:euclid",
             "//third_party/rust_crates:futures",
           ] + [ "//third_party/rust_crates:googletest" ]
    source_root = "src/main.rs"
  }
}

fuchsia_unittest_package("display-tool-test") {
  package_name = "display-tool-test-gn"
  component_name = "display-tool-test"
  deps = [ ":display_tool_bin_test" ]
}
