import("//build/components.gni")

group("tests") {
  testonly = true
  deps = [ ":display-tool-test" ]
}

# TODO(https://fxbug.dev/570694755): Migrate to fx_package once
# //bundles/tools moves to Bazel and //src/storage/lib/vfs/rust:vfs_dylib is no
# longer dual-built across GN and Bazel packages.
fuchsia_package_with_single_component("display-tool") {
  manifest = "meta/display-tool.cml"
  deps = [ ":bin" ]
}

