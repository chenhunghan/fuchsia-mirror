import("//build/components.gni")

# Kept in GN because `:cli` transitively depends on `rustc_dylib`
# `//src/storage/lib/vfs/rust:vfs` via `//src/lib/fuchsia-component`.
fuchsia_package("package") {
  package_name = "powerutil"
  deps = [ ":cli" ]
}

group("tests") {
  testonly = true
  deps = [
    ":lib_fdomain($host_toolchain)",
    ":power_cli_tests",
  ]
}

