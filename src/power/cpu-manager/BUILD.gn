import("//build/components.gni")
import("//build/rust/rustc_binary.gni")
import("//build/rust/rustc_test.gni")
import("//src/power/cpu-manager/node_config/node_config.gni")

cpu_manager_deps = [
  ":cpu-manager-config-lib",
  ":node_config",
  "//sdk/fidl/fuchsia.hardware.cpu.ctrl:fuchsia.hardware.cpu.ctrl_rust",
  "//sdk/fidl/fuchsia.hardware.trippoint:fuchsia.hardware.trippoint_rust",
  "//sdk/fidl/fuchsia.kernel:fuchsia.kernel_rust",
  "//sdk/fidl/fuchsia.power.broker:fuchsia.power.broker_rust",
  "//sdk/fidl/fuchsia.power.cpu:fuchsia.power.cpu_rust",
  "//sdk/fidl/fuchsia.power.cpu.manager:fuchsia.power.cpu.manager_rust",
  "//sdk/fidl/fuchsia.power.powercap:fuchsia.power.powercap_rust",
  "//sdk/fidl/fuchsia.thermal:fuchsia.thermal_rust",
  "//sdk/lib/power/state_recorder/rust",
  "//sdk/rust/zx",
  "//src/lib/async-utils",
  "//src/lib/diagnostics/inspect/contrib/rust",
  "//src/lib/diagnostics/inspect/runtime/rust",
  "//src/lib/diagnostics/inspect/rust",
  "//src/lib/fidl/rust/fidl",
  "//src/lib/fuchsia",
  "//src/lib/fuchsia-async",
  "//src/lib/fuchsia-component",
  "//src/lib/fuchsia-sync",
  "//src/lib/trace/rust:trace",
  "//src/lib/trace/rust:trace-provider",
  "//third_party/rust_crates:anyhow",
  "//third_party/rust_crates:async-lock",
  "//third_party/rust_crates:async-trait",
  "//third_party/rust_crates:futures",
  "//third_party/rust_crates:libm",
  "//third_party/rust_crates:log",
  "//third_party/rust_crates:serde",
  "//third_party/rust_crates:serde_derive",
  "//third_party/rust_crates:serde_json",
  "//third_party/rust_crates:serde_json5",
  "//third_party/rust_crates:strum",
  "//third_party/rust_crates:strum_macros",
  "//third_party/rust_crates:thiserror",
]

cpu_manager_sources = [
  "//src/power/common/lib/common_utils.rs",
  "//src/power/common/lib/types.rs",
  "src/cpu_control_handler.rs",
  "src/cpu_device_handler.rs",
  "src/cpu_manager.rs",
  "src/cpu_manager_main.rs",
  "src/cpu_stats_handler.rs",
  "src/cpu_stats_recorder.rs",
  "src/domain_controller.rs",
  "src/error.rs",
  "src/main.rs",
  "src/message.rs",
  "src/node.rs",
  "src/powercap_watcher.rs",
  "src/syscall_handler.rs",
  "src/test/mock_node.rs",
  "src/test/mod.rs",
  "src/thermal_watcher.rs",
  "src/trippoint_watcher.rs",
  "src/utils.rs",
]

source_set("fake_syscalls") {
  testonly = true
  sources = [ "src/test/fake_syscalls.cc" ]
}

source_set("fake_syscalls_for_integration") {
  testonly = true
  sources = [ "src/test/fake_syscalls_for_integration.cc" ]
}

# Kept in GN because it depends on C++ fake_syscalls and node_config data
# resources.
rustc_test("bin_test") {
  edition = "2024"
  output_name = "cpu_manager_bin_test"
  source_root = "src/main.rs"
  configs += [ "//build/config/rust:bootfs" ]
  deps = cpu_manager_deps + [
           ":fake_syscalls",
           "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
           "//src/lib/test_util",
           "//third_party/rust_crates:assert_matches",
         ]
  sources = cpu_manager_sources
}

# Kept in GN because it depends on //src/lib/fake-clock/lib which is not yet in
# Bazel.
rustc_binary("bin_with_fake_time") {
  testonly = true
  name = "cpu_manager_fake_time"
  edition = "2024"
  with_unit_tests = true
  configs += [ "//build/config/rust:bootfs" ]
  deps = cpu_manager_deps + [ ":fake_syscalls_for_integration" ]
  sources = cpu_manager_sources
  non_rust_deps = [ "//src/lib/fake-clock/lib" ]
}

group("cpu-manager") {
  testonly = true
  deps = [
    ":bin",
    ":tests",
  ]
}

# Kept in GN until all Astro bootfs libvfs users switch to Bazel together:
# Bazel- and GN-built libvfs dylibs don't dedupe, and two copies overflow
# Astro's zircon_a partition (b/583936559).
fuchsia_package("package") {
  package_name = "cpu-manager"
  deps = [ ":component" ]
}

group("tests") {
  testonly = true
  deps = [
    ":cpu-manager-tests",
    "integration/tests",
  ]
}

# Kept in GN because it packages :bin_test which depends on fake_syscalls.
fuchsia_unittest_package("cpu-manager-tests") {
  manifest = "meta/cpu_manager_bin_test.cml"
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
  deps = [
    ":astro",
    ":bin_test",
    ":sherlock",
    ":vim3",
  ]
}

node_config("astro") {
  source = "node_config/astro_node_config.json5"
  output = "astro_node_config.json5"
}

node_config("sherlock") {
  source = "node_config/sherlock_node_config.json5"
  output = "sherlock_node_config.json5"
}

node_config("vim3") {
  source = "node_config/vim3_node_config.json5"
  output = "vim3_node_config.json5"
}

