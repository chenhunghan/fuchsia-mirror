import("//build/components.gni")

group("broker") {
  deps = [ ":package" ]
}

group("tests") {
  testonly = true
  deps = [ ":power-broker-unittests" ]
}

# TODO(https://fxbug.dev/570694755): Kept in GN because many GN packages
# (Starnix tests, integration tests, and the assembly bridge) still consume it.
fuchsia_package("package") {
  package_name = "power-broker"
  deps = [ ":component" ]
}

