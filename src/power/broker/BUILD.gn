import("//build/tools/bazel2gn/bazel_migration.gni")

fuchsia_component_manifest("manifest") {
  component_name = "power-broker"
  manifest = "meta/power_broker.cml"
}

fuchsia_structured_config_rust_lib("broker_config") {
  cm_label = ":manifest"
}

rustc_binary("bin") {
  sources = [
    "src/broker.rs",
    "src/credentials.rs",
    "src/inspect.rs",
    "src/main.rs",
    "src/topology.rs",
  ]
  output_name = "power-broker"
  configs += [ "//build/config/rust:bootfs" ]
  edition = "2024"
  deps = [
    ":broker_config",
    "//sdk/fidl/fuchsia.feedback:fuchsia.feedback_rust",
    "//sdk/fidl/fuchsia.hardware.power.statecontrol:fuchsia.hardware.power.statecontrol_rust",
    "//sdk/fidl/fuchsia.power.broker:fuchsia.power.broker_rust",
    "//sdk/rust/zx",
    "//src/lib/async-utils",
    "//src/lib/diagnostics/inspect/contrib/rust",
    "//src/lib/diagnostics/inspect/format/rust:lib",
    "//src/lib/diagnostics/inspect/runtime/rust",
    "//src/lib/diagnostics/inspect/rust",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-sync",
    "//src/lib/trace/rust:trace",
    "//src/lib/trace/rust:trace-provider",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:either",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:itertools",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:rand",
    "//third_party/rust_crates:rustc-hash",
  ]
}
if (is_fuchsia) {
  rustc_test("bin_test") {
    sources = [
      "src/broker.rs",
      "src/credentials.rs",
      "src/inspect.rs",
      "src/main.rs",
      "src/topology.rs",
    ]
    edition = "2024"
    deps = [
             ":broker_config",
             "//sdk/fidl/fuchsia.feedback:fuchsia.feedback_rust",
             "//sdk/fidl/fuchsia.hardware.power.statecontrol:fuchsia.hardware.power.statecontrol_rust",
             "//sdk/fidl/fuchsia.power.broker:fuchsia.power.broker_rust",
             "//sdk/rust/zx",
             "//src/lib/async-utils",
             "//src/lib/diagnostics/inspect/contrib/rust",
             "//src/lib/diagnostics/inspect/format/rust:lib",
             "//src/lib/diagnostics/inspect/runtime/rust",
             "//src/lib/diagnostics/inspect/rust",
             "//src/lib/fidl/rust/fidl",
             "//src/lib/fuchsia",
             "//src/lib/fuchsia-async",
             "//src/lib/fuchsia-component",
             "//src/lib/fuchsia-sync",
             "//src/lib/trace/rust:trace",
             "//src/lib/trace/rust:trace-provider",
             "//third_party/rust_crates:anyhow",
             "//third_party/rust_crates:either",
             "//third_party/rust_crates:futures",
             "//third_party/rust_crates:itertools",
             "//third_party/rust_crates:log",
             "//third_party/rust_crates:rand",
             "//third_party/rust_crates:rustc-hash",
           ] + [
             "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
             "//src/power/broker/client",
             "//third_party/rust_crates:test-case",
           ]
    source_root = "src/main.rs"
    configs += [ "//build/config/rust:bootfs" ]
    output_name = "power_broker_bin_test"
  }
}

fuchsia_component("component") {
  cm_label = ":manifest"
  visibility = [
    ":*",
    "//examples/power/*",
    "//sdk/lib/driver/power/cpp:*",
    "//src/connectivity/network/tests/integration:*",
    "//src/developer/forensics/exceptions/tests:*",
    "//src/power/*",
  ]
  deps = [ ":bin" ]
}

fuchsia_unittest_package("power-broker-unittests") {
  package_name = "power-broker-unittests-gn"
  component_name = "power-broker-unittests"
  deps = [ ":bin_test" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
