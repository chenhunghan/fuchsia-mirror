load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":power-broker-testing-unittests"],
    visibility = ["//src/power:__pkg__"],
)

rustc_library(
    name = "testing",
    testonly = True,
    srcs = [
        "src/lessor.rs",
        "src/lib.rs",
        "src/runner.rs",
    ],
    crate_name = "power_broker_testing",
    edition = "2024",
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//sdk/fidl/fuchsia.power.broker:fuchsia.power.broker_rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

# @bazel2gn:skip
rustc_test(
    name = "power_broker_testing_lib_test",
    crate = ":testing",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:assert_matches",
    ],
)

# @bazel2gn:skip
fx_unittest_package(
    name = "power-broker-testing-unittests",
    unit_tests = [":power_broker_testing_lib_test"],
)
