load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/components:structured_config.bzl",
    "fuchsia_structured_config_rust_lib",
)
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load(
    "//build/bazel/rules/testing:fx_unittest_package.bzl",
    "fx_unittest_package",
)

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":power-broker-unittests"],
    visibility = ["//src/power:__pkg__"],
)

fx_component_manifest(
    name = "manifest",
    component_name = "power-broker",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
        "//sdk/lib/trace:client.shard",
    ],
    manifest = "meta/power_broker.cml",
)

fuchsia_structured_config_rust_lib(
    name = "broker_config",
    cm_label = ":manifest",
)

rustc_binary(
    name = "bin",
    srcs = [
        "src/broker.rs",
        "src/credentials.rs",
        "src/inspect.rs",
        "src/main.rs",
        "src/topology.rs",
    ],
    binary_name = "power-broker",
    build_flags = ["//build/config/rust:bootfs"],
    edition = "2024",
    deps = [
        ":broker_config",
        "//sdk/fidl/fuchsia.feedback:fuchsia.feedback_rust",
        "//sdk/fidl/fuchsia.hardware.power.statecontrol:fuchsia.hardware.power.statecontrol_rust",
        "//sdk/fidl/fuchsia.power.broker:fuchsia.power.broker_rust",
        "//sdk/rust/zx",
        "//src/lib/async-utils",
        "//src/lib/diagnostics/inspect/contrib/rust",
        "//src/lib/diagnostics/inspect/format/rust:lib",
        "//src/lib/diagnostics/inspect/runtime/rust",
        "//src/lib/diagnostics/inspect/rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-sync",
        "//src/lib/trace/rust:trace",
        "//src/lib/trace/rust:trace-provider",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:either",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:itertools",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:rand",
        "//third_party/rust_crates/vendor:rustc-hash",
    ],
)

# Unit tests for `bin`, built by bazel2gn as the GN target `bin_test`.
rustc_test(
    name = "bin_test",
    build_flags = ["//build/config/rust:bootfs"],
    crate = ":bin",
    # Only bazel2gn uses this, to keep the GN test binary name that
    # `rustc_binary(with_unit_tests = true)` used to generate.
    crate_name = "power_broker_bin_test",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
        "//src/power/broker/client",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

fx_packaged_binary(
    name = "bin_packaged",
    binary = ":bin",
    binary_name = "power-broker",
)

fx_component(
    name = "component",
    compiled_manifest = ":manifest",
    visibility = [
        "//examples/power:__subpackages__",
        "//sdk/lib/driver/power/cpp:__pkg__",
        "//src/connectivity/network/tests/integration:__pkg__",
        "//src/developer/forensics/exceptions/tests:__pkg__",
        "//src/power:__subpackages__",
    ],
    deps = [":bin_packaged"],
)

# Run with `fx test power-broker-unittests`.
fx_unittest_package(
    name = "power-broker-unittests",
    max_log_severity = "ERROR",
    unit_tests = [":bin_test"],
)
