import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_binary("bin") {
  testonly = true
  sources = [ "src/main.rs" ]
  output_name = "fake_domain_controller"
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.power.broker:fuchsia.power.broker_rust",
    "//sdk/fidl/fuchsia.power.cpu:fuchsia.power.cpu_rust",
    "//sdk/rust/zx",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
}

rustc_test("bin_test") {
  sources = [ "src/main.rs" ]
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.power.broker:fuchsia.power.broker_rust",
    "//sdk/fidl/fuchsia.power.cpu:fuchsia.power.cpu_rust",
    "//sdk/rust/zx",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
  source_root = "src/main.rs"
  output_name = "fake_domain_controller_bin_test"
}

fuchsia_component_manifest("manifest") {
  component_name = "fake-domain-controller"
  manifest = "meta/fake_domain_controller.cml"
}

fuchsia_component("component") {
  testonly = true
  cm_label = ":manifest"
  visibility = [
    ":*",
    "//src/power/testing/fake-domain-controller/tests:*",
  ]
  deps = [ ":bin" ]
}

fuchsia_unittest_package("fake-domain-controller-unittests") {
  package_name = "fake-domain-controller-unittests-gn"
  component_name = "fake-domain-controller-unittests"
  deps = [ ":bin_test" ]
}
