import("//build/bazel/bazel_test_suite.gni")
import("//build/components.gni")

# Kept above the sentinel for GN subpackage consumers
# (//src/starnix/tests/thermal) because bazel2gn does not translate fx_package.
fuchsia_package("package") {
  testonly = true
  package_name = "fake-domain-controller"
  deps = [ ":component" ]
}

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/power/testing/fake-domain-controller:fake-domain-controller-unittests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":fake-domain-controller-unittests",
    "tests",
  ]
}

