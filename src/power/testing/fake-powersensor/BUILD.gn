import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_binary("fake_power_sensor_bin") {
  sources = [ "src/lib.rs" ]
  output_name = "fake-power-sensor"
  source_root = "src/lib.rs"
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.hardware.sensors:fuchsia.hardware.sensors_rust",
    "//sdk/fidl/fuchsia.sensors.types:fuchsia.sensors.types_rust",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
}

rustc_test("fake_power_sensor_bin_test") {
  sources = [ "src/lib.rs" ]
  source_root = "src/lib.rs"
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.hardware.sensors:fuchsia.hardware.sensors_rust",
    "//sdk/fidl/fuchsia.sensors.types:fuchsia.sensors.types_rust",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
}

fuchsia_component_manifest("fake_power_sensor_component-manifest") {
  component_name = "fake-power-sensor"
  manifest = "meta/fake-power-sensor.cml"
}

fuchsia_component("fake_power_sensor_component") {
  cm_label = ":fake_power_sensor_component-manifest"
  deps = [ ":fake_power_sensor_bin" ]
}

fuchsia_unittest_package("fake-power-sensor-unittests") {
  package_name = "fake-power-sensor-unittests-gn"
  component_name = "fake-power-sensor-unittests"
  deps = [ ":fake_power_sensor_bin_test" ]
}
