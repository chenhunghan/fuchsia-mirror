import("//build/bazel/bazel_test_suite.gni")
import("//build/components.gni")

# Kept above the sentinel for GN package consumers (`//src/power:drivers` and
# `//bundles/assembly/bazel_inputs/src/power/testing/fake-powersensor`, kept in
# GN so `core_size_limits` shares GN `libvfs_rust.so` across `core.x64`
# packages) because `bazel2gn` does not translate `fx_package`.
fuchsia_package("fake_power_sensor_package") {
  package_name = "fake-power-sensor"
  deps = [ ":fake_power_sensor_component" ]
}

bazel_test_suite("bazel_tests") {
  target_tests =
      [ "//src/power/testing/fake-powersensor:fake-power-sensor-unittests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":fake-power-sensor-unittests",
  ]
}

