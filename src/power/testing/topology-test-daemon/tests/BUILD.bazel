load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":topology-test-daemon-integration-test"],
    visibility = ["//src/power:__pkg__"],
)

rustc_test(
    name = "topology_test_daemon_integration_test",
    srcs = ["src/lib.rs"],
    edition = "2024",
    tags = ["manual"],
    # Device-packaged integration test depending on Fuchsia-only crates.
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//sdk/fidl/fuchsia.power.broker:fuchsia.power.broker_rust",
        "//sdk/fidl/fuchsia.power.topology.test:fuchsia.power.topology.test_rust",
        "//src/lib/diagnostics/reader/rust",
        "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component-test",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:log",
    ],
)

fx_packaged_binary(
    name = "bin_packaged",
    testonly = True,
    binary = ":topology_test_daemon_integration_test",
    # Matches `program.binary` in meta/test.cml.
    binary_name = "topology_test_daemon_integration_test",
)

fx_component_manifest(
    name = "topology-test-daemon-integration-test_manifest",
    testonly = True,
    component_name = "topology-test-daemon-integration-test",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/sys/component:realm_builder.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/test.cml",
)

fx_test_component(
    name = "topology-test-daemon-integration-test_component",
    compiled_manifest = ":topology-test-daemon-integration-test_manifest",
    deps = [":bin_packaged"],
)

fx_package(
    name = "package",
    package_name = "topology-test-daemon-integration-test",
    components = [
        "//src/lib/fuchsia-component-test/realm_builder_server:realm_builder_server_component",
        "//src/power/broker:component",
        "//src/power/testing/topology-test-daemon:component",
    ],
    test_components = [":topology-test-daemon-integration-test_component"],
)

fx_test(
    name = "topology-test-daemon-integration-test",
    package = ":package",
)
