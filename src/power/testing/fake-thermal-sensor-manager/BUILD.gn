import("//build/bazel/bazel_test_suite.gni")
import("//build/components.gni")

# Kept in GN because `bazel2gn` skips `fx_package` and
# `//src/starnix/tests/thermal:starnix_thermal_module_test` includes
# `//src/power/testing/fake-thermal-sensor-manager:package` in `subpackages`.
fuchsia_package("package") {
  testonly = true
  package_name = "fake-thermal-sensor-manager"
  deps = [ ":component" ]
}

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/power/testing/fake-thermal-sensor-manager:fake-thermal-sensor-manager-unittests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":fake-thermal-sensor-manager-unittests",
    "tests",
  ]
}

