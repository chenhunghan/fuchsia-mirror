import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_binary("bin") {
  testonly = true
  sources = [ "src/main.rs" ]
  output_name = "fake_thermal_sensor_manager"
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.hardware.temperature:fuchsia.hardware.temperature_rust",
    "//sdk/fidl/fuchsia.hardware.trippoint:fuchsia.hardware.trippoint_rust",
    "//sdk/fidl/fuchsia.thermal:fuchsia.thermal_rust",
    "//sdk/rust/zx",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
}

rustc_test("bin_test") {
  sources = [ "src/main.rs" ]
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.hardware.temperature:fuchsia.hardware.temperature_rust",
    "//sdk/fidl/fuchsia.hardware.trippoint:fuchsia.hardware.trippoint_rust",
    "//sdk/fidl/fuchsia.thermal:fuchsia.thermal_rust",
    "//sdk/rust/zx",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
  source_root = "src/main.rs"
  output_name = "fake_thermal_sensor_manager_bin_test"
}

fuchsia_component_manifest("manifest") {
  component_name = "fake-thermal-sensor-manager"
  manifest = "meta/fake_thermal_sensor_manager.cml"
}

fuchsia_component("component") {
  testonly = true
  cm_label = ":manifest"
  visibility = [
    ":*",
    "//src/power/testing/fake-thermal-sensor-manager/tests:*",
  ]
  deps = [ ":bin" ]
}

fuchsia_unittest_package("fake-thermal-sensor-manager-unittests") {
  package_name = "fake-thermal-sensor-manager-unittests-gn"
  component_name = "fake-thermal-sensor-manager-unittests"
  deps = [ ":bin_test" ]
}
