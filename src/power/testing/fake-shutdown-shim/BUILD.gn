import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_binary("bin") {
  sources = [ "src/main.rs" ]
  output_name = "fake-shutdown-shim"
  configs += [ "//build/config/rust:bootfs" ]
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.hardware.power.statecontrol:fuchsia.hardware.power.statecontrol_rust",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
}

rustc_test("bin_test") {
  sources = [ "src/main.rs" ]
  edition = "2024"
  deps = [
           "//sdk/fidl/fuchsia.hardware.power.statecontrol:fuchsia.hardware.power.statecontrol_rust",
           "//src/lib/fuchsia",
           "//src/lib/fuchsia-component",
           "//third_party/rust_crates:anyhow",
           "//third_party/rust_crates:futures",
           "//third_party/rust_crates:log",
         ] +
         [
           "//src/lib/fidl/rust/fidl",
           "//src/lib/fuchsia-async",
         ]
  source_root = "src/main.rs"
  output_name = "fake_shutdown_shim_bin_test"
}

fuchsia_component_manifest("fake-shutdown-shim-manifest") {
  component_name = "fake-shutdown-shim"
  manifest = "meta/fake-shutdown-shim.cml"
}

fuchsia_component("fake-shutdown-shim") {
  cm_label = ":fake-shutdown-shim-manifest"
  visibility = [
    ":*",
    "//examples/power/wake_lease/rust:*",
    "//src/connectivity/network/tests/integration:*",
    "//src/developer/forensics/exceptions/tests:*",
    "//src/power/bench/power_framework:*",
    "//src/power/system-activity-governor-controller/tests:*",
    "//src/power/system-activity-governor/fake/tests:*",
    "//src/power/system-activity-governor/integration/testing/realm-factory:*",
  ]
  deps = [ ":bin" ]
}

fuchsia_unittest_package("fake-shutdown-shim-tests") {
  package_name = "fake-shutdown-shim-tests-gn"
  component_name = "fake-shutdown-shim-tests"
  deps = [ ":bin_test" ]
}
