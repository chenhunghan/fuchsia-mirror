import("//build/bazel/bazel_test_suite.gni")
import("//build/components.gni")

# Kept above the sentinel for GN package consumers
# (`//src/power/testing/client:power-framework` and
# `//bundles/assembly/bazel_inputs/src/power/testing/fake-shutdown-shim`, kept
# in GN so `core_with_f2fs` bootfs continues sharing GN `libstd` within the
# `zircon_a` size creep budget) because `bazel2gn` does not translate
# `fx_package`.
fuchsia_package("package") {
  package_name = "fake-shutdown-shim"
  deps = [ ":fake-shutdown-shim" ]
}

bazel_test_suite("bazel_tests") {
  target_tests =
      [ "//src/power/testing/fake-shutdown-shim:fake-shutdown-shim-tests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":fake-shutdown-shim-tests",
  ]
}

