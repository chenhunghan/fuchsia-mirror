load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":mock-test"],
    visibility = ["//src/hwinfo:__pkg__"],
)

rustc_test(
    name = "bin",
    srcs = ["src/main.rs"],
    crate_name = "mock_test",
    edition = "2024",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//sdk/fidl/fuchsia.hwinfo:fuchsia.hwinfo_rust",
        "//sdk/fidl/fuchsia.intl:fuchsia.intl_rust",
        "//src/hwinfo/mock/fidl:fuchsia.hwinfo.mock_rust",
        "//src/hwinfo/mock/integration/testing/fidl:test.mock_rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//src/testing/realm_proxy/client",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:log",
    ],
)

fx_packaged_binary(
    name = "bin_packaged",
    testonly = True,
    binary = ":bin",
    binary_name = "mock_test",
)

fx_component_manifest(
    name = "test-suite-component_manifest",
    testonly = True,
    component_name = "test-suite",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
        "//src/testing/realm_client:meta/realm_client.shard.cml",
    ],
    manifest = "meta/test-suite.cml",
)

fx_component(
    name = "test-suite-component",
    testonly = True,
    compiled_manifest = ":test-suite-component_manifest",
    deps = [":bin_packaged"],
)

fx_package(
    name = "test-suite",
    testonly = True,
    components = [":test-suite-component"],
)

fx_component_manifest(
    name = "test-root_manifest",
    testonly = True,
    component_name = "test-root",
    includes = [
        "//sdk/lib/inspect:offer.shard",
        "//sdk/lib/sys/component:realm_builder.shard",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/test-root.cml",
)

fx_test_component(
    name = "test-root",
    compiled_manifest = ":test-root_manifest",
)

fx_package(
    name = "mock-test-package",
    package_name = "hwinfo-mock-test",
    subpackages = [
        ":test-suite",
        "//src/hwinfo/mock/integration/testing/realm-factory",
    ],
    test_components = [":test-root"],
)

fx_test(
    name = "mock-test",
    max_log_severity = "ERROR",
    package = ":mock-test-package",
)
