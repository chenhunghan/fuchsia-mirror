import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_binary("ptysvc") {
  sources = [
    "src/fifo.rs",
    "src/integration_tests.rs",
    "src/main.rs",
    "src/ptysvc.rs",
  ]
  configs += [ "//build/config/rust:bootfs" ]
  edition = "2024"
  lint_config = "//build/config/rust/lints:clippy_warn_all"
  deps = [
    "//sdk/fidl/fuchsia.device:fuchsia.device_rust",
    "//sdk/fidl/fuchsia.hardware.pty:fuchsia.hardware.pty_rust",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/sys/lib/stdout-to-debuglog/rust:stdout-to-debuglog",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
  ]
}

fuchsia_component_manifest("manifest") {
  component_name = "ptysvc"
  manifest = "meta/ptysvc.cml"
}

fuchsia_component("component") {
  check_includes = false
  cm_label = ":manifest"
  visibility = [
    ":*",
    "//sdk/lib/fdio/tests:*",
    "//src/bringup/bin/virtcon:*",
    "//src/developer/console/test:*",
    "//src/sys/tools/debug-dash-launcher/*",
  ]
  deps = [ ":ptysvc" ]
}
if (is_fuchsia) {
  rustc_test("ptysvc_test") {
    sources = [
      "src/fifo.rs",
      "src/integration_tests.rs",
      "src/main.rs",
      "src/ptysvc.rs",
    ]
    edition = "2024"
    deps = [
             "//sdk/fidl/fuchsia.device:fuchsia.device_rust",
             "//sdk/fidl/fuchsia.hardware.pty:fuchsia.hardware.pty_rust",
             "//sdk/rust/zx",
             "//src/lib/fidl/rust/fidl",
             "//src/lib/fuchsia",
             "//src/lib/fuchsia-async",
             "//src/lib/fuchsia-component",
             "//src/sys/lib/stdout-to-debuglog/rust:stdout-to-debuglog",
             "//third_party/rust_crates:anyhow",
             "//third_party/rust_crates:futures",
           ] +
           [
             "//src/lib/test_util",
             "//third_party/rust_crates:assert_matches",
           ]
    source_root = "src/main.rs"
    configs += [ "//build/config/rust:bootfs" ]
    lint_config = "//build/config/rust/lints:clippy_warn_all"
  }
}

fuchsia_unittest_package("ptysvc-test") {
  package_name = "ptysvc-test-gn"
  component_name = "ptysvc-test"
  deps = [ ":ptysvc_test" ]
}
