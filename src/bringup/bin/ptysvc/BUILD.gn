import("//build/components.gni")

# Kept in GN because GN test packages include it via `subpackages` and `:ptysvc`
# transitively depends on `rustc_dylib` `//src/storage/lib/vfs/rust:vfs`.
fuchsia_package("package") {
  package_name = "ptysvc"
  deps = [ ":component" ]
}

group("tests") {
  testonly = true
  deps = [ ":ptysvc-test" ]
}

