{
    children: [
        {
            name: "device_name_provider",
            url: "fuchsia-boot:///device-name-provider#meta/device-name-provider.cm",
        },
    ],
    offer: [
        {
            config: [
                "fuchsia.device.BootItemInterfaceFlipLowMacBit",
                "fuchsia.device.BootItemInterfaceForNodeName",
                "fuchsia.network.PrimaryInterface",
            ],
            from: "parent",
            to: "#device_name_provider",
            availability: "optional",
        },
        {
            config: [
                "fuchsia.zircon.namegen",
                "fuchsia.zircon.nodename",
            ],
            from: "#kernel-args-forwarder/boot_args",
            to: "#device_name_provider",
            availability: "optional",
        },
        {
            dictionary: "diagnostics",
            from: "self",
            to: "#device_name_provider",
        },
        {
            protocol: [
                "fuchsia.boot.Items",
                "fuchsia.boot.WriteOnlyLog",
            ],
            from: "parent",
            to: "#device_name_provider",
        },
        {
            service: "fuchsia.hardware.network.Service",
            from: "#boot-drivers",
            to: "#device_name_provider",
            availability: "optional",
        },
        {
            service: "fuchsia.hardware.network.Service",
            from: "#base-drivers",
            to: "#device_name_provider",
            availability: "optional",
            source_availability: "unknown",
        },
        {
            protocol: "fuchsia.driver.token.NodeBusTopology",
            from: "#driver_manager",
            to: "#device_name_provider",
        },
        {
            protocol: "fuchsia.device.NameProvider",
            from: "#device_name_provider",
            to: "self/toolbox",
            target_availability: "unknown",
        },
    ],
    expose: [
        {
            protocol: "fuchsia.device.NameProvider",
            from: "#device_name_provider",
        },
    ],
}
