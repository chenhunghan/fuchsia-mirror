import("//build/testing/host_test.gni")

if (is_host) {
  host_test("storage-watchdog-unittests-bin_host_test") {
    binary_path = "$root_out_dir/storage-watchdog-unittests"
    deps = [ ":storage-watchdog-unittests-bin" ]
    target = get_label_info(":storage-watchdog-unittests-bin",
                            "label_with_toolchain")
  }
}

group("tests") {
  testonly = true
  deps = [
    ":storage-watchdog-unittests",
    ":storage-watchdog-unittests-bin_host_test($host_toolchain)",
  ]
}

