  } else {
    public_deps = [ "//zircon/system/public" ]
  }
}
if (is_fuchsia) {
  source_set("storage-watchdog") {
    sources = [
      "archivist_snapshot.cc",
      "storage_watchdog.cc",
      "wedge_dump.cc",
    ]
    public = [
      "archivist_snapshot.h",
      "storage_watchdog.h",
      "wedge_dump.h",
    ]
    deps = [
      ":diagnostics-text",
      "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_cpp",
      "//sdk/fidl/fuchsia.kernel:fuchsia.kernel_cpp",
      "//sdk/lib/component/incoming/cpp",
      "//src/lib/debug:backtrace-request",
      "//src/lib/elf-search",
      "//src/lib/fsl",
      "//zircon/system/ulib/task-utils",
    ]
    visibility = [
      ":*",
      "//src/bringup/bin/critical-services:*",
    ]
    public_deps = [
      ":pager-fault",
      "//zircon/system/ulib/zx",
    ]
  }
}

cc_test_executable("storage-watchdog-unittests-bin") {
  sources = [
    "diagnostics_text_unittest.cc",
    "pager_fault_unittest.cc",
  ]
  output_name = "storage-watchdog-unittests"
  deps = []
  deps += [
    ":diagnostics-text",
    ":pager-fault",
    "//src/lib/fxl/test:gtest_main",
  ]
  if (is_fuchsia) {
    deps += [
      "//sdk/lib/fit",
      "//src/lib/fsl",
      "//zircon/system/ulib/zx",
    ]
  }
  testonly = true
  emit_tool_path = false
}

fuchsia_unittest_package("storage-watchdog-unittests") {
  package_name = "storage-watchdog-unittests-gn"
