import("//build/components.gni")

# Kept in GN because `:console_bin` transitively depends on `rustc_dylib`
# `//src/storage/lib/vfs/rust:vfs` via `//src/lib/fuchsia-component`.
fuchsia_package("package") {
  package_name = "console"
  deps = [ ":component" ]
}

group("tests") {
  testonly = true
  deps = [ ":console-test-pkg" ]
}

