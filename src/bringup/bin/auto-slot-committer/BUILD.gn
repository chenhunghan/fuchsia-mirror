import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_binary("bin") {
  sources = [ "src/main.rs" ]
  output_name = "auto_slot_committer"
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.paver:fuchsia.paver_rust",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//src/sys/lib/stdout-to-debuglog/rust",
    "//third_party/rust_crates:anyhow",
  ]
}
if (is_fuchsia) {
  rustc_test("bin_test") {
    sources = [ "src/main.rs" ]
    edition = "2024"
    deps = [
             "//sdk/fidl/fuchsia.paver:fuchsia.paver_rust",
             "//sdk/rust/zx",
             "//src/lib/fidl/rust/fidl",
             "//src/lib/fuchsia",
             "//src/lib/fuchsia-component",
             "//src/sys/lib/stdout-to-debuglog/rust",
             "//third_party/rust_crates:anyhow",
           ] + [ "//third_party/rust_crates:futures" ]
    source_root = "src/main.rs"
    output_name = "auto_slot_committer_bin_test"
  }
}

fuchsia_unittest_package("auto-slot-committer-tests") {
  package_name = "auto-slot-committer-tests-gn"
  component_name = "auto-slot-committer-tests"
  deps = [ ":bin_test" ]
}

fuchsia_component_manifest("manifest") {
  component_name = "auto-slot-committer"
  manifest = "meta/auto-slot-committer.cml"
}

fuchsia_component("auto-slot-committer-component") {
  check_includes = false
  cm_label = ":manifest"
  deps = [ ":bin" ]
}
