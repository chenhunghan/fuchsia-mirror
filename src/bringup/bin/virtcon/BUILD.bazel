load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
    "fx_test_component",
)
load(
    "//build/bazel/rules/components:structured_config.bzl",
    "fuchsia_structured_config_rust_lib",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/packages:resources.bzl", "resource")
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":virtual_console_tests_test"],
    visibility = ["//src/bringup:__pkg__"],
)

exports_files(
    ["meta/virtual-console.shard.cml"],
    visibility = ["//bundles/assembly:__subpackages__"],
)

fx_component_manifest(
    name = "manifest",
    component_name = "virtual-console",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/virtual-console.cml",
)

fuchsia_structured_config_rust_lib(
    name = "virtcon_config",
    cm_label = ":manifest",
)

# Mandatory portion of virtcon that's included in all products.
fx_component(
    name = "component",
    compiled_manifest = ":manifest",
    deps = [":bin_packaged"],
)

rustc_library(
    name = "lib",
    srcs = [
        "src/app.rs",
        "src/args.rs",
        "src/colors.rs",
        "src/lib.rs",
        "src/log.rs",
        "src/logo.rs",
        "src/session_manager.rs",
        "src/terminal.rs",
        "src/text_grid.rs",
        "src/view.rs",
    ],
    crate_name = "virtual_console_lib",
    edition = "2024",
    deps = [
        ":virtcon_config",
        "//sdk/fidl/fuchsia.hardware.display:fuchsia.hardware.display_rust",
        "//sdk/fidl/fuchsia.hardware.power.statecontrol:fuchsia.hardware.power.statecontrol_rust",
        "//sdk/fidl/fuchsia.hardware.pty:fuchsia.hardware.pty_rust",
        "//sdk/fidl/fuchsia.input:fuchsia.input_rust",
        "//sdk/fidl/fuchsia.virtualconsole:fuchsia.virtualconsole_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-runtime",
        "//src/lib/pty",
        "//src/lib/trace/rust:trace",
        "//src/lib/ui/carnelian",
        "//src/lib/ui/terminal",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:vt100",
    ],
)

rustc_test(
    name = "lib_test",
    crate = ":lib",
    # Preserves the GN test binary name from `rustc_library(name = "virtual_console_lib", with_unit_tests = true)`.
    crate_name = "virtual_console_lib_lib_test",
    target_compatible_with = ["@platforms//os:fuchsia"],
)

rustc_binary(
    name = "bin",
    srcs = ["src/main.rs"],
    binary_name = "virtual_console",
    build_flags = ["//build/config/rust:bootfs"],
    edition = "2024",
    deps = [
        ":lib",
        ":virtcon_config",
        "//sdk/fidl/fuchsia.boot:fuchsia.boot_rust",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/trace/rust:trace-provider",
        "//src/lib/ui/carnelian",
        "//src/sys/lib/stdout-to-debuglog/rust",
        "//third_party/rust_crates/vendor:anyhow",
    ],
)

fx_packaged_binary(
    name = "bin_packaged",
    binary = ":bin",
    binary_name = "virtual_console",
)

resource(
    name = "font_test",
    src = "data/test.ttf",
    dest = "data/font.ttf",
)

fx_packaged_binary(
    name = "lib_test_packaged_bin",
    testonly = True,
    binary = ":lib_test",
    binary_name = "virtual_console_lib_lib_test",
)

fx_component_manifest(
    name = "virtual_console_tests_manifest",
    testonly = True,
    component_name = "virtual_console_tests_component",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/inspect:offer.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/virtual-console-tests.cml",
)

fx_test_component(
    name = "virtual_console_tests_component",
    compiled_manifest = ":virtual_console_tests_manifest",
    deps = [
        ":font_test",
        ":lib_test_packaged_bin",
    ],
)

fx_package(
    name = "virtual_console_tests",
    testonly = True,
    components = ["//src/bringup/bin/ptysvc:component"],
    test_components = [":virtual_console_tests_component"],
)

fx_test(
    name = "virtual_console_tests_test",
    package = ":virtual_console_tests",
)
