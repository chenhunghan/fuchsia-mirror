import("//build/tools/bazel2gn/bazel_migration.gni")

fuchsia_component_manifest("manifest") {
  component_name = "virtual-console"
  manifest = "meta/virtual-console.cml"
}

fuchsia_structured_config_rust_lib("virtcon_config") {
  cm_label = ":manifest"
}

fuchsia_component("component") {
  cm_label = ":manifest"
  deps = [ ":bin" ]
}

rustc_library("lib") {
  sources = [
    "src/app.rs",
    "src/args.rs",
    "src/colors.rs",
    "src/lib.rs",
    "src/log.rs",
    "src/logo.rs",
    "src/session_manager.rs",
    "src/terminal.rs",
    "src/text_grid.rs",
    "src/view.rs",
  ]
  crate_name = "virtual_console_lib"
  edition = "2024"
  deps = [
    ":virtcon_config",
    "//sdk/fidl/fuchsia.hardware.display:fuchsia.hardware.display_rust",
    "//sdk/fidl/fuchsia.hardware.power.statecontrol:fuchsia.hardware.power.statecontrol_rust",
    "//sdk/fidl/fuchsia.hardware.pty:fuchsia.hardware.pty_rust",
    "//sdk/fidl/fuchsia.input:fuchsia.input_rust",
    "//sdk/fidl/fuchsia.virtualconsole:fuchsia.virtualconsole_rust",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-runtime",
    "//src/lib/pty",
    "//src/lib/trace/rust:trace",
    "//src/lib/ui/carnelian",
    "//src/lib/ui/terminal",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:vt100",
  ]
}
if (is_fuchsia) {
  rustc_test("lib_test") {
    sources = [
      "src/app.rs",
      "src/args.rs",
      "src/colors.rs",
      "src/lib.rs",
      "src/log.rs",
      "src/logo.rs",
      "src/session_manager.rs",
      "src/terminal.rs",
      "src/text_grid.rs",
      "src/view.rs",
    ]
    edition = "2024"
    deps = [
      ":virtcon_config",
      "//sdk/fidl/fuchsia.hardware.display:fuchsia.hardware.display_rust",
      "//sdk/fidl/fuchsia.hardware.power.statecontrol:fuchsia.hardware.power.statecontrol_rust",
      "//sdk/fidl/fuchsia.hardware.pty:fuchsia.hardware.pty_rust",
      "//sdk/fidl/fuchsia.input:fuchsia.input_rust",
      "//sdk/fidl/fuchsia.virtualconsole:fuchsia.virtualconsole_rust",
      "//sdk/rust/zx",
      "//src/lib/fidl/rust/fidl",
      "//src/lib/fuchsia-async",
      "//src/lib/fuchsia-component",
      "//src/lib/fuchsia-runtime",
      "//src/lib/pty",
      "//src/lib/trace/rust:trace",
      "//src/lib/ui/carnelian",
      "//src/lib/ui/terminal",
      "//third_party/rust_crates:anyhow",
      "//third_party/rust_crates:futures",
      "//third_party/rust_crates:vt100",
    ]
    output_name = "virtual_console_lib_lib_test"
  }
}

rustc_binary("bin") {
  sources = [ "src/main.rs" ]
  output_name = "virtual_console"
  configs += [ "//build/config/rust:bootfs" ]
  edition = "2024"
  deps = [
    ":lib",
    ":virtcon_config",
    "//sdk/fidl/fuchsia.boot:fuchsia.boot_rust",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/lib/trace/rust:trace-provider",
    "//src/lib/ui/carnelian",
    "//src/sys/lib/stdout-to-debuglog/rust",
    "//third_party/rust_crates:anyhow",
  ]
}

resource("font_test") {
  sources = [ "data/test.ttf" ]
  outputs = [ "data/font.ttf" ]
}

fuchsia_component_manifest("virtual_console_tests_manifest") {
  testonly = true
  component_name = "virtual_console_tests_component"
  manifest = "meta/virtual-console-tests.cml"
}

fuchsia_test_component("virtual_console_tests_component") {
  cm_label = ":virtual_console_tests_manifest"
  deps = [
    ":font_test",
    ":lib_test",
  ]
}

fuchsia_test_package("virtual_console_tests") {
  package_name = "virtual_console_tests-gn"
  test_components = [ ":virtual_console_tests_component" ]
  deps = [ "//src/bringup/bin/ptysvc:component" ]
}
