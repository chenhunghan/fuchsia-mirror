import("//build/bazel/bazel_test_suite.gni")
import("//build/components.gni")
import("//build/dist/renamed_binary.gni")

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/bringup/bin/bootpkg:bootpkg-lib-tests" ]
}

group("tests") {
  testonly = true

  deps = [
    ":bazel_tests",
    ":bootpkg-test",
  ]
}

fuchsia_package("package") {
  package_name = "bootpkg"
  deps = [ ":bootpkg" ]
}

# Installs the generated `cc_test_executable` at `test/bootpkg-test`, where
# meta/bootpkg-test.cml expects it (GN `test()` installed it there before).
renamed_binary("bootpkg-test-renamed") {
  testonly = true
  visibility = [ ":*" ]
  source = "$root_out_dir/bootpkg-test"
  source_deps = [ ":bootpkg-test-bin" ]
  dest = "test/bootpkg-test"
}

fuchsia_unittest_package("bootpkg-test") {
  manifest = "meta/bootpkg-test.cml"
  deps = [
    ":bootpkg",
    ":bootpkg-test-renamed",
  ]
  test_type = "system"
}

