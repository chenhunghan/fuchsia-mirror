import("//build/assembly/bootfs_files_for_assembly.gni")
import("//build/bazel/bazel_test_suite.gni")
import("//build/dist/resource.gni")

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    "bin:tests",
    "lib:tests",
  ]
}

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/bringup:target_tests" ]
}

group("boot_tests") {
  testonly = true
  deps = [
    "bin:boot_tests",
    "lib:boot_tests",
  ]
}

bootfs_files_for_assembly("bootfs") {
  deps = [ ":bringup-config" ]
}

resource("bringup-config") {
  sources = [ "config/bringup.profiles" ]
  outputs = "config/profiles/bringup.profiles"
}
