import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("uart_fpl") {
  sources = [
    "src/error.rs",
    "src/frame.rs",
    "src/handshake.rs",
    "src/lib.rs",
    "src/parser.rs",
    "src/resend_sp.rs",
    "src/window.rs",
  ]
  edition = "2024"
  visibility = [
    ":*",
    "//src/developer/ffx/tests/uart:*",
    "//src/developer/ffx/tools/uart:*",
    "//src/developer/ffx/tools/uart_driver/impl:*",
    "//src/developer/lib:*",
    "//src/developer/remote-control/fdomain-uart-driver:*",
  ]
  deps = [
    "//third_party/rust_crates:crc32fast",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:thiserror",
    "//third_party/rust_crates:zerocopy",
  ]
}

rustc_test("uart_fpl_test") {
  sources = [
    "src/error.rs",
    "src/frame.rs",
    "src/handshake.rs",
    "src/lib.rs",
    "src/parser.rs",
    "src/resend_sp.rs",
    "src/window.rs",
  ]
  edition = "2024"
  deps = [
           "//third_party/rust_crates:crc32fast",
           "//third_party/rust_crates:futures",
           "//third_party/rust_crates:log",
           "//third_party/rust_crates:thiserror",
           "//third_party/rust_crates:zerocopy",
         ] + [ "//src/lib/fuchsia" ]
}

fuchsia_unittest_package("uart-fpl-target-tests") {
  package_name = "uart-fpl-target-tests-gn"
  component_name = "uart-fpl-target-tests"
  deps = [ ":uart_fpl_test" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
