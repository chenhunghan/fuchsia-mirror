import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/developer/lib/uart_fpl:uart-fpl-target-tests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":uart_fpl_test($host_toolchain)",
  ]
  if (is_fuchsia) {
    deps += [ ":uart-fpl-target-tests" ]
  }
}

