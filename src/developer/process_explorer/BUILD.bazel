load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)

package(default_applicable_licenses = ["//:license"])

exports_files(
    ["meta/process_explorer.core_shard.cml"],
    visibility = ["//bundles/assembly:__subpackages__"],
)

fx_cc_library(
    name = "lib",
    srcs = [
        "process_data.cc",
        "process_explorer.cc",
        "task_hierarchy_data.cc",
    ],
    hdrs = [
        "process_data.h",
        "process_explorer.h",
        "task_hierarchy_data.h",
    ],
    implementation_deps = [
        "//sdk/lib/syslog/cpp",
        "//src/lib/fsl",
        "//third_party/rapidjson",
        "//zircon/system/ulib/inspector",
        "//zircon/system/ulib/task-utils",
    ],
    visibility = ["//src/developer/process_explorer/tests:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.process.explorer:fuchsia.process.explorer_cpp",
        "//sdk/lib/component/outgoing/cpp",
        "//src/lib/fxl:fxl_cli",
    ],
    alwayslink = True,
)

fx_cc_binary(
    name = "bin",
    srcs = ["main.cc"],
    gn_output_name = "process_explorer",
    deps = [
        ":lib",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        "//sdk/lib/syslog/cpp",
    ],
)

fx_packaged_binary(
    name = "bin_packaged",
    binary = ":bin",
    binary_name = "process_explorer",
)

fx_component_manifest(
    name = "process_explorer_manifest",
    component_name = "process_explorer",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/process_explorer.cml",
)

fx_component(
    name = "process_explorer_component",
    compiled_manifest = ":process_explorer_manifest",
    visibility = ["//src/developer/process_explorer/tests:__pkg__"],
    deps = [":bin_packaged"],
)
