import("//build/components.gni")

# Kept in BUILD.gn because switching //bundles/assembly/BUILD.bazel directly to
# a native Bazel fx_package pulls //third_party/rapidjson:rapidjson and
# @com_google_googletest//:gtest_prod (via //src/lib/fxl) into release
# verify_licenses_collection before they carry applicable_licenses metadata.
fuchsia_package("process_explorer_package") {
  package_name = "process_explorer"
  deps = [ ":process_explorer_component" ]
}

group("tests") {
  testonly = true
  deps = [ "//src/developer/process_explorer/tests" ]
}

