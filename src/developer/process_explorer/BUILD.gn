source_set("lib") {
  sources = [
    "process_data.cc",
    "process_explorer.cc",
    "task_hierarchy_data.cc",
  ]
  public = [
    "process_data.h",
    "process_explorer.h",
    "task_hierarchy_data.h",
  ]
  deps = [
    "//sdk/lib/syslog/cpp",
    "//src/lib/fsl",
    "//third_party/rapidjson",
    "//zircon/system/ulib/inspector",
    "//zircon/system/ulib/task-utils",
  ]
  visibility = [
    ":*",
    "//src/developer/process_explorer/tests:*",
  ]
  public_deps = [
    "//sdk/fidl/fuchsia.process.explorer:fuchsia.process.explorer_cpp",
    "//sdk/lib/component/outgoing/cpp",
    "//src/lib/fxl:fxl_cli",
  ]
}

executable("bin") {
  sources = [ "main.cc" ]
  output_name = "process_explorer"
  deps = [
    ":lib",
    "//sdk/lib/async-loop:async-loop-cpp",
    "//sdk/lib/async-loop:async-loop-default",
    "//sdk/lib/syslog/cpp",
  ]
}

fuchsia_component_manifest("process_explorer_manifest") {
  component_name = "process_explorer"
  manifest = "meta/process_explorer.cml"
}

fuchsia_component("process_explorer_component") {
  cm_label = ":process_explorer_manifest"
  visibility = [
    ":*",
    "//src/developer/process_explorer/tests:*",
  ]
  deps = [ ":bin" ]
}
