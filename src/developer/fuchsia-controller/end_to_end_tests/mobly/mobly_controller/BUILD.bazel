load("@rules_python//python:py_library.bzl", "py_library")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")

package(default_applicable_licenses = ["//:license"])

py_library(
    name = "mobly_controller",
    testonly = True,
    srcs = [
        "__init__.py",
        "fuchsia_device.py",
    ],
    imports = [".."],
    # Bazel only registers a host Python toolchain; GN python_library is not gated on is_host.
    target_compatible_with = HOST_OS_CONSTRAINTS,  # @bazel2gn:skip
    visibility = ["//src/developer/fuchsia-controller/end_to_end_tests/mobly:__pkg__"],
)
