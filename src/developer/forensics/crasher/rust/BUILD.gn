import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_binary("crasher_exe") {
  sources = [ "src/main.rs" ]
  output_name = "rust_crasher"
  edition = "2024"
  deps = [
    "//src/lib/fuchsia-async",
    "//third_party/rust_crates:argh",
  ]
}

fuchsia_component_manifest("rust_crasher_manifest") {
  component_name = "rust_crasher"
  manifest = "meta/crasher.cml"
}

fuchsia_component("rust_crasher") {
  cm_label = ":rust_crasher_manifest"
  visibility = [
    ":*",
    "//src/developer/forensics/crasher:*",
  ]
  deps = [ ":crasher_exe" ]
}

rustc_test("crasher_exe_test") {
  sources = [ "src/main.rs" ]
  edition = "2024"
  deps = [
           "//src/lib/fuchsia-async",
           "//third_party/rust_crates:argh",
         ] + [ "//src/lib/fuchsia" ]
  source_root = "src/main.rs"
  output_name = "rust_crasher_bin_test"
}
