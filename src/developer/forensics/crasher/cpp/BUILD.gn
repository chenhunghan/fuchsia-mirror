import("//build/tools/bazel2gn/bazel_migration.gni")

executable("crasher_exe") {
  sources = [
    "cpp_specific.cc",
    "crasher.c",
  ]
  configs += [ "//build/cpp:fidl-wire-deprecated-mutable-tables" ]
  defines = [ "_ALL_SOURCE" ]
  output_name = "crasher"
  deps = [
    "//sdk/fidl/fuchsia.feedback:fuchsia.feedback_cpp",
    "//sdk/lib/async-loop:async-loop-cpp",
    "//sdk/lib/async-loop:async-loop-default",
    "//sdk/lib/fdio",
    "//sdk/lib/syslog/cpp",
    "//src/zircon/lib/zircon",
  ]
  cflags = [ "-fstack-protector-all" ]
}

fuchsia_component_manifest("cpp_crasher_manifest") {
  component_name = "cpp_crasher"
  manifest = "meta/crasher.cml"
}

fuchsia_component("cpp_crasher") {
  cm_label = ":cpp_crasher_manifest"
  visibility = [
    ":*",
    "//src/developer/forensics/crasher:*",
  ]
  deps = [ ":crasher_exe" ]
}

cc_test_executable("crasher_test") {
  sources = [ "crasher_test.cc" ]
  deps = [
    "//src/lib/fxl/test:gtest_main",
    "//third_party/googletest:gtest",
  ]
  testonly = true
  emit_tool_path = false
}
