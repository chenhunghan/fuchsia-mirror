import("//src/developer/ffx/build/ffx_tool.gni")

assert(is_host, "bazel_ffx_tool() can only be called in a host toolchain.")

# LINT.IfChange
bazel_ffx_tool("ffx_echo") {
  output_name = "ffx-echo"
}

# LINT.ThenChange(BUILD.bazel)

group("echo") {
  public_deps = [
    ":ffx_echo",
    ":ffx_echo_host_tool",
  ]
}

group("bin") {
  public_deps = [ ":ffx_echo_versioned" ]
}
