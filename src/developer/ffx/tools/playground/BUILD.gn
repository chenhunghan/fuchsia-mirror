import("//src/developer/ffx/build/ffx_tool.gni")

if (is_host) {
  bazel_ffx_tool("ffx_playground") {
    output_name = "ffx-playground"
  }

  group("playground") {
    public_deps = [
      ":ffx_playground",
      ":ffx_playground_host_tool",
    ]
  }

  group("bin") {
    public_deps = [ ":ffx_playground_versioned" ]
  }
}
