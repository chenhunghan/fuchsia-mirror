import("//src/developer/ffx/build/ffx_tool.gni")

if (is_host) {
  # LINT.IfChange
  bazel_ffx_tool("ffx_auth") {
    output_name = "ffx-auth"
  }

  # LINT.ThenChange(BUILD.bazel)

  group("auth") {
    public_deps = [
      ":ffx_auth",
      ":ffx_auth_host_tool",
    ]
  }

  group("bin") {
    public_deps = [ ":ffx_auth_versioned" ]
  }
}

# Needed for //src/developer/ffx/tools:tests.
group("tests") {
  testonly = true
}
