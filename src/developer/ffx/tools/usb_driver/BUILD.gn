import("//src/developer/ffx/build/ffx_tool.gni")

if (is_host) {
  # LINT.IfChange
  bazel_ffx_tool("ffx_usb_driver") {
    output_name = "ffx-usb-driver"
  }

  # LINT.ThenChange(BUILD.bazel)

  group("usb_driver") {
    public_deps = [
      ":ffx_usb_driver",
      ":ffx_usb_driver_host_tool",
    ]
  }

  group("bin") {
    public_deps = [ ":ffx_usb_driver_versioned" ]
  }
}
