import("//build/testing/host_test_data.gni")
import("//src/developer/ffx/build/ffx_tool.gni")

if (is_host) {
  # LINT.IfChange
  bazel_ffx_tool("ffx_monitor") {
    output_name = "ffx-monitor"
  }

  # LINT.ThenChange(BUILD.bazel)

  # Needed for Honeydew's SDK inclusion
  #
  # TODO(https://fxbug.dev/330934833): Remove when IDK allows for `testonly`
  # targets in dep tree or when we can separate the concept of data_dep from
  # host_test_data.
  host_test_data("ffx_monitor_test_data") {
    testonly = false
    visibility = [ "//src/testing/end_to_end/honeydew:*" ]
    data_deps = [ ":ffx_monitor_host_tool" ]
    sources = [
      "${host_tools_dir}/ffx-monitor",
      "${host_tools_dir}/ffx-monitor.json",
    ]
  }

  group("monitor") {
    public_deps = [
      ":ffx_monitor",
      ":ffx_monitor_host_tool",
    ]
  }

  group("bin") {
    public_deps = [ ":ffx_monitor_versioned" ]
  }
}
