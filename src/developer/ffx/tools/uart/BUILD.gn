import("//src/developer/ffx/build/ffx_tool.gni")

if (is_host) {
  # LINT.IfChange
  bazel_ffx_tool("ffx_uart") {
    output_name = "ffx-uart"
    deps = [ "//src/developer/ffx/tools/uart_driver:ffx_uart_driver_host_tool" ]
  }

  # LINT.ThenChange(BUILD.bazel)

  group("uart") {
    public_deps = [
      ":ffx_uart",
      ":ffx_uart_host_tool",
    ]
  }

  group("bin") {
    public_deps = [ ":ffx_uart_versioned" ]
  }
}
