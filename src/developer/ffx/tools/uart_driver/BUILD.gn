# Defines the host daemon executable `ffx-uart-driver` and its CLI wrapper
# library
# `ffx_uart_host_driver`.

import("//src/developer/ffx/build/ffx_tool.gni")

if (is_host) {
  # LINT.IfChange
  bazel_ffx_tool("ffx_uart_driver") {
    output_name = "ffx-uart-driver"
  }

  # LINT.ThenChange(BUILD.bazel)

  group("uart_driver") {
    public_deps = [
      ":ffx_uart_driver",
      ":ffx_uart_driver_host_tool",
    ]
  }

  group("bin") {
    public_deps = [ ":ffx_uart_driver_versioned" ]
  }
}
