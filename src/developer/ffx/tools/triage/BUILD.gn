import("//src/developer/ffx/build/ffx_tool.gni")

assert(is_host, "bazel_ffx_tool() can only be called in a host toolchain.")

# LINT.IfChange
bazel_ffx_tool("ffx_triage") {
  output_name = "ffx-triage"
  sdk_category = "partner"
}

# LINT.ThenChange(BUILD.bazel)

group("triage") {
  public_deps = [
    ":ffx_triage",
    ":ffx_triage_host_tool",
  ]
}

group("bin") {
  public_deps = [ ":ffx_triage_versioned" ]
}
