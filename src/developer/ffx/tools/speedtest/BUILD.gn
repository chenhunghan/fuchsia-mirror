import("//build/testing/host_test_data.gni")
import("//src/developer/ffx/build/ffx_tool.gni")

if (is_host) {
  bazel_ffx_tool("ffx_speedtest_tool") {
    output_name = "ffx-speedtest"
  }

  host_test_data("ffx_speedtest_tool_test_data") {
    visibility = [
      "//src/developer/ffx/tests/e2e/python:*",
      "//src/tests/end_to_end/perf:*",
    ]
    data_deps = [ ":ffx_speedtest_tool_host_tool" ]
    sources = [
      "${host_tools_dir}/ffx-speedtest",
      "${host_tools_dir}/ffx-speedtest.json",
    ]
  }
}

group("speedtest") {
  public_deps = [
    ":ffx_speedtest_tool",
    ":ffx_speedtest_tool_host_tool",
  ]
}

group("bin") {
  public_deps = [ ":ffx_speedtest_tool_versioned" ]
}

group("tests") {
  testonly = true
  deps = [ "common:tests" ]
}
