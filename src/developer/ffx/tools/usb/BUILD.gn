import("//src/developer/ffx/build/ffx_tool.gni")

if (is_host) {
  bazel_ffx_tool("ffx_usb") {
    output_name = "ffx-usb"
  }

  group("usb") {
    public_deps = [
      ":ffx_usb",
      ":ffx_usb_host_tool",
    ]
  }

  group("bin") {
    public_deps = [ ":ffx_usb_versioned" ]
  }
}

group("tests") {
  testonly = true
  deps = [ ":lib_test($host_toolchain)" ]
}

