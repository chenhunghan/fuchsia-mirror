import("//src/developer/ffx/build/ffx_tool.gni")

assert(is_host, "bazel_ffx_tool() can only be called in a host toolchain.")

# LINT.IfChange
bazel_ffx_tool("ffx_verify_ssh_keys") {
  output_name = "ffx-verify-ssh-keys"
}

# LINT.ThenChange(BUILD.bazel)

group("verify-ssh-keys") {
  public_deps = [
    ":ffx_verify_ssh_keys",
    ":ffx_verify_ssh_keys_host_tool",
  ]
}

group("bin") {
  public_deps = [ ":ffx_verify_ssh_keys_versioned" ]
}
