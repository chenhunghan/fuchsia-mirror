import("//src/developer/ffx/build/ffx_tool.gni")

group("tests") {
  testonly = true

  deps = [
    "cycle:tests",
    "focus:tests",
    "list:tests",
    "set-order:tests",
  ]
}

if (is_host) {
  bazel_ffx_tool("ffx_wm_tool") {
    output_name = "ffx-wm"
  }
}

group("wm") {
  public_deps = [
    ":ffx_wm_tool",
    ":ffx_wm_tool_host_tool",
  ]
}

group("bin") {
  public_deps = [ ":ffx_wm_tool_versioned" ]
}

