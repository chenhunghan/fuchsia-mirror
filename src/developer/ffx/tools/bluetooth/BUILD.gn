import("//src/developer/ffx/build/ffx_tool.gni")

assert(is_host, "FFX tools can only be compiled in the host toolchain")

bazel_ffx_tool("ffx_bluetooth_tool") {
  output_name = "ffx-bluetooth"
}

group("bluetooth") {
  deps = [
    ":ffx_bluetooth_tool",
    ":ffx_bluetooth_tool_host_tool",
  ]
}

group("bin") {
  public_deps = [ ":ffx_bluetooth_tool_versioned" ]
}

group("tests") {
  testonly = true
  deps = [
    ":ffx_bluetooth_tests",

    # Plugins migrated to Bazel define standalone unit test targets that are not
    # aggregated by `:ffx_bluetooth_tests`.
    "src/controller:tests",
    "src/pairable:tests",
    "src/pandora:tests",
    "src/peer:tests",
  ]
}

