import("//src/developer/ffx/build/ffx_tool.gni")

if (is_host) {
  # LINT.IfChange(ffx_gce)
  bazel_ffx_tool("ffx_gce") {
    output_name = "ffx-gce"
  }

  # LINT.ThenChange(BUILD.bazel:ffx_gce)

  group("gce") {
    public_deps = [
      ":ffx_gce",
      ":ffx_gce_host_tool",
    ]
  }

  group("bin") {
    public_deps = [ ":ffx_gce_versioned" ]
  }
}
