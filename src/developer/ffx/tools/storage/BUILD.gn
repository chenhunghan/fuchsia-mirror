import("//build/testing/host_test_data.gni")
import("//src/developer/ffx/build/ffx_tool.gni")

assert(is_host, "bazel_ffx_tool() can only be called in a host toolchain.")

# LINT.IfChange
bazel_ffx_tool("ffx_storage") {
  output_name = "ffx-storage"
}

host_test_data("ffx_storage_test_data") {
  visibility = [ "//vendor/google/*" ]
  data_deps = [ ":ffx_storage_host_tool" ]
  sources = [
    "${host_tools_dir}/ffx-storage",
    "${host_tools_dir}/ffx-storage.json",
  ]
}

# LINT.ThenChange(BUILD.bazel)

group("storage") {
  public_deps = [
    ":ffx_storage",
    ":ffx_storage_host_tool",
  ]
}

group("bin") {
  public_deps = [ ":ffx_storage_versioned" ]
}
