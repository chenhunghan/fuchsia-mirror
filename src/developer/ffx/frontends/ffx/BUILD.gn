import("//build/bazel/bazel_host_tool.gni")
import("//build/testing/host_test.gni")
import("//build/testing/host_test_data.gni")

assert(is_host, "ffx is for use with the host toolchain only")

bazel_host_tool("ffx_bin_unversioned") {
  visibility = [
    "//src/developer/ffx/*",
    "//tools/docsgen:*",
  ]
  bazel_target = ":ffx_bin_unversioned"
  bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/ffx_bin_unversioned"
  output_name = "ffx_unversioned"
}

bazel_host_tool("ffx_bin") {
  visibility = [ "//src/developer/ffx/*" ]
  bazel_target = ":ffx"
  bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/ffx"
  output_name = "ffx"
}

_ffx_e2e_config = [
  "--config",
  "log.level=DEBUG",
  "--config",
  "sdk.root=.",
  "--config",
  "ffx.subtool-manifest=\"\"",
  "--config",
  "ffx.subtool-search-paths=host-tools",
]

host_test("ffx-e2e-without-target") {
  visibility = [
    "//:*",
    "//src/developer/ffx/*",
  ]
  binary_path = "$root_out_dir/ffx"
  args = _ffx_e2e_config + [
           "self-test",
           "--include-target",
           "false",
         ]

  deps = [
    ":ffx_bin",
    "//src/developer/ffx/plugins/self-test:ffx_selftest_tool",
  ]
  data_deps = [
    "//src/developer/ffx:suite_test_data",
    "//src/developer/ffx/plugins/self-test:ffx_selftest_tool_test_data",
  ]
}

host_test("ffx-e2e-with-target") {
  visibility = [
    "//:*",
    "//src/developer/ffx/*",
  ]
  binary_path = "$root_out_dir/ffx"
  args = _ffx_e2e_config + [ "self-test" ]

  deps = [
    ":ffx_bin",
    "//src/developer/ffx/plugins/self-test:ffx_selftest_tool",

    # Required by the test_debug_limbo in `ffx self-test`. We cannot add it to
    # the dependency of `ffx self-test` plugin because that will make the
    # crasher into all production builds.
    "//src/developer/forensics/crasher($target_toolchain)",
  ]
  data_deps = [
    ":ffx-e2e-test-data",
    "//src/developer/ffx:suite_test_data",
    "//src/developer/ffx/plugins/self-test:ffx_selftest_tool_test_data",
  ]

  environments = [
    # XXX(https://fxbug.dev/42143551): support arm64 HTI tests
    # emu_env,
    nuc11_env,
  ]
}

host_test_data("ffx-e2e-test-data") {
  visibility = [ "//src/developer/ffx/*" ]
  sources = [
    "$root_out_dir/ffx",
    "$root_out_dir/zxdb",
  ]
}

group("e2e_tests") {
  visibility = [ "//src/developer/ffx/*" ]

  # These are end to end tests, which are different from host-tests since
  # e2e tests require devices and/or complete images or product bundles.
  testonly = true
  public_deps = [
    # ffx end to end tests, through `ffx self-test` invocations, one includes
    # tests that must have a target present, the other can be run without a
    # target present.
    ":ffx-e2e-with-target",
  ]
}

group("host_tests") {
  visibility = [ "//src/developer/ffx/*" ]
  testonly = true
  deps = [ ":ffx-e2e-without-target" ]
}

group("tests") {
  visibility = [ "//src/developer/ffx/*" ]
  testonly = true
  public_deps = [
    ":ffx_bin_unversioned_test",

    # Most ffx plugin test suites are included downstream of the group defined
    # by the ffx_plugin template below.
    ":ffx_lib_tests",
  ]
}

