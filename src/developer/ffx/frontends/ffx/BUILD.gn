import("//build/tools/bazel2gn/bazel_migration.gni")

ffx_plugin("ffx_lib") {
  sources = [ "src/lib.rs" ]
  args_deps = [
    "//src/developer/ffx/core:lib",
    "//third_party/rust_crates:argh",
  ]
  args_sources = [ "src/args.rs" ]
  edition = "2024"
  plugin_deps = [
    "//src/connectivity/network/net-cli/ffx:ffx_net",
    "//src/developer/ffx/plugins/completion:ffx_completion",
    "//src/developer/ffx/plugins/config:ffx_config_plugin",
    "//src/developer/ffx/plugins/devices:ffx_devices",
    "//src/developer/ffx/plugins/doctor:ffx_doctor",
    "//src/developer/ffx/plugins/platform:ffx_platform",
    "//src/developer/ffx/plugins/sdk:ffx_sdk",
    "//src/developer/ffx/plugins/target:ffx_target",
    "//src/developer/ffx/plugins/version:ffx_version",
  ]
  sdk_category = "not-yet-specified"
  version = "0.1.0"
  visibility = [
    ":*",
    "//src/developer/ffx:*",
  ]
  deps = [
    "//src/developer/ffx/lib/fho:lib",
    "//third_party/rust_crates:anyhow",
  ]
}
if (is_host) {
  rustc_test("ffx_bin_unversioned_test") {
    sources = [ "src/main.rs" ]
    edition = "2024"
    deps = [
             ":ffx_lib_args",
             ":ffx_lib_sub_command",
             ":ffx_lib_suite",
             "//src/developer/ffx/command:lib",
             "//src/developer/ffx/config:lib",
             "//src/developer/ffx/lib/errors:lib",
             "//src/developer/ffx/lib/fho:lib",
             "//src/developer/ffx/lib/traceable_error:lib",
             "//src/lib/fuchsia-async",
             "//third_party/rust_crates:argh",
             "//third_party/rust_crates:log",
           ] + [ "//src/lib/fuchsia" ]
    source_root = "src/main.rs"
  }
}
