{
  "name": "symbolize",
  "description": "symbolize backtraces in markup format",
  "examples": [
    "Symbolize piped logs:\n  cat raw_log.txt | ffx debug symbolize\n\nPass flags to the underlying symbolizer:\n  ffx debug symbolize -- -s /path/to/symbols --verbose\n\nShow underlying symbolizer help:\n  ffx debug symbolize -- --help"
  ],
  "flags": [
    {
      "kind": "Switch",
      "optionality": "optional",
      "long": "--help",
      "short": null,
      "description": "display usage information",
      "hidden": false
    },
    {
      "kind": "Switch",
      "optionality": "optional",
      "long": "--auth",
      "short": null,
      "description": "start the authentication process.",
      "hidden": false
    },
    {
      "kind": "Switch",
      "optionality": "optional",
      "long": "--no-prettify",
      "short": null,
      "description": "do not prettify the backtraces.",
      "hidden": false
    }
  ],
  "notes": [
    "Parses logs from stdin and converts symbolizer markup into human-readable\nstack traces using local or remote debug symbols.\n\nBy default, passes --prettify-backtrace and --omit-module-lines to the\nunderlying symbolizer. Use --no-prettify to disable.\n\nArguments starting with '-' for the symbolizer must follow '--'.\nTo see available symbolizer flags, run: `ffx debug symbolize -- --help`"
  ],
  "commands": [],
  "positionals": [
    {
      "name": "symbolizer_args",
      "description": "extra arguments passed to the symbolizer. Any arguments starting with \"-\" must be after a \"--\" separator.",
      "optionality": "repeating",
      "hidden": false
    }
  ],
  "error_codes": []
}