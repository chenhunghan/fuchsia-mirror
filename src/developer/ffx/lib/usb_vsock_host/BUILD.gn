import("//build/tools/bazel2gn/bazel_migration.gni")

if (is_host) {
  rustc_library("usb_vsock_host") {
    sources = [ "src/lib.rs" ]
    edition = "2024"
    visibility = [
      ":*",
      "//src/developer/ffx/*",
    ]
    deps = [
      "//src/developer/lib/usb_vsock",
      "//src/devices/bind/fuchsia.google.platform.usb:fuchsia.google.platform.usb_rust",
      "//src/devices/bind/fuchsia.usb:fuchsia.usb_rust",
      "//src/lib/fuchsia-async",
      "//src/lib/usb_rs",
      "//third_party/rust_crates:futures",
      "//third_party/rust_crates:log",
      "//third_party/rust_crates:rand",
      "//third_party/rust_crates:thiserror",
    ]
  }
}
if (is_host) {
  rustc_test("lib_test") {
    sources = [ "src/lib.rs" ]
    edition = "2024"
    deps = [
             "//src/developer/lib/usb_vsock",
             "//src/devices/bind/fuchsia.google.platform.usb:fuchsia.google.platform.usb_rust",
             "//src/devices/bind/fuchsia.usb:fuchsia.usb_rust",
             "//src/lib/fuchsia-async",
             "//src/lib/usb_rs",
             "//third_party/rust_crates:futures",
             "//third_party/rust_crates:log",
             "//third_party/rust_crates:rand",
             "//third_party/rust_crates:thiserror",
           ] + [ "//src/lib/fuchsia" ]
    output_name = "usb_vsock_host_lib_test"
  }
}
