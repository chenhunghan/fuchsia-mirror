import("//build/tools/bazel2gn/bazel_migration.gni")

if (is_host) {
  rustc_library("lib") {
    sources = [
      "src/lib.rs",
      "src/v1.rs",
      "src/v2.rs",
      "src/v3.rs",
      "src/v4.rs",
    ]
    crate_name = "ffx_flash_manifest"
    edition = "2024"
    visibility = [
      ":*",
      "//src/developer/ffx/*",
    ]
    deps = [
      "//src/lib/assembly/partitions_config",
      "//src/lib/assembly/product_bundle",
      "//third_party/rust_crates:log",
      "//third_party/rust_crates:serde",
      "//third_party/rust_crates:serde_json",
      "//third_party/rust_crates:thiserror",
    ]
  }
}
if (is_host) {
  rustc_test("lib_test") {
    sources = [
      "src/lib.rs",
      "src/v1.rs",
      "src/v2.rs",
      "src/v3.rs",
      "src/v4.rs",
    ]
    edition = "2024"
    deps = [
             "//src/lib/assembly/partitions_config",
             "//src/lib/assembly/product_bundle",
             "//third_party/rust_crates:log",
             "//third_party/rust_crates:serde",
             "//third_party/rust_crates:serde_json",
             "//third_party/rust_crates:thiserror",
           ] +
           [
             "//src/lib/fuchsia",
             "//third_party/rust_crates:anyhow",
           ]
    output_name = "ffx_flash_manifest_lib_test"
    visibility = [
      ":*",
      "//src/developer/ffx:*",
    ]
  }
}
