load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

# Note: Host-only target matching platform-only deps via target_compatible_with.
rustc_library(
    name = "lib",
    srcs = [
        "src/lib.rs",
        "src/v1.rs",
        "src/v2.rs",
        "src/v3.rs",
        "src/v4.rs",
    ],
    crate_name = "ffx_flash_manifest",
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//src/developer/ffx:__subpackages__",
    ],
    deps = [
        "//src/lib/assembly/partitions_config",
        "//src/lib/assembly/product_bundle",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

host_rustc_test(
    name = "lib_test",
    crate = ":lib",
    # Needed so bazel2gn emits output_name = "ffx_flash_manifest_lib_test" in BUILD.gn.
    crate_name = "ffx_flash_manifest_lib_test",
    visibility = ["//src/developer/ffx:__pkg__"],
    deps = [
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:anyhow",
    ],
)
