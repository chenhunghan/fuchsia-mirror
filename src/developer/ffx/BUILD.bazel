package(default_applicable_licenses = ["//:license"])

# Keep in sync with `json_merge("ffx-defaults.json")` in `BUILD.gn` and plugin
# lists in `config.gni`.
# `plugins/product/data/config.json` is intentionally omitted because GN only
# includes it via `dual_mode_defaults` when
# `ffx_build_dual_mode_plugins_as_subtools = true`, which is unsupported in
# Bazel.
# TODO(https://fxbug.dev/512659653): As remaining `ffx_plugin` targets migrate
# to Bazel, drop `//src/developer/ffx/plugins/{emulator,repository}:data/config.json`
# once those built-in plugins join `//src/developer/ffx/frontends/ffx:ffx_lib`,
# and replace `//src/developer/ffx/plugins/log:data/config.json` and
# `plugins/{test,trace}/data/config.json` with `:<plugin>_config` subtargets.
json_merge(
    name = "ffx-defaults.json",
    srcs = [
        "data/config.json",
        "plugins/test/data/config.json",
        "plugins/trace/data/config.json",
        "//src/developer/ffx/frontends/ffx:ffx_lib_config",
        "//src/developer/ffx/lib/pbms:data/config.json",
        "//src/developer/ffx/plugins/emulator:data/config.json",
        "//src/developer/ffx/plugins/log:data/config.json",
        "//src/developer/ffx/plugins/repository:data/config.json",
    ],
    deep_merge = True,
    visibility = ["//src/developer/ffx/config/macro/proc_macro:__pkg__"],
)

# Exposes the full GN-built ffx binary (`host-tools/ffx`) to Bazel host tests
# until //src/developer/ffx/frontends/ffx includes all built-in plugins.
# Needed for SDK inclusion
#
# TODO(b/330934833): Remove when IDK allows for `testonly` targets in dep
# tree or when we can separate the concept of data_dep from host_test_data.
# @bazel2gn:skip
gn_ffx_test_data(
    name = "test_data",
    testonly = False,
    expected_files = ["ffx"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//src/developer/ffx/build/tests:__pkg__"],
)

