ffx_plugin("ffx_audio_gen") {
  sources = [ "src/lib.rs" ]
  args_deps = [
    "//src/developer/ffx/core:lib",
    "//src/media/audio/lib/rust",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
  ]
  args_sources = [ "src/args.rs" ]
  edition = "2024"
  sdk_category = "not-yet-specified"
  version = "0.1.0"
  visibility = [
    ":*",
    "//src/developer/ffx/plugins/audio:*",
  ]
  deps = [
    "//src/developer/ffx/lib/errors:lib",
    "//src/developer/ffx/lib/fho:lib",
    "//src/developer/ffx/lib/writer:lib",
    "//src/media/audio/lib/rust",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:hound",
    "//third_party/rust_crates:rand",
  ]
}
if (is_host) {
  rustc_test("ffx_audio_gen_args_test") {
    sources = [ "src/args.rs" ]
    edition = "2024"
    source_root = "src/args.rs"
    deps = [
      "//src/developer/ffx/core:lib",
      "//src/media/audio/lib/rust",
      "//third_party/rust_crates:anyhow",
      "//third_party/rust_crates:argh",
    ]
    visibility = [
      ":*",
      "//src/developer/ffx:*",
    ]
  }
}
if (is_host) {
  rustc_test("ffx_audio_gen_test") {
    sources = [ "src/lib.rs" ]
    edition = "2024"
    deps = [
      ":ffx_audio_gen_args",
      "//src/developer/ffx/lib/errors:lib",
      "//src/developer/ffx/lib/fho:lib",
      "//src/developer/ffx/lib/writer:lib",
      "//src/media/audio/lib/rust",
      "//third_party/rust_crates:anyhow",
      "//third_party/rust_crates:hound",
      "//third_party/rust_crates:rand",
    ]
    visibility = [
      ":*",
      "//src/developer/ffx:*",
    ]
  }
