load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//src/developer/ffx/build:ffx_plugin.bzl", "ffx_plugin")

package(default_applicable_licenses = ["//:license"])

ffx_plugin(
    name = "ffx_debug_limbo",
    srcs = ["src/lib.rs"],
    args_deps = [
        "//src/developer/ffx/core:lib",
        "//third_party/rust_crates/vendor:argh",
    ],
    args_srcs = ["src/args.rs"],
    edition = "2024",
    sdk_category = "not-yet-specified",
    version = "0.1.0",
    visibility = ["//src/developer/ffx/plugins/debug:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.exception:fuchsia.exception_rust_fdomain",
        "//sdk/rust/zx-status",
        "//sdk/rust/zx-types",
        "//src/developer/ffx/lib/fho:lib",
        "//src/developer/ffx/lib/safe_string:lib",
        "//src/developer/ffx/lib/target/holders:lib",
        "//src/developer/ffx/lib/writer:lib",
        "//third_party/rust_crates/vendor:anyhow",
    ],
)

host_rustc_test(
    name = "ffx_debug_limbo_test",
    crate = ":ffx_debug_limbo",
    visibility = ["//src/developer/ffx:__pkg__"],
    deps = [
        "//src/lib/fdomain/local",
        "//src/lib/fuchsia",
    ],
)
