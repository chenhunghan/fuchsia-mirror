import("//build/sdk/sdk_atom.gni")
import("//src/developer/ffx/build/ffx_tool.gni")

if (is_host) {
  # LINT.IfChange
  bazel_ffx_tool("ffx_wlan_tool") {
    output_name = "ffx-wlan"
    sdk_category = "partner"
  }

  # LINT.ThenChange(BUILD.bazel)

  group("wlan") {
    public_deps = [
      ":ffx_wlan_tool",
      ":ffx_wlan_tool_host_tool",
    ]
  }

  group("bin") {
    public_deps = [ ":ffx_wlan_tool_versioned" ]
  }

  # TODO(https://fxbug.dev/438572714): Remove once the IDK uses the Bazel atom.
  _idk_path = "tools/$current_cpu/ffx_tools/ffx-wlan"

  sdk_atom("sdk") {
    category = "partner"
    sdk_area = "Developer"
    id = "sdk://$_idk_path"
    idk_name = "ffx-wlan"
    meta = {
      dest = "$_idk_path-meta.json"
      type = "ffx_tool"
      source_prebuild_info = {
        arch = current_cpu
        file_base = "tools"
      }
    }
    files = [
      {
        source = "$root_out_dir/ffx-wlan"
        dest = _idk_path
      },
      {
        source = "$root_out_dir/ffx-wlan.json"
        dest = "$_idk_path.json"
      },
    ]
    non_sdk_deps = [ ":ffx_wlan_tool_versioned" ]
  }
}
