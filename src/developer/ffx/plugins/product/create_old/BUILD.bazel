load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

# Note: Host-only target matching platform-only deps via target_compatible_with.
rustc_library(
    name = "lib",
    srcs = [
        "src/args.rs",
        "src/lib.rs",
    ],
    crate_name = "ffx_product_create_old",
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//src/developer/ffx/plugins/product:__pkg__"],
    deps = [
        "//build/sdk/meta:rust",
        "//src/developer/ffx/config:lib",
        "//src/developer/ffx/lib/fastboot/flash_manifest:lib",
        "//src/developer/ffx/lib/fho:lib",
        "//src/developer/ffx/lib/writer:lib",
        "//src/lib/assembly/assembled_system",
        "//src/lib/assembly/container",
        "//src/lib/assembly/partitions_config",
        "//src/lib/assembly/product_bundle",
        "//src/lib/assembly/sdk",
        "//src/lib/assembly/tool",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:camino",
    ],
)

# bazel2gn cannot translate `test_data`, so this test is wired into
# //src/developer/ffx:tests in Bazel.
# @bazel2gn:skip
host_rustc_test(
    name = "ffx_product_create_old_lib_test",
    compile_data = [
        "//build/sdk/meta:test_data/virtual_device.json",
        "//build/sdk/meta:test_data/virtual_device2.json",
    ],
    crate = ":lib",
    edition = "2024",
    test_data = ["//src/developer/ffx/lib/pkg:empty-repo-keys"],
    visibility = ["//src/developer/ffx:__pkg__"],
    deps = [
        "//src/lib/assembly/release_info",
        "//src/lib/fuchsia",
        "//src/sys/pkg/lib/fuchsia-repo",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:tempfile",
    ],
)
