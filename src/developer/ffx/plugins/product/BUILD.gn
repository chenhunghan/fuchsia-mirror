import("//build/sdk/sdk_atom.gni")
import("//build/testing/host_test_data.gni")
import("//src/developer/ffx/build/ffx_tool.gni")

if (is_host) {
  # When used in the build, this separate subtool version is used to avoid
  # its build steps depending on all of ffx. In order to use it with ffx_action,
  # you need to tell it to use the versioned executable target as follows:
  #
  #   ffx_tool =
  #       "//src/developer/ffx/plugins/product:ffx_product_tool"
  #   ffx_tool_output_name = "ffx-product"
  # LINT.IfChange
  bazel_ffx_tool("ffx_product_tool") {
    output_name = "ffx-product"
    sdk_category = "partner"
  }

  # LINT.ThenChange(BUILD.bazel)

  host_test_data("ffx_product_tool_test_data") {
    visibility = [
      "//src/sys/pkg/tests/system-tests:*",
      "//src/testing/end_to_end/honeydew:*",
    ]
    data_deps = [ ":ffx_product_tool_host_tool" ]
    sources = [
      "${host_tools_dir}/ffx-product",
      "${host_tools_dir}/ffx-product.json",
    ]
  }

  # TODO(https://fxbug.dev/438572714): Remove once the IDK uses the Bazel atom.
  _idk_path = "tools/$current_cpu/ffx_tools/ffx-product"

  sdk_atom("sdk") {
    category = "partner"
    sdk_area = "Developer"
    id = "sdk://$_idk_path"
    idk_name = "ffx-product"
    meta = {
      dest = "$_idk_path-meta.json"
      type = "ffx_tool"
      source_prebuild_info = {
        arch = current_cpu
        file_base = "tools"
      }
    }
    files = [
      {
        source = "$root_out_dir/ffx-product"
        dest = _idk_path
      },
      {
        source = "$root_out_dir/ffx-product.json"
        dest = "$_idk_path.json"
      },
    ]
    non_sdk_deps = [ ":ffx_product_tool_versioned" ]
  }

  group("product") {
    public_deps = [
      ":ffx_product_tool",
      ":ffx_product_tool_host_tool",
    ]
  }

  group("bin") {
    public_deps = [ ":ffx_product_tool_versioned" ]
  }
}
