load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":ffx_emulator_engines_test"],
    visibility = ["//src/developer/ffx:__pkg__"],
)

rustc_library(
    name = "ffx_emulator_engines",
    srcs = [
        "src/arg_templates.rs",
        "src/lib.rs",
        "src/qemu_based/comms.rs",
        "src/qemu_based/crosvm/mod.rs",
        "src/qemu_based/femu/mod.rs",
        "src/qemu_based/gpt.rs",
        "src/qemu_based/mod.rs",
        "src/qemu_based/qemu/image_conversion.rs",
        "src/qemu_based/qemu/mod.rs",
        "src/qemu_based/qemu/monitor.rs",
        "src/serialization.rs",
        "src/show_output.rs",
    ],
    compile_data = [
        "templates/efi_flags.json.template",
        "templates/emulator_flags.json.template",
    ],
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//src/developer/ffx/plugins/emulator:__subpackages__",
        "//src/developer/ffx/tools/starnix:__pkg__",
    ],
    deps = [
        "//build/sdk/meta:rust",
        "//src/developer/ffx/config:lib",
        "//src/developer/ffx/lib/emulator_instance:lib",
        "//src/developer/ffx/lib/errors:lib",
        "//src/developer/ffx/lib/fho:lib",
        "//src/developer/ffx/lib/target:lib",
        "//src/developer/ffx/lib/uefi_disk:lib",
        "//src/developer/ffx/plugins/emulator/common:ffx_emulator_common",
        "//src/developer/ffx/plugins/emulator/configuration:ffx_emulator_config",
        "//src/lib/fuchsia-async",
        "//src/storage/lib/sparse/rust:lib",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:handlebars",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:nix",
        "//third_party/rust_crates/vendor:png",
        "//third_party/rust_crates/vendor:rand",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:shared_child",
        "//third_party/rust_crates/vendor:tempfile",
    ],
)

host_rustc_test(
    name = "ffx_emulator_engines_test",
    compile_data = [
        "test_data/atx_metadata.bin",
        "test_data/screenshot_golden.png",
        "test_data/screenshot_input.ppm",
        "test_data/testkey_atx_psk.pem",
        "test_data/unknown_engine_type_engine.json",
    ],
    crate = ":ffx_emulator_engines",
    # Each test writes the fake tools which it then runs. When tests run at the
    # same time, the fork of one test's child can overlap the write of another
    # test's script, and the exec of that script then fails with ETXTBSY; so the
    # tests run one at a time.
    test_args = ["--test-threads=1"],
    deps = [
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:serde",
    ],
)
