load("//build/bazel/rules/idk:idk_ffx_tool.bzl", "idk_ffx_tool")
load("//src/developer/ffx/build:ffx_plugin.bzl", "ffx_plugin")

package(default_applicable_licenses = ["//:license"])

ffx_plugin(
    name = "ffx_component",
    args_deps = [
        "//src/developer/ffx/core:lib",
        "//third_party/rust_crates/vendor:argh",
    ],
    args_srcs = ["src/args.rs"],
    edition = "2024",
    plugin_deps = [
        "//src/developer/ffx/plugins/component/capability:ffx_component_capability",
        "//src/developer/ffx/plugins/component/collection:ffx_component_collection",
        "//src/developer/ffx/plugins/component/config:ffx_component_config",
        "//src/developer/ffx/plugins/component/copy:ffx_component_copy",
        "//src/developer/ffx/plugins/component/create:ffx_component_create",
        "//src/developer/ffx/plugins/component/debug:ffx_component_debug",
        "//src/developer/ffx/plugins/component/destroy:ffx_component_destroy",
        "//src/developer/ffx/plugins/component/doctor:ffx_component_doctor",
        "//src/developer/ffx/plugins/component/explore:ffx_component_explore",
        "//src/developer/ffx/plugins/component/graph:ffx_component_graph",
        "//src/developer/ffx/plugins/component/list:ffx_component_list",
        "//src/developer/ffx/plugins/component/reload:ffx_component_reload",
        "//src/developer/ffx/plugins/component/resolve:ffx_component_resolve",
        "//src/developer/ffx/plugins/component/route:ffx_component_route",
        "//src/developer/ffx/plugins/component/run:ffx_component_run",
        "//src/developer/ffx/plugins/component/show:ffx_component_show",
        "//src/developer/ffx/plugins/component/start:ffx_component_start",
        "//src/developer/ffx/plugins/component/stop:ffx_component_stop",
        "//src/developer/ffx/plugins/component/storage:ffx_component_storage",
    ],
    sdk_category = "not-yet-specified",
    version = "0.1.0",
)

# LINT.IfChange(ffx_component_tool)
idk_ffx_tool(
    name = "ffx_component_tool",
    srcs = ["src/main.rs"],
    category = "partner",
    edition = "2024",
    idk_name = "ffx-component",
    visibility = ["//:__subpackages__"],
    deps = [
        ":ffx_component_suite",
        "//src/lib/fuchsia-async",
    ],
)
# LINT.ThenChange(//src/developer/ffx/plugins/component/BUILD.gn:ffx_component_tool)
