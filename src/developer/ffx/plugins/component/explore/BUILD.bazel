    name = "ffx_component_explore",
    srcs = ["src/lib.rs"],
    args_deps = [
        "//src/developer/ffx/core:lib",
        "//src/sys/lib/component_debug:component_debug_fdomain",
        "//third_party/rust_crates/vendor:argh",
