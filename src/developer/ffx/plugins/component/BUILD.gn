import("//build/sdk/sdk_atom.gni")
import("//build/testing/host_test_data.gni")
import("//src/developer/ffx/build/ffx_tool.gni")

if (is_host) {
  # LINT.IfChange(ffx_component_tool)
  bazel_ffx_tool("ffx_component_tool") {
    output_name = "ffx-component"
    sdk_category = "partner"
  }

  # LINT.ThenChange(//src/developer/ffx/plugins/component/BUILD.bazel:ffx_component_tool)

  host_test_data("ffx_component_tool_test_data") {
    data_deps = [ ":ffx_component_tool_host_tool" ]
    sources = [
      "${host_tools_dir}/ffx-component",
      "${host_tools_dir}/ffx-component.json",
    ]
  }

  group("component") {
    public_deps = [
      ":ffx_component_tool",
      ":ffx_component_tool_host_tool",
    ]
  }

  group("bin") {
    public_deps = [ ":ffx_component_tool_versioned" ]
  }

  # TODO(https://fxbug.dev/438572714): Remove once the IDK uses the Bazel atom.
  _idk_path = "tools/$current_cpu/ffx_tools/ffx-component"

  sdk_atom("sdk") {
    category = "partner"
    sdk_area = "Developer"
    id = "sdk://$_idk_path"
    idk_name = "ffx-component"
    meta = {
      dest = "$_idk_path-meta.json"
      type = "ffx_tool"
      source_prebuild_info = {
        arch = current_cpu
        file_base = "tools"
      }
    }
    files = [
      {
        source = "$root_out_dir/ffx-component"
        dest = _idk_path
      },
      {
        source = "$root_out_dir/ffx-component.json"
        dest = "$_idk_path.json"
      },
    ]
    non_sdk_deps = [ ":ffx_component_tool_versioned" ]
  }
}

group("tests") {
  testonly = true
  deps = [
    "common:ffx_component_test",
    "destroy:tests",
    "doctor:ffx_component_doctor_tests",
    "resolve:ffx_component_resolve_tests",
    "route:ffx_component_route_tests",
    "show:ffx_component_show_tests",
    "start:ffx_component_start_tests",

    # Bazel-migrated plugins
    "create:tests",
    "debug:tests",
    "graph:tests",
    "list:tests",
    "reload:tests",
    "run:tests",
    "stop:tests",
    "storage:tests",
  ]
  if (is_host) {
    deps += [ ":ffx_component_tests($host_toolchain)" ]
  }
}

if (is_host) {
  group("host_tests") {
    testonly = true
    deps = [
      "create:host_tests",
      "destroy:host_tests",
      "run:host_tests",
    ]
  }
}

