ffx_plugin("ffx_product_bundle") {
  args_deps = [
    "//src/developer/ffx/core:lib",
    "//third_party/rust_crates:argh",
  ]
  args_sources = [ "src/args.rs" ]
  edition = "2024"
  plugin_deps = [
    "//src/developer/ffx/plugins/product_bundle/bisect:ffx_product_bundle_bisect",
    "//src/developer/ffx/plugins/product_bundle/create:ffx_product_bundle_create",
  ]
  sdk_category = "partner"
  version = "0.1.0"
  visibility = [
    ":*",
    "//src/developer/ffx/frontends/ffx:*",
  ]
}
