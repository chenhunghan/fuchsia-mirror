import("//build/tools/bazel2gn/bazel_migration.gni")

ffx_plugin("ffx_repository") {
  args_deps = [
    "//src/developer/ffx/core:lib",
    "//third_party/rust_crates:argh",
  ]
  args_sources = [ "src/args.rs" ]
  config_data = [ "data/config.json" ]
  edition = "2024"
  plugin_deps = [
    "//src/developer/ffx/plugins/repository/create:ffx_repository_create",
    "//src/developer/ffx/plugins/repository/default:ffx_repository_default",
    "//src/developer/ffx/plugins/repository/packages:ffx_repository_packages",
    "//src/developer/ffx/plugins/repository/publish:ffx_repository_publish",
    "//src/developer/ffx/plugins/repository/serve-archive:ffx_repository_serve_archive",
    "//src/developer/ffx/plugins/repository/server:ffx_repository_server",
  ]
  sdk_category = "not-yet-specified"
  version = "0.1.0"
  visibility = [
    ":*",
    "//src/developer/ffx:*",
  ]
}
