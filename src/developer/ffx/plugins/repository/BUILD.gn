import("//build/sdk/sdk_atom.gni")
import("//build/testing/host_test_data.gni")
import("//src/developer/ffx/build/ffx_tool.gni")

if (is_host) {
  # LINT.IfChange(ffx_repository_tool)
  bazel_ffx_tool("ffx_repository_tool") {
    output_name = "ffx-repository"
    sdk_category = "partner"
  }

  # LINT.ThenChange(//src/developer/ffx/plugins/repository/BUILD.bazel:ffx_repository_tool)

  host_test_data("ffx_repository_tool_test_data") {
    data_deps = [ ":ffx_repository_tool_host_tool" ]
    sources = [
      "${host_tools_dir}/ffx-repository",
      "${host_tools_dir}/ffx-repository.json",
    ]
  }

  group("repository") {
    public_deps = [
      ":ffx_repository_tool",
      ":ffx_repository_tool_host_tool",
    ]
  }

  group("bin") {
    public_deps = [ ":ffx_repository_tool_versioned" ]
  }

  # TODO(https://fxbug.dev/438572714): Remove once the IDK uses the Bazel atom.
  _idk_path = "tools/$current_cpu/ffx_tools/ffx-repository"

  sdk_atom("sdk") {
    category = "partner"
    sdk_area = "Developer"
    id = "sdk://$_idk_path"
    idk_name = "ffx-repository"
    meta = {
      dest = "$_idk_path-meta.json"
      type = "ffx_tool"
      source_prebuild_info = {
        arch = current_cpu
        file_base = "tools"
      }
    }
    files = [
      {
        source = "$root_out_dir/ffx-repository"
        dest = _idk_path
      },
      {
        source = "$root_out_dir/ffx-repository.json"
        dest = "$_idk_path.json"
      },
    ]
    non_sdk_deps = [ ":ffx_repository_tool_versioned" ]
  }
}

group("tests") {
  testonly = true
  deps = [
    ":ffx_repository_tests($host_toolchain)",

    # Plugins migrated to Bazel define standalone unit test targets that are
    # not aggregated by `:ffx_repository_tests`.
    "create:tests",
    "default:tests",
    "publish:tests",
    "serve-archive:tests",
    "server/list:tests",
    "server/stop:tests",
  ]
}

