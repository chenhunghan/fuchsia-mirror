# src/server_impl.rs calls fuchsia_repo::test_utils::{make_empty_pm_repo_dir,
# make_repo_dir, make_pm_repository}, which read
# ./test_data/ffx_lib_pkg/empty-repo/{keys,repository} from disk at runtime
# (EMPTY_REPO_PATH in //src/sys/pkg/lib/fuchsia-repo/src/test_utils.rs), and
# //src/sys/pkg/lib/fuchsia-repo does not bundle those files. bazel2gn cannot
# translate `test_data`, so this test is marked @bazel2gn:skip and wired into
# //src/developer/ffx:tests in Bazel.
# @bazel2gn:skip
host_rustc_test(
    name = "ffx_repository_server_start_test",
    crate = ":ffx_repository_server_start",
    test_data = [
        "//src/developer/ffx/lib/pkg:empty-repo-keys",
        "//src/developer/ffx/lib/pkg:empty-repo-metadata",
    ],
    visibility = ["//src/developer/ffx:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust_fdomain",
        "//sdk/fidl/fuchsia.posix.socket:fuchsia.posix.socket_rust_fdomain",
        "//src/developer/ffx/config:lib",
        "//src/developer/ffx/fidl:fuchsia.developer.ffx_rust",
        "//src/developer/ffx/lib/discovery:lib",
        "//src/developer/ffx/lib/target:lib",
        "//src/developer/ffx/lib/target/behavior:lib",
        "//src/developer/ffx/lib/target_net:testutil",
        "//src/lib/assembly/partitions_config",
        "//src/lib/fdomain/client",
        "//src/lib/fdomain/local",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-hyper",
        "//src/sys/lib/fidl-fuchsia-pkg-rewrite-ext:fidl-fuchsia-pkg-rewrite-ext_fdomain",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:camino",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:tempfile",
        "//third_party/rust_crates/vendor:test-case",
        "//third_party/rust_crates/vendor:url",
    ],
)
