load("//src/developer/ffx/build:ffx_plugin.bzl", "ffx_plugin")

package(default_applicable_licenses = ["//:license"])

ffx_plugin(
    name = "ffx_repository_server",
    args_deps = [
        "//src/developer/ffx/core:lib",
        "//third_party/rust_crates/vendor:argh",
    ],
    args_srcs = ["src/args.rs"],
    edition = "2024",
    plugin_deps = [
        "//src/developer/ffx/plugins/repository/server/list:ffx_repository_server_list",
        "//src/developer/ffx/plugins/repository/server/start:ffx_repository_server_start",
        "//src/developer/ffx/plugins/repository/server/stop:ffx_repository_server_stop",
    ],
    sdk_category = "not-yet-specified",
    version = "0.1.0",
    visibility = ["//src/developer/ffx/plugins/repository:__pkg__"],
)
