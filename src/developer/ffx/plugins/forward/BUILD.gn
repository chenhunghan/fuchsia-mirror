import("//src/developer/ffx/build/ffx_tool.gni")

if (is_host) {
  bazel_ffx_tool("ffx_forward_tool") {
    output_name = "ffx-forward"
  }
}

group("forward") {
  public_deps = [
    ":ffx_forward_tool",
    ":ffx_forward_tool_host_tool",
  ]
}

group("bin") {
  public_deps = [ ":ffx_forward_tool_versioned" ]
}
