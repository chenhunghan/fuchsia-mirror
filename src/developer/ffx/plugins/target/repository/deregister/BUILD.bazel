load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//src/developer/ffx/build:ffx_plugin.bzl", "ffx_plugin")

package(default_applicable_licenses = ["//:license"])

ffx_plugin(
    name = "ffx_target_repository_deregister",
    srcs = ["src/lib.rs"],
    args_deps = [
        "//src/developer/ffx/core:lib",
        "//third_party/rust_crates/vendor:argh",
    ],
    args_srcs = ["src/args.rs"],
    edition = "2024",
    sdk_category = "not-yet-specified",
    version = "0.1.0",
    visibility = ["//src/developer/ffx/plugins/target/repository:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.pkg:fuchsia.pkg_rust_fdomain",
        "//sdk/fidl/fuchsia.pkg.rewrite:fuchsia.pkg.rewrite_rust_fdomain",
        "//sdk/rust/zx-status",
        "//src/developer/ffx/config:lib",
        "//src/developer/ffx/lib/fho:lib",
        "//src/developer/ffx/lib/pkg",
        "//src/developer/ffx/lib/target/holders:lib",
        "//src/developer/ffx/lib/writer:lib",
        "//src/sys/lib/fidl-fuchsia-pkg-rewrite-ext:fidl-fuchsia-pkg-rewrite-ext_fdomain",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:schemars",
        "//third_party/rust_crates/vendor:serde",
    ],
)

host_rustc_test(
    name = "ffx_target_repository_deregister_test",
    crate = ":ffx_target_repository_deregister",
    visibility = ["//src/developer/ffx:__pkg__"],
    deps = [
        "//src/lib/fdomain/client",
        "//src/lib/fdomain/local",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/sys/lib/fidl-fuchsia-pkg-ext",
        "//src/sys/pkg/lib/fuchsia-repo",
        "//third_party/rust_crates/vendor:camino",
        "//third_party/rust_crates/vendor:futures",
    ],
)
