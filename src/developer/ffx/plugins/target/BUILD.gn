import("//build/testing/host_test_data.gni")
import("//src/developer/ffx/build/ffx_tool.gni")

if (is_host) {
  bazel_ffx_tool("ffx_target_tool") {
    output_name = "ffx-target"
  }

  host_test_data("ffx_target_tool_test_data") {
    visibility = [
      "//src/connectivity/network/testing/conformance/emulator:*",
      "//src/developer/ffx/tests/connection:*",
      "//third_party/network-conformance/*",
    ]
    data_deps = [ ":ffx_target_tool_host_tool" ]
    sources = [
      "${host_tools_dir}/ffx-target",
      "${host_tools_dir}/ffx-target.json",
    ]
  }

  group("tests") {
    testonly = true
    deps = [
      # `:ffx_target_tests` aggregates `<subdir>:<plugin_name>_tests` for
      # unmigrated plugins in `plugin_deps` below.
      ":ffx_target_tests",
      "list/target_formatter:target_formatter_test",
      "package:tests",
      "repository:tests",

      # Plugins migrated to Bazel define standalone unit test targets that are
      # not aggregated by `:ffx_target_tests`.
      "add:tests",
      "bootloader:tests",
      "discover:tests",
      "echo:tests",
      "fastboot:tests",
      "flash:tests",
      "get-time:tests",
      "list:tests",
      "log-message:tests",
      "off:tests",
      "reboot:tests",
      "remove:tests",
      "screenshot:tests",
      "show:tests",
      "snapshot:tests",
      "ssh:tests",
      "update:tests",
      "wait:tests",
      "wipe:tests",
    ]
  }

  group("host_tests") {
    testonly = true
    deps = [
      "package:host_tests",
      "ssh:host_tests",
    ]
  }
}

