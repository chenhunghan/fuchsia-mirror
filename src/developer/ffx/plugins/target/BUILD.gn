    "//src/developer/ffx/plugins/target/echo:ffx_target_echo",
    "//src/developer/ffx/plugins/target/fastboot:ffx_fastboot_tool",
    "//src/developer/ffx/plugins/target/flash:ffx_flash",
    "//src/developer/ffx/plugins/target/get-time:ffx_target_get_time",
    "//src/developer/ffx/plugins/target/list:ffx_list",
    "//src/developer/ffx/plugins/target/log-message:ffx_target_log_message",
    "//src/developer/ffx/plugins/target/off:ffx_off",
    "//src/developer/ffx/plugins/target/package:ffx_target_package",
    "//src/developer/ffx/plugins/target/reboot:ffx_reboot",
    "//src/developer/ffx/plugins/target/remove:ffx_target_remove",
    "//src/developer/ffx/plugins/target/repository:ffx_target_repository",
    "//src/developer/ffx/plugins/target/screenshot:ffx_target_screenshot",
