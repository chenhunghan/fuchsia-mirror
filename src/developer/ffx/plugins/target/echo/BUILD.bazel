load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//src/developer/ffx/build:ffx_plugin.bzl", "ffx_plugin")

package(default_applicable_licenses = ["//:license"])

ffx_plugin(
    name = "ffx_target_echo",
    srcs = ["src/lib.rs"],
    args_deps = [
        "//src/developer/ffx/core:lib",
        "//third_party/rust_crates/vendor:argh",
    ],
    args_srcs = ["src/args.rs"],
    edition = "2024",
    proc_macro_deps = ["//src/developer/ffx/lib/traceable_error/derive:lib"],
    sdk_category = "not-yet-specified",
    version = "0.1.0",
    visibility = ["//src/developer/ffx/plugins/target:__pkg__"],
    deps = [
        "//src/developer/ffx/lib/errors:lib",
        "//src/developer/ffx/lib/fho:lib",
        "//src/developer/ffx/lib/target/connector:lib",
        "//src/developer/ffx/lib/target/holders:lib",
        "//src/developer/ffx/lib/traceable_error:lib",
        "//src/developer/ffx/lib/writer:lib",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:schemars",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

host_rustc_test(
    name = "ffx_target_echo_args_test",
    crate = ":ffx_target_echo_args",
    visibility = ["//src/developer/ffx:__pkg__"],
)

host_rustc_test(
    name = "ffx_target_echo_test",
    crate = ":ffx_target_echo",
    visibility = ["//src/developer/ffx:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.developer.remotecontrol:fuchsia.developer.remotecontrol_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        # These dependencies are host-only and will cause assertion failures
        # if evaluated for target toolchains.
        "//src/developer/ffx/config:lib",
        "//src/developer/ffx/lib/target/behavior:lib",
        "//src/lib/fdomain/client",
        "//src/lib/fdomain/local",
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:serde_json",
    ],
)
