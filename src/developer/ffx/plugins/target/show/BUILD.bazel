load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//src/developer/ffx/build:ffx_plugin.bzl", "ffx_plugin")

package(default_applicable_licenses = ["//:license"])

ffx_plugin(
    name = "ffx_target_show",
    srcs = [
        "src/lib.rs",
        "src/show.rs",
    ],
    args_deps = [
        "//src/developer/ffx/core:lib",
        "//third_party/rust_crates/vendor:argh",
    ],
    args_srcs = ["src/args.rs"],
    edition = "2024",
    sdk_category = "not-yet-specified",
    version = "0.1.0",
    visibility = [
        "//src/developer/ffx/plugins/doctor:__pkg__",
        "//src/developer/ffx/plugins/target:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.buildinfo:fuchsia.buildinfo_rust_fdomain",
        "//sdk/fidl/fuchsia.developer.remotecontrol:fuchsia.developer.remotecontrol_rust_fdomain",
        "//sdk/fidl/fuchsia.feedback:fuchsia.feedback_rust_fdomain",
        "//sdk/fidl/fuchsia.hwinfo:fuchsia.hwinfo_rust_fdomain",
        "//sdk/fidl/fuchsia.update.channel:fuchsia.update.channel_rust_fdomain",
        "//sdk/fidl/fuchsia.update.channelcontrol:fuchsia.update.channelcontrol_rust_fdomain",
        "//src/developer/ffx/lib/errors:lib",
        "//src/developer/ffx/lib/fho:lib",
        "//src/developer/ffx/lib/netext:lib",
        "//src/developer/ffx/lib/target:lib",
        "//src/developer/ffx/lib/target/behavior:lib",
        "//src/developer/ffx/lib/target/holders:lib",
        "//src/developer/ffx/lib/timeout:lib",
        "//src/developer/ffx/lib/writer:lib",
        "//src/lib/fdomain/client",
        "//src/lib/fidl/rust/fidl",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:schemars",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:termion",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

host_rustc_test(
    name = "ffx_target_show_test",
    crate = ":ffx_target_show",
    visibility = ["//src/developer/ffx:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.intl:fuchsia.intl_rust_fdomain",
        "//src/developer/ffx/config:lib",
        "//src/developer/ffx/lib/testing:lib",
        "//src/lib/fdomain/local",
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:serde_json",
    ],
)
