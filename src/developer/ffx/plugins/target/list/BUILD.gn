ffx_plugin("ffx_list") {
  sources = [ "src/lib.rs" ]
  args_deps = [
    "//src/developer/ffx/core:lib",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
    "//third_party/rust_crates:bitflags",
  ]
  args_sources = [ "src/args.rs" ]
  edition = "2024"
  sdk_category = "not-yet-specified"
  version = "0.1.0"
  visibility = [
    ":*",
    "//src/developer/ffx/plugins/devices:*",
    "//src/developer/ffx/plugins/target:*",
    "//src/developer/ffx/plugins/target/list/target_formatter:*",
  ]
  deps = [
    "//src/developer/ffx/config:lib",
    "//src/developer/ffx/lib/errors:lib",
    "//src/developer/ffx/lib/fho:lib",
    "//src/developer/ffx/lib/target:lib",
    "//src/developer/ffx/lib/target/behavior:lib",
    "//src/developer/ffx/lib/writer:lib",
    "//src/developer/ffx/plugins/target/list/target_formatter",
    "//src/lib/analytics/rust:lib",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia-async",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:thiserror",
  ]
}
if (is_host) {
  rustc_test("ffx_list_test") {
    sources = [ "src/lib.rs" ]
    edition = "2024"
    deps = [
             ":ffx_list_args",
             "//src/developer/ffx/config:lib",
             "//src/developer/ffx/lib/errors:lib",
             "//src/developer/ffx/lib/fho:lib",
             "//src/developer/ffx/lib/target:lib",
             "//src/developer/ffx/lib/target/behavior:lib",
             "//src/developer/ffx/lib/writer:lib",
             "//src/developer/ffx/plugins/target/list/target_formatter",
             "//src/lib/analytics/rust:lib",
             "//src/lib/fidl/rust/fidl",
             "//src/lib/fuchsia-async",
             "//third_party/rust_crates:anyhow",
             "//third_party/rust_crates:log",
             "//third_party/rust_crates:thiserror",
           ] +
           [
             "//src/developer/ffx/command:lib",
             "//src/developer/ffx/lib/addr:lib",
             "//src/developer/ffx/lib/writer:lib",
             "//src/lib/fuchsia",
             "//third_party/rust_crates:serde_json",
