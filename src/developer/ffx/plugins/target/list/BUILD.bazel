load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//src/developer/ffx/build:ffx_plugin.bzl", "ffx_plugin")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [":ffx_list_test"],
    visibility = ["//src/developer/ffx:__pkg__"],
)

ffx_plugin(
    name = "ffx_list",
    srcs = ["src/lib.rs"],
    args_deps = [
        "//src/developer/ffx/core:lib",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:bitflags",
    ],
    args_srcs = ["src/args.rs"],
    edition = "2024",
    sdk_category = "not-yet-specified",
    version = "0.1.0",
    visibility = [
        "//src/developer/ffx/plugins/devices:__pkg__",
        "//src/developer/ffx/plugins/target:__pkg__",
        "//src/developer/ffx/plugins/target/list/target_formatter:__pkg__",
    ],
    deps = [
        "//src/developer/ffx/config:lib",
        "//src/developer/ffx/lib/errors:lib",
        "//src/developer/ffx/lib/fho:lib",
        "//src/developer/ffx/lib/target:lib",
        "//src/developer/ffx/lib/target/behavior:lib",
        "//src/developer/ffx/lib/writer:lib",
        "//src/developer/ffx/plugins/target/list/target_formatter",
        "//src/lib/analytics/rust:lib",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

host_rustc_test(
    name = "ffx_list_test",
    crate = ":ffx_list",
    deps = [
        "//src/developer/ffx/command:lib",
        "//src/developer/ffx/lib/addr:lib",
        "//src/developer/ffx/lib/writer:lib",
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:tempfile",
    ],
)
