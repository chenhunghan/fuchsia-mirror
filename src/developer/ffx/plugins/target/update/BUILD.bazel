host_rustc_test(
    name = "ffx_update_args_test",
    crate = ":ffx_update_args",
    deps = ["//third_party/rust_crates/vendor:assert_matches"],
)

# src/lib.rs calls fuchsia_repo::test_utils::make_repo_dir, which reads
# ./test_data/ffx_lib_pkg/empty-repo/{keys,repository} at runtime.
# bazel2gn cannot translate `test_data`, so this test is marked @bazel2gn:skip
# and wired into //src/developer/ffx:tests in Bazel.
# @bazel2gn:skip
host_rustc_test(
    name = "ffx_update_test",
    crate = ":ffx_update",
    test_data = [
        "//src/developer/ffx/lib/pkg:empty-repo-keys",
        "//src/developer/ffx/lib/pkg:empty-repo-metadata",
    ],
    deps = [
        "//sdk/fidl/fuchsia.developer.remotecontrol:fuchsia.developer.remotecontrol_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.pkg:fuchsia.pkg_rust",
        "//sdk/fidl/fuchsia.pkg.rewrite:fuchsia.pkg.rewrite_rust",
        "//src/developer/ffx/lib/target:lib",
        "//src/developer/ffx/lib/target/behavior:lib",
        "//src/lib/assembly/partitions_config",
        "//src/lib/assembly/release_info",
        "//src/lib/fdomain/client",
        "//src/lib/fdomain/local",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-hyper",
        "//src/lib/fuchsia-url",
        "//src/sys/pkg/lib/fuchsia-repo",
        "//src/sys/pkg/testing/mock-installer:mock-installer_fdomain",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:http-body-util",
        "//third_party/rust_crates/vendor:hyper",
        "//third_party/rust_crates/vendor:tempfile",
    ],
)
