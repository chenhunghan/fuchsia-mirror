load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//src/developer/ffx/build:ffx_plugin.bzl", "ffx_plugin")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [
        ":ffx_flash_args_test",
        ":ffx_flash_test",
    ],
    visibility = ["//src/developer/ffx:__pkg__"],
)

ffx_plugin(
    name = "ffx_flash",
    srcs = ["src/lib.rs"],
    args_deps = [
        "//src/developer/ffx/config:lib",
        "//src/developer/ffx/core:lib",
        "//src/developer/ffx/lib/fastboot/flash_manifest:lib",
        "//third_party/rust_crates/vendor:argh",
    ],
    args_srcs = ["src/args.rs"],
    edition = "2024",
    sdk_category = "not-yet-specified",
    version = "0.1.0",
    visibility = ["//src/developer/ffx/plugins/target:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.hardware.power.statecontrol:fuchsia.hardware.power.statecontrol_rust_fdomain",
        "//sdk/fidl/fuchsia.hwinfo:fuchsia.hwinfo_rust_fdomain",
        "//src/developer/ffx/config:lib",
        "//src/developer/ffx/lib/discovery:lib",
        "//src/developer/ffx/lib/errors:lib",
        "//src/developer/ffx/lib/fastboot:lib",
        "//src/developer/ffx/lib/fastboot/connection_factory:lib",
        "//src/developer/ffx/lib/fastboot/flash_manifest:lib",
        "//src/developer/ffx/lib/fastboot/interface:lib",
        "//src/developer/ffx/lib/fho:lib",
        "//src/developer/ffx/lib/pbms:lib",
        "//src/developer/ffx/lib/ssh:lib",
        "//src/developer/ffx/lib/target:lib",
        "//src/developer/ffx/lib/target/holders:lib",
        "//src/developer/ffx/lib/writer:lib",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/gcs",
        "//src/lib/structured_ui",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:chrono",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:schemars",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:signal-hook",
        "//third_party/rust_crates/vendor:tempfile",
        "//third_party/rust_crates/vendor:termion",
        "//third_party/rust_crates/vendor:thiserror",
        "//third_party/rust_crates/vendor:tokio",
        "//third_party/rust_crates/vendor:url",
    ],
)

host_rustc_test(
    name = "ffx_flash_args_test",
    crate = ":ffx_flash_args",
    deps = [
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:tempfile",
    ],
)

host_rustc_test(
    name = "ffx_flash_test",
    crate = ":ffx_flash",
    deps = [
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:pretty_assertions",
        "//third_party/rust_crates/vendor:serde_json",
    ],
)
