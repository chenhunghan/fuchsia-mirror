load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//src/developer/ffx/build:ffx_plugin.bzl", "ffx_plugin")

package(default_applicable_licenses = ["//:license"])

ffx_plugin(
    name = "ffx_target_ssh",
    srcs = ["src/lib.rs"],
    args_deps = [
        "//src/developer/ffx/core:lib",
        "//third_party/rust_crates/vendor:argh",
    ],
    args_srcs = ["src/args.rs"],
    edition = "2024",
    sdk_category = "not-yet-specified",
    version = "0.1.0",
    visibility = ["//src/developer/ffx/plugins/target:__pkg__"],
    deps = [
        "//src/developer/ffx/command:lib",
        "//src/developer/ffx/config:lib",
        "//src/developer/ffx/lib/addr:lib",
        "//src/developer/ffx/lib/fho:lib",
        "//src/developer/ffx/lib/netext:lib",
        "//src/developer/ffx/lib/ssh:lib",
        "//src/developer/ffx/lib/target/holders:lib",
        "//src/developer/ffx/lib/writer:lib",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:nix",
        "//third_party/rust_crates/vendor:tokio",
    ],
)

host_rustc_test(
    name = "ffx_target_ssh_args_test",
    crate = ":ffx_target_ssh_args",
    visibility = ["//src/developer/ffx:__pkg__"],
)

host_rustc_test(
    name = "ffx_target_ssh_test",
    crate = ":ffx_target_ssh",
    visibility = ["//src/developer/ffx:__pkg__"],
    deps = [
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:itertools",
        "//third_party/rust_crates/vendor:pretty_assertions",
        "//third_party/rust_crates/vendor:serde_json",
    ],
)
