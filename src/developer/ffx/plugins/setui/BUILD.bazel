load("//build/bazel/rules/idk:idk_ffx_tool.bzl", "idk_ffx_tool")
load("//src/developer/ffx/build:ffx_plugin.bzl", "ffx_plugin")

package(default_applicable_licenses = ["//:license"])

ffx_plugin(
    name = "ffx_setui",
    args_deps = [
        "//src/developer/ffx/core:lib",
        "//third_party/rust_crates/vendor:argh",
    ],
    args_srcs = ["src/args.rs"],
    edition = "2024",
    plugin_deps = [
        "//src/developer/ffx/plugins/setui/accessibility:ffx_setui_accessibility",
        "//src/developer/ffx/plugins/setui/audio:ffx_setui_audio",
        "//src/developer/ffx/plugins/setui/display:ffx_setui_display",
        "//src/developer/ffx/plugins/setui/do_not_disturb:ffx_setui_do_not_disturb",
        "//src/developer/ffx/plugins/setui/factory_reset:ffx_setui_factory_reset",
        "//src/developer/ffx/plugins/setui/input:ffx_setui_input",
        "//src/developer/ffx/plugins/setui/intl:ffx_setui_intl",
        "//src/developer/ffx/plugins/setui/keyboard:ffx_setui_keyboard",
        "//src/developer/ffx/plugins/setui/light:ffx_setui_light",
        "//src/developer/ffx/plugins/setui/night_mode:ffx_setui_night_mode",
        "//src/developer/ffx/plugins/setui/privacy:ffx_setui_privacy",
        "//src/developer/ffx/plugins/setui/setup:ffx_setui_setup",
    ],
    sdk_category = "not-yet-specified",
    version = "0.1.0",
)

# LINT.IfChange
idk_ffx_tool(
    name = "ffx_setui_tool",
    srcs = ["src/main.rs"],
    category = "partner",
    edition = "2024",
    idk_name = "ffx-setui",
    visibility = ["//:__subpackages__"],
    deps = [
        ":ffx_setui_suite",
        "//src/lib/fuchsia-async",
    ],
)
# LINT.ThenChange(BUILD.gn)
