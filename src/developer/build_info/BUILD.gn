static_library("lib") {
  sources = [ "build_info.cc" ]
  public = [ "build_info.h" ]
  public_deps = [
    "//sdk/fidl/fuchsia.buildinfo:fuchsia.buildinfo_cpp",
    "//sdk/lib/async-loop:async-loop-cpp",
    "//sdk/lib/async-loop:async-loop-default",
    "//sdk/lib/syslog/cpp",
    "//src/lib/fsl",
  ]
}

executable("build_info") {
  sources = [ "main.cc" ]
  deps = [
    ":lib",
    "//sdk/lib/async-loop:async-loop-cpp",
    "//sdk/lib/async-loop:async-loop-default",
    "//sdk/lib/component/outgoing/cpp",
    "//sdk/lib/syslog/cpp",
  ]
}

fuchsia_component_manifest("build-info-manifest") {
  component_name = "build-info"
  manifest = "meta/build_info.cml"
}

fuchsia_component("build-info-component") {
  cm_label = ":build-info-manifest"
  visibility = [
    ":*",
    "//build/bazel/rules/tests/*",
  ]
  deps = [ ":build_info" ]
}

rustc_binary("shell_bin") {
  sources = [ "shell.rs" ]
  output_name = "build-info"
  source_root = "shell.rs"
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.buildinfo:fuchsia.buildinfo_rust",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
    "//third_party/rust_crates:futures",
  ]
}

executable("build_info_unittest_bin") {
  testonly = true
  sources = [ "build_info_unittest.cc" ]
  deps = [
    ":lib",
    "//sdk/lib/vfs/cpp",
    "//src/lib/fxl/test:gtest_main",
    "//src/lib/testing/loop_fixture",
  ]
}
