import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_binary("launcher_bin") {
  sources = [
    "src/error.rs",
    "src/io.rs",
    "src/main.rs",
    "src/namespace.rs",
    "src/process.rs",
    "src/program.rs",
    "src/util.rs",
  ]
  output_name = "developer-console"
  configs += [
    "//build/config/rust:bootfs",
    "//build/config/rust/lints:deny_unused_results",
  ]
  edition = "2024"
  lint_config = "//build/config/rust/lints:clippy_warn_all"
  deps = [
    "//sdk/fidl/fuchsia.component.runner:fuchsia.component.runner_rust",
    "//sdk/fidl/fuchsia.developer.console:fuchsia.developer.console_rust",
    "//sdk/fidl/fuchsia.device:fuchsia.device_rust",
    "//sdk/fidl/fuchsia.hardware.pty:fuchsia.hardware.pty_rust",
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/fidl/fuchsia.process:fuchsia.process_rust",
    "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-fs",
    "//src/lib/fuchsia-runtime",
    "//src/sys/lib/library_loader",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:thiserror",
  ]
}

fuchsia_component_manifest("manifest") {
  component_name = "developer-console"
  manifest = "meta/developer-console.cml"
}

fuchsia_component("component") {
  cm_label = ":manifest"
  visibility = [
    ":*",
    "//src/developer/console/test:*",
  ]
  deps = [ ":launcher_bin" ]
}
