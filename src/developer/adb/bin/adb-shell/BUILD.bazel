load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/components:structured_config.bzl",
    "fuchsia_structured_config_cpp_elf_lib",
)
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [],  # Include all tests in the package.
    visibility = ["//src/developer:__pkg__"],
)

fx_cc_library(
    name = "common",
    srcs = ["adb-shell.cc"],
    hdrs = ["adb-shell.h"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        ":adb-shell-config",
        "//sdk/fidl/fuchsia.dash:fuchsia.dash_cpp",
        "//sdk/fidl/fuchsia.hardware.adb:fuchsia.hardware.adb_cpp",
        "//sdk/fidl/fuchsia.io:fuchsia.io_cpp",
        "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_cpp",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/component/incoming/cpp",
        "//sdk/lib/component/outgoing/cpp",
        "//sdk/lib/sys/cpp",
        "//sdk/lib/syslog/cpp",
        "//zircon/system/ulib/fbl",
    ],
    alwayslink = True,
)

fx_cc_binary(
    name = "adb-shell",
    srcs = ["main.cc"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [":common"],
)

fx_packaged_binary(
    name = "adb-shell-packaged",
    binary = ":adb-shell",
    binary_name = "adb-shell",
)

fx_component_manifest(
    name = "manifest",
    component_name = "adb-shell",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/adb-shell.cml",
)

fuchsia_structured_config_cpp_elf_lib(
    name = "adb-shell-config",
    cm_label = ":manifest",
)

fx_component(
    name = "adb-shell-component",
    compiled_manifest = ":manifest",
    visibility = ["//src/developer/adb/bin:__pkg__"],
    deps = [":adb-shell-packaged"],
)

fx_cc_test_binary(
    name = "adb-shell-test-bin",
    srcs = ["adb-shell-test.cc"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        ":common",
        "//sdk/fidl/fuchsia.dash:fuchsia.dash_cpp_testing",
        "//sdk/fidl/fuchsia.hardware.adb:fuchsia.hardware.adb_cpp_testing",
        "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_cpp_testing",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop-testing/cpp",
        "//sdk/lib/sys/cpp/testing:cpp",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_package(
    name = "adb-shell-test",
    unit_tests = [":adb-shell-test-bin"],
)
