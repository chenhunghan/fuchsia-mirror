load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")

package(default_applicable_licenses = ["//:license"])

# TODO(https://fxbug.dev/570694755): Verify whether adb-file-sync should use target_compatible_with (was not gated by if (is_fuchsia) in GN).
fx_cc_library(
    name = "adb-file-sync",
    srcs = [
        "file_sync_service.cc",
        "util.cc",
    ],
    hdrs = [
        "adb-file-sync-base.h",
        "file_sync_service.h",
        "util.h",
    ],
    includes = ["."],
    public_configs = [":adb-file-sync-headers"],
    # Uses Zircon socket/channel headers and fuchsia.io FIDL bindings without host guards.
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = [
        "//src/developer/adb/bin/adb-file-sync:__pkg__",
        "//src/developer/adb/third_party:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.io:fuchsia.io_cpp",
        "//sdk/lib/syslog/cpp",
        "//zircon/system/ulib/zx",
    ],
    alwayslink = True,
)
