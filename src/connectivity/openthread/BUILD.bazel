# OpenThread device tests defined in Bazel. These are exported to `fx test` and
# infra builders through `:bazel_tests` in BUILD.gn.
test_suite(
    name = "openthread_tests",
    target_compatible_with = ["@platforms//os:fuchsia"],
    tests = [
        "//src/connectivity/openthread/tests/ot-rcp-fuchsia:tests",
        "//src/connectivity/openthread/tests/ot-rcp-fuchsia/tests/mock-spinel-host:tests",
        "//src/connectivity/openthread/tests/rf_medium_dispatcher:tests",
    ],
)
