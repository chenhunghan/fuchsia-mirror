import("//build/bazel/bazel_fuchsia_package.gni")

# Kept in GN because the GN packages of
# //src/connectivity/lowpan/tests/thread-integration-tests subpackage it.
bazel_fuchsia_package("ot-rcp-fuchsia") {
  bazel_config = "fuchsia_platform"
  package_name = "ot-rcp-fuchsia"
  testonly = true
  visibility = [ "//src/connectivity/lowpan/tests/thread-integration-tests/*" ]
}

group("tests") {
  testonly = true
  deps = [
    ":ot-rcp-fuchsia-platform-unittests",
    ":ot-rcp-fuchsia-spinel-device-server-unittests",
    "tests/mock-spinel-host:tests",
  ]
}

