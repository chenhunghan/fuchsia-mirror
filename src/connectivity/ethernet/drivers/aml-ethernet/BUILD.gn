import("//build/bind/bind.gni")
import("//build/components.gni")
import("//build/drivers.gni")
import("//build/test.gni")

fuchsia_driver_dml("aml-ethernet-dml") {
  dml = "meta/aml-ethernet.dml"
  driver_name = "aml-ethernet"
}

fuchsia_driver_dml_cpp_parser("aml-ethernet-metadata") {
  dml_label = ":aml-ethernet-dml"
}

driver_bind_rules("aml_eth_bind") {
  dml_label = ":aml-ethernet-dml"
  tests = "meta/bind-tests.json"
  deps = [
    "//src/devices/bind/fuchsia",
    "//src/devices/bind/fuchsia.amlogic.platform",
    "//src/devices/bind/fuchsia.gpio",
    "//src/devices/bind/fuchsia.platform",
  ]
}

source_set("common") {
  configs += [
    "//build/config:all_source",
    "//build/config/fuchsia:enable_zircon_asserts",
  ]
  sources = [
    "aml-ethernet.cc",
    "aml-ethernet.h",
  ]
  public_deps = [
    ":aml-ethernet-metadata",
    ":aml_eth_bind",
    "//sdk/fidl/fuchsia.driver.metadata:fuchsia.driver.metadata_cpp",
    "//sdk/fidl/fuchsia.hardware.ethernet.board:fuchsia.hardware.ethernet.board_cpp",
    "//sdk/fidl/fuchsia.hardware.gpio:fuchsia.hardware.gpio_cpp",
    "//sdk/lib/component/outgoing/cpp",
    "//sdk/lib/driver/mmio/cpp",
    "//sdk/lib/driver/platform-device/cpp",
    "//src/devices/bind/fuchsia:fuchsia_cpp",
    "//src/devices/i2c/lib/i2c-channel-legacy",
    "//src/devices/lib/amlogic",
    "//src/devices/usb/lib/usb",
    "//src/lib/ddk",
    "//src/lib/ddktl",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/pretty",
    "//zircon/system/ulib/sync",
    "//zircon/system/ulib/zircon-internal",
    "//zircon/system/ulib/zx",
  ]
}

fuchsia_cc_driver("aml-ethernet-driver") {
  legacy = true
  output_name = "aml-ethernet"
  deps = [
    ":common",
    "//src/devices/lib/driver",
    "//src/devices/lib/driver:driver_runtime",
  ]
}

fuchsia_driver_component("aml-ethernet") {
  component_name = "aml-ethernet"
  deps = [ ":aml-ethernet-driver" ]
  dml_label = ":aml-ethernet-dml"
}

fuchsia_driver_package("package") {
  package_name = "aml-ethernet"
  driver_components = [ ":aml-ethernet" ]
}

test("aml-ethernet-test-bin") {
  output_name = "aml-ethernet-test"
  sources = [ "aml-ethernet-test.cc" ]
  deps = [
    ":common",
    "//sdk/lib/async-loop:async-loop-cpp",
    "//sdk/lib/async-loop:async-loop-default",
    "//sdk/lib/async_patterns/testing/cpp",
    "//sdk/lib/component/outgoing/cpp",
    "//sdk/lib/driver/fake-platform-device/cpp",
    "//sdk/lib/driver/runtime/testing/cpp",
    "//src/devices/bin/driver_runtime",
    "//src/devices/gpio/testing/fake-gpio",
    "//src/devices/testing/mock-ddk",
    "//zircon/system/ulib/zxtest",
  ]
}

fuchsia_unittest_package("aml-ethernet-test") {
  deps = [ ":aml-ethernet-test-bin" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}

group("tests") {
  testonly = true
  deps = [
    ":aml-ethernet-test",
    ":aml_eth_bind_test",
  ]
}
