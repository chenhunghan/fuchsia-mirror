load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "wrap_host_rust_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load(
    "//build/bazel/rules/testing:fx_unittest_package.bzl",
    "fx_unittest_package",
)

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":usb-ncm-function-ntb-test"],
    visibility = ["//src/connectivity:__pkg__"],
)

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [":ntb_host_test"],
    visibility = ["//src/connectivity:__pkg__"],
)

rustc_library(
    name = "ntb",
    srcs = [
        "src/ntb/builder.rs",
        "src/ntb/error.rs",
        "src/ntb/lib.rs",
        "src/ntb/parser.rs",
        "src/ntb/wire.rs",
    ],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate_name = "usb_ncm_ntb",
    crate_root = "src/ntb/lib.rs",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    deps = [
        "//src/lib/network/packet",
        "//third_party/rust_crates/vendor:thiserror",
        "//third_party/rust_crates/vendor:zerocopy",
    ],
)

rustc_test(
    name = "ntb_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":ntb",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
)

wrap_host_rust_test(
    name = "ntb_host_test",
    binary_name = "ntb_test",
)

fx_unittest_package(
    name = "usb-ncm-function-ntb-test",
    unit_tests = [":ntb_test"],
)
