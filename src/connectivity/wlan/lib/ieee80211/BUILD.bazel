load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "ieee80211",
    srcs = [
        "src/bssid.rs",
        "src/lib.rs",
        "src/mac_addr.rs",
        "src/ssid.rs",
    ],
    edition = "2024",
    visibility = [
        "//src/connectivity/wlan:__subpackages__",
        "//vendor/google:__subpackages__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.wlan.ieee80211:fuchsia.wlan.ieee80211_rust",
        "//src/diagnostics/lib/redactor",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:arbitrary",
        "//third_party/rust_crates/vendor:thiserror",
        "//third_party/rust_crates/vendor:zerocopy",
    ],
)

rustc_test(
    name = "ieee80211_test",
    crate = ":ieee80211",
    visibility = ["//visibility:private"],
)

# Exercises the process-global redactor, so it must be its own binary.
rustc_test(
    name = "ieee80211-redaction_test",
    srcs = ["tests/redaction.rs"],
    crate_root = "tests/redaction.rs",
    edition = "2024",
    visibility = ["//visibility:private"],
    deps = [
        ":ieee80211",
        "//src/diagnostics/lib/redactor",
    ],
)

fx_unittest_package(
    name = "ieee80211-tests",
    unit_tests = [
        ":ieee80211_test",
        ":ieee80211-redaction_test",
    ],
    visibility = ["//src/connectivity/wlan:__pkg__"],
)
