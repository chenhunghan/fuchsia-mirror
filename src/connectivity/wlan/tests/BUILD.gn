import("//src/connectivity/wlan/tests/wlan_python_architecture_test.gni")

if (is_host) {
  wlan_python_architecture_test("architecture_test") {
    main_source = "architecture_test.py"
    tracked_gn_files = [
      "//src/connectivity/wlan/tests/common/BUILD.gn",
      "//src/connectivity/wlan/tests/core/BUILD.gn",
      "//src/connectivity/wlan/tests/utils/BUILD.gn",
      "//src/connectivity/wlan/tests/wlancfg/BUILD.gn",
      "//src/connectivity/wlan/tests/wlancfg/wmm_testing/BUILD.gn",
      "//src/connectivity/wlan/tests/wlanix/BUILD.gn",
      "//src/connectivity/wlan/tests/wlanix/power/BUILD.gn",
      "//src/connectivity/wlan/tests/wlanix/wlanix_testing/BUILD.gn",
      "//src/testing/end_to_end/honeydew/honeydew/affordances/connectivity/wlan/wlan_policy/tests/BUILD.gn",
      "//src/testing/end_to_end/honeydew/honeydew/affordances/connectivity/wlan/wlan_policy_ap/tests/BUILD.gn",
    ]
    extra_python_sources = [ "//src/testing/end_to_end/mobly_base_tests/fuchsia_wlan_base_test/__init__.py" ]
  }
}

group("tests") {
  testonly = true
  deps = [
    ":architecture_test($host_toolchain)",
    "drivers-only/fullmac-tests",
    "helpers/realm-factory:realm-factory-tests",
    "helpers/testcontroller-driver:tests",
  ]
}

# This is a helper group, intended so that developers can easily add all tests
# to their build. It is not load-bearing in infra, because our e2e host tests
# are split into more granular groups in their respective BUILD.gn files.
group("tests_host") {
  testonly = true
  deps = [
    "core:tests_host($host_toolchain)",
    "utils:tests_host($host_toolchain)",
    "wlancfg:tests_host($host_toolchain)",
    "wlanix:tests_host($host_toolchain)",
  ]
}
