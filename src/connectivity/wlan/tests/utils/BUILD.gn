import("//build/python/python_host_test.gni")
import("//build/python/python_library.gni")

if (is_host) {
  python_library("architecture_check") {
    testonly = true
    library_name = "wlan_architecture_check"
    sources = [
      "__init__.py",
      "architecture_check.py",
    ]
  }

  python_library("wlan_test_utils") {
    testonly = true
    imports = [ "." ]
    sources = [
      "wlan_test_utils/__init__.py",
      "wlan_test_utils/odpm_utils.py",
      "wlan_test_utils/throughput_utils.py",
    ]
    library_deps = [
      "//src/performance/lib/perf_publish",
      "//src/performance/lib/reporting",
      "//src/performance/lib/trace_processing",
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_controller/legacy_access_point",
      "//src/testing/end_to_end/mobly_controller/openwrt_access_point",
      "//third_party/mobly",
    ]
  }

  python_host_test("odpm_utils_test") {
    main_source = "odpm_utils_test.py"
    libraries = [ ":wlan_test_utils" ]
    data_package_name = "test_data"
    data_sources = [ "//src/tests/end_to_end/perf/expected_metric_names/fuchsia.wlan.test_scan_while_connected.txt" ]
  }

  python_host_test("throughput_utils_test") {
    main_source = "throughput_utils_test.py"
    libraries = [ ":wlan_test_utils" ]
  }
}

group("tests_host") {
  testonly = true
  public_deps = [
    ":odpm_utils_test($host_toolchain)",
    ":throughput_utils_test($host_toolchain)",
  ]
}
