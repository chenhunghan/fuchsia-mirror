load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":bt-hfp-audio-gateway-integration-tests"],
    visibility = ["//src/connectivity/bluetooth:__pkg__"],
)

rustc_test(
    name = "tests_bin",
    srcs = ["src/main.rs"],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    edition = "2024",
    proc_macro_deps = ["//src/lib/testing/fixture"],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//sdk/fidl/fuchsia.bluetooth.bredr:fuchsia.bluetooth.bredr_rust",
        "//sdk/fidl/fuchsia.bluetooth.hfp:fuchsia.bluetooth.hfp_rust",
        "//sdk/fidl/fuchsia.bluetooth.internal.a2dp:fuchsia.bluetooth.internal.a2dp_rust",
        "//sdk/fidl/fuchsia.hardware.audio:fuchsia.hardware.audio_rust",
        "//sdk/fidl/fuchsia.media:fuchsia.media_rust",
        "//sdk/rust/zx",
        "//src/connectivity/bluetooth/lib/fuchsia-audio-dai",
        "//src/connectivity/bluetooth/lib/fuchsia-bluetooth",
        "//src/connectivity/bluetooth/testing/mock-piconet-server:lib",
        "//src/connectivity/bluetooth/testing/realmbuilder-mock-helpers",
        "//src/connectivity/bluetooth/testing/test-call-manager",
        "//src/connectivity/lib/at-commands",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component-test",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:bitflags",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

fx_packaged_binary(
    name = "tests_bin_packaged_bin",
    testonly = True,
    binary = ":tests_bin",
    binary_name = "bt_hfp_audio_gateway_integration_tests",
)

fx_component_manifest(
    name = "bt_hfp_audio_gateway_integration_tests_manifest",
    testonly = True,
    component_name = "bt_hfp_audio_gateway_integration_tests",
    includes = [
        "//sdk/lib/sys/component:realm_builder.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/bt-hfp-audio-gateway-integration-tests.cml",
)

fx_test_component(
    name = "bt_hfp_audio_gateway_integration_tests",
    compiled_manifest = ":bt_hfp_audio_gateway_integration_tests_manifest",
    deps = [":tests_bin_packaged_bin"],
)

fx_package(
    name = "bt-hfp-audio-gateway-integration-tests_package",
    package_name = "bt-hfp-audio-gateway-integration-tests",
    testonly = True,
    components = [
        # The HFP component.
        "//src/connectivity/bluetooth/profiles/bt-hfp-audio-gateway:component",

        # The RFCOMM component that is the intermediary for HFP and test driven
        # peers.
        "//src/connectivity/bluetooth/profiles/bt-rfcomm:component",

        # The component mock for the `fuchsia.bluetooth.internal.a2dp.Controller`
        # capability.
        "//src/connectivity/bluetooth/testing/mock-a2dp-controller",

        # Mock Piconet Server
        "//src/connectivity/bluetooth/testing/mock-piconet-server:component",

        # In GN, realm_builder_server_component is pulled in transitively via
        # //src/lib/fuchsia-component-test.
        "//src/lib/fuchsia-component-test/realm_builder_server:realm_builder_server_component",
    ],
    test_components = [":bt_hfp_audio_gateway_integration_tests"],
)

fx_test(
    name = "bt-hfp-audio-gateway-integration-tests",
    # The max severity is set to ERROR due to the HFP component's ERROR log
    # message when the Profile service is dropped. In some test runs, the
    # Profile service goes away before the HFP component terminates, resulting
    # in the log. This does not indicate a bug and is expected behavior.
    max_log_severity = "ERROR",
    package = ":bt-hfp-audio-gateway-integration-tests_package",
    # The profile integration tests tend to flake if tests are run in parallel.
    parallel = 1,
)
