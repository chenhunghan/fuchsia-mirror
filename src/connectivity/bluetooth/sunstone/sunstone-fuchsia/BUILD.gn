import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_binary("bin") {
  sources = [
    "src/host_server.rs",
    "src/main.rs",
    "src/vendor.rs",
  ]
  output_name = "bt_host"
  edition = "2024"
  deps = [
    ":bt_host_config",
    "//sdk/fidl/fuchsia.bluetooth:fuchsia.bluetooth_rust",
    "//sdk/fidl/fuchsia.bluetooth.host:fuchsia.bluetooth.host_rust",
    "//sdk/fidl/fuchsia.bluetooth.sys:fuchsia.bluetooth.sys_rust",
    "//sdk/fidl/fuchsia.hardware.bluetooth:fuchsia.hardware.bluetooth_rust",
    "//sdk/rust/zx",
    "//src/lib/fdio/rust:fdio",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//third_party/rust_crates:futures-util",
    "//third_party/rust_crates:thiserror",
    "//third_party/rust_crates:tracing",
  ]
}

fuchsia_structured_config_rust_lib("bt_host_config") {
  cm_label = ":manifest"
}

fuchsia_component("component") {
  cm_label = ":manifest"
  deps = [ ":bin" ]
}

rustc_test("bin_test") {
  sources = [
    "src/host_server.rs",
    "src/main.rs",
    "src/vendor.rs",
  ]
  edition = "2024"
  deps = [
    ":bt_host_config",
    "//sdk/fidl/fuchsia.bluetooth:fuchsia.bluetooth_rust",
    "//sdk/fidl/fuchsia.bluetooth.host:fuchsia.bluetooth.host_rust",
    "//sdk/fidl/fuchsia.bluetooth.sys:fuchsia.bluetooth.sys_rust",
    "//sdk/fidl/fuchsia.hardware.bluetooth:fuchsia.hardware.bluetooth_rust",
    "//sdk/rust/zx",
    "//src/lib/fdio/rust:fdio",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//third_party/rust_crates:futures-util",
    "//third_party/rust_crates:thiserror",
    "//third_party/rust_crates:tracing",
  ]
  source_root = "src/main.rs"
  output_name = "bt_host_bin_test"
}

fuchsia_unittest_package("sunstone-fuchsia-tests") {
  package_name = "sunstone-fuchsia-tests-gn"
  component_name = "sunstone-fuchsia-tests"
  deps = [ ":bin_test" ]
  visibility = [
    ":*",
    "//src/connectivity/bluetooth:*",
  ]
}

fuchsia_unittest_package("sunstone-bt-host-tests") {
  package_name = "sunstone-bt-host-tests-gn"
  component_name = "sunstone-bt-host-tests"
  deps = [ ":bin_test" ]
  visibility = [
    ":*",
    "//src/connectivity/bluetooth:*",
  ]
}
