import("//build/components.gni")

# The Bazel build defines an equivalent `fx_component_manifest("manifest")`
# target, so that `:bt_host_config` and `:component` refer to the same label in
# both builds.
fuchsia_component_manifest("manifest") {
  component_name = "bt-host"
  manifest = "meta/bt-host.cml"
}

fuchsia_package("sunstone-bt-host") {
  package_name = "sunstone-bt-host"
  deps = [ ":component" ]
}

group("tests") {
  testonly = true
  deps = [
    ":sunstone-bt-host-tests",
    ":sunstone-fuchsia-tests",
  ]
}

