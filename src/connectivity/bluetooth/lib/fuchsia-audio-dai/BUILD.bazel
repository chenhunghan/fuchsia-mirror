load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")
load(
    "//build/bazel/rules/testing:fx_unittest_component.bzl",
    "fx_unittest_component",
)

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":fuchsia-audio-dai-tests"],
    visibility = ["//src/connectivity/bluetooth:__pkg__"],
)

rustc_library(
    name = "fuchsia-audio-dai",
    srcs = [
        "src/audio.rs",
        "src/discover.rs",
        "src/driver.rs",
        "src/lib.rs",
        "src/test.rs",
    ],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    edition = "2024",
    proc_macro_deps = ["//third_party/rust_crates/vendor:derivative"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = [
        "//src/connectivity/bluetooth/lib:__subpackages__",
        "//src/connectivity/bluetooth/profiles/tests/bt-hfp-audio-gateway-integration-tests:__pkg__",
        "//src/connectivity/bluetooth/tests/bt-manifest-integration-tests:__pkg__",
        "//src/connectivity/bluetooth/tools/dai-info:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.hardware.audio:fuchsia.hardware.audio_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.media:fuchsia.media_rust",
        "//sdk/rust/zx",
        "//src/lib/fdio/rust:fdio",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-fs",
        "//src/lib/fuchsia-sync",
        "//src/storage/lib/vfs/rust:vfs",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

rustc_test(
    name = "fuchsia-audio-dai_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":fuchsia-audio-dai",
    # Only used by bazel2gn, to keep the GN `output_name` of the test binary.
    crate_name = "fuchsia_audio_dai_lib_test",
    proc_macro_deps = ["//src/lib/testing/fixture"],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//src/connectivity/bluetooth/testing/realmbuilder-mock-helpers",
        "//src/lib/async-utils",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component-test",
    ],
)

fx_unittest_component(
    name = "fuchsia-audio-dai-tests-component",
    binary = ":fuchsia-audio-dai_test",
    component_name = "fuchsia-audio-dai-tests",
)

fx_package(
    name = "fuchsia-audio-dai-tests-package",
    package_name = "fuchsia-audio-dai-tests",
    testonly = True,
    components = [
        "//src/lib/fuchsia-component-test/realm_builder_server:realm_builder_server_component",
    ],
    test_components = [":fuchsia-audio-dai-tests-component"],
)

fx_test(
    name = "fuchsia-audio-dai-tests",
    package = ":fuchsia-audio-dai-tests-package",
)
