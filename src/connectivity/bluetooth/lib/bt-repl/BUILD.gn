import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("bt-repl") {
  sources = [
    "src/commands.rs",
    "src/helper.rs",
    "src/lib.rs",
    "src/repl.rs",
    "src/source.rs",
  ]
  configs += [ "//build/config/rust/lints:deny_unused_results" ]
  edition = "2024"
  visibility = [
    ":*",
    "//src/connectivity/bluetooth/*",
  ]
  deps = [
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:rustyline",
  ]
}
if (is_fuchsia) {
  rustc_test("bt_repl_lib_test") {
    sources = [
      "src/commands.rs",
      "src/helper.rs",
      "src/lib.rs",
      "src/repl.rs",
      "src/source.rs",
    ]
    edition = "2024"
    deps = [
             "//third_party/rust_crates:anyhow",
             "//third_party/rust_crates:futures",
             "//third_party/rust_crates:rustyline",
           ] + [ "//src/lib/fuchsia" ]
    configs += [ "//build/config/rust/lints:deny_unused_results" ]
  }
}

fuchsia_unittest_package("bt-repl-tests") {
  package_name = "bt-repl-tests-gn"
  component_name = "bt-repl-tests"
  deps = [ ":bt_repl_lib_test" ]
}
