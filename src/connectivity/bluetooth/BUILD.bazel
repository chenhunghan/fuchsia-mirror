load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")

package(default_applicable_licenses = ["//:license"])

# Bluetooth host tests defined in Bazel, aggregated from package `:host_tests`
# suites. These are exported to `fx test` and infra builders through
# `:bazel_tests` in BUILD.gn.
test_suite(
    name = "bluetooth_host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [
        "//src/connectivity/bluetooth/lib/bt-rfcomm:host_tests",
    ],
)

