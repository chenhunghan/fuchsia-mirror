load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
    "fx_test_component",
)
load(
    "//build/bazel/rules/components:structured_config.bzl",
    "fuchsia_structured_config_rust_lib",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":bt-gap-unittests"],
    visibility = ["//src/connectivity/bluetooth:__pkg__"],
)

rustc_binary(
    name = "bin",
    srcs = [
        "src/build_config.rs",
        "src/generic_access_service.rs",
        "src/host_device.rs",
        "src/host_dispatcher.rs",
        "src/main.rs",
        "src/services/access.rs",
        "src/services/address_lookup.rs",
        "src/services/bootstrap.rs",
        "src/services/configuration.rs",
        "src/services/host_watcher.rs",
        "src/services/mod.rs",
        "src/services/pairing/mod.rs",
        "src/services/pairing/pairing_dispatcher.rs",
        "src/services/pairing/pairing_requests.rs",
        "src/store/in_memory.rs",
        "src/store/keys.rs",
        "src/store/mod.rs",
        "src/store/serde.rs",
        "src/store/stash.rs",
        "src/test/access.rs",
        "src/test/address_lookup.rs",
        "src/test/configuration.rs",
        "src/test/discovery.rs",
        "src/test/host_device.rs",
        "src/test/host_dispatcher.rs",
        "src/test/mod.rs",
        "src/test/pairing.rs",
        "src/test/receiver.rs",
        "src/types.rs",
        "src/watch_peers.rs",
    ],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate_name = "bt_gap",
    edition = "2024",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        ":bt_gap_config",
        "//sdk/fidl/fuchsia.bluetooth.bredr:fuchsia.bluetooth.bredr_rust",
        "//sdk/fidl/fuchsia.bluetooth:fuchsia.bluetooth_rust",
        "//sdk/fidl/fuchsia.bluetooth.gatt:fuchsia.bluetooth.gatt_rust",
        "//sdk/fidl/fuchsia.bluetooth.gatt2:fuchsia.bluetooth.gatt2_rust",
        "//sdk/fidl/fuchsia.bluetooth.host:fuchsia.bluetooth.host_rust",
        "//sdk/fidl/fuchsia.bluetooth.le:fuchsia.bluetooth.le_rust",
        "//sdk/fidl/fuchsia.bluetooth.sys:fuchsia.bluetooth.sys_rust",
        "//sdk/fidl/fuchsia.device:fuchsia.device_rust",
        "//sdk/fidl/fuchsia.stash:fuchsia.stash_rust",
        "//sdk/rust/zx",
        "//src/connectivity/bluetooth/lib/async-helpers",
        "//src/connectivity/bluetooth/lib/fuchsia-bluetooth",
        "//src/lib/async-utils",
        "//src/lib/diagnostics/inspect/contrib/rust",
        "//src/lib/diagnostics/inspect/derive",
        "//src/lib/diagnostics/inspect/runtime/rust",
        "//src/lib/diagnostics/inspect/rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-sync",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:slab",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

fx_packaged_binary(
    name = "bin_packaged_bin",
    binary = ":bin",
    binary_name = "bt_gap",
    target_compatible_with = ["@platforms//os:fuchsia"],
)

fx_component_manifest(
    name = "manifest",
    component_name = "bt-gap",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/bt-gap.cml",
    target_compatible_with = ["@platforms//os:fuchsia"],
)

fuchsia_structured_config_rust_lib(
    name = "bt_gap_config",
    cm_label = ":manifest",
)

fx_component(
    name = "component",
    compiled_manifest = ":manifest",
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = [
        "//src/connectivity/bluetooth/core/bt-init:__pkg__",
        "//src/connectivity/bluetooth/testing/bt-test-harness:__pkg__",
        "//src/connectivity/bluetooth/tests/bt-manifest-integration-tests:__pkg__",
    ],
    deps = [":bin_packaged_bin"],
)

rustc_test(
    name = "bt_gap_bin_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":bin",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
        "//src/lib/test_util",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:proptest",
    ],
)

# The test components and package below are Bazel-only. Their GN copies
# (`:test-stash-secure`, `:test-component` and `:bt-gap-unittests`) are
# written by hand in BUILD.gn because other GN packages include
# `:test-stash-secure`.
# @bazel2gn:skip
fx_packaged_binary(
    name = "bt_gap_bin_test_packaged_bin",
    testonly = True,
    binary = ":bt_gap_bin_test",
    binary_name = "bt_gap_bin_test",
    target_compatible_with = ["@platforms//os:fuchsia"],
)

# @bazel2gn:skip
fx_component_manifest(
    name = "bt-gap-unittests-manifest",
    testonly = True,
    component_name = "test-component",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners:tmp_storage.shard.cml",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/bt-gap-unittests.cml",
    target_compatible_with = ["@platforms//os:fuchsia"],
)

# @bazel2gn:skip
fx_test_component(
    name = "bt-gap-unittests-component",
    compiled_manifest = ":bt-gap-unittests-manifest",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [":bt_gap_bin_test_packaged_bin"],
)

# @bazel2gn:skip
fx_packaged_binary(
    name = "stash_packaged_bin",
    testonly = True,
    binary = "//src/sys/stash:bin",
    binary_name = "stash",
    target_compatible_with = ["@platforms//os:fuchsia"],
)

# @bazel2gn:skip
fx_component_manifest(
    name = "test-stash-secure-manifest",
    testonly = True,
    component_name = "test-stash-secure",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/test-stash-secure.cml",
    target_compatible_with = ["@platforms//os:fuchsia"],
)

# @bazel2gn:skip
fx_component(
    name = "test-stash-secure-component",
    testonly = True,
    compiled_manifest = ":test-stash-secure-manifest",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [":stash_packaged_bin"],
)

# @bazel2gn:skip
fx_package(
    name = "bt-gap-unittests-package",
    package_name = "bt-gap-unittests",
    components = [":test-stash-secure-component"],
    test_components = [":bt-gap-unittests-component"],
)

# @bazel2gn:skip
fx_test(
    name = "bt-gap-unittests",
    # Expected ERROR logs in some tests; see the GN copy in BUILD.gn.
    max_log_severity = "ERROR",
    package = ":bt-gap-unittests-package",
)
