      "//third_party/rust_crates:anyhow",
      "//third_party/rust_crates:futures",
      "//third_party/rust_crates:log",
    ]
    source_root = "src/main.rs"
    configs += [ "//build/config/rust/lints:deny_unused_results" ]
    output_name = "bt_init_bin_test"
  }
}

fuchsia_unittest_package("tests") {
  package_name = "bt-init-unittests-gn"
  component_name = "bt-init-unittests"
  deps = [ ":bin_test" ]
  visibility = [
    ":*",
    "//:*",
    "//src/connectivity/bluetooth/*",
  ]
}
