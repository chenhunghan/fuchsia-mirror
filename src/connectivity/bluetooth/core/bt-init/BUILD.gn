import("//build/components.gni")

# Kept in GN because `:bin` transitively links `rustc_dylib`
# `//src/storage/lib/vfs/rust:vfs_dylib` via `//src/lib/fuchsia-component`,
# `bazel2gn` does not translate non-test `fx_package()`, and GN targets
# (`//bundles/assembly/bazel_inputs/src/connectivity/bluetooth/core/bt-init`,
# `//src/connectivity/bluetooth/core:core`, and
# `//src/connectivity/bluetooth:core-testonly`) still consume these packages.
fuchsia_package("bt-init") {
  deps = [
    ":component",
    "//src/connectivity/bluetooth/core/bt-gap:component",
  ]
  subpackages = [ "//src/connectivity/bluetooth/core/bt-host" ]
}

fuchsia_package("bt-init-testonly") {
  deps = [ ":testonly_component" ]
}

