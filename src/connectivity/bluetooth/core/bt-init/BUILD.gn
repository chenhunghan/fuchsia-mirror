      "//third_party/rust_crates:log",
    ]
  }
}
if (is_fuchsia) {
  fuchsia_component_manifest("manifest") {
    component_name = "bt-init"
    manifest = "meta/bt-init.cml"
  }
}

fuchsia_structured_config_rust_lib("bt_init_config") {
  cm_label = ":manifest"
}
if (is_fuchsia) {
  fuchsia_component("component") {
    cm_label = ":manifest"
    deps = [ ":bin" ]
  }
}
if (is_fuchsia) {
  fuchsia_component_manifest("testonly_manifest") {
    component_name = "bt-init-testonly"
    manifest = "meta/bt-init-testonly.cml"
  }
}
if (is_fuchsia) {
  fuchsia_component("testonly_component") {
    cm_label = ":testonly_manifest"
    deps = [ ":bin" ]
  }
}
if (is_fuchsia) {
  rustc_test("bin_test") {
    sources = [ "src/main.rs" ]
    edition = "2024"
    proc_macro_deps = [ "//third_party/rust_crates:async-trait" ]
    deps = [
      ":bt_init_config",
      "//sdk/fidl/fuchsia.bluetooth.bredr:fuchsia.bluetooth.bredr_rust",
      "//sdk/fidl/fuchsia.bluetooth.snoop:fuchsia.bluetooth.snoop_rust",
      "//sdk/fidl/fuchsia.bluetooth.sys:fuchsia.bluetooth.sys_rust",
      "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
      "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust",
      "//sdk/fidl/fuchsia.component.runtime:fuchsia.component.runtime_rust",
      "//sdk/fidl/fuchsia.hardware.bluetooth:fuchsia.hardware.bluetooth_rust",
