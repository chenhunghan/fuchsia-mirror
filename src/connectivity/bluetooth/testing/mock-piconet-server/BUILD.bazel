load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")
load(
    "//build/bazel/rules/testing:fx_unittest_package.bzl",
    "fx_unittest_package",
)

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [
        ":mock-piconet-client-tests",
        ":mock-piconet-server-tests",
    ],
    visibility = ["//src/connectivity/bluetooth:__pkg__"],
)

rustc_library(
    name = "lib",
    testonly = True,
    srcs = ["src/lib.rs"],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate_name = "mock_piconet_client",
    edition = "2024",
    visibility = ["//src/connectivity/bluetooth/profiles/tests:__subpackages__"],
    deps = [
        "//sdk/fidl/fuchsia.bluetooth.bredr:fuchsia.bluetooth.bredr_rust",
        "//sdk/fidl/fuchsia.bluetooth.bredr.test:fuchsia.bluetooth.bredr.test_rust",
        "//sdk/fidl/fuchsia.component.test:fuchsia.component.test_rust",
        "//sdk/fidl/fuchsia.logger:fuchsia.logger_rust",
        "//sdk/rust/zx",
        "//src/connectivity/bluetooth/lib/fuchsia-bluetooth",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-component-test",
        "//src/sys/lib/cm_rust",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

rustc_test(
    name = "mock_piconet_client_lib_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":lib",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//src/lib/fuchsia",
        "//src/sys/lib/cm_types",
        "//third_party/rust_crates/vendor:assert_matches",
    ],
)

fx_packaged_binary(
    name = "mock_piconet_client_lib_test_packaged_bin",
    testonly = True,
    binary = ":mock_piconet_client_lib_test",
    binary_name = "mock_piconet_client_lib_test",
)

fx_component_manifest(
    name = "mock-piconet-client-tests-manifest",
    testonly = True,
    component_name = "mock-piconet-client-tests",
    includes = [
        "//sdk/lib/sys/component:realm_builder.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/mock-piconet-client-tests.cml",
)

fx_test_component(
    name = "mock-piconet-client-tests-component",
    compiled_manifest = ":mock-piconet-client-tests-manifest",
    deps = [":mock_piconet_client_lib_test_packaged_bin"],
)

fx_package(
    name = "mock-piconet-client-tests-package",
    package_name = "mock-piconet-client-tests",
    components = [
        ":component",
        # In GN, realm_builder_server_component is pulled in transitively via
        # //src/lib/fuchsia-component-test.
        "//src/lib/fuchsia-component-test/realm_builder_server:realm_builder_server_component",  # @bazel2gn:skip
    ],
    test_components = [":mock-piconet-client-tests-component"],
)

fx_test(
    name = "mock-piconet-client-tests",
    package = ":mock-piconet-client-tests-package",
)

rustc_binary(
    name = "bin",
    srcs = [
        "src/main.rs",
        "src/peer/mod.rs",
        "src/peer/search.rs",
        "src/peer/service.rs",
        "src/profile.rs",
        "src/types.rs",
    ],
    binary_name = "mock_piconet_server",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    edition = "2024",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//sdk/fidl/fuchsia.bluetooth.bredr:fuchsia.bluetooth.bredr_rust",
        "//sdk/fidl/fuchsia.bluetooth.bredr.test:fuchsia.bluetooth.bredr.test_rust",
        "//sdk/fidl/fuchsia.bluetooth:fuchsia.bluetooth_rust",
        "//sdk/rust/zx",
        "//src/connectivity/bluetooth/lib/bt-rfcomm",
        "//src/connectivity/bluetooth/lib/fuchsia-bluetooth",
        "//src/lib/async-utils",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-sync",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:slab",
    ],
)

fx_packaged_binary(
    name = "bin_packaged_bin",
    binary = ":bin",
    binary_name = "mock_piconet_server",
)

fx_component_manifest(
    name = "manifest",
    component_name = "mock-piconet-server",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/mock-piconet-server.cml",
)

fx_component(
    name = "component",
    compiled_manifest = ":manifest",
    visibility = ["//src/connectivity/bluetooth/profiles/tests:__subpackages__"],
    deps = [":bin_packaged_bin"],
)

rustc_test(
    name = "mock_piconet_server_bin_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":bin",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = ["//third_party/rust_crates/vendor:assert_matches"],
)

fx_unittest_package(
    name = "mock-piconet-server-tests",
    unit_tests = [":mock_piconet_server_bin_test"],
)
