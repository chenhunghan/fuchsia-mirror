import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_binary("bin") {
  sources = [ "src/main.rs" ]
  output_name = "bt-rootcanal"
  configs += [ "//build/config/rust/lints:deny_unused_results" ]
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.bluetooth.pandora:fuchsia.bluetooth.pandora_rust",
    "//sdk/fidl/fuchsia.hardware.bluetooth:fuchsia.hardware.bluetooth_rust",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-sync",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
}

fuchsia_component_manifest("manifest") {
  component_name = "bt-rootcanal"
  manifest = "meta/bt-rootcanal.cml"
}

fuchsia_component("component") {
  cm_label = ":manifest"
  deps = [ ":bin" ]
}
if (is_fuchsia) {
  rustc_test("bin_test") {
    sources = [ "src/main.rs" ]
    edition = "2024"
    deps = [
      "//sdk/fidl/fuchsia.bluetooth.pandora:fuchsia.bluetooth.pandora_rust",
      "//sdk/fidl/fuchsia.hardware.bluetooth:fuchsia.hardware.bluetooth_rust",
      "//sdk/rust/zx",
      "//src/lib/fidl/rust/fidl",
      "//src/lib/fuchsia",
      "//src/lib/fuchsia-async",
      "//src/lib/fuchsia-component",
      "//src/lib/fuchsia-sync",
      "//third_party/rust_crates:anyhow",
      "//third_party/rust_crates:futures",
      "//third_party/rust_crates:log",
    ]
    source_root = "src/main.rs"
    configs += [ "//build/config/rust/lints:deny_unused_results" ]
    output_name = "bt_rootcanal_bin_test"
  }
}

fuchsia_unittest_package("bt-rootcanal-unittests") {
  package_name = "bt-rootcanal-unittests-gn"
  component_name = "bt-rootcanal-unittests"
  deps = [ ":bin_test" ]
}
