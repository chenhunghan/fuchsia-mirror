import("//build/components.gni")

# Kept above the sentinel because `//src/connectivity/bluetooth/tools:emulation`
# still depends on `:bt-rootcanal` in GN, and `bazel2gn` ignores non-test
# `fx_package()` targets.
fuchsia_package("bt-rootcanal") {
  deps = [ ":component" ]
}

group("tests") {
  testonly = true
  deps = [ ":bt-rootcanal-unittests" ]
}

