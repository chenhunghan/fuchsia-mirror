import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_binary("bin") {
  sources = [
    "src/commands.rs",
    "src/main.rs",
    "src/types.rs",
  ]
  output_name = "bt-cli"
  configs += [ "//build/config/rust/lints:deny_unused_results" ]
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.bluetooth:fuchsia.bluetooth_rust",
    "//sdk/fidl/fuchsia.bluetooth.sys:fuchsia.bluetooth.sys_rust",
    "//src/connectivity/bluetooth/lib/bt-repl",
    "//src/connectivity/bluetooth/lib/fuchsia-bluetooth",
    "//src/connectivity/bluetooth/tools/lib/pairing-delegate",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-sync",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:prettytable-rs",
    "//third_party/rust_crates:regex",
  ]
}
if (is_fuchsia) {
  rustc_test("bt_cli_bin_test") {
    sources = [
      "src/commands.rs",
      "src/main.rs",
      "src/types.rs",
    ]
    edition = "2024"
    deps = [
             "//sdk/fidl/fuchsia.bluetooth:fuchsia.bluetooth_rust",
             "//sdk/fidl/fuchsia.bluetooth.sys:fuchsia.bluetooth.sys_rust",
             "//src/connectivity/bluetooth/lib/bt-repl",
             "//src/connectivity/bluetooth/lib/fuchsia-bluetooth",
             "//src/connectivity/bluetooth/tools/lib/pairing-delegate",
             "//src/lib/fidl/rust/fidl",
             "//src/lib/fuchsia",
             "//src/lib/fuchsia-async",
             "//src/lib/fuchsia-component",
             "//src/lib/fuchsia-sync",
             "//third_party/rust_crates:anyhow",
             "//third_party/rust_crates:futures",
             "//third_party/rust_crates:prettytable-rs",
             "//third_party/rust_crates:regex",
           ] +
           [
             "//sdk/rust/zx",
             "//src/connectivity/bluetooth/lib/bt-fidl-mocks",
             "//third_party/rust_crates:assert_matches",
           ]
    source_root = "src/main.rs"
    configs += [ "//build/config/rust/lints:deny_unused_results" ]
  }
}

fuchsia_unittest_package("bt-cli-unittests") {
  package_name = "bt-cli-unittests-gn"
  component_name = "bt-cli-unittests"
  deps = [ ":bt_cli_bin_test" ]
}
