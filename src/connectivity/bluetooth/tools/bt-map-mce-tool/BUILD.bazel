load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":bt-map-mce-tool-unittests"],
    visibility = ["//src/connectivity/bluetooth:__pkg__"],
)

rustc_binary(
    name = "bin",
    srcs = [
        "src/accessor.rs",
        "src/commands.rs",
        "src/main.rs",
        "src/repl.rs",
    ],
    binary_name = "bt-map-mce-tool",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    edition = "2024",
    deps = [
        "//sdk/fidl/fuchsia.bluetooth:fuchsia.bluetooth_rust",
        "//sdk/fidl/fuchsia.bluetooth.map:fuchsia.bluetooth.map_rust",
        "//src/connectivity/bluetooth/lib/bt-repl",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-sync",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:simplelog",
    ],
)

rustc_test(
    name = "bin_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":bin",
    # Preserve the GN `with_unit_tests = true` test binary output name (`bt_map_mce_tool_bin_test`).
    crate_name = "bt_map_mce_tool_bin_test",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
)

fx_unittest_package(
    name = "bt-map-mce-tool-unittests",
    unit_tests = [":bin_test"],
)
