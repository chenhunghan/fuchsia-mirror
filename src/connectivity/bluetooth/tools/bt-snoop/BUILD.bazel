load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

exports_files(
    [
        "meta/bt-snoop-eager.core_shard.cml",
        "meta/bt-snoop.core_shard.cml",
    ],
    visibility = ["//bundles/assembly:__subpackages__"],
)

rustc_binary(
    name = "bin",
    srcs = [
        "src/bounded_queue.rs",
        "src/core_dump.rs",
        "src/main.rs",
        "src/packet_logs.rs",
        "src/snooper.rs",
        "src/subscription_manager.rs",
        "src/tests.rs",
    ],
    binary_name = "bt_snoop",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    edition = "2024",
    deps = [
        "//sdk/fidl/fuchsia.bluetooth.snoop:fuchsia.bluetooth.snoop_rust",
        "//sdk/fidl/fuchsia.feedback:fuchsia.feedback_rust",
        "//sdk/fidl/fuchsia.firmware.crash:fuchsia.firmware.crash_rust",
        "//sdk/fidl/fuchsia.hardware.bluetooth:fuchsia.hardware.bluetooth_rust",
        "//sdk/fidl/fuchsia.mem:fuchsia.mem_rust",
        "//sdk/rust/zx",
        "//src/lib/diagnostics/inspect/format/rust:lib",
        "//src/lib/diagnostics/inspect/runtime/rust",
        "//src/lib/diagnostics/inspect/rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-sync",
        "//src/lib/trace/rust:trace",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:byteorder",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:itertools",
        "//third_party/rust_crates/vendor:log",
    ],
)

rustc_test(
    name = "bt_snoop_bin_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":bin",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//src/lib/async-utils",
        "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
    ],
)

fx_unittest_package(
    name = "bt-snoop-unittests",
    unit_tests = [":bt_snoop_bin_test"],
    visibility = ["//src/connectivity/bluetooth:__pkg__"],
)
