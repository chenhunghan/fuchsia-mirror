if (is_fuchsia) {
  rustc_test("bt_snoop_bin_test") {
    sources = [
      "src/bounded_queue.rs",
      "src/core_dump.rs",
      "src/main.rs",
      "src/packet_logs.rs",
      "src/snooper.rs",
      "src/subscription_manager.rs",
      "src/tests.rs",
    ]
    edition = "2024"
    deps = [
             "//sdk/fidl/fuchsia.bluetooth.snoop:fuchsia.bluetooth.snoop_rust",
             "//sdk/fidl/fuchsia.feedback:fuchsia.feedback_rust",
             "//sdk/fidl/fuchsia.firmware.crash:fuchsia.firmware.crash_rust",
             "//sdk/fidl/fuchsia.hardware.bluetooth:fuchsia.hardware.bluetooth_rust",
             "//sdk/fidl/fuchsia.mem:fuchsia.mem_rust",
             "//sdk/rust/zx",
             "//src/lib/diagnostics/inspect/format/rust:lib",
             "//src/lib/diagnostics/inspect/runtime/rust",
             "//src/lib/diagnostics/inspect/rust",
             "//src/lib/fidl/rust/fidl",
             "//src/lib/fuchsia",
             "//src/lib/fuchsia-async",
             "//src/lib/fuchsia-component",
             "//src/lib/fuchsia-sync",
             "//src/lib/trace/rust:trace",
             "//third_party/rust_crates:anyhow",
             "//third_party/rust_crates:argh",
             "//third_party/rust_crates:byteorder",
             "//third_party/rust_crates:futures",
             "//third_party/rust_crates:itertools",
