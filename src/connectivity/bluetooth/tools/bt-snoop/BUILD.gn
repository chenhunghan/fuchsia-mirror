fuchsia_unittest_package("bt-snoop-unittests") {
  package_name = "bt-snoop-unittests-gn"
  component_name = "bt-snoop-unittests"
  deps = [ ":bt_snoop_bin_test" ]
  visibility = [
    ":*",
    "//src/connectivity/bluetooth:*",
  ]
}
