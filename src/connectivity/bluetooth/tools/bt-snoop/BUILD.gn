import("//build/components.gni")

fuchsia_package_with_single_component("bt-snoop") {
  deps = [ ":bin" ]
  manifest = "meta/bt-snoop.cml"
}

group("tests") {
  testonly = true
  deps = [ ":bt-snoop-unittests" ]
}

