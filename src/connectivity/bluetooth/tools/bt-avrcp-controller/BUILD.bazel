load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":bt-avrcp-controller-unittests"],
    visibility = ["//src/connectivity/bluetooth:__pkg__"],
)

rustc_binary(
    name = "bin",
    srcs = [
        "src/commands.rs",
        "src/main.rs",
    ],
    binary_name = "bt-avrcp-controller",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    edition = "2024",
    visibility = ["//src/connectivity/bluetooth/tools/tests/bt-tool-cli-tests:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.bluetooth.avrcp:fuchsia.bluetooth.avrcp_rust",
        "//sdk/fidl/fuchsia.bluetooth.avrcp.test:fuchsia.bluetooth.avrcp.test_rust",
        "//src/connectivity/bluetooth/lib/bt-repl",
        "//src/connectivity/bluetooth/lib/fuchsia-bluetooth",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:hex",
    ],
)

rustc_test(
    name = "bt_avrcp_controller_bin_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":bin",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = ["//third_party/rust_crates/vendor:assert_matches"],
)

fx_unittest_package(
    name = "bt-avrcp-controller-unittests",
    unit_tests = [":bt_avrcp_controller_bin_test"],
)
