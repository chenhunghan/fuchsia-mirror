    "//sdk/fidl/fuchsia.bluetooth.avdtp.test:fuchsia.bluetooth.avdtp.test_rust",
    "//src/connectivity/bluetooth/lib/bt-repl",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-sync",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
}
if (is_fuchsia) {
  rustc_test("bt_avdtp_tool_bin_test") {
    sources = [
      "src/commands.rs",
      "src/main.rs",
      "src/types.rs",
    ]
    edition = "2024"
    deps = [
      "//sdk/fidl/fuchsia.bluetooth.avdtp.test:fuchsia.bluetooth.avdtp.test_rust",
      "//src/connectivity/bluetooth/lib/bt-repl",
      "//src/lib/fidl/rust/fidl",
      "//src/lib/fuchsia",
      "//src/lib/fuchsia-component",
      "//src/lib/fuchsia-sync",
      "//third_party/rust_crates:anyhow",
      "//third_party/rust_crates:futures",
      "//third_party/rust_crates:log",
    ]
    source_root = "src/main.rs"
    configs += [ "//build/config/rust/lints:deny_unused_results" ]
  }
}

fuchsia_unittest_package("bt-avdtp-tool-unittests") {
  package_name = "bt-avdtp-tool-unittests-gn"
  component_name = "bt-avdtp-tool-unittests"
  deps = [ ":bt_avdtp_tool_bin_test" ]
}
