import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_binary("bin") {
  sources = [
    "src/hci.rs",
    "src/main.rs",
    "src/types.rs",
  ]
  output_name = "bt-fct-hci"
  configs += [ "//build/config/rust/lints:deny_unused_results" ]
  edition = "2024"
  visibility = [
    ":*",
    "//vendor/google/*",
  ]
  deps = [
    "//sdk/fidl/fuchsia.hardware.bluetooth:fuchsia.hardware.bluetooth_rust",
    "//src/connectivity/bluetooth/lib/packet-encoding",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:hex",
    "//third_party/rust_crates:thiserror",
  ]
}
if (is_fuchsia) {
  rustc_test("bin_test") {
    sources = [
      "src/hci.rs",
      "src/main.rs",
      "src/types.rs",
    ]
    edition = "2024"
    deps = [
             "//sdk/fidl/fuchsia.hardware.bluetooth:fuchsia.hardware.bluetooth_rust",
             "//src/connectivity/bluetooth/lib/packet-encoding",
             "//src/lib/fidl/rust/fidl",
             "//src/lib/fuchsia",
             "//src/lib/fuchsia-async",
             "//src/lib/fuchsia-component",
             "//third_party/rust_crates:anyhow",
             "//third_party/rust_crates:argh",
             "//third_party/rust_crates:futures",
             "//third_party/rust_crates:hex",
             "//third_party/rust_crates:thiserror",
           ] + [ "//src/connectivity/bluetooth/lib/bt-fidl-mocks" ]
    source_root = "src/main.rs"
    configs += [ "//build/config/rust/lints:deny_unused_results" ]
    output_name = "bt_fct_hci_bin_test"
  }
}

fuchsia_unittest_package("bt-fct-hci-unittests") {
  package_name = "bt-fct-hci-unittests-gn"
  component_name = "bt-fct-hci-unittests"
  deps = [ ":bin_test" ]
}
