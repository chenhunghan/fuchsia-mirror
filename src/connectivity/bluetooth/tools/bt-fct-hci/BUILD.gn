import("//build/components.gni")

fuchsia_package_with_single_component("bt-fct-hci") {
  manifest = "meta/bt-fct-hci.cml"
  deps = [ ":bin" ]
}

group("tests") {
  testonly = true
  deps = [ ":bt-fct-hci-unittests" ]
}

