load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":bt-le-central-unittests"],
    visibility = ["//src/connectivity/bluetooth:__pkg__"],
)

rustc_binary(
    name = "bin",
    srcs = [
        "src/central.rs",
        "src/gatt.rs",
        "src/gatt/commands.rs",
        "src/gatt/repl.rs",
        "src/main.rs",
    ],
    binary_name = "bt-le-central",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    edition = "2024",
    deps = [
        "//sdk/fidl/fuchsia.bluetooth:fuchsia.bluetooth_rust",
        "//sdk/fidl/fuchsia.bluetooth.le:fuchsia.bluetooth.le_rust",
        "//src/connectivity/bluetooth/lib/bt-gatt-fuchsia",
        "//src/connectivity/bluetooth/lib/bt-repl",
        "//src/connectivity/bluetooth/lib/fuchsia-bluetooth",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-sync",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:bt-common",
        "//third_party/rust_crates/vendor:bt-gatt",
        "//third_party/rust_crates/vendor:bt-pacs",
        "//third_party/rust_crates/vendor:bt-vcs",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:getopts",
        "//third_party/rust_crates/vendor:num-traits",
    ],
)

rustc_test(
    name = "bt_le_central_bin_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":bin",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//sdk/fidl/fuchsia.bluetooth.gatt2:fuchsia.bluetooth.gatt2_rust",
        "//src/connectivity/bluetooth/lib/bt-fidl-mocks",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
    ],
)

fx_unittest_package(
    name = "bt-le-central-unittests",
    unit_tests = [":bt_le_central_bin_test"],
)
