if (is_fuchsia) {
  rustc_binary("packet-formats-benchmarks") {
    testonly = true
    sources = [
      "src/ip.rs",
      "src/main.rs",
      "src/tcp.rs",
      "src/udp.rs",
    ]
    configs += [
      "//build/config/rust/lints:deny_unused_results",
      "//src/connectivity/network/netstack3:netstack3_configs",
    ]
    edition = "2024"
    deps = [
      "//src/connectivity/lib/net-declare",
      "//src/connectivity/lib/net-types",
      "//src/connectivity/lib/packet-formats",
      "//src/developer/fuchsia-criterion",
      "//src/lib/network/packet",
      "//third_party/rust_crates:criterion",
      "//third_party/rust_crates:itertools",
    ]
  }
}
if (is_fuchsia) {
  rustc_test("packet-formats-benchmarks_test") {
    sources = [
      "src/ip.rs",
      "src/main.rs",
      "src/tcp.rs",
      "src/udp.rs",
    ]
    edition = "2024"
    deps = [
      "//src/connectivity/lib/net-declare",
      "//src/connectivity/lib/net-types",
      "//src/connectivity/lib/packet-formats",
      "//src/developer/fuchsia-criterion",
      "//src/lib/network/packet",
      "//third_party/rust_crates:criterion",
      "//third_party/rust_crates:itertools",
    ]
    source_root = "src/main.rs"
    configs += [
      "//build/config/rust/lints:deny_unused_results",
      "//src/connectivity/network/netstack3:netstack3_configs",
    ]
  }
}

fuchsia_unittest_package("packet-formats-benchmarks-test") {
  package_name = "packet-formats-benchmarks-test-gn"
  component_name = "packet-formats-benchmarks-test"
  deps = [ ":packet-formats-benchmarks_test" ]
  visibility = [
    ":*",
    "//src/connectivity/lib/packet-formats:*",
  ]
}
