import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_binary("benchmarks-bin") {
  testonly = true
  sources = [ "src/main.rs" ]
  configs += [ "//build/config/rust/lints:deny_unused_results" ]
  output_name = "internet_checksum_benchmarks"
  edition = "2024"
  deps = [
    "//src/connectivity/lib/internet-checksum",
    "//src/developer/fuchsia-criterion",
  ]
}

fuchsia_component_manifest("benchmarks-manifest") {
  testonly = true
  component_name = "internet_checksum_benchmarks"
  manifest = "meta/benchmarks.cml"
}

fuchsia_component("benchmarks-component") {
  testonly = true
  cm_label = ":benchmarks-manifest"
  deps = [ ":benchmarks-bin" ]
}
