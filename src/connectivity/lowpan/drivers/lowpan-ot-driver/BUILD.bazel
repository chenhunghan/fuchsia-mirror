load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":lowpan-ot-driver-test"],
    visibility = ["//src/connectivity/lowpan:__pkg__"],
)

exports_files(
    ["meta/lowpan-ot-driver.core_shard.cml"],
    visibility = ["//bundles/assembly:__subpackages__"],
)

# //src/connectivity/openthread/third_party/openthread/platform is C++, so GN
# binaries linking it with rustc need dynamic_cpp_standard_library; Bazel's
# C++ toolchain links libc++ automatically via link_deps.
# TODO(https://fxbug.dev/356474618): Re-enable and fix existing lints.
# configs += [ "//build/config/rust/lints:clippy_warn_all" ]
# @bazel2gn:raw_attribute:configs += [ "//build/config/fuchsia:dynamic_cpp_standard_library" ]
rustc_binary(
    name = "bin",
    srcs = [
        "src/bootstrap.rs",
        "src/config.rs",
        "src/convert_ext.rs",
        "src/driver/api.rs",
        "src/driver/border_agent.rs",
        "src/driver/connectivity_state.rs",
        "src/driver/convert.rs",
        "src/driver/detailed_logging.rs",
        "src/driver/dhcpv6pd.rs",
        "src/driver/driver_state.rs",
        "src/driver/error_adapter.rs",
        "src/driver/host_to_thread.rs",
        "src/driver/joiner.rs",
        "src/driver/mod.rs",
        "src/driver/multicast_routing_manager.rs",
        "src/driver/nat64.rs",
        "src/driver/ot_ctl.rs",
        "src/driver/srp_proxy/advertising_proxy.rs",
        "src/driver/srp_proxy/discovery_proxy.rs",
        "src/driver/srp_proxy/mod.rs",
        "src/driver/tasks.rs",
        "src/driver/tests.rs",
        "src/driver/thread_to_host.rs",
        "src/main.rs",
    ],
    binary_name = "lowpan_ot_driver",
    edition = "2024",
    link_deps = ["//src/connectivity/openthread/third_party/openthread/platform"],
    proc_macro_deps = ["//third_party/rust_crates/vendor:async-trait"],
    # Fuchsia-only because this binary unconditionally uses Fuchsia FIDL bindings and //src/lib/fuchsia-component.
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//sdk/fidl/fuchsia.buildinfo:fuchsia.buildinfo_rust",
        "//sdk/fidl/fuchsia.factory.lowpan:fuchsia.factory.lowpan_rust",
        "//sdk/fidl/fuchsia.feedback:fuchsia.feedback_rust",
        "//sdk/fidl/fuchsia.hardware.network:fuchsia.hardware.network_rust",
        "//sdk/fidl/fuchsia.hwinfo:fuchsia.hwinfo_rust",
        "//sdk/fidl/fuchsia.location.namedplace:fuchsia.location.namedplace_rust",
        "//sdk/fidl/fuchsia.lowpan.bootstrap:fuchsia.lowpan.bootstrap_rust",
        "//sdk/fidl/fuchsia.lowpan.device:fuchsia.lowpan.device_rust",
        "//sdk/fidl/fuchsia.lowpan.driver:fuchsia.lowpan.driver_rust",
        "//sdk/fidl/fuchsia.lowpan.experimental:fuchsia.lowpan.experimental_rust",
        "//sdk/fidl/fuchsia.lowpan.spinel:fuchsia.lowpan.spinel_rust",
        "//sdk/fidl/fuchsia.net.dhcpv6:fuchsia.net.dhcpv6_rust",
        "//sdk/fidl/fuchsia.net:fuchsia.net_rust",
        "//sdk/fidl/fuchsia.net.interfaces:fuchsia.net.interfaces_rust",
        "//sdk/fidl/fuchsia.net.masquerade:fuchsia.net.masquerade_rust",
        "//sdk/fidl/fuchsia.net.mdns:fuchsia.net.mdns_rust",
        "//sdk/fidl/fuchsia.net.multicast.admin:fuchsia.net.multicast.admin_rust",
        "//sdk/rust/zx",
        "//sdk/rust/zx-status",
        "//src/connectivity/lib/net-declare",
        "//src/connectivity/lib/net-types",
        "//src/connectivity/lib/packet-formats",
        "//src/connectivity/lowpan/lib/lowpan_driver_common",
        "//src/connectivity/lowpan/lib/openthread_fuchsia",
        "//src/connectivity/lowpan/lib/openthread_rust:openthread",
        "//src/lib/diagnostics/log/rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-sync",
        "//src/lib/network/fidl_fuchsia_net_ext",
        "//src/lib/network/packet",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:bitflags",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:hex",
        "//third_party/rust_crates/vendor:libc",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:rand",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:socket2",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

# //src/connectivity/openthread/third_party/openthread/platform is C++, so GN
# test binaries linking it with rustc need dynamic_cpp_standard_library;
# Bazel's C++ toolchain links libc++ automatically via link_deps.
# @bazel2gn:raw_attribute:configs += [ "//build/config/fuchsia:dynamic_cpp_standard_library" ]
rustc_test(
    name = "bin_test",
    crate = ":bin",
    # Preserves the GN test binary name from `rustc_binary(output_name = "lowpan_ot_driver", with_unit_tests = true)`.
    crate_name = "lowpan_ot_driver_bin_test",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:regex",
    ],
)

fx_packaged_binary(
    name = "bin_packaged",
    binary = ":bin",
    binary_name = "lowpan_ot_driver",
)

fx_component_manifest(
    name = "manifest",
    component_name = "lowpan-ot-driver",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/lowpan-ot-driver.cml",
)

fx_component(
    name = "lowpan-ot-driver-cv2",
    compiled_manifest = ":manifest",
    deps = [":bin_packaged"],
)

fx_packaged_binary(
    name = "bin_test_packaged",
    testonly = True,
    binary = ":bin_test",
    binary_name = "lowpan_ot_driver_bin_test",
)

fx_component_manifest(
    name = "lowpan-ot-driver-test_manifest",
    testonly = True,
    component_name = "lowpan-ot-driver-test",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/lowpan-ot-driver-test.cml",
)

fx_test_component(
    name = "lowpan-ot-driver-test_component",
    compiled_manifest = ":lowpan-ot-driver-test_manifest",
    deps = [":bin_test_packaged"],
)

fx_package(
    name = "lowpan-ot-driver-test_package",
    package_name = "lowpan-ot-driver-test",
    test_components = [":lowpan-ot-driver-test_component"],
)

fx_test(
    name = "lowpan-ot-driver-test",
    environments = ["//build/testing/environments:emu_env"],
    max_log_severity = "ERROR",
    package = ":lowpan-ot-driver-test_package",
)
