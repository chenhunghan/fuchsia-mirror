fuchsia_component_manifest("manifest") {
  component_name = "lowpan-ot-driver"
  manifest = "meta/lowpan-ot-driver.cml"
}

fuchsia_component("lowpan-ot-driver-cv2") {
  cm_label = ":manifest"
  deps = [ ":bin" ]
}

fuchsia_component_manifest("lowpan-ot-driver-test_manifest") {
  testonly = true
  component_name = "lowpan-ot-driver-test"
  manifest = "meta/lowpan-ot-driver-test.cml"
}

fuchsia_test_component("lowpan-ot-driver-test_component") {
  cm_label = ":lowpan-ot-driver-test_manifest"
  deps = [ ":bin_test" ]
}

fuchsia_test_package("lowpan-ot-driver-test_package") {
  package_name = "lowpan-ot-driver-test-gn"
  test_components = [ ":lowpan-ot-driver-test_component" ]
  test_specs = {
    environments = [ emu_env ]
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
