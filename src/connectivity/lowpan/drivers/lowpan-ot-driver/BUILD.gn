import("//build/components.gni")

# Kept in GN because `//src/connectivity/lowpan/drivers:drivers` and
# `//src/connectivity/lowpan/tests/thread-integration-tests` depend on
# `:lowpan-ot-driver`, and `:bin` transitively links `rustc_dylib`
# `//src/storage/lib/vfs/rust:vfs_dylib` via `//src/lib/fuchsia-component`.
fuchsia_package("lowpan-ot-driver") {
  deps = [
    ":lowpan-ot-driver-cv2",
    "//src/connectivity/lowpan/monitor:lowpan-monitor",
  ]
}

group("tests") {
  testonly = true
  deps = [ ":lowpan-ot-driver-test_package" ]
}

