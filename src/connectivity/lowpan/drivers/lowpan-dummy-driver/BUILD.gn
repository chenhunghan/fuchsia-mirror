import("//build/bazel/bazel_fuchsia_package.gni")

# Kept in GN because `//src/connectivity/lowpan/drivers:tests` still depends on
# `:lowpan-dummy-driver` in GN.
bazel_fuchsia_package("lowpan-dummy-driver") {
  bazel_config = "fuchsia_platform"
  package_name = "lowpan-dummy-driver"
}

group("tests") {
  testonly = true
  deps = [ ":lowpan-dummy-driver-test" ]
}

