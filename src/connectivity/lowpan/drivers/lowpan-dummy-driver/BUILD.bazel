load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load(
    "//build/bazel/rules/testing:fx_unittest_package.bzl",
    "fx_unittest_package",
)

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":lowpan-dummy-driver-test"],
    visibility = ["//src/connectivity/lowpan:__pkg__"],
)

rustc_binary(
    name = "bin",
    srcs = ["src/main.rs"],
    binary_name = "lowpan_dummy_driver",
    edition = "2024",
    # Fuchsia-only because this binary unconditionally uses Fuchsia FIDL bindings and //src/lib/fuchsia-component.
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//sdk/fidl/fuchsia.factory.lowpan:fuchsia.factory.lowpan_rust",
        "//sdk/fidl/fuchsia.lowpan.driver:fuchsia.lowpan.driver_rust",
        "//src/connectivity/lowpan/lib/lowpan_driver_common",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

rustc_test(
    name = "bin_test",
    crate = ":bin",
    # Preserves the GN test binary name from `rustc_binary(output_name = "lowpan_dummy_driver", with_unit_tests = true)`.
    crate_name = "lowpan_dummy_driver_bin_test",
    target_compatible_with = ["@platforms//os:fuchsia"],
)

fx_packaged_binary(
    name = "bin_packaged",
    binary = ":bin",
    binary_name = "lowpan_dummy_driver",
)

fx_component_manifest(
    name = "manifest",
    component_name = "lowpan-dummy-driver",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/lowpan-dummy-driver.cml",
)

fx_component(
    name = "lowpan-dummy-driver-cmp",
    compiled_manifest = ":manifest",
    visibility = [
        "//src/connectivity/lowpan/service:__pkg__",
        "//src/connectivity/lowpan/tests:__pkg__",
        "//src/connectivity/lowpan/tools/lowpanctl/test:__pkg__",
    ],
    deps = [":bin_packaged"],
)

fx_package(
    name = "lowpan-dummy-driver",
    components = [":lowpan-dummy-driver-cmp"],
)

fx_unittest_package(
    name = "lowpan-dummy-driver-test",
    unit_tests = [":bin_test"],
)
