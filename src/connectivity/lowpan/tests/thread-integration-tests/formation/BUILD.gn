import("//build/components.gni")
import("//build/rust/rustc_test.gni")
import(
    "//src/connectivity/lowpan/tests/thread-integration-tests/common/thread_test_package.gni")

# Thread network formation: a single node boots and forms a network.

group("tests") {
  testonly = true
  deps = [ ":thread-formation-integration-test" ]
}

rustc_test("bin") {
  edition = "2024"
  output_name = "thread_formation_integration_test"
  source_root = "src/main.rs"
  sources = [ "src/main.rs" ]
  deps = [
    "//sdk/fidl/fuchsia.lowpan.device:fuchsia.lowpan.device_rust",
    "//src/connectivity/lowpan/tests/thread-integration-tests/common:thread_testing_common",
    "//src/connectivity/network/testing/netemul/rust:lib",
    "//src/lib/fuchsia",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:test-case",
  ]
  configs += [ "//build/config/rust/lints:deny_unused_results" ]
}

fuchsia_unittest_package("thread-formation-integration-test") {
  deps = [ ":bin" ]
  subpackages = thread_test_subpackages
}
