# lib-ot-core is C++, so GN targets linking it with rustc need
# //build/config/fuchsia:dynamic_cpp_standard_library; Bazel's C++ toolchain
# links libc++ automatically via link_deps.
# @bazel2gn:raw_attribute:configs += [ "//build/config/fuchsia:dynamic_cpp_standard_library" ]
rustc_test(
    name = "openthread_test",
    crate = ":openthread",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = ["//third_party/rust_crates/vendor:assert_matches"],
)

fx_unittest_package(
    name = "openthread-rust-tests",
    unit_tests = [":openthread_test"],
)
