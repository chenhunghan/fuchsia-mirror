load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":lowpanservice-test"],
    visibility = ["//src/connectivity/lowpan:__pkg__"],
)

exports_files(
    ["meta/lowpanservice.core_shard.cml"],
    visibility = ["//bundles/assembly:__subpackages__"],
)

rustc_binary(
    name = "bin",
    srcs = [
        "src/inspect.rs",
        "src/main.rs",
        "src/service.rs",
    ],
    binary_name = "lowpanservice",
    edition = "2024",
    proc_macro_deps = ["//third_party/rust_crates/vendor:async-trait"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//sdk/fidl/fuchsia.factory.lowpan:fuchsia.factory.lowpan_rust",
        "//sdk/fidl/fuchsia.lowpan.driver:fuchsia.lowpan.driver_rust",
        "//sdk/fidl/fuchsia.lowpan.experimental:fuchsia.lowpan.experimental_rust",
        "//src/connectivity/lowpan/lib/lowpan_driver_common",
        "//src/lib/async-utils",
        "//src/lib/diagnostics/inspect/contrib/rust",
        "//src/lib/diagnostics/inspect/runtime/rust",
        "//src/lib/diagnostics/inspect/rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-sync",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:regex-lite",
    ],
)

rustc_test(
    name = "bin_test",
    crate = ":bin",
    # Preserves the GN test binary name from `rustc_binary(name = "lowpanservice", with_unit_tests = true)`.
    crate_name = "lowpanservice_bin_test",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//sdk/rust/zx",
        "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
        "//src/lib/fuchsia-component-test",
    ],
)

fx_packaged_binary(
    name = "bin_packaged",
    binary = ":bin",
    binary_name = "lowpanservice",
)

fx_component_manifest(
    name = "manifest",
    component_name = "lowpanservice",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/lowpanservice.cml",
)

fx_component(
    name = "lowpanservice-cv2",
    compiled_manifest = ":manifest",
    visibility = [
        "//src/connectivity/lowpan/tests:__pkg__",
        "//src/connectivity/lowpan/tools/lowpanctl/test:__pkg__",
    ],
    deps = [":bin_packaged"],
)

fx_packaged_binary(
    name = "bin_test_packaged",
    testonly = True,
    binary = ":bin_test",
    binary_name = "lowpanservice_bin_test",
)

fx_component_manifest(
    name = "lowpanservice-test_manifest",
    testonly = True,
    component_name = "lowpanservice-test",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/sys/component:realm_builder.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/lowpanservice-test.cml",
)

fx_test_component(
    name = "lowpanservice-test_component",
    compiled_manifest = ":lowpanservice-test_manifest",
    deps = [":bin_test_packaged"],
)

fx_package(
    name = "lowpanservice-test_package",
    package_name = "lowpanservice-test",
    components = [
        ":lowpanservice-cv2",
        "//src/connectivity/lowpan/drivers/lowpan-dummy-driver:lowpan-dummy-driver-cmp",
        "//src/lib/fuchsia-component-test/realm_builder_server:realm_builder_server_component",
    ],
    test_components = [":lowpanservice-test_component"],
)

fx_test(
    name = "lowpanservice-test",
    max_log_severity = "ERROR",
    package = ":lowpanservice-test_package",
)
