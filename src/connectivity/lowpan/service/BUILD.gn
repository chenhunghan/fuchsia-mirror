fuchsia_component_manifest("manifest") {
  component_name = "lowpanservice"
  manifest = "meta/lowpanservice.cml"
}

fuchsia_component("lowpanservice-cv2") {
  cm_label = ":manifest"
  visibility = [
    ":*",
    "//src/connectivity/lowpan/tests:*",
    "//src/connectivity/lowpan/tools/lowpanctl/test:*",
  ]
  deps = [ ":bin" ]
}

fuchsia_component_manifest("lowpanservice-test_manifest") {
  testonly = true
  component_name = "lowpanservice-test"
  manifest = "meta/lowpanservice-test.cml"
}

fuchsia_test_component("lowpanservice-test_component") {
  cm_label = ":lowpanservice-test_manifest"
  deps = [ ":bin_test" ]
}

fuchsia_test_package("lowpanservice-test_package") {
  package_name = "lowpanservice-test-gn"
  test_components = [ ":lowpanservice-test_component" ]
  deps = [
    ":lowpanservice-cv2",
    "//src/connectivity/lowpan/drivers/lowpan-dummy-driver:lowpan-dummy-driver-cmp",
    "//src/lib/fuchsia-component-test/realm_builder_server:realm_builder_server_component",
  ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
