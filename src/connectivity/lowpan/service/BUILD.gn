import("//build/components.gni")

# Kept in GN because `group("service")` (used by `//src/connectivity/lowpan`,
# `//src/connectivity/lowpan/tests`, and
# `//src/connectivity/lowpan/tools/lowpanctl/test`) depends on `:lowpanservice`
# and `:bin` transitively links `rustc_dylib`
# `//src/storage/lib/vfs/rust:vfs_dylib` via `//src/lib/fuchsia-component`.
fuchsia_package("lowpanservice") {
  deps = [ ":lowpanservice-cv2" ]
}

group("service") {
  deps = [ ":lowpanservice" ]
}

group("tests") {
  testonly = true
  deps = [ ":lowpanservice-test_package" ]
}

