load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")

package(default_applicable_licenses = ["//:license"])

# LoWPAN device tests defined in Bazel. These are exported to `fx test` and
# infra builders through `:bazel_tests` in BUILD.gn.
test_suite(
    name = "lowpan_tests",
    target_compatible_with = ["@platforms//os:fuchsia"],
    tests = [
        "//src/connectivity/lowpan/drivers/lowpan-dummy-driver:tests",
        "//src/connectivity/lowpan/drivers/lowpan-ot-driver:tests",
        "//src/connectivity/lowpan/lib/lowpan_driver_common:tests",
        "//src/connectivity/lowpan/lib/openthread_fuchsia:tests",
        "//src/connectivity/lowpan/lib/openthread_rust:tests",
        "//src/connectivity/lowpan/lib/spinel_pack:tests",
        "//src/connectivity/lowpan/service:tests",
        "//src/connectivity/lowpan/tests",
        "//src/connectivity/lowpan/tools/lowpanctl:tests",
    ],
)

# LoWPAN host tests defined in Bazel. These are exported to `fx test` and
# infra builders through `:bazel_tests` in BUILD.gn.
test_suite(
    name = "lowpan_host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [
        "//src/connectivity/lowpan/lib/spinel_pack:host_tests",
    ],
)
