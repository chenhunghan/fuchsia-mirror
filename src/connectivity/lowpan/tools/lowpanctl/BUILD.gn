import("//build/components.gni")

# Kept in GN because `:bin` transitively links dual-built `rustc_dylib`
# `//src/storage/lib/vfs/rust:vfs_dylib` via `//src/lib/fuchsia-component`, and
# unmigrated GN callers (`//src/testing/sl4f:lib` and
# `//src/connectivity/lowpan/tools:tools`) depend on `:lowpanctl`.
fuchsia_package("lowpanctl") {
  deps = [ ":bin" ]
}

group("tests") {
  testonly = true
  deps = [
    ":lowpanctl-unittests",
    "test",
  ]
}

