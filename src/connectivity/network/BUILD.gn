import("//build/bazel/bazel_test_suite.gni")

# LINT.IfChange(performance_critical_rust_crate)
config("performance_critical_rust_crate") {
  if (is_release && !is_host) {
    configs = [ "//build/config:optimize_speed" ]
  }
}

# LINT.ThenChange(BUILD.bazel:performance_critical_rust_crate)

group("drivers") {
  deps = [ "drivers/network-device" ]
}

group("benchmarks") {
  testonly = true
  deps = [
    "drivers/network-device/device:benchmarks",
    "netstack3:benchmarks",
    "tests/benchmarks",
  ]
}

group("e2e_tests") {
  testonly = true

  deps = [ "//src/connectivity/network/testing/conformance/emulator:e2e_tests" ]
}

bazel_test_suite("bazel_tests") {
  host_tests = [ "//src/connectivity/network:host_tests" ]
  target_tests = [ "//src/connectivity/network:target_tests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    "dhcpv4:tests",
    "dhcpv6:tests",
    "dns:tests",
    "drivers:tests",
    "lib:tests",
    "mdns:tests",
    "net-cli:tests",
    "netlink:tests",
    "netstack3:tests",
    "testing:tests",
    "tests",
    "tools:tests",
    "tun:tests",
  ]
}
