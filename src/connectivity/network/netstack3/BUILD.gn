    ":netstack3_configs",
    ":netstack3_debug_configs",
  ]
  edition = "2024"
  _concurrent_jobs = concurrent_jobs.rust_highmem
  configs += _concurrent_jobs.configs
  forward_variables_from(_concurrent_jobs.vars, "*")
  proc_macro_deps = _COMMON_PROC_MACRO_DEPS
  deps = _COMMON_DEPS +
         [ "//src/connectivity/network/netstack3/core:netstack3-core" ]
