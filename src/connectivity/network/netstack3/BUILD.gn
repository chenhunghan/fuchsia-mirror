declare_args() {
  # Adds compilation flags to emit rustc self-profiling when building netstack3
  # targets. That helps us track down where time is spent and memory
  # consumption to play nice with RBE.
  netstack3_profile_rustc = false
}

import("//build/bazel/bazel_fuchsia_package.gni")
import("//build/components.gni")

# See netstack3_profile_rustc GN arg for details here.
config("compiler_profile") {
  rustflags = [
    "-Ztime-passes",
    "-Zllvm-time-trace",
    "-Zself-profile",
  ]
  visibility = [ ":*" ]
}

# LINT.IfChange(netstack3_configs)
# Keep in sync with netstack3_configs in BUILD.bazel.
config("netstack3_configs") {
  # TODO(https://fxbug.dev/556328773): Remove -Znext-solver=coherence once the
  # ~80x wfcheck regression under -Znext-solver=globally is fixed.
  rustflags = [ "-Znext-solver=coherence" ]

  if (is_release && !is_host) {
    configs = [
      # Always optimize speed, even if it increases size.
      "//build/config:optimize_speed",
    ]
  }
  visibility = [
    "//src/connectivity/lib/packet-formats/benchmarks:*",
    "//src/connectivity/network/*",
  ]
}

# LINT.ThenChange(BUILD.bazel:netstack3_configs)

# LINT.IfChange(netstack3_debug_configs)
config("netstack3_debug_configs") {
  if (is_debug) {
    configs = [
      # Minor optimizations that remove a lot of indirection and make zero-cost
      # closer to zero-cost.
      "//build/config:optimize_debug",
    ]

    # Enable ThinLTO to allow cross-crate optimization, as netstack3 is
    # distributed across multiple crates.
    configs += [ "//build/config/lto:thinlto-if-compatible" ]
  }
}

# LINT.ThenChange(BUILD.bazel:netstack3_debug_configs)

# TODO(https://fxbug.dev/582745291): netstack3 is ready to be moved to
# bazel_fuchsia_package, but is held back waiting for debug symbols to be
# resolved.
fuchsia_package("netstack3") {
  package_name = "netstack3"
  deps = [ ":component" ]
  visibility = [
    ":*",
    "//bundles/assembly/*",
  ]
}

# A stand-in for :netstack3 to use as a subpackage in tests.
bazel_fuchsia_package("package-for-tests") {
  testonly = true
  package_name = "netstack"
  bazel_config = "fuchsia_platform"
}

# Package with debugging instrumentation enabled. This should be used as a
# subpackage in tests, not benchmarks.
bazel_fuchsia_package("package-debug") {
  testonly = true
  package_name = "netstack-debug"
  bazel_config = "fuchsia_platform"
}

# A stand-in for :package-debug for tests that need reduced logging verbosity.
bazel_fuchsia_package("package-debug-less-logs") {
  testonly = true
  package_name = "netstack-debug"
  bazel_config = "fuchsia_platform"
}

# Package with debugging instrumentation enabled and opaque IIDs disabled for
# convenience in conformance testing.
bazel_fuchsia_package("package-conformance") {
  testonly = true
  package_name = "netstack-conformance"
  bazel_config = "fuchsia_platform"
}

group("netstack3-bin_test") {
  testonly = true
  deps = [ ":netstack3-bin_test_package" ]
}

group("netstack3-bin-instrumented_test") {
  testonly = true
  deps = [ ":netstack3-bin-instrumented_test_package" ]
}

group("benchmarks") {
  testonly = true
  deps = [ "bench" ]
}

group("tests") {
  testonly = true
  deps = [
    ":netstack3-bin-instrumented_test",
    ":netstack3-bin_test",
    "bench:tests",
    "core:tests",
  ]
}

