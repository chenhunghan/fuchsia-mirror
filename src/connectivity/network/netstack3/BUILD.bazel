    name = "component-conformance_manifest",
    component_name = "netstack3-conformance",
    includes = [
        ":meta/netstack3.shard",
        ":meta/test_common_configs.shard",
    ],
    manifest = "meta/netstack3_conformance.cml",
)

# Component with debugging instrumentation enabled and opaque IIDs disabled for
# convenience in conformance testing.
# @bazel2gn:skip
fx_component(
    name = "component-conformance",
    testonly = True,
    compiled_manifest = ":component-conformance_manifest",
    deps = [":bin-instrumented_packaged"],
)

# Package with debugging instrumentation enabled and opaque IIDs disabled for
# convenience in conformance testing.
fx_package(
    name = "package-conformance",
    package_name = "netstack-conformance",
    testonly = True,
    components = [":component-conformance"],
)

fx_unittest_component(
    name = "netstack3-bin_test_component",
    binary = ":bin_test",
    component_name = "netstack3-bin_test",
)

fx_package(
    name = "netstack3-bin_test_package",
    package_name = "netstack3-bin_test",
    subpackages = ["//src/connectivity/network/testing/netemul/service:package"],
    test_components = [":netstack3-bin_test_component"],
)

fx_test(
    name = "netstack3-bin_test",
    package = ":netstack3-bin_test_package",
)

fx_unittest_component(
    name = "netstack3-bin-instrumented_test_component",
    binary = ":bin-instrumented_test",
    component_name = "netstack3-bin-instr_test",
)

fx_package(
    name = "netstack3-bin-instrumented_test_package",
    package_name = "netstack3-bin-instr_test",
    subpackages = ["//src/connectivity/network/testing/netemul/service:package"],
    test_components = [":netstack3-bin-instrumented_test_component"],
)

fx_test(
    name = "netstack3-bin-instrumented_test",
    package = ":netstack3-bin-instrumented_test_package",
)
