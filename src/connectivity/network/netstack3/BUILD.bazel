# Profile the binary build when requested.
# @bazel2gn:raw_attribute:if (netstack3_profile_rustc) { configs += [ ":compiler_profile" ] }
rustc_binary(
    name = "bin",
    srcs = _COMMON_SRCS,
    binary_name = "netstack3",
    build_flags = [
        ":check_cfg_flags",
        "//build/config/rust/lints:deny_unused_results",
        ":netstack3_configs",
        ":netstack3_debug_configs",
    ],
    edition = "2024",
    # Both debug and release NS3 builds take a long while to run because of
    # optimizations. Build these on the larger build machines to prevent build
    # times from becoming unreasonably large.
    exec_properties = RBE_USE_LARGE_WORKER,
    proc_macro_deps = _COMMON_PROC_MACRO_DEPS,
    deps = _COMMON_DEPS + ["//src/connectivity/network/netstack3/core:netstack3-core"],
)

# Cannot attach to `:bin` via `crate` because unit tests require
# `:netstack3-core-testutils` instead of `:netstack3-core`.
# @bazel2gn:raw_attribute:if (netstack3_profile_rustc) { configs += [ ":compiler_profile" ] }
rustc_test(
    name = "bin_test",
    srcs = _COMMON_SRCS,
    build_flags = [
        ":check_cfg_flags",
        "//build/config/rust/lints:deny_unused_results",
        ":netstack3_configs",
        ":netstack3_debug_configs",
    ],
    # Preserves the GN `with_unit_tests = true` output binary name for `:bin`.
    crate_name = "netstack3_bin_test",
    crate_root = "src/main.rs",
    edition = "2024",
    exec_properties = RBE_USE_LARGE_WORKER,
    proc_macro_deps = _COMMON_PROC_MACRO_DEPS + _COMMON_TEST_PROC_MACRO_DEPS,
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = _COMMON_DEPS + _COMMON_TEST_DEPS,
)

rustc_binary(
    name = "bin-instrumented",
    srcs = _COMMON_SRCS,
    binary_name = "netstack3-instrumented",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate_features = ["instrumented"],
    edition = "2024",
    # This target needs more memory to build remotely, see b/484091776.
    exec_properties = RBE_USE_LARGE_WORKER,
    proc_macro_deps = _COMMON_PROC_MACRO_DEPS,
    deps = _COMMON_DEPS + ["//src/connectivity/network/netstack3/core:netstack3-core-instrumented"],
)

# Cannot attach to `:bin-instrumented` via `crate` because unit tests require
# `:netstack3-core-testutils` instead of `:netstack3-core-instrumented`.
rustc_test(
    name = "bin-instrumented_test",
    srcs = _COMMON_SRCS,
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate_features = ["instrumented"],
    # Preserves the GN `with_unit_tests = true` output binary name for
    # `:bin-instrumented`.
    crate_name = "netstack3_instrumented_bin_test",
    crate_root = "src/main.rs",
    edition = "2024",
    exec_properties = RBE_USE_LARGE_WORKER,
    proc_macro_deps = _COMMON_PROC_MACRO_DEPS + _COMMON_TEST_PROC_MACRO_DEPS,
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = _COMMON_DEPS + _COMMON_TEST_DEPS,
)

