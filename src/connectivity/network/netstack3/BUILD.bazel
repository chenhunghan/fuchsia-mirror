# LINT.IfChange(netstack3_configs)
# @bazel2gn:skip
build_flags(
    name = "netstack3_configs",
    # TODO(https://fxbug.dev/556328773): Remove -Znext-solver=coherence once
    # the ~80x wfcheck regression under -Znext-solver=globally is fixed.
    rustflags = ["-Znext-solver=coherence"] + (select({
        # Always optimize speed, even if it increases size.
        "@platforms//os:fuchsia": ["-Copt-level=3"],
        "//conditions:default": [],
    }) if is_release else []),
    visibility = [
        "//src/connectivity/lib/packet-formats/benchmarks:__pkg__",
        "//src/connectivity/network:__subpackages__",
    ],
)
# LINT.ThenChange(BUILD.gn:netstack3_configs)

# LINT.IfChange(netstack3_debug_configs)
# @bazel2gn:skip
build_flags(
    name = "netstack3_debug_configs",
    subflags = [
        # Minor optimizations that remove a lot of indirection and make zero-cost
        # closer to zero-cost.
        "//build/config:optimize_debug",

        # Enable ThinLTO to allow cross-crate optimization, as netstack3 is
        # distributed across multiple crates.
        "//build/config/lto:thinlto-if-compatible",
    ] if is_debug else [],
)
# LINT.ThenChange(BUILD.gn:netstack3_debug_configs)

rustc_check_cfg_build_flags(
    name = "check_cfg_flags",
    cfgs = ["test"],
    features = ["instrumented"],
)

