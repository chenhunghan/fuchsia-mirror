load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")

package(default_applicable_licenses = ["//:license"])

rustc_test(
    name = "settings",
    srcs = ["src/lib.rs"],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    # Preserves GN `output_name = "netstack_settings_fidl_test"` through bazel2gn.
    crate_name = "netstack_settings_fidl_test",
    edition = "2024",
    proc_macro_deps = [
        "//src/connectivity/network/tests/integration/macros:netstack_testing_macros",
    ],
    visibility = ["//src/connectivity/network/tests/fidl:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.net.interfaces.admin:fuchsia.net.interfaces.admin_rust",
        "//sdk/fidl/fuchsia.net.settings:fuchsia.net.settings_rust",
        "//sdk/fidl/fuchsia.posix.socket:fuchsia.posix.socket_rust",
        "//sdk/fidl/fuchsia.posix.socket.packet:fuchsia.posix.socket.packet_rust",
        "//sdk/fidl/fuchsia.posix.socket.raw:fuchsia.posix.socket.raw_rust",
        "//src/connectivity/network/testing/netemul/rust:lib",
        "//src/connectivity/network/tests/integration/common:netstack_testing_common",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:socket2",
    ],
)
