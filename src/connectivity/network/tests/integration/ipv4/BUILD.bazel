load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")

package(default_applicable_licenses = ["//:license"])

rustc_test(
    name = "ipv4",
    srcs = ["src/lib.rs"],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    # Preserves GN output_name for the parent integration test package.
    crate_name = "netstack_ipv4_integration_test",
    edition = "2024",
    proc_macro_deps = [
        "//src/connectivity/network/tests/integration/macros:netstack_testing_macros",
    ],
    visibility = ["//src/connectivity/network/tests/integration:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.net:fuchsia.net_rust",
        "//sdk/fidl/fuchsia.net.interfaces.admin:fuchsia.net.interfaces.admin_rust",
        "//sdk/fidl/fuchsia.net.routes:fuchsia.net.routes_rust",
        "//src/connectivity/lib/net-declare",
        "//src/connectivity/lib/net-types",
        "//src/connectivity/lib/packet-formats",
        "//src/connectivity/network/testing/netemul/rust:lib",
        "//src/connectivity/network/tests/integration/common:netstack_testing_common",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/network/fidl_fuchsia_net_routes_ext",
        "//src/lib/network/packet",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:test-case",
    ],
)
