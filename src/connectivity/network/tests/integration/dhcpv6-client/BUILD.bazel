load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")

package(default_applicable_licenses = ["//:license"])

rustc_test(
    name = "dhcpv6-client",
    srcs = ["src/lib.rs"],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    # Preserves the GN `output_name` expected by the integration test component manifest.
    crate_name = "netstack_dhcpv6_client_integration_test",
    edition = "2024",
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = ["//src/connectivity/network/tests/integration:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.net.dhcpv6:fuchsia.net.dhcpv6_rust",
        "//sdk/fidl/fuchsia.net:fuchsia.net_rust",
        "//sdk/fidl/fuchsia.net.interfaces:fuchsia.net.interfaces_rust",
        "//sdk/fidl/fuchsia.posix.socket:fuchsia.posix.socket_rust",
        "//sdk/rust/zx",
        "//src/connectivity/lib/fidl_fuchsia_net_dhcpv6_ext",
        "//src/connectivity/lib/net-declare",
        "//src/connectivity/network/testing/netemul/rust:lib",
        "//src/connectivity/network/tests/integration/common:netstack_testing_common",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:socket2",
        "//third_party/rust_crates/vendor:test-case",
    ],
)
