import("//build/bazel/bazel_fuchsia_package.gni")
import("//build/testing/perf/test.gni")

# Bridge the Bazel package for GN-only perf and tracing consumers
# (fuchsia_component_perf_test and
# //src/connectivity/network/tests/benchmarks/with-tracing).
# LINT.IfChange
bazel_fuchsia_package("tun-socket-benchmarks-tests-netstack3") {
  testonly = true
  bazel_config = "fuchsia_platform"
}

# LINT.ThenChange(BUILD.bazel)

fuchsia_component_perf_test("tun_socket_benchmarks_with_netstack3") {
  package = ":tun-socket-benchmarks-tests-netstack3"
  component_name = "tun-socket-benchmarks-netstack3"
  expected_metric_names_filepath = "//src/tests/end_to_end/perf/expected_metric_names/fuchsia.network.socket.tun.netstack3.txt"
  test_component_args = [ "--output-fuchsiaperf" ]
}

group("benchmarks") {
  testonly = true
  deps = [ ":tun_socket_benchmarks_with_netstack3($host_toolchain)" ]
}

group("tests") {
  testonly = true
  public_deps = [ ":tun-socket-benchmarks-tests-netstack3" ]
}
