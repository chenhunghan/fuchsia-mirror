}
if (is_fuchsia) {
  rustc_test("dhcp_client_test") {
    sources = [
      "src/client.rs",
      "src/inspect.rs",
      "src/main.rs",
      "src/packetsocket.rs",
      "src/provider.rs",
      "src/udpsocket.rs",
    ]
    edition = "2024"
    proc_macro_deps = [ "//third_party/rust_crates:derivative" ]
    deps = [
             "//sdk/fidl/fuchsia.net:fuchsia.net_rust",
             "//sdk/fidl/fuchsia.net.dhcp:fuchsia.net.dhcp_rust",
             "//sdk/fidl/fuchsia.net.interfaces:fuchsia.net.interfaces_rust",
             "//sdk/fidl/fuchsia.net.interfaces.admin:fuchsia.net.interfaces.admin_rust",
             "//sdk/fidl/fuchsia.posix:fuchsia.posix_rust",
             "//sdk/fidl/fuchsia.posix.socket.packet:fuchsia.posix.socket.packet_rust",
             "//sdk/rust/zx",
             "//src/connectivity/lib/net-types",
             "//src/connectivity/lib/packet-formats",
             "//src/connectivity/network/dhcpv4/client/core",
             "//src/connectivity/network/dhcpv4/protocol",
             "//src/connectivity/network/lib/diagnostics-traits",
             "//src/connectivity/network/lib/sockaddr",
             "//src/lib/diagnostics/inspect/runtime/rust",
             "//src/lib/diagnostics/inspect/rust",
             "//src/lib/fidl/rust/fidl",
             "//src/lib/fuchsia",
             "//src/lib/fuchsia-async",
             "//src/lib/fuchsia-component",
             "//src/lib/fuchsia-sync",
             "//src/lib/network/fidl_fuchsia_net_ext",
             "//src/lib/network/fidl_fuchsia_net_interfaces_ext",
             "//src/lib/network/fidl_fuchsia_posix_socket_ext",
             "//third_party/rust_crates:anyhow",
             "//third_party/rust_crates:futures",
             "//third_party/rust_crates:indexmap",
             "//third_party/rust_crates:libc",
             "//third_party/rust_crates:log",
             "//third_party/rust_crates:rand",
             "//third_party/rust_crates:thiserror",
           ] + [
             "//sdk/fidl/fuchsia.hardware.network:fuchsia.hardware.network_rust",
             "//sdk/fidl/fuchsia.posix.socket:fuchsia.posix.socket_rust",
             "//src/connectivity/lib/net-declare",
             "//src/connectivity/network/testing/netemul/network-context/fidl:network_rust",
             "//src/connectivity/network/testing/netemul/rust:lib",
             "//src/connectivity/network/tests/integration/common:netstack_testing_common",
             "//src/lib/network/packet",
           ]
    source_root = "src/main.rs"
    configs += [ "//build/config/rust/lints:deny_unused_results" ]
    output_name = "dhcp_client_bin_test"
  }
}

fuchsia_component_manifest("manifest") {
  component_name = "dhcp-client"
  manifest = "meta/dhcp-client.cml"
}

fuchsia_component("component") {
  cm_label = ":manifest"
  deps = [ ":dhcp_client" ]
}

fuchsia_component_manifest_with_expectations("dhcp-client-test_manifest") {
  component_name = "dhcp-client-test"
  manifest = "meta/dhcp-client-test.cml"
}

fuchsia_test_component_with_expectations("dhcp-client-test-no-err-logs") {
  cm_label = ":dhcp-client-test_manifest"
  expectations = "expects/expectations.json5"
  treatment_of_cases_with_error_logs = "SKIP_CASES_WITH_ERROR_LOGS"
  deps = [ ":dhcp_client_test" ]
}

fuchsia_test_package("dhcp-client-tests-package") {
  package_name = "dhcp-client-tests-gn"
  test_components = [ ":dhcp-client-test-no-err-logs" ]
  subpackages = [
    "//src/connectivity/network/netstack3:package-debug",
    "//src/connectivity/network/testing/netemul/service:package",
  ]
}

fuchsia_test_component_with_expectations("dhcp-client-test-with-err-logs") {
  cm_label = ":dhcp-client-test_manifest"
  expectations = "expects/expectations.json5"
  treatment_of_cases_with_error_logs = "RUN_ONLY_CASES_WITH_ERROR_LOGS"
  deps = [ ":dhcp_client_test" ]
}

fuchsia_test_package("dhcp-client-tests-with-error-logs-package") {
  package_name = "dhcp-client-tests-with-error-logs-gn"
  test_components = [ ":dhcp-client-test-with-err-logs" ]
  subpackages = [
    "//src/connectivity/network/netstack3:package-debug",
    "//src/connectivity/network/testing/netemul/service:package",
  ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
