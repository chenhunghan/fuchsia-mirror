import("//build/components.gni")

# Kept in GN because :package links the dual-built rustc_dylib
# libvfs_rust.so (shipped as libvfs-<hash>.so in Bazel) and has non-assembly
# GN subpackage callers. See https://fxbug.dev/582745291.
fuchsia_package("package") {
  package_name = "dhcp-client"
  deps = [ ":component" ]
}

group("tests") {
  testonly = true
  deps = [
    ":dhcp-client-tests-package",
    ":dhcp-client-tests-with-error-logs-package",
  ]
}

