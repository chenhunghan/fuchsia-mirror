fuchsia_component_manifest("dhcpv4_server_bin_test_manifest") {
  testonly = true
  component_name = "dhcpv4_server_bin_test"
  manifest = "meta/dhcpv4_server_bin_test.cml"
}

fuchsia_test_component("dhcpv4_server_bin_test") {
  cm_label = ":dhcpv4_server_bin_test_manifest"
  deps = [ ":bin_test" ]
}

fuchsia_test_package("dhcpv4-server-tests-package") {
  package_name = "dhcpv4-server-tests-gn"
  test_components = [ ":dhcpv4_server_bin_test" ]
  deps = [ "//src/sys/stash:stash_secure_v2" ]
}

fuchsia_component_manifest("manifest") {
  component_name = "dhcpv4_server"
  manifest = "meta/dhcpv4_server.cml"
}

fuchsia_structured_config_rust_lib("config") {
  cm_label = ":manifest"
}

fuchsia_component("component") {
  cm_label = ":manifest"
