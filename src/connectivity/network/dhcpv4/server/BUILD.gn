import("//build/components.gni")
import("//build/rust/rustc_binary.gni")

rustc_binary("bin") {
  name = "dhcpv4_server"
  with_unit_tests = true
  edition = "2024"

  deps = [
    ":config",
    "//sdk/fidl/fuchsia.net.dhcp:fuchsia.net.dhcp_rust",
    "//sdk/rust/zx",
    "//src/connectivity/lib/net-declare",
    "//src/connectivity/lib/net-types",
    "//src/connectivity/lib/packet-formats",
    "//src/connectivity/network/dhcpv4/lib",
    "//src/connectivity/network/lib/sockaddr",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia_nix",
    "//src/lib/network/packet",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:libc",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:socket2",
  ]

  test_deps = [ "//third_party/rust_crates:assert_matches" ]

  sources = [ "src/main.rs" ]

  configs += [ "//build/config/rust/lints:deny_unused_results" ]
}

fuchsia_component("dhcpv4_server_bin_test") {
  testonly = true
  manifest = "meta/dhcpv4_server_bin_test.cml"
  deps = [ ":bin_test" ]
}

fuchsia_test_package("dhcpv4-server-tests") {
  test_components = [ ":dhcpv4_server_bin_test" ]
  deps = [ "//src/sys/stash:stash_secure_v2" ]
}

fuchsia_component_manifest("manifest") {
  component_name = "dhcpv4_server"
  manifest = "meta/dhcpv4_server.cml"
  visibility = [ ":*" ]
}

fuchsia_structured_config_rust_lib("config") {
  cm_label = ":manifest"
  visibility = [ ":*" ]
}

fuchsia_component("component") {
  cm_label = ":manifest"
  deps = [ ":bin" ]
  visibility = [
    ":*",
    "//vendor/google/*",
  ]
}

fuchsia_structured_config_values("default_config_values") {
  cm_label = ":manifest"
  values = {
    persistent = false
  }
  visibility = [ ":*" ]
}

fuchsia_package("package") {
  package_name = "dhcpv4-server"
  deps = [
    ":component",
    ":default_config_values",
  ]
}

group("tests") {
  testonly = true
  deps = [ ":dhcpv4-server-tests" ]
}
