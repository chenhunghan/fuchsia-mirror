        "//sdk/fidl/fuchsia.io:fuchsia.io_rust_fdomain_flex",
        "//sdk/fidl/fuchsia.net:fuchsia.net_rust_fdomain_flex",
        "//sdk/fidl/fuchsia.net.debug:fuchsia.net.debug_rust_fdomain_flex",
        "//sdk/fidl/fuchsia.net.dhcp:fuchsia.net.dhcp_rust_fdomain_flex",
        "//sdk/fidl/fuchsia.net.filter:fuchsia.net.filter_rust_fdomain_flex",
        "//sdk/fidl/fuchsia.net.interfaces:fuchsia.net.interfaces_rust_fdomain_flex",
        "//sdk/fidl/fuchsia.net.interfaces.admin:fuchsia.net.interfaces.admin_rust_fdomain_flex",
        "//sdk/fidl/fuchsia.net.matchers:fuchsia.net.matchers_rust_fdomain_flex",
        "//sdk/fidl/fuchsia.net.name:fuchsia.net.name_rust_fdomain_flex",
        "//sdk/fidl/fuchsia.net.neighbor:fuchsia.net.neighbor_rust_fdomain_flex",
        "//sdk/fidl/fuchsia.net.resources:fuchsia.net.resources_rust_fdomain_flex",
        "//sdk/fidl/fuchsia.net.root:fuchsia.net.root_rust_fdomain_flex",
        "//sdk/fidl/fuchsia.net.routes:fuchsia.net.routes_rust_fdomain_flex",
        "//sdk/fidl/fuchsia.net.stack:fuchsia.net.stack_rust_fdomain_flex",
        "//sdk/rust/zx-status",
        "//sdk/rust/zx-types",
        "//src/connectivity/lib/fidl_fuchsia_net_neighbor_ext:fidl_fuchsia_net_neighbor_ext_fdomain",
        "//src/connectivity/lib/fidl_fuchsia_net_stack_ext",
        "//src/connectivity/lib/net-types",
        "//src/connectivity/network/lib/pcap:pcap-compile",
        "//src/developer/lib/writer:lib",
        "//src/lib/fdomain/client:flex_fdomain",
        "//src/lib/network/fidl_fuchsia_net_ext",
        "//src/lib/network/fidl_fuchsia_net_filter_ext:fidl_fuchsia_net_filter_ext_fdomain",
        "//src/lib/network/fidl_fuchsia_net_interfaces_ext:fidl_fuchsia_net_interfaces_ext_fdomain",
        "//src/lib/network/fidl_fuchsia_net_matchers_ext:fidl_fuchsia_net_matchers_ext_fdomain",
        "//src/lib/network/fidl_fuchsia_net_routes_ext:fidl_fuchsia_net_routes_ext_fdomain",
        # prettytable-rs is a fork outside vendor/; GN reaches it through
        # the //third_party/rust_crates:prettytable-rs alias group.
        "//third_party/rust_crates/forks/prettytable-rs:prettytable",  # @bazel2gn:path_overwrite://third_party/rust_crates:prettytable-rs
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:itertools",
