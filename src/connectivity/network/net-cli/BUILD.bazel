rustc_test(
    name = "lib_test",
    build_flags = _COMMON_BUILD_FLAGS,
    crate = ":lib",
    # Preserve the GN unit test output name so generic :lib_test does not collide in root_out_dir.
    crate_name = "net_cli_lib_test",
    # Fuchsia-only because :lib depends on Fuchsia-only FIDL flex bindings.
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = _COMMON_TEST_DEPS + [
        "//src/lib/fdomain/local:local_fidl_flex",
    ],
)

rustc_test(
    name = "lib_fdomain_test",
    build_flags = _COMMON_BUILD_FLAGS,
    crate = ":lib_fdomain",
    crate_features = ["fdomain"],
    # Preserve the GN unit test output name from with_unit_tests = true.
    crate_name = "net_cli_fdomain_lib_test",
    deps = _COMMON_TEST_DEPS + [
        "//src/lib/fdomain/local:local_fdomain_flex",
    ],
)

wrap_host_rust_test(
    name = "lib_fdomain_host_test",
    binary_name = "lib_fdomain_test",
)

rustc_binary(
    name = "bin",
    srcs = ["src/main.rs"],
    binary_name = "net",
    build_flags = _COMMON_BUILD_FLAGS,
    edition = "2024",
    proc_macro_deps = ["//third_party/rust_crates/vendor:async-trait"],
    # Fuchsia-only because this binary uses Fuchsia component and FIDL libraries.
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        ":lib",
        "//sdk/fidl/fuchsia.net.debug:fuchsia.net.debug_rust",
        "//sdk/fidl/fuchsia.net.dhcp:fuchsia.net.dhcp_rust",
        "//sdk/fidl/fuchsia.net.filter:fuchsia.net.filter_rust",
        "//sdk/fidl/fuchsia.net.interfaces.admin:fuchsia.net.interfaces.admin_rust",
        "//sdk/fidl/fuchsia.net.interfaces:fuchsia.net.interfaces_rust",
        "//sdk/fidl/fuchsia.net.name:fuchsia.net.name_rust",
        "//sdk/fidl/fuchsia.net.neighbor:fuchsia.net.neighbor_rust",
        "//sdk/fidl/fuchsia.net.root:fuchsia.net.root_rust",
        "//sdk/fidl/fuchsia.net.routes:fuchsia.net.routes_rust",
        "//sdk/fidl/fuchsia.net.stack:fuchsia.net.stack_rust",
        "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust",
        "//src/developer/lib/writer:lib",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//src/sys/lib/component_debug",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:log",
    ],
)

fx_unittest_package(
    name = "net-cli-tests",
    unit_tests = [":lib_test"],
)

fx_unittest_package(
    name = "net-cli-fdomain-tests",
    unit_tests = [":lib_fdomain_test"],
)
