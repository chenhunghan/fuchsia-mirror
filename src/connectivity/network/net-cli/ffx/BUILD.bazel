load("//src/developer/ffx/build:ffx_plugin.bzl", "ffx_plugin")

package(default_applicable_licenses = ["//:license"])

ffx_plugin(
    name = "ffx_net",
    srcs = ["src/lib.rs"],
    args_deps = [
        "//src/connectivity/network/net-cli:lib_fdomain",
        "//src/developer/ffx/core:lib",
        "//third_party/rust_crates/vendor:argh",
    ],
    args_srcs = ["src/args.rs"],
    edition = "2024",
    proc_macro_deps = ["//third_party/rust_crates/vendor:async-trait"],
    rustc_flags = ["-Dunused_results"],
    sdk_category = "not-yet-specified",
    visibility = ["//src/developer/ffx/frontends/ffx:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.developer.remotecontrol:fuchsia.developer.remotecontrol_rust_fdomain",
        "//sdk/fidl/fuchsia.net.debug:fuchsia.net.debug_rust_fdomain",
        "//sdk/fidl/fuchsia.net.dhcp:fuchsia.net.dhcp_rust_fdomain",
        "//sdk/fidl/fuchsia.net.filter:fuchsia.net.filter_rust_fdomain",
        "//sdk/fidl/fuchsia.net.interfaces.admin:fuchsia.net.interfaces.admin_rust_fdomain",
        "//sdk/fidl/fuchsia.net.interfaces:fuchsia.net.interfaces_rust_fdomain",
        "//sdk/fidl/fuchsia.net.name:fuchsia.net.name_rust_fdomain",
        "//sdk/fidl/fuchsia.net.neighbor:fuchsia.net.neighbor_rust_fdomain",
        "//sdk/fidl/fuchsia.net.root:fuchsia.net.root_rust_fdomain",
        "//sdk/fidl/fuchsia.net.routes:fuchsia.net.routes_rust_fdomain",
        "//sdk/fidl/fuchsia.net.stack:fuchsia.net.stack_rust_fdomain",
        "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust_fdomain",
        "//src/connectivity/network/net-cli:lib_fdomain",
        "//src/developer/ffx/lib/fho:lib",
        "//src/developer/ffx/lib/target/holders:lib",
        "//src/developer/ffx/lib/writer:lib",
        "//src/lib/fdomain/client",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:serde_json",
    ],
)
