load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")
load(
    "//src/lib/testing/sharding/rules:fx_sharded_test_package.bzl",
    "fx_sharded_test_package",
)

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":netlink-integration-tests_test"],
    visibility = ["//src/connectivity/network:__pkg__"],
)

rustc_test(
    name = "netlink_integration_test",
    srcs = ["src/lib.rs"],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    edition = "2024",
    proc_macro_deps = [
        "//src/connectivity/network/tests/integration/macros:netstack_testing_macros",
    ],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//sdk/fidl/fuchsia.net:fuchsia.net_rust",
        "//sdk/fidl/fuchsia.net.interfaces.admin:fuchsia.net.interfaces.admin_rust",
        "//sdk/fidl/fuchsia.net.interfaces:fuchsia.net.interfaces_rust",
        "//sdk/fidl/fuchsia.net.ndp:fuchsia.net.ndp_rust",
        "//sdk/fidl/fuchsia.net.neighbor:fuchsia.net.neighbor_rust",
        "//sdk/fidl/fuchsia.net.root:fuchsia.net.root_rust",
        "//sdk/fidl/fuchsia.net.routes:fuchsia.net.routes_rust",
        "//sdk/fidl/fuchsia.net.sockets:fuchsia.net.sockets_rust",
        "//sdk/fidl/fuchsia.posix.socket:fuchsia.posix.socket_rust",
        "//src/connectivity/lib/net-declare",
        "//src/connectivity/lib/net-types",
        "//src/connectivity/lib/packet-formats",
        "//src/connectivity/network/netlink",
        "//src/connectivity/network/testing/netemul/rust:lib",
        "//src/connectivity/network/tests/integration/common:netstack_testing_common",
        "//src/lib/fdio/rust:fdio",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/network/fidl_fuchsia_net_ext",
        "//src/lib/network/fidl_fuchsia_net_interfaces_ext",
        "//src/lib/network/fidl_fuchsia_net_matchers_ext",
        "//src/lib/network/fidl_fuchsia_net_routes_ext",
        "//src/lib/network/packet",
        "//src/starnix/lib/linux_uapi",
        "//src/starnix/lib/third_party/rust_netlink/netlink_packet_core",
        "//src/starnix/lib/third_party/rust_netlink/netlink_packet_route",
        "//src/starnix/lib/third_party/rust_netlink/netlink_packet_sock_diag",
        "//src/starnix/lib/third_party/rust_netlink/netlink_packet_utils",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:libc",
        "//third_party/rust_crates/vendor:smallvec",
        "//third_party/rust_crates/vendor:socket2",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

fx_packaged_binary(
    name = "netlink_integration_test_packaged",
    testonly = True,
    binary = ":netlink_integration_test",
    binary_name = "netlink_integration_test",
)

fx_sharded_test_package(
    name = "netlink-integration-tests",
    component_name = "netlink-integration-test",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/connectivity/network/tests/integration/common:client.shard",
        "//src/lib/testing/sharding:meta/client.shard",
    ],
    manifest = "meta/netlink-integration-test.cml",
    num_shards = 5,
    # Matches the first `::`-delimited section of the test case name,
    # or the whole name if there are no `::` delimiters.
    shard_part_regex = "([^::]+)(?:::.*)?",
    subpackages = [
        # Netstack3 is under test.
        "//src/connectivity/network/netstack3:package-debug",
        # netemul-sandbox is used to create hermetic test realms.
        "//src/connectivity/network/testing/netemul/service:package",
    ],
    deps = [":netlink_integration_test_packaged"],
)

fx_test(
    name = "netlink-integration-tests_test",
    package = ":netlink-integration-tests",
)
