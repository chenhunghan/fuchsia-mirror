        "//third_party/rust_crates/vendor:thiserror",
    ],
)

fx_packaged_binary(
    name = "netlink_test_packaged",
    testonly = True,
    binary = ":netlink_test",
    binary_name = "netlink_lib_test",
)

fx_component_manifest_with_expectations(
    name = "netlink-lib-test_manifest",
    component_name = "netlink-lib-test-component",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/lib/testing/expectation:meta/client.shard",
    ],
    manifest = "meta/netlink-lib-test.cml",
)

fx_test_component_with_expectations(
    name = "netlink-lib-test-component-no-err-logs",
    compiled_manifest = ":netlink-lib-test_manifest",
    expectations = "expects/expectations.json5",
    treatment_of_cases_with_error_logs = "SKIP_CASES_WITH_ERROR_LOGS",
    deps = [":netlink_test_packaged"],
)

fx_package(
    name = "netlink-lib-test-no-err-logs-package",
    package_name = "netlink-lib-test-no-err-logs",
    test_components = [":netlink-lib-test-component-no-err-logs"],
)

fx_test(
    name = "netlink-lib-test-no-err-logs",
    package = ":netlink-lib-test-no-err-logs-package",
)

fx_test_component_with_expectations(
    name = "netlink-lib-test-component-with-err-logs",
    compiled_manifest = ":netlink-lib-test_manifest",
    expectations = "expects/expectations.json5",
    treatment_of_cases_with_error_logs = "RUN_ONLY_CASES_WITH_ERROR_LOGS",
    deps = [":netlink_test_packaged"],
)

fx_package(
    name = "netlink-lib-test-with-err-logs-package",
    package_name = "netlink-lib-test-with-err-logs",
    test_components = [":netlink-lib-test-component-with-err-logs"],
)

fx_test(
    name = "netlink-lib-test-with-err-logs",
    max_log_severity = "ERROR",
    package = ":netlink-lib-test-with-err-logs-package",
)
