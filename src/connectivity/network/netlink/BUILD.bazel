# This test compiles the library sources directly rather than using
# `crate = ":netlink"`: it links the `testutils` flavor of
# `fidl_fuchsia_net_neighbor_ext`, which has the same crate name as the
# flavor `:netlink` depends on.
rustc_test(
    name = "netlink_test",
    srcs = [
        "src/client.rs",
        "src/interfaces.rs",
        "src/lib.rs",
        "src/logging.rs",
        "src/messaging.rs",
        "src/multicast_groups.rs",
        "src/nduseropt.rs",
        "src/neighbors.rs",
        "src/netlink_packet.rs",
        "src/protocol_family.rs",
        "src/protocol_family/sock_diag.rs",
        "src/protocol_family/sock_diag/eventloop.rs",
        "src/protocol_family/sock_diag/request.rs",
        "src/route_eventloop.rs",
        "src/route_tables.rs",
        "src/routes.rs",
        "src/rules.rs",
        "src/rules/conversions.rs",
        "src/util.rs",
    ],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    # Matches the binary path in `meta/netlink-lib-test.cml`.
    crate_name = "netlink_lib_test",
    edition = "2024",
    proc_macro_deps = [
        "//src/connectivity/lib/ip-test-macro",
        "//third_party/rust_crates/vendor:derivative",
        "//third_party/rust_crates/vendor:proptest-derive",
    ],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//sdk/fidl/fuchsia.net:fuchsia.net_rust",
        "//sdk/fidl/fuchsia.net.interfaces.admin:fuchsia.net.interfaces.admin_rust",
        "//sdk/fidl/fuchsia.net.interfaces:fuchsia.net.interfaces_rust",
        "//sdk/fidl/fuchsia.net.matchers:fuchsia.net.matchers_rust",
        "//sdk/fidl/fuchsia.net.ndp:fuchsia.net.ndp_rust",
        "//sdk/fidl/fuchsia.net.neighbor:fuchsia.net.neighbor_rust",
        "//sdk/fidl/fuchsia.net.resources:fuchsia.net.resources_rust",
        "//sdk/fidl/fuchsia.net.root:fuchsia.net.root_rust",
        "//sdk/fidl/fuchsia.net.routes.admin:fuchsia.net.routes.admin_rust",
        "//sdk/fidl/fuchsia.net.routes:fuchsia.net.routes_rust",
        "//sdk/fidl/fuchsia.net.sockets:fuchsia.net.sockets_rust",
        "//sdk/fidl/fuchsia.net.tcp:fuchsia.net.tcp_rust",
        "//sdk/fidl/fuchsia.net.udp:fuchsia.net.udp_rust",
        "//src/connectivity/lib/fidl_fuchsia_net_neighbor_ext:fidl_fuchsia_net_neighbor_ext_testutils",
        "//src/connectivity/lib/net-declare",
        "//src/connectivity/lib/net-types",
        "//src/connectivity/lib/packet-formats",
        "//src/connectivity/network/lib/oneshot-sync",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-sync",
        "//src/lib/network/fidl_fuchsia_net_ext",
        "//src/lib/network/fidl_fuchsia_net_interfaces_ext",
        "//src/lib/network/fidl_fuchsia_net_matchers_ext",
        "//src/lib/network/fidl_fuchsia_net_ndp_ext",
        "//src/lib/network/fidl_fuchsia_net_routes_ext",
        "//src/lib/network/fidl_fuchsia_net_sockets_ext",
        "//src/lib/network/packet",
        "//src/lib/proptest-support",
        "//src/starnix/lib/linux_uapi",
        "//src/starnix/lib/third_party/rust_netlink/netlink_packet_core",
        "//src/starnix/lib/third_party/rust_netlink/netlink_packet_route",
        "//src/starnix/lib/third_party/rust_netlink/netlink_packet_sock_diag",
        "//src/starnix/lib/third_party/rust_netlink/netlink_packet_utils",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:bit-set",
        "//third_party/rust_crates/vendor:either",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:itertools",
        "//third_party/rust_crates/vendor:libc",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:maplit",
        "//third_party/rust_crates/vendor:pretty_assertions",
