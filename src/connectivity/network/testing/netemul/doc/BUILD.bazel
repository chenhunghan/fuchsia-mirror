load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":netemul-example-tests"],
    visibility = ["//src/connectivity/network:__pkg__"],
)

fx_packaged_binary(
    name = "sandbox-test_packaged",
    testonly = True,
    binary = "//src/connectivity/network/testing/netemul/doc/sandbox-test",
    binary_name = "sandbox_test",
)

fx_component_manifest(
    name = "example-sandbox-test_manifest",
    testonly = True,
    component_name = "example-sandbox-test",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/connectivity/network/tests/integration/common:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "//src/connectivity/network/testing/netemul/doc/sandbox-test:meta/sandbox-test.cml",
)

fx_test_component(
    name = "example-sandbox-test",
    compiled_manifest = ":example-sandbox-test_manifest",
    deps = [":sandbox-test_packaged"],
)

fx_packaged_binary(
    name = "client_packaged",
    testonly = True,
    binary = "//src/connectivity/network/testing/netemul/doc/runner-test:client",
    binary_name = "netemul_runner_test_driver",
)

fx_component_manifest(
    name = "client-component_manifest",
    testonly = True,
    component_name = "client",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/connectivity/network/testing/netemul/sync-manager/meta:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "//src/connectivity/network/testing/netemul/doc/runner-test:meta/client.cml",
)

fx_component(
    name = "client-component",
    testonly = True,
    compiled_manifest = ":client-component_manifest",
    deps = [":client_packaged"],
)

fx_packaged_binary(
    name = "server_packaged",
    testonly = True,
    binary = "//src/connectivity/network/testing/netemul/doc/runner-test:server",
    binary_name = "netemul_runner_test_server",
)

fx_component_manifest(
    name = "server-component_manifest",
    testonly = True,
    component_name = "server",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/connectivity/network/testing/netemul/sync-manager/meta:client.shard",
    ],
    manifest = "//src/connectivity/network/testing/netemul/doc/runner-test:meta/server.cml",
)

fx_component(
    name = "server-component",
    testonly = True,
    compiled_manifest = ":server-component_manifest",
    deps = [":server_packaged"],
)

fx_component_manifest(
    name = "example-runner-test_manifest",
    testonly = True,
    component_name = "example-runner-test",
    includes = [
        "//sdk/lib/inspect:offer.shard",
        "//sdk/lib/syslog:offer.shard",
        "//src/connectivity/network/testing/netemul/runner:default.shard",
    ],
    manifest = "//src/connectivity/network/testing/netemul/doc/runner-test:meta/runner-test.cml",
)

fx_test_component(
    name = "example-runner-test",
    compiled_manifest = ":example-runner-test_manifest",
)

fx_package(
    name = "netemul-example-tests_package",
    package_name = "netemul-example-tests",
    components = [
        ":client-component",
        ":server-component",
    ],
    subpackages = [
        "//src/connectivity/network/netstack3:package-debug",
        "//src/connectivity/network/testing/netemul/configurable-netstack",
        "//src/connectivity/network/testing/netemul/service:package",
        "//src/connectivity/network/testing/netemul/sync-manager",
    ],
    test_components = [
        ":example-runner-test",
        ":example-sandbox-test",
    ],
)

fx_test(
    name = "netemul-example-tests",
    package = ":netemul-example-tests_package",
)
