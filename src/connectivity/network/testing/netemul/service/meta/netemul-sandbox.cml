{
    include: [ "//src/connectivity/network/testing/netemul/service/meta/common.shard.cml" ],
    program: {
        runner: "elf",
        binary: "bin/netemul_sandbox",
    },
    capabilities: [
        { protocol: "fuchsia.netemul.Sandbox" },
    ],
    use: [
        {
            protocol: "fuchsia.component.Realm",
            from: "parent",
        },
        {
            directory: "pkg",
            from: "parent",
            rights: [ "rx*" ],
            path: "/parent_pkg",
        },
    ],
    expose: [
        {
            protocol: "fuchsia.netemul.Sandbox",
            from: "self",
        },
        {
            protocol: "fuchsia.net.tun.Control",
            from: "#network-tun",
        },
        {
            protocol: "fuchsia.netemul.network.NetworkContext",
            from: "#network-context",
        },
        {
            directory: "custom_artifacts",
            from: "self",
        },
    ],
}
