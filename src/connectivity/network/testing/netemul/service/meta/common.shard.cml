{
    include: [
        "syslog/client.shard.cml",
        "trace/client.shard.cml",
    ],
    children: [
        {
            name: "network-context",
            url: "network-context#meta/network-context.cm",
        },
        {
            name: "network-tun",
            url: "network-tun#meta/network-tun.cm",
        },
    ],
    capabilities: [
        {
            directory: "custom_artifacts",
            rights: [ "rw*" ],
            path: "/custom_artifacts",
        },
    ],
    use: [
        {
            protocol: "fuchsia.netemul.network.NetworkContext",
            from: "#network-context",
        },
        {
            storage: "custom_artifacts",
            path: "/custom_artifacts",
        },
        {
            event_stream: "stopped",
            from: "parent",
            path: "/events/stopped",
        },
    ],
    offer: [
        {
            storage: "custom_artifacts",
            from: "parent",
            to: "#network-context",
        },
        {
            protocol: "fuchsia.net.tun.Control",
            from: "#network-tun",
            to: "#network-context",
        },
        {
            dictionary: "diagnostics",
            from: "parent",
            to: [
                "#network-context",
                "#network-tun",
            ],
        },
    ],
}
