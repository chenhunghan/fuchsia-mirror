{
    include: [
        "//src/connectivity/network/testing/netemul/service/meta/collection.shard.cml",
        "syslog/client.shard.cml",
    ],
    children: [
        {
            name: "sandbox",
            url: "netemul-sandbox#meta/netemul-sandbox.cm",
        },
        {
            name: "realm_builder_server",
            url: "netemul-sandbox#meta/realm_builder_server.cm",
        },
    ],
    use: [
        {
            protocol: "fuchsia.netemul.Sandbox",
            from: "#sandbox",
        },
    ],
    offer: [
        {
            protocol: "fuchsia.component.Realm",
            from: "framework",
            to: "#sandbox",
        },
        {
            directory: "pkg",
            from: "framework",
            to: "#sandbox",
            rights: [ "rx*" ],
        },
        {
            protocol: [
                "fuchsia.process.Launcher",
                "fuchsia.tracing.provider.Registry",
            ],
            from: "parent",
            to: "#sandbox",
        },
        {
            protocol: [
                "fuchsia.net.tun.Control",
                "fuchsia.netemul.network.NetworkContext",
            ],
            from: "#sandbox",
            to: "#netemul",
        },
        {
            directory: "custom_artifacts",
            from: "#sandbox",
            to: "#netemul",
        },
        {
            dictionary: "diagnostics",
            from: "parent",
            to: "#sandbox",
        },
        {
            storage: [
                "cache",
                "custom_artifacts",
                "data",
                "tmp",
            ],
            from: "parent",
            to: "#sandbox",
        },
        {
            event_stream: "stopped",
            from: "parent",
            to: "#sandbox",
        },
    ],
}
