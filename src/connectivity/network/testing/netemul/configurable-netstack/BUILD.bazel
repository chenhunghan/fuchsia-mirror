load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load(
    "//build/bazel/rules/testing:fx_unittest_package.bzl",
    "fx_unittest_package",
)

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":configurable-netstack-unit-tests"],
    visibility = ["//src/connectivity/network:__pkg__"],
)

rustc_binary(
    name = "bin",
    testonly = True,
    srcs = ["src/main.rs"],
    binary_name = "configurable_netstack",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate_name = "configurable_netstack",
    edition = "2024",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//sdk/fidl/fuchsia.hardware.network:fuchsia.hardware.network_rust",
        "//sdk/fidl/fuchsia.net:fuchsia.net_rust",
        "//sdk/fidl/fuchsia.net.interfaces.admin:fuchsia.net.interfaces.admin_rust",
        "//sdk/fidl/fuchsia.net.interfaces:fuchsia.net.interfaces_rust",
        "//sdk/fidl/fuchsia.net.resources:fuchsia.net.resources_rust",
        "//src/connectivity/lib/net-types",
        "//src/connectivity/network/testing/netemul/fidl:fuchsia.netemul_rust",
        "//src/lib/async-utils",
        "//src/lib/diagnostics/log/rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//src/lib/network/fidl_fuchsia_net_ext",
        "//src/lib/network/fidl_fuchsia_net_interfaces_ext",
        "//src/lib/network/fidl_fuchsia_net_routes_ext",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures-util",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

rustc_test(
    name = "configurable_netstack_bin_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":bin",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = ["//third_party/rust_crates/vendor:assert_matches"],
)

fx_packaged_binary(
    name = "bin_packaged",
    testonly = True,
    binary = ":bin",
    binary_name = "configurable_netstack",
)

fx_component_manifest(
    name = "configurable-netstack_manifest",
    testonly = True,
    component_name = "configurable-netstack",
    includes = [
        "//sdk/lib/inspect:offer.shard",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/configurable-netstack.cml",
)

fx_component(
    name = "component",
    testonly = True,
    compiled_manifest = ":configurable-netstack_manifest",
    deps = [":bin_packaged"],
)

fx_package(
    name = "configurable-netstack",
    testonly = True,
    components = [":component"],
    subpackages = ["//src/connectivity/network/netstack3:package-debug"],
    visibility = ["//src/connectivity/network:__subpackages__"],
)

fx_unittest_package(
    name = "configurable-netstack-unit-tests",
    unit_tests = [":configurable_netstack_bin_test"],
)
