load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":configurable-netstack-tests"],
    visibility = ["//src/connectivity/network:__pkg__"],
)

rustc_library(
    name = "lib",
    testonly = True,
    srcs = ["src/lib.rs"],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate_name = "configurable_netstack_test",
    edition = "2024",
    deps = ["//src/connectivity/lib/net-declare"],
)

rustc_test(
    name = "configurable_netstack_test_client",
    srcs = ["src/client.rs"],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    edition = "2024",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        ":lib",
        "//sdk/fidl/fuchsia.net:fuchsia.net_rust",
        "//sdk/fidl/fuchsia.net.interfaces.admin:fuchsia.net.interfaces.admin_rust",
        "//sdk/fidl/fuchsia.net.interfaces:fuchsia.net.interfaces_rust",
        "//sdk/fidl/fuchsia.net.root:fuchsia.net.root_rust",
        "//sdk/fidl/fuchsia.net.routes:fuchsia.net.routes_rust",
        "//src/connectivity/lib/net-declare",
        "//src/connectivity/lib/net-types",
        "//src/connectivity/network/testing/netemul/sync-manager/rust:lib",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//src/lib/network/fidl_fuchsia_net_interfaces_ext",
        "//src/lib/network/fidl_fuchsia_net_routes_ext",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:futures-util",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

rustc_binary(
    name = "server",
    testonly = True,
    srcs = ["src/server.rs"],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    edition = "2024",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        ":lib",
        "//src/connectivity/network/testing/netemul/sync-manager/rust:lib",
        "//src/lib/diagnostics/log/rust",
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:log",
    ],
)

fx_packaged_binary(
    name = "client_packaged",
    testonly = True,
    binary = ":configurable_netstack_test_client",
    binary_name = "configurable_netstack_test_client",
)

fx_packaged_binary(
    name = "server_packaged",
    testonly = True,
    binary = ":server",
    binary_name = "server",
)

fx_component_manifest(
    name = "client_manifest",
    testonly = True,
    component_name = "client",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/connectivity/network/testing/netemul/sync-manager/meta:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/client.cml",
)

fx_component(
    name = "client-component",
    testonly = True,
    compiled_manifest = ":client_manifest",
    deps = [":client_packaged"],
)

fx_component_manifest(
    name = "server_manifest",
    testonly = True,
    component_name = "server",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/connectivity/network/testing/netemul/sync-manager/meta:client.shard",
    ],
    manifest = "meta/server.cml",
)

fx_component(
    name = "server-component",
    testonly = True,
    compiled_manifest = ":server_manifest",
    deps = [":server_packaged"],
)

fx_component_manifest(
    name = "configurable-netstack-test_manifest",
    testonly = True,
    component_name = "configurable-netstack-test",
    includes = [
        "//sdk/lib/inspect:offer.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/connectivity/network/testing/netemul/runner:default.shard",
    ],
    manifest = "meta/configurable-netstack-test.cml",
)

fx_test_component(
    name = "configurable-netstack-test",
    compiled_manifest = ":configurable-netstack-test_manifest",
)

fx_package(
    name = "configurable-netstack-tests_package",
    package_name = "configurable-netstack-tests",
    components = [
        ":client-component",
        ":server-component",
    ],
    subpackages = [
        "//src/connectivity/network/testing/netemul/configurable-netstack",
        "//src/connectivity/network/testing/netemul/sync-manager",
    ],
    test_components = [":configurable-netstack-test"],
)

fx_test(
    name = "configurable-netstack-tests",
    package = ":configurable-netstack-tests_package",
)
