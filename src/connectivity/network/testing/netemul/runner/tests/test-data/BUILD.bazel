load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load(
    "//build/bazel/rules/packages:resources.bzl",
    "fuchsia_package_resource_collection",
)

package(default_applicable_licenses = ["//:license"])

fx_packaged_binary(
    name = "elf_packaged_bin",
    testonly = True,
    binary = "//src/connectivity/network/testing/netemul/runner/tests/test-data/elf",
    binary_name = "elf_test",
)

fx_component_manifest(
    name = "elf-test-driver_manifest",
    testonly = True,
    component_name = "elf-test-driver",
    includes = [
        "//sdk/lib/sys/testing:elf_test_runner.shard.cml",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "//src/connectivity/network/testing/netemul/runner/tests/test-data/elf:meta/test-driver.cml",
)

fx_component(
    name = "elf-test-driver",
    testonly = True,
    compiled_manifest = ":elf-test-driver_manifest",
    # TODO(https://fxbug.dev/570694755): bazel2gn only unwraps fx_packaged_binary
    # targets defined in the same package.
    deps = [
        ":elf_packaged_bin",  # @bazel2gn:path_overwrite://src/connectivity/network/testing/netemul/runner/tests/test-data/elf
    ],
)

fx_component_manifest(
    name = "elf-test_manifest",
    testonly = True,
    component_name = "elf-test",
    includes = [
        "//sdk/lib/inspect:offer.shard",
        "//sdk/lib/syslog:offer.shard",
        "//src/connectivity/network/testing/netemul/runner:default.shard",
    ],
    manifest = "//src/connectivity/network/testing/netemul/runner/tests/test-data/elf:meta/test-root.cml",
)

fx_component(
    name = "elf-test",
    testonly = True,
    compiled_manifest = ":elf-test_manifest",
    deps = [":elf-test-driver"],
)

fx_packaged_binary(
    name = "gtest_packaged_bin",
    testonly = True,
    binary = "//src/connectivity/network/testing/netemul/runner/tests/test-data/gtest",
    binary_name = "gtest",
)

fx_component_manifest(
    name = "gtest-test-driver_manifest",
    testonly = True,
    component_name = "gtest-test-driver",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/gtest:default.shard.cml",
    ],
    manifest = "//src/connectivity/network/testing/netemul/runner/tests/test-data/gtest:meta/test-driver.cml",
)

fx_component(
    name = "gtest-test-driver",
    testonly = True,
    compiled_manifest = ":gtest-test-driver_manifest",
    deps = [
        ":gtest_packaged_bin",  # @bazel2gn:path_overwrite://src/connectivity/network/testing/netemul/runner/tests/test-data/gtest
    ],
)

fx_component_manifest(
    name = "gtest-test_manifest",
    testonly = True,
    component_name = "gtest-test",
    includes = [
        "//sdk/lib/inspect:offer.shard",
        "//sdk/lib/syslog:offer.shard",
        "//src/connectivity/network/testing/netemul/runner:default.shard",
    ],
    manifest = "//src/connectivity/network/testing/netemul/runner/tests/test-data/gtest:meta/test-root.cml",
)

fx_component(
    name = "gtest-test",
    testonly = True,
    compiled_manifest = ":gtest-test_manifest",
    deps = [":gtest-test-driver"],
)

fx_packaged_binary(
    name = "rust_packaged_bin",
    testonly = True,
    binary = "//src/connectivity/network/testing/netemul/runner/tests/test-data/rust",
    binary_name = "rust_test",
)

fx_component_manifest(
    name = "rust-test-driver_manifest",
    testonly = True,
    component_name = "rust-test-driver",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "//src/connectivity/network/testing/netemul/runner/tests/test-data/rust:meta/test-driver.cml",
)

fx_component(
    name = "rust-test-driver",
    testonly = True,
    compiled_manifest = ":rust-test-driver_manifest",
    deps = [
        ":rust_packaged_bin",  # @bazel2gn:path_overwrite://src/connectivity/network/testing/netemul/runner/tests/test-data/rust
    ],
)

fx_component_manifest(
    name = "rust-test_manifest",
    testonly = True,
    component_name = "rust-test",
    includes = [
        "//sdk/lib/inspect:offer.shard",
        "//sdk/lib/syslog:offer.shard",
        "//src/connectivity/network/testing/netemul/runner:default.shard",
    ],
    manifest = "//src/connectivity/network/testing/netemul/runner/tests/test-data/rust:meta/test-root.cml",
)

fx_component(
    name = "rust-test",
    testonly = True,
    compiled_manifest = ":rust-test_manifest",
    deps = [":rust-test-driver"],
)

fuchsia_package_resource_collection(
    name = "test-data",
    testonly = True,
    resources = [
        ":elf-test",
        ":gtest-test",
        ":rust-test",
        "//src/connectivity/network/testing/netemul/runner/tests/test-data/invalid",
    ],
    visibility = ["//src/connectivity/network/testing/netemul/runner/tests:__pkg__"],
)
