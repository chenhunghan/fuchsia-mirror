import("//build/bazel/bazel_test_suite.gni")
import("//build/testing/host_test_data.gni")
import("//src/developer/ffx/build/ffx_tool.gni")

assert(is_host, "bazel_ffx_tool() can only be called in a host toolchain.")

bazel_ffx_tool("ffx_net_test_realm_tool") {
  output_name = "ffx-net-test-realm"
}

host_test_data("ffx_net_test_realm_tool_test_data") {
  visibility = [ "//src/connectivity/network/testing/conformance/emulator:*" ]
  data_deps = [ ":ffx_net_test_realm_tool_host_tool" ]
  sources = [
    "${host_tools_dir}/ffx-net-test-realm",
    "${host_tools_dir}/ffx-net-test-realm.json",
  ]
}

bazel_test_suite("bazel_tests") {
  host_tests = [ "//src/connectivity/network/testing/network-test-realm/ffx:ffx_net_test_realm_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":bazel_tests" ]
}
