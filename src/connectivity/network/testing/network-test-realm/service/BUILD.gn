fuchsia_component_manifest("hermetic_network_manifest") {
  testonly = true
  component_name = "hermetic_network"
  manifest = "meta/hermetic_network.cml"
}

fuchsia_component("hermetic_network") {
  testonly = true
  cm_label = ":hermetic_network_manifest"
}

fuchsia_component_manifest("controller_manifest") {
  testonly = true
  component_name = "controller"
  manifest = "meta/controller.cml"
}

fuchsia_component("controller") {
  testonly = true
  cm_label = ":controller_manifest"
  deps = [
    ":bin",
    ":hermetic_network",
  ]
}
