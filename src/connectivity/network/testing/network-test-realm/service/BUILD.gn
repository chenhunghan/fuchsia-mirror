rustc_library("network_test_realm") {
  sources = [ "src/lib.rs" ]
  configs += [ "//build/config/rust/lints:deny_unused_results" ]
  edition = "2024"
  visibility = [
    ":*",
    "//src/connectivity/network/net-cli/tests:*",
