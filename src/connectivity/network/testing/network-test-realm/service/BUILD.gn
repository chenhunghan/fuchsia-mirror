import("//build/components.gni")

# Kept in GN because :network-test-realm has non-assembly GN callers and
# subpackages GN-only packages.
fuchsia_package("network-test-realm") {
  package_name = "network-test-realm"
  deps = [ ":controller" ]
  subpackages = [
    "//src/connectivity/network/dhcpv4/client/bindings:package",
    "//src/connectivity/network/dhcpv4/server:package",
    "//src/connectivity/network/dhcpv6/client:package",
    "//src/connectivity/network/dns:package",
    "//src/connectivity/network/netstack3:package-conformance",
    "//src/connectivity/network/testing/network-test-realm/tests/unreliable-echo:package",
  ]
  testonly = true
}

