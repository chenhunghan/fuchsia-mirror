import("//build/components.gni")

# TODO(https://fxbug.dev/570694755): Migrate this target to
# bazel_fuchsia_package once binary size increase from shared library
# duplication between Bazel and GN packages is addressed. Using the Bazel
# package duplicates libasync-default.so, libbackend_fuchsia_globals.so,
# libdriver_runtime.so, libfdio.so, libsvc.so, and libtrace-engine.so in
# BlobFS.
fuchsia_package("network-tun") {
  deps = [ ":component" ]
}

group("tests") {
  testonly = true
  deps = [ ":network-tun-test" ]
}

