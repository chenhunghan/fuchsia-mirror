source_set("src") {
  sources = [
    "buffer.cc",
    "config.cc",
    "device_adapter.cc",
    "mac_adapter.cc",
    "port_adapter.cc",
    "state.cc",
    "tun_ctl.cc",
    "tun_device.cc",
    "tun_pair.cc",
  ]
  public = [
    "buffer.h",
    "config.h",
    "device_adapter.h",
    "mac_adapter.h",
    "port_adapter.h",
    "state.h",
    "tun_ctl.h",
    "tun_device.h",
    "tun_pair.h",
  ]
  public_deps = [
    "//sdk/fidl/fuchsia.hardware.network:fuchsia.hardware.network_cpp",
    "//sdk/fidl/fuchsia.hardware.network.driver:fuchsia.hardware.network.driver_cpp",
    "//sdk/fidl/fuchsia.net.tun:fuchsia.net.tun_cpp",
    "//sdk/lib/async:async-cpp",
    "//sdk/lib/async-loop:async-loop-cpp",
    "//sdk/lib/async-loop:async-loop-default",
    "//sdk/lib/fit",
    "//sdk/lib/syslog/cpp",
    "//src/connectivity/network/drivers/network-device/device",
    "//src/connectivity/network/drivers/network-device/mac",
    "//src/lib/fsl",
    "//src/lib/vmo_store",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/svc",
    "//zircon/system/ulib/sync:sync-cpp",
  ]
}

executable("bin") {
  sources = [
    "main.cc",
    "minimal_driver_runtime.cc",
    "minimal_driver_runtime.h",
  ]
  output_name = "network_tun"
  deps = [
    ":src",
    "//sdk/lib/driver/runtime:driver_runtime_env_cpp",
    "//src/devices/bin/driver_runtime",
  ]
}

fuchsia_component_manifest("manifest") {
  component_name = "network-tun"
  manifest = "meta/network-tun.cml"
}

fuchsia_component("component") {
  cm_label = ":manifest"
  deps = [ ":bin" ]
}

cc_test_executable("network_tun_unittest") {
  sources = [
    "buffer_unittest.cc",
    "network_tun_unittest.cc",
  ]
  deps = [
    ":src",
    "//sdk/lib/driver/testing/cpp",
    "//src/lib/fxl/test:gtest_main",
    "//src/lib/testing/loop_fixture",
    "//src/lib/testing/predicates",
    "//third_party/googletest:gtest",
    "//zircon/system/ulib/fzl",
  ]
  testonly = true
  emit_tool_path = false
}

fuchsia_unittest_package("network-tun-test") {
  package_name = "network-tun-test-gn"
  component_name = "network-tun-test"
  deps = [ ":network_tun_unittest" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
