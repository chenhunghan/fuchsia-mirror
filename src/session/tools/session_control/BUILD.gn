import("//build/bazel/bazel_fuchsia_package.gni")

# The package is defined as `fx_package` in BUILD.bazel. This GN wrapper is
# kept because `//src/session/tools:tools` (built by `//src/session`) still
# depends on `:session_control` in GN.
# TODO(https://fxbug.dev/570694755): Remove once //src/session/tools drops GN.
bazel_fuchsia_package("session_control") {
  bazel_config = "fuchsia_platform"
  package_name = "session_control"
}
