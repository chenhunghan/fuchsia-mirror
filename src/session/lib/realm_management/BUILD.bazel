load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":realm_management_tests"],
    visibility = ["//src/session:__pkg__"],
)

rustc_library(
    name = "realm_management",
    srcs = ["src/lib.rs"],
    edition = "2024",
    visibility = ["//src/session:__subpackages__"],
    deps = [
        "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust",
        "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//src/lib/fidl/rust/fidl",
    ],
)

rustc_test(
    name = "realm_management_test",
    crate = ":realm_management",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//src/lib/fdio/rust:fdio",
        "//src/lib/fidl/rust/fidl_test_util",
        "//src/lib/fuchsia",
        "//src/lib/test_util",
        "//src/session/testing",
    ],
)

fx_unittest_package(
    name = "realm_management_tests",
    unit_tests = [":realm_management_test"],
)
