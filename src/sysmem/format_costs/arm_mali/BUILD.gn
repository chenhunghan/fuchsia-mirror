import("//build/tools/bazel2gn/bazel_migration.gni")

if (is_host) {
  rustc_binary("generate_format_costs_arm_mali") {
    sources = [ "src/main.rs" ]
    configs += [ "//build/config/rust/lints:deny_unused_results" ]
    edition = "2024"
    visibility = [ ":*" ]
    deps = [
      "//sdk/fidl/fuchsia.images2:fuchsia.images2_rust_common",
      "//sdk/fidl/fuchsia.sysmem2:fuchsia.sysmem2_rust_common",
      "//src/lib/fidl/rust/fidl",
      "//third_party/rust_crates:anyhow",
      "//third_party/rust_crates:argh",
      "//third_party/rust_crates:camino",
    ]
  }
}

compiled_action("arm_mali") {
  outputs = [ "$target_out_dir/arm_mali.format_costs_persistent_fidl" ]
  args = [
    "--output",
    rebase_path("$target_out_dir/arm_mali.format_costs_persistent_fidl",
                root_build_dir),
  ]
  tool = ":generate_format_costs_arm_mali"
  visibility = [
    ":*",
    "//boards/*",
    "//src/sysmem/*",
    "//vendor/google/*",
  ]
}
