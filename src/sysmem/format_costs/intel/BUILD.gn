import("//build/tools/bazel2gn/bazel_migration.gni")

if (is_host) {
  rustc_binary("generate_format_costs_intel") {
    sources = [ "src/main.rs" ]
    configs += [ "//build/config/rust/lints:deny_unused_results" ]
    edition = "2024"
    visibility = [ ":*" ]
    deps = [
      "//sdk/fidl/fuchsia.images2:fuchsia.images2_rust",
      "//sdk/fidl/fuchsia.sysmem2:fuchsia.sysmem2_rust",
      "//src/lib/fidl/rust/fidl",
      "//third_party/rust_crates:anyhow",
      "//third_party/rust_crates:argh",
      "//third_party/rust_crates:camino",
    ]
  }
}
