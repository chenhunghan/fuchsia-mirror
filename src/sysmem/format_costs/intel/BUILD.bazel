load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules:compiled_action.bzl", "compiled_action")
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

# the binary expects a single arg which is the path of the output file
rustc_binary(
    name = "generate_format_costs_intel",
    srcs = ["src/main.rs"],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//visibility:private"],
    deps = [
        "//sdk/fidl/fuchsia.images2:fuchsia.images2_rust",
        "//sdk/fidl/fuchsia.sysmem2:fuchsia.sysmem2_rust",
        "//src/lib/fidl/rust/fidl",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:camino",
    ],
)

# these format_costs are not strictly required to be included via assembly tool,
# but the sysmem tests rely on these or similar format costs for the tests to
# pass
#
# GN consumers (//build/assembly/board_input_bundle.gni and //src/sysmem/server)
# read this output from $target_out_dir, whereas bazel2gn defaults compiled_action
# outputs to $target_gen_dir, and shac check bazel_migration_bazel2gn_overwrites
# disallows bazel2gn overwrites to $target_out_dir without an allowlist entry.
# Keep compiled_action("intel") above the bazel2gn sentinel in BUILD.gn.
# @bazel2gn:skip
compiled_action(
    name = "intel",
    outs = ["intel.format_costs_persistent_fidl"],
    args = [
        "--output",
        "$(location :intel.format_costs_persistent_fidl)",
    ],
    tool = ":generate_format_costs_intel",
    visibility = [
        "//boards/x64:__pkg__",
        "//src/sysmem:__subpackages__",
    ],
)
