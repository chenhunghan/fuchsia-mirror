import("//build/bazel/bazel_test_suite.gni")

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    "server:tests",
    "tests/sysmem:sysmem-test-v1",
    "tests/sysmem:sysmem-test-v2",
    "tests/sysmem/fuzz",
    "tools:tests",
  ]
}

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/sysmem:target_tests" ]
}

group("tools") {
  deps = [ "tools" ]
}

group("metrics") {
  deps = [ "metrics" ]
}
