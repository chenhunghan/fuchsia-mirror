import("//build/bazel/bazel_test_suite.gni")

group("recovery") {
  testonly = true
  deps = [
    ":e2e_tests",
    ":recovery_no_e2e",
  ]
}

group("recovery_no_e2e") {
  testonly = true
  assert_no_deps = e2e_test_libs

  deps = [
    ":tests_no_e2e",
    "system",
  ]
}

group("tests_no_e2e") {
  testonly = true
  assert_no_deps = e2e_test_libs

  deps = [
    ":bazel_tests",
    "integration:tests",
    "lib:tests",
    "system:tests",
  ]
}

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/recovery:target_tests" ]
}

group("e2e_tests") {
  testonly = true
  deps = [ "simulator:tests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":e2e_tests",
    ":tests_no_e2e",
  ]
}
