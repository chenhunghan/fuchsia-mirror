import("//build/bazel/bazel_fuchsia_package.gni")

# //bundles/tools:tools and //sdk/bundles:tools still depend on :tools from GN.
bazel_fuchsia_package("fdr_cli") {
  bazel_config = "fuchsia_platform"
}

group("tools") {
  deps = [ ":fdr_cli" ]
}

# Downstream vendor test bundles still use this from GN.
group("factory_reset_tests") {
  testonly = true
  deps = [ ":factory_reset_tests_pkg" ]
}

