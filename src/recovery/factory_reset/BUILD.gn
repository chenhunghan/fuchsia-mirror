source_set("lib") {
  sources = [ "factory_reset.cc" ]
  public = [ "factory_reset.h" ]
  deps = [
    "//sdk/lib/component/incoming/cpp",
    "//sdk/lib/fdio",
    "//sdk/lib/syslog/cpp",
    "//src/security/lib/kms-stateless",
    "//zircon/system/ulib/zx",
  ]
  visibility = [ ":*" ]
  public_deps = [
    "//sdk/fidl/fuchsia.fshost:fuchsia.fshost_cpp",
    "//sdk/fidl/fuchsia.hardware.power.statecontrol:fuchsia.hardware.power.statecontrol_cpp",
    "//sdk/fidl/fuchsia.recovery:fuchsia.recovery_cpp",
  ]
}

executable("bin") {
  sources = [ "main.cc" ]
  output_name = "factory_reset"
  deps = [
    ":lib",
    "//sdk/fidl/fuchsia.io:fuchsia.io_cpp",
    "//sdk/lib/async-loop:async-loop-cpp",
    "//sdk/lib/async-loop:async-loop-default",
    "//sdk/lib/component/incoming/cpp",
    "//sdk/lib/component/outgoing/cpp",
  ]
}

executable("fdr") {
  sources = [ "cli_main.cc" ]
  deps = [
    "//sdk/fidl/fuchsia.recovery:fuchsia.recovery_cpp",
    "//sdk/lib/component/incoming/cpp",
  ]
}

fuchsia_component_manifest("manifest") {
  component_name = "factory_reset"
  manifest = "meta/factory_reset.cml"
}

fuchsia_component("factory_reset_component") {
  cm_label = ":manifest"
  deps = [ ":bin" ]
}

cc_test_executable("factory_reset_unittests") {
  sources = [ "factory_reset_unittest.cc" ]
  deps = [
    ":lib",
    "//sdk/fidl/fuchsia.device:fuchsia.device_cpp",
    "//sdk/fidl/fuchsia.fshost:fuchsia.fshost_cpp_testing",
    "//sdk/fidl/fuchsia.hardware.power.statecontrol:fuchsia.hardware.power.statecontrol_cpp_testing",
    "//sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_cpp",
    "//sdk/lib/async-loop:async-loop-cpp",
    "//sdk/lib/async-loop:async-loop-default",
    "//sdk/lib/component/incoming/cpp",
    "//sdk/lib/fdio-caller",
    "//src/lib/fxl/test:gtest_main",
    "//src/lib/testing/loop_fixture",
    "//src/storage/lib/block_client/cpp",
    "//third_party/googletest:gtest",
    "//zircon/system/ulib/fbl",
  ]
  testonly = true
  emit_tool_path = false
}

fuchsia_unittest_component("factory_reset_tests_component") {
  deps = [ ":factory_reset_unittests" ]
  component_name = "factory_reset_tests_pkg"
}

fuchsia_test_package("factory_reset_tests_pkg") {
  package_name = "factory_reset_tests_pkg-gn"
  test_components = [ ":factory_reset_tests_component" ]
  test_specs = {
    environments = [
      astro_env,
      emu_env,
    ]
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
