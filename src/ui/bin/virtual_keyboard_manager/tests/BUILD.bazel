load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")
load(
    "//build/bazel/rules/testing:fx_unittest_component.bzl",
    "fx_unittest_component",
)

package(default_applicable_licenses = ["//:license"])

# Aggregated into //src/ui:target_tests.
test_suite(
    name = "tests",
    tests = [":virtual_keyboard_tests"],
    visibility = ["//src/ui:__pkg__"],
)

fx_unittest_component(
    name = "focus_dispatcher_unittests",
    binary = ":focus_dispatcher_unittests_bin",
)

fx_unittest_component(
    name = "virtual_keyboard_unittests",
    binary = ":virtual_keyboard_unittests_bin",
)

fx_package(
    name = "virtual_keyboard_tests_package",
    package_name = "virtual_keyboard_tests",
    testonly = True,
    test_components = [
        ":virtual_keyboard_unittests",
        ":focus_dispatcher_unittests",
    ],
)

fx_test(
    name = "virtual_keyboard_tests",
    environments = [
        "//build/testing/environments:nuc11_env",
    ],
    max_log_severity = "ERROR",
    package = ":virtual_keyboard_tests_package",
)

fx_cc_test_binary(
    name = "virtual_keyboard_unittests_bin",
    srcs = [
        "virtual_keyboard_controller_unittest.cc",
        "virtual_keyboard_coordinator_unittest.cc",
        "virtual_keyboard_fidl_test.cc",
        "virtual_keyboard_manager_unittest.cc",
    ],
    # Test sources use angled `#include <src/lib/...>`, which relies on the
    # workspace root being on the include path.
    # @bazel2gn:skip
    copts = ["-I."],
    gn_output_name = "virtual_keyboard_unittests",
    deps = [
        "//sdk/lib/sys/cpp/testing:cpp",
        "//sdk/lib/ui/scenic/cpp",
        "//src/lib/fxl/test:gtest_main",
        "//src/lib/testing/loop_fixture",
        "//src/ui/bin/virtual_keyboard_manager:lib",
        "//src/ui/bin/virtual_keyboard_manager:virtual_keyboard",
    ],
)

fx_cc_test_binary(
    name = "focus_dispatcher_unittests_bin",
    srcs = ["focus_dispatcher_unittest.cc"],
    # focus_dispatcher_unittest.cc uses angled `#include <src/lib/...>`, which
    # relies on the workspace root being on the include path.
    # @bazel2gn:skip
    copts = ["-I."],
    gn_output_name = "focus_dispatcher_unittests",
    deps = [
        "//sdk/lib/sys/cpp",
        "//sdk/lib/sys/cpp/testing:cpp",
        "//sdk/lib/syslog/cpp",
        "//sdk/lib/ui/scenic/cpp",
        "//src/lib/fxl/test:gtest_main",
        "//src/lib/testing/loop_fixture",
        "//src/ui/bin/virtual_keyboard_manager:lib",
        "//src/ui/bin/virtual_keyboard_manager/tests/fakes",
    ],
)
