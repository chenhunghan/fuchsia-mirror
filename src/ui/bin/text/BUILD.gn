import("//build/components.gni")

group("text") {
  testonly = true
  deps = [
    ":tests",
    ":text_manager",
  ]
}

group("tests") {
  testonly = true

  deps = [
    ":keyboard_test",
    ":keyboard_test_parallel_pkg",
    ":text_manager",
    ":text_manager_test_pkg",
  ]
}

# Kept in GN because non-assembly GN targets (//src/ui/bin:bin,
# //src/chromium/web_runner_tests/generate_web_runner_tests.gni, and
# //src/ui/tests/integration_input_tests/web-touch-input:tests) depend on
# `:text_manager`, and `:bin` transitively links the dual-built `rustc_dylib`
# `//src/storage/lib/vfs/rust:vfs` via `//src/lib/fuchsia-component`.
fuchsia_package("text_manager") {
  deps = [ ":text_manager_comp" ]
}

# Kept above the sentinel because `bazel2gn` does not support `parallel = 1`
# on `fx_test()`.
fuchsia_component("text_manager_integration_test") {
  testonly = true
  deps = [
    ":text_manager_comp",
    ":text_manager_integration_test_bin",
  ]
  manifest = "meta/text_manager_integration_test.cml"
}

fuchsia_component("legacy_ime_integration_test") {
  testonly = true
  deps = [
    ":legacy_ime_integration_test_bin",
    ":text_manager_comp",
  ]
  manifest = "meta/legacy_ime_integration_test.cml"
}

fuchsia_test_package("keyboard_test") {
  package_name = "keyboard_test-gn"
  test_components = [
    ":text_manager_integration_test",
    ":legacy_ime_integration_test",
  ]

  # These tests use a single instance of the text manager, and since they set
  # up conflicting test cases, they can not run in parallel.
  test_specs = {
    parallel = 1
  }
}

