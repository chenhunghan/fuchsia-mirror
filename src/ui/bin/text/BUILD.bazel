load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

# Aggregated into //src/ui:target_tests.
test_suite(
    name = "tests",
    tests = [
        ":keyboard_test",
        ":keyboard_test_parallel",
        ":text_manager_test",
    ],
    visibility = ["//src/ui:__pkg__"],
)

# TODO(https://fxbug.dev/570694755): Verify whether bin should use target_compatible_with (was not gated by if (is_fuchsia) in GN).
rustc_binary(
    name = "bin",
    srcs = [
        "src/fidl_helpers.rs",
        "src/index_convert.rs",
        "src/keyboard/events.rs",
        "src/keyboard/keyboard3.rs",
        "src/keyboard/mod.rs",
        "src/keyboard/service.rs",
        "src/legacy_ime/handler.rs",
        "src/legacy_ime/mod.rs",
        "src/legacy_ime/position.rs",
        "src/legacy_ime/state.rs",
        "src/main.rs",
        "src/text_manager.rs",
    ],
    binary_name = "text_manager",
    edition = "2024",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//sdk/fidl/fuchsia.input:fuchsia.input_rust",
        "//sdk/fidl/fuchsia.ui.input:fuchsia.ui.input_rust",
        "//sdk/fidl/fuchsia.ui.input3:fuchsia.ui.input3_rust",
        "//sdk/fidl/fuchsia.ui.keyboard.focus:fuchsia.ui.keyboard.focus_rust",
        "//sdk/fidl/fuchsia.ui.views:fuchsia.ui.views_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/ui/fuchsia-scenic",
        "//src/lib/ui/keymaps",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:unicode-normalization",
        "//third_party/rust_crates/vendor:unicode-segmentation",
    ],
)

fx_packaged_binary(
    name = "bin_packaged",
    binary = ":bin",
    binary_name = "text_manager",
)

fx_component_manifest(
    name = "text_manager_manifest",
    component_name = "text_manager",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/text_manager.cml",
)

fx_component(
    name = "text_manager_comp",
    compiled_manifest = ":text_manager_manifest",
    visibility = [
        "//src/ui/testing/ui_test_realm:__pkg__",
        "//src/ui/tests:__subpackages__",
    ],
    deps = [":bin_packaged"],
)

rustc_test(
    name = "bin_test",
    crate = ":bin",
    # Preserves the GN output_name expected by meta/text_manager_bin_test.cml.
    crate_name = "text_manager_bin_test",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        ":test_helpers",
        "//third_party/rust_crates/vendor:maplit",
    ],
)

fx_packaged_binary(
    name = "bin_test_packaged",
    testonly = True,
    binary = ":bin_test",
    binary_name = "text_manager_bin_test",
)

fx_component_manifest(
    name = "text_manager_bin_test_manifest",
    testonly = True,
    component_name = "text_manager_bin_test",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/text_manager_bin_test.cml",
)

fx_test_component(
    name = "text_manager_bin_test",
    compiled_manifest = ":text_manager_bin_test_manifest",
    deps = [":bin_test_packaged"],
)

fx_package(
    name = "text_manager_test_pkg",
    package_name = "text_manager_test",
    test_components = [":text_manager_bin_test"],
)

# bazel2gn translates `fx_package("text_manager_test_pkg")` into
# `fuchsia_test_package("text_manager_test_pkg")` and ignores `fx_test()`.
# @bazel2gn:skip
fx_test(
    name = "text_manager_test",
    package = ":text_manager_test_pkg",
)

rustc_test(
    name = "keyboard3_integration_test_bin",
    srcs = ["tests/keyboard3.rs"],
    crate_name = "keyboard3_integration_test",
    crate_root = "tests/keyboard3.rs",
    edition = "2024",
    target_compatible_with = ["@platforms//os:fuchsia"],
