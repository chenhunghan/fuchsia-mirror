        ":test_helpers",
        "//sdk/fidl/fuchsia.input:fuchsia.input_rust",
        "//sdk/fidl/fuchsia.logger:fuchsia.logger_rust",
        "//sdk/fidl/fuchsia.ui.input:fuchsia.ui.input_rust",
        "//sdk/fidl/fuchsia.ui.input3:fuchsia.ui.input3_rust",
        "//sdk/fidl/fuchsia.ui.keyboard.focus:fuchsia.ui.keyboard.focus_rust",
        "//sdk/fidl/fuchsia.ui.views:fuchsia.ui.views_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component-test",
        "//src/lib/ui/fuchsia-scenic",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

rustc_test(
    name = "text_manager_integration_test_bin",
    srcs = ["tests/text_manager.rs"],
    crate_name = "text_manager_integration_test",
    crate_root = "tests/text_manager.rs",
    edition = "2024",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        ":test_helpers",
        "//sdk/fidl/fuchsia.input:fuchsia.input_rust",
        "//sdk/fidl/fuchsia.ui.input:fuchsia.ui.input_rust",
        "//sdk/fidl/fuchsia.ui.input3:fuchsia.ui.input3_rust",
        "//sdk/rust/zx",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/ui/keymaps",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
    ],
)

rustc_test(
    name = "legacy_ime_integration_test_bin",
    srcs = ["tests/legacy_ime.rs"],
    crate_name = "legacy_ime_integration_test",
    crate_root = "tests/legacy_ime.rs",
    edition = "2024",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        ":test_helpers",
        "//sdk/fidl/fuchsia.input:fuchsia.input_rust",
        "//sdk/fidl/fuchsia.ui.input:fuchsia.ui.input_rust",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//third_party/rust_crates/vendor:anyhow",
    ],
)

rustc_library(
    name = "test_helpers",
    testonly = True,
    srcs = ["tests/test_helpers.rs"],
    crate_root = "tests/test_helpers.rs",
    edition = "2024",
    proc_macro_deps = ["//third_party/rust_crates/vendor:async-trait"],
    deps = [
        "//sdk/fidl/fuchsia.input:fuchsia.input_rust",
        "//sdk/fidl/fuchsia.ui.input:fuchsia.ui.input_rust",
        "//sdk/fidl/fuchsia.ui.input3:fuchsia.ui.input3_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
    ],
)

fx_packaged_binary(
    name = "keyboard3_integration_test_bin_packaged",
    testonly = True,
    binary = ":keyboard3_integration_test_bin",
    binary_name = "keyboard3_integration_test",
)

fx_component_manifest(
    name = "keyboard3_integration_test_manifest",
    testonly = True,
    component_name = "keyboard3_integration_test",
    includes = [
        "//sdk/lib/sys/component:realm_builder.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/keyboard3_integration_test.cml",
)

fx_test_component(
    name = "keyboard3_integration_test",
    compiled_manifest = ":keyboard3_integration_test_manifest",
    deps = [":keyboard3_integration_test_bin_packaged"],
)

fx_package(
    name = "keyboard_test_parallel_pkg",
    package_name = "keyboard_test_parallel",
    components = [
        ":text_manager_comp",
        "//src/lib/fuchsia-component-test/realm_builder_server:realm_builder_server_component",
    ],
    test_components = [":keyboard3_integration_test"],
)

# bazel2gn translates `fx_package("keyboard_test_parallel_pkg")` into
# `fuchsia_test_package("keyboard_test_parallel_pkg")` and ignores `fx_test()`.
# @bazel2gn:skip
fx_test(
    name = "keyboard_test_parallel",
    package = ":keyboard_test_parallel_pkg",
)

fx_packaged_binary(
    name = "text_manager_integration_test_bin_packaged",
    testonly = True,
    binary = ":text_manager_integration_test_bin",
    binary_name = "text_manager_integration_test",
)

fx_component_manifest(
    name = "text_manager_integration_test_manifest",
    testonly = True,
    component_name = "text_manager_integration_test",
    includes = [
        "//sdk/lib/inspect:offer.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/text_manager_integration_test.cml",
)

fx_test_component(
    name = "text_manager_integration_test",
    compiled_manifest = ":text_manager_integration_test_manifest",
    deps = [":text_manager_integration_test_bin_packaged"],
)

fx_packaged_binary(
    name = "legacy_ime_integration_test_bin_packaged",
    testonly = True,
    binary = ":legacy_ime_integration_test_bin",
    binary_name = "legacy_ime_integration_test",
)

fx_component_manifest(
    name = "legacy_ime_integration_test_manifest",
    testonly = True,
    component_name = "legacy_ime_integration_test",
    includes = [
        "//sdk/lib/inspect:offer.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/legacy_ime_integration_test.cml",
)

fx_test_component(
    name = "legacy_ime_integration_test",
    compiled_manifest = ":legacy_ime_integration_test_manifest",
    deps = [":legacy_ime_integration_test_bin_packaged"],
)

# bazel2gn does not support `parallel` on `fx_test()`, so the GN copy stays
# above the sentinel in BUILD.gn.
# @bazel2gn:skip
fx_package(
    name = "keyboard_test_pkg",
    package_name = "keyboard_test",
    components = [":text_manager_comp"],
    test_components = [
        ":text_manager_integration_test",
        ":legacy_ime_integration_test",
    ],
)

# These tests use a single instance of the text manager, and since they set
# up conflicting test cases, they can not run in parallel.
fx_test(
    name = "keyboard_test",
    package = ":keyboard_test_pkg",
    parallel = 1,
)
