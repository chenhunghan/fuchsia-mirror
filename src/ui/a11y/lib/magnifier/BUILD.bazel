        "//sdk/lib/async:async-cpp",
        "//src/lib/callback",
        "//src/lib/fxl",
        "//src/ui/a11y/lib/gesture_manager",
        "//src/ui/a11y/lib/gesture_manager/arena",
        "//src/ui/a11y/lib/gesture_manager/gesture_util",
        "//zircon/system/ulib/zx",
