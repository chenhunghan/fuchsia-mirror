load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")

package(default_applicable_licenses = ["//:license"])

fx_cc_library(
    name = "mocks",
    testonly = True,
    srcs = [
        "mock_gesture_handler.cc",
        "mock_gesture_listener.cc",
    ],
    hdrs = [
        "mock_gesture_handler.h",
        "mock_gesture_listener.h",
    ],
    implementation_deps = [
