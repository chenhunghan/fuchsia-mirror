        "//src/ui/a11y/lib/screen_reader/tests:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.accessibility.gesture:fuchsia.accessibility.gesture_hlcpp",
        "//src/ui/a11y/lib/gesture_manager",
    ],
    alwayslink = True,
