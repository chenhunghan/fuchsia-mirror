load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")

package(default_applicable_licenses = ["//:license"])

fx_cc_library(
    name = "mocks",
    testonly = True,
    srcs = [
        "mock_highlight_delegate.cc",
    ],
    hdrs = [
        "mock_highlight_delegate.h",
    ],
    implementation_deps = [
        "//sdk/lib/sys/cpp",
        "//sdk/lib/syslog/cpp",
        "//sdk/lib/ui/scenic/cpp",
        "//src/lib/fxl",
        "//src/ui/a11y/lib/annotation",
        "//src/ui/a11y/lib/util",
    ],
    # Uses Fuchsia-specific Scenic, sys, and annotation headers.
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = [
        "//src/ui/a11y/bin/a11y_manager/tests:__pkg__",
        "//src/ui/a11y/lib/screen_reader/focus/tests:__pkg__",
        "//src/ui/a11y/lib/screen_reader/tests:__pkg__",
        "//src/ui/a11y/lib/view/tests:__subpackages__",
    ],
    alwayslink = True,
)
