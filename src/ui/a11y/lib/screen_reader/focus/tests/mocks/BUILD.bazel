load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")

package(default_applicable_licenses = ["//:license"])

fx_cc_library(
    name = "mocks",
    testonly = True,
    srcs = [
        "mock_a11y_focus_manager.cc",
    ],
    hdrs = [
        "mock_a11y_focus_manager.h",
    ],
    # TODO(https://fxbug.dev/42136089): delete the below and fix compiler warnings
    copts = ["-Wno-conversion"],
    implementation_deps = [
        "//sdk/lib/sys/cpp",
        "//sdk/lib/syslog/cpp",
        "//src/lib/fxl",
        "//src/ui/a11y/lib/util",
    ],
    visibility = [
        "//src/ui/a11y/lib/focus_chain/tests:__pkg__",
        "//src/ui/a11y/lib/screen_reader/focus/tests:__pkg__",
        "//src/ui/a11y/lib/screen_reader/tests:__subpackages__",
    ],
    deps = [
        "//src/ui/a11y/lib/focus_chain",
        "//src/ui/a11y/lib/screen_reader/focus",
    ],
    alwayslink = True,
)
