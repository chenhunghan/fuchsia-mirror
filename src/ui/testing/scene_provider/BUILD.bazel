load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)

package(default_applicable_licenses = ["//:license"])

fx_cc_binary(
    name = "bin",
    srcs = ["main.cc"],
    gn_output_name = "scene_provider",
    tags = ["manual"],
    # Uses Fuchsia-only Zircon/FIDL headers and deps via :lib and //sdk/lib/sys/cpp.
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        ":lib",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        "//sdk/lib/sys/cpp",
        "//sdk/lib/syslog/cpp",
    ],
)

fx_cc_library(
    name = "lib",
    srcs = ["scene_provider.cc"],
    hdrs = ["scene_provider.h"],
    # Uses Fuchsia-only Zircon/FIDL headers and deps.
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//sdk/fidl/fuchsia.element:fuchsia.element_hlcpp",
        "//sdk/fidl/fuchsia.session.scene:fuchsia.session.scene_hlcpp",
        "//sdk/fidl/fuchsia.ui.app:fuchsia.ui.app_hlcpp",
        "//sdk/fidl/fuchsia.ui.observation.test:fuchsia.ui.observation.test_hlcpp",
        "//sdk/fidl/fuchsia.ui.test.scene:fuchsia.ui.test.scene_hlcpp",
        "//sdk/lib/sys/cpp",
        "//sdk/lib/syslog/cpp",
        "//sdk/lib/ui/scenic/cpp",
        "//src/lib/fsl",
    ],
    alwayslink = True,
)

fx_packaged_binary(
    name = "bin_packaged",
    binary = ":bin",
    binary_name = "scene_provider",
)

fx_component_manifest(
    name = "scene_provider_manifest",
    component_name = "scene-provider",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/scene_provider.cml",
)

fx_component(
    name = "scene-provider",
    compiled_manifest = ":scene_provider_manifest",
    visibility = ["//src/ui/testing/ui_test_realm:__pkg__"],
    deps = [":bin_packaged"],
)
