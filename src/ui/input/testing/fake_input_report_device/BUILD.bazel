    name = "fake_input_report_device",
    testonly = True,
    srcs = [
        "fake.cc",
        "reports_reader.cc",
    ],
    hdrs = [
        "fake.h",
        "reports_reader.h",
    ],
    visibility = [
        "//src/ui/tests/integration_input_tests/touch:__pkg__",
        "//src/ui/tests/integration_input_tests/virtual-keyboard:__pkg__",
