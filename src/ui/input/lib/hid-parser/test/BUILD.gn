    "hid-descriptor-test.cc",
    "hid-helper-test.cc",
    "hid-parser-test.cc",
    "hid-report-data.h",
    "hid-units-test.cc",
    "hid-utest-data.cc",
    "util.h",
  ]
  output_name = "hid-parser-test"
  deps = [
    "//sdk/lib/fdio",
    "//src/lib/fxl/test:gtest_main",
    "//src/ui/input/lib/hid",
    "//src/ui/input/lib/hid-parser",
    "//third_party/googletest:gtest",
    "//zircon/system/ulib/fbl",
  ]
  testonly = true
  emit_tool_path = false
}

fuchsia_unittest_package("hid-parser-package") {
  package_name = "hid-parser-test-gn"
  component_name = "hid-parser-test"
  deps = [ ":hid-parser" ]
}
