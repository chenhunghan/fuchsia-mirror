load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")

package(default_applicable_licenses = ["//:license"])

fx_cc_library(
    name = "mocks",
    testonly = True,
    srcs = [
        "mock_injector.cc",
        "mock_injector_registry.cc",
    ],
    hdrs = [
        "mock_injector.h",
        "mock_injector_registry.h",
    ],
    # Needed for angled workspace-root `#include <src/...>` in mock_injector_registry.cc.
    # @bazel2gn:skip
    copts = ["-I."],
    implementation_deps = [
        "//sdk/lib/syslog/cpp",
    ],
    # Depends on Fuchsia-only FIDL and SDK targets.
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = [
        "//src/ui/a11y/lib/view/tests:__pkg__",
        "//src/ui/input/lib/injector/tests:__pkg__",
    ],
    deps = [
        "//sdk/lib/sys/cpp/testing:cpp",
        "//src/ui/input/lib/injector",
    ],
    alwayslink = True,
)
