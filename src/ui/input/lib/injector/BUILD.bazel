load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")

package(default_applicable_licenses = ["//:license"])

# TODO(https://fxbug.dev/570694755): Kept as group("injector") above the
# sentinel in BUILD.gn because bazel2gn cannot emit a group() with multiple
# public_deps from fx_cc_library.
# @bazel2gn:skip
fx_cc_library(
    name = "injector",
    visibility = [
        "//src/ui/a11y/lib/view:__subpackages__",
        "//src/ui/input/lib/injector/tests:__subpackages__",
    ],
    deps = [
        ":injector_config_setup",
        ":lib",
    ],
)

fx_cc_library(
    name = "lib",
    srcs = ["injector.cc"],
    hdrs = ["injector.h"],
    implementation_deps = [
        ":injector_config_setup",
        "//sdk/lib/syslog/cpp",
        "//src/lib/fostr/fidl/fuchsia.input.report",
        "//src/lib/fostr/fidl/fuchsia.ui.input",
        "//zircon/system/ulib/trace",
    ],
    visibility = [
        "//src/ui/a11y/lib/view:__subpackages__",
        "//src/ui/input/lib/injector/tests:__subpackages__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.ui.input:fuchsia.ui.input_hlcpp",
        "//sdk/fidl/fuchsia.ui.pointerinjector.configuration:fuchsia.ui.pointerinjector.configuration_hlcpp",
        "//sdk/fidl/fuchsia.ui.pointerinjector:fuchsia.ui.pointerinjector_hlcpp",
        "//sdk/fidl/fuchsia.ui.views:fuchsia.ui.views_hlcpp",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/sys/cpp",
        "//sdk/lib/ui/scenic/cpp",
        "//src/lib/fxl",
        "//zircon/system/ulib/inspect",
    ],
    alwayslink = True,
)

fx_cc_library(
    name = "injector_config_setup",
    srcs = ["injector_config_setup.cc"],
    hdrs = ["injector_config_setup.h"],
    implementation_deps = [
        "//sdk/lib/syslog/cpp",
    ],
    visibility = [
        "//src/ui/a11y/lib/view:__subpackages__",
        "//src/ui/input/lib/injector/tests:__subpackages__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.ui.pointerinjector.configuration:fuchsia.ui.pointerinjector.configuration_hlcpp",
        "//sdk/fidl/fuchsia.ui.views:fuchsia.ui.views_hlcpp",
        "//sdk/lib/sys/cpp",
    ],
    alwayslink = True,
)
