load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [
        ":test",
    ],
    visibility = ["//src/ui:__pkg__"],
)

fx_cc_library(
    name = "hid-input-report",
    srcs = [
        "axis.cc",
        "consumer_control.cc",
        "device.cc",
        "keyboard.cc",
        "mouse.cc",
        "sensor.cc",
        "touch.cc",
    ],
    hdrs = [
        "axis.h",
        "consumer_control.h",
        "device.h",
        "keyboard.h",
        "mouse.h",
        "sensor.h",
        "touch.h",
    ],
    # TODO(https://fxbug.dev/42176699): This target uses mutable tables which are deprecated,
    # rather than builders.
    build_flags = ["//build/cpp:fidl-wire-deprecated-mutable-tables"],
    # TODO(https://fxbug.dev/42136089): delete the below and fix compiler warnings
    copts = ["-Wno-conversion"],
    visibility = [
        "//src/ui/input/drivers/hid-input-report:__pkg__",
        "//src/ui/input/drivers/virtio:__pkg__",
        "//src/ui/input/testing/fake_input_report_device:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.input:fuchsia.input_cpp",
        "//sdk/fidl/fuchsia.input.report:fuchsia.input.report_cpp",
        "//sdk/fidl/fuchsia.ui.input:fuchsia.ui.input_cpp",
        "//sdk/lib/stdcompat",
        "//src/ui/input/lib/hid",
        "//src/ui/input/lib/hid-parser",
        "//zircon/system/ulib/fbl",
    ],
    alwayslink = True,
)

fx_cc_test_binary(
    name = "lib-hid-input-report-test",
    srcs = [
        "axis.cc",
        "axis.h",
        "consumer_control.cc",
        "consumer_control.h",
        "device.cc",
        "device.h",
        "keyboard.cc",
        "keyboard.h",
        "mouse.cc",
        "mouse.h",
        "sensor.cc",
        "sensor.h",
        "test/consumer-control-test.cc",
        "test/keyboard-test.cc",
        "test/mouse-test.cc",
        "test/sensor-test.cc",
        "test/test.h",
        "test/touch-test.cc",
        "touch.cc",
        "touch.h",
    ],
    # TODO(https://fxbug.dev/42176699): This target uses mutable tables which are deprecated,
    # rather than builders.
    build_flags = ["//build/cpp:fidl-wire-deprecated-mutable-tables"],
    # TODO(https://fxbug.dev/42136089): delete the below and fix compiler warnings
    copts = ["-Wno-conversion"],
    deps = [
        "//sdk/fidl/fuchsia.input:fuchsia.input_cpp",
        "//sdk/fidl/fuchsia.input.report:fuchsia.input.report_cpp",
        "//sdk/fidl/fuchsia.ui.input:fuchsia.ui.input_cpp",
        "//sdk/lib/stdcompat",
        "//src/lib/ddk",
        "//src/ui/input/lib/hid",
        "//src/ui/input/lib/hid-parser",
        "//zircon/system/ulib/fbl",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_package(
    name = "test",
    package_name = "lib-hid-input-report-test",
    unit_tests = [":lib-hid-input-report-test"],
    visibility = ["//src/ui/input/lib:__pkg__"],
)
