rustc_library(
    name = "input_pipeline",
    srcs = _COMMON_SRCS,
    aspect_hints = [":input_pipeline_includes"],
    edition = "2024",
    proc_macro_deps = _COMMON_PROC_MACRO_DEPS,
    visibility = [
        "//src/ui/bin/scene_manager:__pkg__",
        "//src/ui/lib/scene_management:__pkg__",
    ],
    deps = _COMMON_DEPS + [
        "//src/lib/fdio/rust:fdio",
    ],
)

rustc_library(
    name = "dso",
    srcs = _COMMON_SRCS,
    aspect_hints = [":input_pipeline_includes"],
    crate_features = ["dso"],
    crate_name = "input_pipeline_dso",
    edition = "2024",
    proc_macro_deps = _COMMON_PROC_MACRO_DEPS,
    visibility = [
        "//src/ui/bin/scene_manager:__pkg__",
        "//src/ui/lib/scene_management:__pkg__",
    ],
    # :input_pipeline provides unit tests.
    deps = _COMMON_DEPS + [
        "//sdk/fidl/fuchsia.ui.pointerinjector.dso:fuchsia.ui.pointerinjector.dso_rust_next",
        "//sdk/lib/async/rust",
        "//sdk/lib/async/rust/fidl",
        "//sdk/lib/driver/component/rust",
        "//sdk/lib/driver/runtime/rust",
        "//sdk/lib/driver/runtime/rust/fidl",
    ],
)

cml_shard(
    name = "meta/client.shard",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
        "//sdk/lib/trace:use.shard",
        "//src/ui/lib/focus_chain_provider:meta/client.shard",
    ],
    shard = "meta/client.shard.cml",
    visibility = ["//src/ui/bin/scene_manager:__pkg__"],
)

expect_includes(
    name = "input_pipeline_includes",
    includes = [":meta/client.shard"],
)

rustc_test(
    name = "input_pipeline_test",
    aspect_hints = [":input_pipeline_includes"],
    crate = ":input_pipeline",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
        "//src/lib/fuchsia",
        "//src/lib/ui/fidl_fuchsia_ui_focus_ext:lib",
        "//src/lib/ui/fidl_fuchsia_ui_views_ext:lib",
        "//src/storage/lib/vfs/rust:vfs",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:pretty_assertions",
        "//third_party/rust_crates/vendor:rand",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

fx_unittest_package(
    name = "input_pipeline_lib_tests",
    max_log_severity = "ERROR",
    unit_tests = [":input_pipeline_test"],
)
