import("//build/components.gni")
import("//src/lib/vulkan/vulkan.gni")

group("libvulkan") {
  public_deps = [ "//src/lib/vulkan" ]
}

# Keep test packages in GN until //src/lib/vulkan has a Ninja dependency edge
# for fuchsia_platform Bazel builds and
# //src/lib/vulkan:vulkan_validation_layers and vulkan_envs have Bazel
# equivalents.
fuchsia_unittest_package("diagnostic_overlay_tests") {
  deps = [ ":diagnostic_overlay_test" ]
}

fuchsia_unittest_package("diagnostic_overlay_vulkan_tests") {
  manifest = "meta/diagnostic_overlay_vulkan_tests.cml"
  deps = [
    ":diagnostic_overlay_vulkan_test",
    "//src/lib/vulkan:vulkan_validation_layers",
  ]
  test_specs = {
    environments = vulkan_envs
  }
  test_type = "vulkan"
}

group("tests") {
  testonly = true
  deps = [
    ":diagnostic_overlay_tests",
    ":diagnostic_overlay_vulkan_tests",
  ]
}

