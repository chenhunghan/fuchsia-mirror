load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//build/bazel/rules/host_tests:host_cc_test.bzl", "host_cc_test")

package(default_applicable_licenses = ["//:license"])

# Aggregated into //src/ui:host_tests.
test_suite(
    name = "host_tests",
    tests = [":yuv_unittests"],
    visibility = ["//src/ui:__pkg__"],
)

fx_cc_library(
    name = "yuv",
    srcs = ["yuv.cc"],
    hdrs = ["yuv.h"],
    # Always optimize regardless of --release or debug.
    copts = ["-O3"],
    alwayslink = True,
)

host_cc_test(
    name = "yuv_unittests",
    srcs = ["test/yuv_unittests.cc"],
    # TODO(https://fxbug.dev/42136089): delete the below and fix compiler warnings
    copts = ["-Wno-conversion"],
    deps = [
        ":yuv",
        "//src/lib/fxl",
        "//src/lib/fxl/test:gtest_main",
        "@com_google_googletest//:gtest",
    ],
)
