import("//build/tools/bazel2gn/bazel_migration.gni")

executable("http_server_bin") {
  sources = [ "http_server.cc" ]
  deps = [
    "//sdk/lib/stdcompat",
    "//sdk/lib/syslog/cpp",
    "//src/lib/fxl",
    "//zircon/system/ulib/fbl",
  ]
  data_deps = [ ":http_server_data" ]
}

fuchsia_component_manifest("http_server_manifest") {
  testonly = true
  component_name = "http_server"
  manifest = "meta/http_server.cml"
}

fuchsia_component("http_server_component") {
  testonly = true
  cm_label = ":http_server_manifest"
  visibility = [ "//*" ]
  deps = [ ":http_server_bin" ]
}
