  forward_variables_from(_component, "*")
  cm_label = ":scenic_dso_manifest"
  deps += [ "//src/ui/scenic/bin:dso" ]
}

fuchsia_structured_config_cpp_elf_lib("scenic_structured_config") {
  cm_label = ":scenic_manifest"
}

fuchsia_package("scenic_pkg") {
  package_name = "scenic"
  deps = [ ":component" ]
}

fuchsia_package("scenic_pkg_dso") {
  package_name = "scenic"
  deps = [ ":component_dso" ]
}

