  }
  if (scenic_enable_vulkan_validation) {
    deps += [ "//src/lib/vulkan:vulkan_validation_layers" ]
  }
}

fuchsia_component("component") {
  forward_variables_from(_component, "*")
  cm_label = ":scenic_manifest"
  deps += [ "//src/ui/scenic/bin" ]
}

