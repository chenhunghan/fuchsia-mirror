# The real-display pixeltests compare display-capture output against golden
# images using board-specific tolerances. A single test binary is shared by
# one test package per board:
#  - Each package's manifest passes the board name to the binary via `--board=<name>`
#  - The package only runs in that board's 'environment' in infra due to the
#    specification of the matching environment in the test package's 'environments' param.
#
# Do not add new boards (such as Nelson) here. Although other display engines
# also support display capture, hardware readback is flaky on other boards even
# with board-specific comparison workarounds. We intentionally only run these
# tests on Astro, Sherlock and VIM3 where they are known to be stable.
#
# When running locally, run only the package for the board under test (e.g.
# `fx test flatland_display_compositor_pixeltests_vim3`). Running all of them
# against a single device will cause failures in the packages for the
# mismatched boards.

# Only add the board-specific packages on the arch used by their board.
if (current_cpu == "arm64") {
  fuchsia_unittest_package("flatland_display_compositor_pixeltests_astro") {
    manifest = "meta/flatland_display_compositor_pixeltests_astro.cml"
    deps = [ "//src/ui/scenic/lib/flatland/engine/tests/pixeltests:pixeltests_with_real_display" ] + scenic_test_deps
    test_specs = {
      log_settings = {
        max_severity = "ERROR"
      }
      environments = [ astro_env ]
    }
    test_type = "system"
  }

  fuchsia_unittest_package("flatland_display_compositor_pixeltests_sherlock") {
    manifest = "meta/flatland_display_compositor_pixeltests_sherlock.cml"
    deps = [ "//src/ui/scenic/lib/flatland/engine/tests/pixeltests:pixeltests_with_real_display" ] + scenic_test_deps
    test_specs = {
      log_settings = {
        max_severity = "ERROR"
      }
      environments = [ sherlock_env ]
    }
    test_type = "system"
  }

  fuchsia_unittest_package("flatland_display_compositor_pixeltests_vim3") {
    manifest = "meta/flatland_display_compositor_pixeltests_vim3.cml"
    deps = [ "//src/ui/scenic/lib/flatland/engine/tests/pixeltests:pixeltests_with_real_display" ] + scenic_test_deps
    test_specs = {
      log_settings = {
        max_severity = "ERROR"
      }
      environments = [ vim3_env ]
    }
    test_type = "system"
  }
}

fuchsia_unittest_package(
    "flatland_display_compositor_pixeltests_with_fake_display") {
  manifest = "meta/flatland_display_compositor_pixeltests_with_fake_display.cml"
  deps = [
           "//src/graphics/display/testing/fake-display-stack-host:component",
           "//src/ui/scenic/lib/flatland/engine/tests/pixeltests:pixeltests_with_fake_display",
         ] + scenic_test_deps
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }

    # Force these tests to run on the display-capture-capable devices used by
    # the flatland_display_compositor_pixeltests_<board> packages + NUC +
    # basic_envs in CQ. Do not remove.
    environments = [
                     astro_env,
                     sherlock_env,
                     vim3_env,
                     nuc11_env,
                   ] + basic_envs
  }
  test_type = "vulkan"
}

