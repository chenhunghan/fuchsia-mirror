import("//build/testing/cc_test_executable.gni")

group("tests") {
  testonly = true

  public_deps = [
    ":death_unittests",
    ":unittests",
  ]
}

cc_test_executable("death_unittests") {
  output_name = "display_death_unittests"
  testonly = true
  deps = [
    "//src/lib/fxl/test:gtest_main",
    "//src/ui/scenic/lib/display/coordinator_proxy/tests:death_unittests",
  ]
}

# fx test //src/ui/scenic:display_unittests
cc_test_executable("unittests") {
  output_name = "display_unittests"
  testonly = true
  sources = [
    "color_converter_unittest.cc",
    "display_coordinator_listener_unittest.cc",
    "display_manager_unittest.cc",
    "display_power_manager_unittest.cc",
    "singleton_display_service_unittest.cc",
    "util_unittest.cc",
    "vsync_source_unittest.cc",
  ]
  deps = [
    ":mocks",
    "//sdk/fidl/fuchsia.hardware.display:fuchsia.hardware.display_cpp",
    "//sdk/fidl/fuchsia.hardware.display.types:fuchsia.hardware.display.types_cpp",
    "//sdk/fidl/fuchsia.images2:fuchsia.images2_cpp",
    "//sdk/fidl/fuchsia.ui.display.color:fuchsia.ui.display.color_cpp",
    "//sdk/fidl/fuchsia.ui.input.internal:fuchsia.ui.input.internal_cpp",
    "//sdk/fidl/fuchsia.ui.views:fuchsia.ui.views_cpp",
    "//sdk/lib/async:async-cpp",
    "//sdk/lib/async-default",
    "//sdk/lib/async-testing",
    "//sdk/lib/sys/cpp/testing:cpp",
    "//src/lib/fsl",
    "//src/lib/fxl/test:gtest_main",
    "//src/lib/testing/loop_fixture:gtest",
    "//src/ui/scenic/lib/display",
    "//src/ui/scenic/lib/display:singleton_display_service",
    "//src/ui/scenic/lib/display/coordinator_proxy/tests:unittests",
    "//third_party/googletest:gmock",
    "//zircon/system/ulib/inspect",
  ]
}

source_set("mocks") {
  testonly = true
  sources = [
    "mock_display_coordinator.cc",
    "mock_display_coordinator.h",
  ]
  public_deps = [
    "//sdk/fidl/fuchsia.hardware.display:fuchsia.hardware.display_cpp",
    "//sdk/fidl/fuchsia.hardware.display.types:fuchsia.hardware.display.types_cpp",
    "//sdk/fidl/fuchsia.sysmem2:fuchsia.sysmem2_cpp",
    "//src/lib/fsl",
    "//src/ui/scenic/lib/display:types",
  ]
  deps = [ "//sdk/lib/async-default" ]
}
