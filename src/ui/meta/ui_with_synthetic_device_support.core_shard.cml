{
    offer: [
        {
            // test-only: lets input-helper register synthetic devices with Starnix.
            protocol: [ "fuchsia.input.injection.InputDeviceRegistry" ],
            from: "#starnix_runner",
            to: "#ui",
            dependency: "weak",
            availability: "optional",
            source_availability: "unknown",
        },
    ],
}
