load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "bin",
    srcs = [
        "src/internal_message.rs",
        "src/keyboard.rs",
        "src/main.rs",
        "src/mouse.rs",
        "src/touch.rs",
    ],
    binary_name = "simplest-app-flatland",
    edition = "2024",
    deps = [
        "//sdk/fidl/fuchsia.element:fuchsia.element_rust",
        "//sdk/fidl/fuchsia.math:fuchsia.math_rust",
        "//sdk/fidl/fuchsia.ui.app:fuchsia.ui.app_rust",
        "//sdk/fidl/fuchsia.ui.composition:fuchsia.ui.composition_rust",
        "//sdk/fidl/fuchsia.ui.input3:fuchsia.ui.input3_rust",
        "//sdk/fidl/fuchsia.ui.pointer:fuchsia.ui.pointer_rust",
        "//sdk/fidl/fuchsia.ui.views:fuchsia.ui.views_rust",
        "//src/lib/async-utils",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/trace/rust:trace",
        "//src/lib/trace/rust:trace-provider",
        "//src/lib/ui/fuchsia-scenic",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

fx_packaged_binary(
    name = "bin_packaged",
    binary = ":bin",
    binary_name = "simplest-app-flatland",
)

fx_component_manifest(
    name = "simplest-app-flatland_manifest",
    component_name = "simplest-app-flatland",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/simplest-app-flatland.cml",
)

fx_component(
    name = "simplest-app-flatland",
    compiled_manifest = ":simplest-app-flatland_manifest",
    visibility = ["//src/ui/examples:__pkg__"],
    deps = [":bin_packaged"],
)

fx_component_manifest(
    name = "simplest-app-flatland-session_manifest",
    component_name = "simplest-app-flatland-session",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//sdk/lib/trace:use.shard",
    ],
    manifest = "meta/simplest-app-flatland-session.cml",
)

fx_component(
    name = "simplest-app-flatland-session",
    compiled_manifest = ":simplest-app-flatland-session_manifest",
    visibility = ["//src/ui/examples:__pkg__"],
    deps = [":bin_packaged"],
)
