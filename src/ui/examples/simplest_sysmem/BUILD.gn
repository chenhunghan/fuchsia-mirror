import("//build/components.gni")

# Kept in GN because `fx set --with //src/ui/examples/simplest_sysmem` (see
# README.md) builds this package and bazel2gn does not translate fx_package().
# TODO(https://fxbug.dev/570694755): Move to Bazel once bazel2gn supports it.
fuchsia_package("simplest_sysmem") {
  package_name = "simplest_sysmem"
  deps = [ ":simplest_sysmem_component" ]
}

# bazel2gn does not translate resource() targets, so this stays hand-written.
# TODO(https://fxbug.dev/570694755)
resource("images") {
  sources = [ "data/smiley.png" ]
  outputs = [ "data/images/{{source_file_part}}" ]
}

