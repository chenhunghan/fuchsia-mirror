import("//build/tools/bazel2gn/bazel_migration.gni")

if (is_fuchsia) {
  executable("bin") {
    sources = [
      "main.cc",
      "view_provider.cc",
      "view_provider.h",
    ]
    output_name = "simplest_sysmem"
    deps = [
      ":helpers",
      "//sdk/fidl/fuchsia.ui.app:fuchsia.ui.app_hlcpp",
      "//sdk/lib/async-loop:async-loop-cpp",
      "//sdk/lib/async-loop:async-loop-default",
      "//sdk/lib/sys/cpp",
      "//sdk/lib/ui/scenic/cpp",
      "//zircon/system/ulib/fbl",
    ]
    data_deps = [ ":images" ]
  }
}

source_set("helpers") {
  sources = [
    "png_helper.cc",
    "sysmem_helper.cc",
  ]
  public = [
    "png_helper.h",
    "sysmem_helper.h",
  ]
  public_deps = [
    "//sdk/fidl/fuchsia.images2:fuchsia.images2_hlcpp",
    "//sdk/fidl/fuchsia.sysmem2:fuchsia.sysmem2_hlcpp",
    "//sdk/fidl/fuchsia.ui.composition:fuchsia.ui.composition_hlcpp",
    "//sdk/lib/syslog/cpp",
    "//third_party/libpng",
    "//zircon/system/ulib/zx",
  ]
}

fuchsia_component_manifest("simplest_sysmem_manifest") {
  component_name = "simplest_sysmem"
  manifest = "meta/simplest_sysmem.cml"
}

fuchsia_component("simplest_sysmem_component") {
  cm_label = ":simplest_sysmem_manifest"
  visibility = [
    ":*",
    "//src/testing/system-validation/ui:*",
    "//src/ui/examples:*",
  ]
  deps = [
    ":bin",
    ":images",
  ]
}
