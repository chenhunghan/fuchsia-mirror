{
    include: [ "syslog/client.shard.cml" ],
    program: {
        runner: "driver",
        binary: "driver/fake-bus-pci.so",
        bind: "meta/bind/fake_pci_bus_driver_bind.bindbc",
        default_dispatcher_opts: [ "allow_sync_calls" ],
    },
    capabilities: [
        { service: "fuchsia.hardware.pci.Service" },
    ],
    use: [
        {
            protocol: "fuchsia.kernel.IoportResource",
            availability: "optional",
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.pci.Service",
            from: "self",
        },
    ],
}
