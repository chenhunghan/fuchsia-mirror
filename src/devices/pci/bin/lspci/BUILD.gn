import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("lib") {
  sources = [
    "src/bridge.rs",
    "src/capability.rs",
    "src/config.rs",
    "src/db.rs",
    "src/device.rs",
    "src/filter.rs",
    "src/lib.rs",
    "src/util.rs",
  ]
  crate_name = "lspci"
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.hardware.pci:fuchsia.hardware.pci_rust",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
    "//third_party/rust_crates:bitfield",
    "//third_party/rust_crates:zerocopy",
  ]
}

rustc_test("lib_test") {
  sources = [
    "src/bridge.rs",
    "src/capability.rs",
    "src/config.rs",
    "src/db.rs",
    "src/device.rs",
    "src/filter.rs",
    "src/lib.rs",
    "src/util.rs",
  ]
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.hardware.pci:fuchsia.hardware.pci_rust",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
    "//third_party/rust_crates:bitfield",
    "//third_party/rust_crates:zerocopy",
  ]
  output_name = "lspci_lib_test"
}

rustc_binary("lspci") {
  sources = [ "src/main.rs" ]
  configs += [ "//build/config/rust:bootfs" ]
  edition = "2024"
  visibility = [
    ":*",
    "//src/devices/pci/bin:*",
  ]
  deps = [
    ":lib",
    "//sdk/fidl/fuchsia.hardware.pci:fuchsia.hardware.pci_rust",
    "//sdk/rust/zx",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
  ]
}
