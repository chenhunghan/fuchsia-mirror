{
    name: "spi",
    program: {
        colocate: "true",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        default_dispatcher_scheduler_role: "fuchsia.devices.spi.drivers.spi.bus",
        allowed_scheduler_roles: [
            "fuchsia.devices.spi.drivers.aml-spi.transaction",
            "fuchsia.devices.spi.drivers.aml-spi.spi1",
            "fuchsia.devices.spi.drivers.msm-spi.spi4",
        ],
        bind: { service: "fuchsia.hardware.spiimpl.Service" },
    },
    capabilities: [
        { service: "fuchsia.hardware.power.PowerTokenService" },
        {
            service: "fuchsia.hardware.spi.Service",
            metadata: {
                id: "fuchsia.hardware.spi.businfo.SpiBusMetadata",
                schema: {
                    $schema: "http://json-schema.org/draft-07/schema#",
                    title: "SpiBusMetadata",
                    type: "object",
                    properties: {
                        bus_id: {
                            type: "integer",
                            fuchsia_type: "provider_id",
                        },
                        channels: {
                            type: "array",
                            items: { $ref: "#/definitions/SpiChannel" },
                        },
                    },
                    required: [ "channels" ],
                    definitions: {
                        SpiChannel: {
                            type: "object",
                            properties: {
                                cs: {
                                    type: "integer",
                                    fuchsia_type: "uint32",
                                },
                                id: {
                                    type: "integer",
                                    fuchsia_type: "uint32",
                                },
                                vid: {
                                    type: "integer",
                                    fuchsia_type: "uint32",
                                },
                                pid: {
                                    type: "integer",
                                    fuchsia_type: "uint32",
                                },
                                did: {
                                    type: "integer",
                                    fuchsia_type: "uint32",
                                },
                                max_frequency_hz: {
                                    type: "integer",
                                    fuchsia_type: "uint32",
                                },
                                cs_polarity_high: { type: "boolean" },
                                word_length_bits: {
                                    type: "integer",
                                    fuchsia_type: "uint8",
                                },
                                is_bus_controller: { type: "boolean" },
                                clock_polarity_high: { type: "boolean" },
                            },
                            required: [ "cs" ],
                        },
                    },
                },
            },
        },
        { service: "fuchsia.hardware.spi.TestService" },
    ],
    use: [
        {
            config: "fuchsia.power.SuspendEnabled",
            key: "enable_suspend",
            type: "bool",
            availability: "optional",
            default: false,
        },
        {
            config: "fuchsia.driver.ExposeDebugCapabilities",
            key: "expose_debug_capabilities",
            type: "bool",
            availability: "optional",
            default: false,
        },
        {
            name: "default",
            service: "fuchsia.hardware.power.PowerTokenService",
            generate_bind_rule: false,
        },
        {
            name: "default",
            service: "fuchsia.hardware.spiimpl.Service",
            generate_bind_rule: false,
        },
        {
            name: "default",
            service: "fuchsia.hardware.spi.businfo.SpiBusMetadata",
            generate_bind_rule: false,
        },
        {
            name: "default",
            service: "fuchsia.scheduler.RoleName",
            generate_bind_rule: false,
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.power.PowerTokenService",
            from: "self",
        },
        {
            service: "fuchsia.hardware.spi.Service",
            from: "self",
        },
        {
            service: "fuchsia.hardware.spi.TestService",
            from: "self",
        },
    ],
}
