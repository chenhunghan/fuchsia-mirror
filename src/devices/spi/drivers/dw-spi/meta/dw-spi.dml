{
    name: "dw-spi",
    include: [
        "driver/platform-device.shard.cml",
        "driver_component/power_managed_dispatchers.shard.cml",
    ],
    program: {
        binary: "driver/dw-spi.so",
        default_dispatcher_scheduler_role: "fuchsia.devices.spi.drivers.spi.bus",
    },
    capabilities: [
        { service: "fuchsia.hardware.spiimpl.Service" },
        { service: "fuchsia.hardware.spi.businfo.SpiBusMetadata" },
        {
            driver_config: "fuchsia.hardware.spi.businfo.SpiBusMetadata",
            defs: {
                SpiChannel: {
                    type: "object",
                    properties: {
                        cs: { type: "uint32" },
                        id: { type: "uint32" },
                        vid: { type: "uint32" },
                        pid: { type: "uint32" },
                        did: { type: "uint32" },
                        max_frequency_hz: { type: "uint32" },
                        cs_polarity_high: { type: "bool" },
                        word_length_bits: { type: "uint8" },
                        is_bus_controller: { type: "bool" },
                        clock_polarity_high: { type: "bool" },
                    },
                    required: [ "cs" ],
                },
            },
            properties: {
                provider: { type: "uint32" },
                channels: {
                    type: "vector",
                    element: { ref: "#/SpiChannel" },
                    max_count: "MAX",
                },
            },
            required: [ "channels" ],
        },
    ],
    use: [
        {
            name: "pdev",
            primary: true,
            bind: { compat: "google,spi" },
        },
        {
            name: "bus",
            service: "fuchsia.hardware.clock.Service",
            bind: {
                rules: { "fuchsia.NAME": "bus" },
            },
        },
        {
            name: "registers",
            service: "fuchsia.hardware.clock.Service",
            bind: {
                rules: { "fuchsia.NAME": "registers" },
            },
        },
        {
            name: "reset",
            service: "fuchsia.hardware.reset.Service",
            bind: {
                rules: { "fuchsia.NAME": "reset" },
            },
        },
        {
            name: "power-domain",
            service: "fuchsia.hardware.powerdomain.Service",
        },
        {
            name: "cs-0",
            service: "fuchsia.hardware.gpio.Service",
            availability: "optional",
            bind: {
                rules: { "fuchsia.NAME": "cs-0" },
            },
        },
        {
            name: "gpio-init-0",
            service: "fuchsia.gpio.Init",
            availability: "optional",
        },
        {
            name: "gpio-init-1",
            service: "fuchsia.gpio.Init",
            availability: "optional",
        },

        // The interrupt controller providing the interrupt. Binding to this parent node
        // guarantees correct suspend/resume order relative to the controller of the interrupt.
        {
            name: "interrupt-controller-0",
            availability: "optional",
            bind: {
                rules: { "fuchsia.NAME": "interrupt-controller-0" },
            },
        },
        {
            name: "pin-states-0",
            service: "fuchsia.hardware.pin.PinStatesService",
            availability: "optional",
            bind: {
                rules: { "fuchsia.NAME": "pin-states-0" },
            },
        },
        {
            name: "pin-states-1",
            service: "fuchsia.hardware.pin.PinStatesService",
            availability: "optional",
            bind: {
                rules: { "fuchsia.NAME": "pin-states-1" },
            },
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.spiimpl.Service",
            from: "self",
        },
        {
            service: "fuchsia.hardware.spi.businfo.SpiBusMetadata",
            from: "self",
        },
    ],
}
