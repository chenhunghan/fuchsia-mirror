import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("rust") {
  sources = [
    "src/lib.rs",
    "src/phys_iter.rs",
  ]
  crate_name = "dma_buffer"
  edition = "2024"
  lint_config = "//build/config/rust/lints:clippy_warn_all"
  visibility = [
    ":*",
    "//src/connectivity/ethernet/drivers/gvnic:*",
    "//src/devices/block/drivers/cqhci:*",
    "//src/devices/block/drivers/nvme:*",
    "//src/graphics/display/drivers/virtio-gpu-display:*",
  ]
  deps = [
    "//sdk/rust/zx",
    "//src/lib/fuchsia-runtime",
    "//src/lib/mapped-vmo",
    "//src/lib/shared-buffer",
    "//third_party/rust_crates:zerocopy",
  ]
}
if (is_fuchsia) {
  rustc_test("dma_buffer_lib_test") {
    sources = [
      "src/lib.rs",
      "src/phys_iter.rs",
    ]
    edition = "2024"
    deps = [
             "//sdk/rust/zx",
             "//src/lib/fuchsia-runtime",
             "//src/lib/mapped-vmo",
             "//src/lib/shared-buffer",
             "//third_party/rust_crates:zerocopy",
           ] +
           [
             "//sdk/lib/driver/fake-bti/rust",
             "//src/lib/fuchsia",
             "//third_party/rust_crates:test-case",
           ]
    lint_config = "//build/config/rust/lints:clippy_warn_all"
  }
}

fuchsia_unittest_package("dma-buffer-rust-tests") {
  package_name = "dma-buffer-rust-tests-gn"
  component_name = "dma-buffer-rust-tests"
  deps = [ ":dma_buffer_lib_test" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
