load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [
        ":pipe_io_test_package",
    ],
    visibility = ["//src/devices:__pkg__"],
)

fx_cc_library(
    name = "pipe_io",
    srcs = [
        "pipe_auto_reader.cc",
        "pipe_io.cc",
    ],
    hdrs = [
        "pipe_auto_reader.h",
        "pipe_io.h",
    ],
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = ["//src/graphics/display/drivers/goldfish-display:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.hardware.goldfish:fuchsia.hardware.goldfish_cpp",
        "//sdk/fidl/fuchsia.hardware.goldfish.pipe:fuchsia.hardware.goldfish.pipe_cpp",
        "//sdk/lib/async:async-cpp",
        "//src/devices/lib/dma-buffer",
        "//src/devices/lib/goldfish/pipe_headers",
        "//src/graphics/display/lib/driver-framework-migration-utils/logging:zxlogf",
        "//src/lib/ddk",
        "//src/lib/fxl",
        "//zircon/system/ulib/fbl",
        "//zircon/system/ulib/fzl",
        "//zircon/system/ulib/zircon-internal",
        "//zircon/system/ulib/zx",
    ],
    alwayslink = True,
)

fx_cc_test_binary(
    name = "pipe_io_unittest",
    srcs = ["tests/pipe_io_test.cc"],
    build_flags = ["//build/config:all_source"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        ":pipe_io",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//src/devices/testing/goldfish/fake_pipe",
        "//src/devices/testing/no_ddk",
        "//src/graphics/display/lib/driver-framework-migration-utils/logging:logging-dfv1",
        "//src/lib/fxl/test:gtest_main",
        "//src/lib/testing/loop_fixture",
        "//zircon/system/ulib/sync",
        "//zircon/system/ulib/zircon-internal",
        "//zircon/system/ulib/zx",
        "@com_google_googletest//:gtest",
    ],
)

fx_unittest_package(
    name = "pipe_io_test_package",
    package_name = "goldfish_pipe_io_test",
    unit_tests = [":pipe_io_unittest"],
)
