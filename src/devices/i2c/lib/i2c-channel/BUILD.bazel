load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

fx_cc_library(
    name = "i2c-channel",
    srcs = ["i2c-channel.cc"],
    hdrs = ["i2c-channel.h"],
    # The public header includes Zircon and FIDL headers.
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = [
        "//src/devices/light-sensor/drivers/ams-light:__pkg__",
        "//src/devices/power/drivers/ti-ina231:__pkg__",
        "//src/ui/backlight/drivers/ti-lp8556:__pkg__",
        "//src/ui/input/drivers/focaltech:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.hardware.i2c:fuchsia.hardware.i2c_cpp",
        "//sdk/lib/driver/incoming/cpp",
        "//zircon/system/ulib/zx",
    ],
    alwayslink = True,
)

fx_cc_test_binary(
    name = "i2c-channel-test-bin",
    srcs = ["i2c-channel-test.cc"],
    gn_output_name = "i2c-channel-test",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        ":i2c-channel",
        "//sdk/fidl/fuchsia.hardware.i2c:fuchsia.hardware.i2c_cpp",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async_patterns/testing/cpp",
        "//sdk/lib/component/outgoing/cpp",
        "//src/devices/i2c/testing/fake-i2c",
        "//src/lib/fxl/test:gtest_main",
        "//src/lib/testing/predicates",
        # Bazel googletest has no :gmock target (its :gtest bundles gmock),
        # while GN needs the separate :gmock target for <gmock/gmock.h>.
        "@com_google_googletest//:gtest",  # @bazel2gn:path_overwrite://third_party/googletest:gmock
    ],
)

fx_unittest_package(
    name = "i2c-channel-test",
    unit_tests = [":i2c-channel-test-bin"],
    visibility = ["//src/devices:__pkg__"],
)
