import("//build/components.gni")

# Kept in GN because :vreg-ctl transitively depends on rustc_dylib
# //src/storage/lib/vfs/rust:vfs via //src/lib/fuchsia-component.
fuchsia_package("vreg_ctl_pkg") {
  package_name = "vreg_ctl_pkg"
  deps = [ ":vreg-ctl" ]
}

