import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_binary("batteryutil") {
  sources = [
    "src/battery.rs",
    "src/charger.rs",
    "src/common.rs",
    "src/main.rs",
    "src/spmi.rs",
  ]
  configs += [ "//build/config/rust:bootfs" ]
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.hardware.power.battery:fuchsia.hardware.power.battery_rust",
    "//sdk/fidl/fuchsia.hardware.power.charger:fuchsia.hardware.power.charger_rust",
    "//sdk/fidl/fuchsia.hardware.spmi:fuchsia.hardware.spmi_rust",
    "//sdk/fidl/fuchsia.power.battery:fuchsia.power.battery_rust",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
    "//third_party/rust_crates:futures",
  ]
}
if (is_fuchsia) {
  rustc_test("batteryutil_test") {
    sources = [
      "src/battery.rs",
      "src/charger.rs",
      "src/common.rs",
      "src/main.rs",
      "src/spmi.rs",
    ]
    edition = "2024"
    deps = [
             "//sdk/fidl/fuchsia.hardware.power.battery:fuchsia.hardware.power.battery_rust",
             "//sdk/fidl/fuchsia.hardware.power.charger:fuchsia.hardware.power.charger_rust",
             "//sdk/fidl/fuchsia.hardware.spmi:fuchsia.hardware.spmi_rust",
             "//sdk/fidl/fuchsia.power.battery:fuchsia.power.battery_rust",
             "//src/lib/fidl/rust/fidl",
             "//src/lib/fuchsia",
             "//src/lib/fuchsia-component",
             "//third_party/rust_crates:anyhow",
             "//third_party/rust_crates:argh",
             "//third_party/rust_crates:futures",
           ] + [ "//src/lib/fuchsia-async" ]
    source_root = "src/main.rs"
    configs += [ "//build/config/rust:bootfs" ]
  }
}

fuchsia_unittest_package("batteryutil-tests") {
  package_name = "batteryutil-tests-gn"
  component_name = "batteryutil-tests"
  deps = [ ":batteryutil_test" ]
}
