        "radar-proxy.h",
        "radar-reader-proxy.cc",
        "radar-reader-proxy.h",
        "reader-instance.cc",
        "reader-instance.h",
        "test/radar-proxy-test.h",
        "test/radar-reader-proxy-test.cc",
    ],
    deps = [
        "//sdk/fidl/fuchsia.hardware.radar:fuchsia.hardware.radar_cpp",
        "//sdk/fidl/fuchsia.io:fuchsia.io_cpp",
        "//sdk/lib/async:async-cpp",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        "//sdk/lib/component/incoming/cpp",
        "//sdk/lib/component/outgoing/cpp",
        "//sdk/lib/driver/runtime/testing/cpp",
        "//sdk/lib/fdio",
        "//sdk/lib/fdio-caller",
        "//sdk/lib/fit",
        "//sdk/lib/sys/cpp",
        "//sdk/lib/syslog/cpp",
        "//src/devices/bin/driver_runtime",
        "//src/devices/radar/lib/vmo-manager",
        "//src/lib/fsl",
        "//zircon/system/ulib/fbl",
        "//zircon/system/ulib/fzl",
        "//zircon/system/ulib/sync",
        "//zircon/system/ulib/zx",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_component(
    name = "radar-proxy-test-component-with-injector",
    binary = ":radar-proxy-test-bin-with-injector",
)

fx_cc_test_binary(
    name = "radar-proxy-test-bin-without-injector",
    srcs = [
        "radar-provider-proxy.cc",
        "radar-provider-proxy.h",
        "radar-proxy.h",
        "test/radar-provider-proxy-test.cc",
        "test/radar-proxy-test.h",
    ],
    deps = [
        "//sdk/fidl/fuchsia.hardware.radar:fuchsia.hardware.radar_cpp",
        "//sdk/fidl/fuchsia.io:fuchsia.io_cpp",
        "//sdk/lib/async:async-cpp",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        "//sdk/lib/component/incoming/cpp",
        "//sdk/lib/component/outgoing/cpp",
        "//sdk/lib/driver/runtime/testing/cpp",
        "//sdk/lib/fdio",
        "//sdk/lib/fdio-caller",
        "//sdk/lib/fit",
        "//sdk/lib/sys/cpp",
        "//sdk/lib/syslog/cpp",
        "//src/devices/bin/driver_runtime",
        "//src/devices/radar/lib/vmo-manager",
        "//src/lib/fsl",
        "//zircon/system/ulib/fbl",
        "//zircon/system/ulib/fzl",
        "//zircon/system/ulib/sync",
        "//zircon/system/ulib/zx",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_component(
    name = "radar-proxy-test-component-without-injector",
    binary = ":radar-proxy-test-bin-without-injector",
)

fx_package(
    name = "radar-proxy-test_pkg",
    package_name = "radar-proxy-test",
    test_components = [
        ":radar-proxy-test-component-with-injector",
        ":radar-proxy-test-component-without-injector",
    ],
)

fx_test(
    name = "radar-proxy-test",
    max_log_severity = "ERROR",
    package = ":radar-proxy-test_pkg",
)
