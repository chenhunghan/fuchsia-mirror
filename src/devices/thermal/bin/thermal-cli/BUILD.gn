    "//zircon/system/ulib/zx",
  ]
}

source_set("common") {
  sources = [ "thermal-cli.cc" ]
  public = [ "thermal-cli.h" ]
  deps = [
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/fzl",
  ]
  public_deps = [
    "//sdk/fidl/fuchsia.hardware.thermal:fuchsia.hardware.thermal_cpp",
    "//zircon/system/ulib/zx",
  ]
}

cc_test_executable("thermal-cli-test-bin") {
  sources = [ "test/thermal-cli-test.cc" ]
  output_name = "thermal-cli-test"
  deps = [
    ":common",
    "//sdk/fidl/fuchsia.hardware.thermal:fuchsia.hardware.thermal_cpp",
    "//sdk/lib/async-loop:async-loop-cpp",
    "//sdk/lib/async-loop:async-loop-default",
    "//sdk/lib/driver/runtime/testing/cpp",
    "//src/devices/bin/driver_runtime",
    "//zircon/system/ulib/mock-function",
    "//zircon/system/ulib/zxtest",
  ]
  testonly = true
  emit_tool_path = false
  include_dirs = [ "." ]
}

fuchsia_unittest_package("thermal-cli-test") {
  package_name = "thermal-cli-test-gn"
  component_name = "thermal-cli-test"
  deps = [ ":thermal-cli-test-bin" ]
}
