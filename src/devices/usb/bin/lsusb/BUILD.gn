import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("lib") {
  sources = [
    "src/args.rs",
    "src/descriptors.rs",
    "src/lib.rs",
  ]
  crate_name = "lsusb"
  edition = "2024"
  proc_macro_deps = [ "//third_party/rust_crates:num-derive" ]
  deps = [
    "//sdk/fidl/fuchsia.hardware.usb.device:fuchsia.hardware.usb.device_rust",
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/lib/device-watcher/rust",
    "//sdk/rust/zx-status",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-sync",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:num-traits",
    "//third_party/rust_crates:zerocopy",
  ]
}
if (is_fuchsia) {
  rustc_test("lib_test") {
    sources = [
      "src/args.rs",
      "src/descriptors.rs",
      "src/lib.rs",
    ]
    edition = "2024"
    proc_macro_deps = [ "//third_party/rust_crates:num-derive" ]
    deps = [
             "//sdk/fidl/fuchsia.hardware.usb.device:fuchsia.hardware.usb.device_rust",
             "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
             "//sdk/lib/device-watcher/rust",
             "//sdk/rust/zx-status",
             "//src/lib/fidl/rust/fidl",
             "//src/lib/fuchsia-async",
             "//src/lib/fuchsia-sync",
             "//third_party/rust_crates:anyhow",
             "//third_party/rust_crates:argh",
             "//third_party/rust_crates:futures",
             "//third_party/rust_crates:num-traits",
             "//third_party/rust_crates:zerocopy",
           ] + [ "//src/lib/fuchsia" ]
    output_name = "lsusb_lib_test"
  }
}

fuchsia_unittest_package("lsusb-lib-tests") {
  package_name = "lsusb-lib-tests-gn"
  component_name = "lsusb-lib-tests"
  deps = [ ":lib_test" ]
}

rustc_binary("lsusb") {
  sources = [ "src/main.rs" ]
  configs += [ "//build/config/rust:bootfs" ]
  edition = "2024"
  deps = [
    ":lib",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-fs",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
  ]
}

cc_test_executable("lsusb-test-bin") {
  sources = [ "test.cc" ]
  output_name = "lsusb-test"
  deps = [
    "//sdk/lib/fdio",
    "//zircon/system/ulib/zxtest",
  ]
  testonly = true
  emit_tool_path = false
}

renamed_binary("lsusb-test-bin_packaged") {
  testonly = true
  source = "$root_out_dir/lsusb-test"
  source_deps = [ ":lsusb-test-bin" ]
  dest = "test/lsusb-test"
}

fuchsia_component_manifest("lsusb-test_manifest") {
  testonly = true
  component_name = "lsusb-test"
  manifest = "meta/lsusb-test.cml"
}

fuchsia_test_component("lsusb-test_component") {
  cm_label = ":lsusb-test_manifest"
  deps = [
    ":lsusb",
    ":lsusb-test-bin_packaged",
  ]
}

fuchsia_test_package("lsusb-test_package") {
  package_name = "lsusb-test-gn"
  test_components = [ ":lsusb-test_component" ]
  test_specs = {
    environments = [ nuc11_env ]
  }
}
