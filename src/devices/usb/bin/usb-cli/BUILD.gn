import("//build/assembly/bootfs_files_for_assembly.gni")
import("//build/components.gni")
import("//build/dist/resource.gni")

# Kept in GN because //src/devices/usb/bin:usb-cli and
# //src/devices/usb/usb-policy:tools depend on it in GN, and `:bin`
# transitively depends on `rustc_dylib` `//src/storage/lib/vfs/rust:vfs`
# via `//src/lib/fuchsia-component`.
fuchsia_package("usb-cli") {
  deps = [ ":bin" ]
}

group("tests") {
  testonly = true
  deps = [ ":usb-cli-unit-tests" ]
}

resource("wrapper_script") {
  sources = [ "usb-cli-wrapper.sh" ]
  outputs = [ "bin/usb-cli" ]
  allow_binary_output_dir = true
}

bootfs_files_for_assembly("bootfs") {
  deps = [ ":wrapper_script" ]
}

