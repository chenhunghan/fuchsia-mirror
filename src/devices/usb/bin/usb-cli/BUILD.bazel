load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load(
    "//build/bazel/rules/testing:fx_unittest_package.bzl",
    "fx_unittest_package",
)

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":usb-cli-unit-tests"],
    visibility = ["//src/devices:__pkg__"],
)

rustc_binary(
    name = "bin",
    srcs = [
        "src/config.rs",
        "src/health.rs",
        "src/inspect.rs",
        "src/main.rs",
    ],
    binary_name = "usb-cli",
    edition = "2024",
    deps = [
        "//sdk/fidl/fuchsia.hardware.usb.peripheral:fuchsia.hardware.usb.peripheral_rust",
        "//sdk/fidl/fuchsia.hardware.usb.policy:fuchsia.hardware.usb.policy_rust",
        "//sdk/fidl/fuchsia.usb.policy:fuchsia.usb.policy_rust",
        "//sdk/rust/zx",
        "//src/lib/diagnostics/reader/rust:lib",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:bitflags",
        "//third_party/rust_crates/vendor:chrono",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:serde_json",
    ],
)

rustc_test(
    name = "bin_test",
    crate = ":bin",
    # Preserves the GN test binary name from `rustc_binary(name = "usb-cli", with_unit_tests = true)`.
    crate_name = "usb_cli_bin_test",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//src/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:futures",
    ],
)

fx_unittest_package(
    name = "usb-cli-unit-tests",
    unit_tests = [":bin_test"],
)
