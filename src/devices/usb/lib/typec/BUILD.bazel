load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load(
    "//build/bazel/rules/testing:fx_unittest_package.bzl",
    "fx_unittest_package",
)

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":typec-tests"],
    visibility = ["//src/devices:__pkg__"],
)

_LIB_SRCS = [
    "src/actor.rs",
    "src/cc.rs",
    "src/inspect.rs",
    "src/lib.rs",
    "src/port.rs",
    "src/power.rs",
    "src/runner.rs",
    "src/state.rs",
    "src/state/sink.rs",
    "src/typec.rs",
]

# @bazel2gn:transformer=deps
_LIB_DEPS = [
    "//sdk/fidl/fuchsia.hardware.usb.connector:fuchsia.hardware.usb.connector_rust_next",
    "//sdk/rust/zx",
    "//src/lib/diagnostics/inspect/rust",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-sync",
    "//third_party/rust_crates/vendor:anyhow",
    "//third_party/rust_crates/vendor:futures",
    "//third_party/rust_crates/vendor:log",
]

rustc_library(
    name = "typec",
    srcs = _LIB_SRCS,
    edition = "2024",
    deps = _LIB_DEPS,
)

rustc_test(
    name = "typec_test",
    srcs = _LIB_SRCS + [
        "src/tests/attach.rs",
        "src/tests/boot_and_accessories.rs",
        "src/tests/cc.rs",
        "src/tests/concurrency.rs",
        "src/tests/disconnect.rs",
        "src/tests/fixture.rs",
        "src/tests/inspect.rs",
        "src/tests/mod.rs",
        "src/tests/spec.rs",
        "src/tests/state.rs",
        "src/tests/state_sink.rs",
        "src/tests/vbus.rs",
        "src/tests/vbus_discharge.rs",
    ],
    edition = "2024",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = _LIB_DEPS + [
        "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:assert_matches",
    ],
)

fx_unittest_package(
    name = "typec-tests",
    max_log_severity = "ERROR",
    unit_tests = [":typec_test"],
)
