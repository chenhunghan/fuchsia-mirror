import("//build/components.gni")

# Kept in GN because `:bin` transitively links `rustc_dylib`
# `//src/storage/lib/vfs/rust:vfs_dylib` via `//src/lib/fuchsia-component`.
# `//bundles/assembly/bazel_inputs/src/devices/usb/usb-policy` and
# `//src/devices/usb:packages` consume this package.
fuchsia_package("usb-policy") {
  deps = [ ":service" ]
}

group("tests") {
  testonly = true
  deps = [
    ":usb-policy-integration-tests",
    ":usb-policy-tests",
  ]
}

group("tools") {
  deps = [ "//src/devices/usb/bin/usb-cli" ]
}

