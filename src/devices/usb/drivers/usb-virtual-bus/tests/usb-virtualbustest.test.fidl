library fuchsia.hardware.usb.virtualbustest;

using zx;

/// The maximum size of data payload allowed for a single transfer in tests.
const MAX_DATA_SIZE uint32 = 65536;

/// Protocol for controlling the virtual bus tester from the host side.
closed protocol BusTest {
    /// Performs a control transfer.
    ///
    /// * error Returns a status code indicating success or failure.
    strict Control(struct {
        /// Indicates direction of transfer (true if IN, false if OUT).
        is_in bool;
        /// Data payload for OUT control transfers.
        out_data vector<uint8>:MAX_DATA_SIZE;
    }) -> (struct {
        /// Data payload returned by IN control transfers.
        in_data vector<uint8>:MAX_DATA_SIZE;
    }) error zx.Status;

    /// Performs a bulk OUT transfer.
    ///
    /// * error Returns a status code indicating success or failure.
    strict Out(struct {
        /// Data to write to the device.
        data vector<uint8>:MAX_DATA_SIZE;
    }) -> (struct {
        /// Number of bytes actually written.
        actual uint64;
    }) error zx.Status;

    /// Performs a bulk IN transfer.
    ///
    /// * error Returns a status code indicating success or failure.
    strict In(struct {
        /// Number of bytes to read from the device.
        size uint64;
    }) -> (struct {
        /// Data read from the device.
        data vector<uint8>:MAX_DATA_SIZE;
    }) error zx.Status;
};

/// Protocol for setting up expectations on the virtual bus tester device side.
closed protocol ExpectBusTest {
    /// Configures the device to expect a control transfer.
    ///
    /// * error Returns a status code indicating success or failure.
    strict ExpectControl(struct {
        /// Indicates direction of transfer (true if IN, false if OUT).
        is_in bool;
        /// Expected data payload for OUT control transfers.
        in_data vector<uint8>:MAX_DATA_SIZE;
    }) -> (struct {
        /// Data payload to return for IN control transfers.
        out_data vector<uint8>:MAX_DATA_SIZE;
    }) error zx.Status;

    /// Configures the device to expect a bulk OUT transfer.
    ///
    /// * error Returns a status code indicating success or failure.
    strict ExpectOut() -> (struct {
        /// Data received from the host OUT transfer.
        data vector<uint8>:MAX_DATA_SIZE;
    }) error zx.Status;

    /// Configures the device to expect a bulk IN transfer.
    ///
    /// * error Returns a status code indicating success or failure.
    strict ExpectIn(struct {
        /// Data to return to the host IN transfer.
        data vector<uint8>:MAX_DATA_SIZE;
    }) -> (struct {
        /// Number of bytes actually read by the host.
        actual uint64;
    }) error zx.Status;

    /// Used to sync, i.e. call `Sync()` after `ExpectControl()` to
    /// ensure that `ExpectControl()` has arrived before calling
    /// `Control()`.
    strict Sync() -> ();

    /// Controls virtual bus connection state.
    strict Connect(struct {
        /// Connection status (true for connected).
        connect bool;
    }) -> ();
};

/// Service exposing the BusTest interface.
service BusTestService {
    device client_end:BusTest;
};

/// Service exposing the ExpectBusTest interface.
service ExpectBusTestService {
    device client_end:ExpectBusTest;
};
