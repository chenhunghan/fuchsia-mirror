import("//build/bazel/bazel_fuchsia_test_package.gni")
import("//build/bind/bind.gni")
import("//build/drivers/dml.gni")

# TODO(https://fxbug.dev/348712444): Remove once vendor boards stop listing :package.bazel_input.
group("package.bazel_input") {
}

fuchsia_driver_dml("dwc2-dml") {
  testonly = true
  dml = "meta/dwc2.dml"
  driver_name = "dwc2"
}

bind_test("dwc2_bind_test") {
  rules = "meta/dwc2.bind"
  tests = "meta/tests.json"
  deps = [
    "//src/devices/bind/fuchsia",
    "//src/devices/bind/fuchsia.platform",
  ]
}

bazel_fuchsia_test_package("dwc2-test") {
  test_component_names = [ "dwc2-test-bin" ]
  test_specs = {
    environments = basic_envs
  }
}

group("tests") {
  testonly = true
  deps = [
    ":dwc2-dml_manifest",
    ":dwc2-test",
    ":dwc2_bind_test",
  ]
}
