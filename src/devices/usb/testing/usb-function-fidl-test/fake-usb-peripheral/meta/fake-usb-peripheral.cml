{
    include: [
        "inspect/client.shard.cml",
        "syslog/client.shard.cml",
    ],
    program: {
        runner: "driver",
        binary: "driver/fake-usb-peripheral.so",
        bind: "meta/bind/fake-usb-peripheral.bindbc",
        colocate: "true",
    },
    use: [
        { service: "fuchsia.hardware.usb.function.UsbFunctionService" },
        {
            config: "fuchsia.usb.test.UsbClass",
            key: "usb_class",
            type: "uint8",
            availability: "transitional",
            default: 255,
        },
        {
            config: "fuchsia.usb.test.UsbSubclass",
            key: "usb_subclass",
            type: "int16",
            availability: "transitional",
            default: 0,
        },
        {
            config: "fuchsia.usb.test.UsbProtocol",
            key: "usb_protocol",
            type: "int16",
            availability: "transitional",
            default: 0,
        },
        {
            // 0x18D1 (fuchsia.usb.test.BIND_USB_VID.TEST)
            config: "fuchsia.usb.test.UsbVid",
            key: "usb_vid",
            type: "uint16",
            availability: "transitional",
            default: 6353,
        },
        {
            // 0x0002 (fuchsia.usb.test.BIND_USB_PID.TEST)
            config: "fuchsia.usb.test.UsbPid",
            key: "usb_pid",
            type: "uint16",
            availability: "transitional",
            default: 2,
        },
    ],
}
