load("//build/bazel/rules/bind:bind_library.bzl", "bind_library")

package(default_applicable_licenses = ["//:license"])

bind_library(
    name = "fuchsia.usb",
    src = "fuchsia.usb.bind",
    api_area = "Unknown",
    category = "partner",
    visibility = [
        "//src/camera:__subpackages__",
        "//src/connectivity:__subpackages__",
        "//src/developer:__subpackages__",
        "//src/devices:__subpackages__",
        "//src/firmware:__subpackages__",
        "//src/media:__subpackages__",
        "//src/ui:__subpackages__",
        "//tools/bindc/examples:__pkg__",
    ],
)
