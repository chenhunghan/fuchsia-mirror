load("//build/bazel/rules/bind:bind_library.bzl", "bind_library")

package(default_applicable_licenses = ["//:license"])

# Read by the bindc unit tests.
exports_files(
    ["fuchsia.bind"],
    visibility = ["//tools/bindc:__pkg__"],
)

bind_library(
    name = "fuchsia",
    src = "fuchsia.bind",
    api_area = "Unknown",
    category = "partner",
    visibility = ["//:__subpackages__"],
)

# Compatibility alias for existing Bazel callers; GN callers use `:fuchsia_cpp`.
# @bazel2gn:skip
alias(
    name = "fuchsia_cc",
    actual = ":fuchsia_cpp",
    visibility = [
        "//sdk/lib/driver/compat/cpp:__pkg__",
        "//vendor/google:__subpackages__",
    ],
)
