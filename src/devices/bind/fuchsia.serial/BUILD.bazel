load("//build/bazel/rules/bind:bind_library.bzl", "bind_library")

package(default_applicable_licenses = ["//:license"])

bind_library(
    name = "fuchsia.serial",
    src = "fuchsia.serial.bind",
    api_area = "Driver SDK",
    category = "partner",
    visibility = [
        "//sdk:__pkg__",
        "//sdk/lib/driver/devicetree/visitors/drivers/serial/serial-port:__pkg__",
        "//src/connectivity/bluetooth/hci/transport/uart/cpp:__pkg__",
        "//src/connectivity/bluetooth/hci/transport/uart/rust:__pkg__",
        "//src/devices/serial/drivers/aml-uart:__pkg__",
        "//src/devices/serial/drivers/serial:__pkg__",
        "//vendor/google:__subpackages__",
    ],
)
