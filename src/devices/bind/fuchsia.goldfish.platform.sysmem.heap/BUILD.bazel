fuchsia_bind_cc_library(
    name = "fuchsia.goldfish.platform.sysmem.heap_cc",
    library = "fuchsia.goldfish.platform.sysmem.heap",
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = ["//:__subpackages__"],
