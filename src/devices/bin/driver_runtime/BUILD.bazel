package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [
        ":driver_runtime_death_tests",
        ":driver_runtime_scheduler_role_tests",
        ":driver_runtime_sdk_tests",
        ":driver_runtime_shutdown_process_tests",
        ":driver_runtime_tests",
    ],
    visibility = ["//src/devices:__pkg__"],
)

exports_files(
    ["libdriver_runtime.ifs"],
    visibility = ["//src/devices/lib/driver:__pkg__"],
)

idk_cc_shared_library(
    name = "driver_runtime",
    srcs = [],
    hdrs = [],
    api_area = "Driver SDK",
    category = "partner",
    idk_name = "driver_runtime_shared_lib",
    implementation_deps = [":driver_runtime_impl"],
    libcxx_linkage = "static",
    no_headers = True,
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = ["//:__subpackages__"],
    runtime_deps = [
        "//sdk/lib/fdio",
        "//sdk/lib/svc",
        "//zircon/system/ulib/trace-engine",
    ],
)

