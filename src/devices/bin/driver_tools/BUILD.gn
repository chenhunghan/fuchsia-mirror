import("//build/bazel/bazel_test_suite.gni")
import("//build/components.gni")

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/devices/bin/driver_tools:driver_tools_tests" ]
  host_tests = [ "//src/devices/bin/driver_tools:lib_fdomain_test" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":driver_tools_tests",
    ":lib_fdomain_test($host_toolchain)",
    "tests",
  ]
}

fuchsia_package("package") {
  package_name = "driver"
  deps = [ ":driver_tools" ]
}

