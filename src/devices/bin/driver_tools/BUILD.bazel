    "src/subcommands/disable/mod.rs",
    "src/subcommands/doctor/args.rs",
    "src/subcommands/doctor/mod.rs",
    "src/subcommands/dump/args.rs",
    "src/subcommands/dump/mod.rs",
    "src/subcommands/enable/args.rs",
    "src/subcommands/enable/mod.rs",
    "src/subcommands/health_check/args.rs",
    "src/subcommands/health_check/mod.rs",
