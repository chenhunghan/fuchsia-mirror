load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "lib",
    srcs = ["src/lib.rs"],
    crate_name = "fuchsia_driver_dev",
    edition = "2024",
    visibility = ["//src/devices/bin/driver_tools:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.driver.development:fuchsia.driver.development_rust_flex",
        "//sdk/fidl/fuchsia.driver.framework:fuchsia.driver.framework_rust_flex",
        "//src/lib/fdomain/client:flex_fidl",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
    ],
)

rustc_library(
    name = "lib_fdomain",
    srcs = ["src/lib.rs"],
    crate_features = ["fdomain"],
    crate_name = "fuchsia_driver_dev_fdomain",
    edition = "2024",
    visibility = ["//src/devices/bin/driver_tools:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.driver.development:fuchsia.driver.development_rust_fdomain_flex",
        "//sdk/fidl/fuchsia.driver.framework:fuchsia.driver.framework_rust_fdomain_flex",
        "//src/lib/fdomain/client:flex_fdomain",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
    ],
)
