load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":driver-manager-composite-unittests"],
    visibility = ["//src/devices/bin/driver_manager_rust:__pkg__"],
)

rustc_library(
    name = "driver_manager_composite",
    srcs = [
        "src/composite_manager_bridge.rs",
        "src/composite_node_spec_manager.rs",
        "src/lib.rs",
        "src/parent_set_collector.rs",
        "src/spec.rs",
    ],
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    proc_macro_deps = [
        "//third_party/rust_crates/vendor:async-trait",
    ],
    visibility = [
        "//src/devices/bin/driver_manager_rust/core:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.driver.development:fuchsia.driver.development_rust",
        "//sdk/fidl/fuchsia.driver.framework:fuchsia.driver.framework_rust",
        "//sdk/rust/zx",
        "//src/devices/bin/driver_manager_rust/bind:driver_manager_bind",
        "//src/devices/bin/driver_manager_rust/node:driver_manager_node",
        "//src/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:flyweights",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

rustc_test(
    name = "driver_manager_composite_test",
    crate = ":driver_manager_composite",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    target_compatible_with = ["@platforms//os:fuchsia"],
)

fx_unittest_package(
    name = "driver-manager-composite-unittests",
    unit_tests = [":driver_manager_composite_test"],
)
