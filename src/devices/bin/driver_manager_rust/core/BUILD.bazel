load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":driver-manager-core-unittests"],
    visibility = ["//src/devices/bin/driver_manager_rust:__pkg__"],
)

rustc_library(
    name = "driver_manager_core",
    srcs = [
        "src/bootup_tracker.rs",
        "src/driver_host_runner.rs",
        "src/driver_runner.rs",
        "src/lib.rs",
        "src/memory_attribution.rs",
        "src/offer_injection.rs",
        "src/runner.rs",
        "src/testing.rs",
        "src/trait_impls.rs",
    ],
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    proc_macro_deps = [
        "//third_party/rust_crates/vendor:async-trait",
    ],
    visibility = ["//src/devices/bin/driver_manager_rust:__subpackages__"],
    deps = [
        "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust",
        "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
        "//sdk/fidl/fuchsia.component.runner:fuchsia.component.runner_rust",
        "//sdk/fidl/fuchsia.data:fuchsia.data_rust",
        "//sdk/fidl/fuchsia.driver.crash:fuchsia.driver.crash_rust",
        "//sdk/fidl/fuchsia.driver.development:fuchsia.driver.development_rust",
        "//sdk/fidl/fuchsia.driver.framework:fuchsia.driver.framework_rust",
        "//sdk/fidl/fuchsia.driver.host:fuchsia.driver.host_rust",
        "//sdk/fidl/fuchsia.driver.index:fuchsia.driver.index_rust",
        "//sdk/fidl/fuchsia.driver.loader:fuchsia.driver.loader_rust",
        "//sdk/fidl/fuchsia.driver.token:fuchsia.driver.token_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.ldsvc:fuchsia.ldsvc_rust",
        "//sdk/fidl/fuchsia.memory.attribution:fuchsia.memory.attribution_rust",
        "//sdk/fidl/fuchsia.process:fuchsia.process_rust",
        "//sdk/rust/zx",
        "//src/devices/bin/driver_manager_rust/bind:driver_manager_bind",
        "//src/devices/bin/driver_manager_rust/composite:driver_manager_composite",
        "//src/devices/bin/driver_manager_rust/devfs:driver_manager_devfs",
        "//src/devices/bin/driver_manager_rust/driver_host:driver_manager_driver_host",
        "//src/devices/bin/driver_manager_rust/node:driver_manager_node",
        "//src/devices/bin/driver_manager_rust/shutdown:driver_manager_shutdown",
        "//src/devices/bin/driver_manager_rust/types:driver_manager_types",
        "//src/devices/bin/driver_manager_rust/utils:driver_manager_utils",
        "//src/lib/diagnostics/inspect/rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-runtime",
        "//src/lib/fuchsia-sync",
        "//src/memory/attribution/server",
        "//src/storage/lib/vfs/rust:vfs",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:rand",
    ],
)

rustc_test(
    name = "driver_manager_core_test",
    crate = ":driver_manager_core",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//sdk/fidl/fuchsia.component.runtime:fuchsia.component.runtime_rust",
        "//src/lib/fuchsia",
    ],
)

fx_unittest_package(
    name = "driver-manager-core-unittests",
    unit_tests = [":driver_manager_core_test"],
)
