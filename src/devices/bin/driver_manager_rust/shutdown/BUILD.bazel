load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "driver_manager_shutdown",
    srcs = [
        "src/lib.rs",
        "src/node_removal_tracker.rs",
        "src/node_remover.rs",
        "src/node_shutdown_coordinator.rs",
        "src/shutdown_manager.rs",
        "src/shutdown_node.rs",
    ],
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    proc_macro_deps = ["//third_party/rust_crates/vendor:async-trait"],
    visibility = ["//src/devices/bin/driver_manager_rust:__subpackages__"],
    deps = [
        "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust",
        "//sdk/fidl/fuchsia.kernel:fuchsia.kernel_rust",
        "//sdk/fidl/fuchsia.process.lifecycle:fuchsia.process.lifecycle_rust",
        "//sdk/fidl/fuchsia.system.state:fuchsia.system.state_rust",
        "//sdk/rust/zx",
        "//src/devices/bin/driver_manager_rust/driver_host:driver_manager_driver_host",
        "//src/devices/bin/driver_manager_rust/types:driver_manager_types",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-runtime",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:rand",
    ],
)

rustc_test(
    name = "driver_manager_shutdown_test",
    crate = ":driver_manager_shutdown",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    deps = ["//src/lib/fuchsia"],
)

fx_unittest_package(
    name = "driver-manager-shutdown-unittests",
    max_log_severity = "ERROR",
    unit_tests = [":driver_manager_shutdown_test"],
    visibility = ["//src/devices/bin/driver_manager_rust:__pkg__"],
)
