load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/components:structured_config.bzl",
    "fuchsia_structured_config_rust_lib",
)
load("//build/bazel/rules/fidl:fidl_library.bzl", "fidl_library")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load(
    "//build/bazel/rules/testing:fx_unittest_package.bzl",
    "fx_unittest_package",
)

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":dml-config-unittests"],
    visibility = ["//src/devices:__pkg__"],
)

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [":dml-config_host_test"],
    visibility = ["//src/devices:__pkg__"],
)

fidl_library(
    name = "fuchsia.board.dml.config",
    srcs = ["fidl/config.fidl"],
    # Unused rust_next bindings fail to compile on host because transitive dep
    # //sdk/fidl/fuchsia.driver.metadata uses zx.Status without the `fuchsia` feature.
    # @bazel2gn:skip
    enable_rust_next = False,
    visibility = [
        "//src/devices:__subpackages__",
        "//vendor/google:__subpackages__",
    ],
    deps = ["//sdk/fidl/fuchsia.driver.metadata"],
)

fx_component_manifest(
    name = "board-config-manifest",
    component_name = "board-config",
    manifest = "meta/board_config.cml",
)

fuchsia_structured_config_rust_lib(
    name = "board_structured_config",
    cm_label = ":board-config-manifest",
)

rustc_library(
    name = "dml-config",
    srcs = [
        "src/dump.rs",
        "src/lib.rs",
        "src/parser.rs",
    ],
    edition = "2024",
    visibility = [
        "//src/devices:__subpackages__",
        "//vendor/google:__subpackages__",
    ],
    deps = [
        ":fuchsia.board.dml.config_rust_common",
        "//sdk/fidl/fuchsia.driver.metadata:fuchsia.driver.metadata_rust_common",
        "//src/lib/fidl/rust/fidl",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:phf",
    ] + select({
        "@platforms//os:fuchsia": [
            ":board_structured_config",
            "//sdk/fidl/fuchsia.driver.framework:fuchsia.driver.framework_rust_next",
            "//sdk/fidl/fuchsia.hardware.platform.bus:fuchsia.hardware.platform.bus_rust_next",
            "//sdk/fidl/fuchsia.hardware.power:fuchsia.hardware.power_rust_next",
            "//sdk/lib/driver/runtime/rust/fidl",
            "//sdk/rust/zx",
            "//src/lib/fidl/rust_next/fidl_next",
            "//third_party/rust_crates/vendor:futures",
        ],
        "//conditions:default": [
            "//sdk/fidl/fuchsia.driver.framework:fuchsia.driver.framework_rust_common",
            "//sdk/fidl/fuchsia.hardware.platform.bus:fuchsia.hardware.platform.bus_rust_common",
            "//sdk/fidl/fuchsia.hardware.power:fuchsia.hardware.power_rust_common",
        ],
    }),
)

rustc_binary(
    name = "dml-dump-parsed",
    srcs = ["src/dump_main.rs"],
    crate_root = "src/dump_main.rs",
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//src/devices:__subpackages__",
        "//vendor/google:__subpackages__",
    ],
    deps = [
        ":dml-config",
        "//third_party/rust_crates/vendor:anyhow",
    ],
)

rustc_test(
    name = "dml-config_test",
    srcs = [
        "src/dump.rs",
        "src/lib.rs",
        "src/parser.rs",
    ],
    crate_name = "dml_config_lib_test",
    edition = "2024",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        ":board_structured_config",
        ":fuchsia.board.dml.config_rust_common",
        "//sdk/fidl/fuchsia.driver.framework:fuchsia.driver.framework_rust_next",
        "//sdk/fidl/fuchsia.driver.metadata:fuchsia.driver.metadata_rust_common",
        "//sdk/fidl/fuchsia.hardware.platform.bus:fuchsia.hardware.platform.bus_rust_next",
        "//sdk/fidl/fuchsia.hardware.power:fuchsia.hardware.power_rust_next",
        "//sdk/lib/driver/runtime/rust/fidl",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fidl/rust_next/fidl_next",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:phf",
    ],
)

fx_unittest_package(
    name = "dml-config-unittests",
    unit_tests = [":dml-config_test"],
)

host_rustc_test(
    name = "dml-config_host_test",
    crate = ":dml-config",
)
