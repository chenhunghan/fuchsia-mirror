load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")

package(default_applicable_licenses = ["//:license"])

fx_cc_library(
    name = "smbios",
    srcs = ["smbios.cc"],
    hdrs = ["smbios.h"],
    implementation_deps = [
        "//src/lib/ddk",
        "//zircon/kernel/lib/smbios",
        "//zircon/system/ulib/fbl",
        "//zircon/system/ulib/fzl",
    ],
    visibility = ["//src/devices/board/drivers/x86:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.hardware.platform.bus:fuchsia.hardware.platform.bus_cpp",
        "//zircon/system/ulib/zx",
    ],
    alwayslink = True,
)

# GN's bootfs_test() expects the binary at test/smbios-test via distribution_entries metadata, which cc_test_executable() omits.
# @bazel2gn:raw_attribute:metadata = { distribution_entries = [ { source = rebase_path("$root_out_dir/smbios-test", root_build_dir) destination = "test/smbios-test" label = get_label_info(":smbios-test", "label_with_toolchain") } ] }
fx_cc_test_binary(
    name = "smbios-test",
    srcs = ["smbios-test.cc"],
    deps = [
        ":smbios",
        "//zircon/system/ulib/zxtest",
    ],
)
