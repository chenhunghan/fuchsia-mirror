import("//build/testing/host_test_data.gni")

if (is_host) {
  # LINT.IfChange
  host_test_data("device-child-of-scope") {
    # Fake tables used for everything.
    sources = [
      "device-child-of-scope/dsdt.aml",
      "fake-fadt/facp.aml",
    ]

    outputs = [ "$target_out_dir/device-child-of-scope/{{source_file_part}}" ]
  }

  # LINT.ThenChange(BUILD.bazel)

  group("test-data") {
    testonly = true
    public_deps = [ ":device-child-of-scope" ]
  }
} else {
  group("test-data") {
  }
}
