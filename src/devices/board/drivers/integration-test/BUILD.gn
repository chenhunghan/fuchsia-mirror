fidl("fuchsia.board.test") {
  testonly = true
  sources = [ "board.test.fidl" ]
  visibility = [
    ":*",
    "//src/devices/testing/driver-integration-test-shim:*",
    "//src/devices/tests/isolateddevmgr:*",
  ]
}
