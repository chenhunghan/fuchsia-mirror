import("//build/bind/bind.gni")
import("//build/components.gni")
import("//build/drivers.gni")
import("//build/test.gni")

driver_bind_rules("virt_bind") {
  rules = "meta/virt.bind"
  tests = "meta/bind_tests.json"
  deps = [
    "//src/devices/bind/fuchsia",
    "//src/devices/bind/fuchsia.platform",
  ]
}

group("tests") {
  testonly = true
  deps = [ ":virt_bind_test" ]
  if (current_cpu == "arm64" || current_cpu == "riscv64") {
    deps += [ ":virt-pciroot-test" ]
  }
}

if (current_cpu == "arm64" || current_cpu == "riscv64") {
  fuchsia_cc_driver("virt-driver") {
    output_name = "virt"
    configs += [
      "//build/config:all_source",
      "//build/config/fuchsia:enable_zircon_asserts",
    ]
    sources = [
      "pciroot.cc",
      "rtc.cc",
      "virt.cc",
    ]
    deps = [
      ":virt_bind",
      "//sdk/banjo/fuchsia.hardware.pciroot:fuchsia.hardware.pciroot_banjo_cpp",
      "//sdk/fidl/fuchsia.hardware.platform.bus:fuchsia.hardware.platform.bus_cpp",
      "//sdk/fidl/fuchsia.kernel:fuchsia.kernel_cpp",
      "//sdk/lib/driver/compat/cpp",
      "//sdk/lib/driver/component/cpp",
      "//sdk/lib/driver/logging/cpp",
      "//sdk/lib/inspect/component/cpp",
      "//src/devices/bind/fuchsia.pci:fuchsia.pci_cpp",
      "//src/devices/lib/driver:driver_runtime",
      "//src/devices/pci/lib/pci",
      "//zircon/system/ulib/fbl",
      "//zircon/system/ulib/zx",
    ]
    if (current_cpu == "arm64") {
      deps += [ "//src/devices/bind/fuchsia.platform:fuchsia.platform_cpp" ]
    } else if (current_cpu == "riscv64") {
      deps += [ "//src/devices/bind/fuchsia.google.platform:fuchsia.google.platform_cpp" ]
    }
  }

  fuchsia_driver_component("virt") {
    component_name = "virt"
    deps = [ ":virt-driver" ]
    manifest = "meta/virt.cml"
  }

  test("virt-pciroot-test-bin") {
    output_name = "virt-pciroot-test"
    sources = [
      "pciroot-test.cc",
      "pciroot.cc",
    ]
    deps = [
      "//sdk/banjo/fuchsia.hardware.pciroot:fuchsia.hardware.pciroot_banjo_cpp",
      "//sdk/lib/driver/fake-resource/cpp",
      "//sdk/lib/driver/logging/cpp",
      "//sdk/lib/driver/testing/cpp:scoped_global_logger",
      "//src/devices/pci/lib/pci",
      "//src/lib/fxl/test:gtest_main",
      "//src/lib/testing/predicates",
      "//zircon/system/ulib/zx",
    ]
  }

  fuchsia_unittest_package("virt-pciroot-test") {
    deps = [ ":virt-pciroot-test-bin" ]
  }

  fuchsia_driver_package("package") {
    package_name = "virt"
    driver_components = [ ":virt" ]
    export_to_bazel = true
  }
} else {
  # Provide a placeholder for
  # @gn_targets//src/devices/board/drivers/virt:package so unconfigured Bazel
  # queries (e.g. genquery on //build/images/guest) can resolve all select()
  # branches without pulling the virt board driver into x64 builds.
  generated_file("package") {
    outputs = [ "$target_out_dir/package" ]
    contents = ""
  }

  bazel_input_file("package.bazel_input") {
    generator = ":package"
  }
}
