load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//build/bazel/rules/cc:fx_cc_library_headers.bzl", "fx_cc_library_headers")
load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":block-common-test"],
    visibility = ["//src/devices:__pkg__"],
)

fx_cc_library_headers(
    name = "headers",
    hdrs = ["include/common.h"],
    deps = ["//sdk/lib/driver/logging/cpp"],
)

fx_cc_library(
    name = "common",
    visibility = ["//src/devices/block:__subpackages__"],
    deps = [":headers"],
    alwayslink = True,
)

fx_cc_test_binary(
    name = "common-test",
    srcs = ["common-test.cc"],
    deps = [
        ":common",
        "//sdk/lib/driver/testing/cpp:scoped_global_logger",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_package(
    name = "block-common-test",
    max_log_severity = "ERROR",
    unit_tests = [":common-test"],
)
