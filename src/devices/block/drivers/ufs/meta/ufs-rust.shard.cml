{
    include: [
        "driver_component/driver.shard.cml",
        "inspect/client.shard.cml",
        "syslog/client.shard.cml",
    ],
    program: {
        runner: "driver",
        binary: "driver/ufs_rust.so",
        default_dispatcher_scheduler_role: "fuchsia.devices.storage.ufs.worker",
        allowed_scheduler_roles: [
            "fuchsia.devices.storage.ufs.irq",
            "fuchsia.devices.storage.ufs.worker",
        ],
        suspend_enabled: "true",
    },
    capabilities: [
        { service: "fuchsia.hardware.block.volume.Service" },
        { service: "fuchsia.hardware.rpmb.Service" },
        { service: "fuchsia.hardware.ufs.Service" },
    ],
    use: [
        { protocol: "fuchsia.scheduler.RoleManager" },
        {
            protocol: "fuchsia.power.system.CpuElementManager",
            availability: "optional",
        },
        {
            config: "fuchsia.power.SuspendEnabled",
            key: "suspend_enabled",
            type: "bool",
            availability: "optional",
            default: false,
        },
        {
            config: "fuchsia.power.StoragePowerManagementEnabled",
            key: "storage_power_management_enabled",
            type: "bool",
            availability: "optional",
            default: false,
        },
        {
            config: "fuchsia.storage.ufs.EnableAutoHibernate",
            key: "enable_auto_hibernate",
            type: "bool",
            availability: "optional",
            default: true,
        },
        {
            config: "fuchsia.storage.ufs.AutoHibernateTimerUs",
            key: "auto_hibernate_timer_us",
            type: "uint32",
            availability: "optional",
            default: 2000,
        },
        {
            // Timeout in seconds for admin and query commands, and the diagnostic error-logging
            // interval for overdue data-path I/O slots (which remain pinned rather than aborted
            // while controller DMA remains active).
            config: "fuchsia.storage.ufs.CommandTimeoutSec",
            key: "command_timeout_sec",
            type: "uint32",
            availability: "optional",
            default: 10,
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.block.volume.Service",
            from: "self",
        },
        {
            service: "fuchsia.hardware.rpmb.Service",
            from: "self",
        },
        {
            service: "fuchsia.hardware.ufs.Service",
            from: "self",
        },
    ],
}
