import("//build/bind/bind.gni")
import("//build/components.gni")
import("//build/drivers.gni")
import("//build/rust/rustc_library.gni")
import("//build/test.gni")

fuchsia_driver_dml("nvme-dml") {
  dml = "meta/nvme.dml"
  driver_name = "nvme"
}

driver_bind_rules("nvme_bind") {
  dml_label = ":nvme-dml"
  tests = "meta/bind_tests.json"
  deps = [
    "//src/devices/bind/fuchsia",
    "//src/devices/bind/fuchsia.acpi",
    "//src/devices/bind/fuchsia.pci",
    "//src/devices/bind/fuchsia.pci.massstorage",
  ]
}

group("tests") {
  testonly = true
  deps = [
    ":nvme-rust-tests",
    ":nvme-tests",
    ":nvme_bind_test",
    ":nvme_rust",
  ]
}

common_deps = [
  ":nvme_bind",
  "//sdk/fidl/fuchsia.driver.token:fuchsia.driver.token_cpp",
  "//sdk/fidl/fuchsia.hardware.block.volume:fuchsia.hardware.block.volume_cpp",
  "//sdk/lib/driver/component/cpp",
  "//sdk/lib/driver/mmio/cpp",
  "//sdk/lib/driver/pci/cpp",
  "//sdk/lib/driver/runtime:driver_runtime_cpp",
  "//sdk/lib/inspect/component/cpp",
  "//src/devices/block/lib/common",
  "//src/devices/lib/dev-operation",
  "//src/devices/lib/dma-buffer",
  "//src/devices/lib/driver:driver_runtime",
  "//src/devices/pci/lib/pci",
  "//src/storage/lib/block_server:block_server_cc",
  "//zircon/system/ulib/fbl",
  "//zircon/system/ulib/fzl",
  "//zircon/system/ulib/hwreg",
  "//zircon/system/ulib/inspect",
  "//zircon/system/ulib/sync",
  "//zircon/system/ulib/zircon-internal",
]

fuchsia_cc_driver("nvme-driver") {
  output_name = "nvme"
  configs += [ "//build/config:all_source" ]
  sources = [
    "export.cc",
    "namespace.cc",
    "nvme.cc",
    "queue-pair.cc",
    "queue.cc",
  ]
  deps = common_deps
}

fuchsia_driver_component("nvme") {
  component_name = "nvme"
  deps = [ ":nvme-driver" ]
  dml_label = ":nvme-dml"
}

fuchsia_driver_package("package") {
  package_name = "nvme"
  driver_components = [ ":nvme" ]
}

test("nvme-queue-tests-bin") {
  sources = [
    "queue-test.cc",
    "queue.cc",
  ]
  deps = [
    ":nvme_bind",
    "//src/devices/lib/dma-buffer",
    "//src/devices/testing/fake-bti",
    "//src/lib/fxl/test:gtest_main",
    "//src/lib/testing/predicates",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/hwreg",
  ]
}

fuchsia_unittest_component("nvme-queue-tests") {
  deps = [ ":nvme-queue-tests-bin" ]
}

test("nvme-queue-pair-tests-bin") {
  configs += [ "//build/config/fuchsia:enable_zircon_asserts" ]
  sources = [
    "queue-pair-test.cc",
    "queue-pair.cc",
    "queue.cc",
  ]
  deps = [
    ":nvme_bind",
    "//sdk/lib/driver/logging/cpp",
    "//sdk/lib/driver/mmio/cpp",
    "//sdk/lib/driver/mmio/testing/cpp",
    "//sdk/lib/driver/testing/cpp:scoped_global_logger",
    "//src/devices/lib/dma-buffer",
    "//src/devices/testing/fake-bti",
    "//src/lib/fxl/test:gtest_main",
    "//src/lib/testing/predicates",
    "//src/storage/lib/block_server:block_server_cc",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/hwreg",
    "//zircon/system/ulib/mmio-ptr",
    "//zircon/system/ulib/sync",
  ]
}

fuchsia_unittest_component("nvme-queue-pair-tests") {
  deps = [ ":nvme-queue-pair-tests-bin" ]
}

test("nvme-unit-tests-bin") {
  configs += [ "//build/config:all_source" ]
  sources = [
    "fake/fake-admin-commands.cc",
    "fake/fake-controller.cc",
    "fake/fake-namespace.cc",
    "fake/fake-registers.cc",
    "namespace.cc",
    "nvme-test.cc",
    "nvme.cc",
    "queue-pair.cc",
    "queue.cc",
  ]
  deps = common_deps + [
           "//sdk/lib/driver/testing/cpp",
           "//sdk/lib/driver/testing/cpp:minimal_compat_environment",
           "//sdk/lib/inspect/testing/cpp",
           "//src/devices/testing/fake-bti",
           "//src/lib/fxl/test:gtest_main",
           "//src/lib/testing/predicates",
           "//src/storage/lib/block_client/cpp",
         ]
}

fuchsia_unittest_component("nvme-unit-tests") {
  deps = [ ":nvme-unit-tests-bin" ]
}

fuchsia_test_package("nvme-tests") {
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
  test_components = [
    ":nvme-queue-pair-tests",
    ":nvme-queue-tests",
    ":nvme-unit-tests",
  ]
}

rustc_library("nvme_rust") {
  edition = "2024"
  with_unit_tests = true

  configs += [ "//build/config/rust/lints:clippy_warn_all" ]

  sources = [
    "src/commands.rs",
    "src/inspect.rs",
    "src/io_processor.rs",
    "src/lib.rs",
    "src/namespace.rs",
    "src/queue.rs",
    "src/queue_pair.rs",
    "src/registers.rs",
  ]

  deps = [
    "//sdk/fidl/fuchsia.driver.token:fuchsia.driver.token_rust",
    "//sdk/fidl/fuchsia.hardware.block.volume:fuchsia.hardware.block.volume_rust",
    "//sdk/fidl/fuchsia.hardware.pci:fuchsia.hardware.pci_rust_next",
    "//sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_rust",
    "//sdk/lib/driver/mmio/rust:mmio",
    "//sdk/lib/scheduler/rust",
    "//sdk/rust/zx",
    "//src/devices/lib/dma-buffer/rust",
    "//src/lib/diagnostics/inspect/rust",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fidl/rust_next/fidl_next",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-runtime",
    "//src/lib/fuchsia-sync",
    "//src/storage/lib/block_server",
    "//third_party/rust_crates:bitfield",
    "//third_party/rust_crates:bitflags",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:zerocopy",
  ]

  test_deps = [
    "//sdk/lib/driver/fake-bti/rust",
    "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
    "//src/lib/fuchsia",
    "//src/storage/lib/block_client/rust",
    "//third_party/rust_crates:assert_matches",
  ]
}

fuchsia_unittest_package("nvme-rust-tests") {
  deps = [ ":nvme_rust_test" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
