load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")

package(default_applicable_licenses = ["//:license"])

fx_cc_binary(
    name = "iochk",
    srcs = ["iochk.cc"],
    # TODO(https://fxbug.dev/42085293): delete the below and fix compiler warnings
    copts = ["-Wno-vla-cxx-extension"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = [
        "//src/devices/block/bin:__pkg__",
        "//src/devices/block/drivers/ftl/tests:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.hardware.skipblock:fuchsia.hardware.skipblock_cpp",
        "//sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_cpp",
        "//sdk/lib/fdio",
        "//sdk/lib/fdio-caller",
        "//src/storage/lib/block_client/cpp",
        "//zircon/system/ulib/fbl",
        "//zircon/system/ulib/fzl",
        "//zircon/system/ulib/sync",
        "//zircon/system/ulib/zircon-internal",
        "//zircon/system/ulib/zx",
    ],
)
