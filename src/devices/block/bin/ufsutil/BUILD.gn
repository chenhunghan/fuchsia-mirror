executable("ufsutil") {
  sources = [
    "main.cc",
    "query.cc",
    "query.h",
    "ufsutil.cc",
    "ufsutil.h",
  ]
  deps = [
    "//sdk/fidl/fuchsia.hardware.ufs:fuchsia.hardware.ufs_cpp",
    "//sdk/lib/component/incoming/cpp",
    "//src/lib/files",
    "//zircon/third_party/ulib/safemath",
  ]
}

cc_test_executable("ufsutil-test-bin") {
  sources = [
    "query.cc",
    "query.h",
    "ufsutil-test.cc",
    "ufsutil.cc",
    "ufsutil.h",
  ]
  output_name = "ufsutil-test"
  deps = [
    "//sdk/fidl/fuchsia.hardware.ufs:fuchsia.hardware.ufs_cpp",
    "//sdk/fidl/fuchsia.hardware.ufs:fuchsia.hardware.ufs_cpp_testing",
    "//sdk/lib/async-loop:async-loop-cpp",
    "//sdk/lib/async-loop:async-loop-default",
    "//sdk/lib/component/incoming/cpp",
    "//src/lib/files",
    "//zircon/system/ulib/zxtest",
    "//zircon/third_party/ulib/safemath",
  ]
  testonly = true
  emit_tool_path = false
}

fuchsia_unittest_package("ufsutil-test") {
  package_name = "ufsutil-test-gn"
  component_name = "ufsutil-test"
  deps = [ ":ufsutil-test-bin" ]
}
