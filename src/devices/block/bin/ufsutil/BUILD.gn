import("//build/assembly/bootfs_files_for_assembly.gni")

# Binary BootFS assembly inputs stay in GN until Bazel BootFS binary support
# lands.
bootfs_files_for_assembly("bootfs") {
  deps = [ ":ufsutil" ]
}

group("tests") {
  testonly = true
  deps = [ ":ufsutil-test" ]
}

