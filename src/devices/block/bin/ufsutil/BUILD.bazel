load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":ufsutil-test"],
    visibility = ["//src/devices:__pkg__"],
)

fx_cc_binary(
    name = "ufsutil",
    srcs = [
        "common.h",
        "error-history.cc",
        "error-history.h",
        "main.cc",
        "query.cc",
        "query.h",
        "rpmb.cc",
        "rpmb.h",
        "rpmb-frame.h",
        "ufsutil.cc",
        "ufsutil.h",
        "uic.cc",
        "uic.h",
    ],
    deps = [
        "//sdk/fidl/fuchsia.hardware.rpmb:fuchsia.hardware.rpmb_cpp",
        "//sdk/fidl/fuchsia.hardware.ufs:fuchsia.hardware.ufs_cpp",
        "//sdk/lib/component/incoming/cpp",
        "//src/lib/files",
        "//third_party/boringssl:crypto",
        "//zircon/system/ulib/fzl",
        "//zircon/third_party/ulib/safemath",
    ],
)

fx_cc_test_binary(
    name = "ufsutil-test-bin",
    srcs = [
        "common.h",
        "error-history.cc",
        "error-history.h",
        "query.cc",
        "query.h",
        "rpmb.cc",
        "rpmb.h",
        "rpmb-frame.h",
        "rpmb-test.cc",
        "ufsutil.cc",
        "ufsutil.h",
        "ufsutil-test.cc",
        "uic.cc",
        "uic.h",
    ],
    # Error history and RPMB read tests write their output files under /tmp.
    aspect_hints = ["//src/sys/test_runners:tmp_storage"],
    gn_output_name = "ufsutil-test",
    # Packaged into :ufsutil-test below; do not run bare.
    tags = ["manual"],
    deps = [
        "//sdk/fidl/fuchsia.hardware.rpmb:fuchsia.hardware.rpmb_cpp",
        "//sdk/fidl/fuchsia.hardware.ufs:fuchsia.hardware.ufs_cpp",
        "//sdk/fidl/fuchsia.hardware.ufs:fuchsia.hardware.ufs_cpp_testing",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        "//sdk/lib/component/incoming/cpp",
        "//src/lib/files",
        "//third_party/boringssl:crypto",
        "//zircon/system/ulib/fzl",
        "//zircon/system/ulib/zxtest",
        "//zircon/third_party/ulib/safemath",
    ],
)

fx_unittest_package(
    name = "ufsutil-test",
    unit_tests = [":ufsutil-test-bin"],
)
