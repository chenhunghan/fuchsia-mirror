load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [":fidlgen_banjo_unittests"],
    visibility = ["//src/devices:__pkg__"],
)

# Write a .rs file containing all the IRs needed by tests.
# For remote-build-ability, paths must be at least relative to test source.
# For consistency across different output dirs, paths should be relative
# to the root_build_dir, which lives under the test source dir.
# In Bazel, lib.rs and fidl/<name>.fidl.json share the output package directory.
write_file(
    name = "irs_lib_rs",
    testonly = True,
    out = "lib.rs",
    content = [
        line
        for name in [
            "alias",
            "alignment",
            "api",
            "attributes",
            "binary",
            "bits",
            "buffer",
            "callback",
            "callback2",
            "constants",
            "empty",
            "enums",
            "example0",
            "example1",
            "example2",
            "example3",
            "example4",
            "example6",
            "example7",
            "example8",
            "example9",
            "fidlhandle",
            "handles",
            "interface",
            "order",
            "order1",
            "order2",
            "order3",
            "order4",
            "order5",
            "order6",
            "order7",
            "passcallback",
            "point",
            "preservenames",
            "protocolarray",
            "protocolbase",
            "protocolhandle",
            "protocolothertypes",
            "protocolprimitive",
            "protocolvector",
            "references",
            "rustderive",
            "simple",
            "tables",
            "types",
            "union",
            "view",
        ]
        for line in [
            "pub mod {} {{".format(name),
            '    pub static IR: &str = include_str!("fidl/{}.fidl.json");'.format(name),
            "}",
        ]
    ],
)

# Expose the IRs in a standard Rust library.
rustc_library(
    name = "irs",
    testonly = True,
    srcs = ["lib.rs"],
    compile_data = ["//src/devices/tools/fidlgen_banjo/tests/fidl"],
    crate_name = "test_irs",
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
)

