load("//build/bazel/rules/fidl:fidl_library.bzl", "fidl_library")

package(default_applicable_licenses = ["//:license"])

# Depend on this target to have the IRs generated for all test FIDL libraries.
filegroup(
    name = "fidl",
    testonly = True,
    srcs = [
        ":alias",
        ":alignment",
        ":api",
        ":attributes",
        ":binary",
        ":bits",
        ":buffer",
        ":callback",
        ":callback2",
        ":constants",
        ":empty",
        ":enums",
        ":example0",
        ":example1",
        ":example2",
        ":example3",
        ":example4",
        ":example6",
        ":example7",
        ":example8",
        ":example9",
        ":fidlhandle",
        ":handles",
        ":interface",
        ":order",
        ":order1",
        ":order2",
        ":order3",
        ":order4",
        ":order5",
        ":order6",
        ":order7",
        ":passcallback",
        ":point",
        ":preservenames",
        ":protocolarray",
        ":protocolbase",
        ":protocolhandle",
        ":protocolothertypes",
        ":protocolprimitive",
        ":protocolvector",
        ":references",
        ":rustderive",
        ":simple",
        ":tables",
        ":types",
        ":union",
        ":view",
    ],
    visibility = ["//src/devices/tools/fidlgen_banjo/tests:__pkg__"],
)

# Note: badtype.test.fidl verifies that the banjo parser correctly fails, and
# parameterattributes.test.fidl is an AST-only test; neither is compiled here.

fidl_library(
    name = "alias",
    testonly = True,
    srcs = ["alias.test.fidl"],
    enable_cpp = False,
