load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":fake-mmio-reg-test"],
    visibility = ["//src/devices:__pkg__"],
)

fx_cc_test_binary(
    name = "fake-mmio-reg-test-bin",
    srcs = ["fake-mmio-reg-test.cc"],
    disable_build_flags = ["//build/config/fuchsia:fdio_config"],
    gn_output_name = "fake-mmio-reg-test",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//sdk/lib/driver/mmio/cpp",
        "//sdk/lib/driver/mmio/testing/cpp",
        "//sdk/lib/fdio",
        "//sdk/lib/fit",
        "//src/devices/testing/fake-mmio-reg",
        "//src/lib/ddk",
        "//zircon/system/ulib/zx",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_package(
    name = "fake-mmio-reg-test",
    unit_tests = [":fake-mmio-reg-test-bin"],
)
