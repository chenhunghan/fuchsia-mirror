# fake-dma-buffer library that should eventually go into SDK

load("//build/bazel/rules/cc:fx_cc_source_library_zx.bzl", "fx_cc_source_library_zx")

package(default_applicable_licenses = ["//:license"])

fx_cc_source_library_zx(
    name = "fake-dma-buffer",
    testonly = True,
    srcs = [
        "fake-dma-buffer.cc",
    ],
    hdrs = [
        "include/fake-dma-buffer/fake-dma-buffer.h",
    ],
    includes = [
        "include",
    ],
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = [
        "//src/devices/testing/fake-dma-buffer/test:__pkg__",
        "//src/devices/usb/drivers/xhci/tests:__pkg__",
    ],
    deps = [
        "//sdk/lib/fit",
        "//src/devices/lib/dma-buffer",
        "//zircon/system/ulib/fbl",
        "//zircon/system/ulib/zx",
    ],
)
