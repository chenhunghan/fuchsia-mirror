load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":fake-msi-test"],
    visibility = ["//src/devices:__pkg__"],
)

fx_cc_test_binary(
    name = "fake-msi-test-bin",
    srcs = ["fake-msi-test.cc"],
    disable_build_flags = select({
        "@platforms//os:fuchsia": ["//build/config/fuchsia:fdio_config"],
    }),
    gn_output_name = "fake-msi-test",
    deps = [
        "//src/devices/testing/fake-msi",
        "//zircon/system/ulib/fbl",
        "//zircon/system/ulib/zx",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_package(
    name = "fake-msi-test",
    unit_tests = [":fake-msi-test-bin"],
)
