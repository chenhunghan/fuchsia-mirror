load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")

package(default_applicable_licenses = ["//:license"])

fx_cc_library(
    name = "no_ddk",
    testonly = True,
    srcs = ["no_ddk.cc"],
    # GN sets -D_ALL_SOURCE via the //build/config:all_source config.
    configs = ["//build/config:all_source"],
    implementation_deps = [
        "//sdk/lib/fdio",
        "//src/lib/ddk",
        "//zircon/system/ulib/zx",
    ] + select({
        "@platforms//os:fuchsia": [
            "//src/devices/bin/driver_runtime",
        ],
        "//conditions:default": [],
    }),
    # TODO(https://fxbug.dev/421888626): GN sets _ALL_SOURCE via configs +=
    # ["//build/config:all_source"] above, whereas fx_cc_library(configs) is
    # only used by bazel2gn.
    # @bazel2gn:skip
    local_defines = ["_ALL_SOURCE"],
    visibility = ["//:__subpackages__"],
    alwayslink = True,
)
