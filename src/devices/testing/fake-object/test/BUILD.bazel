load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

fx_cc_test_binary(
    name = "fake-object-test-bin",
    srcs = ["fake-object-test.cc"],
    disable_build_flags = select({
        "@platforms//os:fuchsia": ["//build/config/fuchsia:fdio_config"],
    }),
    gn_output_name = "fake-object-test",
    tags = ["manual"],
    deps = [
        "//src/devices/testing/fake-object",
        "//zircon/system/ulib/fbl",
        "//zircon/system/ulib/zx",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_package(
    name = "fake-object-test",
    unit_tests = [":fake-object-test-bin"],
    visibility = [
        "//src/devices:__pkg__",
        "//src/devices/testing/fake-object:__pkg__",
    ],
)
