    name = "fake-resource",
    testonly = True,
    srcs = ["fake-resource.cc"],
    hdrs = ["include/lib/fake-resource/resource.h"],
    build_flags = ["//build/config/fuchsia:static_cpp_standard_library"],
    implementation_deps = [
