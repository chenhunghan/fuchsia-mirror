load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":mock-mmio-reg-test"],
    visibility = ["//src/devices:__pkg__"],
)

fx_cc_test_binary(
    name = "mock-mmio-reg-test-bin",
    srcs = ["mock-mmio-reg-test.cc"],
    disable_build_flags = select({
        "@platforms//os:fuchsia": ["//build/config/fuchsia:fdio_config"],
        "//conditions:default": [],
    }),
    gn_output_name = "mock-mmio-reg-test",
    deps = [
        "//sdk/lib/driver/mmio/cpp",
        "//src/devices/testing/mock-mmio-reg",
        "//src/lib/fxl/test:gtest_main",
        "@com_google_googletest//:gtest",
    ],
)

fx_unittest_package(
    name = "mock-mmio-reg-test",
    unit_tests = [":mock-mmio-reg-test-bin"],
)
