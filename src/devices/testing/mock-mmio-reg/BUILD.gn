import("//build/cpp/sdk_source_set.gni")

group("tests") {
  testonly = true
  deps = [ "test:mock-mmio-reg-test" ]
}

config("headers.config") {
  include_dirs = [ "include" ]
}

config("zxtest-backend") {
  defines = [ "MOCK_MMIO_REG_USE_ZXTEST" ]
}

# Kept hand-written because it is an internal-category SDK atom, which the
# Bazel `idk_cc_source_library()` cannot express. Keep in sync with the
# `mock-mmio-reg` target in BUILD.bazel.
# LINT.IfChange(mock-mmio-reg)
sdk_source_set("mock-mmio-reg") {
  category = "internal"
  sdk_name = "mock-mmio-reg"
  public = [ "include/mock-mmio-reg/mock-mmio-reg.h" ]
  public_deps = [
    "//sdk/lib/driver/mmio/cpp",
    "//sdk/lib/driver/mmio/testing/cpp",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/mmio-ptr",
  ]
  non_sdk_public_deps = [ "//third_party/googletest:gtest_no_testonly" ]
  public_configs = [ ":headers.config" ]
}

# LINT.ThenChange(//src/devices/testing/mock-mmio-reg/BUILD.bazel:mock-mmio-reg)

