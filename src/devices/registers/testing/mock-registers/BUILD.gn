cc_test_executable("mock-registers-test") {
  sources = [ "mock-registers-test.cc" ]
  deps = [
    ":mock-registers",
    "//sdk/lib/async-loop:async-loop-cpp",
    "//sdk/lib/async-loop:async-loop-default",
    "//zircon/system/ulib/zx",
    "//zircon/system/ulib/zxtest",
  ]
  testonly = true
  emit_tool_path = false
}

fuchsia_unittest_package("mock-registers-test-package") {
  package_name = "mock-registers-test-gn"
  component_name = "mock-registers-test"
  deps = [ ":mock-registers-test" ]
  visibility = [
    ":*",
    "//src/devices:*",
  ]
}
