{
    include: [ "syslog/client.shard.cml" ],
    program: {
        runner: "elf",
        binary: "bin/loadbench",
        args: [
            "-v",
            "/pkg/data/asymmetric_fair_starvation.json",
        ],
    },
    use: [
        {
            protocol: [
                "fuchsia.kernel.InfoResource",
                "fuchsia.kernel.ProfileResource",
                "fuchsia.kernel.TracingResource",
            ],
        },
        {
            storage: "tmp",
            path: "/tmp",
        },
    ],
}
