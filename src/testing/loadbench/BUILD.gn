import("//build/tools/bazel2gn/bazel_migration.gni")

source_set("lib") {
  sources = [
    "tracing.cc",
    "utility.cc",
    "workload.cc",
  ]
  public = [
    "action.h",
    "measurement.h",
    "object.h",
    "random.h",
    "tracing.h",
    "utility.h",
    "worker.h",
    "workload.h",
  ]
  deps = [
    "//sdk/fidl/fuchsia.kernel:fuchsia.kernel_hlcpp",
    "//src/lib/files",
    "//third_party/re2",
  ]
  public_deps = [
    "//sdk/lib/fdio",
    "//sdk/lib/syslog/cpp",
    "//src/performance/lib/fxt",
    "//third_party/rapidjson",
    "//zircon/system/ulib/sync",
    "//zircon/system/ulib/trace-reader",
    "//zircon/system/ulib/zircon-internal",
    "//zircon/system/ulib/zx",
  ]
}

executable("bin") {
  sources = [ "loadbench.cc" ]
  output_name = "loadbench"
  deps = [ ":lib" ]
}

resource("loadbench_data") {
  sources = [
    "data/asymmetric_fair_starvation.json",
    "data/deadline_spin_one_cpu.json",
    "data/deadline_spin_one_cpu_fair_hog.json",
    "data/deadline_test.json",
    "data/example.json",
    "data/port_test.json",
  ]
  outputs = [ "data/{{source_file_part}}" ]
}

fuchsia_component_manifest("loadbench_component_manifest") {
  component_name = "loadbench"
  manifest = "meta/loadbench.cml"
}

fuchsia_component("loadbench_component") {
  cm_label = ":loadbench_component_manifest"
  deps = [
    ":bin",
    ":loadbench_data",
  ]
}

fuchsia_component_manifest("loadbench_cli_manifest") {
  component_name = "loadbench_cli"
  manifest = "meta/loadbench_cli.cml"
}

fuchsia_component("loadbench_cli") {
  cm_label = ":loadbench_cli_manifest"
  deps = [
    ":bin",
    ":loadbench_data",
  ]
}

cc_test_executable("loadbench_unittests") {
  sources = [
    "tracing_unittest.cc",
    "workload_unittest.cc",
  ]
  deps = [
    ":lib",
    "//src/lib/fxl/test:gtest_main",
    "//src/performance/lib/fxt",
    "//third_party/googletest:gtest",
    "//third_party/re2",
  ]
  testonly = true
  emit_tool_path = false
}

fuchsia_component_manifest("loadbench_unittests_manifest") {
  testonly = true
  component_name = "loadbench_unittests"
  manifest = "meta/loadbench_unittests.cml"
}

fuchsia_test_component("loadbench_unittests_component") {
  cm_label = ":loadbench_unittests_manifest"
  deps = [
    ":loadbench_data",
    ":loadbench_unittests",
  ]
  test_type = "system"
}

fuchsia_test_package("loadbench_tests_package") {
  package_name = "loadbench_tests-gn"
  test_components = [ ":loadbench_unittests_component" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
