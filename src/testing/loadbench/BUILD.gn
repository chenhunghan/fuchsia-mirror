import("//build/bazel/bazel_fuchsia_package.gni")

# //src/testing:testing still references this package from GN.
bazel_fuchsia_package("loadbench") {
  bazel_config = "fuchsia_platform"
}

group("tests") {
  testonly = true
  public_deps = [ ":loadbench_tests_package" ]
}

