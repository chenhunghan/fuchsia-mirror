{
    include: [ "//src/testing/system-validation/web/apps/meta/web_view.shard.cml" ],
    use: [
        {
            config: "fuchsia.testing.web.JavascriptFile",
            key: "javascript_file",
            type: "string",
            max_size: 2048,
            availability: "transitional",
            default: "/pkg/data/javascripts/simple_video.js",
        },
    ],
}
