rustc_library("server") {
  sources = [ "src/server.rs" ]
  source_root = "src/server.rs"
  edition = "2024"
  proc_macro_deps = [ "//third_party/rust_crates:async-trait" ]
  deps = [
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-fs",
    "//src/lib/fuchsia-hyper",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:hyper",
    "//third_party/rust_crates:log",
  ]
}

rustc_binary("bin") {
  sources = [ "src/main.rs" ]
  output_name = "file_server"
  edition = "2024"
  deps = [
    ":server",
    "//src/lib/fuchsia",
    "//third_party/rust_crates:anyhow",
  ]
  data_deps = [ ":server_data" ]
}

fuchsia_component_manifest("file_server_manifest") {
  component_name = "file_server"
  manifest = "meta/file_server.cml"
}

fuchsia_component("file_server_component") {
  cm_label = ":file_server_manifest"
  visibility = [
    ":*",
    "//src/testing/system-validation/web:*",
  ]
  deps = [ ":bin" ]
}
