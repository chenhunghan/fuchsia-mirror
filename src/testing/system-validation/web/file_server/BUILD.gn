  files = [
    {
      source = "data/test_video.webm"
      dest = "data/sample_video.webm"
    },
    {
      source = "data/fuchsia_logo.png"
      dest = "data/fuchsia_logo.png"
    },
    {
      source = "data/100Hz_tone.mp3"
      dest = "data/100Hz_tone.mp3"
    },
  ]
}

