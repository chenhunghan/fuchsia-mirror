load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [],  # Include all tests in the package.
    visibility = ["//src/testing:__pkg__"],
)

rustc_library(
    name = "system_validation_lib",
    srcs = [
        "src/app_monitor.rs",
        "src/lib.rs",
        "src/screencapture.rs",
        "src/single_session_trace.rs",
    ],
    edition = "2024",
    visibility = ["//:__subpackages__"],
    deps = [
        "//sdk/fidl/fuchsia.tracing.controller:fuchsia.tracing.controller_rust",
        "//sdk/fidl/fuchsia.ui.composition:fuchsia.ui.composition_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-sync",
        "//src/lib/mapped-vmo",
        "//src/sys/lib/component-events",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:png",
    ],
)

rustc_test(
    name = "system_validation_lib_test",
    crate = ":system_validation_lib",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
)

fx_unittest_package(
    name = "system-validation-lib-tests",
    unit_tests = [":system_validation_lib_test"],
)
