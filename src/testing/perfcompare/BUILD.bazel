load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_py_test.bzl", "host_py_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "host_tests",
    tests = [
        ":local_workflow_test",
        ":perfcompare_test",
    ],
    visibility = ["//src/testing:__pkg__"],
)

host_py_test(
    name = "local_workflow_test",
    srcs = [
        "local_workflow.py",
        "local_workflow_test.py",
        "perfcompare.py",
        "stats.py",
    ],
    imports = ["."],
    main = "local_workflow_test.py",
    target_compatible_with = HOST_OS_CONSTRAINTS,
)

host_py_test(
    name = "perfcompare_test",
    srcs = [
        "local_workflow.py",
        "perfcompare.py",
        "perfcompare_test.py",
        "stats.py",
    ],
    imports = ["."],
    main = "perfcompare_test.py",
    main_callable = "TestMain",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    test_data = ["perfcompare_test_output.txt"],
)
