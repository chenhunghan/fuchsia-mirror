import("//build/bazel/bazel_test_suite.gni")

group("testing") {
  testonly = true
  deps = [
    ":tests",
    "fuzzing",
    "loadbench",
  ]
}

group("tests") {
  testonly = true

  deps = [
    ":bazel_tests",
    "catapult_converter:tests",
    "fuzzing:tests",
    "host-target-testing:tests",
    "loadbench:tests",
    "realm_client:tests",
    "sl4f:tests",
    "trf_codegen/bin:tests",
    "trf_codegen/lib/macro:tests",
  ]
}

group("e2e_tests") {
  testonly = true

  deps = []

  if (!is_asan) {
    # Do not run host-driven tests on Fuchsia's `asan` build variant.
    deps += [
      "end_to_end/examples:emulator_tests($host_toolchain)",
      "end_to_end/mobly_driver/tests/functional_tests:tests",
    ]
  }
}

bazel_test_suite("bazel_tests") {
  host_tests = [ "//src/testing:host_tests" ]
  target_tests = [ "//src/testing:target_tests" ]
}
