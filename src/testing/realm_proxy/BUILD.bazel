load("//build/bazel/rules/components:cml_shard.bzl", "cml_shard")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

cml_shard(
    name = "service/meta/realm_proxy.shard",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/sys/component:realm_builder.shard",
        "//sdk/lib/syslog:client.shard",
    ],
    shard = "service/meta/realm_proxy.shard.cml",
    visibility = [
        "//sdk/ctf/tests/examples/fidl/fuchsia.examples/testing/realm-factory:__pkg__",
        "//sdk/ctf/tests/fidl/fuchsia.element/testing/realm-factory:__pkg__",
        "//src/sys/pkg/tests/pkgdir/test_realm_proxy:__pkg__",
    ],
)

rustc_library(
    name = "realm_proxy",
    testonly = True,
    srcs = [
        "src/error.rs",
        "src/lib.rs",
        "src/service.rs",
    ],
    edition = "2024",
    visibility = ["//:__subpackages__"],
    deps = [
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.testing.harness:fuchsia.testing.harness_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-component-test:fuchsia-component-test-lib",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)
