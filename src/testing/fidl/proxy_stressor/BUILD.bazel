load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "proxy_stressor_bin",
    testonly = True,
    srcs = ["src/server.rs"],
    binary_name = "proxy_stressor",
    crate_root = "src/server.rs",
    edition = "2024",
    tags = ["manual"],
    deps = [
        "//sdk/rust/zx",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//src/testing/fidl/proxy_stressor/fidl:test.proxy.stress_rust",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

fx_packaged_binary(
    name = "bin",
    testonly = True,
    binary = ":proxy_stressor_bin",
    binary_name = "proxy_stressor",
)

fx_component_manifest(
    name = "manifest",
    testonly = True,
    component_name = "proxy_stressor",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/server.cml",
)

fx_component(
    name = "proxy_stressor",
    testonly = True,
    compiled_manifest = ":manifest",
    visibility = ["//src/developer/ffx/tests/connection:__pkg__"],
    deps = [":bin"],
)
