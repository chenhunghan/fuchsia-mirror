import("//build/bazel/bazel_host_tool.gni")

if (is_host) {
  bazel_host_tool("converter_bin") {
    bazel_target = ":converter_bin"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/converter_bin"
    output_name = "catapult_converter"
    install_host_tool = true
  }
}

group("host_tools") {
  deps = [ ":converter_bin($host_toolchain)" ]
}

group("tests") {
  testonly = true
  deps = [ ":host_tools" ]
}
