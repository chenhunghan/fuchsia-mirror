import("//build/python/python_host_test.gni")

if (is_host) {
  python_host_test("uci_commands_test") {
    main_source = "uci_commands_test.py"
    libraries =
        [ "//src/testing/end_to_end/mobly_controller/openwrt_access_point" ]
    main_callable = "unittest.main"
    extra_args = [ "-v" ]
  }

  python_host_test("dhcp_controller_test") {
    main_source = "dhcp_controller_test.py"
    libraries =
        [ "//src/testing/end_to_end/mobly_controller/openwrt_access_point" ]
    main_callable = "unittest.main"
    extra_args = [ "-v" ]
  }
}

group("tests") {
  testonly = true
  public_deps = [
    ":dhcp_controller_test($host_toolchain)",
    ":uci_commands_test($host_toolchain)",
  ]
}
