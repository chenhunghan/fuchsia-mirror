load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_py_test.bzl", "host_py_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [
        ":iperf_client_test",
        ":iperf_server_test",
    ],
    visibility = ["//src/testing:__pkg__"],
)

host_py_test(
    name = "iperf_server_test",
    testonly = True,
    srcs = ["iperf_server_test.py"],
    main = "iperf_server_test.py",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    test_args = ["-v"],
    deps = [
        "//src/testing/end_to_end/libs",
        "//src/testing/end_to_end/mobly_controller/iperf",
        "//third_party/mobly",
    ],
)

host_py_test(
    name = "iperf_client_test",
    testonly = True,
    srcs = ["iperf_client_test.py"],
    main = "iperf_client_test.py",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    test_args = ["-v"],
    deps = [
        "//src/testing/end_to_end/libs",
        "//src/testing/end_to_end/mobly_controller/iperf",
        "//third_party/mobly",
    ],
)
