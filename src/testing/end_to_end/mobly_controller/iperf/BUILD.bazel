load("@rules_python//python:py_library.bzl", "py_library")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")

package(default_applicable_licenses = ["//:license"])

# Synced to BUILD.gn via bazel2gn for remaining GN consumers.
py_library(
    name = "iperf",
    testonly = True,
    srcs = [
        "__init__.py",
        "iperf_client.py",
        "iperf_server.py",
    ],
    imports = [".."],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//src/connectivity/wlan/tests:__subpackages__",
        "//src/testing/end_to_end/mobly_base_tests:__pkg__",
        "//src/testing/end_to_end/mobly_controller/iperf/tests:__pkg__",
        "//src/testing/end_to_end/mobly_controller/openwrt_access_point:__pkg__",
        "//vendor/google:__subpackages__",
    ],
    deps = [
        "//src/testing/end_to_end/libs",
        "//third_party/mobly",
    ],
)
