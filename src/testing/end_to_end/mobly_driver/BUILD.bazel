load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")

package(default_applicable_licenses = ["//:license"])

# Keep mypy in GN: GN-only consumers that run mypy (e.g.
# tests/unit_tests:init_test) need type information from it.
# @bazel2gn:raw_attribute:enable_mypy = true
py_library(
    name = "mobly_driver",
    srcs = [
        "mobly_driver/__init__.py",
        "mobly_driver/api/__init__.py",
        "mobly_driver/api/api_ffx.py",
        "mobly_driver/api/api_infra.py",
        "mobly_driver/api/api_mobly.py",
        "mobly_driver/driver/__init__.py",
        "mobly_driver/driver/base.py",
        "mobly_driver/driver/common.py",
        "mobly_driver/driver/infra.py",
        "mobly_driver/driver/local.py",
        "mobly_driver/driver_factory.py",
    ],
    imports = ["."],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//src/testing/end_to_end/mobly_driver/tests/unit_tests:__subpackages__"],
    deps = [
        "//scripts/lib/logging_utils",
        "//src/testing/end_to_end/libs",
        "//third_party/mobly:mobly_no_testonly",
    ],
)

# Mobly Driver Python binary definition.
# GN host_test_data("mobly_driver_test_data_target") expects output_name = "mobly_driver.pyz".
# @bazel2gn:raw_attribute:output_name = "mobly_driver.pyz"
py_binary(
    name = "mobly_driver_binary_target",
    testonly = True,
    srcs = ["main.py"],
    # Do not create an `__init__.py` file in this directory: since
    # //src/testing/end_to_end/libs adds its parent directory to `sys.path`,
    # it would shadow the `mobly_driver` package below.
    # @bazel2gn:skip
    legacy_create_init = False,
    main = "main.py",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    # Used by python_mobly_test() targets, in any package.
    visibility = ["//:__subpackages__"],
    deps = [":mobly_driver"],
)
