load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_py_test.bzl", "host_py_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [
        ":driver_factory_test",
        ":init_test",
    ],
    visibility = ["//src/testing:__pkg__"],
)

# Disable Bazel's legacy stub __init__.py generation so //src/testing/end_to_end/libs's
# imports = [".."] does not shadow //src/testing/end_to_end/mobly_driver's package root.
host_py_test(
    name = "init_test",
    srcs = ["init_test.py"],
    legacy_create_init = False,
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        "//src/testing/end_to_end/libs",
        "//src/testing/end_to_end/mobly_driver",
        "//third_party/parameterized",
    ],
)

host_py_test(
    name = "driver_factory_test",
    srcs = ["driver_factory_test.py"],
    legacy_create_init = False,
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        "//src/testing/end_to_end/libs",
        "//src/testing/end_to_end/mobly_driver",
        "//third_party/parameterized",
    ],
)
