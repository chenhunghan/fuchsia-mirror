load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_py_test.bzl", "host_py_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [
        ":api_ffx_test",
        ":api_mobly_test",
    ],
    visibility = ["//src/testing:__pkg__"],
)

# Avoid generating an empty src/testing/end_to_end/mobly_driver/__init__.py in
# runfiles, which would shadow the mobly_driver package under
# //src/testing/end_to_end/libs's imports = [".."].
host_py_test(
    name = "api_ffx_test",
    srcs = ["api_ffx_test.py"],
    legacy_create_init = 0,
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        "//src/testing/end_to_end/mobly_driver",
        "//third_party/parameterized",
    ],
)

host_py_test(
    name = "api_mobly_test",
    srcs = ["api_mobly_test.py"],
    legacy_create_init = 0,
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        "//src/testing/end_to_end/mobly_driver",
        "//third_party/parameterized",
    ],
)
