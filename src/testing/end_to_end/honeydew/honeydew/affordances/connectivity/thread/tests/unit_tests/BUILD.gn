import("//build/python/python_host_test.gni")

if (is_host) {
  python_host_test("ot_cli_test") {
    main_source = "ot_cli_test.py"
    libraries = [ "//src/testing/end_to_end/honeydew" ]
    main_callable = "unittest.main"
    extra_args = [ "-v" ]
  }

  python_host_test("thread_test") {
    main_source = "thread_test.py"
    libraries = [ "//src/testing/end_to_end/honeydew" ]
    main_callable = "unittest.main"
    extra_args = [ "-v" ]
  }
}

group("tests") {
  testonly = true
  public_deps = [
    ":ot_cli_test($host_toolchain)",
    ":thread_test($host_toolchain)",
  ]
}
