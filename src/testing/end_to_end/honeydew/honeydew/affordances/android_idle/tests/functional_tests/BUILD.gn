import("//build/python/python_mobly_test.gni")

if (is_host) {
  python_mobly_test("android_idle_test") {
    main_source = "test_android_idle.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
    ]
  }
}

# Group containing all of the AndroidIdle affordance functional test cases and
# their dependencies.
group("tests") {
  testonly = true
  public_deps = [ ":android_idle_test($host_toolchain)" ]
}
