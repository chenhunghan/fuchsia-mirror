import("//build/python/python_mobly_test.gni")

if (is_host) {
  python_mobly_test("ui_navigation_functional_test") {
    main_source = "test_ui_navigation.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
    ]
  }
}

# Group containing all of the ui_navigation affordance functional test cases
# and their dependencies.
group("tests") {
  testonly = true
  public_deps = [ ":ui_navigation_functional_test($host_toolchain)" ]
}
