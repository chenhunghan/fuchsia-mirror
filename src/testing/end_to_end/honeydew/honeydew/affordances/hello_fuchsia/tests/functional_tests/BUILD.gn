import("//build/python/python_mobly_test.gni")
import("//build/testing/environments.gni")

if (is_host) {
  python_mobly_test("hello_fuchsia_fc_test") {
    main_source = "test_hello_fuchsia.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
    ]
    environments = [ aemu_env ]
    honeydew_config = {
      affordances = {
        hello_fuchsia = {
          implementation = "fuchsia-controller"
        }
      }
    }
  }

  python_mobly_test("hello_fuchsia_ffx_test") {
    main_source = "test_hello_fuchsia.py"
    libraries = [
      "//src/testing/end_to_end/honeydew",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
    ]
    environments = [ aemu_env ]
    honeydew_config = {
      affordances = {
        hello_fuchsia = {
          implementation = "ffx"
        }
      }
    }
  }
}

group("tests") {
  testonly = true
  public_deps = [
    ":hello_fuchsia_fc_test($host_toolchain)",
    ":hello_fuchsia_ffx_test($host_toolchain)",
  ]
}
