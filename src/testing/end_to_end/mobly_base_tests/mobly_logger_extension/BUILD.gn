if (is_host) {
  python_library("mobly_logger_extension") {
    sources = [ "__init__.py" ]
    imports = [ ".." ]
    visibility = [
      ":*",
      "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test:*",
    ]
    deps = [
      "//scripts/lib/logging_utils",
      "//third_party/mobly:mobly_no_testonly",
    ]
    enable_mypy = false
  }
}
