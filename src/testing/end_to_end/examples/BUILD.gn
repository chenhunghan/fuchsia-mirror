# All of the lacewing example tests and their dependencies.
group("examples") {
  testonly = true
  public_deps = [
    "data_resource_access_test($host_toolchain)",
    "exoneration_failing_test($host_toolchain)",
    "fidl_hello_world_test($host_toolchain)",
    "hello_world_test($host_toolchain)",
    "multi_device_test($host_toolchain)",
    "openwrt_ap_test($host_toolchain)",
    "power_cycle_test($host_toolchain)",
    "test_case_revive_example:run_wo_test_case_revive($host_toolchain)",
    "test_case_revive_example:test_case_revive_with_hard_reboot($host_toolchain)",
    "test_case_revive_example:test_case_revive_with_soft_reboot($host_toolchain)",
    "test_cases_example($host_toolchain)",
    "test_cases_revive_example($host_toolchain)",
    "test_soft_reboot:soft_reboot_test($host_toolchain)",
    "test_soft_reboot:soft_reboot_test.hermetic($host_toolchain)",
    "test_soft_reboot:soft_reboot_test_with_ffx_monitor($host_toolchain)",
  ]
}

# Tests in this directory that can safely run on a standard Fuchsia emulator
# without requiring specialized hardware, multiple devices, or power cycling.
group("emulator_tests") {
  testonly = true
  public_deps = [
    "data_resource_access_test($host_toolchain)",
    "fidl_hello_world_test($host_toolchain)",
    "hello_world_test($host_toolchain)",
    "test_cases_example($host_toolchain)",
  ]
}
