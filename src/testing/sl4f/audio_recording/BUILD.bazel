load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "bin",
    srcs = [
        "src/audio_facade.rs",
        "src/input_worker.rs",
        "src/main.rs",
        "src/output_worker.rs",
        "src/server.rs",
        "src/util.rs",
    ],
    binary_name = "audio_recording",
    edition = "2024",
    visibility = ["//src/testing/sl4f:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.media:fuchsia.media_rust",
        "//sdk/fidl/fuchsia.virtualaudio:fuchsia.virtualaudio_rust",
        "//sdk/rust/zx",
        "//src/lib/async-utils",
        "//src/lib/fdio/rust:fdio",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/testing/sl4f/fidl:fuchsia.test.audio_rust",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)
