load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")

package(default_applicable_licenses = ["//:license"])

exports_files(
    ["testing_keys/test_private_key.pem"],
    visibility = ["//src/sys/pkg/tests/system-tests:__subpackages__"],
)

go_library(
    name = "omaha_tool",
    testonly = True,  # @bazel2gn:raw_overwrite:true non_go_deps = [ ":test_tools" ]
    srcs = [
        "omaha.go",
        "omaha_structs.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/src/testing/host-target-testing/omaha_tool",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//src/testing/host-target-testing:__subpackages__"],
    deps = [
        "//tools/lib/color",
        "//tools/lib/logger",
    ],
)

go_test(
    name = "host-target-testing-omaha_tool-test",
    srcs = ["omaha_test.go"],
    embed = [":omaha_tool"],
    tags = ["manual"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//src/testing/host-target-testing:__pkg__"],
)
