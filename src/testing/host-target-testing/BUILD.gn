import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("bazel_tests") {
  host_tests = [ "//src/testing/host-target-testing:host_tests" ]
}

test_packages = [
  "artifacts",
  "avb",
  "build",
  "cli",
  "device",
  "ffx",
  "omaha_tool",
  "packages",
  "paver",
  "util",
  "zbi",
]

group("tests") {
  testonly = true

  public_deps = [ ":bazel_tests" ]
  foreach(testpkg, test_packages) {
    public_deps +=
        [ "${testpkg}:host-target-testing-${testpkg}-test($host_toolchain)" ]
  }
}
