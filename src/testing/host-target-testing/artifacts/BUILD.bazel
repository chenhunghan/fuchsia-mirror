load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_go_test.bzl", "host_go_test")

package(default_applicable_licenses = ["//:license"])

go_library(
    name = "artifacts",
    testonly = True,
    srcs = [
        "archive.go",
        "build.go",
        "builder.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/src/testing/host-target-testing/artifacts",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//:__subpackages__"],
    deps = [
        "//src/testing/host-target-testing/avb",
        "//src/testing/host-target-testing/build",
        "//src/testing/host-target-testing/ffx",
        "//src/testing/host-target-testing/omaha_tool",
        "//src/testing/host-target-testing/packages",
        "//src/testing/host-target-testing/paver",
        "//src/testing/host-target-testing/util",
        "//src/testing/host-target-testing/zbi",
        "//third_party/golibs:golang.org/x/crypto/ssh",
        "//tools/build",
        "//tools/lib/logger",
        "//tools/lib/retry",
    ],
)

host_go_test(
    name = "host-target-testing-artifacts-test",
    srcs = [
        "archive_test.go",
        "build_test.go",
    ],
    embed = [":artifacts"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//src/testing/host-target-testing:__pkg__"],
)
