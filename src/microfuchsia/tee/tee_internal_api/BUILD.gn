source_set("headers") {
  public = [
    "include/lib/tee_internal_api/tee_internal_api.h",
    "include/lib/tee_internal_api/tee_internal_api_types.h",
  ]
  public_configs = [ ":config" ]
  visibility = [
    ":*",
    "//src/microfuchsia/tee/*",
    "//src/tee/tee_internal_api:*",
    "//vendor/*",
  ]
}

rustc_library("tee_internal") {
  sources = [
    "src/binding.rs",
    "src/lib.rs",
  ]
  configs += [ "//build/config/rust/lints:deny_unused_results" ]
  edition = "2024"
  proc_macro_deps = [ "//third_party/rust_crates:num-derive" ]
  visibility = [
    ":*",
    "//src/microfuchsia/tee/*",
  ]
  deps = [
    "//third_party/rust_crates:bitflags",
    "//third_party/rust_crates:num-traits",
    "//third_party/rust_crates:thiserror",
  ]
}
