load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//build/bazel/rules/cc:fx_cc_library_headers.bzl", "fx_cc_library_headers")

package(default_applicable_licenses = ["//:license"])

fx_cc_library_headers(
    name = "tee-client-api-headers",
    hdrs = [
        "include/tee-client-api/tee-client-impl.h",
        "include/tee-client-api/tee-client-types.h",
        "include/tee_client_api.h",
    ],
    visibility = ["//visibility:private"],
)

# `shared_library("tee-client-api-experimental")` remains above the bazel2gn
# sentinel in BUILD.gn because bazel2gn does not translate shared_library().
fx_cc_library(
    name = "tee-client-api-experimental-static",
    srcs = ["tee-client-api-experimental.cc"],
    implementation_deps = [
        "//sdk/fidl/fuchsia.hardware.tee:fuchsia.hardware.tee_cpp",
        "//sdk/fidl/fuchsia.tee:fuchsia.tee_cpp",
        "//sdk/lib/component/incoming/cpp",
        "//sdk/lib/fdio",
        "//sdk/lib/fidl",
        # Directly #included by tee-client-api-experimental.cc (and listed on
        # shared_library("tee-client-api-experimental") in BUILD.gn).
        "//sdk/lib/fit",
        "//src/lib/fxl",
        "//zircon/system/ulib/zx",
    ],
    visibility = ["//visibility:private"],
    deps = [":tee-client-api-headers"],
)
