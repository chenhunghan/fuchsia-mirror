load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//build/bazel/rules/cc:fx_cc_library_headers.bzl", "fx_cc_library_headers")
load("//build/bazel/rules/cc:fx_cc_shared_library.bzl", "fx_cc_shared_library")

package(default_applicable_licenses = ["//:license"])

fx_cc_library_headers(
    name = "tee-client-api-headers",
    hdrs = [
        "include/tee-client-api/tee-client-impl.h",
        "include/tee-client-api/tee-client-types.h",
        "include/tee_client_api.h",
    ],
    visibility = ["//visibility:private"],
)

fx_cc_library(
    name = "tee-client-api-experimental-static",
    srcs = ["tee-client-api-experimental.cc"],
    implementation_deps = [
        "//sdk/fidl/fuchsia.hardware.tee:fuchsia.hardware.tee_cpp",
        "//sdk/fidl/fuchsia.tee:fuchsia.tee_cpp",
        "//sdk/lib/component/incoming/cpp",
        "//sdk/lib/fdio",
        "//sdk/lib/fidl",
        # Directly #included by tee-client-api-experimental.cc.
        "//sdk/lib/fit",
        "//src/lib/fxl",
        "//zircon/system/ulib/zx",
    ],
    visibility = ["//visibility:private"],
    deps = [":tee-client-api-headers"],
    alwayslink = True,
)

fx_cc_shared_library(
    name = "tee-client-api-experimental",
    # GN dependents include the headers through their dependency on the
    # shared library.
    gn_public_deps = [":tee-client-api-headers"],
    visibility = [
        "//src/tee/tee-client-api-experimental:__pkg__",
        "//vendor:__subpackages__",
    ],
    deps = [":tee-client-api-experimental-static"],
)
