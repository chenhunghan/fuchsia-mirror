load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
    "fx_test_component",
)
load(
    "//build/bazel/rules/components:structured_config.bzl",
    "fuchsia_structured_config_rust_lib",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":sc_rust_client_integration_test"],
    visibility = ["//src/sys/component_manager:__pkg__"],
)

rustc_binary(
    name = "bin",
    testonly = True,
    srcs = ["src/main.rs"],
    crate_name = "structured_config_rust_receiver",
    edition = "2024",
    deps = [
        ":config_lib",
        "//src/lib/diagnostics/inspect/runtime/rust",
        "//src/lib/diagnostics/inspect/rust:fuchsia-inspect",  # @bazel2gn:path_overwrite://src/lib/diagnostics/inspect/rust
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//src/sys/component_manager/tests/structured_config/fidl:test.structuredconfig.receiver_rust",
        "//third_party/rust_crates/vendor:futures",
    ],
)

fx_packaged_binary(
    name = "bin_packaged_bin",
    testonly = True,
    binary = ":bin",
    binary_name = "structured_config_rust_receiver",
)

# The GN build uses the `fuchsia_component_manifest("manifest")` target defined
# above the bazel2gn sentinel in BUILD.gn instead, because
# `fuchsia_structured_config_values("values")` calls
# `get_target_outputs(":manifest")`.
# @bazel2gn:skip
fx_component_manifest(
    name = "manifest",
    testonly = True,
    component_name = "rust_receiver",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/component_manager/tests/structured_config:all_config_types.shard.cml",
    ],
    manifest = "meta/receiver.cml",
)

fuchsia_structured_config_rust_lib(
    name = "config_lib",
    testonly = True,
    cm_label = ":manifest",
    crate_name = "receiver_config",
)

fx_component(
    name = "component",
    testonly = True,
    compiled_manifest = ":manifest",
    deps = [":bin_packaged_bin"],
)

rustc_test(
    name = "rust_sc_client_test_bin",
    srcs = ["src/test.rs"],
    crate_root = "src/test.rs",
    edition = "2024",
    tags = ["manual"],
    # Device-packaged integration test depending on Fuchsia-only crates.
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//src/lib/fuchsia",
        "//src/sys/component_manager/tests/structured_config/client_integration:sc_client_integration_support",
    ],
)

fx_packaged_binary(
    name = "rust_sc_client_test_packaged_bin",
    testonly = True,
    binary = ":rust_sc_client_test_bin",
    binary_name = "rust_sc_client_test_bin",
)

fx_component_manifest(
    name = "test_component_manifest",
    testonly = True,
    component_name = "test_component",
    includes = [
        "//sdk/lib/inspect:offer.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/test.cml",
)

fx_test_component(
    name = "test_component",
    compiled_manifest = ":test_component_manifest",
    deps = [":rust_sc_client_test_packaged_bin"],
)

fx_package(
    name = "rust",
    package_name = "sc_rust_client_integration_test",
    components = [
        ":component",
        # https://fxbug.dev/42052321: Dep included for affected tests presubmit
        "//src/sys/component_manager:component-manager-realm-builder-cmp",
    ],
    test_components = [":test_component"],
)

fx_test(
    name = "sc_rust_client_integration_test",
    package = ":rust",
)
