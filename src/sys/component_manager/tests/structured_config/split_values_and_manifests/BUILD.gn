import("//build/components.gni")

group("tests") {
  testonly = true
  deps = [ ":values_defined_separately_from_manifest" ]
}

fuchsia_structured_config_values("values_defined_separately_from_manifest") {
  testonly = true
  component_name = "rust_receiver"
  cm_label = "//src/sys/component_manager/tests/structured_config/client_integration/rust:manifest"
  values = {
    my_flag = false
    my_uint8 = 255
    my_uint16 = 65535
    my_uint32 = 4000000000
    my_uint64 = 8000000000
    my_int8 = -127
    my_int16 = -32766
    my_int32 = -2000000000
    my_int64 = -4000000000
    my_string = "hello, world!"
    my_vector_of_flag = [
      true,
      false,
    ]
    my_vector_of_uint8 = [
      1,
      2,
      3,
    ]
    my_vector_of_uint16 = [
      2,
      3,
      4,
    ]
    my_vector_of_uint32 = [
      3,
      4,
      5,
    ]
    my_vector_of_uint64 = [
      4,
      5,
      6,
    ]
    my_vector_of_int8 = [
      -1,
      -2,
      3,
    ]
    my_vector_of_int16 = [
      -2,
      -3,
      4,
    ]
    my_vector_of_int32 = [
      -3,
      -4,
      5,
    ]
    my_vector_of_int64 = [
      -4,
      -5,
      6,
    ]
    my_vector_of_string = [
      "hello, world!",
      "hello, again!",
    ]
  }
}

