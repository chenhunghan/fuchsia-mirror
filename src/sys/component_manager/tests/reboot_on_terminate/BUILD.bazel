fx_component_manifest(
    name = "reboot_on_terminate_success_manifest",
    testonly = True,
    component_name = "reboot_on_terminate_success",
    includes = [
        "//src/sys/component_manager:meta/passthrough_diagnostics.shard.cml",
        "//src/sys/component_manager/tests:meta/use_elf_runner.shard",
    ],
    manifest = "meta/reboot_on_terminate_success.cml",
)

fx_component(
    name = "reboot_on_terminate_success",
    testonly = True,
    # We want `diagnostics` from self rather than parent, so we can't use
    # syslog/client.shard.cml.
    check_includes = False,
    compiled_manifest = ":reboot_on_terminate_success_manifest",
    deps = [":reboot_on_terminate_success_packaged_bin"],
)

fx_component_manifest(
    name = "reboot_on_terminate_policy_manifest",
