component_config(
    name = "component_manager_config",
    testonly = True,
    srcs = [
        "config.json5",
        "//src/sys/component_manager/configs:test_config.base.json5",
    ],
)

fx_component_manifest(
    name = "component_manager_manifest",
    testonly = True,
    component_name = "component_manager",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/component_manager:meta/component_manager.cml",
    ],
    manifest = "meta/component_manager.cml",
)

fx_component(
    name = "component_manager",
    testonly = True,
    compiled_manifest = ":component_manager_manifest",
    deps = [
        ":component_manager_config",
        "//src/sys/component_manager:bin_with_tracing_packaged",  # @bazel2gn:path_overwrite://src/sys/component_manager:bin_with_tracing
    ],
)

fx_component_manifest(
    name = "reboot_on_terminate_test_component-manifest",
    testonly = True,
    component_name = "reboot_on_terminate_test",
    includes = [
        "//sdk/lib/sys/component:realm_builder.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/lib/fuchsia-component-test:meta/nested_component_manager.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/integration_test.cml",
)

fx_test_component(
    name = "reboot_on_terminate_test_component",
    compiled_manifest = ":reboot_on_terminate_test_component-manifest",
    deps = [":reboot_on_terminate_test_packaged_bin"],
)

fx_package(
    name = "reboot_on_terminate_test_package",
    package_name = "reboot_on_terminate_test",
    components = [
        ":component_manager",
        ":crash",
        ":reboot_on_terminate_policy",
        ":reboot_on_terminate_success",
        "//src/lib/fuchsia-component-test/realm_builder_server:realm_builder_server_component",
        "//src/power/shutdown-shim/tests:shutdown_shim_component",
        "//src/sys/component_manager/testing/echo_server",
    ],
    test_components = [":reboot_on_terminate_test_component"],
)

# It's possible for nested component_manager to panic after the test
# passes.
#
# This may happen when the process for shutdown_shim is killed, and
# component_manager panics because its connection to the reboot protocol
# is closed. This is benign because the test has already finished this
# point, but there's no lightweight way to prevent it.
fx_test(
    name = "reboot_on_terminate_test",
    # TODO(https://fxbug.dev/42157148): This test launches a nested component manager
    # and doesn't route debug data service, causing the test to log on error
    # level, which fails because of restricted log severity in tests.
    build_only = select({
        "@prebuilt_clang//:coverage_variant": True,
        "//conditions:default": False,
    }),
    max_log_severity = "FATAL",
    package = ":reboot_on_terminate_test_package",
    visibility = ["//src/sys/component_manager:__pkg__"],
)
