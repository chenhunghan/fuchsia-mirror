load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

fx_cc_binary(
    name = "bin",
    testonly = True,
    srcs = ["main.cc"],
    deps = ["//src/lib/test-suite:test_suite_lib"],
)

fx_packaged_binary(
    name = "bin_packaged_bin",
    testonly = True,
    binary = ":bin",
    binary_name = "security-policy-next-vdso-test",
)

fx_component_manifest(
    name = "security-policy-next-vdso-test-manifest",
    testonly = True,
    component_name = "security-policy-next-vdso-test",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/security-policy-next-vdso-test.cml",
)

fx_test_component(
    name = "security-policy-next-vdso-test-component",
    compiled_manifest = ":security-policy-next-vdso-test-manifest",
    deps = [":bin_packaged_bin"],
)

fx_package(
    name = "security-policy-next-vdso-test-package",
    package_name = "security-policy-next-vdso-test",
    components = [
        # https://fxbug.dev/42052321: Dep included for affected tests presubmit
        "//src/sys/component_manager:component-manager-realm-builder-cmp",
    ],
    test_components = [":security-policy-next-vdso-test-component"],
)

fx_test(
    name = "security-policy-next-vdso-test",
    package = ":security-policy-next-vdso-test-package",
    visibility = ["//src/sys/component_manager:__pkg__"],
)
