load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/fidl:fidl_library.bzl", "fidl_library")
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")
load("//build/component:config.bzl", "component_config")

package(default_applicable_licenses = ["//:license"])

rustc_test(
    name = "security_policy_vmex_integration_test_bin",
    srcs = ["security_policy_vmex_integration_test.rs"],
    crate_name = "security_policy_vmex_integration_test",
    crate_root = "security_policy_vmex_integration_test.rs",
    edition = "2024",
    deps = [
        ":test.policy_rust",
        "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
        "//sdk/rust/zx",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//src/sys/component_manager/tests/security_policy/util:security_policy_test_util",
        "//src/sys/lib/component-events",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:assert_matches",
    ],
)

fx_packaged_binary(
    name = "security_policy_vmex_integration_test_packaged_bin",
    testonly = True,
    binary = ":security_policy_vmex_integration_test_bin",
    binary_name = "security_policy_vmex_integration_test",
)

fidl_library(
    name = "test.policy",
    testonly = True,
    srcs = ["policy.test.fidl"],
    deps = ["//zircon/vdso/zx"],
)

rustc_binary(
    name = "protected_ops_util",
    testonly = True,
    srcs = ["protected_ops_util.rs"],
    crate_root = "protected_ops_util.rs",
    edition = "2024",
    deps = [
        ":test.policy_rust",
        "//sdk/rust/zx",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
    ],
)

fx_packaged_binary(
    name = "protected_ops_util_packaged_bin",
    testonly = True,
    binary = ":protected_ops_util",
    binary_name = "protected_ops_util",
)

component_config(
    name = "cm_config",
    testonly = True,
    srcs = ["cm_config.json5"],
)

fx_component_manifest(
    name = "protected_ops-manifest",
    testonly = True,
    component_name = "protected_ops",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/protected_ops.cml",
)

fx_component(
    name = "protected_ops",
    testonly = True,
    compiled_manifest = ":protected_ops-manifest",
    deps = [":protected_ops_util_packaged_bin"],
)

fx_component_manifest(
    name = "test_root-manifest",
    testonly = True,
    component_name = "test_root",
    includes = [
        "//sdk/lib/inspect:offer.shard",
        "//sdk/lib/syslog:offer.shard",
        "//src/sys/component_manager/tests:meta/elf_runner_and_environment.shard",
    ],
    manifest = "meta/test_root.cml",
)

fx_component(
    name = "test_root",
    testonly = True,
    compiled_manifest = ":test_root-manifest",
)

fx_component_manifest(
    name = "protected_ops_no_request-manifest",
    testonly = True,
    component_name = "protected_ops_no_request",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/protected_ops_no_request.cml",
)

fx_component(
    name = "protected_ops_no_request",
    testonly = True,
    compiled_manifest = ":protected_ops_no_request-manifest",
    deps = [":protected_ops_util_packaged_bin"],
)

fx_component_manifest(
    name = "security-policy-vmex-integration-test-manifest",
    testonly = True,
    component_name = "security-policy-vmex-integration-test",
    includes = [
        "//sdk/lib/sys/component:realm_builder.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/component_manager/tests/security_policy:meta/test.shard.cml",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/security-policy-vmex-integration-test.cml",
)

fx_test_component(
    name = "security-policy-vmex-integration-test-component",
    compiled_manifest = ":security-policy-vmex-integration-test-manifest",
    deps = [":security_policy_vmex_integration_test_packaged_bin"],
)

fx_package(
    name = "security-policy-vmex-integration-test-package",
    package_name = "security-policy-vmex-integration-test",
    components = [
        ":protected_ops",
        ":protected_ops_no_request",
        ":test_root",
        "//src/lib/fuchsia-component-test/realm_builder_server:realm_builder_server_component",
        "//src/sys/component_manager/tests/security_policy:cm_for_test",
    ],
    resources = [":cm_config"],
    test_components = [":security-policy-vmex-integration-test-component"],
)

fx_test(
    name = "security-policy-vmex-integration-test",
    package = ":security-policy-vmex-integration-test-package",
    test_type = "system",
    visibility = ["//src/sys/component_manager:__pkg__"],
)
