        "//src/sys/component_manager/tests/security_policy/util:security_policy_test_util",
        "//third_party/rust_crates/vendor:anyhow",
    ],
)

fx_packaged_binary(
    name = "security_policy_capability_allowlist_integration_test_packaged_bin",
    testonly = True,
    binary = ":security_policy_capability_allowlist_integration_test_bin",
    binary_name = "security_policy_capability_allowlist_integration_test",
)

fidl_library(
    name = "test.policy",
    testonly = True,
    srcs = ["policy.test.fidl"],
