load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

rustc_test(
    name = "destruction_integration_test_bin",
    srcs = ["integration_test.rs"],
    crate_name = "destruction_integration_test",
    crate_root = "integration_test.rs",
    edition = "2024",
    deps = [
        "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component-test:fuchsia-component-test-lib",  # @bazel2gn:path_overwrite://src/lib/fuchsia-component-test
        "//src/sys/lib/component-events",
    ],
)

fx_packaged_binary(
    name = "destruction_integration_test_packaged_bin",
    testonly = True,
    binary = ":destruction_integration_test_bin",
    binary_name = "destruction_integration_test",
)

rustc_binary(
    name = "destruction_collection_realm_bin",
    testonly = True,
    srcs = ["collection_realm.rs"],
    crate_name = "destruction_collection_realm",
    crate_root = "collection_realm.rs",
    edition = "2024",
    deps = [
        "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust",
        "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/sys/component_manager/tests/fidl:components_rust",
        "//third_party/rust_crates/vendor:log",
    ],
)

fx_packaged_binary(
    name = "destruction_collection_realm_packaged_bin",
    testonly = True,
    binary = ":destruction_collection_realm_bin",
    binary_name = "destruction_collection_realm",
)

rustc_binary(
    name = "destroy_and_recreate_bin",
    testonly = True,
    srcs = ["destroy_and_recreate.rs"],
    crate_name = "destroy_and_recreate",
    crate_root = "destroy_and_recreate.rs",
    edition = "2024",
    deps = [
        "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust",
        "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/sys/component_manager/tests/fidl:components_rust",
        "//third_party/rust_crates/vendor:log",
    ],
)

fx_packaged_binary(
    name = "destroy_and_recreate_packaged_bin",
    testonly = True,
    binary = ":destroy_and_recreate_bin",
    binary_name = "destroy_and_recreate",
)

rustc_binary(
    name = "destruction_trigger_bin",
    testonly = True,
    srcs = ["trigger.rs"],
    crate_name = "destruction_trigger",
    crate_root = "trigger.rs",
    edition = "2024",
    deps = [
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/sys/component_manager/tests/fidl:components_rust",
        "//third_party/rust_crates/vendor:futures",
    ],
)

fx_packaged_binary(
    name = "destruction_trigger_packaged_bin",
    testonly = True,
    binary = ":destruction_trigger_bin",
    binary_name = "destruction_trigger",
)

fx_component_manifest(
    name = "trigger-manifest",
    testonly = True,
    component_name = "trigger",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/trigger.cml",
)

fx_component(
    name = "trigger",
    testonly = True,
    compiled_manifest = ":trigger-manifest",
    deps = [":destruction_trigger_packaged_bin"],
)

fx_component_manifest(
    name = "trigger_realm-manifest",
    testonly = True,
    component_name = "trigger_realm",
    includes = [
        "//sdk/lib/inspect:offer.shard",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/trigger_realm.cml",
)

fx_component(
    name = "trigger_realm",
    testonly = True,
    compiled_manifest = ":trigger_realm-manifest",
    deps = [":destruction_trigger_packaged_bin"],
)

fx_component_manifest(
    name = "collection_realm-manifest",
    testonly = True,
    component_name = "collection_realm",
    includes = [
        "//src/sys/component_manager:meta/passthrough_diagnostics.shard.cml",
        "//src/sys/component_manager/tests:meta/use_elf_runner.shard",
    ],
    manifest = "meta/collection_realm.cml",
)

# We want `diagnostics` from self rather than parent, so we can't use
# syslog/client.shard.cml.
fx_component(
    name = "collection_realm",
    testonly = True,
    check_includes = False,
    compiled_manifest = ":collection_realm-manifest",
    deps = [":destruction_collection_realm_packaged_bin"],
)

fx_component_manifest(
    name = "destroy_and_recreate-manifest",
    testonly = True,
    component_name = "destroy_and_recreate",
    includes = [
        "//src/sys/component_manager:meta/passthrough_diagnostics.shard.cml",
        "//src/sys/component_manager/tests:meta/use_elf_runner.shard",
    ],
    manifest = "meta/destroy_and_recreate.cml",
)

# We want `diagnostics` from self rather than parent, so we can't use
# syslog/client.shard.cml.
fx_component(
    name = "destroy_and_recreate",
    testonly = True,
    check_includes = False,
    compiled_manifest = ":destroy_and_recreate-manifest",
    deps = [":destroy_and_recreate_packaged_bin"],
)

fx_component_manifest(
    name = "destruction_integration_test-manifest",
    testonly = True,
    component_name = "destruction_integration_test",
    includes = [
        "//sdk/lib/sys/component:realm_builder.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/lib/fuchsia-component-test:meta/nested_component_manager.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/destruction_integration_test.cml",
)

fx_test_component(
    name = "destruction_integration_test_component",
    compiled_manifest = ":destruction_integration_test-manifest",
    deps = [":destruction_integration_test_packaged_bin"],
)

fx_package(
    name = "destruction_integration_test_package",
    package_name = "destruction_integration_test",
    components = [
        ":collection_realm",
        ":destroy_and_recreate",
        ":trigger",
        ":trigger_realm",
        "//src/lib/fuchsia-component-test/realm_builder_server:realm_builder_server_component",
        "//src/sys/component_manager:component-manager-realm-builder-debug-cmp",
    ],
    test_components = [":destruction_integration_test_component"],
)

fx_test(
    name = "destruction_integration_test",
    package = ":destruction_integration_test_package",
    visibility = ["//src/sys/component_manager:__pkg__"],
)
