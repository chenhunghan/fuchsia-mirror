load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

rustc_test(
    name = "builtin_runner_test_bin",
    srcs = ["builtin_runner_test.rs"],
    crate_name = "builtin_runner_test",
    crate_root = "builtin_runner_test.rs",
    edition = "2024",
    deps = [
        "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component-test:fuchsia-component-test-lib",  # @bazel2gn:path_overwrite://src/lib/fuchsia-component-test
        "//src/sys/lib/component-events",
    ],
)

fx_packaged_binary(
    name = "builtin_runner_test_packaged_bin",
    testonly = True,
    binary = ":builtin_runner_test_bin",
    binary_name = "builtin_runner_test",
)

fx_component_manifest(
    name = "builtin-runner-test-manifest",
    testonly = True,
    component_name = "builtin-runner-test",
    includes = [
        "//sdk/lib/sys/component:realm_builder.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/lib/fuchsia-component-test:meta/nested_component_manager.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/builtin-runner-test.cml",
)

fx_test_component(
    name = "builtin-runner-test-component",
    compiled_manifest = ":builtin-runner-test-manifest",
    deps = [":builtin_runner_test_packaged_bin"],
)

rustc_binary(
    name = "simple_elf_program_bin",
    srcs = ["simple_elf_program.rs"],
    crate_name = "simple_elf_program",
    crate_root = "simple_elf_program.rs",
    edition = "2024",
    tags = ["manual"],
)

fx_packaged_binary(
    name = "simple_elf_program_bin_packaged_bin",
    binary = ":simple_elf_program_bin",
    binary_name = "simple_elf_program",
)

fx_component_manifest(
    name = "simple_elf_program_packaged_elf_runner-manifest",
    testonly = True,
    component_name = "simple_elf_program_packaged_elf_runner",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/simple_elf_program_packaged_elf_runner.cml",
)

fx_component(
    name = "simple_elf_program_packaged_elf_runner",
    testonly = True,
    compiled_manifest = ":simple_elf_program_packaged_elf_runner-manifest",
    deps = [":simple_elf_program_bin_packaged_bin"],
)

fx_component_manifest(
    name = "simple_elf_program_builtin_elf_runner-manifest",
    testonly = True,
    component_name = "simple_elf_program_builtin_elf_runner",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/simple_elf_program_builtin_elf_runner.cml",
)

fx_component(
    name = "simple_elf_program_builtin_elf_runner",
    testonly = True,
    compiled_manifest = ":simple_elf_program_builtin_elf_runner-manifest",
    deps = [":simple_elf_program_bin_packaged_bin"],
)

fx_package(
    name = "builtin-runner-test_package",
    package_name = "builtin-runner-test",
    components = [
        ":simple_elf_program_builtin_elf_runner",
        ":simple_elf_program_packaged_elf_runner",
        "//src/lib/fuchsia-component-test/realm_builder_server:realm_builder_server_component",
        "//src/sys/component_manager:component-manager-realm-builder-debug-cmp",
        "//src/sys/component_manager:elf_runner",
    ],
    test_components = [":builtin-runner-test-component"],
)

fx_test(
    name = "builtin-runner-test",
    package = ":builtin-runner-test_package",
    visibility = ["//src/sys/component_manager:__pkg__"],
)
