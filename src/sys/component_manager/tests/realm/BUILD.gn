if (is_fuchsia) {
  rustc_test("realm_integration_test_bin") {
    sources = [ "src/integration_test.rs" ]
    source_root = "src/integration_test.rs"
    edition = "2024"
    deps = [
      "//examples/components/routing/fidl:echo_rust",
      "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust",
      "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust",
      "//sdk/rust/zx",
      "//src/lib/fidl/rust/fidl",
      "//src/lib/fuchsia",
      "//src/lib/fuchsia-async",
      "//src/lib/fuchsia-component",
      "//src/lib/fuchsia-fs",
    ]
  }
}
if (is_fuchsia) {
  rustc_test("realm_namespace_test_bin") {
    sources = [ "src/namespace_test.rs" ]
    source_root = "src/namespace_test.rs"
    edition = "2024"
    deps = [
      "//examples/components/routing/fidl:echo_rust",
      "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust",
      "//src/lib/fidl/rust/fidl",
      "//src/lib/fuchsia",
      "//src/lib/fuchsia-component",
    ]
  }
}

fuchsia_component_manifest("no_program-manifest") {
  testonly = true
  component_name = "no_program"
  manifest = "meta/no_program.cml"
}

fuchsia_component("no_program") {
  testonly = true
  cm_label = ":no_program-manifest"
  deps = [ ":placeholder_data" ]
}

fuchsia_component_manifest("realm_integration_test-manifest") {
  testonly = true
  component_name = "realm_integration_test"
  manifest = "meta/realm_integration_test.cml"
}

fuchsia_test_component("realm_integration_test") {
  cm_label = ":realm_integration_test-manifest"
  deps = [ ":realm_integration_test_bin" ]
}

fuchsia_component_manifest("realm_namespace_test-manifest") {
  testonly = true
  component_name = "realm_namespace_test"
  manifest = "meta/realm_namespace_test.cml"
}

fuchsia_test_component("realm_namespace_test") {
  cm_label = ":realm_namespace_test-manifest"
  deps = [ ":realm_namespace_test_bin" ]
}

fuchsia_test_package("realm_integration_tests") {
  package_name = "realm_integration_tests-gn"
  test_components = [
    ":realm_integration_test",
    ":realm_namespace_test",
  ]
  deps = [
    ":no_program",
    "//src/sys/component_manager:component-manager-realm-builder-cmp",
    "//src/sys/component_manager/testing/echo_server",
  ]
}

ctf_fuchsia_package("realm_integration_tests-ctf") {
  testonly = true
  package_name = "realm_integration_tests-ctf"
  deps = [
    ":no_program",
    "//src/sys/component_manager/testing/echo_server",
  ]
  deps += [
    ":realm_integration_test",
    ":realm_namespace_test",
  ]
  test_component_names = [
    "realm_integration_test",
    "realm_namespace_test",
  ]
}
