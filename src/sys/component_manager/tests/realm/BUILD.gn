import("//build/component/config.gni")
import("//build/components.gni")

# Retained in GN because bazel2gn does not translate component_config.
component_config("placeholder_data") {
  sources = [ "configs/placeholder.json5" ]
  dest = "data/placeholder_config"
}

group("tests") {
  testonly = true
  deps = []

  # TODO(https://fxbug.dev/485919246): Flaky test disabled on coverage.
  # Please fix the flake and remove the condition below.
  if (!is_coverage) {
    deps += [ ":realm_integration_tests" ]
  }
}

group("ctf-tests") {
  testonly = true
  deps = [ ":realm_integration_tests-ctf_archive" ]
}

