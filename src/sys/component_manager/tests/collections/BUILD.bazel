load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

# TODO(109696): Add this test to CTF by following the guide at
# https://fuchsia.dev/fuchsia-src/development/testing/ctf/contributing_tests.
rustc_test(
    name = "collections_integration_test_bin",
    srcs = ["integration_test.rs"],
    crate_name = "collections_integration_test",
    crate_root = "integration_test.rs",
    edition = "2024",
    deps = [
        "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust",
        "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.process:fuchsia.process_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-runtime",
        "//src/sys/component_manager/tests/fidl:components_rust",
        "//third_party/rust_crates/vendor:anyhow",
    ],
)

fx_packaged_binary(
    name = "collections_integration_test_packaged_bin",
    testonly = True,
    binary = ":collections_integration_test_bin",
    binary_name = "collections_integration_test",
)

rustc_binary(
    name = "write_startup_socket_bin",
    testonly = True,
    srcs = ["write_startup_socket.rs"],
    crate_name = "write_startup_socket",
    crate_root = "write_startup_socket.rs",
    edition = "2024",
    tags = ["manual"],
    deps = [
        "//sdk/rust/zx",
        "//src/lib/fuchsia-runtime",
    ],
)

fx_packaged_binary(
    name = "write_startup_socket_bin_packaged_bin",
    testonly = True,
    binary = ":write_startup_socket_bin",
    binary_name = "write_startup_socket",
)

fx_component_manifest(
    name = "write_startup_socket-manifest",
    testonly = True,
    component_name = "write_startup_socket",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/write_startup_socket.cml",
)

fx_component(
    name = "write_startup_socket",
    testonly = True,
    compiled_manifest = ":write_startup_socket-manifest",
    deps = [":write_startup_socket_bin_packaged_bin"],
)

fx_component_manifest(
    name = "trigger_a-manifest",
    testonly = True,
    component_name = "trigger_a",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/trigger_a.cml",
)

fx_component(
    name = "trigger_a",
    testonly = True,
    compiled_manifest = ":trigger_a-manifest",
    visibility = ["//src/sys/component_manager/tests/dictionaries:__pkg__"],
    deps = [
        "//src/sys/component_manager/tests:trigger_packaged_bin",  # @bazel2gn:path_overwrite://src/sys/component_manager/tests:trigger_bin
    ],
)

fx_component_manifest(
    name = "trigger_b-manifest",
    testonly = True,
    component_name = "trigger_b",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/trigger_b.cml",
)

fx_component(
    name = "trigger_b",
    testonly = True,
    compiled_manifest = ":trigger_b-manifest",
    visibility = ["//src/sys/component_manager/tests/dictionaries:__pkg__"],
    deps = [
        "//src/sys/component_manager/tests:trigger_packaged_bin",  # @bazel2gn:path_overwrite://src/sys/component_manager/tests:trigger_bin
    ],
)

fx_component_manifest(
    name = "trigger_realm-manifest",
    testonly = True,
    component_name = "trigger_realm",
    includes = [
        "//sdk/lib/inspect:offer.shard",
        "//sdk/lib/syslog:offer.shard",
    ],
    manifest = "meta/trigger_realm.cml",
)

fx_component(
    name = "trigger_realm",
    testonly = True,
    compiled_manifest = ":trigger_realm-manifest",
)

fx_component_manifest(
    name = "collections_integration_test_component-manifest",
    testonly = True,
    component_name = "collections_integration_test_component",
    includes = [
        "//sdk/lib/inspect:offer.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/collections_integration_test.cml",
)

fx_test_component(
    name = "collections_integration_test_component",
    compiled_manifest = ":collections_integration_test_component-manifest",
    deps = [":collections_integration_test_packaged_bin"],
)

fx_package(
    name = "collections_integration_test_package",
    package_name = "collections_integration_test",
    components = [
        ":trigger_a",
        ":trigger_b",
        ":trigger_realm",
        ":write_startup_socket",
        "//src/sys/component_manager/testing/echo_server",
    ],
    test_components = [":collections_integration_test_component"],
)

fx_test(
    name = "collections_integration_test",
    package = ":collections_integration_test_package",
    visibility = ["//src/sys/component_manager:__pkg__"],
)
