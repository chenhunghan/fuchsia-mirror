load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")
load("//build/component:config.bzl", "component_config")

package(default_applicable_licenses = ["//:license"])

rustc_test(
    name = "component_manager_panic_test_bin",
    srcs = ["component_manager_panic.rs"],
    crate_name = "component_manager_panic_test",
    crate_root = "component_manager_panic.rs",
    edition = "2024",
    deps = [
        "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust",
        "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//src/sys/lib/component-events",
    ],
)

fx_packaged_binary(
    name = "component_manager_panic_test_packaged_bin",
    testonly = True,
    binary = ":component_manager_panic_test_bin",
    binary_name = "component_manager_panic_test",
)

component_config(
    name = "component_manager_config",
    testonly = True,
    srcs = ["config.json5"],
)

fx_component_manifest(
    name = "component_manager-manifest",
    testonly = True,
    component_name = "component_manager",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/component_manager.cml",
)

fx_component(
    name = "component_manager",
    testonly = True,
    compiled_manifest = ":component_manager-manifest",
    deps = [
        ":component_manager_config",
        "//src/sys/component_manager:bin_with_tracing_packaged",  # @bazel2gn:path_overwrite://src/sys/component_manager:bin_with_tracing
    ],
)

fx_component_manifest(
    name = "component_manager_panic_test_cmp-manifest",
    testonly = True,
    component_name = "component_manager_panic_test_cmp",
    includes = [
        "//sdk/lib/inspect:offer.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/component_manager_panic_test.cml",
)

fx_test_component(
    name = "component_manager_panic_test_cmp",
    compiled_manifest = ":component_manager_panic_test_cmp-manifest",
    deps = [":component_manager_panic_test_packaged_bin"],
)

fx_package(
    name = "component_manager_panic_test_package",
    package_name = "component_manager_panic_test",
    components = [":component_manager"],
    test_components = [":component_manager_panic_test_cmp"],
)

fx_test(
    name = "component_manager_panic_test",
    max_log_severity = "ERROR",
    package = ":component_manager_panic_test_package",
    visibility = ["//src/sys/component_manager:__pkg__"],
)
