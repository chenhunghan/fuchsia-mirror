load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")
load(
    "//build/bazel/rules/testing:fx_unittest_component.bzl",
    "fx_unittest_component",
)

package(default_applicable_licenses = ["//:license"])

rustc_test(
    name = "cast_resolver_bin",
    srcs = ["integration_test.rs"],
    aspect_hints = ["//src/lib/fuchsia-component-test:includes"],
    crate_name = "cast_resolver",
    crate_root = "integration_test.rs",
    edition = "2024",
    deps = [
        "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust",
        "//sdk/fidl/fuchsia.component.resolution:fuchsia.component.resolution_rust",
        "//sdk/fidl/fuchsia.mem:fuchsia.mem_rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-component-test:fuchsia-component-test-lib",  # @bazel2gn:path_overwrite://src/lib/fuchsia-component-test
        "//src/lib/versioning/version-history/rust/data",
        "//src/sys/lib/cm_rust",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
    ],
)

fx_unittest_component(
    name = "cast_resolver_test_component",
    binary = ":cast_resolver_bin",
    component_name = "cast_resolver_test",
)

fx_package(
    name = "cast_resolver_test_package",
    package_name = "cast_resolver_test",
    components = [
        "//src/lib/fuchsia-component-test/realm_builder_server:realm_builder_server_component",
        "//src/sys/component_manager:component-manager-realm-builder-cmp",
    ],
    test_components = [":cast_resolver_test_component"],
)

fx_test(
    name = "cast_resolver_test",
    package = ":cast_resolver_test_package",
    visibility = ["//src/sys/component_manager:__pkg__"],
)
