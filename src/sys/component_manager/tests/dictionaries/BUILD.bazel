load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

rustc_test(
    name = "dictionaries_integration_test_bin",
    srcs = ["src/lib.rs"],
    edition = "2024",
    deps = [
        "//examples/components/routing/fidl:echo_rust",
        "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust",
        "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-component-test:fuchsia-component-test-lib",  # @bazel2gn:path_overwrite://src/lib/fuchsia-component-test
        "//src/lib/fuchsia-fs",
        "//src/lib/fuchsia-sync",
        "//src/storage/lib/vfs/rust:vfs",
        "//src/sys/component_manager/tests/fidl:components_rust",
        "//src/sys/lib/cm_rust",
        "//src/sys/lib/cm_types",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

fx_packaged_binary(
    name = "dictionaries_integration_test_packaged_bin",
    testonly = True,
    binary = ":dictionaries_integration_test_bin",
    binary_name = "dictionaries_integration_test_bin",
)

rustc_binary(
    name = "dict_trigger_bin",
    testonly = True,
    srcs = ["src/trigger.rs"],
    crate_name = "dict_trigger",
    crate_root = "src/trigger.rs",
    edition = "2024",
    deps = [
        "//examples/components/routing/fidl:echo_rust",
        "//sdk/fidl/fuchsia.component.runtime:fuchsia.component.runtime_rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/storage/lib/vfs/rust:vfs",
        "//src/sys/component_manager/tests/fidl:components_rust",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

fx_packaged_binary(
    name = "dict_trigger_packaged_bin",
    testonly = True,
    binary = ":dict_trigger_bin",
    binary_name = "dict_trigger",
)

fx_component_manifest(
    name = "trigger_c-manifest",
    testonly = True,
    component_name = "trigger_c",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/trigger_c.cml",
    restricted_features = ["dynamic_dictionaries"],
)

fx_component(
    name = "trigger_c",
    testonly = True,
    compiled_manifest = ":trigger_c-manifest",
    deps = [":dict_trigger_packaged_bin"],
)

fx_component_manifest(
    name = "directory_test-manifest",
    testonly = True,
    component_name = "directory_test",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/directory_test.cml",
)

fx_component(
    name = "directory_test",
    testonly = True,
    compiled_manifest = ":directory_test-manifest",
    deps = [":dict_trigger_packaged_bin"],
)

fx_component_manifest(
    name = "dictionaries_integration_test-manifest",
    testonly = True,
    component_name = "dictionaries_integration_test",
    includes = [
        "//sdk/lib/sys/component:realm_builder.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/dictionaries_integration_test.cml",
    restricted_features = ["use_dictionaries"],
)

fx_test_component(
    name = "dictionaries_integration_test_component",
    compiled_manifest = ":dictionaries_integration_test-manifest",
    deps = [":dictionaries_integration_test_packaged_bin"],
)

fx_package(
    name = "dictionaries_integration_test_package",
    package_name = "dictionaries_integration_test",
    components = [
        ":directory_test",
        ":trigger_c",
        "//src/lib/fuchsia-component-test/realm_builder_server:realm_builder_server_component",
        "//src/sys/component_manager:component-manager-realm-builder-cmp",
        "//src/sys/component_manager/testing/echo_server",
        "//src/sys/component_manager/tests/collections:trigger_a",
        "//src/sys/component_manager/tests/collections:trigger_b",
    ],
    test_components = [":dictionaries_integration_test_component"],
)

fx_test(
    name = "dictionaries_integration_test",
    package = ":dictionaries_integration_test_package",
    visibility = ["//src/sys/component_manager:__pkg__"],
)
