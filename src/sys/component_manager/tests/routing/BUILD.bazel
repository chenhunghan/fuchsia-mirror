load("//build/bazel/rules/components:expect_includes.bzl", "expect_includes")
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

rustc_test(
    name = "routing_integration_test_bin",
    srcs = ["integration_test.rs"],
    crate_name = "routing_integration_test",
    crate_root = "integration_test.rs",
    edition = "2024",
    deps = [
        "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust",
        "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//src/sys/component_manager/tests/fidl:components_rust",
    ],
)

fx_packaged_binary(
    name = "routing_integration_test_packaged_bin",
    testonly = True,
    binary = ":routing_integration_test_bin",
    binary_name = "routing_integration_test",
)

expect_includes(
    name = "trigger_shard",
    includes = ["meta/trigger.shard.cml"],
)

fx_component_manifest(
    name = "trigger-manifest",
    testonly = True,
    component_name = "trigger",
    includes = [
        "meta/trigger.shard.cml",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/trigger.cml",
)

fx_component(
    name = "trigger",
    testonly = True,
    compiled_manifest = ":trigger-manifest",
    deps = [
        "//src/sys/component_manager/tests:trigger_packaged_bin",  # @bazel2gn:path_overwrite://src/sys/component_manager/tests:trigger_bin
    ],
)

fx_component_manifest(
    name = "routing_integration_test-manifest",
    testonly = True,
    component_name = "routing_integration_test",
    includes = [
        "//sdk/lib/inspect:offer.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/routing_integration_test.cml",
)

fx_test_component(
    name = "routing_integration_test_component",
    compiled_manifest = ":routing_integration_test-manifest",
    deps = [":routing_integration_test_packaged_bin"],
)

fx_package(
    name = "routing_integration_test_package",
    package_name = "routing_integration_test",
    components = [
        ":trigger",
        # https://fxbug.dev/42052321: Dep included for affected tests presubmit
        "//src/sys/component_manager:component-manager-realm-builder-cmp",
        "//src/sys/component_manager/testing/echo_server",
    ],
    test_components = [":routing_integration_test_component"],
)

fx_test(
    name = "routing_integration_test",
    package = ":routing_integration_test_package",
    visibility = ["//src/sys/component_manager:__pkg__"],
)
