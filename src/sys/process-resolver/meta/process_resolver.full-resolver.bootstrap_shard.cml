{
    children: [
        {
            name: "process_resolver",
            url: "fuchsia-boot:///process-resolver#meta/process_resolver.cm",
        },
    ],
    offer: [
        {
            protocol: "fuchsia.pkg.PackageResolver-boot",
            from: "parent",
            to: "#process_resolver",
        },
        {
            dictionary: "diagnostics",
            from: "self",
            to: "#process_resolver",
        },
        {
            protocol: "fuchsia.pkg.PackageResolver-full",
            from: "#pkg-cache",
            as: "fuchsia.pkg.PackageResolver-pkg",
            to: "#process_resolver",
        },
        {
            protocol: "fuchsia.process.Resolver",
            from: "#process_resolver",
            to: "self/toolbox",
            target_availability: "unknown",
        },
    ],
    expose: [
        {
            protocol: "fuchsia.process.Resolver",
            from: "#process_resolver",
        },
    ],
}
