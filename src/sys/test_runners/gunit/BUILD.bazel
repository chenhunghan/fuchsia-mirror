load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":gunit-runner-tests"],
    visibility = ["//src/sys:__pkg__"],
)

fx_packaged_binary(
    name = "gunit_packaged_bin",
    binary = "//src/sys/test_runners/gtest:gunit_bin",
    binary_name = "gunit_runner",
)

fx_component_manifest(
    name = "gunit-runner-component_manifest",
    component_name = "gunit-runner",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//sdk/lib/trace:client.shard",
        "//src/sys/test_runners:lib.shard",
    ],
    manifest = "meta/gunit_runner.cml",
)

fx_component(
    name = "gunit-runner-component",
    compiled_manifest = ":gunit-runner-component_manifest",
    deps = [
        ":gunit_packaged_bin",  # @bazel2gn:path_overwrite://src/sys/test_runners/gtest:gunit_bin
    ],
)

fx_packaged_binary(
    name = "gunit_bin_test_packaged_bin",
    testonly = True,
    binary = "//src/sys/test_runners/gtest:gunit_bin_test",
    binary_name = "gunit_runner_bin_test",
)

fx_component_manifest(
    name = "gunit-runner-tests_manifest",
    testonly = True,
    component_name = "gunit-runner-tests",
    includes = [
        "//sdk/lib/inspect:offer.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners:tmp_storage.shard.cml",
        "//src/sys/test_runners/rust:default",
    ],
    manifest = "meta/gunit_runner_bin_test.cml",
)

fx_test_component(
    name = "gunit-runner-tests_component",
    compiled_manifest = ":gunit-runner-tests_manifest",
    deps = [
        ":gunit_bin_test_packaged_bin",  # @bazel2gn:path_overwrite://src/sys/test_runners/gtest:gunit_bin_test
        "//src/sys/test_runners/gtest/test_data:gunit_all_bins",
    ],
)

fx_package(
    name = "gunit-runner-tests_package",
    package_name = "gunit-runner-tests",
    components = ["//src/sys/test_runners/lib_loader_cache:lib_loader_runner_cache_cmp"],
    test_components = [":gunit-runner-tests_component"],
)

fx_test(
    name = "gunit-runner-tests",
    package = ":gunit-runner-tests_package",
)
