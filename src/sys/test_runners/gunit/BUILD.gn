import("//build/components.gni")

# Retained for GN callers (//sdk/ctf, //src/sys/test_manager) and the
# //bundles/assembly/bazel_inputs bridge (//bundles/assembly:testing_support is
# non-testonly).
fuchsia_package("gunit-runner") {
  visibility = [
    ":*",
    "//bundles/assembly/*",
    "//sdk/ctf/*",
    "//src/sys/test_manager:*",
  ]
  deps = [ ":gunit-runner-component" ]
}

group("tests") {
  testonly = true
  deps = [
    ":gunit-runner-tests_package",
    "tests",
  ]
}

