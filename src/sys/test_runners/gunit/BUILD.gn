import("//build/tools/bazel2gn/bazel_migration.gni")

fuchsia_component_manifest("gunit-runner-component_manifest") {
  component_name = "gunit-runner"
  manifest = "meta/gunit_runner.cml"
}

fuchsia_component("gunit-runner-component") {
  cm_label = ":gunit-runner-component_manifest"
  deps = [ "//src/sys/test_runners/gtest:gunit_bin" ]
}

fuchsia_component_manifest("gunit-runner-tests_manifest") {
  testonly = true
  component_name = "gunit-runner-tests"
  manifest = "meta/gunit_runner_bin_test.cml"
}

fuchsia_test_component("gunit-runner-tests_component") {
  cm_label = ":gunit-runner-tests_manifest"
  deps = [
    "//src/sys/test_runners/gtest:gunit_bin_test",
    "//src/sys/test_runners/gtest/test_data:gunit_all_bins",
  ]
}

fuchsia_test_package("gunit-runner-tests_package") {
  package_name = "gunit-runner-tests-gn"
  test_components = [ ":gunit-runner-tests_component" ]
  deps =
      [ "//src/sys/test_runners/lib_loader_cache:lib_loader_runner_cache_cmp" ]
}
