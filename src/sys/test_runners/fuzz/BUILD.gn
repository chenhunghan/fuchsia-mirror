import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_binary("bin") {
  sources = [
    "src/launcher.rs",
    "src/main.rs",
  ]
  output_name = "fuzz_test_runner"
  edition = "2024"
  proc_macro_deps = [ "//third_party/rust_crates:async-trait" ]
  deps = [
    "//sdk/fidl/fuchsia.process:fuchsia.process_rust",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-runtime",
    "//src/sys/fuzzing/fidl:fuchsia.fuzzer_rust",
    "//src/sys/test_runners:lib",
    "//src/sys/test_runners/elf:lib",
    "//third_party/rust_crates:anyhow",
  ]
}

fuchsia_component_manifest("fuzz-test-runner-component-manifest") {
  component_name = "fuzz-test-runner"
  manifest = "meta/fuzz_test_runner.cml"
}

fuchsia_component("fuzz-test-runner-component") {
  cm_label = ":fuzz-test-runner-component-manifest"
  deps = [ ":bin" ]
}

fuchsia_component_manifest("fuzz-starnix-test-runner-component-manifest") {
  component_name = "fuzz-starnix-test-runner"
  manifest = "meta/fuzz_starnix_test_runner.cml"
}

fuchsia_component("fuzz-starnix-test-runner-component") {
  cm_label = ":fuzz-starnix-test-runner-component-manifest"
  deps = [ ":bin" ]
}
