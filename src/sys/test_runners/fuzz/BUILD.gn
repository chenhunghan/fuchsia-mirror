import("//build/components.gni")

group("tests") {
  testonly = true
  deps = [ "tests" ]
}

# Retained in BUILD.gn because non-assembly GN package
# //src/sys/test_manager:pkg includes
# //src/sys/test_runners/fuzz:fuzz-test-runner in subpackages.
fuchsia_package("fuzz-test-runner") {
  visibility = [
    ":*",
    "//bundles/assembly/*",
    "//sdk/ctf/*",
    "//src/sys/test_manager:*",
  ]
  deps = [
    ":fuzz-starnix-test-runner-component",
    ":fuzz-test-runner-component",
  ]
}

