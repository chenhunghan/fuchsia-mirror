import("//build/components.gni")

group("tests") {
  testonly = true
  deps = [ ":integration-test-pkg" ]
}

# Retained in BUILD.gn with `integration-test-pkg` because the test package
# depends on the GN-only component `//src/sys/fuzzing/common/testing:fuzzer`
# and GN-only subpackage `//src/sys/test_manager:pkg`, and `bazel2gn` only
# converts `fx_test_component` when paired with `fx_package` and `fx_test`.
fuchsia_test_component("integration-test") {
  manifest = "meta/fuzz_test_runner_integration_test.cml"
  deps = [ ":bin" ]
  test_type = "test_arch"
}

fuchsia_test_package("integration-test-pkg") {
  package_name = "fuzz-test-runner-tests"
  test_components = [ ":integration-test" ]
  deps = [
    "//src/sys/fuzzing/common/testing:fuzzer",
    "//src/sys/fuzzing/manager",
    "//src/sys/fuzzing/registry",
  ]
  subpackages = [ "//src/sys/test_manager:pkg" ]
  test_specs = {
    # Run sequentially.
    parallel = 1
  }
}

