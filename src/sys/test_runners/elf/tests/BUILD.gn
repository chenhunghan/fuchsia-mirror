import("//build/components.gni")

# The test component and package stay in GN: the package subpackages
# `//src/sys/test_manager:pkg` and `../test_data:elf-test-runner-example-tests`,
# which are not available in Bazel yet.
fuchsia_test_component("elf_test_runner_integration_test") {
  manifest = "meta/elf_test_runner_integration_test.cml"
  deps = [
    ":tests_bin",
    "//src/lib/fuchsia",
  ]
  test_type = "test_arch"
}

fuchsia_test_package("elf-test-runner-integration-test") {
  test_components = [ ":elf_test_runner_integration_test" ]
  subpackages = [
    "//src/sys/test_manager:pkg",
    "../test_data:elf-test-runner-example-tests",
  ]
}

group("tests") {
  testonly = true
  deps = [
    ":elf-test-runner-integration-test",
    "../test_data:elf-test-runner-example-tests",
    "//src/lib/fuchsia",
  ]
}

