import("//build/components.gni")

# The test component and package stay in GN: the package subpackages
# `//src/sys/test_manager:pkg`, which has no Bazel target yet because it
# depends on GN-only components and unmigrated test runner packages.
fuchsia_test_component("stress_runner_integration_test") {
  manifest = "meta/stress_runner_integration_test.cml"
  deps = [
    ":tests_bin",
    "//src/lib/fuchsia",
  ]
  test_type = "test_arch"
}

fuchsia_test_package("stress-runner-integration-test") {
  test_components = [ ":stress_runner_integration_test" ]

  # This includes the `always_fail`, `always_pass`, `timeout` and `echo` stress
  # tests used in this integration test.
  deps = [
    "test_data",
    "//src/lib/fuchsia",
  ]

  subpackages = [ "//src/sys/test_manager:pkg" ]

  # TODO(https://fxbug.dev/42065991): Flaky test disabled on coverage.
  # Please fix the flake and remove the condition below.
  if (is_coverage) {
    test_specs = {
      environments = [
        {
          dimensions = emu_env.dimensions
          tags = [ "disabled" ]
        },
      ]
    }
  }
}

group("tests") {
  testonly = true
  deps = [
    ":stress-runner-integration-test",
    "//src/lib/fuchsia",
  ]
}

