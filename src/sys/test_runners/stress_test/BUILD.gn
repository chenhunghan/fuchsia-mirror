import("//build/components.gni")

# Retained for GN subpackages in //src/sys/test_manager:pkg and the
# //bundles/assembly/bazel_inputs bridge (//bundles/assembly:testing_support is
# non-testonly).
fuchsia_package("stress-test-runner") {
  testonly = true
  deps = [ ":stress-test-runner-cmp" ]
}

group("tests") {
  testonly = true
  deps = [ "tests" ]
}

