import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_binary("bin") {
  sources = [
    "src/main.rs",
    "src/test_server.rs",
  ]
  output_name = "rust_test_runner"
  configs += [ "//build/config/rust:bootfs" ]
  edition = "2024"
  proc_macro_deps = [ "//third_party/rust_crates:async-trait" ]
  visibility = [
    ":*",
    "//src/sys/test_runners/starnix:*",
  ]
  deps = [
    "//sdk/fidl/fuchsia.component.runner:fuchsia.component.runner_rust",
    "//sdk/fidl/fuchsia.process:fuchsia.process_rust",
    "//sdk/fidl/fuchsia.test:fuchsia.test_rust",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-runtime",
    "//src/lib/trace/rust:trace-provider",
    "//src/sys/lib/namespace",
    "//src/sys/test_runners:lib",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:regex",
    "//third_party/rust_crates:thiserror",
  ]
}
if (is_fuchsia) {
  rustc_test("bin_test") {
    sources = [
      "src/main.rs",
      "src/test_server.rs",
    ]
    edition = "2024"
    proc_macro_deps = [ "//third_party/rust_crates:async-trait" ]
    deps =
        [
          "//sdk/fidl/fuchsia.component.runner:fuchsia.component.runner_rust",
          "//sdk/fidl/fuchsia.process:fuchsia.process_rust",
          "//sdk/fidl/fuchsia.test:fuchsia.test_rust",
          "//sdk/rust/zx",
          "//src/lib/fidl/rust/fidl",
          "//src/lib/fuchsia",
          "//src/lib/fuchsia-async",
          "//src/lib/fuchsia-component",
          "//src/lib/fuchsia-runtime",
          "//src/lib/trace/rust:trace-provider",
          "//src/sys/lib/namespace",
          "//src/sys/test_runners:lib",
          "//third_party/rust_crates:anyhow",
          "//third_party/rust_crates:futures",
          "//third_party/rust_crates:log",
          "//third_party/rust_crates:regex",
          "//third_party/rust_crates:thiserror",
        ] +
        [
          "//src/sys/test_runners:test_lib",
          "//third_party/rust_crates:assert_matches",
          "//third_party/rust_crates:itertools",
          "//third_party/rust_crates:pretty_assertions",
        ]
    source_root = "src/main.rs"
    configs += [ "//build/config/rust:bootfs" ]
    output_name = "rust_test_runner_bin_test"
  }
}

fuchsia_component_manifest("rust_test_runner_manifest") {
  component_name = "rust-test-runner"
  manifest = "meta/rust-test-runner.cml"
}

fuchsia_component("rust_test_runner") {
  cm_label = ":rust_test_runner_manifest"
  visibility = [
    ":*",
    "//src/sys/test_manager:*",
  ]
  deps = [ ":bin" ]
}

