import("//build/components.gni")

# Retained for GN callers (//sdk/ctf, //src/sys/test_manager) and the
# //bundles/assembly/bazel_inputs bridge (//bundles/assembly:testing_support is
# non-testonly).
fuchsia_package("rust-test-runner") {
  visibility = [
    ":*",
    "//bundles/assembly/*",
    "//sdk/ctf/*",
    "//src/sys/test_manager:*",
  ]
  deps = [ ":rust_test_runner" ]
}

fuchsia_package("rust-test-create-raw-processes-runner") {
  visibility = [
    ":*",
    "//bundles/assembly/*",
    "//sdk/ctf/*",
    "//src/sys/test_manager:*",
  ]
  deps = [ ":rust_test_create_raw_processes_runner" ]
}

fuchsia_package("rust-test-next-vdso-runner") {
  visibility = [
    ":*",
    "//bundles/assembly/*",
    "//sdk/ctf/*",
    "//src/sys/test_manager:*",
  ]
  deps = [ ":rust_test_next_vdso_runner" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bin_test",
    "tests",
  ]
}

