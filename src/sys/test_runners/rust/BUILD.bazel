load("//build/bazel/aspects:runner.bzl", "fx_runner_shard")
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":rust-test-runner-test"],
    visibility = ["//src/sys:__pkg__"],
)

exports_files(
    [
        "create_raw_processes.shard.cml",
        "default.shard.cml",
        "next-vdso.shard.cml",
    ],
    visibility = ["//visibility:public"],
)

fx_runner_shard(
    name = "default",
    shard = "default.shard.cml",
    visibility = ["//visibility:public"],
)

rustc_binary(
    name = "bin",
    srcs = [
        "src/main.rs",
        "src/test_server.rs",
    ],
    binary_name = "rust_test_runner",
    build_flags = ["//build/config/rust:bootfs"],
    edition = "2024",
    proc_macro_deps = ["//third_party/rust_crates/vendor:async-trait"],
    tags = ["manual"],
    visibility = ["//src/sys/test_runners/starnix:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.component.runner:fuchsia.component.runner_rust",
        "//sdk/fidl/fuchsia.process:fuchsia.process_rust",
        "//sdk/fidl/fuchsia.test:fuchsia.test_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-runtime",
        "//src/lib/trace/rust:trace-provider",
        "//src/sys/lib/namespace",
        "//src/sys/test_runners:lib",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:regex",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

rustc_test(
    name = "bin_test",
    build_flags = ["//build/config/rust:bootfs"],
    crate = ":bin",
    # Sets GN output_name via bazel2gn to match the original with_unit_tests binary name.
    crate_name = "rust_test_runner_bin_test",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//src/sys/test_runners:test_lib",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:itertools",
        "//third_party/rust_crates/vendor:pretty_assertions",
    ],
)

fx_packaged_binary(
    name = "bin_packaged_bin",
    binary = ":bin",
    binary_name = "rust_test_runner",
)

fx_component_manifest(
    name = "rust_test_runner_manifest",
    component_name = "rust-test-runner",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//sdk/lib/trace:client.shard",
        "//src/sys/test_runners:lib.shard.cml",
    ],
    manifest = "meta/rust-test-runner.cml",
)

fx_component(
    name = "rust_test_runner",
    compiled_manifest = ":rust_test_runner_manifest",
    visibility = ["//src/sys/test_manager:__pkg__"],
    deps = [":bin_packaged_bin"],
)

fx_component_manifest(
    name = "rust_test_create_raw_processes_runner_manifest",
    component_name = "rust-test-create-raw-processes-runner",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners:lib.shard.cml",
    ],
    manifest = "meta/rust-test-create-raw-processes-runner.cml",
)

fx_component(
    name = "rust_test_create_raw_processes_runner",
    compiled_manifest = ":rust_test_create_raw_processes_runner_manifest",
    deps = [":bin_packaged_bin"],
)

fx_component_manifest(
    name = "rust_test_next_vdso_runner_manifest",
    component_name = "rust-test-next-vdso-runner",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners:lib.shard.cml",
    ],
    manifest = "meta/rust-test-next-vdso-runner.cml",
)

fx_component(
    name = "rust_test_next_vdso_runner",
    compiled_manifest = ":rust_test_next_vdso_runner_manifest",
    deps = [":bin_packaged_bin"],
)

fx_packaged_binary(
    name = "bin_test_packaged_bin",
    testonly = True,
    binary = ":bin_test",
    binary_name = "rust_test_runner_bin_test",
)

fx_component_manifest(
    name = "test-component_manifest",
    testonly = True,
    component_name = "test-component",
    includes = [
        ":default",
        "//sdk/lib/syslog:client.shard",
        "//sdk/lib/syslog:offer.shard",
    ],
    manifest = "meta/test_component.cml",
)

fx_test_component(
    name = "test-component",
    compiled_manifest = ":test-component_manifest",
    deps = [
        ":bin_test_packaged_bin",
        "//src/sys/test_runners:test-with-process-launcher",
    ],
)

# Needs reviewer attention (bazel2gn skip): test hardcodes fuchsia-pkg://fuchsia.com/rust-test-runner-test#sample-rust-tests.cm so the rust-test-runner-test-gn package name generated by bazel2gn fails at runtime
# @bazel2gn:skip
fx_package(
    name = "rust-test-runner-test_package",
    package_name = "rust-test-runner-test",
    components = [
        "//src/sys/test_runners/lib_loader_cache:lib_loader_runner_cache_cmp",
        "//src/sys/test_runners/rust/test_data/huge-rust-tests",
        "//src/sys/test_runners/rust/test_data/no-rust-tests",
        "//src/sys/test_runners/rust/test_data/sample-rust-tests",
    ],
    test_components = [":test-component"],
)

# Needs reviewer attention (bazel2gn skip): test hardcodes fuchsia-pkg://fuchsia.com/rust-test-runner-test#sample-rust-tests.cm so the rust-test-runner-test-gn package name generated by bazel2gn fails at runtime
# @bazel2gn:skip
fx_test(
    name = "rust-test-runner-test",
    package = ":rust-test-runner-test_package",
)
