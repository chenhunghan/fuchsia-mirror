import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_test("tests_bin") {
  sources = [
    "helpers.rs",
    "main.rs",
  ]
  output_name = "rust_runner_integration_test"
  source_root = "main.rs"
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.test.manager:fuchsia.test.manager_rust",
    "//src/lib/fuchsia",
    "//src/sys/test_manager:test_lib",
    "//src/sys/test_runners:test_lib",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:pretty_assertions",
  ]
}

rustc_test("stress_tests_bin") {
  sources = [
    "helpers.rs",
    "stress_main.rs",
  ]
  output_name = "rust_runner_stress_test"
  source_root = "stress_main.rs"
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.test.manager:fuchsia.test.manager_rust",
    "//src/lib/fuchsia",
    "//src/sys/test_manager:test_lib",
    "//src/sys/test_runners:test_lib",
    "//third_party/rust_crates:anyhow",
  ]
}
