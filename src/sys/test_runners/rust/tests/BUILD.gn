import("//build/components.gni")

# The test components and package below stay in GN because the package's
# subpackages (`//src/sys/test_manager:pkg` and
# `../test_data:rust-test-runner-example`) do not have Bazel targets yet, and
# bazel2gn only converts test components listed in a converted `fx_package()`.
fuchsia_test_component("rust_runner_integration_test") {
  testonly = true
  manifest = "meta/rust_runner_integration_test.cml"
  deps = [
    ":tests_bin",
    "//src/lib/fuchsia",
  ]
  test_type = "test_arch"
}

fuchsia_test_component("rust_runner_stress_test") {
  manifest = "meta/rust_runner_stress_test.cml"
  deps = [
    ":stress_tests_bin",
    "//src/lib/fuchsia",
  ]
  test_type = "test_arch"
}

fuchsia_test_package("rust-runner-integration-test") {
  test_components = [ ":rust_runner_integration_test" ]
  subpackages = [
    "//src/sys/test_manager:pkg",
    "../test_data:rust-test-runner-example",
  ]

  if (!is_coverage) {
    # https://fxbug.dev/42157229: This stress test times out on coverage bot.
    test_components += [ ":rust_runner_stress_test" ]
  }
}

group("tests") {
  testonly = true
  deps = [
    ":rust-runner-integration-test",
    "../test_data",
    "//src/lib/fuchsia",
  ]
}

