load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")

package(default_applicable_licenses = ["//:license"])

rustc_test(
    name = "test",
    srcs = ["src/lib.rs"],
    crate_name = "huge_rust_tests",
    edition = "2024",
    proc_macro_deps = ["//src/sys/test_runners/rust/test_data/huge-rust-tests/macro:gen-tests-macro"],
)

fx_packaged_binary(
    name = "test_packaged_bin",
    testonly = True,
    binary = ":test",
    binary_name = "huge_rust_tests",
)

fx_component_manifest(
    name = "huge-rust-tests-manifest",
    testonly = True,
    component_name = "huge_rust_tests",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/huge_rust_tests.cml",
)

fx_component(
    name = "huge-rust-tests",
    testonly = True,
    compiled_manifest = ":huge-rust-tests-manifest",
    visibility = [
        "//src/sys/test_runners/rust:__pkg__",
        "//src/sys/test_runners/rust/test_data:__pkg__",
    ],
    deps = [":test_packaged_bin"],
)
