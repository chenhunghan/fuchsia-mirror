import("//build/components.gni")

# Retained in BUILD.gn because bazel2gn does not convert non-test fx_package
# and //src/sys/test_runners/rust/tests still subpackages it in GN.
fuchsia_package("rust-test-runner-example") {
  testonly = true
  deps = [
    ":echo-example",
    "concurrency-test",
    "huge-rust-tests",
    "no-rust-tests",
    "sample-rust-tests",
  ]
}

