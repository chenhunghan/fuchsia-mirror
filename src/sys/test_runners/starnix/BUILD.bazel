load("@fuchsia_rules_common//packages:resources.bzl", "resource")
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":starnix-test-runner-tests"],
    visibility = ["//src/sys:__pkg__"],
)

exports_files(
    ["unit_test.shard.cml"],
    visibility = ["//src/starnix:__subpackages__"],
)

rustc_binary(
    name = "bin",
    srcs = [
        "src/binder_latency.rs",
        "src/debian_guest.rs",
        "src/gbenchmark.rs",
        "src/gtest.rs",
        "src/helpers.rs",
        "src/main.rs",
        "src/results_parser.rs",
        "src/runner.rs",
        "src/selinux.rs",
        "src/syscalls_gtest.rs",
        "src/syscalls_libtest.rs",
        "src/test_suite.rs",
        "src/vts_binary.rs",
    ],
    crate_name = "starnix_test_runner",
    edition = "2024",
    tags = ["manual"],
    deps = [
        "//sdk/fidl/fuchsia.component.runner:fuchsia.component.runner_rust",
        "//sdk/fidl/fuchsia.data:fuchsia.data_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.process:fuchsia.process_rust",
        "//sdk/fidl/fuchsia.test:fuchsia.test_rust",
        "//sdk/fidl/fuchsia.test:rust_measure_tape_for_case",
        "//sdk/fidl/fuchsia.virtualization:fuchsia.virtualization_rust",
        "//sdk/lib/async/rust/scope_dispatcher",
        "//sdk/rust/zx",
        "//src/lib/fdio/rust:fdio",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-fs",
        "//src/lib/fuchsia-runtime",
        "//src/lib/fuchsia-sync",
        "//src/lib/trace/rust:trace-provider",
        "//src/performance/lib/fuchsiaperf",
        "//src/sys/lib/cm_types",
        "//src/sys/lib/namespace",
        "//src/sys/lib/runner",
        "//src/sys/test_runners:lib",
        "//src/sys/test_runners/gtest:lib",
        "//src/virtualization/lib/guest_interaction:fuchsia.virtualization.guest.interaction_rust",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        # GN uses the hyphenated target name heck-0_3; Bazel crate_universe uses heck_0_3.
        "//third_party/rust_crates/vendor:heck_0_3",  # @bazel2gn:path_overwrite://third_party/rust_crates:heck-0_3
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:uuid",
        "//third_party/rust_crates/vendor:xml",
    ],
)

rustc_test(
    name = "bin_test",
    crate = ":bin",
    # Sets GN output_name via bazel2gn to match the original with_unit_tests binary name.
    crate_name = "starnix_test_runner_bin_test",
    target_compatible_with = ["@platforms//os:fuchsia"],
)

# LINT.IfChange
# Hand-maintained in BUILD.gn above the sentinel while GN consumers remain.
# @bazel2gn:skip
resource(
    name = "mount_syscall_deps",
    src = "data/mount_syscall_deps.sh",
    dest = "data/mount_syscall_deps.sh",
)
# LINT.ThenChange(BUILD.gn)

fx_packaged_binary(
    name = "bin_test_packaged_bin",
    testonly = True,
    binary = ":bin_test",
    binary_name = "starnix_test_runner_bin_test",
)

fx_component_manifest(
    name = "starnix-test-runner-tests_manifest",
    testonly = True,
    component_name = "starnix-test-runner-tests",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default",
    ],
    manifest = "meta/starnix_test_runner_tests.cml",
)

fx_test_component(
    name = "starnix-test-runner-tests_component",
    compiled_manifest = ":starnix-test-runner-tests_manifest",
    deps = [
        ":bin_test_packaged_bin",
        ":mount_syscall_deps",
    ],
)

fx_package(
    name = "starnix-test-runner-tests_package",
    package_name = "starnix-test-runner-tests",
    test_components = [":starnix-test-runner-tests_component"],
)

fx_test(
    name = "starnix-test-runner-tests",
    max_log_severity = "ERROR",
    package = ":starnix-test-runner-tests_package",
)
