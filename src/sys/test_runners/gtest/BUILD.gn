import("//build/components.gni")
import("//tools/cmc/build/expect_includes.gni")

fuchsia_package("gtest-runner") {
  visibility = [
    ":*",
    "//bundles/assembly/*",
    "//sdk/ctf/*",
    "//src/sys/test_manager:*",
  ]
  deps = [ ":gtest-runner-component" ]
}

fuchsia_package("gtest-create-raw-processes-runner") {
  visibility = [
    ":*",
    "//bundles/assembly/*",
    "//sdk/ctf/*",
    "//src/sys/test_manager:*",
  ]
  deps = [ ":gtest-create-raw-processes-runner-component" ]
}

fuchsia_package("zxtest-runner") {
  visibility = [
    ":*",
    "//bundles/assembly/*",
    "//sdk/ctf/*",
    "//src/sys/test_manager:*",
  ]
  deps = [ ":zxtest-runner-component" ]
}

# Retained in BUILD.gn because it depends on GN-only `test_data:gtest_all_bins`.
fuchsia_unittest_package("gtest-runner-tests") {
  deps = [
    ":gtest_bin_test",
    "test_data:gtest_all_bins",
    "//src/sys/test_runners/lib_loader_cache:lib_loader_runner_cache_cmp",
  ]
  manifest = "meta/gtest_runner_bin_test.cml"
}

group("tests") {
  testonly = true
  deps = [
    ":gtest-runner-tests",
    "tests",
  ]
}

# Depend on this if your test uses ASSERT_DEATH or EXPECT_DEATH
# and your test component's cml is generated.
group("death_test") {
  testonly = true
  metadata = {
    # Used by the fuchsia_test_component_manifest() template.
    test_component_manifest_cml = [
      {
        include = [ "//src/sys/test_runners/gtest/death_test.shard.cml" ]
      },
    ]
  }
}

# Makes the test manifests that GN generates use the zxtest runner.
# Retained in BUILD.gn because `:zxtest` in BUILD.bazel is `fx_runner_shard`.
expect_includes("zxtest") {
  enforce = false
  includes = [ "zxtest.shard.cml" ]
}

