load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")

package(default_applicable_licenses = ["//:license"])

rustc_test(
    name = "tests_bin",
    srcs = [
        "helpers.rs",
        "tests.rs",
    ],
    compile_data = ["//src/sys/test_runners/gtest/test_data:sample_tests_golden_events.rsf"],
    crate_name = "gtest_runner_integration_test",
    crate_root = "tests.rs",
    edition = "2024",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//sdk/fidl/fuchsia.test.manager:fuchsia.test.manager_rust",
        "//src/lib/fuchsia",
        "//src/sys/test_manager:test_lib",
        "//src/sys/test_runners:test_lib",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:maplit",
        "//third_party/rust_crates/vendor:pretty_assertions",
    ],
)

rustc_test(
    name = "stress_tests_bin",
    srcs = [
        "helpers.rs",
        "stress_tests.rs",
    ],
    crate_name = "gtest_runner_stress_test",
    crate_root = "stress_tests.rs",
    edition = "2024",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//sdk/fidl/fuchsia.test.manager:fuchsia.test.manager_rust",
        "//src/lib/fuchsia",
        "//src/sys/test_manager:test_lib",
        "//src/sys/test_runners:test_lib",
        "//third_party/rust_crates/vendor:anyhow",
    ],
)
