load("//build/bazel/aspects:runner.bzl", "fx_runner_shard")
load("//build/bazel/rules/components:expect_includes.bzl", "expect_includes")
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")

package(default_applicable_licenses = ["//:license"])

exports_files(
    [
        "death_test.shard.cml",
        "default.shard.cml",
        "zxtest.shard.cml",
    ],
    visibility = ["//visibility:public"],
)

# Depend on this (via `aspect_hints`) if your test uses ASSERT_DEATH or
# EXPECT_DEATH and your test component's cml is generated. Mirrors GN's
# group("death_test").
# @bazel2gn:skip
expect_includes(
    name = "death_test",
    testonly = True,
    enforce = False,
    includes = ["death_test.shard.cml"],
    visibility = ["//:__subpackages__"],
)

fx_runner_shard(
    name = "default",
    shard = "default.shard.cml",
    visibility = ["//visibility:public"],
)

fx_runner_shard(
    name = "zxtest",
    shard = "zxtest.shard.cml",
    visibility = ["//visibility:public"],
)

rustc_library(
    name = "lib",
    srcs = [
        "src/lib.rs",
        "src/parser.rs",
    ],
    crate_name = "gtest_runner_lib",
    edition = "2024",
    visibility = ["//src/sys/test_runners/starnix:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//src/lib/fuchsia-fs",
        "//src/sys/test_runners:lib",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:serde_json",
    ],
)

rustc_binary(
    name = "gtest_bin",
    srcs = [
        "src/main.rs",
        "src/test_server.rs",
    ],
    binary_name = "gtest_runner",
    build_flags = ["//build/config/rust:bootfs"],
    crate_features = ["gtest"],
    edition = "2024",
    proc_macro_deps = ["//third_party/rust_crates/vendor:async-trait"],
    deps = [
        ":lib",
        "//sdk/fidl/fuchsia.component.runner:fuchsia.component.runner_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.process:fuchsia.process_rust",
        "//sdk/fidl/fuchsia.test:fuchsia.test_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-fs",
        "//src/lib/fuchsia-runtime",
        "//src/lib/trace/rust:trace-provider",
        "//src/sys/lib/namespace",
        "//src/sys/test_runners:lib",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:rand",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:thiserror",
        "//third_party/rust_crates/vendor:uuid",
    ],
)

rustc_test(
    name = "gtest_bin_test",
    build_flags = ["//build/config/rust:bootfs"],
    crate = ":gtest_bin",
    crate_features = ["gtest"],
    # Sets GN output_name via bazel2gn to match the original with_unit_tests binary name.
    crate_name = "gtest_runner_bin_test",
    deps = [
        "//src/sys/test_runners:test_lib",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:pretty_assertions",
    ],
)

rustc_binary(
    name = "gunit_bin",
    srcs = [
        "src/main.rs",
        "src/test_server.rs",
    ],
    binary_name = "gunit_runner",
    crate_features = ["gunit"],
    edition = "2024",
    proc_macro_deps = ["//third_party/rust_crates/vendor:async-trait"],
    visibility = ["//src/sys/test_runners/gunit:__pkg__"],
    deps = [
        ":lib",
        "//sdk/fidl/fuchsia.component.runner:fuchsia.component.runner_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.process:fuchsia.process_rust",
        "//sdk/fidl/fuchsia.test:fuchsia.test_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-fs",
        "//src/lib/fuchsia-runtime",
        "//src/lib/trace/rust:trace-provider",
        "//src/sys/lib/namespace",
        "//src/sys/test_runners:lib",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:rand",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:thiserror",
        "//third_party/rust_crates/vendor:uuid",
    ],
)

rustc_test(
    name = "gunit_bin_test",
    crate = ":gunit_bin",
    crate_features = ["gunit"],
    # Sets GN output_name via bazel2gn to match the original with_unit_tests binary name.
    crate_name = "gunit_runner_bin_test",
    visibility = ["//src/sys/test_runners/gunit:__pkg__"],
    deps = [
        "//src/sys/test_runners:test_lib",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:pretty_assertions",
    ],
)

fx_packaged_binary(
    name = "gtest_packaged_bin",
    binary = ":gtest_bin",
    binary_name = "gtest_runner",
)

fx_component_manifest(
    name = "gtest-runner-component_manifest",
    component_name = "gtest-runner",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//sdk/lib/trace:client.shard",
        "//src/sys/test_runners:lib.shard.cml",
    ],
    manifest = "meta/gtest_runner.cml",
)

fx_component(
    name = "gtest-runner-component",
    compiled_manifest = ":gtest-runner-component_manifest",
    visibility = ["//src/sys/test_manager:__pkg__"],
    deps = [":gtest_packaged_bin"],
)

fx_component_manifest(
    name = "gtest-create-raw-processes-runner-component_manifest",
    component_name = "gtest-create-raw-processes-runner",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//sdk/lib/trace:client.shard",
        "//src/sys/test_runners:lib.shard.cml",
    ],
    manifest = "meta/gtest_create_raw_processes_runner.cml",
)

fx_component(
    name = "gtest-create-raw-processes-runner-component",
    compiled_manifest = ":gtest-create-raw-processes-runner-component_manifest",
    deps = [":gtest_packaged_bin"],
)

fx_component_manifest(
    name = "zxtest-runner-component_manifest",
    component_name = "zxtest-runner",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners:lib.shard.cml",
    ],
    manifest = "meta/zxtest_runner.cml",
)

fx_component(
    name = "zxtest-runner-component",
    compiled_manifest = ":zxtest-runner-component_manifest",
    visibility = ["//src/sys/test_manager:__pkg__"],
    deps = [":gtest_packaged_bin"],
)
