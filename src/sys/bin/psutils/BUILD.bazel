# GN exposes the generated memgraph-schema.h via `include_dirs = [ target_gen_dir ]`
# and `deps += [ ":gen-memgraph-schema" ]`, whereas Bazel compiles against the
# genrule output via `srcs` and `includes`.
# TODO(https://fxbug.dev/570694755): Support `includes` and generated header `srcs` on `fx_cc_binary` in bazel2gn.
# @bazel2gn:raw_attribute:include_dirs = [ target_gen_dir ]
# @bazel2gn:raw_attribute:deps += [ ":gen-memgraph-schema" ]
fx_cc_binary(
    name = "memgraph",
    srcs = [
        "memgraph.cc",
        # GN depends on `:gen-memgraph-schema` in `deps` instead of `srcs`.
        # TODO(https://fxbug.dev/570694755): Support generated header `srcs` on `fx_cc_binary` in bazel2gn.
        ":gen-memgraph-schema",  # @bazel2gn:skip
    ],
    # bazel2gn does not translate `includes` on `fx_cc_binary`; GN uses
    # `include_dirs = [ target_gen_dir ]` via `@bazel2gn:raw_attribute` above.
    # TODO(https://fxbug.dev/570694755): Support `includes` on `fx_cc_binary` in bazel2gn.
    # @bazel2gn:skip
    includes = ["."],
    visibility = ["//visibility:private"],
    deps = [
        ":memgraph_internal",
        ":resources",
        "//sdk/lib/fdio",
        "//zircon/system/ulib/task-utils",
    ],
)

# Generate an include file that contains the schema JSON.
genrule(
    name = "gen-memgraph-schema",
    srcs = ["memgraph-schema.json"],
    outs = [
        # GN action() outputs require an explicit $target_gen_dir prefix.
        "memgraph-schema.h",  # @bazel2gn:path_overwrite:$target_gen_dir/memgraph-schema.h
    ],
    cmd = "$(location :gen-memgraph-schema-header.sh) $@ $<",
    tools = [":gen-memgraph-schema-header.sh"],
    visibility = ["//visibility:private"],
)

