package(default_applicable_licenses = ["//:license"])

# Includes unguarded Zircon headers (<zircon/types.h>) with no Fuchsia-only
# library deps from which Bazel would infer platform compatibility.
fx_cc_library(
    name = "object-utils",
    srcs = ["object-utils.cc"],
    hdrs = ["object-utils.h"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = ["//visibility:private"],
    alwayslink = True,
)

# Includes unguarded Zircon syscall headers (<zircon/syscalls.h>) with no
# Fuchsia-only library deps from which Bazel would infer platform compatibility.
fx_cc_library(
    name = "vmo-utils",
    srcs = ["vmo-utils.c"],
    hdrs = ["vmo-utils.h"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = ["//visibility:private"],
    alwayslink = True,
)

