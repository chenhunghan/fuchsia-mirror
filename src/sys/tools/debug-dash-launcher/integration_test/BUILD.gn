    ]
  }
}

fuchsia_component_manifest("debug-dash-launcher-test-manifest") {
  testonly = true
  component_name = "debug-dash-launcher-test"
  manifest = "meta/test.cml"
}

fuchsia_test_component("debug-dash-launcher-test-component") {
  cm_label = ":debug-dash-launcher-test-manifest"
  deps = [
    ":test_bin",
    "//src/developer/zxsh:sh",
  ]
}

fuchsia_test_package("debug-dash-launcher-test-package") {
  package_name = "debug-dash-launcher-test-gn"
  test_components = [ ":debug-dash-launcher-test-component" ]
  deps = [
    "//src/bringup/bin/ptysvc:component",
    "//src/sys/tools/debug-dash-launcher:component",
    "//src/sys/tools/debug-dash-launcher/integration_test/mock_resolver",
  ]
}
