load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":mock-omaha-server-fuchsia-tests"],
    visibility = ["//src/sys/pkg:__pkg__"],
)

rustc_library(
    name = "mock-omaha-server-fuchsia",
    srcs = ["src/lib.rs"],
    edition = "2024",
    visibility = [
        "//src/sys/pkg/testing/isolated-ota-env:__pkg__",
        "//src/sys/pkg/tests/omaha-client:__pkg__",
    ],
    deps = [
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-hyper",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:hyper-util",
        "//third_party/rust_crates/vendor:mock-omaha-server",
    ],
)

rustc_test(
    name = "mock-omaha-server-fuchsia_test",
    crate = ":mock-omaha-server-fuchsia",
    # Matches the binary path in meta/mock-omaha-server-fuchsia-tests.cml.
    crate_name = "mock_omaha_server_fuchsia_lib_test",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
)

fx_packaged_binary(
    name = "mock-omaha-server-fuchsia_test_packaged_bin",
    testonly = True,
    binary = ":mock-omaha-server-fuchsia_test",
    binary_name = "mock_omaha_server_fuchsia_lib_test",
)

fx_component_manifest(
    name = "mock-omaha-server-fuchsia-tests-manifest",
    testonly = True,
    component_name = "mock-omaha-server-fuchsia-tests",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/connectivity/network:meta/isolated-network.shard.cml",
        "//src/connectivity/network:meta/isolated-network-offers.shard.cml",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/mock-omaha-server-fuchsia-tests.cml",
)

fx_test_component(
    name = "mock-omaha-server-fuchsia-tests-component",
    compiled_manifest = ":mock-omaha-server-fuchsia-tests-manifest",
    deps = [":mock-omaha-server-fuchsia_test_packaged_bin"],
)

fx_package(
    name = "mock-omaha-server-fuchsia-tests-package",
    package_name = "mock-omaha-server-fuchsia-tests",
    testonly = True,
    subpackages = ["//src/connectivity/network/netstack3:package-for-tests"],
    test_components = [":mock-omaha-server-fuchsia-tests-component"],
)

fx_test(
    name = "mock-omaha-server-fuchsia-tests",
    package = ":mock-omaha-server-fuchsia-tests-package",
)
