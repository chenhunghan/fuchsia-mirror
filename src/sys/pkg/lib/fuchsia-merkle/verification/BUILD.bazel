load(
    "//build/testing/formal_verification:rust_lean_verification_test.bzl",
    "rust_lean_verification_test",
)

package(default_applicable_licenses = ["//:license"])

rust_lean_verification_test(
    name = "fuchsia_merkle_verification_test",
    assumptions_lean = "spec/Assumptions.lean",
    contract_lean = "spec/Contract.lean",
    contract_lean_target = "FuchsiaMerkleContract",
    crate_name = "fuchsia_merkle_core",
    crate_srcs = [
        "//src/sys/pkg/lib/fuchsia-merkle:core/src/lib.rs",
    ],
    lakefile = "lakefile.lean",
    proof_lean = [
        "proof/Proof.lean",
        "proof/Proof/BuilderProofs.lean",
        "proof/Proof/MerkleVerifierProofs.lean",
        "proof/Proof/ReadSizedAlignedProofs.lean",
        "proof/Proof/ReadSizedSliceProofs.lean",
        "proof/Proof/Sha256Sim.lean",
        "proof/Proof/SpecLemmas.lean",
        "proof/Proof/VerifierCommon.lean",
    ],
    spec_lean = "spec/Spec.lean",
    visibility = ["//src/sys/pkg/lib/fuchsia-merkle:__pkg__"],
)
