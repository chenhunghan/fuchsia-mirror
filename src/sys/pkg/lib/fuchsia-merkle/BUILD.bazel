load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "wrap_host_rust_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

# @bazel2gn:skip
exports_files(
    [
        "core/src/lib.rs",
    ],
    visibility = ["//src/sys/pkg/lib/fuchsia-merkle/verification:__pkg__"],
)

rustc_library(
    name = "fuchsia-merkle-core",
    srcs = [
        "core/src/lib.rs",
    ],
    crate_root = "core/src/lib.rs",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    visibility = ["//visibility:private"],
)

rustc_library(
    name = "fuchsia-merkle",
    srcs = [
        "src/lib.rs",
        "src/merkle_root_builder.rs",
        "src/merkle_verifier.rs",
        "src/util.rs",
    ],
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    visibility = [
        "//src/bringup:__subpackages__",
        "//src/developer:__subpackages__",
        "//src/lib/assembly:__subpackages__",
        "//src/recovery:__subpackages__",
        "//src/security:__subpackages__",
        "//src/storage:__subpackages__",
        "//src/sys:__subpackages__",
        "//tools/lib:__subpackages__",
    ],
    deps = [
        ":fuchsia-merkle-core",
        "//sdk/rust/zx-status",
        "//src/storage/lib/ptr_slice",
        "//src/sys/pkg/lib/fuchsia-hash",
        "//third_party/boringssl/rust:bssl-crypto.no-ssl",
    ],
)

# @bazel2gn:skip
rustc_test(
    name = "fuchsia-merkle_test",
    crate = ":fuchsia-merkle",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    deps = [
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

# @bazel2gn:skip
wrap_host_rust_test(
    name = "fuchsia-merkle_host_test",
    binary_name = "fuchsia-merkle_test",
)

# @bazel2gn:skip
test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [
        ":fuchsia-merkle_host_test",
        "//src/sys/pkg/lib/fuchsia-merkle/verification:fuchsia_merkle_verification_test",
    ],
    visibility = ["//src/sys/pkg:__pkg__"],
)

# @bazel2gn:skip
fx_unittest_package(
    name = "fuchsia-merkle-tests",
    unit_tests = [":fuchsia-merkle_test"],
)
