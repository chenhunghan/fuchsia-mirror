load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_test_data.bzl", "host_test_data_files")

package(default_applicable_licenses = ["//:license"])

go_library(
    name = "gopkg",
    # GN go_library attaches non_go_deps here; in Bazel non_go_deps is passed via host_test(data) in system_tests.bzl.
    testonly = True,  # @bazel2gn:raw_overwrite:true non_go_deps = [ "//src/sys/pkg/tests/system-tests:non_go_deps" ]
    srcs = [
        "config.go",
        "reboot_test.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/src/sys/pkg/tests/system-tests/reboot_test",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//:__subpackages__"],
    deps = [
        "//src/sys/pkg/tests/system-tests/check",
        "//src/sys/pkg/tests/system-tests/flash",
        "//src/sys/pkg/tests/system-tests/pave",
        "//src/testing/host-target-testing/artifacts",
        "//src/testing/host-target-testing/cli",
        "//src/testing/host-target-testing/device",
        "//src/testing/host-target-testing/errutil",
        "//src/testing/host-target-testing/ffx",
        "//src/testing/host-target-testing/sl4f",
        "//src/testing/host-target-testing/util",
        "//tools/lib/color",
        "//tools/lib/logger",
    ],
)

# Standalone test binary wrapped by system_test_reboot_suite() in system_tests.bzl.
# @bazel2gn:raw_attribute:environments = [ disabled_env ]
go_test(
    name = "system_tests_reboot",
    embed = [":gopkg"],
    tags = ["manual"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//src/sys/pkg/tests/system-tests:__pkg__",
        "//vendor/google:__subpackages__",
    ],
)

host_test_data_files(
    name = "system_tests_reboot.test_data",
    testonly = True,
    srcs = [":system_tests_reboot"],
    visibility = ["//src/sys/pkg/tests/system-tests:__pkg__"],
)
