system_test_upgrade_suite(
    name = "workstation-release-upgrade",
    cycle_count = "1",
    cycle_timeout = "10m",
    downgrade_release_builder = "fuchsia/global.ci/workstation_eng.x64-release-e2e-isolated",
    environments = [
        # These are disabled on NUCs to preserve hardware capacity.
        #{
        #  dimensions = {
        #    device_type = "Intel NUC Kit NUC7i5DNHE"
        #  }
        #  tags = [ "e2e-isolated" ]
        #},
        {
            "dimensions": {
                "device_type": "GCE",
            },
            "tags": ["e2e-isolated"],
        },
    ],
    pave_timeout = "10m",
    # We use flashing instead of paving as GCE does not support paving.
    use_flash = True,
)

