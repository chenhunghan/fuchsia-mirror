load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")

package(default_applicable_licenses = ["//:license"])

go_library(
    name = "pave",
    testonly = True,
    srcs = ["pave.go"],
    importpath = "go.fuchsia.dev/fuchsia/src/sys/pkg/tests/system-tests/pave",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//src/sys/pkg/tests/system-tests/reboot_test:__pkg__",
        "//src/sys/pkg/tests/system-tests/recovery_test:__pkg__",
        "//src/sys/pkg/tests/system-tests/upgrade_test:__pkg__",
    ],
    deps = [
        "//src/testing/host-target-testing/artifacts",
        "//src/testing/host-target-testing/device",
        "//src/testing/host-target-testing/ffx",
        "//third_party/golibs:golang.org/x/crypto/ssh",
        "//tools/lib/logger",
    ],
)
