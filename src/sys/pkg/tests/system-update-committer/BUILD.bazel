load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":system-update-committer-integration-tests"],
    visibility = ["//src/sys/pkg:__pkg__"],
)

rustc_test(
    name = "test_driver",
    srcs = ["src/lib.rs"],
    # Matches `program.binary` in
    # meta/system-update-committer-integration-test.cml.
    crate_name = "system_update_committer_integration_test",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    deps = [
        "//sdk/fidl/fuchsia.hardware.power.statecontrol:fuchsia.hardware.power.statecontrol_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.logger:fuchsia.logger_rust",
        "//sdk/fidl/fuchsia.paver:fuchsia.paver_rust",
        "//sdk/fidl/fuchsia.update:fuchsia.update_rust",
        "//sdk/rust/zx",
        "//src/lib/diagnostics/hierarchy/rust:diagnostics-hierarchy",
        "//src/lib/diagnostics/reader/rust",
        "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-component-test",
        "//src/lib/fuchsia-sync",
        "//src/sys/lib/cm_rust",
        "//src/sys/lib/component-events",
        "//src/sys/pkg/fidl/fuchsia.update.verify:fuchsia.update.verify_rust",
        "//src/sys/pkg/testing/mock-health-verification",
        "//src/sys/pkg/testing/mock-paver",
        "//src/sys/pkg/testing/mock-reboot",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

fx_packaged_binary(
    name = "test_driver_packaged_bin",
    testonly = True,
    binary = ":test_driver",
    binary_name = "system_update_committer_integration_test",
)

fx_component_manifest(
    name = "system-update-committer-integration-test-manifest",
    testonly = True,
    component_name = "system-update-committer-integration-test",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/sys/component:realm_builder.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners:tmp_storage.shard.cml",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/system-update-committer-integration-test.cml",
)

fx_test_component(
    name = "system-update-committer-integration-test",
    compiled_manifest = ":system-update-committer-integration-test-manifest",
    deps = [":test_driver_packaged_bin"],
)

fx_package(
    name = "package",
    package_name = "system-update-committer-integration-tests",
    testonly = True,
    components = [
        "//src/lib/fuchsia-component-test/realm_builder_server:realm_builder_server_component",
        "//src/sys/pkg/bin/system-update-committer:component",
    ],
    test_components = [":system-update-committer-integration-test"],
)

fx_test(
    name = "system-update-committer-integration-tests",
    package = ":package",
)
