import("//build/components.gni")

# Kept in GN while //src/sys/pkg/tests/pkgdir and //sdk/ctf/build subpackage
# them in GN (and test_realm_proxy transitively packages GN-only
# //src/storage/blobfs/bin:blobfs-component via
# //src/sys/pkg/testing/blobfs-ramdisk).
fuchsia_package("test_realm_proxy") {
  testonly = true
  deps = [ ":test_realm_proxy_component" ]
}

fuchsia_package("test_realm_proxy_fxblob") {
  testonly = true
  deps = [ ":test_realm_proxy_component_fxblob" ]
}

