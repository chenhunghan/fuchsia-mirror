load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":system-update-checker-integration-tests"],
    visibility = ["//src/sys/pkg:__pkg__"],
)

rustc_test(
    name = "driver",
    srcs = ["src/lib.rs"],
    crate_name = "system_update_checker_integration_test",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    deps = [
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.logger:fuchsia.logger_rust",
        "//sdk/fidl/fuchsia.paver:fuchsia.paver_rust",
        "//sdk/fidl/fuchsia.pkg:fuchsia.pkg_rust",
        "//sdk/fidl/fuchsia.pkg.garbagecollector:fuchsia.pkg.garbagecollector_rust",
        "//sdk/fidl/fuchsia.pkg.rewrite:fuchsia.pkg.rewrite_rust",
        "//sdk/fidl/fuchsia.update.channel:fuchsia.update.channel_rust",
        "//sdk/fidl/fuchsia.update.channelcontrol:fuchsia.update.channelcontrol_rust",
        "//sdk/fidl/fuchsia.update:fuchsia.update_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-component-test",
        "//src/lib/fuchsia-fs",
        "//src/lib/fuchsia-sync",
        "//src/sys/lib/cm_rust",
        "//src/sys/pkg/fidl/fuchsia.update.installer:fuchsia.update.installer_rust",
        "//src/sys/pkg/fidl/fuchsia.update.verify:fuchsia.update.verify_rust",
        "//src/sys/pkg/lib/fidl-fuchsia-update-installer-ext",
        "//src/sys/pkg/lib/fuchsia-pkg-testing",
        "//src/sys/pkg/testing/mock-health-verification",
        "//src/sys/pkg/testing/mock-installer",
        "//src/sys/pkg/testing/mock-paver",
        "//src/sys/pkg/testing/mock-resolver",
        "//src/sys/pkg/testing/mock-space",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:pretty_assertions",
        "//third_party/rust_crates/vendor:tempfile",
    ],
)

fx_packaged_binary(
    name = "driver_packaged_bin",
    testonly = True,
    binary = ":driver",
    binary_name = "system_update_checker_integration_test",
)

fx_component_manifest(
    name = "system-update-checker-integration-test-manifest",
    testonly = True,
    component_name = "system-update-checker-integration-test",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/sys/component:realm_builder.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/storage/lib/fs_management:client.shard.cml",
        "//src/sys/test_runners:tmp_storage.shard.cml",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/system-update-checker-integration-test.cml",
)

fx_test_component(
    name = "system-update-checker-integration-test",
    compiled_manifest = ":system-update-checker-integration-test-manifest",
    deps = [":driver_packaged_bin"],
)

fx_package(
    name = "system-update-checker-integration-tests-package",
    package_name = "system-update-checker-integration-tests",
    testonly = True,
    components = [
        "//src/lib/fuchsia-component-test/realm_builder_server:realm_builder_server_component",
        "//src/sys/pkg/bin/system-update-checker:component",
        "//src/sys/pkg/bin/system-update-committer:component",
    ],
    test_components = [":system-update-checker-integration-test"],
)

fx_test(
    name = "system-update-checker-integration-tests",
    max_log_severity = "ERROR",
    package = ":system-update-checker-integration-tests-package",
)
