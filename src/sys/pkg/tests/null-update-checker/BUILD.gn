import("//build/components.gni")

# `component` and `package` stay in GN because `:bin` depends on
# `//src/lib/fuchsia-component-test`, which bundles the GN-only
# `//src/lib/fuchsia-component-test/realm_builder_server:realm_builder_server_component`
# needed at runtime by `sys/component/realm_builder.shard.cml`.
fuchsia_test_component("component") {
  manifest = "meta/null-update-checker-integration-tests.cml"
  deps = [ ":bin" ]
  visibility = [ ":*" ]
}

fuchsia_test_package("package") {
  package_name = "null-update-checker-integration-tests"
  test_components = [ ":component" ]
  deps = [ "//src/sys/pkg/bin/null-update-checker:component" ]
}

group("hermetic_tests") {
  testonly = true
  public_deps = [ ":package" ]
}

