load("@fuchsia_rules_common//packages:resources.bzl", "resource")
load("//build/bazel/rules/packages:fx_bootfs_files_package.bzl", "fx_bootfs_files_package")

package(default_applicable_licenses = ["//:license"])

exports_files(
    [
        # If this target is included in the build, all components are allowed to use
        # isolated-persistent-storage, even if they are not in the component ID index.
        "component_id_index_no_restrict_storage.json5",
        # This index contains component ID entries for components whose source-code
        # lives in this repository (fuchsia.git).
        # See: https://fuchsia.dev/fuchsia-src/development/components/component_id_index
        "core_component_id_index.json5",
        "meta/core-env-base-resolver.core_shard.cml",
        "meta/core-env-full-resolver.core_shard.cml",
        "meta/core.cml",
        "meta/core.root_shard.cml",
        "meta/core.toolbox_shard.cml",
        "meta/heapdump.core_shard.cml",
        "meta/heapdump.root_shard.cml",
        "meta/lavapipe-disabled.core_shard.cml",
        "meta/lavapipe.core_shard.cml",
        "meta/restricted-storage.core_shard.cml",
        "meta/restricted_swd.core_shard.cml",
        "meta/unrestricted-storage.core_shard.cml",
        "meta/unrestricted_swd.core_shard.cml",
    ],
    visibility = ["//bundles/assembly:__subpackages__"],
)

resource(
    name = "config",
    src = "config/core.profiles",
    dest = "config/profiles/core.profiles",
)

fx_bootfs_files_package(
    name = "bootfs",
    package_name = "common_standard.bootfs_files_package",
    resources = [":config"],
    visibility = ["//bundles/assembly:__subpackages__"],
)
