import("//build/bazel/bazel_test_suite.gni")

group("sys") {
  testonly = true
  deps = [
    "cache_manager",
    "pkg",
    "time/timekeeper",
  ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    "cache_manager:tests",
    "component_manager:tests",
    "early_boot_instrumentation:tests",
    "fuzzing:tests",
    "lib:tests",
    "pkg:tests",
    "process-resolver:tests",
    "run_test_suite:tests",
    "runners:tests",
    "service-broker:tests",
    "stash:tests",
    "test_manager:tests",
    "test_runners:tests",
    "time:tests",
    "tools:tests",
  ]
}

bazel_test_suite("bazel_tests") {
  host_tests = [ "//src/sys:host_tests" ]
  target_tests = [ "//src/sys:target_tests" ]
}
