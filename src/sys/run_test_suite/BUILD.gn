import("//build/components.gni")

# Retained in BUILD.gn (bridged via
# `//bundles/assembly/bazel_inputs/src/sys/run_test_suite`) because `:bin`
# transitively links the dual-built `rustc_dylib`
# `//src/storage/lib/vfs/rust:vfs_dylib`, and migrating assembled packages that
# link a dual-built `rustc_dylib` to `fx_package` would duplicate the shared
# dylib in BlobFS alongside the GN-built dylib.
fuchsia_package("run_test_suite") {
  testonly = true
  deps = [ ":bin" ]
}

group("tests") {
  testonly = true
  deps = [
    ":lib_test",
    ":run-test-suite-unit-tests-package",
    "directory:tests",
    "tests",
  ]
}

# Retained in BUILD.gn without testonly for system image assembly because `:bin`
# transitively links the dual-built `rustc_dylib`
# `//src/storage/lib/vfs/rust:vfs_dylib`.
fuchsia_package("package") {
  package_name = "run-test-suite"
  deps = [ ":bin" ]
}

