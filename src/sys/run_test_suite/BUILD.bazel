load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")
load(
    "//build/bazel/rules/testing:fx_unittest_component.bzl",
    "fx_unittest_component",
)

package(default_applicable_licenses = ["//:license"])

_COMMON_SRCS = [
    "src/artifacts.rs",
    "src/cancel.rs",
    "src/connector.rs",
    "src/diagnostics.rs",
    "src/lib.rs",
    "src/outcome.rs",
    "src/output/directory.rs",
    "src/output/directory_with_stdout.rs",
    "src/output/line.rs",
    "src/output/memory.rs",
    "src/output/mod.rs",
    "src/output/mux.rs",
    "src/output/noop.rs",
    "src/output/shell/mod.rs",
    "src/output/shell/writer.rs",
    "src/params.rs",
    "src/realm.rs",
    "src/run.rs",
    "src/running_suite.rs",
    "src/stream_util.rs",
    "src/trace.rs",
]

# @bazel2gn:transformer=deps
_COMMON_DEPS = [
    "//sdk/rust/zx-status",
    "//src/lib/diagnostics/data/rust",
    "//src/lib/diagnostics/selectors",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-sync",
    "//src/lib/testing/test_list",
    "//src/sys/lib/cm_rust",
    "//src/sys/lib/moniker",
    "//src/sys/run_test_suite/directory",
    "//third_party/rust_crates/vendor:anyhow",
    "//third_party/rust_crates/vendor:futures",
    "//third_party/rust_crates/vendor:log",
    "//third_party/rust_crates/vendor:pin-project",
    "//third_party/rust_crates/vendor:thiserror",
    "//third_party/rust_crates/vendor:vte",
] + select({
    "@platforms//os:fuchsia": ["//src/lib/trace/rust:trace"],
    "//conditions:default": [],
})

# Unrolls the GN `run_test_suite_lib_tmpl` template into `lib` (via
# `flex_fidl` and `test_diagnostics`) and `lib_fdomain` (via `flex_fdomain`
# and `test_diagnostics_fdomain`).
rustc_library(
    name = "lib",
    srcs = _COMMON_SRCS,
    crate_name = "run_test_suite_lib",
    edition = "2024",
    # Only to be used by internal bin and tests.
    visibility = [
        "//src/developer/ffx:__subpackages__",
        "//src/sys/run_test_suite/tests:__subpackages__",
        "//src/sys/test_runners/rust/tests:__subpackages__",
    ],
    deps = _COMMON_DEPS + [
        "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust_flex",
        "//sdk/fidl/fuchsia.component:fuchsia.component_rust_flex",
        "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust_flex",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust_flex",
        "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust_flex",
        "//sdk/fidl/fuchsia.test.manager:fuchsia.test.manager_rust_flex",
        "//src/lib/fdomain/client:flex_fidl",
        "//src/lib/fuchsia-fs",
        "//src/lib/test_diagnostics/rust:test_diagnostics",
        "//src/sys/lib/component_debug",
    ],
)

# FDomain variant of `run_test_suite_lib_tmpl` (via `flex_fdomain` and
# `test_diagnostics_fdomain`).
rustc_library(
    name = "lib_fdomain",
    srcs = _COMMON_SRCS,
    crate_features = ["fdomain"],
    crate_name = "run_test_suite_lib",
    edition = "2024",
    # Only to be used by internal bin and tests.
    visibility = [
        "//src/developer/ffx:__subpackages__",
        "//src/sys/run_test_suite/tests:__subpackages__",
        "//src/sys/test_runners/rust/tests:__subpackages__",
    ],
    deps = _COMMON_DEPS + [
        "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust_fdomain_flex",
        "//sdk/fidl/fuchsia.component:fuchsia.component_rust_fdomain_flex",
        "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust_fdomain_flex",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust_fdomain_flex",
        "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust_fdomain_flex",
        "//sdk/fidl/fuchsia.test.manager:fuchsia.test.manager_rust_fdomain_flex",
        "//src/lib/fdomain/client:flex_fdomain",
        "//src/lib/fuchsia-fs:fuchsia-fs_fdomain",
        "//src/lib/test_diagnostics/rust:test_diagnostics_fdomain",
        "//src/sys/lib/component_debug:component_debug_fdomain",
    ],
)

rustc_test(
    name = "lib_test",
    crate = ":lib",
    # Sets GN `output_name` to match `bin/run_test_suite_lib_lib_test` in `meta/run_test_suite_lib_test.cml`.
    crate_name = "run_test_suite_lib_lib_test",
    link_deps = ["//third_party/zstd"],
    proc_macro_deps = ["//src/lib/testing/fixture"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//sdk/rust/zx",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//src/storage/lib/vfs/rust:vfs",
        "//third_party/rust_crates/vendor:ansi_term",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:maplit",
        "//third_party/rust_crates/vendor:tempfile",
        "//third_party/rust_crates/vendor:zstd",
    ],
)

rustc_binary(
    name = "bin",
    srcs = ["src/main.rs"],
    binary_name = "run-test-suite",
    build_flags = ["//build/config/rust:bootfs"],
    edition = "2024",
    deps = [
        ":lib",
        "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust",
        "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust",
        "//sdk/fidl/fuchsia.test.manager:fuchsia.test.manager_rust",
        "//sdk/rust/zx",
        "//src/lib/diagnostics/data/rust",
        "//src/lib/diagnostics/selectors",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//src/lib/trace/rust:trace-provider",
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

rustc_test(
    name = "bin_test",
    build_flags = ["//build/config/rust:bootfs"],
    crate = ":bin",
    # Preserves GN `output_name = "run_test_suite_bin_test"` (from `output_name = "run-test-suite"` on `:bin`).
    crate_name = "run_test_suite_bin_test",
    target_compatible_with = ["@platforms//os:fuchsia"],
)

fx_component_manifest(
    name = "test_realm-manifest",
    testonly = True,
    component_name = "test_realm",
    includes = [
        "//sdk/lib/inspect:offer.shard",
        "//sdk/lib/sys/component:realm_builder.shard",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/test_realm.cml",
)

fx_component(
    name = "test_realm",
    testonly = True,
    compiled_manifest = ":test_realm-manifest",
)

fx_component_manifest(
    name = "no_realm_protocol_realm-manifest",
    testonly = True,
    component_name = "no_realm_protocol_realm",
    includes = [
        "//sdk/lib/inspect:offer.shard",
        "//sdk/lib/sys/component:realm_builder.shard",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/no_realm_protocol_realm.cml",
)

fx_component(
    name = "no_realm_protocol_realm",
    testonly = True,
    compiled_manifest = ":no_realm_protocol_realm-manifest",
)

fx_packaged_binary(
    name = "lib_test_packaged_bin",
    testonly = True,
    binary = ":lib_test",
    binary_name = "run_test_suite_lib_lib_test",
)

fx_component_manifest(
    name = "run-test-suite-lib-test-manifest",
    testonly = True,
    component_name = "run-test-suite-lib-test",
    includes = [
        "//sdk/lib/inspect:offer.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners:tmp_storage.shard.cml",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/run_test_suite_lib_test.cml",
)

fx_test_component(
    name = "run-test-suite-lib-test",
    compiled_manifest = ":run-test-suite-lib-test-manifest",
    deps = [":lib_test_packaged_bin"],
)

fx_unittest_component(
    name = "run-test-suite-bin-test",
    binary = ":bin_test",
)

fx_package(
    name = "run-test-suite-unit-tests-package",
    package_name = "run-test-suite-unit-tests",
    testonly = True,
    components = [
        ":no_realm_protocol_realm",
        ":test_realm",
    ],
    test_components = [
        ":run-test-suite-lib-test",
        ":run-test-suite-bin-test",
    ],
)

fx_test(
    name = "run-test-suite-unit-tests",
    package = ":run-test-suite-unit-tests-package",
    visibility = ["//src/sys:__pkg__"],
)
