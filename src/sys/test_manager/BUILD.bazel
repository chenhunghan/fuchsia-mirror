load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

exports_files(
    [
        "meta/test_manager.bootstrap_shard.cml",
        "meta/test_manager.core_shard.cml",
    ],
    visibility = ["//bundles/assembly:__subpackages__"],
)

rustc_library(
    name = "test_lib",
    testonly = True,
    srcs = ["src/test_lib.rs"],
    crate_name = "test_manager_test_lib",
    crate_root = "src/test_lib.rs",
    edition = "2024",
    visibility = ["//:__subpackages__"],
    deps = [
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.test.manager:fuchsia.test.manager_rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-fs",
        "//src/lib/test_diagnostics/rust:test_diagnostics",
        "//src/sys/lib/moniker",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:linked-hash-map",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

rustc_library(
    name = "lib",
    testonly = True,
    srcs = [
        "src/above_root_capabilities.rs",
        "src/constants.rs",
        "src/debug_agent.rs",
        "src/debug_data_processor.rs",
        "src/debug_data_server.rs",
        "src/diagnostics.rs",
        "src/error.rs",
        "src/facet.rs",
        "src/lib.rs",
        "src/offers.rs",
        "src/resolver.rs",
        "src/run_events.rs",
        "src/running_suite.rs",
        "src/scheduler.rs",
        "src/self_diagnostics.rs",
        "src/test_manager_server.rs",
        "src/test_suite.rs",
        "src/utilities.rs",
    ],
    crate_name = "test_manager_lib",
    edition = "2024",
    proc_macro_deps = ["//third_party/rust_crates/vendor:async-trait"],
    # Only for internal use.
    visibility = ["//src/sys/test_manager/tests:__subpackages__"],
    deps = [
        "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
        "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust",
        "//sdk/fidl/fuchsia.component.resolution:fuchsia.component.resolution_rust",
        "//sdk/fidl/fuchsia.component.test:fuchsia.component.test_rust",
        "//sdk/fidl/fuchsia.data:fuchsia.data_rust",
        "//sdk/fidl/fuchsia.debugdata:fuchsia.debugdata_rust",
        "//sdk/fidl/fuchsia.debugger:fuchsia.debugger_rust",
        "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust",
        "//sdk/fidl/fuchsia.diagnostics.host:fuchsia.diagnostics.host_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.logger:fuchsia.logger_rust",
        "//sdk/fidl/fuchsia.pkg:fuchsia.pkg_rust",
        "//sdk/fidl/fuchsia.test:fuchsia.test_rust",
        "//sdk/fidl/fuchsia.test.manager:fuchsia.test.manager_rust",
        "//sdk/fidl/fuchsia.tracing.provider:fuchsia.tracing.provider_rust",
        "//sdk/rust/zx",
        "//src/lib/async-utils",
        "//src/lib/diagnostics/inspect/rust",
        "//src/lib/diagnostics/log/rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        # In GN, `//src/lib/fuchsia-component-test` is a group that bundles
        # `:fuchsia-component-test-lib` alongside `realm_builder_server_component`.
        "//src/lib/fuchsia-component-test:fuchsia-component-test-lib",  # @bazel2gn:path_overwrite://src/lib/fuchsia-component-test
        "//src/lib/fuchsia-fs",
        "//src/lib/fuchsia-sync",
        "//src/lib/fuchsia-url",
        "//src/lib/test_diagnostics/rust:test_diagnostics",
        "//src/sys/lib/cm_rust",
        "//src/sys/lib/cm_types",
        "//src/sys/lib/mem_util",
        "//src/sys/lib/moniker",
        "//src/sys/test_manager/fidl/fuchsia.test.debug:fuchsia.test.debug_rust",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:glob",
        "//third_party/rust_crates/vendor:itertools",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:tempfile",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

rustc_test(
    name = "lib_test",
    crate = ":lib",
    # Preserves GN `output_name = "test_manager_lib_lib_test"` expected by
    # `meta/test_manager_lib_test.cml`.
    crate_name = "test_manager_lib_lib_test",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        ":test_lib",
        "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:maplit",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

fx_packaged_binary(
    name = "lib_test_packaged_bin",
    testonly = True,
    binary = ":lib_test",
    binary_name = "test_manager_lib_lib_test",
)

fx_component_manifest(
    name = "test-manager-unittests_manifest",
    testonly = True,
    component_name = "test-manager-unittests",
    includes = [
        "//sdk/lib/sys/component:realm_builder.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/test_manager_lib_test.cml",
)

fx_test_component(
    name = "test-manager-unittests_component",
    compiled_manifest = ":test-manager-unittests_manifest",
    deps = [":lib_test_packaged_bin"],
)

fx_package(
    name = "test-manager-unittests_package",
    package_name = "test-manager-unittests",
    components = [
        "//src/lib/fuchsia-component-test/realm_builder_server:realm_builder_server_component",
    ],
    test_components = [":test-manager-unittests_component"],
)

fx_test(
    name = "test-manager-unittests",
    package = ":test-manager-unittests_package",
    visibility = ["//src/sys:__pkg__"],
)

rustc_binary(
    name = "bin",
    testonly = True,
    srcs = ["src/main.rs"],
    binary_name = "test_manager",
    build_flags = ["//build/config/rust:bootfs"],
    edition = "2024",
    tags = ["manual"],
    deps = [
        ":lib",
        "//sdk/fidl/fuchsia.component.resolution:fuchsia.component.resolution_rust",
        "//sdk/fidl/fuchsia.pkg:fuchsia.pkg_rust",
        "//sdk/fidl/fuchsia.process.lifecycle:fuchsia.process.lifecycle_rust",
        "//src/lib/diagnostics/inspect/runtime/rust",
        "//src/lib/diagnostics/inspect/rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-runtime",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:futures-util",
        "//third_party/rust_crates/vendor:log",
    ],
)

rustc_binary(
    name = "fxfs_backed_data_for_tests_bin",
    testonly = True,
    srcs = ["src/fxfs_backed_data.rs"],
    binary_name = "fxfs_backed_data_for_tests",
    crate_root = "src/fxfs_backed_data.rs",
    edition = "2024",
    tags = ["manual"],
    deps = [
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-fs",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
    ],
)

fx_packaged_binary(
    name = "fxfs_backed_data_for_tests_packaged_bin",
    testonly = True,
    binary = ":fxfs_backed_data_for_tests_bin",
    binary_name = "fxfs_backed_data_for_tests",
)

fx_component_manifest(
    name = "fxfs_backed_data_for_tests_manifest",
    testonly = True,
    component_name = "fxfs_backed_data_for_tests",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/fxfs_backed_data_for_tests.cml",
)

fx_component(
    name = "fxfs_backed_data_for_tests_cmp",
    testonly = True,
    compiled_manifest = ":fxfs_backed_data_for_tests_manifest",
    deps = [":fxfs_backed_data_for_tests_packaged_bin"],
)
