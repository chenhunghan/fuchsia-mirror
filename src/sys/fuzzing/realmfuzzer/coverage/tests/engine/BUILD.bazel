load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "engine",
    testonly = True,
    srcs = ["src/main.rs"],
    crate_name = "realmfuzzer_coverage_test_engine",
    edition = "2024",
    # rustc_binary defaults to clippy_warn_production; use the testonly
    # default instead.
    lint_config = "//build/config/rust/lints:clippy_warn_default",
    tags = ["manual"],
    visibility = ["//src/sys/fuzzing/realmfuzzer/coverage/tests:__pkg__"],
    deps = [
        "//sdk/rust/zx",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/sys/fuzzing/fidl:fuchsia.fuzzer_rust",
        "//third_party/rust_crates/vendor:anyhow",
    ],
)
