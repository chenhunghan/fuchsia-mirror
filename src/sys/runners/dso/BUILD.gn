import("//build/components.gni")

# Retained in GN because `:bin` links dual-built
# `//src/storage/lib/vfs/rust:vfs_dylib`.
fuchsia_package("package") {
  package_name = "dso_runner"
  deps = [ ":component" ]
}

group("tests") {
  testonly = true
  deps = [
    ":dso_runner_tests_package",
    "tests",
  ]
}

