          "//third_party/rust_crates:assert_matches",
          "//third_party/rust_crates:test-case",
        ]
    source_root = "src/main.rs"
    output_name = "dso_runner_bin_test"
  }
}

fuchsia_component_manifest("dso_runner_tests_manifest") {
  testonly = true
  component_name = "dso_runner_tests"
