load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":elf_runner_stdout_test"],
    visibility = ["//src/sys:__pkg__"],
)

rustc_test(
    name = "test",
    srcs = ["src/lib.rs"],
    # Matches `program.binary` in meta/stdout.cml.
    crate_name = "elf_runner_stdout",
    edition = "2024",
    tags = ["manual"],
    deps = [
        "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
        "//src/lib/diagnostics/data/rust",
        "//src/lib/diagnostics/reader/rust",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component-test",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

fx_packaged_binary(
    name = "test_packaged_bin",
    testonly = True,
    binary = ":test",
    binary_name = "elf_runner_stdout",
)

fx_component_manifest(
    name = "stdout_integration_test_manifest",
    testonly = True,
    component_name = "stdout_integration_test",
    includes = [
        "//sdk/lib/inspect:offer.shard",
        "//sdk/lib/sys/component:realm_builder.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/stdout.cml",
)

fx_test_component(
    name = "stdout_integration_test",
    compiled_manifest = ":stdout_integration_test_manifest",
    deps = [":test_packaged_bin"],
)

fx_package(
    name = "elf_runner_stdout_test_package",
    package_name = "elf_runner_stdout_test",
    components = [
        "//src/lib/fuchsia-component-test/realm_builder_server:realm_builder_server_component",
        "//src/sys/lib/elf_runner/tests/stdout/cpp:logs-default-cpp",
        "//src/sys/lib/elf_runner/tests/stdout/cpp:logs-stderr-cpp",
        "//src/sys/lib/elf_runner/tests/stdout/cpp:logs-stdout-and-stderr-cpp",
        "//src/sys/lib/elf_runner/tests/stdout/cpp:logs-stdout-cpp",
        "//src/sys/lib/elf_runner/tests/stdout/rust:logs-default-rust",
        "//src/sys/lib/elf_runner/tests/stdout/rust:logs-stderr-rust",
        "//src/sys/lib/elf_runner/tests/stdout/rust:logs-stdout-and-stderr-rust",
        "//src/sys/lib/elf_runner/tests/stdout/rust:logs-stdout-rust",
    ],
    test_components = [":stdout_integration_test"],
)

fx_test(
    name = "elf_runner_stdout_test",
    package = ":elf_runner_stdout_test_package",
)
