load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":elf_runner_tests"],
    visibility = ["//src/sys:__pkg__"],
)

rustc_library(
    name = "elf_runner",
    srcs = [
        "src/component.rs",
        "src/component_set.rs",
        "src/config.rs",
        "src/crash_handler.rs",
        "src/crash_info.rs",
        "src/error.rs",
        "src/lib.rs",
        "src/logger.rs",
        "src/memory/mod.rs",
        "src/memory/reporter.rs",
        "src/process_launcher.rs",
        "src/runtime_dir.rs",
        "src/stdout.rs",
        "src/vdso_vmo.rs",
    ],
    edition = "2024",
    proc_macro_deps = [
        "//third_party/rust_crates/vendor:async-trait",
    ],
    visibility = [
        "//src/sys/component_manager:__pkg__",
        "//src/sys/runners/dso:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
        "//sdk/fidl/fuchsia.component.runner:fuchsia.component.runner_rust",
        "//sdk/fidl/fuchsia.data:fuchsia.data_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.logger:fuchsia.logger_rust",
        "//sdk/fidl/fuchsia.memory.attribution:fuchsia.memory.attribution_rust",
        "//sdk/fidl/fuchsia.process:fuchsia.process_rust",
        "//sdk/fidl/fuchsia.process.lifecycle:fuchsia.process.lifecycle_rust",
        "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust",
        "//sdk/rust/zx",
        "//src/lib/diagnostics/log/rust",
        "//src/lib/error/clonable_error",
        "//src/lib/fdio/rust:fdio",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-runtime",
        "//src/lib/fuchsia-sync",
        "//src/lib/process_builder",
        "//src/lib/trace/rust:trace",
        "//src/memory/attribution/server",
        "//src/storage/lib/pseudo_fs",
        "//src/storage/lib/vfs/rust:vfs",
        "//src/sys/lib/cm_types",
        "//src/sys/lib/fidl-connector",
        "//src/sys/lib/moniker",
        "//src/sys/lib/namespace",
        "//src/sys/lib/routing",
        "//src/sys/lib/runner",
        "//src/sys/lib/socket_parsing",
        "//src/sys/lib/task-exceptions",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:chrono",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

rustc_test(
    name = "elf_runner_test",
    crate = ":elf_runner",
    crate_name = "elf_runner_lib_test",
    edition = "2024",
    tags = ["manual"],
    deps = [
        "//src/lib/fidl/rust/fidl_test_util",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-fs",
        "//src/lib/scoped_task",
        "//src/sys/lib/cm_config",
        "//src/sys/lib/library_loader",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:rand",
        "//third_party/rust_crates/vendor:test-case",
    ],
)

rustc_test(
    name = "elf_runner_next_vdso_tests",
    srcs = [
        "src/logger.rs",
        "src/next_vdso_tests.rs",
    ],
    crate_root = "src/next_vdso_tests.rs",
    edition = "2024",
    tags = ["manual"],
    deps = [
        "//sdk/fidl/fuchsia.component.runner:fuchsia.component.runner_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.logger:fuchsia.logger_rust",
        "//src/lib/diagnostics/fake-log-sink/rust",
        "//src/lib/diagnostics/log/rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//src/sys/lib/cm_types",
        "//src/sys/lib/namespace",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

fx_packaged_binary(
    name = "elf_runner_test_packaged_bin",
    testonly = True,
    binary = ":elf_runner_test",
    binary_name = "elf_runner_lib_test",
)

fx_component_manifest(
    name = "elf_runner_tests_cmp_manifest",
    testonly = True,
    component_name = "elf_runner_tests",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners:tmp_storage.shard.cml",
        "//src/sys/test_runners/elf:create_raw_processes.shard.cml",
    ],
    manifest = "meta/elf_runner_tests.cml",
)

fx_test_component(
    name = "elf_runner_tests_cmp",
    compiled_manifest = ":elf_runner_tests_cmp_manifest",
    test_type = "system",
    deps = [":elf_runner_test_packaged_bin"],
)

fx_packaged_binary(
    name = "elf_runner_next_vdso_tests_packaged_bin",
    testonly = True,
    binary = ":elf_runner_next_vdso_tests",
    binary_name = "elf_runner_next_vdso_tests",
)

fx_component_manifest(
    name = "elf_runner_next_vdso_tests_cmp_manifest",
    testonly = True,
    component_name = "elf_runner_next_vdso_tests",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:next-vdso.shard.cml",
    ],
    manifest = "meta/elf_runner_next_vdso_tests.cml",
)

fx_test_component(
    name = "elf_runner_next_vdso_tests_cmp",
    compiled_manifest = ":elf_runner_next_vdso_tests_cmp_manifest",
    deps = [":elf_runner_next_vdso_tests_packaged_bin"],
)

fx_packaged_binary(
    name = "run_indefinitely_packaged_bin",
    testonly = True,
    binary = "//src/sys/lib/elf_runner/tests/lifecycle:run-indefinitely",
    binary_name = "run-indefinitely",
)

fx_packaged_binary(
    name = "exit_with_code_packaged_bin",
    testonly = True,
    binary = "//src/sys/component_manager/tests/exit_code:exit_with_code",
    binary_name = "exit_with_code",
)

fx_packaged_binary(
    name = "exit_with_code_from_env_packaged_bin",
    testonly = True,
    binary = "//src/sys/component_manager/tests/exit_code:exit_with_code_from_env",
    binary_name = "exit_with_code_from_env",
)

# Needs reviewer attention (bazel2gn skip): test hardcodes fuchsia-pkg://fuchsia.com/elf_runner_tests#meta/hello-world-rust.cm so the elf_runner_tests-gn package name generated by bazel2gn fails at runtime
# @bazel2gn:skip
fx_package(
    name = "elf_runner_tests_package",
    package_name = "elf_runner_tests",
    components = [
        "//examples/hello_world/rust:hello-world-rust-component",
        "//src/sys/component_manager/testing/lifecycle",
        "//src/sys/component_manager/tests/crash_introspect:panic_on_start",
        "//src/sys/lib/elf_runner/tests/lifecycle:immediate_escrow_component",
    ],
    resources = [
        ":exit_with_code_from_env_packaged_bin",
        ":exit_with_code_packaged_bin",
        ":run_indefinitely_packaged_bin",
    ],
    test_components = [
        ":elf_runner_tests_cmp",
        ":elf_runner_next_vdso_tests_cmp",
    ],
)

