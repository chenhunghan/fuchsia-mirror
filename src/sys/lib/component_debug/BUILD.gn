rustc_library("component_debug") {
  sources = _COMMON_SRCS
  if (is_host) {
    features = [ "serde" ]
  } else {
    features = []
  }
  edition = "2024"
  proc_macro_deps = [ "//third_party/rust_crates:async-trait" ]
  assert_no_deps = [
    "//sdk/fidl/fuchsia.component.internal:fuchsia.component.internal_rust",
    "//src/sys/lib/routing",
  ]
  visibility = [
    ":*",
    "//src/connectivity/*",
    "//src/developer/*",
    "//src/diagnostics/*",
    "//src/session/*",
    "//src/storage/*",
    "//src/sys/*",
    "//src/testing/sl4f:*",
  ]
  deps = _COMMON_DEPS + [
           "//sdk/fidl/fuchsia.component:fuchsia.component_rust_flex",
           "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust_flex",
           "//sdk/fidl/fuchsia.dash:fuchsia.dash_rust_flex",
           "//sdk/fidl/fuchsia.data:fuchsia.data_rust_flex",
           "//sdk/fidl/fuchsia.io:fuchsia.io_rust_flex",
