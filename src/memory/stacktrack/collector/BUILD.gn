import("//build/bazel/bazel_fuchsia_package.gni")

# The package is defined as `fx_package` in BUILD.bazel. This GN wrapper
# stays because `//src/memory/stacktrack:stacktrack` and the
# `subpackages` of `//src/memory/stacktrack/example` still
# depend on `:collector` in GN.
bazel_fuchsia_package("collector") {
  bazel_config = "fuchsia_platform"
  package_name = "stacktrack-collector"
}
