import("//build/bazel/bazel_fuchsia_package.gni")
import("//build/components.gni")
import("//build/dist/renamed_binary.gni")

# Kept in BUILD.gn because //bundles/tools depends on
# //src/memory/thrasher and bazel2gn does not translate non-test
# fx_package() or resource().
# (Bridged via bazel_fuchsia_package; thrasher_resources is synced below.)
bazel_fuchsia_package("thrasher") {
  bazel_config = "fuchsia_platform"
}

# GN copy of thrasher_tests, kept above the sentinel because bazel2gn cannot
# translate resource() or test packages with resources.
renamed_binary("thrasher_test_packaged") {
  testonly = true
  source = "$root_out_dir/thrasher_test"
  source_deps = [ ":thrasher_test" ]
  dest = "test/thrasher_test"
}

fuchsia_unittest_package("thrasher_tests") {
  package_name = "thrasher_tests-gn"
  component_name = "thrasher_tests"
  manifest = "meta/thrasher_tests.cml"
  deps = [
    ":thrasher_empty_dir_resource",
    ":thrasher_test_dir_resource",
    ":thrasher_test_packaged",
    ":thrasher_test_resources",
    ":thrasher_unmappable_dir_resource",
    "//src/lib/fuchsia-component-test/realm_builder_server:realm_builder_server_component",
  ]
}

resource("thrasher_test_resources") {
  testonly = true
  sources = [ "test_data" ]
  outputs = [ "data/test_data" ]
}

resource("thrasher_empty_dir_resource") {
  testonly = true
  sources = [ "empty_dir/.placeholder" ]
  outputs = [ "data/empty_dir/.placeholder" ]
}

resource("thrasher_unmappable_dir_resource") {
  testonly = true
  sources = [ "unmappable_dir/empty_file" ]
  outputs = [ "data/unmappable_dir/empty_file" ]
}

resource("thrasher_test_dir_resource") {
  testonly = true
  sources = [ "test_dir/test_data" ]
  outputs = [ "data/test_dir/test_data" ]
}

group("tests") {
  testonly = true
  deps = [ ":thrasher_tests" ]
}

