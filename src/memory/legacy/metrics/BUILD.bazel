load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")

package(default_applicable_licenses = ["//:license"])

fx_cc_library(
    name = "metrics",
    srcs = [
        "bucket_match.cc",
        "capture.cc",
        "capture_strategy.cc",
        "digest.cc",
        "printer.cc",
        "summary.cc",
        "watcher.cc",
    ],
    hdrs = [
        "bucket_match.h",
        "capture.h",
        "capture_strategy.h",
        "digest.h",
        "mas_cache.h",
        "printer.h",
        "summary.h",
        "watcher.h",
    ],
    # TODO(https://fxbug.dev/570694755): capture_strategy.h uses angled
    # workspace-root `#include <src/lib/fxl/macros.h>`, which GN resolves via
    # root `-I.` while Bazel only searches `-iquote .` by default.
    # @bazel2gn:skip
    copts = ["-I."],
    implementation_deps = [
        "//sdk/lib/component/incoming/cpp",
        "//src/lib/fsl",
        "//third_party/rapidjson",
        "//zircon/system/ulib/task-utils",
        "//zircon/system/ulib/trace",
    ],
    visibility = [
        "//src/memory/legacy/metrics/tests:__pkg__",
        "//src/memory/legacy/monitor:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.kernel:fuchsia.kernel_cpp",
        "//sdk/lib/syslog/cpp",
        "//src/lib/fxl",
        "//src/memory/lib/scudo",
        "//third_party/re2",
        "//zircon/system/ulib/ffl",
    ],
    alwayslink = True,
)
