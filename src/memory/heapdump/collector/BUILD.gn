import("//build/components.gni")
import("//build/packages/sdk_fuchsia_package.gni")

# TODO(https://fxbug.dev/570694755): Migrate this package to Bazel once
# its GN consumers are gone. It stays in GN because the assembly reaches it
# through the //bundles/assembly/bazel_inputs bridge, `:collector_sdk`
# below packages it for the IDK, and GN test and example packages in
# //src/memory/tools/dupefinder and //src/memory/heapdump/example
# list it in `subpackages`.
fuchsia_package_with_single_component("collector") {
  package_name = "heapdump-collector"
  manifest = "meta/collector.cml"
  deps = [ ":bin" ]
}

if (current_toolchain == default_toolchain) {
  # TODO(https://fxbug.dev/570694755): Migrate this IDK package to Bazel
  # together with `:collector`. It stays in GN because it wraps the GN
  # `:collector` package above and //sdk/BUILD.gn consumes it.
  sdk_fuchsia_package("collector_sdk") {
    distribution_name = "heapdump-collector"
    package_label = ":collector"
    category = "partner"
    expected_files_exact = [ "meta/heapdump-collector.cm" ]
    api_level_added = 27
  }
}

