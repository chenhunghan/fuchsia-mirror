import("//build/components.gni")

# TODO(https://fxbug.dev/570694755): Migrate `:example` to Bazel once its
# subpackage `//src/memory/heapdump/collector`, CML shard
# `//sdk/lib/heapdump_instrumentation`, and GN consumer
# `//src/developer/ffx/plugins/profile/heapdump:product_bundle` are ready.
fuchsia_package_with_single_component("example") {
  package_name = "heapdump-example"
  manifest = "meta/example.cml"
  deps = [ ":bin" ]
  subpackages = [ "//src/memory/heapdump/collector" ]
}

