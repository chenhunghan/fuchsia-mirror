import("//build/bazel/bazel_fuchsia_package.gni")

# TODO(https://fxbug.dev/570694755): Migrate group("kernel-collector") and
# bazel_fuchsia_package("package") once GN `--with` callers move to Bazel.
group("kernel-collector") {
  testonly = true
  deps = [
    ":package",
    ":tests",
  ]
}

group("tests") {
  testonly = true
  deps = [ "//src/memory:bazel_tests" ]
}

bazel_fuchsia_package("package") {
  bazel_config = "fuchsia_platform"
  package_name = "kernel-collector"
}
