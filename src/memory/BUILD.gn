import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("bazel_tests") {
  host_tests = [ "//src/memory:host_tests" ]
  target_tests = [ "//src/memory:target_tests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    "attribution:tests",
    "heapdump:tests",
    "legacy:tests",
    "lib:tests",
    "pressure_signaler:tests",
    "sampler:tests",
    "stacktrack:tests",
    "tests",
    "thrasher:tests",
    "tools:tests",
  ]
}

group("host_tests") {
  testonly = true
  deps = [ "tools/dupefinder:host_tests($host_toolchain)" ]
}
