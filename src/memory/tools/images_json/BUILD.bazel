load("@rules_python//python:py_library.bzl", "py_library")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_py_test.bzl", "host_py_test")

package(default_applicable_licenses = ["//:license"])

# Note: Host-only target matching platform-only deps via target_compatible_with.
py_library(
    name = "images_json",
    srcs = [
        "__init__.py",
        "images_json.py",
    ],
    imports = [".."],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//src/memory/tools/snapshots:__pkg__"],
    deps = ["//src/memory/tools/dataclasses_json_lite"],
)

host_py_test(
    name = "images_json_test",
    srcs = ["images_json_test.py"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//src/memory/tools:__pkg__"],
    deps = [":images_json"],
)
