load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host:defs.bzl", "rustc_binary_host_tool")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [":lib_test"],
    visibility = ["//src/memory/tools:__pkg__"],
)

# Bridged to GN via `bazel_host_tool("bin")` in `BUILD.gn`.
# @bazel2gn:skip
rustc_binary_host_tool(
    name = "bin",
    srcs = ["src/main.rs"],
    binary_name = "dupefinder",
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        ":lib",
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:camino",
        "//third_party/rust_crates/vendor:chrono",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:serde_json",
    ],
)

# The public API of this library is only exposed for internal testing.
rustc_library(
    name = "lib",
    srcs = ["src/lib.rs"],
    compile_data = ["templates/report.html.hbs"],
    crate_name = "dupefinder",
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//src/memory/tools/dupefinder/tests:__subpackages__"],
    deps = [
        "//src/memory/lib/pprof",
        "//third_party/rust_crates/vendor:flate2",
        "//third_party/rust_crates/vendor:handlebars",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:percent-encoding",
        "//third_party/rust_crates/vendor:prost",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

host_rustc_test(
    name = "lib_test",
    crate = ":lib",
    # Preserves the GN test binary name from `rustc_library(name = "dupefinder", with_unit_tests = true)`.
    crate_name = "dupefinder_lib_test",
)
