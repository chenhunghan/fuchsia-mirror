import("//build/bazel/bazel_host_tool.gni")

if (is_host) {
  bazel_host_tool("bin") {
    bazel_target = ":bin"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/dupefinder"
    output_name = "dupefinder"
    install_host_tool = true
    visibility = [
      ":*",
      "tests/e2e:*",
    ]
  }

  group("dupefinder") {
    public_deps = [ ":bin" ]
  }

  group("host_tests") {
    testonly = true
    deps = [
      ":lib_test",
      "tests:host_tests",
    ]
  }
}

group("tests") {
  testonly = true
  deps = [
    ":lib_test($host_toolchain)",
    "tests:dupefinder_html_goldens($host_toolchain)",
  ]
}

