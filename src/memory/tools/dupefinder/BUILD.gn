import("//build/tools/bazel2gn/bazel_migration.gni")

if (is_host) {
  rustc_library("lib") {
    sources = [ "src/lib.rs" ]
    inputs = [ "templates/report.html.hbs" ]
    crate_name = "dupefinder"
    edition = "2024"
    visibility = [
      ":*",
      "//src/memory/tools/dupefinder/tests/*",
    ]
    deps = [
      "//src/memory/lib/pprof",
      "//third_party/rust_crates:flate2",
      "//third_party/rust_crates:handlebars",
      "//third_party/rust_crates:log",
      "//third_party/rust_crates:percent-encoding",
      "//third_party/rust_crates:prost",
      "//third_party/rust_crates:serde",
      "//third_party/rust_crates:serde_json",
      "//third_party/rust_crates:thiserror",
    ]
  }
}
if (is_host) {
  rustc_test("lib_test") {
    sources = [ "src/lib.rs" ]
    inputs = [ "templates/report.html.hbs" ]
    edition = "2024"
    deps = [
      "//src/memory/lib/pprof",
      "//third_party/rust_crates:flate2",
      "//third_party/rust_crates:handlebars",
      "//third_party/rust_crates:log",
      "//third_party/rust_crates:percent-encoding",
      "//third_party/rust_crates:prost",
      "//third_party/rust_crates:serde",
      "//third_party/rust_crates:serde_json",
      "//third_party/rust_crates:thiserror",
    ]
    output_name = "dupefinder_lib_test"
  }
}
