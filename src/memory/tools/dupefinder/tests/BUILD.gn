import("//build/testing/golden_files.gni")

group("host_tests") {
  testonly = true
  deps = [
    ":dupefinder_html_goldens",
    "e2e:host_tests",
  ]
}

# LINT.IfChange(golden_tests)
_golden_tests = [ "from_e2e_test" ]

# LINT.ThenChange(BUILD.bazel:golden_tests)

_comparisons = []
_goldens_deps = []
foreach(test_name, _golden_tests) {
  _golden_path = "goldens/$test_name.golden.html"
  _candidate_path = "${target_gen_dir}/${test_name}.html"

  _render_label = test_name + ".render"

  _goldens_deps += [ ":${_render_label}" ]

  _comparisons += [
    {
      golden = _golden_path
      candidate = _candidate_path
    },
  ]
}

golden_files("dupefinder_html_goldens") {
  testonly = true
  comparisons = _comparisons
  deps = _goldens_deps
}

