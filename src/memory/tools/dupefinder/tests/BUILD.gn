import("//build/tools/bazel2gn/bazel_migration.gni")

compiled_action("from_e2e_test.render") {
  testonly = true
  sources = [ "goldens/from_e2e_test.json" ]
  outputs = [ "$target_gen_dir/from_e2e_test.html" ]
  args = [
    "--json-dump",
    rebase_path("goldens/from_e2e_test.json", root_build_dir),
    "--html-output",
    rebase_path("$target_gen_dir/from_e2e_test.html", root_build_dir),
  ]
  tool = ":render_html_for_goldens"
}
if (is_host) {
  rustc_binary("render_html_for_goldens") {
    testonly = true
    sources = [ "render_html_for_goldens.rs" ]
    source_root = "render_html_for_goldens.rs"
    edition = "2024"
    deps = [
      "//src/lib/fuchsia",
      "//src/memory/tools/dupefinder:lib",
      "//third_party/rust_crates:argh",
      "//third_party/rust_crates:camino",
      "//third_party/rust_crates:serde_json",
    ]
  }
}
