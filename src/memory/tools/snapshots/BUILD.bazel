load("@rules_python//python:py_library.bzl", "py_library")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_py_test.bzl", "host_py_test")

package(default_applicable_licenses = ["//:license"])

# Note: Host-only target matching platform-only deps via target_compatible_with.
py_library(
    name = "snapshots",
    srcs = [
        "__init__.py",
        "snapshots.py",
    ],
    imports = [".."],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        "//src/memory/tools/debug_json",
        "//src/memory/tools/images_json",
        "//src/memory/tools/multidict",
        "//src/memory/tools/smaps",
    ],
)

host_py_test(
    name = "snapshots_test",
    srcs = ["snapshots_test.py"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//src/memory/tools:__pkg__"],
    deps = [":snapshots"],
)
