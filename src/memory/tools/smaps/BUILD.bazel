load("@rules_python//python:py_library.bzl", "py_library")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_py_test.bzl", "host_py_test")

package(default_applicable_licenses = ["//:license"])

# TODO(https://fxbug.dev/575968075): Fix Pyrefly errors and remove no-pyrefly.
py_library(
    name = "smaps",
    srcs = [
        "__init__.py",
        "smaps.py",
    ],
    imports = [".."],
    tags = ["no-pyrefly"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//src/memory/tools/snapshots:__pkg__"],
)

host_py_test(
    name = "smaps_test",
    srcs = ["smaps_test.py"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//src/memory/tools:__pkg__"],
    deps = [":smaps"],
)
