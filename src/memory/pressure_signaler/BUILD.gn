import("//build/components.gni")

# Kept in GN because `:bin` transitively depends on `rustc_dylib`
# `//src/storage/lib/vfs/rust:vfs_dylib` via `//src/lib/fuchsia-component`.
fuchsia_package("pressure_signaler") {
  package_name = "memory_pressure_signaler"
  deps = [ ":component" ]
}

group("tests") {
  testonly = true
  deps = [ ":memory_pressure_signaler_tests" ]
}

