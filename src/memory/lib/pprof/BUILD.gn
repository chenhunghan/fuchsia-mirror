import("//build/tools/bazel2gn/bazel_migration.gni")

rust_proto_library("pprof_proto") {
  sources = [ "//third_party/perfetto/protos/third_party/pprof/profile.proto" ]
  packages = [ "perfetto.third_party.perftools.profiles" ]
}

rustc_library("pprof") {
  sources = [
    "src/lib.rs",
    "src/module_map.rs",
    "src/string_table.rs",
  ]
  edition = "2024"
  visibility = [
    ":*",
    "//src/developer/ffx/plugins/profile/heapdump:*",
    "//src/developer/ffx/plugins/profile/heapdump/common:*",
    "//src/memory/tools/dupefinder:*",
  ]
  deps = [
    ":pprof_proto",
    "//src/memory/lib/index_table_builder",
    "//third_party/rust_crates:hex",
    "//third_party/rust_crates:thiserror",
  ]
}

rustc_test("pprof_test") {
  sources = [
    "src/lib.rs",
    "src/module_map.rs",
    "src/string_table.rs",
  ]
  edition = "2024"
  deps = [
           ":pprof_proto",
           "//src/memory/lib/index_table_builder",
           "//third_party/rust_crates:hex",
           "//third_party/rust_crates:thiserror",
         ] + [ "//third_party/rust_crates:itertools" ]
}

fuchsia_unittest_package("pprof_tests") {
  package_name = "pprof_tests-gn"
  component_name = "pprof_tests"
  deps = [ ":pprof_test" ]
}
