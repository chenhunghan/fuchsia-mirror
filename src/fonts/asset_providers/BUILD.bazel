load("//build/bazel/rules/components:fx_component.bzl", "fx_component_manifest")
load("//src/fonts/build:fonts.bzl", "font_asset_provider")

package(default_applicable_licenses = ["//:license"])

# LINT.IfChange
# Hermetic asset provider.
fx_component_manifest(
    name = "asset-provider.manifest",
    component_name = "asset-provider",
    manifest = "meta/asset-provider.cml",
    visibility = [
        "//src/fonts:__subpackages__",
        "//vendor/google:__subpackages__",
    ],
)

# Font asset provider definitions.
# Expect to have one for each font collection in //src/fonts/collections.
font_asset_provider(
    name = "open-fonts-collection",
    visibility = ["//products/terminal:__pkg__"],
    deps = ["//src/fonts/collections:open-fonts-collection"],
)

font_asset_provider(
    name = "small-open-fonts-collection",
    visibility = ["//products/core:__pkg__"],
    deps = ["//src/fonts/collections:small-open-fonts-collection"],
)
# LINT.ThenChange(BUILD.gn)
