_COPTS = [
    "-Wno-conversion",
    "-Wno-implicit-fallthrough",
    "-Wno-macro-redefined",
    "-Wno-unused-function",
    "-Wno-unused-variable",
]

_COMMON_DEFINES = [
    "FT2_BUILD_LIBRARY",
    "DARWIN_NO_CARBON",
    # Long directory name to avoid accidentally using wrong headers.
    "FT_CONFIG_MODULES_H=<freetype-fuchsia-config/ftmodule.h>",
    "FT_CONFIG_OPTIONS_H=<freetype-fuchsia-config/ftoption.h>",
]

fx_cc_library(
    name = "_freetype2_headers",
    hdrs = _HDRS,
    includes = ["include"],
    visibility = ["//visibility:private"],
)

fx_cc_library(
    name = "_freetype2_shared_cc",
    srcs = _SRCS,
    hdrs = _HDRS,
    copts = _COPTS,
    defines = _COMMON_DEFINES + [
        "'FT_EXPORT(x)=extern __attribute__(( visibility( \"default\" ) )) x'",
        "'FT_EXPORT_DEF(x)=extern __attribute__(( visibility( \"default\" ) )) x'",
        "'FT_EXPORT_VAR(x)=extern __attribute__(( visibility( \"default\" ) )) x'",
        "FT_CONFIG_OPTION_USE_PNG",
    ],
    includes = ["include"],
    textual_hdrs = _TEXTUAL_HDRS,
    visibility = ["//visibility:private"],
    deps = [
        "@@//third_party/libpng",
        "@zlib",
    ],
    alwayslink = True,
)

fx_cc_binary(
    name = "libfreetype2.so",
    linkshared = True,
    visibility = ["//visibility:private"],
    deps = [":_freetype2_shared_cc"],
)

cc_import(
    name = "freetype2",
    hdrs = _HDRS,
    shared_library = ":libfreetype2.so",
    visibility = ["@//:__subpackages__"],
    deps = [":_freetype2_headers"],
)

# TODO(https://fxbug.dev/42111830): Remove workaround for Rust host_toolchain
fx_cc_library(
    name = "freetype2_for_rust_host",
    srcs = _SRCS,
    hdrs = _HDRS,
    copts = _COPTS + [
        # Without `-fPIC`, we get the error:
        # > ld.lld: error: can't create dynamic relocation R_X86_64_64 against local symbol in readonly
        # > segment
        "-fPIC",
    ],
    defines = _COMMON_DEFINES + [
        # Reduce visibility of symbols.
        "FT_EXPORT(x)=x",
    ],
    includes = ["include"],
    textual_hdrs = _TEXTUAL_HDRS,
    visibility = ["@//:__subpackages__"],
    deps = ["@zlib"],
)
