load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "freetype_ffi",
    srcs = ["src/lib.rs"],
    edition = "2024",
    link_deps = select({
        "@platforms//os:fuchsia": ["@freetype2"],
        # TODO(https://fxbug.dev/42111830): Remove workaround for Rust host_toolchain
        "//conditions:default": ["@freetype2//:freetype2_for_rust_host"],
    }),
    visibility = ["//src/fonts/font_info:__pkg__"],
    deps = ["//third_party/rust_crates/vendor:libc"],
)
