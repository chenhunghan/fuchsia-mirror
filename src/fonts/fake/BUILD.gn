import("//build/bazel/bazel_fuchsia_package.gni")
import("//build/bazel/bazel_test_suite.gni")

group("fake") {
  testonly = true
  deps = [
    ":pkg",
    ":tests",
  ]
}

group("tests") {
  testonly = true
  deps = [ ":bazel_tests" ]
}

# Products add //src/fonts/fake:pkg from GN (see README.md).
bazel_fuchsia_package("pkg") {
  bazel_config = "fuchsia_platform"
  package_name = "fake-fonts"
}

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/fonts/fake:test-pkg_test" ]
}
