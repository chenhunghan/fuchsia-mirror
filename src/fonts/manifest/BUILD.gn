    "//sdk/fidl/fuchsia.fonts:fuchsia.fonts_rust_common",
    "//src/fonts/char_set",
    "//src/fonts/offset_string",
    "//src/lib/error/clonable_error",
    "//src/lib/fuchsia-url",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:itertools",
    "//third_party/rust_crates:serde",
    "//third_party/rust_crates:serde_json",
    "//third_party/rust_crates:thiserror",
    "//third_party/rust_crates:unicase",
  ]
}

rustc_test("manifest_test") {
  sources = [
    "src/lib.rs",
    "src/serde_ext.rs",
    "src/v1_to_v2.rs",
    "src/v2.rs",
  ]
  edition = "2024"
  deps = [
           "//sdk/fidl/fuchsia.fonts:fuchsia.fonts_rust_common",
           "//src/fonts/char_set",
           "//src/fonts/offset_string",
           "//src/lib/error/clonable_error",
           "//src/lib/fuchsia-url",
           "//third_party/rust_crates:anyhow",
           "//third_party/rust_crates:itertools",
           "//third_party/rust_crates:serde",
           "//third_party/rust_crates:serde_json",
           "//third_party/rust_crates:thiserror",
           "//third_party/rust_crates:unicase",
         ] + [ "//third_party/rust_crates:assert_matches" ]
}

fuchsia_unittest_package("manifest_tests") {
  package_name = "manifest_tests-gn"
  component_name = "manifest_tests"
  deps = [ ":manifest_test" ]
}
