import("//build/components.gni")
import("//build/dist/resource.gni")
import("//build/testing/host_test_data.gni")

# bazel2gn does not translate resource() or fx_unittest_package(resources =
# ...), so the GN copy of the test package is kept above the sentinel.
resource("testdata") {
  testonly = true
  sources = [ "//src/fonts/test_data/SampleFont-Regular.ttf" ]
  outputs = [ "data/{{source_file_part}}" ]
}

fuchsia_unittest_package("font_info_tests") {
  package_name = "font_info_tests-gn"
  component_name = "font_info_tests"
  deps = [
    ":font_info_test_bin",
    ":testdata",
  ]
}

if (is_host) {
  host_test_data("test_data") {
    sources = [ "//src/fonts/test_data/SampleFont-Regular.ttf" ]
    outputs = [ "$root_out_dir/test_data/font_info/{{source_file_part}}" ]
  }
}

group("tests") {
  testonly = true

  deps = [
    ":font_info_test_bin($host_toolchain)",
    ":font_info_tests",
  ]
}

