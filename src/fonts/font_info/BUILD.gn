import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("font_info") {
  sources = [
    "src/lib.rs",
    "src/sources.rs",
    "src/vmo_stream.rs",
  ]
  edition = "2024"
  visibility = [
    ":*",
    "//src/fonts:*",
    "//src/fonts/tools/manifest_generator:*",
  ]
  deps = []
  deps += [
    "//src/fonts/char_set",
    "//src/fonts/freetype_ffi",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:byteorder",
  ]
  if (is_fuchsia) {
    deps += [
      "//sdk/fidl/fuchsia.mem:fuchsia.mem_rust",
      "//sdk/rust/zx",
      "//third_party/rust_crates:libc",
    ]
  }
}

rustc_test("font_info_test_bin") {
  sources = [ "tests/tests.rs" ]
  output_name = "font_info_test"
  source_root = "tests/tests.rs"
  edition = "2024"
  deps = [
    ":font_info",
    "//src/fonts/char_set",
    "//third_party/rust_crates:anyhow",
  ]
  if (is_host) {
    data_deps = [ ":test_data" ]
  }
}
