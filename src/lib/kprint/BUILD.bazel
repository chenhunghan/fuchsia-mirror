load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "wrap_host_rust_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":kprint-test"],
    visibility = ["//src/lib:__pkg__"],
)

test_suite(
    name = "host_tests",
    tests = [":kprint_host_test"],
    visibility = ["//src/lib:__pkg__"],
)

rustc_library(
    name = "kprint",
    srcs = [
        "src/backend.rs",
        "src/lib.rs",
    ],
    edition = "2024",
    proc_macro_deps = ["//src/lib/kprint/macro:kprint-macro"],
    visibility = [
        "//src/lib/ksync:__pkg__",
        "//zircon:__subpackages__",
    ],
)

# Needs reviewer attention (bazel2gn skip): Keeping the dual-built GN
# fuchsia_unittest_package wired alongside bazel_test_suite fails core.x64-asan
# testsharder ("some shard names are repeated: affected:AEMU") when
# use_test_pilot = true sets os = "linux" on the GN test;
# TODO(https://fxbug.dev/570694755).
# @bazel2gn:skip
rustc_test(
    name = "kprint_test",
    crate = ":kprint",
)

wrap_host_rust_test(
    name = "kprint_host_test",
    binary_name = "kprint_test",
)

# Needs reviewer attention (bazel2gn skip): Keeping the dual-built GN
# fuchsia_unittest_package wired alongside bazel_test_suite fails core.x64-asan
# testsharder ("some shard names are repeated: affected:AEMU") when
# use_test_pilot = true sets os = "linux" on the GN test;
# TODO(https://fxbug.dev/570694755).
# @bazel2gn:skip
fx_unittest_package(
    name = "kprint-test",
    environments = ["//build/testing/environments:emu_env"],
    unit_tests = [":kprint_test"],
)
