import("//build/tools/bazel2gn/bazel_migration.gni")

handle_test_sources = [
  "src/channel.rs",
  "src/lib.rs",
  "src/socket.rs",
]

# To avoid "Assignment had no effect" from GN.
# It's possible this variable is only used in if conditions (e.g. is_host).
not_needed([ "handle_test_sources" ])

handle_test_deps = [
  "//src/lib/fidl/rust/fidl",
  "//third_party/rust_crates:futures",
]

# To avoid "Assignment had no effect" from GN.
# It's possible this variable is only used in if conditions (e.g. is_host).
not_needed([ "handle_test_deps" ])

rustc_test("fidl_rust_handle_tests_bin") {
  sources = handle_test_sources
  output_name = "fidl_rust_handle_tests"
  edition = "2024"
  proc_macro_deps = [ "//third_party/rust_crates:async-trait" ]
  deps = handle_test_deps + [ "//src/lib/fuchsia-async" ]
}

fuchsia_unittest_package("fidl_rust_handle_tests") {
  package_name = "fidl_rust_handle_tests-gn"
  component_name = "fidl_rust_handle_tests"
  deps = [ ":fidl_rust_handle_tests_bin" ]
  visibility = [
    ":*",
    "//src/lib:*",
  ]
}

rustc_library("fidl_handle_tests") {
  sources = handle_test_sources
  crate_name = "fidl_handle_tests"
  edition = "2024"
  proc_macro_deps = [ "//third_party/rust_crates:async-trait" ]
  visibility = [
    ":*",
    "//src/connectivity/overnet/tests/fidl:*",
  ]
  deps = handle_test_deps
}
