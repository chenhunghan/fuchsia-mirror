import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/lib/fidl/rust:fidl_rust_conformance_tests" ]
  host_tests = [ "//src/lib/fidl/rust:fidl_rust_conformance_tests_host" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    "fidl:tests",
    "fidl-contrib:tests",
    "fidl_test_util:tests",
    "fidl_test_util:tests($host_toolchain)",
  ]
}
