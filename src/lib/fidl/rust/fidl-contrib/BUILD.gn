    "//src/sys/time/httpsdate_time_source:*",
    "//src/sys/time/timekeeper:*",
  ]
  deps = [
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia-async",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
}
if (is_fuchsia) {
  rustc_test("fidl-contrib_test") {
    sources = [
      "src/lib.rs",
      "src/protocol_connector.rs",
    ]
    edition = "2024"
    deps = [
             "//sdk/rust/zx",
             "//src/lib/fidl/rust/fidl",
             "//src/lib/fuchsia-async",
             "//third_party/rust_crates:futures",
             "//third_party/rust_crates:log",
           ] +
           [
             "//sdk/testing/fidl/protocols_tests:test.protocol.connector_rust",
             "//src/lib/fuchsia",
             "//src/lib/fuchsia-component",
             "//src/lib/fuchsia-component-test",
             "//third_party/rust_crates:anyhow",
           ]
    deps += [ "//src/lib/fuchsia-component-test:includes" ]
    output_name = "fidl_contrib_lib_test"
  }
}

fuchsia_unittest_component("fidl_contrib_rust_lib_tests_component") {
  deps = [ ":fidl-contrib_test" ]
  component_name = "fidl_contrib_rust_lib_tests"
}

fuchsia_test_package("fidl_contrib_rust_lib_tests_package") {
  package_name = "fidl_contrib_rust_lib_tests-gn"
  test_components = [ ":fidl_contrib_rust_lib_tests_component" ]
  deps = [ "//src/lib/fuchsia-component-test/realm_builder_server:realm_builder_server_component" ]
