import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("bazel_tests") {
  target_tests = [
    "//src/lib/fidl/rust_next/conformance:fidl_rust_next_conformance_tests",
  ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    "fidl_next:tests",
    "fidl_next_bind:tests",
    "fidl_next_codec:tests",
    "fidl_next_protocol:tests",
    "fidl_next_util:tests",
  ]
}
