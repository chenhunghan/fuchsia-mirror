load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "wrap_host_rust_test")
load("//build/bazel/rules/rust:defs.bzl", "rustc_library")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")
load("//build/rust:fidl_rust_next.bzl", "fidl_rust_next_allowlist")

package(default_applicable_licenses = ["//:license"])

# LINT.IfChange
rustc_library(
    name = "fidl_next_protocol_internal",
    srcs = [
        "src/endpoints/client.rs",
        "src/endpoints/connection.rs",
        "src/endpoints/lockers.rs",
        "src/endpoints/mod.rs",
        "src/endpoints/server.rs",
        "src/error.rs",
        "src/flexibility.rs",
        "src/flexible.rs",
        "src/framework_error.rs",
        "src/lib.rs",
        "src/message.rs",
        "src/mpsc.rs",
        "src/service.rs",
        "src/strict.rs",
        "src/testing.rs",
        "src/transport.rs",
        "src/wire/empty.rs",
        "src/wire/epitaph.rs",
        "src/wire/flexible.rs",
        "src/wire/message_header.rs",
        "src/wire/mod.rs",
        "src/wire/strict.rs",
    ] + select({
        "@platforms//os:fuchsia": [
            "src/fuchsia/channel.rs",
            "src/fuchsia/mod.rs",
        ],
        "//conditions:default": [],
    }),
    crate_features = select({
        "@platforms//os:fuchsia": [
            "fuchsia",
        ],
        "//conditions:default": [],
    }),
    crate_name = "fidl_next_protocol",
    edition = "2024",
    test_deps = [
        "//third_party/rust_crates/vendor:futures",
    ] + select({
        "@platforms//os:fuchsia": [],
        "//conditions:default": [
            "//src/lib/fuchsia-async",
        ],
    }),
    visibility = [
        "//sdk/lib/driver/component/rust:__subpackages__",
        "//src/lib/fdomain/client:__subpackages__",
        "//src/lib/fidl/rust_next:__subpackages__",
    ],
    with_unit_tests = True,
    deps = [
        "//sdk/lib/fuchsia-loom",
        "//src/lib/fidl/rust_constants",
        "//src/lib/fidl/rust_next/fidl_next_codec",
        "//third_party/rust_crates/vendor:pin-project",
        "//third_party/rust_crates/vendor:thiserror",
        "//third_party/rust_crates/vendor:zerocopy",
    ] + select(
        {
            "@platforms//os:fuchsia": [
                "//sdk/rust/zx",
                "//src/lib/fuchsia-async",
            ],
            "//conditions:default": [],
        },
    ),
)
# LINT.ThenChange(BUILD.gn)

alias(
    name = "fidl_next_protocol",
    actual = ":fidl_next_protocol_internal",
    visibility = fidl_rust_next_allowlist,
)

wrap_host_rust_test(
    name = "fidl_next_protocol_host_test",
    binary_name = "fidl_next_protocol_internal_test",
)

fx_unittest_package(
    name = "fidl_next_protocol_test_package",
    unit_tests = [":fidl_next_protocol_internal_test"],
)
