load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":fidl_cpp_fpromise_tests"],
    visibility = ["//src/lib:__pkg__"],
)

fx_cc_test_binary(
    name = "fidl_cpp_fpromise_tests_bin",
    srcs = ["client_test.cc"],
    deps = [
        "//sdk/lib/async:async-cpp",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/fit-promise",
        "//sdk/testing/fidl/protocols_tests:test.basic.protocol_cpp",
        "//sdk/testing/fidl/protocols_tests:test.error.methods_cpp",
        "//src/lib/fidl/contrib/fpromise",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_package(
    name = "fidl_cpp_fpromise_tests",
    unit_tests = [":fidl_cpp_fpromise_tests_bin"],
    visibility = ["//src/lib:__pkg__"],
)
