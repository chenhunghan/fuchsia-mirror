import("//build/tools/bazel2gn/bazel_migration.gni")

regio_sources = [
  "src/arm64/mod.rs",
  "src/arm64/spec.rs",
  "src/lib.rs",
  "src/mmio.rs",
  "src/riscv64/encoding.rs",
  "src/riscv64/mod.rs",
  "src/testing/mod.rs",
  "src/testing/x86.rs",
  "src/traits.rs",
  "src/x86/cpuid.rs",
  "src/x86/cr.rs",
  "src/x86/mod.rs",
  "src/x86/msr.rs",
  "src/x86/pio.rs",
]

# To avoid "Assignment had no effect" from GN.
# It's possible this variable is only used in if conditions (e.g. is_host).
not_needed([ "regio_sources" ])

rustc_library("regio") {
  sources = regio_sources
  edition = "2024"
  visibility = [
    ":*",
    "//zircon/kernel/*",
  ]
  deps = [ "//zircon/system/ulib/mmio-ptr:mmio-ptr-rs" ]
}

rustc_library("regio-testing") {
  testonly = true
  sources = regio_sources
  features = [ "testing" ]
  crate_name = "regio"
  edition = "2024"
  visibility = [
    ":*",
    "//zircon/kernel/lib/arch:*",
  ]
  deps = [ "//zircon/system/ulib/mmio-ptr:mmio-ptr-rs" ]
}

rustc_test("regio_test") {
  sources = regio_sources
  edition = "2024"
  deps = [ "//zircon/system/ulib/mmio-ptr:mmio-ptr-rs" ]
}

fuchsia_unittest_package("regio-tests") {
  package_name = "regio-tests-gn"
  component_name = "regio-tests"
  deps = [ ":regio_test" ]
}
