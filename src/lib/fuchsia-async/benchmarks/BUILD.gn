import("//build/components.gni")
import("//build/testing/perf/test.gni")

group("benchmarks") {
  deps = [ ":fuchsia_async_benchmarks" ]
  testonly = true
}

fuchsia_component("fuchsia_async_benchmarks_component") {
  testonly = true
  component_name = "fuchsia_async_benchmarks"
  manifest = "meta/fuchsia_async_benchmarks.cml"
  deps = [ ":bin" ]
}

fuchsia_test_package("fuchsia_async_benchmarks_pkg") {
  package_name = "fuchsia_async_benchmarks"
  test_components = [ ":fuchsia_async_benchmarks_component" ]
}

fuchsia_component_perf_test("fuchsia_async_benchmarks") {
  package = ":fuchsia_async_benchmarks_pkg"
  package_name = "fuchsia_async_benchmarks"
  component_name = "fuchsia_async_benchmarks"
  expected_metric_names_filepath =
      "//src/tests/end_to_end/perf/expected_metric_names/fuchsia.async.txt"
}

