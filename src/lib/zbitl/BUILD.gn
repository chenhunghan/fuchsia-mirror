if (zircon_toolchain == false) {
  headers_dep = ""
} else {
  headers_dep = ":headers"
}

# LINT.IfChange(zbitl)
static_library("zbitl") {
  # GN visibility remains unrestricted while unmigrated GN and kernel callers
  # exist; Bazel visibility is narrowed to migrated callers.
  # Includes //src/sys/early_boot_instrumentation.
  public_deps = [ ":headers" ]
  sources = [
    "checking.cc",
    "cpu-topology.cc",
    "debugdata.cc",
    "efi.cc",
    "item.cc",
  ]
  deps = [
    ":headers",
    ":internal.decompress-zstd",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/zx",
    "//zircon/third_party/ulib/cksum",
  ]

  if (is_kernel) {
    # The zbitl headers use various ktl-approved standard C++ headers.
    deps += [
      "//zircon/kernel/lib/ktl",
      "//zircon/kernel/lib/libc",
    ]
    public_deps += [ "//zircon/kernel/lib/ktl:headers" ]
  } else {
    sources += [
      "fd.cc",
      "stdio.cc",
    ]

    if (is_fuchsia) {
      sources += [
        "mapvmo.cc",
        "vmo-read.cc",
        "vmo.cc",
      ]
      deps += [
        "//zircon/system/ulib/zircon-internal",
        "//zircon/system/ulib/zx",
      ]
      public_deps += [
        # <lib/zbitl/vmo.h> has #include <lib/zx/vmo.h>.
        "//zircon/system/ulib/zx$headers_dep",
      ]
    }
  }
}

# LINT.ThenChange(BUILD.bazel:zbitl)

# LINT.IfChange(internal_decompress_zstd)
source_set("internal.decompress-zstd") {
  sources = [
    "zstd-streaming.cc",
    "zstd.cc",
  ]
  defines = [ "ZSTD_STATIC_LINKING_ONLY" ]
  deps = [
    ":headers",
    "//third_party/zstd:zstd-decompress-standalone",
  ]
  public_deps = [
    # Sources include <lib/zbitl/decompress.h>
    ":headers.decompress",

    # zstd-streaming.cc includes <zircon/assert.h>
    "//sdk/lib/zircon-assert",
  ]
  include_dirs = [ "include" ]

  if (is_kernel) {
    deps += [
      "//zircon/kernel/lib/ktl",
      "//zircon/kernel/lib/libc",
    ]
  } else {
    sources += [ "default-allocator.cc" ]
  }
}

# LINT.ThenChange(BUILD.bazel:internal_decompress_zstd)

group("tests") {
  testonly = true
  deps = [ "tests" ]
}

