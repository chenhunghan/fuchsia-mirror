executable("elf-search-test-helper") {
  sources = [ "helper.cc" ]
  if (is_fuchsia) {
    configs -= [ "//build/config/fuchsia:fdio_config" ]
  } else {
    configs -= []
  }
  visibility = [ ":*" ]
