import("//build/tools/bazel2gn/bazel_migration.gni")

library_headers("headers") {
  public = [
    "include/lib/lazy_init/internal/assert.h",
    "include/lib/lazy_init/internal/storage.h",
    "include/lib/lazy_init/lazy_init.h",
    "include/lib/lazy_init/options.h",
  ]
  visibility = [
    ":*",
    "//src/devices/board/drivers/x86:*",
    "//src/zircon/testing/standalone-test:*",
    "//zircon/kernel/arch/riscv64:*",
    "//zircon/kernel/kernel:*",
    "//zircon/kernel/lib/*",
    "//zircon/kernel/platform:*",
    "//zircon/kernel/tests:*",
    "//zircon/kernel/vm:*",
  ]
}

group("lazy_init") {
  public_deps = [ ":headers" ]
  visibility = [
    ":*",
    "//src/devices/board/drivers/x86:*",
    "//src/zircon/testing/standalone-test:*",
    "//zircon/kernel/arch/riscv64:*",
    "//zircon/kernel/kernel:*",
    "//zircon/kernel/lib/*",
    "//zircon/kernel/platform:*",
    "//zircon/kernel/tests:*",
    "//zircon/kernel/vm:*",
  ]
}

rustc_library("lazy_init_rs") {
  sources = [
    "src/check.rs",
    "src/lib.rs",
  ]
  crate_name = "lazy_init"
  edition = "2024"
  visibility = [
    ":*",
    "//zircon/kernel/*",
  ]
  deps = [ "//third_party/rust_crates:pin-init" ]
}
if (is_host) {
  rustc_test("lazy_init_rs_test") {
    sources = [
      "src/check.rs",
      "src/lib.rs",
    ]
    edition = "2024"
    deps = [ "//third_party/rust_crates:pin-init" ]
  }
}

cc_test_executable("lazy-init-test") {
  sources = [ "lazy_init_tests.cc" ]
  configs += [ "//build/config/fuchsia:static_cpp_standard_library" ]
  deps = []
  deps += [
    ":lazy_init",
    "//zircon/system/ulib/zxtest",
  ]
  if (is_fuchsia) {
    deps += [
      "//sdk/lib/fdio",
      "//zircon/system/ulib/zx",
    ]
  }
  testonly = true
  emit_tool_path = false
  if (is_fuchsia) {
    fdio_config = [ "//build/config/fuchsia:fdio_config" ]
    if (configs + fdio_config - fdio_config != configs) {
      configs -= fdio_config
    }
  }
}

fuchsia_unittest_package("lazy-init-test-pkg") {
  package_name = "lazy-init-test-gn"
  component_name = "lazy-init-test"
  deps = [ ":lazy-init-test" ]
}
