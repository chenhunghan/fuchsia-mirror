load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/cc:fx_cc_library_headers.bzl", "fx_cc_library_headers")
load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":lazy-init-test-pkg"],
    visibility = ["//src/lib:__pkg__"],
)

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [":lazy_init_rs_test"],
    visibility = ["//src/lib:__pkg__"],
)

fx_cc_library_headers(
    name = "headers",
    hdrs = [
        "include/lib/lazy_init/internal/assert.h",
        "include/lib/lazy_init/internal/storage.h",
        "include/lib/lazy_init/lazy_init.h",
        "include/lib/lazy_init/options.h",
    ],
    visibility = [
        "//src/devices/board/drivers/x86:__pkg__",
        "//src/zircon/testing/standalone-test:__pkg__",
        "//zircon/kernel/arch/riscv64:__pkg__",
        "//zircon/kernel/kernel:__pkg__",
        "//zircon/kernel/lib:__subpackages__",
        "//zircon/kernel/platform:__pkg__",
        "//zircon/kernel/tests:__pkg__",
        "//zircon/kernel/vm:__pkg__",
    ],
)

alias(
    name = "lazy_init",
    actual = ":headers",
    visibility = [
        "//src/devices/board/drivers/x86:__pkg__",
        "//src/zircon/testing/standalone-test:__pkg__",
        "//zircon/kernel/arch/riscv64:__pkg__",
        "//zircon/kernel/kernel:__pkg__",
        "//zircon/kernel/lib:__subpackages__",
        "//zircon/kernel/platform:__pkg__",
        "//zircon/kernel/tests:__pkg__",
        "//zircon/kernel/vm:__pkg__",
    ],
)

rustc_library(
    name = "lazy_init_rs",
    srcs = [
        "src/check.rs",
        "src/lib.rs",
    ],
    crate_name = "lazy_init",
    edition = "2024",
    visibility = ["//zircon/kernel:__subpackages__"],
    deps = ["//third_party/rust_crates/vendor:pin-init"],
)

host_rustc_test(
    name = "lazy_init_rs_test",
    crate = ":lazy_init_rs",
)

# TODO(https://fxbug.dev/570694755): Guard fdio_config removal in GN so kernel
# toolchains (where is_fuchsia is true but fdio_config is absent) do not fail.
# @bazel2gn:raw_attribute:if (is_fuchsia) { fdio_config = [ "//build/config/fuchsia:fdio_config" ] if (configs + fdio_config - fdio_config != configs) { configs -= fdio_config } }
fx_cc_test_binary(
    name = "lazy-init-test",
    # These tests won't run on the host because some of these tests make
    # use of the ASSERT_DEATH macro to ensure that certain actions result
    # in program termination, which is not currently supported in the
    # host test environment.
    # See: TODO(https://fxbug.dev/42105920)
    srcs = ["lazy_init_tests.cc"],
    build_flags = ["//build/config/fuchsia:static_cpp_standard_library"],
    # TODO(https://fxbug.dev/570694755): Emitted with a presence check via
    # raw_attribute above because kernel toolchains do not include fdio_config.
    # @bazel2gn:skip
    disable_build_flags = ["//build/config/fuchsia:fdio_config"],
    # TODO(https://fxbug.dev/570694755): Restrict to Fuchsia in Bazel while
    # keeping the GN target unguarded as in the original BUILD.gn.
    # @bazel2gn:skip
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        ":lazy_init",
        "//zircon/system/ulib/zxtest",
    ] + select({
        "@platforms//os:fuchsia": [
            "//sdk/lib/fdio",
            "//zircon/system/ulib/zx",
        ],
        "//conditions:default": [],
    }),
)

fx_unittest_package(
    name = "lazy-init-test-pkg",
    package_name = "lazy-init-test",
    unit_tests = [":lazy-init-test"],
)
