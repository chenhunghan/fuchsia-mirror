import("//build/tools/bazel2gn/bazel_migration.gni")

source_set("uuid") {
  sources = [ "uuid.cc" ]
  public = [ "uuid.h" ]
  visibility = [
    ":*",
    "//sdk/lib/syslog/cpp:*",
    "//src/bringup/*",
    "//src/developer/*",
    "//src/firmware/*",
    "//src/lib/analytics/cpp/core_dev_tools:*",
    "//src/storage/*",
    "//src/zircon/*",
    "//vendor/google/*",
  ]
  public_deps = [ "//src/lib/fxl:string_printf" ]
}

cc_test_executable("uuid_unittests") {
  sources = [ "uuid_unittest.cc" ]
  deps = [
    ":uuid",
    "//src/lib/fxl/test:gtest_main",
    "//third_party/googletest:gtest",
    "//third_party/re2",
  ]
  testonly = true
  emit_tool_path = false
}

fuchsia_unittest_package("uuid_tests") {
  package_name = "uuid_tests-gn"
  component_name = "uuid_tests"
  deps = [ ":uuid_unittests" ]
}
