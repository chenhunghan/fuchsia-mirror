import("//build/testing/host_test.gni")

if (is_host) {
  host_test("uuid_unittests_host_test") {
    binary_path = "$root_out_dir/uuid_unittests"
    target = get_label_info(":uuid_unittests", "label_with_toolchain")
    deps = [ ":uuid_unittests" ]
  }
}

group("tests") {
  testonly = true

  deps = [
    ":uuid_tests",
    ":uuid_unittests_host_test($host_toolchain)",
  ]
}

