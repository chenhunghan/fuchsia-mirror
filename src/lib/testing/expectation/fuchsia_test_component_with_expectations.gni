import("//build/components.gni")
import("//src/lib/testing/expectation/preprocess/preprocess.gni")

# LINT.IfChange

# Declares a test expectations JSON5 file target.
#
# Parameters
#   expectations (required)
#     Path to a JSON5 test expectations file.
#     Type: path
template("fuchsia_expectations") {
  assert(
      defined(invoker.expectations),
      "Must define `expectations` when calling fuchsia_expectations($target_name).")
  assert(!defined(invoker.testonly) || invoker.testonly,
         "`fuchsia_expectations` targets are always testonly.")

  generated_file(target_name) {
    forward_variables_from(invoker, [ "visibility" ])
    testonly = true
    outputs = [ "${target_gen_dir}/${target_name}.json5" ]
    output_conversion = "json"
    contents = {
      actions = [
        {
          include = get_path_info(invoker.expectations, "abspath")
        },
      ]
    }
  }
}

# Compiles a Fuchsia test component manifest with the expectations offer shard.
#
# Parameters
#   manifest (required)
#     The component manifest (.cml) file to compile.
#     Type: path
#
#   component_name (optional)
#     The name of the component. Defaults to `target_name`.
#     Type: string
#
#   All other parameters match `fuchsia_component_manifest`.
template("fuchsia_component_manifest_with_expectations") {
  assert(
      !defined(invoker.testonly) || invoker.testonly,
      "`fuchsia_component_manifest_with_expectations` targets are always testonly.")
  assert(defined(invoker.manifest), "Must define path to manifest file.")

  _component_name = target_name
  if (defined(invoker.component_name)) {
    _component_name = invoker.component_name
  }

  _offer_shard_target = "${target_name}_expectations_offer_shard"
  _offer_shard_file =
      "${target_gen_dir}/${target_name}_expectations_offer.shard.cml"

  generated_file(_offer_shard_target) {
    testonly = true
    contents = {
      offer = [
        {
          directory = "pkg"
          from = "framework"
          as = "expectations"
          to = "#expectation-comparer"
          subdir = "data/tests/expectations/${_component_name}"
        },
      ]
    }
    outputs = [ _offer_shard_file ]
    output_conversion = "json"
    visibility = [ ":*" ]
  }

  _merged_cml_target = "${target_name}_expectations_cml"

  cmc_merge(_merged_cml_target) {
    testonly = true
    deps = [ ":${_offer_shard_target}" ]
    if (defined(invoker.deps)) {
      deps += invoker.deps
    }
    sources = [
      _offer_shard_file,
      invoker.manifest,
    ]
    output_name = "${target_name}_merged.cml"
    visibility = [ ":*" ]
  }
  _merged_outputs = get_target_outputs(":${_merged_cml_target}")

  fuchsia_component_manifest(target_name) {
    forward_variables_from(invoker,
                           "*",
                           [
                             "component_name",
                             "deps",
                             "manifest",
                             "target_name",
                             "testonly",
                           ])
    testonly = true
    component_name = _component_name
    manifest = _merged_outputs[0]
    deps = [ ":${_merged_cml_target}" ]
    if (defined(invoker.deps)) {
      deps += invoker.deps
    }
  }
}

# Defines a fuchsia_test_component with an expectations file for this test.
#
# Parameters
#  expectations (optional)
#    Path to a JSON5 test expectations file, or label of a
#    `fuchsia_expectations` or `generated_expectations_file` target. See
#    //src/lib/testing/expectation/example_expectations.json5 for an example of
#    the format. Either expectations or generated_expectations is required.
#    Type: path or label
#
#  generated_expectations (optional)
#    Name of the generated_expectations_file target that generates expectation
#    file. Note that this duplicates `expectations` semantics, but is kept
#    around to facilitate migration to Bazel even though it is redundant.
#    Either expectations or generated_expectations is required.
#    Type: target name
#
#  manifest (must specify either manifest or cm_label)
#    The component manifest.
#    Type: path
#
#  cm_label (must specify either manifest or cm_label)
#    Label of a `fuchsia_component_manifest_with_expectations` target.
#    Type: label
#
#  treatment_of_cases_with_error_logs (optional)
#     Identifies how test cases that are expected to generate error logs should be run. Since most
#     failed tests fail by panicking on a failed assertion, which generates error logs, this is
#     useful for segregating expected-to-fail tests from expected-to-pass tests by marking the
#     former as "expect_failure_with_err_log" and placing them in a separate test package that
#     allows error logs without failing the whole suite.
#     Type: string
#     Options:
#       - "SKIP_CASES_WITH_ERROR_LOGS" indicates that tests expected to
#         generate error logs should be skipped.
#       - "RUN_ONLY_CASES_WITH_ERROR_LOGS" indicates that only those tests
#         expected to generate error logs should be run.
#       - By default, all test cases will be run.
#
#  All others - same as fuchsia_test_component.
template("fuchsia_test_component_with_expectations") {
  assert(
      !defined(invoker.testonly) || invoker.testonly,
      "`fuchsia_test_component_with_expectations` targets are always testonly.")
  assert(
      !defined(invoker.check_includes) || invoker.check_includes,
      "`check_includes` cannot be disabled on `fuchsia_test_component_with_expectations`.")

  _manifest_defined = defined(invoker.manifest)
  _cm_label_defined = defined(invoker.cm_label)
  assert(
      (_manifest_defined && !_cm_label_defined) ||
          (!_manifest_defined && _cm_label_defined),
      "Exactly one of `manifest` or `cm_label` must be specified when calling fuchsia_test_component_with_expectations($target_name).")

  if (_manifest_defined) {
    _test_component_name = target_name
    if (defined(invoker.component_name)) {
      _test_component_name = invoker.component_name
    }
    _cm_target = "${target_name}_manifest_compile"

    fuchsia_component_manifest_with_expectations(_cm_target) {
      forward_variables_from(invoker,
                             "*",
                             [
                               "check_includes",
                               "check_references",
                               "cm_label",
                               "component_name",
                               "data_deps",
                               "expectations",
                               "generated_expectations",
                               "manifest_deps",
                               "metadata",
                               "public_deps",
                               "target_name",
                               "test_type",
                               "testonly",
                               "treatment_of_cases_with_error_logs",
                               "visibility",
                             ])
      component_name = _test_component_name
      if (defined(invoker.manifest_deps)) {
        if (!defined(deps)) {
          deps = []
        }
        deps += invoker.manifest_deps
      }
      visibility = [ ":*" ]
    }
    _cm_label = ":${_cm_target}"
  } else {
    assert(
        !defined(invoker.component_name) &&
            !defined(invoker.restricted_features) &&
            !defined(invoker.experimental_force_runner) &&
            !defined(invoker.required_offers) &&
            !defined(invoker.required_uses),
        "Manifest attributes (`component_name`, `restricted_features`, etc.) must be set on `fuchsia_component_manifest_with_expectations` when `cm_label` is used.")
    _cm_label = invoker.cm_label
    if (current_toolchain == default_toolchain) {
      _manifest_outputs = get_target_outputs(_cm_label)
      _test_component_name = get_path_info(_manifest_outputs[0], "name")
    } else {
      _test_component_name = target_name
    }
  }

  _skip_err_logs_cases = "SKIP_CASES_WITH_ERROR_LOGS"
  _run_err_logs_cases = "RUN_ONLY_CASES_WITH_ERROR_LOGS"
  not_needed([
               _skip_err_logs_cases,
               _run_err_logs_cases,
             ])

  _expectations_deps = []

  # `generated_expectations` duplicates `expectations` semantics, but is kept
  # around to facilitate migration to Bazel even though it is redundant.
  if (defined(invoker.generated_expectations)) {
    assert(!defined(invoker.expectations),
           "Cannot define both `expectations` and `generated_expectations`.")
    _exp_label = invoker.generated_expectations
    _expectations_deps = [ _exp_label ]
    _expectations_file = get_label_info(_exp_label, "target_gen_dir") + "/" +
                         get_label_info(_exp_label, "name") + ".json5"
  } else {
    assert(defined(invoker.expectations),
           "Must define path or label for `expectations`.")
    if (get_path_info(invoker.expectations, "extension") == "json5" &&
        string_replace(invoker.expectations, ":", "") == invoker.expectations) {
      _expectations_file = invoker.expectations
    } else {
      _exp_label = invoker.expectations
      _expectations_deps = [ _exp_label ]
      _expectations_file = get_label_info(_exp_label, "target_gen_dir") + "/" +
                           get_label_info(_exp_label, "name") + ".json5"
    }
  }

  _expectations_target = "${target_name}_preprocessed_expectations"

  preprocess_expectations(_expectations_target) {
    testonly = true
    expectations = _expectations_file
    if (_expectations_deps != []) {
      deps = _expectations_deps
    }
    if (defined(invoker.treatment_of_cases_with_error_logs)) {
      assert(
          invoker.treatment_of_cases_with_error_logs == _skip_err_logs_cases ||
          invoker.treatment_of_cases_with_error_logs == _run_err_logs_cases)
      if (invoker.treatment_of_cases_with_error_logs == _skip_err_logs_cases) {
        cases_to_run = "NoErrLogs"
      } else {
        cases_to_run = "WithErrLogs"
      }
    }
    output_path =
        "data/tests/expectations/${_test_component_name}/expectations.json5"
  }

  fuchsia_test_component(target_name) {
    forward_variables_from(invoker,
                           "*",
                           [
                             "check_includes",
                             "cm_label",
                             "component_name",
                             "deps",
                             "expectations",
                             "experimental_force_runner",
                             "generated_expectations",
                             "manifest",
                             "required_offers",
                             "required_uses",
                             "restricted_features",
                             "target_name",
                             "testonly",
                             "treatment_of_cases_with_error_logs",
                           ])

    cm_label = _cm_label
    deps = [
      ":${_expectations_target}",
      "//src/lib/testing/expectation:expectation_comparer",
      "//src/lib/testing/expectation:expected_includes_common",
    ]

    if (defined(invoker.deps)) {
      deps += invoker.deps
    }
  }
}
# LINT.ThenChange(
#   //src/lib/testing/expectation/rules/fx_expectations.bzl,
#   //src/lib/testing/expectation/rules/fx_test_component_with_expectations.bzl
# )
