import("//build/bazel/bazel_host_tool.gni")
import("//build/bazel/bazel_test_suite.gni")

if (is_host) {
  bazel_host_tool("list_test_expectations") {
    bazel_target = "//src/lib/testing/expectation/tool:list_test_expectations"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/list_test_expectations"
    install_host_tool = true
  }
}

bazel_test_suite("bazel_tests") {
  host_tests = [ "//src/lib/testing/expectation/tool:bin_test" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":bin_test($host_toolchain)",
    ":list_test_expectations($host_toolchain)",
  ]
}

