load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":ddk-unittest-package"],
    visibility = ["//src/lib:__pkg__"],
)

fx_cc_test_binary(
    name = "ddk-unittest",
    srcs = ["binding-test.cc"],
    deps = [
        "//sdk/lib/fdio",
        "//src/lib/ddk",

        # TODO(https://fxbug.dev/42113849): Migrate to the new bind rules and delete the below
        "//src/lib/ddk:ddk-deprecated-binding-headers",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_package(
    name = "ddk-unittest-package",
    package_name = "ddk-unittest",
    unit_tests = [":ddk-unittest"],
)
