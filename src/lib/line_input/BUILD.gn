import("//build/tools/bazel2gn/bazel_migration.gni")

static_library("line_input") {
  sources = [
    "line_input.cc",
    "modal_line_input.cc",
  ]
  public = [
    "line_input.h",
    "modal_line_input.h",
  ]
  visibility = [
    ":*",
    "//src/connectivity/network/mdns/util:*",
    "//src/developer/debug/zxdb/console:*",
    "//vendor/google/*",
  ]
  public_deps = [
    "//sdk/lib/fit",
    "//sdk/lib/syslog/cpp",
    "//src/lib/fxl",
  ]
}
if (is_host) {
  executable("line_input_example") {
    sources = [ "line_input_example.cc" ]
    deps = [ ":line_input" ]
  }
}

cc_test_executable("line_input_tests_bin") {
  sources = [
    "line_input_unittest.cc",
    "modal_line_input_unittest.cc",
    "test_line_input.h",
  ]
  deps = [
    ":line_input",
    "//src/lib/fxl/test:gtest_main",
    "//third_party/googletest:gtest",
  ]
  testonly = true
  emit_tool_path = false
}

fuchsia_unittest_package("line_input_tests") {
  package_name = "line_input_tests-gn"
  component_name = "line_input_tests"
  deps = [ ":line_input_tests_bin" ]
}
