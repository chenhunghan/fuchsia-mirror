import("//build/testing/host_test.gni")

# TODO(https://fxbug.dev/570694755): bazel2gn does not translate host_test() yet.
if (is_host) {
  host_test("line_input_tests_host_test") {
    binary_path = "$root_out_dir/line_input_tests_bin"
    target = get_label_info(":line_input_tests_bin", "label_with_toolchain")
    deps = [ ":line_input_tests_bin" ]
  }
}

group("tests") {
  testonly = true

  deps = [
    ":line_input_example($host_toolchain)",
    ":line_input_tests",
    ":line_input_tests_host_test($host_toolchain)",
  ]
}

