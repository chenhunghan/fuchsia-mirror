load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/host_tests:host_test.bzl", "host_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":line_input_tests"],
    visibility = ["//src/lib:__pkg__"],
)

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [":line_input_tests_host_test"],
    visibility = ["//src/lib:__pkg__"],
)

fx_cc_library(
    name = "line_input",
    srcs = [
        "line_input.cc",
        "modal_line_input.cc",
    ],
    hdrs = [
        "line_input.h",
        "modal_line_input.h",
    ],
    visibility = [
        "//src/connectivity/network/mdns/util:__pkg__",
        "//src/developer/debug/zxdb/console:__pkg__",
        "//vendor/google:__subpackages__",
    ],
    deps = [
        "//sdk/lib/fit",
        "//sdk/lib/syslog/cpp",
        "//src/lib/fxl",
    ],
)

# Currently compiled for the host only, but could be packaged for the target
# if desired.
fx_cc_binary(
    name = "line_input_example",
    srcs = ["line_input_example.cc"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [":line_input"],
)

fx_cc_test_binary(
    name = "line_input_tests_bin",
    srcs = [
        "line_input_unittest.cc",
        "modal_line_input_unittest.cc",
        "test_line_input.h",
    ],
    deps = [
        ":line_input",
        "//src/lib/fxl/test:gtest_main",
        "@com_google_googletest//:gtest",
    ],
)

fx_unittest_package(
    name = "line_input_tests",
    unit_tests = [":line_input_tests_bin"],
)

host_test(
    name = "line_input_tests_host_test",
    binary = ":line_input_tests_bin",
    target_compatible_with = HOST_OS_CONSTRAINTS,
)
