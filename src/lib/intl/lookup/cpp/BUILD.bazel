load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/icu:icu_source_set.bzl", "icu_source_set")

package(default_applicable_licenses = ["//:license"])

icu_source_set(
    name = "lib",
    srcs = [
        "lookup.cc",
        "lookup.h",
    ],
    icu_public_deps = ["//src/lib/intl/lookup/rust:lib_headers"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//sdk/lib/fit-promise",
        "//third_party/googletest:gtest_prod",
    ],
)

fx_cc_test_binary(
    name = "intl_lookup_cpp_unittests",
    srcs = ["lookup_test.cc"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":lib",
        "//sdk/lib/fit-promise",
        "//src/lib/fxl/test:gtest_main",
        "//src/lib/testing/loop_fixture",
    ],
)
