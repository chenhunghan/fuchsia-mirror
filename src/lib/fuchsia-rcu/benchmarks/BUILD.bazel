load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_check_cfg_build_flags.bzl", "rustc_check_cfg_build_flags")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":fuchsia_rcu_benchmarks_test"],
    visibility = ["//src/lib:__pkg__"],
)

rustc_check_cfg_build_flags(
    name = "check_cfg_flags",
    cfgs = ['rcu_backend, values("rseq", "atomic")'],
)

rustc_binary(
    name = "bin_rseq",
    testonly = True,
    srcs = ["src/main.rs"],
    build_flags = [
        ":check_cfg_flags",
        "//build/config/rust/lints:deny_unused_results",
    ],
    crate_name = "fuchsia_rcu_benchmarks_rseq",
    edition = "2024",
    rustc_flags = ["--cfg=rcu_backend=\"rseq\""],
    deps = [
        "//src/developer/fuchsia-criterion",
        "//src/lib/fuchsia-rcu",
    ],
)

rustc_binary(
    name = "bin_atomic",
    testonly = True,
    srcs = ["src/main.rs"],
    build_flags = [
        ":check_cfg_flags",
        "//build/config/rust/lints:deny_unused_results",
    ],
    crate_name = "fuchsia_rcu_benchmarks_atomic",
    edition = "2024",
    rustc_flags = ["--cfg=rcu_backend=\"atomic\""],
    deps = [
        "//src/developer/fuchsia-criterion",
        "//src/lib/fuchsia-rcu:fuchsia-rcu-atomic",
    ],
)

fx_packaged_binary(
    name = "bin_rseq_packaged_bin",
    testonly = True,
    binary = ":bin_rseq",
    binary_name = "fuchsia_rcu_benchmarks_rseq",
)

fx_component_manifest(
    name = "rcu_rseq_benchmarks_manifest",
    testonly = True,
    component_name = "rcu_rseq_benchmarks",
    includes = [
        "//sdk/lib/sys/testing:elf_test_runner.shard.cml",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/rcu_rseq_benchmarks.cml",
)

fx_test_component(
    name = "rcu_rseq_benchmarks_component",
    compiled_manifest = ":rcu_rseq_benchmarks_manifest",
    deps = [":bin_rseq_packaged_bin"],
)

fx_packaged_binary(
    name = "bin_atomic_packaged_bin",
    testonly = True,
    binary = ":bin_atomic",
    binary_name = "fuchsia_rcu_benchmarks_atomic",
)

fx_component_manifest(
    name = "rcu_atomic_benchmarks_manifest",
    testonly = True,
    component_name = "rcu_atomic_benchmarks",
    includes = [
        "//sdk/lib/sys/testing:elf_test_runner.shard.cml",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/rcu_atomic_benchmarks.cml",
)

fx_test_component(
    name = "rcu_atomic_benchmarks_component",
    compiled_manifest = ":rcu_atomic_benchmarks_manifest",
    deps = [":bin_atomic_packaged_bin"],
)

fx_package(
    name = "fuchsia_rcu_benchmarks_pkg",
    package_name = "fuchsia_rcu_benchmarks",
    test_components = [
        ":rcu_atomic_benchmarks_component",
        ":rcu_rseq_benchmarks_component",
    ],
)

fx_test(
    name = "fuchsia_rcu_benchmarks_test",
    # FuchsiaCriterion requires a JSON output path argument supplied by the
    # host-driven fuchsia_component_perf_test wrapper; running without args fails.
    build_only = True,
    package = ":fuchsia_rcu_benchmarks_pkg",
)
