load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_proc_macro.bzl", "rustc_proc_macro")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [
        ":fuchsia-rcu-atomic-tests-pkg",
        ":fuchsia-rcu-tests",
    ],
    visibility = ["//src/lib:__pkg__"],
)

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [":fuchsia-rcu-traits_test"],
    visibility = ["//src/lib:__pkg__"],
)

_COMMON_SRCS = [
    "src/atomic_stack.rs",
    "src/lib.rs",
    "src/rcu_arc.rs",
    "src/rcu_box.rs",
    "src/rcu_callback.rs",
    "src/rcu_droppable.rs",
    "src/rcu_droppable_arc.rs",
    "src/rcu_option_arc.rs",
    "src/rcu_option_box.rs",
    "src/rcu_ptr.rs",
    "src/rcu_read_scope.rs",
    "src/rcu_weak.rs",
    "src/read_counters.rs",
    "src/state_machine.rs",
]

rustc_proc_macro(
    name = "fuchsia-rcu-derive",
    srcs = ["macro/src/lib.rs"],
    crate_root = "macro/src/lib.rs",
    edition = "2024",
    # GN's rustc_macro() transitions to $host_toolchain internally.
    # @bazel2gn:skip
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        "//third_party/rust_crates/vendor:proc-macro2",
        "//third_party/rust_crates/vendor:quote",
        "//third_party/rust_crates/vendor:syn",
    ],
)

rustc_library(
    name = "fuchsia-rcu-traits",
    srcs = ["traits/src/lib.rs"],
    crate_features = ["std"],
    crate_root = "traits/src/lib.rs",
    edition = "2024",
    proc_macro_deps = [
        ":fuchsia-rcu-derive",
    ],
    version = "0.1.0",
    visibility = [
        "//src/lib/fuchsia-sync:__pkg__",
        "//src/lib/trace/rust:__pkg__",
        "//src/starnix/lib/starnix_types:__pkg__",
    ],
    deps = [
        "//third_party/rust_crates/vendor:bstr",
        "//third_party/rust_crates/vendor:lock_api",
    ] + select({
        "@platforms//os:fuchsia": ["//sdk/rust/zx"],
        "//conditions:default": [],
    }),
)

host_rustc_test(
    name = "fuchsia-rcu-traits_test",
    crate = ":fuchsia-rcu-traits",
    crate_features = ["std"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
)

# Uses Fuchsia-only zx::Futex and fuchsia_sync::Completion APIs.
rustc_library(
    name = "fuchsia-rcu",
    srcs = _COMMON_SRCS,
    crate_features = ["rseq_backend"],
    edition = "2024",
    target_compatible_with = ["@platforms//os:fuchsia"],
    version = "0.1.0",
    visibility = [
        ":__subpackages__",
        "//examples/rcu:__pkg__",
        "//src/lib/fuchsia-rcu-collections:__pkg__",
        "//src/starnix:__subpackages__",
    ],
    deps = [
        ":fuchsia-rcu-traits",
        "//sdk/rust/zx",
        "//src/lib/fuchsia-rseq",
        "//src/lib/fuchsia-sync",
    ],
)

rustc_test(
    name = "fuchsia-rcu_test",
    crate = ":fuchsia-rcu",
    crate_features = ["rseq_backend"],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
)

# bazel2gn does not yet support `parallel` on `fx_unittest_package()`, so the GN
# copy is defined by hand above the sentinel in BUILD.gn while GN callers remain.
# @bazel2gn:skip
fx_unittest_package(
    name = "fuchsia-rcu-tests",
    # The state machine tests spawn multiple threads and make assertion about
    # shared global state, so we can't run multiple tests in parallel.
    parallel = 1,
    unit_tests = [":fuchsia-rcu_test"],
)

# Uses Fuchsia-only zx::Futex and fuchsia_sync::Completion APIs.
rustc_library(
    name = "fuchsia-rcu-atomic",
    testonly = True,
    srcs = _COMMON_SRCS,
    crate_name = "fuchsia_rcu",
    edition = "2024",
    target_compatible_with = ["@platforms//os:fuchsia"],
    version = "0.1.0",
    visibility = [":__subpackages__"],
    deps = [
        ":fuchsia-rcu-traits",
        "//sdk/rust/zx",
        "//src/lib/fuchsia-sync",
    ],
)

rustc_test(
    name = "fuchsia-rcu-atomic-tests",
    crate = ":fuchsia-rcu-atomic",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    version = "0.1.0",
)

# bazel2gn does not yet support `parallel` on `fx_unittest_package()`, so the GN
# copy is defined by hand above the sentinel in BUILD.gn while GN callers remain.
# @bazel2gn:skip
fx_unittest_package(
    name = "fuchsia-rcu-atomic-tests-pkg",
    package_name = "fuchsia-rcu-atomic-tests",
    # The state machine tests spawn multiple threads and make assertion about
    # shared global state, so we can't run multiple tests in parallel.
    parallel = 1,
    unit_tests = [":fuchsia-rcu-atomic-tests"],
)
