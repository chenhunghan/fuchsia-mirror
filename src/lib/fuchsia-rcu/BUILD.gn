import("//build/components.gni")

group("tests") {
  testonly = true
  deps = [
    ":fuchsia-rcu-atomic-tests-pkg",
    ":fuchsia-rcu-tests",
    ":fuchsia-rcu-traits_test($host_toolchain)",
  ]
}

group("benchmarks") {
  testonly = true
  deps = [ "benchmarks" ]
}

# bazel2gn does not yet support `parallel` on `fx_unittest_package()`, so the GN
# copies are defined by hand here while GN callers remain.
fuchsia_unittest_package("fuchsia-rcu-tests") {
  package_name = "fuchsia-rcu-tests-gn"
  component_name = "fuchsia-rcu-tests"
  deps = [ ":fuchsia-rcu_test" ]

  # The state machine tests spawn multiple threads and make assertion about
  # shared global state, so we can't run multiple tests in parallel.
  test_specs = {
    parallel = 1
  }
}

fuchsia_unittest_package("fuchsia-rcu-atomic-tests-pkg") {
  package_name = "fuchsia-rcu-atomic-tests-gn"
  component_name = "fuchsia-rcu-atomic-tests"
  deps = [ ":fuchsia-rcu-atomic-tests" ]

  # The state machine tests spawn multiple threads and make assertion about
  # shared global state, so we can't run multiple tests in parallel.
  test_specs = {
    parallel = 1
  }
}

