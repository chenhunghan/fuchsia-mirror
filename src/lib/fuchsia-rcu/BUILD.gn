import("//build/tools/bazel2gn/bazel_migration.gni")

_COMMON_SRCS = [
  "src/atomic_stack.rs",
  "src/lib.rs",
  "src/rcu_arc.rs",
  "src/rcu_box.rs",
  "src/rcu_callback.rs",
  "src/rcu_droppable.rs",
  "src/rcu_droppable_arc.rs",
  "src/rcu_option_arc.rs",
  "src/rcu_option_box.rs",
  "src/rcu_ptr.rs",
  "src/rcu_read_scope.rs",
  "src/rcu_weak.rs",
  "src/read_counters.rs",
  "src/state_machine.rs",
]

# To avoid "Assignment had no effect" from GN.
# It's possible this variable is only used in if conditions (e.g. is_host).
not_needed([ "_COMMON_SRCS" ])

rustc_macro("fuchsia-rcu-derive") {
  sources = [ "macro/src/lib.rs" ]
  source_root = "macro/src/lib.rs"
  edition = "2024"
  deps = [
    "//third_party/rust_crates:proc-macro2",
    "//third_party/rust_crates:quote",
    "//third_party/rust_crates:syn",
  ]
}

rustc_library("fuchsia-rcu-traits") {
  sources = [ "traits/src/lib.rs" ]
  features = [ "std" ]
  source_root = "traits/src/lib.rs"
  edition = "2024"
  proc_macro_deps = [ ":fuchsia-rcu-derive" ]
  version = "0.1.0"
  visibility = [
    ":*",
    "//src/lib/fuchsia-sync:*",
    "//src/lib/trace/rust:*",
    "//src/starnix/lib/starnix_types:*",
  ]
  deps = []
  deps += [
    "//third_party/rust_crates:bstr",
    "//third_party/rust_crates:lock_api",
  ]
  if (is_fuchsia) {
    deps += [ "//sdk/rust/zx" ]
  }
}
if (is_host) {
  rustc_test("fuchsia-rcu-traits_test") {
    sources = [ "traits/src/lib.rs" ]
    source_root = "traits/src/lib.rs"
    edition = "2024"
    proc_macro_deps = [ ":fuchsia-rcu-derive" ]
    deps = []
    deps += [
      "//third_party/rust_crates:bstr",
      "//third_party/rust_crates:lock_api",
    ]
    if (is_fuchsia) {
      deps += [ "//sdk/rust/zx" ]
    }
    features = [ "std" ]
  }
}
if (is_fuchsia) {
  rustc_library("fuchsia-rcu") {
    sources = _COMMON_SRCS
    features = [ "rseq_backend" ]
    edition = "2024"
    version = "0.1.0"
    visibility = [
      "./*",
      "//examples/rcu:*",
      "//src/lib/fuchsia-rcu-collections:*",
      "//src/starnix/*",
    ]
    deps = [
      ":fuchsia-rcu-traits",
      "//sdk/rust/zx",
      "//src/lib/fuchsia-rseq",
      "//src/lib/fuchsia-sync",
    ]
  }
}
if (is_fuchsia) {
  rustc_test("fuchsia-rcu_test") {
    sources = _COMMON_SRCS
    edition = "2024"
    deps = [
      ":fuchsia-rcu-traits",
      "//sdk/rust/zx",
      "//src/lib/fuchsia-rseq",
      "//src/lib/fuchsia-sync",
    ]
    features = [ "rseq_backend" ]
  }
}
if (is_fuchsia) {
  rustc_library("fuchsia-rcu-atomic") {
    testonly = true
    sources = _COMMON_SRCS
    crate_name = "fuchsia_rcu"
    edition = "2024"
    version = "0.1.0"
    visibility = [ "./*" ]
    deps = [
      ":fuchsia-rcu-traits",
      "//sdk/rust/zx",
      "//src/lib/fuchsia-sync",
    ]
  }
}
if (is_fuchsia) {
  rustc_test("fuchsia-rcu-atomic-tests") {
    sources = _COMMON_SRCS
    edition = "2024"
    deps = [
      ":fuchsia-rcu-traits",
      "//sdk/rust/zx",
      "//src/lib/fuchsia-sync",
    ]
    version = "0.1.0"
  }
}
