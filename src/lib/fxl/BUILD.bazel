load("@rules_cc//cc:defs.bzl", "cc_library")
load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/components:fx_component.bzl", "fx_component_manifest", "fx_test_component")
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(
    default_applicable_licenses = ["//:license"],
)

test_suite(
    name = "tests",
    tests = [":fxl_tests"],
    visibility = ["//src/lib:__pkg__"],
)

cc_library(
    name = "common",
    hdrs = [
        "build_config.h",
        "fxl_export.h",
        "macros.h",
    ],
    visibility = [
        ":__pkg__",
        "//src/lib/files:__pkg__",
        "//src/lib/fsl/handles:__pkg__",
        "//src/lib/fsl/io:__pkg__",
        "//src/lib/fsl/socket:__pkg__",
        "//src/lib/fsl/tasks:__pkg__",
    ],
    alwayslink = True,
)

cc_library(
    name = "memory",
    srcs = [
        "memory/weak_ptr_internal.cc",
    ],
    hdrs = [
        "memory/ref_counted.h",
        "memory/ref_counted_internal.h",
        "memory/ref_ptr.h",
        "memory/ref_ptr_internal.h",
        "memory/unique_object.h",
        "memory/weak_ptr.h",
        "memory/weak_ptr_internal.h",
    ],
    visibility = [
        ":__pkg__",
        "//src/lib/files:__pkg__",
        "//src/lib/fsl/io:__pkg__",
        "//src/lib/fsl/vmo:__pkg__",
    ],
    deps = [
        ":common",
        "//sdk/lib/zircon-assert",
    ],
    alwayslink = True,
)

cc_library(
    name = "functional",
    hdrs = [
        "functional/apply.h",
        "functional/cancelable_callback.h",
    ],
    visibility = [":__pkg__"],
    deps = [
        ":common",
        ":memory",
    ],
    alwayslink = True,
)

cc_library(
    name = "third_party",
    srcs = [
        "third_party/icu/icu_utf.cc",
    ],
    hdrs = [
        "third_party/icu/icu_utf.h",
    ],
    # GN: configs += [ "//build/config:Wno-implicit-fallthrough" ]
    copts = ["-Wno-implicit-fallthrough"],
    visibility = [":__pkg__"],  # GN: :strings
    alwayslink = True,
)

cc_library(
    name = "string_printf",
    srcs = [
        "strings/string_printf.cc",
    ],
    hdrs = [
        "strings/string_printf.h",
    ],
    visibility = [
        ":__pkg__",
        "//src/lib/files:__pkg__",
        "//src/lib/uuid:__pkg__",
    ],
    deps = [":common"],
    alwayslink = True,
)

cc_library(
    name = "strings",
    srcs = [
        "strings/ascii.cc",
        "strings/concatenate.cc",
        "strings/split_string.cc",
        "strings/string_number_conversions.cc",
        "strings/substitute.cc",
        "strings/trim.cc",
        "strings/utf_codecs.cc",
    ],
    hdrs = [
        "strings/ascii.h",
        "strings/concatenate.h",
        "strings/join_strings.h",
        "strings/split_string.h",
        "strings/string_number_conversions.h",
        "strings/substitute.h",
        "strings/trim.h",
        "strings/utf_codecs.h",
    ],
    visibility = [
        ":__pkg__",
        "//src/lib/files:__pkg__",
        "//src/lib/uuid:__pkg__",
    ],
    deps = [
        ":common",
        ":string_printf",
        ":third_party",
    ],
    alwayslink = True,
)

fx_cc_library(
    name = "fxl",
    hdrs = [
        "observer_list.h",
        "synchronization/thread_annotations.h",
    ],
    visibility = [
        "//:__subpackages__",
        "//vendor/google:__subpackages__",
    ],
    deps = [
        ":common",
        ":functional",
        ":memory",
        ":strings",
        "//sdk/lib/fit",
        "//src/lib/files",
    ],
    alwayslink = True,
)

# Transitional target for things depending on the CLI
# parts of fxl. Eventually CLI-specific functionality
# will be removed from the main "fxl" target, and moved to this one.
fx_cc_library(
    name = "cli",
    srcs = [
        "log_settings_command_line.cc",
    ],
    hdrs = [
        "log_settings_command_line.h",
    ],
    visibility = [
        "//:__subpackages__",
        "//vendor/google:__subpackages__",
    ],
    deps = [
        ":cli_no_logging",
        "//sdk/lib/syslog/cpp",
    ],
    alwayslink = True,
)

# Command-line parsing, but without the syslog depenency.
cc_library(
    name = "cli_no_logging",
    srcs = [
        "command_line.cc",
    ],
    hdrs = [
        "command_line.h",
        "observer_list.h",
    ],
    deps = [":fxl"],
    alwayslink = True,
)

alias(
    name = "fxl_cli",
    actual = ":cli",
    visibility = [
        "//:__subpackages__",
        "//vendor/google:__subpackages__",
    ],
)

fx_cc_test_binary(
    name = "fxl_unittests",
    srcs = [
        "command_line_unittest.cc",
        "functional/apply_unittest.cc",
        "functional/cancelable_callback_unittest.cc",
        "log_settings_command_line_unittest.cc",
        "memory/ref_counted_unittest.cc",
        "memory/weak_ptr_unittest.cc",
        "observer_list_unittest.cc",
        "strings/ascii_unittest.cc",
        "strings/concatenate_unittest.cc",
        "strings/join_strings_unittest.cc",
        "strings/split_string_unittest.cc",
        "strings/string_number_conversions_unittest.cc",
        "strings/string_printf_unittest.cc",
        "strings/substitute_unittest.cc",
        "strings/trim_unittest.cc",
        "synchronization/thread_annotations_unittest.cc",
        "//src/lib/fxl/test:test_settings_unittest.cc",
    ],
    deps = [
        ":fxl",
        "//sdk/lib/syslog/cpp",
        "//src/lib/files",
        "//src/lib/fxl/test:gtest_main",
        "//src/lib/fxl/test:test_settings",
        "@com_google_googletest//:gtest",
    ],
)

fx_packaged_binary(
    name = "fxl_unittests_packaged_bin",
    testonly = True,
    binary = ":fxl_unittests",
    binary_name = "fxl_unittests",
)

fx_component_manifest(
    name = "fxl_tests_manifest",
    testonly = True,
    component_name = "fxl_tests",
    includes = [
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners:tmp_storage.shard.cml",
        "//src/sys/test_runners/gtest:default.shard.cml",
    ],
    manifest = "meta/fxl_unittests.cml",
)

fx_test_component(
    name = "fxl_tests_component",
    compiled_manifest = ":fxl_tests_manifest",
    deps = [
        ":fxl_unittests_packaged_bin",
    ],
)

fx_package(
    name = "fxl_tests_package",
    package_name = "fxl_tests",
    test_components = [
        ":fxl_tests_component",
    ],
)

fx_test(
    name = "fxl_tests",
    max_log_severity = "FATAL",
    package = ":fxl_tests_package",
)
