import("//build/tools/bazel2gn/bazel_migration.gni")

if (is_host) {
  python_library("lib") {
    sources = [
      "pydap/__init__.py",
      "pydap/client.py",
      "pydap/dap_types.py",
      "pydap/models.py",
    ]
    imports = [ "." ]
    visibility = [
      ":*",
      "//scripts/debug/zxdb_cli/daemon:*",
      "//scripts/debug/zxdb_cli/shared:*",
      "//src/developer/debug/e2e_tests/dap_integration_tests:*",
      "//src/lib/debug/dap/python/zxdb:*",
    ]
    deps = [ "//third_party/pylibs/pydantic" ]
    enable_mypy = false
  }
}
