import("//build/tools/bazel2gn/bazel_migration.gni")

static_library("utf_conversion") {
  sources = [ "utf_conversion.cc" ]
  public = [ "utf_conversion.h" ]
  deps = [ "//sdk/lib/stdcompat" ]
  visibility = [
    ":*",
    "//src/devices/usb/drivers/usb-bus:*",
    "//src/firmware/gigaboot/cpp:*",
    "//src/storage/gpt:*",
    "//zircon/kernel/lib/efi/string:*",
  ]
  public_deps = []
  if (is_kernel) {
    deps += [
      "//zircon/kernel/lib/ktl",
      "//zircon/kernel/lib/libc",
    ]
  }
}

cc_test_executable("utf_conversion_test") {
  sources = [ "utf_conversion_test.cc" ]
  deps = []
  deps += [
    ":utf_conversion",
    "//sdk/lib/stdcompat",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/zxtest",
  ]
  if (is_fuchsia) {
    deps += [ "//sdk/lib/fdio" ]
  }
  testonly = true
  emit_tool_path = false
}

fuchsia_unittest_package("utf_conversion_test_pkg") {
  package_name = "utf_conversion_test-gn"
  component_name = "utf_conversion_test"
  deps = [ ":utf_conversion_test" ]
}
