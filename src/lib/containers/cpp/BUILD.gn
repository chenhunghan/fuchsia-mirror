source_set("cpp") {
  public = [
    "circular_deque.h",
    "mpsc_queue.h",
    "ownership.h",
    "template_util.h",
    "vector_buffer.h",
  ]
  configs += [ "//build/config:Wno-conversion" ]
  visibility = [ "//*" ]
  public_deps = [ "//zircon/third_party/ulib/safemath" ]
}

cc_test_executable("containers_cpp_unittests") {
  sources = [
    "circular_deque_unittest.cc",
    "mpsc_queue_unittest.cc",
    "test_objects.h",
    "vector_buffer_unittest.cc",
  ]
  configs += [ "//build/config:Wno-conversion" ]
  deps = [
    ":cpp",
    "//src/lib/fxl/test:gtest_main",
    "//third_party/googletest:gtest",
  ]
  testonly = true
  emit_tool_path = false
}

fuchsia_unittest_package("containers_cpp_tests") {
  package_name = "containers_cpp_tests-gn"
  component_name = "containers_cpp_tests"
  deps = [ ":containers_cpp_unittests" ]
}
