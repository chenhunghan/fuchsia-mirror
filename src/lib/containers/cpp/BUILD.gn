import("//build/testing/host_test.gni")

group("tests") {
  testonly = true

  deps = [
    ":containers_cpp_host_unittests($host_toolchain)",
    ":containers_cpp_tests",
  ]
}

# TODO(https://fxbug.dev/570694755): bazel2gn does not translate host_test() yet.
if (is_host) {
  host_test("containers_cpp_host_unittests") {
    binary_path = "$root_out_dir/containers_cpp_unittests"
    target = get_label_info(":containers_cpp_unittests", "label_with_toolchain")
    deps = [ ":containers_cpp_unittests" ]
  }
}

