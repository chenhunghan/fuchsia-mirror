import("//build/bazel/bazel_fuchsia_package.gni")

bazel_fuchsia_package("rust_trace_events_benchmarks") {
  bazel_config = "fuchsia_platform"
}

group("bench") {
  testonly = true
  deps = [ ":rust_trace_events_benchmarks" ]
}

