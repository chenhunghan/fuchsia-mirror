import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_binary("trace_events_bin") {
  sources = [ "src/trace_events.rs" ]
  output_name = "trace_event_benchmarks"
  source_root = "src/trace_events.rs"
  edition = "2024"
  deps = [
    "//src/developer/fuchsia-criterion",
    "//src/lib/cstringify",
    "//src/lib/trace/rust:trace",
    "//src/lib/trace/rust:trace-provider",
  ]
}

fuchsia_component_manifest("trace_events_component_manifest") {
  component_name = "trace_events"
  manifest = "meta/trace_events.cml"
}

fuchsia_component("trace_events_component") {
  cm_label = ":trace_events_component_manifest"
  deps = [ ":trace_events_bin" ]
}
