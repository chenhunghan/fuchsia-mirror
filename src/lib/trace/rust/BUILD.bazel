load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//build/bazel/rules/cc:fx_cc_shared_library.bzl", "fx_cc_shared_library")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "trace",
    srcs = ["src/lib.rs"],
    crate_name = "fuchsia_trace",
    edition = "2024",
    link_deps = ["//zircon/system/ulib/trace-engine"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//sdk/rust/zx",
        "//src/lib/fuchsia-rcu:fuchsia-rcu-traits",
        "//src/lib/fuchsia-runtime",
        "//third_party/rust_crates/vendor:libc",
        "//third_party/rust_crates/vendor:pin-project",
        "//third_party/rust_crates/vendor:rand",
    ],
)

# The C++ trace provider that `:trace-provider` wraps, built into
# `:rust-trace-provider` below.
fx_cc_library(
    name = "rust-trace-provider-cpp",
    srcs = ["trace-provider/trace_provider.cc"],
    implementation_deps = [
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        "//zircon/system/ulib/trace-provider",
    ],
    visibility = ["//visibility:private"],
    alwayslink = True,
)

# librust-trace-provider.so, which holds the process-global trace provider state
# and is included in the packages of Rust components that use `:trace-provider`.
#
# Not converted to GN: BUILD.gn defines `shared_library("rust-trace-provider")`
# by hand, because that file is also included in bootfs (see
# `bootfs_files_for_assembly("bootfs")` in BUILD.gn).
# @bazel2gn:skip
fx_cc_shared_library(
    name = "rust-trace-provider",
    deps = [":rust-trace-provider-cpp"],
)

# rules_rust `link_deps` require `CcInfo`, which `cc_shared_library()` doesn't
# provide, so `:trace-provider` depends on this wrapper instead.
# @bazel2gn:skip
cc_import(
    name = "rust-trace-provider-import",
    shared_library = ":rust-trace-provider",
)

rustc_library(
    name = "trace-provider",
    srcs = ["trace-provider/src/lib.rs"],
    crate_name = "fuchsia_trace_provider",
    crate_root = "trace-provider/src/lib.rs",
    edition = "2024",
    link_deps = [
        # GN links Rust binaries with rustc, which needs the C++ standard
        # library to be linked dynamically for librust-trace-provider.so; see
        # group("rust-trace-provider-for-rust") in BUILD.gn.
        ":rust-trace-provider-import",  # @bazel2gn:path_overwrite::rust-trace-provider-for-rust
        "//zircon/system/ulib/trace-provider",
    ],
    visibility = ["//:__subpackages__"],
    deps = [
        "//sdk/lib/async/rust",
        "//sdk/lib/async/rust/sys",
        "//sdk/rust/zx",
    ],
)

rustc_library(
    name = "trace-observer",
    srcs = ["trace-observer/src/lib.rs"],
    crate_name = "fuchsia_trace_observer",
    crate_root = "trace-observer/src/lib.rs",
    edition = "2024",
    link_deps = ["//zircon/system/ulib/trace"],
    visibility = [
        "//src/memory/attribution/monitor:__pkg__",
        "//src/starnix/kernel/core:__pkg__",
        "//src/starnix/modules/perfetto_consumer:__pkg__",
        "//src/sysmem/server:__subpackages__",
        "//vendor/google:__subpackages__",
    ],
    deps = [
        ":trace",
        "//sdk/rust/zx",
        "//src/lib/fuchsia-async",
    ],
)
