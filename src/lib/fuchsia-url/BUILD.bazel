load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "wrap_host_rust_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":fuchsia-url-tests"],
    visibility = ["//src/lib:__pkg__"],
)

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [":fuchsia-url_host_test"],
    visibility = ["//src/lib:__pkg__"],
)

rustc_library(
    name = "fuchsia-url",
    srcs = [
        "src/boot.rs",
        "src/builtin_url.rs",
        "src/errors.rs",
        "src/fuchsia_pkg_absolute_component_url.rs",
        "src/fuchsia_pkg_absolute_package_url.rs",
        "src/fuchsia_pkg_component_url.rs",
        "src/fuchsia_pkg_package_url.rs",
        "src/fuchsia_pkg_pinned_absolute_package_url.rs",
        "src/fuchsia_pkg_unpinned_absolute_package_url.rs",
        "src/generic.rs",
        "src/host.rs",
        "src/lib.rs",
        "src/parse.rs",
        "src/path.rs",
        "src/relative_component_url.rs",
        "src/relative_package_url.rs",
        "src/repository_url.rs",
        "src/resource.rs",
        "src/test.rs",
    ],
    edition = "2024",
    visibility = [
        "//build/assembly:__subpackages__",
        "//src/developer/ffx:__subpackages__",
        "//src/diagnostics/archivist:__subpackages__",
        "//src/fonts:__subpackages__",
        "//src/lib/assembly:__subpackages__",
        "//src/security/lib/scrutiny:__subpackages__",
        "//src/starnix:__subpackages__",
        "//src/sys:__subpackages__",
        "//tools/lib/cm_fidl_analyzer:__subpackages__",
        "//tools/pkgstats:__subpackages__",
        "//tools/test_list_tool:__subpackages__",
        "//vendor/google:__subpackages__",
    ],
    deps = [
        "//src/sys/pkg/lib/fuchsia-hash",
        "//third_party/rust_crates/vendor:percent-encoding",
        "//third_party/rust_crates/vendor:proptest",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:thiserror",
        "//third_party/rust_crates/vendor:url",
    ],
)

rustc_test(
    name = "fuchsia-url_test",
    crate = ":fuchsia-url",
    deps = [
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:serde_json",
    ],
)

wrap_host_rust_test(
    name = "fuchsia-url_host_test",
    binary_name = "fuchsia-url_test",
)

fx_unittest_package(
    name = "fuchsia-url-tests",
    unit_tests = [":fuchsia-url_test"],
)
