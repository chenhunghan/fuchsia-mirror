import("//build/fuzz.gni")
import("//build/testing/host_test.gni")
import("//build/testing/host_test_data.gni")

# A collection of utilities useful to debuggers and similar programs.

# bazel2gn does not translate host_test().
if (is_host) {
  host_test_data("test_data") {
    sources = [
      "test_data/6d4d8ac190ecc7.debug",
      "test_data/stripped_example.elf",
      "test_data/unstripped_example.arm64.rel.elf",
      "test_data/unstripped_example.arm64.rela.elf",
      "test_data/unstripped_example.x64.rel.elf",
      "test_data/unstripped_example.x64.rela.elf",
      "test_data/unstripped_example_stripped.arm64.rel.elf",
      "test_data/unstripped_example_stripped.arm64.rela.elf",
      "test_data/unstripped_example_stripped.x64.rel.elf",
      "test_data/unstripped_example_stripped.x64.rela.elf",
    ]
    outputs = [ "$root_out_dir/test_data/elflib/{{source_file_part}}" ]
  }

  host_test("elflib_unittest") {
    binary_path = "$root_out_dir/elflib_unittest"
    args = [ "env ELFLIB_TEST_DATA_DIR=" +
             rebase_path("$root_out_dir/test_data/elflib", root_build_dir) ]
    deps = [ ":elflib_unittest_bin" ]
    data_deps = [ ":test_data" ]
  }
}

group("tests") {
  testonly = true

  deps = [
    ":elflib-fuzzers",
    ":elflib_tests",
    ":elflib_unittest($host_toolchain)",
  ]
}

# Fuzzer rules do not have Bazel equivalents yet.
fuchsia_library_fuzzer("elflib_fuzzer") {
  sources = [ "elflib_fuzztest.cc" ]
  deps = [ ":elflib" ]

  # TODO(https://fxbug.dev/42136089): delete the below and fix compiler warnings
  configs += [ "//build/config:Wno-conversion" ]
}

fuchsia_fuzzer_component("elflib-fuzzer-component") {
  manifest = "meta/elflib_fuzzer.cml"
  deps = [
    ":elflib_fuzzer",
    ":test_data",
  ]
}

fuchsia_fuzzer_package("elflib-fuzzers") {
  cpp_fuzzer_components = [ ":elflib-fuzzer-component" ]
}

