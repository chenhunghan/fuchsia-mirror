load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":fuchsia-rcu-collections-tests"],
    visibility = ["//src/lib:__pkg__"],
)

rustc_library(
    name = "fuchsia-rcu-collections",
    srcs = [
        "src/lib.rs",
        "src/rcu_array.rs",
        "src/rcu_intrusive_list.rs",
        "src/rcu_list.rs",
        "src/rcu_raw_hash_map.rs",
        "src/tests/mod.rs",
        "src/tests/rcu_array.rs",
        "src/tests/rcu_intrusive_list.rs",
        "src/tests/rcu_list.rs",
        "src/tests/rcu_raw_hash_map.rs",
    ],
    edition = "2024",
    visibility = [
        "//src/starnix/kernel/core:__pkg__",
        "//src/starnix/lib/selinux:__pkg__",
        "//src/starnix/lib/starnix_rcu:__pkg__",
        "//src/starnix/lib/starnix_sync:__pkg__",
    ],
    deps = [
        "//src/lib/fuchsia-rcu",
        "//third_party/rust_crates/vendor:memoffset",
        "//third_party/rust_crates/vendor:rapidhash",
    ],
)

rustc_test(
    name = "fuchsia-rcu-collections_test",
    crate = ":fuchsia-rcu-collections",
    tags = ["manual"],
)

fx_unittest_package(
    name = "fuchsia-rcu-collections-tests",
    unit_tests = [":fuchsia-rcu-collections_test"],
)
