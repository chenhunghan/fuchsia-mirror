"""Tests of the `fostr_fidl()` macro."""

load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/host_tests:host_test.bzl", "host_test")
load("//src/lib/fostr/build:fostr_fidl.bzl", "fostr_fidl")

package(default_applicable_licenses = ["//:license"])

# The generated header is `src/lib/fostr/build/tests/formatting.h`.
fostr_fidl(
    name = "fuchsia.example.fostr",
    testonly = True,
    fidl_target = "//src/lib/fostr/test/fuchsia.example.fostr",
)

fx_cc_test_binary(
    name = "fostr_fidl_test",
    srcs = ["fostr_fidl_test.cc"],
    deps = [":fuchsia.example.fostr"],
)

host_test(
    name = "fostr_fidl_host_test",
    binary = ":fostr_fidl_test",
    target_compatible_with = HOST_OS_CONSTRAINTS,
)

# Run by //build/bazel/rules/tests:host_tests.
test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [":fostr_fidl_host_test"],
    visibility = ["//build/bazel/rules/tests:__pkg__"],
)

# Built for Fuchsia by //build/bazel/rules/tests:quick_tests.
filegroup(
    name = "build_only_tests",
    testonly = True,
    srcs = [":fostr_fidl_test"],
    visibility = ["//build/bazel/rules/tests:__pkg__"],
)
