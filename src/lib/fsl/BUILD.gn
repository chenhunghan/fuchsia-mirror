    "//src/lib/fsl/types/type_converters_unittest.cc",
    "//src/lib/fsl/vmo/file_unittest.cc",
    "//src/lib/fsl/vmo/shared_vmo_unittest.cc",
    "//src/lib/fsl/vmo/sized_vmo_unittest.cc",
