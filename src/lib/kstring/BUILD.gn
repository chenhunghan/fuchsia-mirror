import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("kstring") {
  sources = [
    "src/interned_category.rs",
    "src/interned_string.rs",
    "src/lib.rs",
  ]
  edition = "2024"
  proc_macro_deps = [ "//src/lib/kstring/macro:kstring-macro" ]
  visibility = [
    ":*",
    "//src/lib/ksync:*",
    "//src/lib/lockdep/rust:*",
    "//zircon/kernel/*",
  ]
}

rustc_test("kstring_test") {
  sources = [
    "src/interned_category.rs",
    "src/interned_string.rs",
    "src/lib.rs",
  ]
  edition = "2024"
  proc_macro_deps = [ "//src/lib/kstring/macro:kstring-macro" ]
}

fuchsia_unittest_component("kstring-test-component") {
  deps = [ ":kstring_test" ]
  component_name = "kstring-test"
}

fuchsia_test_package("kstring-test-package") {
  package_name = "kstring-test-gn"
  test_components = [ ":kstring-test-component" ]
  test_specs = {
    environments = [ emu_env ]
  }
}
if (is_fuchsia) {
  source_set("cpp_test_lib") {
    testonly = true
    sources = [ "tests/cpp_interned.cc" ]
    public_deps = [ "//src/performance/lib/fxt" ]
  }
}
if (is_fuchsia) {
  rustc_test("kstring_cpp_integration_test") {
    sources = [ "tests/integration_test.rs" ]
    source_root = "tests/integration_test.rs"
    edition = "2024"
    link_deps = [ ":cpp_test_lib" ]
    deps = [ ":kstring" ]
    configs += [ "//build/config/fuchsia:dynamic_cpp_standard_library" ]
  }
}

fuchsia_unittest_component("kstring-cpp-integration-test-component") {
  deps = [ ":kstring_cpp_integration_test" ]
  component_name = "kstring-cpp-integration-test"
}

fuchsia_test_package("kstring-cpp-integration-test-package") {
  package_name = "kstring-cpp-integration-test-gn"
  test_components = [ ":kstring-cpp-integration-test-component" ]
  test_specs = {
    environments = [ emu_env ]
  }
}
