load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "bench-bin",
    srcs = ["src/main.rs"],
    binary_name = "diagnostics_hierarchy_rust_benchmarks",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    deps = [
        "//src/developer/fuchsia-criterion",
        "//src/lib/diagnostics/inspect/rust",
        "//src/lib/diagnostics/inspect/rust/bench/utils:fuchsia_inspect_bench_utils",
        "//src/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:serde_json",
    ],
)

fx_packaged_binary(
    name = "bench-bin_packaged_bin",
    binary = ":bench-bin",
    binary_name = "diagnostics_hierarchy_rust_benchmarks",
)

fx_component_manifest(
    name = "hierarchy-component-manifest",
    component_name = "hierarchy",
    includes = ["//src/lib/diagnostics/inspect/rust/bench/meta:benchmark.shard"],
    manifest = "meta/hierarchy.cml",
)

fx_component(
    name = "hierarchy-component",
    compiled_manifest = ":hierarchy-component-manifest",
    deps = [":bench-bin_packaged_bin"],
)

fx_package(
    name = "diagnostics-hierarchy-benchmarks",
    components = [":hierarchy-component"],
)
