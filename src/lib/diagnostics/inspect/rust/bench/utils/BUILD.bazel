load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "fuchsia_inspect_bench_utils",
    srcs = ["src/lib.rs"],
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    visibility = [
        "//src/lib/diagnostics/hierarchy/rust/bench:__subpackages__",
        "//src/lib/diagnostics/inspect/rust/bench:__subpackages__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.inspect:fuchsia.inspect_rust",
        "//src/developer/fuchsia-criterion",
        "//src/lib/diagnostics/inspect/runtime/rust",
        "//src/lib/diagnostics/inspect/rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:rand",
    ],
)

rustc_test(
    name = "fuchsia_inspect_bench_utils_test",
    crate = ":fuchsia_inspect_bench_utils",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    deps = [
        "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
        "//src/lib/fuchsia",
    ],
)

fx_unittest_package(
    name = "inspect-bench-utils-unittests",
    unit_tests = [":fuchsia_inspect_bench_utils_test"],
    visibility = ["//src/lib/diagnostics:__pkg__"],
)
