rustc_library("lib") {
  sources = [
    "src/lib.rs",
    "src/service.rs",
  ]
  crate_name = "inspect_runtime"
  edition = "2024"
  lint_config = "//build/config/rust/lints:clippy_warn_all"
  visibility = [
    ":*",
    "//src/lib/diagnostics/inspect/rust/testing:*",
    "//src/sys/pkg/bin/system-update-configurator:*",
  ]
  deps = []
  deps += [
    "//sdk/fidl/fuchsia.inspect:fuchsia.inspect_rust",
    "//sdk/fidl/fuchsia.mem:fuchsia.mem_rust",
    "//sdk/rust/zx",
    "//src/lib/diagnostics/inspect/rust",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component/client",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:pin-project",
  ]
  if (current_build_target_api_level == "PLATFORM" ||
      current_build_target_api_level == "HEAD") {
    deps += [ "//third_party/rust_crates:thiserror" ]
  }
}
if (is_fuchsia) {
  rustc_test("lib_test") {
    sources = [
      "src/lib.rs",
      "src/service.rs",
    ]
    edition = "2024"
    deps = []
    deps += [
      "//sdk/fidl/fuchsia.inspect:fuchsia.inspect_rust",
      "//sdk/fidl/fuchsia.mem:fuchsia.mem_rust",
      "//sdk/rust/zx",
      "//src/lib/diagnostics/inspect/rust",
      "//src/lib/fidl/rust/fidl",
      "//src/lib/fuchsia-async",
      "//src/lib/fuchsia-component/client",
      "//third_party/rust_crates:anyhow",
      "//third_party/rust_crates:futures",
      "//third_party/rust_crates:log",
      "//third_party/rust_crates:pin-project",
    ]
    if (current_build_target_api_level == "PLATFORM" ||
        current_build_target_api_level == "HEAD") {
      deps += [ "//third_party/rust_crates:thiserror" ]
    }
    deps += [
      "//src/lib/diagnostics/hierarchy/rust:diagnostics-hierarchy",
      "//src/lib/diagnostics/reader/rust",
      "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
      "//src/lib/fuchsia",
      "//src/lib/fuchsia-component-test",
      "//src/sys/lib/component-events",
      "//third_party/rust_crates:assert_matches",
    ]
    output_name = "inspect_runtime_lib_test"
    lint_config = "//build/config/rust/lints:clippy_warn_all"
  }
}

fuchsia_component_manifest("inspect-runtime-tests-manifest") {
  testonly = true
  component_name = "inspect-runtime-tests"
  manifest = "meta/inspect_runtime_lib_test.cml"
}

fuchsia_test_component("inspect-runtime-tests-component") {
  cm_label = ":inspect-runtime-tests-manifest"
  deps = [ ":lib_test" ]
}

fuchsia_test_package("inspect-runtime-tests-package") {
  package_name = "inspect-runtime-tests-gn"
  test_components = [ ":inspect-runtime-tests-component" ]
  deps = [
    ":inspect_test_component",
    "//src/lib/fuchsia-component-test/realm_builder_server:realm_builder_server_component",
  ]
}

fuchsia_component_manifest("inspect_test_component_manifest") {
  component_name = "inspect_test_component"
  manifest = "meta/inspect_test_component.cml"
}

fuchsia_structured_config_rust_lib("inspect_test_component_config_bindings") {
  cm_label = ":inspect_test_component_manifest"
}

rustc_binary("inspect_test_component_bin") {
  testonly = true
  sources = [ "test/main.rs" ]
  source_root = "test/main.rs"
  edition = "2024"
  lint_config = "//build/config/rust/lints:clippy_warn_all"
  deps = [
    ":inspect_test_component_config_bindings",
    "//src/lib/diagnostics/inspect/runtime/rust",
    "//src/lib/diagnostics/inspect/rust",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//third_party/rust_crates:futures",
  ]
}

fuchsia_component("inspect_test_component") {
  testonly = true
  cm_label = ":inspect_test_component_manifest"
  visibility = [
    ":*",
    "//src/lib/diagnostics/reader/rust:*",
  ]
  deps = [ ":inspect_test_component_bin" ]
}

group("inspect_test_component_default") {
  testonly = true
  public_deps = [ ":inspect_test_component" ]
  visibility = [
    ":*",
    "//src/lib/diagnostics/reader/rust:*",
  ]
}
