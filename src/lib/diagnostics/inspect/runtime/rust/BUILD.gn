group("tests") {
  testonly = true
  deps = [ ":inspect-runtime-tests-package" ]
}

group("rust") {
  public_deps = [
    ":lib",
    "//sdk/lib/inspect:client_includes",
  ]
}

group("unchecked_includes") {
  public_deps = [ ":lib" ]
}

