load("//build/bazel/rules/components:cml_shard.bzl", "cml_shard")
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

cml_shard(
    name = "meta/benchmark.shard",
    includes = [
        "//sdk/lib/sys/testing:elf_test_runner.shard.cml",
        "//sdk/lib/syslog:client.shard",
    ],
    shard = "meta/benchmark.shard.cml",
)

rustc_binary(
    name = "encoding-bin",
    srcs = [
        "src/common.rs",
        "src/encoding.rs",
    ],
    crate_name = "diagnostics_log_encoding_bench",
    crate_root = "src/encoding.rs",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    deps = [
        "//sdk/fidl/fuchsia.logger:fuchsia.logger_rust",
        "//sdk/rust/zx",
        "//src/developer/fuchsia-criterion",
        "//src/lib/diagnostics/log/encoding/rust",
        "//src/lib/diagnostics/log/rust",
        "//src/lib/fuchsia-runtime",
        "//third_party/rust_crates/vendor:log",
    ],
)

rustc_binary(
    name = "core-bin",
    srcs = ["src/core.rs"],
    crate_name = "diagnostics_log_bench",
    crate_root = "src/core.rs",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    deps = [
        "//sdk/fidl/fuchsia.logger:fuchsia.logger_rust",
        "//src/developer/fuchsia-criterion",
        "//src/diagnostics/lib/ring-buffer",
        "//src/lib/diagnostics/log/rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:log",
    ],
)

rustc_binary(
    name = "decoding-bin",
    srcs = [
        "src/common.rs",
        "src/decoding.rs",
    ],
    crate_name = "diagnostics_log_decoding_bench",
    crate_root = "src/decoding.rs",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    deps = [
        "//sdk/fidl/fuchsia.logger:fuchsia.logger_rust",
        "//sdk/rust/zx",
        "//src/developer/fuchsia-criterion",
        "//src/lib/diagnostics/log/encoding/rust",
        "//src/lib/diagnostics/log/rust",
        "//src/lib/fuchsia-runtime",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:log",
    ],
)

fx_packaged_binary(
    name = "encoding-bin_packaged_bin",
    binary = ":encoding-bin",
    binary_name = "diagnostics_log_encoding_bench",
)

fx_packaged_binary(
    name = "core-bin_packaged_bin",
    binary = ":core-bin",
    binary_name = "diagnostics_log_bench",
)

fx_packaged_binary(
    name = "decoding-bin_packaged_bin",
    binary = ":decoding-bin",
    binary_name = "diagnostics_log_decoding_bench",
)

fx_component_manifest(
    name = "encoding-component-manifest",
    component_name = "encoding",
    includes = [":meta/benchmark.shard"],
    manifest = "meta/encoding.cml",
)

fx_component_manifest(
    name = "decoding-component-manifest",
    component_name = "decoding",
    includes = [":meta/benchmark.shard"],
    manifest = "meta/decoding.cml",
)

fx_component_manifest(
    name = "core-component-manifest",
    component_name = "core",
    includes = [":meta/benchmark.shard"],
    manifest = "meta/core.cml",
)

fx_component(
    name = "encoding-component",
    compiled_manifest = ":encoding-component-manifest",
    deps = [":encoding-bin_packaged_bin"],
)

fx_component(
    name = "decoding-component",
    compiled_manifest = ":decoding-component-manifest",
    deps = [":decoding-bin_packaged_bin"],
)

fx_component(
    name = "core-component",
    compiled_manifest = ":core-component-manifest",
    deps = [":core-bin_packaged_bin"],
)

fx_package(
    name = "diagnostics-log-rust-benchmarks",
    components = [
        ":core-component",
        ":decoding-component",
        ":encoding-component",
    ],
)
