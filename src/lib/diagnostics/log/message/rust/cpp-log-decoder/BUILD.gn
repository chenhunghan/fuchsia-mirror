cc_test_executable("cpp-log-decoder-unittest") {
  sources = [ "test.cc" ]
  deps = [
    ":log_decoder_api_cpp",
    ":staticlib",
    "//sdk/lib/syslog/cpp",
    "//src/lib/fxl/test:gtest_main",
    "//third_party/googletest:gtest",
  ]
  testonly = true
  emit_tool_path = false
}

fuchsia_unittest_package("cpp-log-decoder-tests") {
  package_name = "cpp-log-decoder-tests-gn"
  component_name = "cpp-log-decoder-tests"
  deps = [ ":cpp-log-decoder-unittest" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
