}

source_set("headers") {
  testonly = true
  public = [ "log_decoder.h" ]
  deps = [ "//src/lib/diagnostics/fake-log-sink/rust:rust_ffi" ]
  visibility = [
    ":*",
    "//src/lib/diagnostics/fake-log-sink/cpp:*",
    "//src/storage/lib/watchdog:*",
  ]
}

rustc_staticlib("staticlib") {
  sources = [ "src/lib.rs" ]
  configs += [
    "//build/config:optimize_size",
    "//build/config/lto:thinlto-if-compatible",
  ]
  crate_name = "log_decoder_c_bindings"
  edition = "2024"
  deps = [
    "//src/lib/diagnostics/log/encoding/rust",
    "//src/lib/diagnostics/log/message/rust",
    "//third_party/rust_crates:bumpalo",
    "//third_party/rust_crates:thiserror",
  ]
}
if (is_fuchsia) {
  source_set("log_decoder_api_cpp") {
    sources = [ "log_decoder_api.cc" ]
