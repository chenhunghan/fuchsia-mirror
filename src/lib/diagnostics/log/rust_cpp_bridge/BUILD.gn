import("//build/tools/bazel2gn/bazel_migration.gni")

source_set("cpp_syslog_wrapper") {
  sources = [ "wrapper.cc" ]
  deps = [ "//sdk/lib/syslog/cpp" ]
}

rustc_library("rust_cpp_bridge") {
  sources = [ "src/lib.rs" ]
  crate_name = "logging_rust_cpp_bridge"
  edition = "2024"
  link_deps = [ ":cpp_syslog_wrapper" ]
  visibility = [
    ":*",
    "//src/developer/ffx/lib/profiler:*",
    "//src/developer/ffx/lib/symbolize/tests:*",
  ]
  deps = [ "//third_party/rust_crates:log" ]
}

source_set("cpp_syslog_test_wrapper") {
  sources = [ "test_wrapper.cc" ]
  deps = [ "//sdk/lib/syslog/cpp" ]
}
if (is_fuchsia) {
  rustc_test("logging_rust_cpp_bridge_test") {
    sources = [ "src/lib.rs" ]
    edition = "2024"
    link_deps = [ ":cpp_syslog_wrapper" ] + [ ":cpp_syslog_test_wrapper" ]
    deps = [ "//third_party/rust_crates:log" ] + [
             "//src/lib/diagnostics/reader/rust",
             "//src/lib/fuchsia",
             "//third_party/rust_crates:futures",
           ]
    configs += [ "//build/config/fuchsia:dynamic_cpp_standard_library" ]
  }
}
