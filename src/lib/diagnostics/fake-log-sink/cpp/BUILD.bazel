load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//build/bazel/rules/components:expect_includes.bzl", "expect_includes")

package(default_applicable_licenses = ["//:license"])

# `fx_cc_library` has no `output_name` attribute in Bazel; preserve GN
# `output_name` for object file disambiguation; TODO(https://fxbug.dev/570694755).
# @bazel2gn:raw_attribute:output_name = "fake_log_sink"
fx_cc_library(
    name = "cpp",
    testonly = True,
    srcs = ["fake_log_sink.cc"],
    hdrs = ["fake_log_sink.h"],
    aspect_hints = [":shard"],
    implementation_deps = [
        "//src/lib/diagnostics/fake-log-sink/rust:rust_ffi_headers",
        "//src/lib/diagnostics/log/message/rust/cpp-log-decoder:headers",
    ],
    visibility = [
        "//sdk/lib/driver/component/cpp:__pkg__",
        "//sdk/lib/syslog/cpp:__pkg__",
        "//src/graphics/display/lib/driver-framework-migration-utils/logging:__pkg__",
        "//src/graphics/magma/tests/integration:__pkg__",
        "//src/storage/lib/watchdog:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.logger:fuchsia.logger_cpp",
        "//sdk/lib/async:async-cpp",
        "//sdk/lib/diagnostics/reader/cpp:archive_reader",
        "//sdk/lib/syslog/cpp",
        "//zircon/system/ulib/zx",
    ],
    alwayslink = True,
)

expect_includes(
    name = "shard",
    # TODO(https://fxbug.dev/441642041): Stabilize zx_iob_create_shared_region
    # We use the zxtest runner for VDSO next which is currently required
    # for some of the IOB API which is used by logging fakes. We can switch
    # back to the default runner when it is stabilised.
    includes = ["//src/sys/test_runners/gtest:zxtest.shard.cml"],
)
