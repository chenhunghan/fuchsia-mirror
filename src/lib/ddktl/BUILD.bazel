load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")

package(default_applicable_licenses = ["//:license"])

fx_cc_library(
    name = "ddktl",
    srcs = ["fidl.cc"],
    hdrs = [
        "include/ddktl/composite-node-spec.h",
        "include/ddktl/device.h",
        "include/ddktl/device-internal.h",
        "include/ddktl/fidl.h",
        "include/ddktl/init-txn.h",
        "include/ddktl/metadata.h",
        "include/ddktl/metadata_server.h",
        "include/ddktl/suspend-txn.h",
        "include/ddktl/unbind-txn.h",
    ],
    implementation_deps = [
        "//sdk/lib/driver/runtime:driver_runtime_cpp",
    ] + select({
        "@platforms//os:fuchsia": [
            "//zircon/system/ulib/sync",
        ],
        "//conditions:default": [],
    }),
    includes = ["include"],
    public_configs = [":include"],
    #  ________  _________  ________  ________
    # |\   ____\|\___   ___\\   __  \|\   __  \
    # \ \  \___|\|___ \  \_\ \  \|\  \ \  \|\  \
    #  \ \_____  \   \ \  \ \ \  \\\  \ \   ____\
    #   \|____|\  \   \ \  \ \ \  \\\  \ \  \___|
    #     ____\_\  \   \ \__\ \ \_______\ \__\
    #    |\_________\   \|__|  \|_______|\|__|
    #    \|_________|
    #
    # New drivers should be written for DFv2. If you need to target a board stuck
    # on DFv1, it is acceptable to add an entry to this list.
    #
    # To remove items from the allowlist, please send a change to one of the
    # OWNERS of this file to remove an element from the visibility list below.
    #
    # Please allowlist entire directories rather than individual targets as it
    # requires less allowlist churn over time.
    visibility = ["//:__subpackages__"],
    deps = [
        # <ddktl/fidl.h> has #include <lib/fidl/cpp/wire/transaction.h>.
        "//sdk/lib/fidl/cpp/wire",

        # <ddktl/fidl.h> has #include <lib/stdcompat/span.h>.
        "//sdk/lib/stdcompat",

        # <ddktl/composite-node-spec.h> has #include <bind/fuchsia/cpp/bind.h>.
        "//src/devices/bind/fuchsia:fuchsia_cpp",

        # <ddktl/fidl.h> has #include <ddk/device.h>.
        "//src/lib/ddk",

        # <ddktl/device.h> has #include <lib/zx/channel.h>.
        # <ddktl/device.h> has #include <lib/zx/result.h>.
        "//zircon/system/ulib/zx",
    ] + select({
        "@platforms//os:fuchsia": [
            # <ddktl/device.h> has #include <fidl/fuchsia.driver.framework/cpp/fidl.h>.
            "//sdk/fidl/fuchsia.driver.framework:fuchsia.driver.framework_cpp",

            # <ddktl/metadata_server.h> has #include
            # <fidl/fuchsia.driver.metadata/cpp/fidl.h>.
            "//sdk/fidl/fuchsia.driver.metadata:fuchsia.driver.metadata_cpp",

            # <ddktl/device.h> has #include <lib/component/incoming/cpp/protocol.h>.
            "//sdk/lib/component/incoming/cpp",

            # <ddktl/metadata_server.h> has #include
            # <lib/component/outgoing/cpp/outgoing_directory.h>.
            "//sdk/lib/component/outgoing/cpp",

            # <ddktl/metadata_server.h> has #include
            # <lib/driver/outgoing/cpp/outgoing_directory.h>.
            "//sdk/lib/driver/outgoing/cpp",

            # <ddktl/device.h> has #include <lib/fidl_driver/cpp/transport.h>.
            "//sdk/lib/fidl_driver:fidl_driver_transport",
        ],
        "//conditions:default": [],
    }),
    alwayslink = True,
)
