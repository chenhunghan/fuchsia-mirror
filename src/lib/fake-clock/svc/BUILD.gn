  edition = "2024"
  visibility = [ ":*" ]
  deps = [
    "//sdk/rust/zx",
    "//src/lib/fake-clock/fidl:fidl_rust",
    "//src/lib/fake-clock/named-timer:fidl_rust",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-sync",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:rand",
  ]
}
if (is_fuchsia) {
  rustc_test("fake_clock_svc_test") {
    sources = [ "src/main.rs" ]
    edition = "2024"
    deps = [
             "//sdk/rust/zx",
             "//src/lib/fake-clock/fidl:fidl_rust",
             "//src/lib/fake-clock/named-timer:fidl_rust",
             "//src/lib/fidl/rust/fidl",
             "//src/lib/fuchsia",
             "//src/lib/fuchsia-async",
             "//src/lib/fuchsia-component",
             "//src/lib/fuchsia-sync",
             "//third_party/rust_crates:anyhow",
             "//third_party/rust_crates:futures",
             "//third_party/rust_crates:log",
             "//third_party/rust_crates:rand",
           ] + [ "//src/lib/fake-clock/named-timer" ]
    source_root = "src/main.rs"
    visibility = [ ":*" ]
  }
}

fuchsia_component_manifest("svc_manifest") {
  testonly = true
  component_name = "fake_clock"
  manifest = "meta/fake_clock.cml"
  visibility = [ ":*" ]
}

fuchsia_component("svc") {
  testonly = true
  cm_label = ":svc_manifest"
  visibility = [
    ":*",
    "//src/connectivity/*",
    "//src/lib/fake-clock/*",
    "//src/power/*",
    "//src/recovery/*",
    "//src/sys/*",
    "//src/ui/*",
  ]
  deps = [ ":fake_clock_svc" ]
}

fuchsia_unittest_package("tests") {
  package_name = "fake_clock_test-gn"
  component_name = "fake_clock_test"
  deps = [ ":fake_clock_svc_test" ]
  visibility = [
    ":*",
    "//src/lib:*",
    "//src/lib/fake-clock:*",
  ]
}
