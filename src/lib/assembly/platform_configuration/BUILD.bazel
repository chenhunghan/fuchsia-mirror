load("@fuchsia_build_info//:args.bzl", "enable_assembly_heapdump")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [":platform_configuration_test"],
    visibility = ["//src/lib/assembly:__pkg__"],
)

exports_files(
    [
        "src/subsystems/meta/tee-clients.core_shard.cml",
    ],
    visibility = ["//bundles/assembly:__subpackages__"],
)

rustc_library(
    name = "platform_configuration",
    srcs = [
        "src/common.rs",
        "src/lib.rs",
        "src/subsystems.rs",
        "src/subsystems/battery.rs",
        "src/subsystems/bluetooth.rs",
        "src/subsystems/build_info.rs",
        "src/subsystems/component.rs",
        "src/subsystems/connectivity.rs",
        "src/subsystems/development.rs",
        "src/subsystems/diagnostics.rs",
        "src/subsystems/driver_framework.rs",
        "src/subsystems/example.rs",
        "src/subsystems/factory_store_providers.rs",
        "src/subsystems/fonts.rs",
        "src/subsystems/forensics.rs",
        "src/subsystems/graphics.rs",
        "src/subsystems/hwinfo.rs",
        "src/subsystems/icu.rs",
        "src/subsystems/intl.rs",
        "src/subsystems/kernel.rs",
        "src/subsystems/media.rs",
        "src/subsystems/memory_monitor.rs",
        "src/subsystems/paravirtualization.rs",
        "src/subsystems/power.rs",
        "src/subsystems/radar.rs",
        "src/subsystems/rcs.rs",
        "src/subsystems/recovery.rs",
        "src/subsystems/sensors.rs",
        "src/subsystems/session.rs",
        "src/subsystems/setui.rs",
        "src/subsystems/starnix.rs",
        "src/subsystems/storage.rs",
        "src/subsystems/swd.rs",
        "src/subsystems/sysmem.rs",
        "src/subsystems/system_sounds.rs",
        "src/subsystems/tee.rs",
        "src/subsystems/thermal.rs",
        "src/subsystems/timekeeper.rs",
        "src/subsystems/trusted_apps.rs",
        "src/subsystems/ui.rs",
        "src/subsystems/usb.rs",
        "src/subsystems/virtualization.rs",
        "src/util.rs",
    ],
    # If true, forcefully enables Heapdump for the entire system (including
    # component_manager and all other monikers) during assembly of eng standard
    # builds.
    crate_features = ["enable_assembly_heapdump"] if enable_assembly_heapdump else [],
    crate_name = "assembly_platform_configuration",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//src/lib/assembly:__subpackages__"],
    deps = [
        "//sdk/fidl/fuchsia.images2:fuchsia.images2_rust_common",
        "//sdk/fidl/fuchsia.sysmem2:fuchsia.sysmem2_rust_common",
        "//src/devices/bind/fuchsia.platform:fuchsia.platform_rust",
        "//src/diagnostics/lib/sampler-config",
        "//src/lib/assembly/cli_args",
        "//src/lib/assembly/component_id_index",
        "//src/lib/assembly/component_manager_config",
        "//src/lib/assembly/config_capabilities",
        "//src/lib/assembly/config_schema",
        "//src/lib/assembly/constants",
        "//src/lib/assembly/container",
        "//src/lib/assembly/images_config",
        "//src/lib/assembly/named_file_map",
        "//src/lib/assembly/platform_artifacts",
        "//src/lib/assembly/util",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-url",
        "//src/microfuchsia/tee/manager-config",
        "//src/starnix/lib/features:starnix_features",
        "//src/sys/lib/cm_config",
        "//src/sys/lib/cm_types",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:camino",
        "//third_party/rust_crates/vendor:handlebars",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:serde_json5",
        "//third_party/rust_crates/vendor:uuid",
        "//tools/lib/cml",
    ],
)

host_rustc_test(
    name = "platform_configuration_test",
    crate = ":platform_configuration",
    crate_features = ["enable_assembly_heapdump"] if enable_assembly_heapdump else [],
    deps = [
        "//sdk/fidl/fuchsia.component.internal:fuchsia.component.internal_rust_common",
        "//src/lib/assembly/images_config",
        "//src/lib/assembly/util",
        "//src/lib/diagnostics/selectors",
        "//src/lib/utf8_path",
        "//third_party/rust_crates/vendor:tempfile",
    ],
)
