load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "validate_package",
    srcs = ["src/lib.rs"],
    crate_name = "assembly_validate_package",
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//src/lib/assembly/image_assembly_config_builder:__pkg__",
        "//src/lib/assembly/structured_config/tests/repackaging_pass:__pkg__",
        "//tools/configc:__pkg__",
    ],
    deps = [
        "//src/lib/assembly/structured_config",
        "//src/lib/assembly/validate_util",
        "//src/lib/versioning/version-history/rust",
        "//src/lib/versioning/version-history/rust/data",
        "//src/sys/pkg/lib/far/rust:fuchsia-archive",
        "//src/sys/pkg/lib/fuchsia-pkg",
        "//third_party/rust_crates/vendor:anyhow",
    ],
)

host_rustc_test(
    name = "validate_package_test",
    crate = ":validate_package",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//src/lib/assembly:__pkg__"],
)
