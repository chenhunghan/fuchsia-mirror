load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//build/bazel/rules/host_tests:host_cc_test.bzl", "host_cc_test")

package(default_applicable_licenses = ["//:license"])

# The names of the environment variables that indicate an AI agent come from
# //tools/devshell/lib, which is the source of truth for all languages.
genrule(
    name = "gen_agent_environments",
    srcs = ["//tools/devshell/lib:agents.txt"],
    outs = [
        # GN action() outputs require an explicit $target_gen_dir prefix.
        "agent_environments.inc",  # @bazel2gn:path_overwrite:$target_gen_dir/agent_environments.inc
    ],
    cmd = "$(location :gen_environment_variable_list.sh) $@ $<",
    tools = [":gen_environment_variable_list.sh"],
)

genrule(
    name = "gen_agent_session_id_environments",
    srcs = ["//tools/devshell/lib:agent_session_ids.txt"],
    outs = [
        # GN action() outputs require an explicit $target_gen_dir prefix.
        "agent_session_id_environments.inc",  # @bazel2gn:path_overwrite:$target_gen_dir/agent_session_id_environments.inc
    ],
    cmd = "$(location :gen_environment_variable_list.sh) $@ $<",
    tools = [":gen_environment_variable_list.sh"],
)

# GN depends on the generated include files via `deps`, whereas Bazel compiles
# against the genrule outputs via `srcs`.
# @bazel2gn:raw_attribute:deps = [ ":gen_agent_environments", ":gen_agent_session_id_environments" ]
fx_cc_library(
    name = "testable_internals",
    srcs = [
        "environment_status.cc",
        "persistent_status.cc",
        ":gen_agent_environments",  # @bazel2gn:skip
        ":gen_agent_session_id_environments",  # @bazel2gn:skip
    ],
    hdrs = [
        "environment_status.h",
        "persistent_status.h",
    ],
    deps = [
        "//src/lib/analytics/cpp/metric_properties",
        "//src/lib/uuid",
    ],
    alwayslink = True,
)

fx_cc_library(
    name = "core_dev_tools",
    srcs = [
        "analytics_executor.cc",
        "analytics_internal.cc",
        "analytics_messages.cc",
        "analytics_messages.h",
        "analytics_status.h",
        "command_line_options.cc",
        "ga4_common_events.h",
        "google_analytics_4_client.cc",
        "system_info.cc",
    ],
    hdrs = [
        "analytics.h",
        "analytics_executor.h",
        "analytics_internal.h",
        "command_line_options.h",
        "google_analytics_4_client.h",
        "system_info.h",
    ],
    implementation_deps = [
        "//src/developer/debug/shared",
        "//src/developer/debug/zxdb/common",
    ],
    visibility = [
        "//src/developer/debug/zxdb/client:__pkg__",
        "//src/developer/debug/zxdb/console:__pkg__",
        "//tools/fidlcat:__pkg__",
        "//tools/fidlcat/lib:__pkg__",
        "//tools/symbolizer:__pkg__",
    ],
    deps = [
        ":testable_internals",
        "//sdk/lib/fit-promise",
        "//sdk/lib/syslog/cpp",
        "//src/lib/analytics/cpp/google_analytics_4",
        "//src/lib/analytics/cpp/metric_properties",
        "//src/lib/cmdline",
        "//src/lib/fxl",
    ],
)

host_cc_test(
    name = "analytics_cpp_core_dev_tools_unittests",
    srcs = [
        "environment_status_unittest.cc",
        "persistent_status_unittest.cc",
        ":gen_agent_environments",
        ":gen_agent_session_id_environments",
    ],
    test_args = ["env HOME=/tmp"],
    visibility = ["//src/lib/analytics:__pkg__"],
    deps = [
        ":core_dev_tools",
        ":testable_internals",
        "//src/lib/analytics/cpp/metric_properties",
        "//src/lib/files",
        "//src/lib/fxl/test:gtest_main",
        "//src/lib/uuid",
        "@com_google_googletest//:gtest",
    ],
)
