import("//build/testing/host_test.gni")

if (is_host) {
  host_test("unittests_host_test") {
    binary_path = "$root_out_dir/analytics_cpp_metric_properties_unittests"
    deps = [ ":unittests" ]
    target = get_label_info(":unittests", "label_with_toolchain")
  }
}

group("tests") {
  testonly = true

  deps = [ ":unittests_host_test($host_toolchain)" ]
}

