import("//build/tools/bazel2gn/bazel_migration.gni")

lib_sources = [
  "src/diagnostics.rs",
  "src/lib.rs",
  "src/zstd_compress.rs",
]

# To avoid "Assignment had no effect" from GN.
# It's possible this variable is only used in if conditions (e.g. is_host).
not_needed([ "lib_sources" ])

lib_deps = [
  "//src/lib/diagnostics/data/rust",
  "//src/lib/fuchsia-async",
  "//src/lib/fuchsia-sync",
  "//third_party/rust_crates:anyhow",
  "//third_party/rust_crates:futures",
  "//third_party/rust_crates:pin-project",
  "//third_party/rust_crates:thiserror",
  "//third_party/rust_crates:zstd",
]

# To avoid "Assignment had no effect" from GN.
# It's possible this variable is only used in if conditions (e.g. is_host).
not_needed([ "lib_deps" ])

shared_test_deps = [
  "//src/lib/fuchsia",
  "//third_party/rust_crates:assert_matches",
  "//third_party/rust_crates:pretty_assertions",
  "//third_party/rust_crates:rand",
  "//third_party/rust_crates:serde_json",
  "//third_party/rust_crates:test-case",
]

# To avoid "Assignment had no effect" from GN.
# It's possible this variable is only used in if conditions (e.g. is_host).
not_needed([ "shared_test_deps" ])

rustc_library("test_diagnostics") {
  sources = lib_sources
  edition = "2024"
  link_deps = [ "//third_party/zstd" ]
  visibility = [
    ":*",
    "//src/sys/run_test_suite:*",
    "//src/sys/test_manager:*",
  ]
  deps = []
  deps += lib_deps
  deps += [
    "//sdk/fidl/fuchsia.test.manager:fuchsia.test.manager_rust_flex",
    "//src/diagnostics/lib/log-command",
    "//src/lib/fdomain/client:flex_fidl",
  ]
  if (is_fuchsia) {
    deps += [
      "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust",
      "//src/lib/diagnostics/reader/rust",
      "//src/lib/fidl/rust/fidl",
    ]
  }
}
if (is_host) {
  rustc_library("test_diagnostics_fdomain") {
    sources = lib_sources
    features = [ "fdomain" ]
    edition = "2024"
    link_deps = [ "//third_party/zstd" ]
    visibility = [
      ":*",
      "//src/sys/run_test_suite:*",
    ]
    deps = lib_deps + [
             "//sdk/fidl/fuchsia.test.manager:fuchsia.test.manager_rust_fdomain_flex",
             "//src/diagnostics/lib/log-command:log-command_fdomain",
             "//src/lib/fdomain/client:flex_fdomain",
           ]
  }
}
if (is_fuchsia) {
  rustc_test("test_diagnostics_test") {
    sources = lib_sources
    edition = "2024"
    link_deps = [ "//third_party/zstd" ]
    deps = []
    deps += lib_deps
    deps += [
      "//sdk/fidl/fuchsia.test.manager:fuchsia.test.manager_rust_flex",
      "//src/diagnostics/lib/log-command",
      "//src/lib/fdomain/client:flex_fidl",
    ]
    if (is_fuchsia) {
      deps += [
        "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust",
        "//src/lib/diagnostics/reader/rust",
        "//src/lib/fidl/rust/fidl",
      ]
    }
    deps += shared_test_deps
    deps += [
      "//sdk/fidl/fuchsia.mem:fuchsia.mem_rust",
      "//sdk/rust/zx",
    ]
    output_name = "test_diagnostics_lib_test"
  }
}

fuchsia_unittest_package("test_diagnostics_unittests") {
  package_name = "test_diagnostics_unittests-gn"
  component_name = "test_diagnostics_unittests"
  deps = [ ":test_diagnostics_test" ]
  visibility = [
    ":*",
    "//src/lib:*",
  ]
}
if (is_host) {
  rustc_test("test_diagnostics_host_unittests") {
    sources = lib_sources
    edition = "2024"
    link_deps = [ "//third_party/zstd" ]
    deps = lib_deps + [
             "//sdk/fidl/fuchsia.test.manager:fuchsia.test.manager_rust_fdomain_flex",
             "//src/diagnostics/lib/log-command:log-command_fdomain",
             "//src/lib/fdomain/client:flex_fdomain",
           ] + shared_test_deps +
           [
             "//src/lib/fdomain/local",
             "//src/lib/fidl/rust/fidl",
           ]
    features = [ "fdomain" ]
    visibility = [
      ":*",
      "//src/lib:*",
    ]
  }
}
