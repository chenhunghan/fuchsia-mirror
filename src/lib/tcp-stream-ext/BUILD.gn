rustc_library("tcp-stream-ext") {
  sources = [ "src/lib.rs" ]
  configs += [ "//build/config/rust/lints:deny_unused_results" ]
  edition = "2024"
  visibility = [
    ":*",
    "//src/connectivity/network/tests/connect:*",
  ]
  deps = [
    "//third_party/rust_crates:libc",
    "//third_party/rust_crates:thiserror",
  ]
}

rustc_test("tcp-stream-ext_test") {
  sources = [ "src/lib.rs" ]
  edition = "2024"
  deps = [
           "//third_party/rust_crates:libc",
           "//third_party/rust_crates:thiserror",
         ] +
         [
           "//third_party/rust_crates:proptest",
           "//third_party/rust_crates:socket2",
         ]
  configs += [ "//build/config/rust/lints:deny_unused_results" ]
  output_name = "tcp_stream_ext_lib_test"
}

rustc_test("stub-netstack-test") {
  sources = [ "src/stub_netstack_test.rs" ]
  configs += [ "//build/config/rust/lints:deny_unused_results" ]
  source_root = "src/stub_netstack_test.rs"
  edition = "2024"
  deps = [
    ":tcp-stream-ext",
    "//sdk/fidl/fuchsia.posix.socket:fuchsia.posix.socket_rust",
    "//sdk/rust/zx",
    "//src/lib/fdio/rust:fdio",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia-async",
    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:futures",
  ]
}
