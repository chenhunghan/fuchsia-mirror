import("//build/cpp/sdk_source_set.gni")

config("vmo_store_include") {
  include_dirs = [ "include" ]
}

# vmo_store is in the IDK only so in-tree targets built with the Bazel SDK rules
# (e.g. drivers) can use it at HEAD.
# TODO(https://fxbug.dev/444521390): Stabilize or remove from the IDK, and switch
# to idk_cc_source_library() + bazel2gn once //zircon/system/ulib/{fbl,fzl}
# expose _idk Bazel targets.
# LINT.IfChange
if (is_fuchsia) {
  sdk_source_set("vmo_store") {
    public = [
      "include/lib/vmo_store/growable_slab.h",
      "include/lib/vmo_store/owned_vmo_store.h",
      "include/lib/vmo_store/storage_types.h",
      "include/lib/vmo_store/stored_vmo.h",
      "include/lib/vmo_store/vmo_store.h",
    ]
    sdk_area = "Driver SDK"
    category = "partner"
    sdk_name = "vmo_store"
    public_configs = [ ":vmo_store_include" ]
    stable = false
    visibility = [
      ":*",
      "//src/connectivity/ethernet/drivers/*",
      "//src/connectivity/network/drivers/network-device/device:*",
      "//src/connectivity/network/tun/network-tun:*",
      "//src/devices/block/drivers/*",
      "//src/devices/radar/lib/vmo-manager:*",
      "//src/devices/spi/drivers/aml-spi:*",
    ]
    public_deps = [
      "//sdk/lib/stdcompat",
      "//zircon/system/ulib/fbl",
      "//zircon/system/ulib/fzl",
      "//zircon/system/ulib/zx",
    ]
  }
}

# LINT.ThenChange(BUILD.bazel)

group("tests") {
  testonly = true
  deps = [ ":vmo-store-test-package" ]
}

