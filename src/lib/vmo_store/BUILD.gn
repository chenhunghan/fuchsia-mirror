import("//build/tools/bazel2gn/bazel_migration.gni")

if (is_fuchsia) {
  cc_test_executable("test_bin") {
    sources = [
      "growable_slab_test.cc",
      "map_pin_test.cc",
      "owned_vmo_store_test.cc",
      "typed_store_test.cc",
    ]
    output_name = "vmo-store-test"
    deps = [
      ":vmo_store",
      "//src/devices/testing/fake-bti",
      "//src/lib/fxl/test:gtest_main",
      "//src/lib/testing/predicates",
      "//third_party/googletest:gtest",
    ]
    testonly = true
    emit_tool_path = false
  }
}

fuchsia_unittest_component("vmo-store-test-component") {
  deps = [ ":test_bin" ]
  component_name = "vmo-store-test"
}

fuchsia_test_package("vmo-store-test-package") {
  package_name = "vmo-store-test-gn"
  test_components = [ ":vmo-store-test-component" ]
  test_specs = {
    environments = [ emu_env ]
  }
}
