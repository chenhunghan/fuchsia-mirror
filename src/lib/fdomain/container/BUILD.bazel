load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":fdomain-container-tests"],
    visibility = ["//src/lib:__pkg__"],
)

rustc_library(
    name = "container",
    srcs = [
        "src/handles.rs",
        "src/lib.rs",
        "src/test.rs",
        "src/wire.rs",
    ],
    crate_name = "fdomain_container",
    edition = "2024",
    visibility = [
        "//src/developer/remote-control:__pkg__",
        "//src/lib/fdomain/client:__pkg__",
        "//src/lib/fdomain/example:__pkg__",
        "//src/lib/fdomain/example_next:__pkg__",
        "//src/lib/fdomain/local:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.fdomain:fuchsia.fdomain_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fidl/rust/fidl_message",
        "//src/lib/replace-with",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:pin-project",
        "//third_party/rust_crates/vendor:rand",
    ] + select({
        "@platforms//os:fuchsia": [
            "//sdk/rust/zx",
            "//src/lib/fuchsia-async",
        ],
        "//conditions:default": [],
    }),
)

rustc_test(
    name = "container_test",
    crate = ":container",
    # Sets the GN `output_name` to avoid colliding with other `container_test` binaries.
    crate_name = "fdomain_container_lib_test",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//src/lib/fuchsia",
    ],
)

fx_unittest_package(
    name = "fdomain-container-tests",
    unit_tests = [":container_test"],
)
