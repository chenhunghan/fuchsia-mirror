load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")

package(default_applicable_licenses = ["//:license"])

# Host tests for //src/lib defined in Bazel. These are exported to `fx test`
# and infra builders through the `bazel_tests` target in //src/lib/BUILD.gn.
test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [
        "//src/lib/containers/cpp:host_tests",
        "//src/lib/fidl/c/walker_tests:fidl-walker-host-tests_host_test",
        "//src/lib/fidl/rust/external_tests:host_tests",
        "//src/lib/fidl/rust/fidl_test_util:fidl_test_util_host_test",
        "//src/lib/fidl/rust/handle_tests:fidl_rust_handle_tests_host_test",
        "//src/lib/fuchsia-emulated-handle:fuchsia-emulated-handle-shutdown-test",
        "//src/lib/fuchsia-emulated-handle:fuchsia-emulated-handle_test",
        "//src/lib/gcs/test:gcs_test_client_bin_test",
        "//src/lib/go-benchmarking:go_benchmarking_test",
        "//src/lib/inet:libinet_host_test",
        "//src/lib/intl/strings:lib_test",
        "//src/lib/json_parser:json_parser_unittests_host_test",
        "//src/lib/kprint:host_tests",
        "//src/lib/listnode:listnode_host_tests",
        "//src/lib/stdbind:stdbind-cpp-unittests",
        "//src/lib/stdbind:stdbind-rs_test",
        "//src/lib/test_diagnostics/rust:test_diagnostics_host_unittests",
        "//src/lib/testing/temp_test_env:lib_test",
        "//src/lib/transfer_manifest:transfer_manifest_test",
        "//src/lib/utf_conversion:host_tests",
        "//src/lib/zxc/tests:zxc_host_unittests",
    ],
)

