load("@fuchsia_rules_common//packages:resources.bzl", "resource")
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/fidl:fidl_library.bzl", "fidl_library")
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")
load("//build/bazel/rules/rust:defs.bzl", "rustc_library")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":fuchsia-fs-tests_test"],
    visibility = ["//src/lib:__pkg__"],
)

_COMMON_SRCS = [
    "src/directory.rs",
    "src/directory/watcher.rs",
    "src/file.rs",
    "src/file/async_read_at.rs",
    "src/file/async_read_at_ext.rs",
    "src/file/async_reader.rs",
    "src/file/buffered_async_read_at.rs",
    "src/lib.rs",
    "src/node.rs",
]

# @bazel2gn:transformer=deps
_COMMON_DEPS = [
    "//sdk/rust/zx-status",
    "//sdk/rust/zx-status-ext",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia-async",
    "//third_party/rust_crates/vendor:futures",
    "//third_party/rust_crates/vendor:pin-project",
    "//third_party/rust_crates/vendor:rand",
    "//third_party/rust_crates/vendor:static_assertions",
    "//third_party/rust_crates/vendor:thiserror",
    "//third_party/rust_crates/vendor:zerocopy",
]

# @bazel2gn:transformer=deps
_COMMON_TEST_DEPS = [
    ":fidl.test.schema_rust",
    "//src/lib/fuchsia",
    "//src/storage/lib/vfs/rust:vfs",
    "//third_party/rust_crates/vendor:assert_matches",
    "//third_party/rust_crates/vendor:proptest",
    "//third_party/rust_crates/vendor:tempfile",
]

rustc_library(
    name = "fuchsia-fs",
    srcs = _COMMON_SRCS,
    crate_features = select({
        "@platforms//os:fuchsia": [],
        "//conditions:default": ["fdomain"],
    }),
    crate_name = "fuchsia_fs",
    edition = "2024",
    test_deps = _COMMON_TEST_DEPS,
    visibility = ["//:__subpackages__"],
    with_unit_tests = True,
    deps = _COMMON_DEPS + select({
        "@platforms//os:fuchsia": [
            "//sdk/fidl/fuchsia.io:fuchsia.io_rust_flex",
            "//sdk/rust/zx",
            "//src/lib/fdio/rust:fdio",
            "//src/lib/fdomain/client:flex_fidl",
        ],
        "//conditions:default": [
            "//sdk/fidl/fuchsia.io:fuchsia.io_rust_fdomain_flex",
            "//src/lib/fdomain/client:flex_fdomain",
        ],
    }),
)

rustc_library(
    name = "fuchsia-fs_fdomain",
    srcs = _COMMON_SRCS,
    crate_features = ["fdomain"],
    crate_name = "fuchsia_fs_fdomain",
    edition = "2024",
    test_deps = _COMMON_TEST_DEPS,
    visibility = ["//:__subpackages__"],
    with_unit_tests = True,
    deps = _COMMON_DEPS + [
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust_fdomain_flex",
        "//src/lib/fdomain/client:flex_fdomain",
    ],
)

fidl_library(
    name = "fidl.test.schema",
    testonly = True,
    srcs = ["data/schema.test.fidl"],
)

resource(
    name = "file_resource",
    src = "data/file",
    dest = "data/file",
)

resource(
    name = "fidl_file_resource",
    src = "data/fidl_file",
    dest = "data/fidl_file",
)

resource(
    name = "subdir_file_resource",
    src = "data/file",
    dest = "data/subdir/subdir-file",
)

fx_packaged_binary(
    name = "fuchsia-fs_test_packaged_bin",
    testonly = True,
    binary = ":fuchsia-fs_test",
    binary_name = "fuchsia_fs_lib_test",
)

fx_component_manifest(
    name = "fuchsia-fs-tests_manifest",
    testonly = True,
    component_name = "fuchsia-fs-tests",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/fuchsia_fs_tests.cml",
)

fx_test_component(
    name = "fuchsia-fs-tests_component",
    compiled_manifest = ":fuchsia-fs-tests_manifest",
    deps = [":fuchsia-fs_test_packaged_bin"],
)

fx_package(
    name = "fuchsia-fs-tests",
    resources = [
        ":fidl_file_resource",
        ":file_resource",
        ":subdir_file_resource",
    ],
    test_components = [":fuchsia-fs-tests_component"],
)

fx_test(
    name = "fuchsia-fs-tests_test",
    package = ":fuchsia-fs-tests",
)
