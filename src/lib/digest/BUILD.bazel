load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")

package(default_applicable_licenses = ["//:license"])

fx_cc_library(
    name = "digest",
    srcs = [
        "digest.cc",
        "hash-list.cc",
        "merkle-tree.cc",
        "node-digest.cc",
    ],
    hdrs = [
        "digest.h",
        "hash-list.h",
        "merkle-tree.h",
        "node-digest.h",
    ],
    implementation_deps = [
        "//third_party/boringssl",
        "//zircon/third_party/ulib/safemath",
    ],
    visibility = [
        "//src/camera:__subpackages__",
        "//src/firmware:__subpackages__",
        "//src/lib/digest/test:__pkg__",
        "//src/media:__subpackages__",
        "//src/security:__subpackages__",
        "//src/storage:__subpackages__",
        "//zircon/tools/merkleroot:__pkg__",
    ],
    deps = [
        "//sdk/lib/stdcompat",
        "//zircon/system/public",
        "//zircon/system/ulib/fbl",
        "//zircon/system/ulib/zx",
    ],
)
