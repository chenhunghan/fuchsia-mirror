cc_test_executable("digest") {
  sources = [
    "digest.cc",
    "hash-list.cc",
    "merkle-tree.cc",
    "node-digest.cc",
  ]
  if (is_fuchsia) {
    configs -= [ "//build/config/fuchsia:fdio_config" ]
  } else {
    configs -= []
  }
  output_name = "digest-unit-tests"
  deps = [
    "//sdk/lib/fdio",
    "//src/lib/digest",
    "//src/lib/fxl/test:gtest_main",
    "//src/lib/testing/predicates",
    "//third_party/boringssl",
    "//third_party/googletest:gtest",
    "//zircon/system/ulib/fbl",
  ]
  testonly = true
  emit_tool_path = false
}

renamed_binary("digest_packaged") {
  testonly = true
  source = "$root_out_dir/digest-unit-tests"
  source_deps = [ ":digest" ]
  dest = "test/digest-unit-tests"
}

fuchsia_component_manifest("digest-unit-tests-manifest") {
  testonly = true
  component_name = "digest-unit-tests"
  manifest = "digest-unit-tests.cml"
}

fuchsia_test_component("digest-unit-tests-component") {
  cm_label = ":digest-unit-tests-manifest"
  deps = [ ":digest_packaged" ]
}

fuchsia_test_package("digest-unit-tests") {
  package_name = "digest-unit-tests-gn"
  test_components = [ ":digest-unit-tests-component" ]
}
