{
    include: [
        "inspect/client.shard.cml",
        "syslog/client.shard.cml",
    ],
    program: {
        runner: "elf",
        binary: "bin/echo_client_sc",
    },
    use: [
        { protocol: "fidl.examples.routing.echo.Echo" },
        {
            config: "fuchsia.config.EchoString",
            key: "echo_string",
            type: "string",
            max_size: 15,
            availability: "optional",
            default: "Hello Fuchsia!",
        },
        {
            config: "fuchsia.config.EchoStringVector",
            key: "echo_string_vector",
            type: "vector",
            max_count: 2,
            element: {
                type: "string",
                max_size: 10,
            },
            availability: "optional",
            default: [
                "Hi",
                "There",
            ],
        },
        {
            config: "fuchsia.config.EchoBool",
            key: "echo_bool",
            type: "bool",
            availability: "optional",
            default: false,
        },
        {
            config: "fuchsia.config.EchoNum",
            key: "echo_num",
            type: "uint64",
            availability: "optional",
            default: 100,
        },
    ],
    expose: [
        {
            protocol: "fuchsia.component.Binder",
            from: "framework",
        },
    ],
}
