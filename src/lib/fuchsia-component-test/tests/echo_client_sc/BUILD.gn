import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_binary("bin") {
  sources = [ "src/main.rs" ]
  output_name = "echo_client_sc"
  edition = "2024"
  deps = [
    ":config_lib",
    "//examples/components/routing/fidl:echo_rust",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
  ]
}

fuchsia_structured_config_rust_lib("config_lib") {
  cm_label = ":manifest"
}

fuchsia_component("component") {
  cm_label = ":manifest"
  visibility = [
    ":*",
    "//src/lib/fuchsia-component-test/tests:*",
  ]
  deps = [ ":bin" ]
}
