import("//build/components.gni")

# The Bazel build defines an equivalent `fx_component_manifest("manifest")`
# target, so that `:config_lib` and `:component` refer to the same label in
# both builds.
fuchsia_component_manifest("manifest") {
  component_name = "echo_client_sc"
  manifest = "meta/echo_client_sc.cml"
}

# TODO(https://fxbug.dev/543568916): Move to BUILD.bazel once
# `//src/lib/fuchsia-component-test/tests` is migrated to Bazel.
group("echo_client_sc") {
  deps = [ ":component" ]
}

