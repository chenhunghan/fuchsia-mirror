# Needs reviewer attention (bazel2gn skip): src/lib.rs and
# src/arbitrary_realm_test.rs hardcode absolute
# fuchsia-pkg://fuchsia.com/fuchsia-component-test-tests#meta/... URLs, which
# fail hermetic package resolution when bazel2gn renames the GN test package to
# fuchsia-component-test-tests-gn; TODO(https://fxbug.dev/570694755).
# @bazel2gn:skip
fx_package(
    name = "fuchsia-component-test-tests-gn",
    package_name = "fuchsia-component-test-tests",
    components = [
        ":child_realm_with_realmbuilder",
        ":component_manager_expose_dir_rights",
        ":echo_client_empty_component",
        ":echo_client_with_elf_runner",
        ":echo_realm_component",
        ":echo_server_empty_component",
        "//src/lib/fuchsia-component-test/realm_builder_server:realm_builder_server_component",
        "//src/lib/fuchsia-component-test/tests/collection_sc:component",
        "//src/lib/fuchsia-component-test/tests/echo_client_sc:component",
        "//src/sys/component_manager:component-manager-realm-builder-cmp",
        "//src/sys/component_manager/testing/echo_client",
        "//src/sys/component_manager/testing/echo_server",
        "//src/sys/component_manager/tests/rights:elf_runner_and_environment",
        "//src/sys/component_manager/tests/rights:expose_dir_rights",
    ],
    test_components = [
        ":arbitrary_realm_test_component",
        ":fuchsia_component_test_tests_component",
    ],
)

fx_test(
