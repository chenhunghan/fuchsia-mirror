rustc_test(
    name = "fuchsia_component_test_tests_bin",
    srcs = ["src/lib.rs"],
    edition = "2024",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//examples/components/routing/fidl:echo_rust",
        "//examples/components/services/fidl:fuchsia.examples.services_rust",
        "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust",
        "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
        "//sdk/fidl/fuchsia.component.test:fuchsia.component.test_rust",
        "//sdk/fidl/fuchsia.data:fuchsia.data_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.process:fuchsia.process_rust",
        "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-component-test",
        "//src/lib/fuchsia-fs",
        "//src/sys/lib/cm_rust",
        "//src/sys/lib/cm_rust/testing",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:futures",
    ],
)

fx_packaged_binary(
    name = "fuchsia_component_test_tests_bin_packaged",
    testonly = True,
    binary = ":fuchsia_component_test_tests_bin",
    binary_name = "fuchsia_component_test_tests_bin",
)

fx_component_manifest(
    name = "fuchsia_component_test_tests_manifest",
    testonly = True,
    component_name = "fuchsia-component-test-tests",
    includes = [
        "//sdk/lib/sys/component:realm_builder.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/lib/fuchsia-component-test:meta/nested_component_manager.shard",
