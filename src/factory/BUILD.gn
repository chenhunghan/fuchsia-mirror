import("//build/bazel/bazel_test_suite.gni")

group("factory") {
  deps = [ "factory_store_providers" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    "factory_store_providers:tests",
    "fake_factory_items:tests",
    "fake_factory_store_providers:tests",
  ]
}

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/factory:target_tests" ]
}
