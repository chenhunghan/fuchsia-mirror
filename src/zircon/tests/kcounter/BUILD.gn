import("//build/dist/renamed_binary.gni")
import("//build/rust/rustc_test.gni")
import("//build/testing/bootfs_test.gni")

rustc_test("kcounter_test") {
  visibility = [ ":*" ]
  edition = "2024"
  configs += [ "//build/config/rust:bootfs" ]
  source_root = "kcounter_test.rs"
  sources = [ "kcounter_test.rs" ]
  deps = [
    "//sdk/rust/zx",
    "//src/lib/fdio/rust:fdio",
    "//src/zircon/bin/kcounter/lib:kcounter-lib",
    "//third_party/rust_crates:zerocopy",
    "//zircon/kernel/lib/counters/abi:counters-abi",
  ]
}

# Installs the test binary as /boot/test/kcounter for bootfs_test() rather
# than at the default bin/kcounter_test that rustc_test() would use.
renamed_binary("kcounter") {
  testonly = true
  source = "$root_out_dir/kcounter_test"
  source_deps = [ ":kcounter_test" ]
  dest = "test/kcounter"
}

bootfs_test("kcounter-bootfs-test") {
  name = "kcounter"
  deps = [ ":kcounter" ]
}
