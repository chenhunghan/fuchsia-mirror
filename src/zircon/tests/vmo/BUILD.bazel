load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

# @bazel2gn:skip
test_suite(
    name = "tests",
    tests = [":vmo-test-pkg"],
    visibility = ["//src/zircon:__pkg__"],
)

fx_cc_test_binary(
    name = "vmo",
    srcs = [
        "bench.cc",
        "bench.h",
        "vmo.cc",
    ],
    gn_output_name = "vmo-test",
    deps = [
        "//sdk/lib/fdio",
        "//zircon/system/ulib/fbl",
        "//zircon/system/ulib/fzl",
        "//zircon/system/ulib/pretty",
        "//zircon/system/ulib/zx",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_package(
    name = "vmo-test-pkg",
    package_name = "vmo-test",
    unit_tests = [":vmo"],
)
