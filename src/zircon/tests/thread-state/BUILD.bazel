load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")

package(default_applicable_licenses = ["//:license"])

# GN bootfs_test("thread-state-bootfs-test") expects distribution_entries metadata to install to /boot/test/thread-state-test.
# @bazel2gn:raw_attribute:metadata = { distribution_entries = [ { source = rebase_path("$root_out_dir/thread-state-test", root_build_dir) destination = "test/thread-state-test" label = get_label_info(":thread-state", "label_with_toolchain") } ] }
fx_cc_test_binary(
    name = "thread-state",
    srcs = ["thread-state.cc"],
    gn_output_name = "thread-state-test",
    deps = [
        "//sdk/lib/fdio",
        "//zircon/system/ulib/fbl",
        "//zircon/system/ulib/test-utils",
        "//zircon/system/ulib/zx",
        "//zircon/system/ulib/zxtest",
    ],
)
