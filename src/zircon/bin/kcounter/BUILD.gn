import("//build/tools/bazel2gn/bazel_migration.gni")

if (is_fuchsia) {
  rustc_binary("kcounter") {
    sources = [ "src/main.rs" ]
    configs += [ "//build/config/rust:bootfs" ]
    edition = "2024"
    visibility = [ ":*" ]
    deps = [
      "//sdk/rust/zx",
      "//src/lib/fdio/rust:fdio",
      "//src/zircon/bin/kcounter/lib:kcounter-lib",
      "//third_party/rust_crates:libc",
      "//zircon/kernel/lib/counters/abi:counters-abi",
    ]
  }
}
