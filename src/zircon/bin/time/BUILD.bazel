load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)

package(default_applicable_licenses = ["//:license"])

fx_cc_binary(
    name = "bin",
    srcs = ["time.c"],
    tags = ["manual"],
    deps = [
        "//sdk/lib/fdio",
        "//src/zircon/lib/zircon",
    ],
)

fx_packaged_binary(
    name = "bin_packaged",
    binary = ":bin",
    binary_name = "time",
)

fx_package(
    name = "time",
    package_name = "time",
    resources = [":bin_packaged"],
)
