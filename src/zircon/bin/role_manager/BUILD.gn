# Kept in BUILD.gn because switching //bundles/assembly/BUILD.bazel directly to
# a native Bazel fx_package pulls //third_party/rapidjson:rapidjson, @re2, and
# @abseil-cpp//absl/... into release verify_licenses_collection before they
# carry applicable_licenses metadata.
fuchsia_package("package") {
  package_name = "role_manager"
  deps = [ ":role_manager" ]
}

group("tests") {
  testonly = true
  deps = [ "tests" ]
}

