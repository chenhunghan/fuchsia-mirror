import("//build/components.gni")

group("guest") {
  deps = [ ":guest_package" ]
}

group("tests") {
  testonly = true
  deps = [ ":guest_tests" ]
}

# Kept in GN because //src/virtualization/bin:bin and
# //src/virtualization/bundles:{debian,zircon} depend on :guest in GN.
fuchsia_package("guest_package") {
  package_name = "guest"
  deps = [ ":bin" ]
}

