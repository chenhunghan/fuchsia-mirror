import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_binary("bin") {
  sources = [ "src/main.rs" ]
  output_name = "guest"
  edition = "2024"
  deps = [
    "//src/lib/fuchsia",
    "//src/virtualization/lib/cli:guest_cli",
    "//src/virtualization/lib/cli/args:guest_cli_args",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
  ]
}
if (is_fuchsia) {
  rustc_test("bin_test") {
    sources = [ "src/main.rs" ]
    edition = "2024"
    deps = [
      "//src/lib/fuchsia",
      "//src/virtualization/lib/cli:guest_cli",
      "//src/virtualization/lib/cli/args:guest_cli_args",
      "//third_party/rust_crates:anyhow",
      "//third_party/rust_crates:argh",
    ]
    source_root = "src/main.rs"
    output_name = "guest_bin_test"
  }
}

fuchsia_unittest_package("guest_tests") {
  package_name = "guest_tests-gn"
  component_name = "guest_tests"
  deps = [ ":bin_test" ]
}
