fuchsia_unittest_package("virtio_net_unittests") {
  package_name = "virtio_net_unittests-gn"
  component_name = "virtio_net_unittests"
  deps = [ ":virtio_net_bin_test" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}

fuchsia_component_manifest("virtio_net_manifest") {
  component_name = "virtio_net"
  manifest = "meta/virtio_net.cml"
}

fuchsia_component("virtio_net_component") {
  cm_label = ":virtio_net_manifest"
  visibility = [
    ":*",
    "//src/virtualization/bin/vmm/device/*",
  ]
  deps = [ ":virtio_net_bin" ]
}

