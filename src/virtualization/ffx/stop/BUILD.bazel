load("//src/developer/ffx/build:ffx_plugin.bzl", "ffx_plugin")

package(default_applicable_licenses = ["//:license"])

ffx_plugin(
    name = "ffx_guest_stop",
    srcs = ["src/lib.rs"],
    args_deps = [
        "//src/developer/ffx/core:lib",
        "//src/virtualization/lib/cli/args:guest_cli_args",
        "//third_party/rust_crates/vendor:argh",
    ],
    args_srcs = ["src/args.rs"],
    edition = "2024",
    version = "0.1.0",
    visibility = ["//src/virtualization/ffx:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.developer.remotecontrol:fuchsia.developer.remotecontrol_rust",
        "//src/developer/ffx/lib/fho:lib",
        "//src/virtualization/lib/cli:guest_cli",
    ],
)
