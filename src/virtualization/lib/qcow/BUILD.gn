rustc_library("qcow") {
  sources = [
    "src/lib.rs",
    "src/wire.rs",
  ]
  edition = "2024"
  visibility = [
    ":*",
    "//src/virtualization/bin/vmm/device/virtio_block:*",
  ]
  deps = [
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:zerocopy",
  ]
}

rustc_test("qcow_test") {
  sources = [
    "src/lib.rs",
    "src/wire.rs",
  ]
  edition = "2024"
  deps = [
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:zerocopy",
  ]
}
