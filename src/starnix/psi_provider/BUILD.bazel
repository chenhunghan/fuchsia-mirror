load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load(
    "//build/bazel/rules/testing:fx_unittest_package.bzl",
    "fx_unittest_package",
)

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "psi_provider-bin",
    srcs = [
        "src/history.rs",
        "src/main.rs",
    ],
    edition = "2024",
    lint_config = "//src/starnix/config:starnix_clippy_lints",
    deps = [
        "//sdk/fidl/fuchsia.kernel:fuchsia.kernel_rust",
        "//sdk/fidl/fuchsia.starnix.psi:fuchsia.starnix.psi_rust",
        "//sdk/rust/zx",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/starnix/lib/starnix_sync",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

rustc_test(
    name = "psi_provider-bin_test",
    crate = ":psi_provider-bin",
    # Preserves the GN binary `output_name` for `psi_provider-bin_test`.
    crate_name = "psi_provider-bin_bin_test",
    lint_config = "//src/starnix/config:starnix_clippy_lints_test",
    deps = ["//src/lib/fuchsia-sync"],
)

fx_packaged_binary(
    name = "psi_provider_packaged_bin",
    binary = ":psi_provider-bin",
    binary_name = "psi_provider-bin",
)

fx_component_manifest(
    name = "psi_provider-manifest",
    component_name = "psi_provider",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/psi_provider.cml",
)

fx_component(
    name = "psi_provider",
    compiled_manifest = ":psi_provider-manifest",
    deps = [":psi_provider_packaged_bin"],
)

fx_unittest_package(
    name = "psi_provider-tests",
    unit_tests = [":psi_provider-bin_test"],
    visibility = ["//src/starnix:__pkg__"],
)
