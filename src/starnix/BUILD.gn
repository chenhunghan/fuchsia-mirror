import("//build/bazel/bazel_test_suite.gni")

group("starnix") {
  deps = [
    "containers",
    "examples",
    "kernel",
    "lib",
    "runner",
    "tools",
  ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    "containers:tests",
    "examples:tests",
    "fakes",
    "kernel:tests",
    "lib:tests",
    "modules:tests",
    "psi_provider:tests",
    "runner:tests",
    "tests",
    "tools:tests",
  ]
}

bazel_test_suite("bazel_tests") {
  host_tests = [ "//src/starnix:host_tests" ]
  target_tests = [ "//src/starnix:target_tests" ]
}

group("benchmarks") {
  testonly = true
  deps = [
    "lib:benchmarks",
    "tests:benchmarks",
  ]
}
