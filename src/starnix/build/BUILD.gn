import("//build/tools/bazel2gn/bazel_migration.gni")

if (is_host) {
  python_binary("generate_container_config_component") {
    sources = [ "generate_container_config_component.py" ]
    main_source = "generate_container_config_component.py"
    visibility = [
      ":*",
      "//src/starnix/tests/gvisor:*",
      "//src/starnix/tests/remotevol/*",
      "//src/starnix/tests/syscalls/cpp:*",
      "//src/storage/fshost/integration:*",
      "//src/storage/fshost/testing:*",
      "//vendor/google/*",
    ]
    deps = [ "//third_party/pyjson5" ]
    enable_mypy = false
  }
}
if (is_host) {
  python_binary("generate_container_config_shard") {
    sources = [ "generate_container_config_shard.py" ]
    main_source = "generate_container_config_shard.py"
    visibility = [
      ":*",
      "//src/starnix/tests/gvisor:*",
      "//src/starnix/tests/remotevol/*",
      "//src/starnix/tests/syscalls/cpp:*",
      "//vendor/google/*",
    ]
    deps = [ "//third_party/pyjson5" ]
    enable_mypy = false
  }
}
