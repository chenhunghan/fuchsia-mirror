import("//build/python/python_binary.gni")

# TODO(https://fxbug.dev/570694755): Maintained above the sentinel for GN
# Starnix callers because bazel2gn does not generate GN config() targets.
# Add this config to any libraries that are only used by the Starnix kernel
# binary.
config("kernel_library_config") {
  configs = [ "//src/starnix/config:starnix_clippy_lints" ]

  # Enable moderate level of optimization for better performance.
  if (compilation_mode == "release") {
    configs += [ "//build/config:optimize_moderate" ]
  }
}

