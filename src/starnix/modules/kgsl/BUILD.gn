import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("kgsl") {
  sources = [
    "file.rs",
    "init.rs",
    "lib.rs",
    "util.rs",
  ]
  features = []
  if (starnix_kgsl_enable) {
    features += [ "starnix-kgsl-enable" ]
  }
  if (starnix_kgsl_debug) {
    features += [ "starnix-kgsl-debug" ]
  }
  crate_name = "starnix_modules_kgsl"
  source_root = "lib.rs"
  edition = "2024"
  lint_config = "//src/starnix/build:kernel_library_config"
  visibility = [
    ":*",
    "//src/starnix/modules/*",
  ]
  deps = [
    "//sdk/rust/zx",
    "//src/lib/fdio/rust:fdio",
    "//src/starnix/kernel/core",
    "//src/starnix/lib/magma",
    "//src/starnix/lib/starnix_logging",
    "//src/starnix/lib/starnix_sync",
    "//src/starnix/lib/starnix_syscalls",
    "//src/starnix/lib/starnix_uapi",
    "//src/starnix/modules/kgsl/libmagma",
    "//src/starnix/modules/kgsl/magma_params",
    "//src/starnix/modules/kgsl/strings:kgsl_strings",
    "//third_party/rust_crates:bitfield",
    "//third_party/rust_crates:range-alloc",
  ]
  deps += [ "//src/starnix/modules/kgsl/uapi_manual" ]
}
if (is_fuchsia) {
  rustc_test("kgsl_test") {
    sources = [
      "file.rs",
      "init.rs",
      "lib.rs",
      "util.rs",
    ]
    source_root = "lib.rs"
    edition = "2024"
    deps = [
      "//sdk/rust/zx",
      "//src/lib/fdio/rust:fdio",
      "//src/starnix/kernel/core",
      "//src/starnix/lib/magma",
      "//src/starnix/lib/starnix_logging",
      "//src/starnix/lib/starnix_sync",
      "//src/starnix/lib/starnix_syscalls",
      "//src/starnix/lib/starnix_uapi",
      "//src/starnix/modules/kgsl/libmagma",
      "//src/starnix/modules/kgsl/magma_params",
      "//src/starnix/modules/kgsl/strings:kgsl_strings",
      "//third_party/rust_crates:bitfield",
      "//third_party/rust_crates:range-alloc",
    ]
    deps += [ "//src/starnix/modules/kgsl/uapi_manual" ]
    features = []
    if (starnix_kgsl_enable) {
      features += [ "starnix-kgsl-enable" ]
    }
    if (starnix_kgsl_debug) {
      features += [ "starnix-kgsl-debug" ]
    }
    lint_config = "//src/starnix/config:starnix_clippy_lints_test"
  }
}

fuchsia_unittest_component("kgsl-tests-component") {
  deps = [ ":kgsl_test" ]
  component_name = "kgsl-tests"
  test_type = "starnix"
}

fuchsia_test_package("kgsl-tests-package") {
  package_name = "kgsl-tests-gn"
  test_components = [ ":kgsl-tests-component" ]
}
