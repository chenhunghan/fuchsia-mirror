import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("boot") {
  sources = [ "lib.rs" ]
  crate_name = "starnix_modules_boot"
  source_root = "lib.rs"
  edition = "2024"
  lint_config = "//src/starnix/build:kernel_library_config"
  visibility = [
    ":*",
    "//src/starnix/modules/*",
  ]
  deps = [
    "//sdk/fidl/fuchsia.power.cpu.manager:fuchsia.power.cpu.manager_rust",
    "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust",
    "//sdk/rust/zx",
    "//src/lib/diagnostics/inspect/rust",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/starnix/kernel/core",
    "//src/starnix/lib/starnix_logging",
    "//src/starnix/lib/starnix_sync",
    "//src/starnix/lib/starnix_uapi",
    "//third_party/rust_crates:anyhow",
  ]
}

rustc_test("boot_test") {
  sources = [ "lib.rs" ]
  source_root = "lib.rs"
  edition = "2024"
  deps = [
           "//sdk/fidl/fuchsia.power.cpu.manager:fuchsia.power.cpu.manager_rust",
           "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust",
           "//sdk/rust/zx",
           "//src/lib/diagnostics/inspect/rust",
           "//src/lib/fuchsia-async",
           "//src/lib/fuchsia-component",
           "//src/starnix/kernel/core",
           "//src/starnix/lib/starnix_logging",
           "//src/starnix/lib/starnix_sync",
           "//src/starnix/lib/starnix_uapi",
           "//third_party/rust_crates:anyhow",
         ] + [
           "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
           "//src/lib/fuchsia",
         ]
  output_name = "starnix_modules_boot_lib_test"
  lint_config = "//src/starnix/config:starnix_clippy_lints_test"
  exclude_toolchain_tags = [
    "asan",
    "hwasan",
  ]
}

fuchsia_component_manifest("starnix-boot-tests-manifest") {
  testonly = true
  component_name = "starnix-boot-tests"
  manifest = "meta/starnix_boot_tests.cml"
}

fuchsia_test_component("starnix-boot-tests-component") {
  cm_label = ":starnix-boot-tests-manifest"
  test_type = "starnix"
  deps = [
    ":boot_test",
    "//src/starnix/kernel/vdso",
  ]
}

fuchsia_test_package("starnix-boot-tests-package") {
  package_name = "starnix-boot-tests-gn"
  test_components = [ ":starnix-boot-tests-component" ]
}
