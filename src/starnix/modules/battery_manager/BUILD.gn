import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("battery_manager") {
  sources = [ "lib.rs" ]
  crate_name = "starnix_modules_battery_manager"
  source_root = "lib.rs"
  edition = "2024"
  lint_config = "//src/starnix/build:kernel_library_config"
  visibility = [
    ":*",
    "//src/starnix/modules/*",
  ]
  deps = [
    "//sdk/fidl/fuchsia.power.battery:fuchsia.power.battery_rust",
    "//sdk/fidl/fuchsia.power.battery.test:fuchsia.power.battery.test_rust",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia-component",
    "//src/starnix/kernel/core",
    "//src/starnix/lib/starnix_logging",
    "//src/starnix/lib/starnix_sync",
    "//src/starnix/lib/starnix_uapi",
    "//third_party/rust_crates:futures",
  ]
}

rustc_test("battery_manager_test") {
  sources = [ "lib.rs" ]
  source_root = "lib.rs"
  edition = "2024"
  deps =
      [
        "//sdk/fidl/fuchsia.power.battery:fuchsia.power.battery_rust",
        "//sdk/fidl/fuchsia.power.battery.test:fuchsia.power.battery.test_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-component",
        "//src/starnix/kernel/core",
        "//src/starnix/lib/starnix_logging",
        "//src/starnix/lib/starnix_sync",
        "//src/starnix/lib/starnix_uapi",
        "//third_party/rust_crates:futures",
      ] +
      [
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
      ]
  output_name = "starnix_modules_battery_manager_lib_test"
  lint_config = "//src/starnix/config:starnix_clippy_lints_test"
  exclude_toolchain_tags = [
    "asan",
    "hwasan",
  ]
}

fuchsia_component_manifest("starnix-battery-manager-tests-manifest") {
  testonly = true
  component_name = "starnix-battery-manager-tests"
  manifest = "meta/starnix_battery_manager_tests.cml"
}

fuchsia_test_component("starnix-battery-manager-tests-component") {
  cm_label = ":starnix-battery-manager-tests-manifest"
  test_type = "starnix"
  deps = [
    ":battery_manager_test",
    "//src/starnix/kernel/vdso",
  ]
}

fuchsia_test_package("starnix-battery-manager-tests-package") {
  package_name = "starnix-battery-manager-tests-gn"
  test_components = [ ":starnix-battery-manager-tests-component" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
