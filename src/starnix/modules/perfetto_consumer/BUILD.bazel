load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":perfetto_consumer_tests"],
    visibility = ["//src/starnix:__pkg__"],
)

rustc_library(
    name = "perfetto_consumer",
    srcs = [
        "atrace.rs",
        "blob_sink.rs",
        "lib.rs",
        "packet_forwarder.rs",
        "testing.rs",
    ],
    crate_name = "starnix_modules_perfetto_consumer",
    crate_root = "lib.rs",
    edition = "2024",
    lint_config = "//src/starnix/build:kernel_library_config",
    visibility = ["//src/starnix/modules:__pkg__"],
    deps = [
        "//sdk/rust/zx",
        "//src/lib/trace/rust:trace",
        "//src/lib/trace/rust:trace-observer",
        "//src/performance/lib/fxt/rust",
        "//src/starnix/kernel/core",
        "//src/starnix/lib/starnix_logging",
        "//src/starnix/lib/starnix_uapi",
        "//src/starnix/modules/perfetto_consumer/lib/perfetto",
        "//src/starnix/modules/perfetto_consumer/lib/perfetto:perfetto_protos",
        "//src/starnix/modules/perfetto_consumer/lib/perfetto:perfetto_trace_protos",
        "//src/starnix/modules/perfetto_consumer/lib/perfetto/trace_decoder",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
    ],
)

rustc_test(
    name = "perfetto_consumer_test",
    crate = ":perfetto_consumer",
    # Matches program.binary in meta/perfetto_consumer_tests.cml for the GN copy.
    crate_name = "starnix_modules_perfetto_consumer_lib_test",
    link_deps = ["//zircon/system/ulib/trace-test-utils"],
    lint_config = "//src/starnix/config:starnix_clippy_lints_test",
    # TODO(https://fxbug.dev/42059075): Re-enable starnix in these environments.
    tags = [
        "exclude_toolchain_tags=asan",
        "exclude_toolchain_tags=hwasan",
        "manual",
    ],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = ["//src/lib/fuchsia"],
)

fx_packaged_binary(
    name = "perfetto_consumer_test_packaged_bin",
    testonly = True,
    binary = ":perfetto_consumer_test",
    binary_name = "starnix_modules_perfetto_consumer_lib_test",
)

fx_component_manifest(
    name = "perfetto_consumer_tests_manifest",
    testonly = True,
    component_name = "perfetto_consumer_tests",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/starnix:unit_test.shard.cml",
    ],
    manifest = "meta/perfetto_consumer_tests.cml",
)

fx_test_component(
    name = "perfetto_consumer_tests_component",
    compiled_manifest = ":perfetto_consumer_tests_manifest",
    test_type = "starnix",
    deps = [
        ":perfetto_consumer_test_packaged_bin",
        # In GN, //src/starnix/kernel/vdso is a resource() propagated through
        # //src/starnix/kernel/core's deps.
        "//src/starnix/kernel/vdso",
    ],
)

fx_package(
    name = "perfetto_consumer_tests_package",
    package_name = "perfetto_consumer_tests",
    test_components = [":perfetto_consumer_tests_component"],
)

fx_test(
    name = "perfetto_consumer_tests",
    # TODO(https://fxbug.dev/42059075): Re-enable starnix in these environments.
    # Bazel ignores exclude_toolchain_tags on the GN binary, so mark the Bazel
    # test build_only under asan and hwasan variants.
    # @bazel2gn:skip
    build_only = select({
        "//build/bazel/config/variant_features/asan:true": True,
        "//build/bazel/config/variant_features/hwasan:true": True,
        "//conditions:default": False,
    }),
    package = ":perfetto_consumer_tests_package",
)
