import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("usbfs") {
  sources = [
    "device.rs",
    "lib.rs",
    "sysfs.rs",
  ]
  crate_name = "starnix_modules_usbfs"
  source_root = "lib.rs"
  edition = "2024"
  lint_config = "//src/starnix/build:kernel_library_config"
  visibility = [
    ":*",
    "//src/starnix/modules/*",
  ]
  deps = [
    "//sdk/fidl/fuchsia.hardware.usb:fuchsia.hardware.usb_rust",
    "//sdk/fidl/fuchsia.hardware.usb.descriptor:fuchsia.hardware.usb.descriptor_rust",
    "//sdk/fidl/fuchsia.hardware.usb.endpoint:fuchsia.hardware.usb.endpoint_rust",
    "//sdk/fidl/fuchsia.hardware.usb.request:fuchsia.hardware.usb.request_rust",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia-component",
    "//src/starnix/kernel/core",
    "//src/starnix/lib/starnix_logging",
    "//src/starnix/lib/starnix_sync",
    "//src/starnix/lib/starnix_syscalls",
    "//src/starnix/lib/starnix_uapi",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:zerocopy",
  ]
  with_unit_tests = true
  exclude_toolchain_tags = [
    "asan",
    "hwasan",
  ]
  test_deps = [
    "//sdk/fidl/fuchsia.driver.test:fuchsia.driver.test_rust",
    "//sdk/fidl/fuchsia.hardware.usb.peripheral:fuchsia.hardware.usb.peripheral_rust",
    "//sdk/fidl/fuchsia.hardware.usb.virtual.bus:fuchsia.hardware.usb.virtual.bus_rust",
    "//sdk/lib/device-watcher/rust",
    "//sdk/lib/driver_test_realm/realm_builder/rust",
    "//src/devices/usb/drivers/usb-virtual-bus/tests:fuchsia.hardware.usb.virtualbustest_rust",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component-test",
  ]
}
