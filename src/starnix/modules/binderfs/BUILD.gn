import("//build/bazel/bazel_test_suite.gni")
import("//build/components.gni")

bazel_test_suite("bazel_tests") {
  target_tests = [ "//src/starnix/modules/binderfs:starnix-binderfs-tests" ]
}

group("tests") {
  testonly = true
  deps = [ ":starnix-binderfs-tests" ]

  # TODO(https://fxbug.dev/42059075): Re-enable starnix in these environments.
  # The GN copy's test binary is excluded from asan/hwasan variants with
  # exclude_toolchain_tags, which Bazel ignores.
  if (!is_asan) {
    deps += [ ":bazel_tests" ]
  }
}

# Hand-maintained because bazel2gn does not support create_no_exception_channel
# on fx_test.
fuchsia_unittest_package("starnix-binderfs-tests") {
  package_name = "starnix-binderfs-tests-gn"
  component_name = "starnix-binderfs-tests"
  manifest = "meta/starnix_binderfs_tests.cml"
  deps = [ ":binderfs_test" ]
  test_specs = {
    log_settings = {
      # Tests exercise failure cases, so ERROR logs are expected.
      max_severity = "ERROR"
    }
    create_no_exception_channel = true
  }
  test_type = "starnix"
}

