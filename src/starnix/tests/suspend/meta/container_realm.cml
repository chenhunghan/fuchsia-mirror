{
    include: [
        "inspect/offer.shard.cml",
        "syslog/offer.shard.cml",
        "trace/offer.shard.cml",
    ],
    children: [
        {
            name: "runner",
            url: "starnix#meta/starnix_runner.cm",
        },
        {
            name: "debian_container",
            url: "debian#meta/debian_container.cm",
            environment: "#starnix_runner_env",
        },
    ],
    collections: [
        {
            name: "puppets",
            environment: "#debian_container_env",
            durability: "single_run",
        },
    ],
    offer: [
        {
            protocol: [
                "fuchsia.buildinfo.Provider",
                "fuchsia.kernel.Stats",
                "fuchsia.kernel.VmexResource",
                "fuchsia.sysinfo.SysInfo",
            ],
            from: "parent",
            to: "#runner",
        },
        {
            directory: "boot-kernel",
            from: "parent",
            to: "#runner",
        },
    ],
    expose: [
        {
            protocol: "fuchsia.component.Realm",
            from: "framework",
        },
        {
            protocol: "fuchsia.starnix.runner.Manager",
            from: "#runner",
        },
    ],
    environments: [
        {
            name: "starnix_runner_env",
            extends: "realm",
            runners: [
                {
                    runner: "starnix",
                    from: "#runner",
                },
            ],
        },
        {
            name: "debian_container_env",
            extends: "realm",
            runners: [
                {
                    runner: "starnix_container",
                    from: "#debian_container",
                },
            ],
        },
    ],
}
