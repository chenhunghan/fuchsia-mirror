import("//build/components.gni")
import("//build/rust/rustc_binary.gni")
import("//build/rust/rustc_test.gni")
import("//src/starnix/tests/build/starnix_linux_test_component.gni")
import("//src/starnix/tests/starnix_test_subpackages.gni")

group("tests") {
  testonly = true
  deps = [ ":starnix_battery_manager_integration_test" ]
}

rustc_binary("fake_battery_bin") {
  testonly = true
  edition = "2024"
  output_name = "fake_battery"
  source_root = "src/fake_battery.rs"
  sources = [ "src/fake_battery.rs" ]
  deps = [
    "//sdk/fidl/fuchsia.hardware.power.battery:fuchsia.hardware.power.battery_rust",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
  ]
}

fuchsia_component("fake_battery") {
  testonly = true
  manifest = "meta/fake_battery.cml"
  deps = [ ":fake_battery_bin" ]
}

fuchsia_component("battery_manager_container") {
  testonly = true
  manifest = "meta/battery_manager_container.cml"
}

rustc_test("battery_manager_test_bin") {
  edition = "2024"
  source_root = "src/battery_manager_test.rs"
  sources = [ "src/battery_manager_test.rs" ]
}

starnix_linux_test_component("battery_manager_test_component") {
  test_label = ":battery_manager_test_bin"
  test_binary = "battery_manager_test_bin"
  manifest = "meta/battery_manager_test.cml"
  test_type = "starnix"
}

fuchsia_test_package("starnix_battery_manager_integration_test") {
  test_components = [ ":battery_manager_test_component" ]
  deps = [
    ":battery_manager_container",
    ":fake_battery",
    "//src/starnix/containers/debian:container_resources",
  ]
  subpackages = starnix_test_subpackages +
                [ "//src/power/battery-manager:battery-manager" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
