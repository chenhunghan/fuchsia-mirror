// Serves a fake devicetree boot item to the Starnix kernel for sysfs_kernel_test.
{
    children: [
        {
            name: "fake_boot_items",
            url: "#meta/fake_boot_items.cm",
        },
    ],
    offer: [
        {
            protocol: "fuchsia.boot.Items",
            from: "#fake_boot_items",
            to: "#kernel",
        },
    ],
}
