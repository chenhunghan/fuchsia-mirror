// Serves a fake USB device to the Starnix kernel for usb_test.
{
    children: [
        {
            name: "fake_usb_device",
            url: "#meta/fake_usb_device.cm",
        },
    ],
    offer: [
        {
            service: "fuchsia.hardware.usb.UsbService",
            from: "#fake_usb_device",
            to: "#kernel",
        },
    ],
}
