import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_test("bin") {
  sources = [ "src/lib.rs" ]
  output_name = "starnix_fp_stack_glue_test"
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.buildinfo:fuchsia.buildinfo_rust",
    "//sdk/fidl/fuchsia.component.runner:fuchsia.component.runner_rust",
    "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-component-test",
    "//src/lib/fuchsia-runtime",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
}
if (is_linux && !is_host) {
  rustc_binary("print_uname_bin_bin") {
    testonly = true
    sources = [ "src/print_uname.rs" ]
    output_name = "print_uname_bin"
    source_root = "src/print_uname.rs"
    edition = "2024"
    exclude_toolchain_tags = [ "instrumented" ]
    deps = [ "//third_party/rust_crates:nix" ]
  }
}

linux_resource("print_uname_bin") {
  testonly = true
  src = ":print_uname_bin_bin"
  bin_output_name = "print_uname_bin"
  dest = "data/tests/print_uname_bin"
}
