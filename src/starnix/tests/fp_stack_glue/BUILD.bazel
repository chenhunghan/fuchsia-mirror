load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//src/starnix/containers:linux_resource.bzl", "linux_resource")

package(default_applicable_licenses = ["//:license"])

rustc_test(
    name = "bin",
    srcs = ["src/lib.rs"],
    crate_name = "starnix_fp_stack_glue_test",
    edition = "2024",
    deps = [
        "//sdk/fidl/fuchsia.buildinfo:fuchsia.buildinfo_rust",
        "//sdk/fidl/fuchsia.component.runner:fuchsia.component.runner_rust",
        "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        # GN depends on the fuchsia-component-test group; Bazel depends on the library directly.
        "//src/lib/fuchsia-component-test:fuchsia-component-test-lib",  # @bazel2gn:path_overwrite://src/lib/fuchsia-component-test
        "//src/lib/fuchsia-runtime",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

rustc_binary(
    name = "print_uname_bin_bin",
    testonly = True,
    srcs = ["src/print_uname.rs"],
    crate_name = "print_uname_bin",
    crate_root = "src/print_uname.rs",
    edition = "2024",
    tags = [
        "exclude_toolchain_tags=instrumented",
        "manual",
    ],
    deps = ["//third_party/rust_crates/vendor:nix"],
)

linux_resource(
    name = "print_uname_bin",
    testonly = True,
    src = ":print_uname_bin_bin",
    dest = "data/tests/print_uname_bin",
)
