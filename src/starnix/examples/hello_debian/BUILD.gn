group("hello_debian") {
  deps = [
    "cpp",
    "rust",
  ]

  # asm is only needed for compat testing
  # and compat is only supported on arm64.
  if (current_cpu == "arm64") {
    deps += [ "asm" ]
  }
}

group("tests") {
  testonly = true
  deps = [
    "cpp:tests",
    "rust:tests",
  ]
  if (current_cpu == "arm64") {
    deps += [ "asm:tests" ]
  }
}

