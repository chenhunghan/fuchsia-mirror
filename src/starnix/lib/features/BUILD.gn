rustc_library("starnix_features") {
  sources = [ "src/lib.rs" ]
  edition = "2024"
  lint_config = "//src/starnix/build:kernel_library_config"
  proc_macro_deps = [ "//third_party/rust_crates:strum_macros" ]
  visibility = [
    ":*",
    "//src/lib/assembly/platform_configuration:*",
    "//src/starnix/kernel/runner:*",
  ]
  deps = [
    "//third_party/rust_crates:strum",
    "//third_party/rust_crates:thiserror",
  ]
}

rustc_test("starnix_features_test") {
  sources = [ "src/lib.rs" ]
  edition = "2024"
  proc_macro_deps = [ "//third_party/rust_crates:strum_macros" ]
  deps = [
    "//third_party/rust_crates:strum",
    "//third_party/rust_crates:thiserror",
  ]
}

fuchsia_unittest_package("starnix_features-tests") {
  package_name = "starnix_features-tests-gn"
  component_name = "starnix_features-tests"
  deps = [ ":starnix_features_test" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
