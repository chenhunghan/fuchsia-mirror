rustc_library("range_map") {
  sources = [ "src/lib.rs" ]
  edition = "2024"
  lint_config = "//src/starnix/build:kernel_library_config"
  visibility = [
    ":*",
    "//src/starnix/kernel/core:*",
    "//src/starnix/lib/starnix_uapi:*",
    "//src/starnix/modules/ashmem:*",
  ]
  deps = [ "//third_party/rust_crates:arrayvec" ]
}

rustc_test("starnix_range_map_test") {
  sources = [ "src/lib.rs" ]
  edition = "2024"
  deps = [ "//third_party/rust_crates:arrayvec" ] + [ "//src/lib/fuchsia" ]
  lint_config = "//src/starnix/build:kernel_library_config"
}

fuchsia_unittest_component("unittests_component") {
  deps = [ ":starnix_range_map_test" ]
  component_name = "range_map_unittests"
}

fuchsia_test_package("starnix_range_map_unittests") {
  package_name = "starnix_range_map_unittests-gn"
  test_components = [ ":unittests_component" ]
}
