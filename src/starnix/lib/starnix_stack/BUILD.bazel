load("//build/bazel/rules/rust:defs.bzl", "rustc_library")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "starnix_stack",
    srcs = ["src/lib.rs"],
    crate_name = "starnix_stack",
    edition = "2024",
    test_deps = ["//src/lib/fuchsia"],
    visibility = [
        "//src/starnix/lib:__pkg__",
        "//src/starnix/lib/starnix_sync:__pkg__",
    ],
    with_unit_tests = True,
    deps = [
        "//sdk/rust/zx",
        "//src/lib/fuchsia-runtime",
    ],
)

fx_unittest_package(
    name = "starnix_stack-unittests",
    unit_tests = [":starnix_stack_test"],
    visibility = ["//src/starnix/lib:__pkg__"],
)
