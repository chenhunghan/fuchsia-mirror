load("//build/bazel/rules/rust:defs.bzl", "rustc_library")
load(
    "//build/bazel/rules/testing:fx_unittest_package.bzl",
    "fx_unittest_package",
)

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":netlink_packet_utils_test_package"],
    visibility = ["//src/starnix/lib:__pkg__"],
)

rustc_library(
    name = "netlink_packet_utils",
    srcs = [
        "src/errors.rs",
        "src/lib.rs",
        "src/macros.rs",
        "src/nla.rs",
        "src/parsers.rs",
        "src/traits.rs",
    ],
    crate_name = "netlink_packet_utils",
    edition = "2024",
    proc_macro_deps = [
        "//third_party/rust_crates/vendor:paste",
    ],
    test_deps = [
        "//third_party/rust_crates/vendor:assert_matches",
    ],
    visibility = [
        "//src/connectivity/network/netlink:__subpackages__",
        "//src/connectivity/wlan/wlanix:__pkg__",
        "//src/starnix:__subpackages__",
    ],
    with_unit_tests = True,
    deps = [
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:byteorder",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

fx_unittest_package(
    name = "netlink_packet_utils_test_package",
    unit_tests = [":netlink_packet_utils_test"],
)
