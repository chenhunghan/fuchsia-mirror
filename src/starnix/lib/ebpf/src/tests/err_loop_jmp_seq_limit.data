# Backward jump loop of 5,000 iterations executes 10,000 jumps (> MAX_JMP_SEQ = 8,192) in
# 15,001 instructions (well below 10 * BPF_MAX_INSTS = 655,360), hitting the per-path jump
# sequence limit.
-- asm
mov %r0, 0
add %r0, 1
jeq %r0, 5000, +1
ja -3
exit
-- error
verification complexity limit exceeded
