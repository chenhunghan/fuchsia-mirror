load("//build/bazel/rules/rust:defs.bzl", "rustc_library")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "starnix_task_command",
    srcs = ["src/lib.rs"],
    crate_name = "starnix_task_command",
    edition = "2024",
    visibility = ["//src/starnix:__subpackages__"],
    with_unit_tests = True,
    deps = [
        "//src/lib/fuchsia-rcu",
        "//third_party/rust_crates/vendor:bstr",
        "//third_party/rust_crates/vendor:flyweights",
        "//third_party/rust_crates/vendor:memchr",
    ],
)

fx_unittest_package(
    name = "starnix_task_command_tests",
    unit_tests = [":starnix_task_command_test"],
    visibility = ["//src/starnix/lib:__pkg__"],
)
