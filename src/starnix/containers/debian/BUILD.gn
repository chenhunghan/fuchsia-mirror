import("//build/bazel/bazel_fuchsia_package.gni")
import("//src/storage/ext4/ext4_to_pkg.gni")

# LINT.IfChange
group("container_resources") {
  deps = [
    ":system_image",
    "//src/starnix/containers:data_tmp_target",
    "//src/starnix/containers:default_init",
  ]
}

ext4_to_pkg("system_image") {
  if (target_cpu == "x64") {
    input = "//prebuilt/starnix/linux-amd64/amd64_system.img"
  } else if (target_cpu == "arm64") {
    input = "//prebuilt/starnix/linux-arm64/arm64_system.img"
  } else if (target_cpu == "riscv64") {
    input = "//prebuilt/starnix/linux-riscv64/riscv64_system.img"
  } else {
    assert(false, "Unsupported CPU architecture.")
  }
  prefix = "data/system"
}

# LINT.ThenChange(BUILD.bazel)

# The package is defined as `fx_package` in BUILD.bazel. This GN wrapper stays
# above the sentinel while GN callers still subpackage `:debian_package` or
# depend on `:debian`.
# TODO(https://fxbug.dev/570694755): Remove once GN callers migrate.
bazel_fuchsia_package("debian_package") {
  bazel_config = "fuchsia_platform"
  package_name = "debian"

  # TODO(https://fxbug.dev/570694755): bazel_action pulls
  # sysroot_for_fuchsia_platform without link_output_barrier while
  # zxdb_e2e_symbols and dap_e2e_symbols walk zxdb_e2e_inferiors subpackages.
  metadata = {
    link_output_barrier = []
  }
}

