load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load(
    "//build/bazel/rules/testing:fx_unittest_package.bzl",
    "fx_unittest_package",
)

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [
        ":paver-core-tests",
    ],
    visibility = ["//src/firmware:__pkg__"],
)

rustc_library(
    name = "paver-core",
    srcs = [
        "src/abr.rs",
        "src/block.rs",
        "src/boot_manager.rs",
        "src/data_sink.rs",
        "src/lib.rs",
        "src/partition.rs",
        "src/partition_io.rs",
        "src/paver.rs",
        "src/sysconfig.rs",
    ],
    build_flags = [
        "//build/config/rust:bootfs",
    ],
    edition = "2024",
    proc_macro_deps = [
        "//third_party/rust_crates/vendor:async-trait",
    ],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust_next",
        "//sdk/fidl/fuchsia.mem:fuchsia.mem_rust_next",
        "//sdk/fidl/fuchsia.paver:fuchsia.paver_rust_next",
        "//sdk/fidl/fuchsia.process.lifecycle:fuchsia.process.lifecycle_rust_next",
        "//sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_rust",
        "//sdk/rust/zx",
        "//src/firmware/lib/zbi-rs",
        "//src/lib/fdio/rust:fdio",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fidl/rust_next/fidl_next",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-runtime",
        "//src/lib/mapped-vmo",
        "//src/storage/lib/block_client/rust:block-client",
        "//src/storage/lib/storage_device",
        "//third_party/android/platform/bootable/libbootloader:libabr",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

rustc_test(
    name = "paver-core_test",
    build_flags = [
        "//build/config/rust:bootfs",
    ],
    crate = ":paver-core",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//src/lib/fuchsia",
        "//src/storage/lib/block_client/rust:fake-block-client",
    ],
)

fx_unittest_package(
    name = "paver-core-tests",
    max_log_severity = "ERROR",
    unit_tests = [
        ":paver-core_test",
    ],
)
