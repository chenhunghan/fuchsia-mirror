load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")

package(default_applicable_licenses = ["//:license"])

# Host tests for //src/firmware defined in Bazel. These are exported to
# `fx test` and infra builders through the `bazel_tests` target in
# //src/firmware/BUILD.gn.
test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [
        "//src/firmware/lib/zbi-rs:host_tests",
    ],
)

# Device tests for //src/firmware defined in Bazel. These are exported to
# `fx test` and infra builders through the `bazel_tests` target in
# //src/firmware/BUILD.gn.
test_suite(
    name = "target_tests",
    target_compatible_with = ["@platforms//os:fuchsia"],
    tests = [
        "//src/firmware/lib/zbi-rs:tests",
    ],
)
