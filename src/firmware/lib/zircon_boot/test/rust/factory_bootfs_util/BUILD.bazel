load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//build/bazel/rules/rust:rustc_staticlib.bzl", "rustc_staticlib")

package(default_applicable_licenses = ["//:license"])

rustc_staticlib(
    name = "factory-bootfs-util",
    srcs = ["src/lib.rs"],
    # Don't allow unused result. See build/config/rust/BUILD.gn for more detail.
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    edition = "2024",
    # Redundant in Bazel, but keeps the GN target generated by bazel2gn private:
    # C/C++ consumers use the header through `:factory-bootfs-util_headers`.
    visibility = ["//visibility:private"],
    deps = [
        "//sdk/rust/zx",
        "//src/sys/lib/fuchsia-bootfs",
        "//src/sys/lib/fuchsia-zbi",
    ],
)

fx_cc_library(
    name = "factory-bootfs-util_headers",
    hdrs = ["src/factory_bootfs_util.h"],
    visibility = ["//src/firmware/lib/zircon_boot/test:__pkg__"],
    deps = [":factory-bootfs-util"],
    alwayslink = True,
)
