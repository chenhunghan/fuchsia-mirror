import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("zbi-rs") {
  sources = [
    "src/lib.rs",
    "src/zbi_format.rs",
  ]
  configs += [ "//build/config/rust/lints:deny_unused_results" ]
  crate_name = "zbi"
  edition = "2024"
  link_deps = [ "//sdk/lib/zbi-format" ]
  visibility = [
    ":*",
    "//src/bringup/bin/userboot:*",
    "//src/bringup/lib/userboot/rust:*",
    "//src/firmware/paver/rust/paver-core:*",
  ]
  deps = [
    "//third_party/rust_crates:bitflags",
    "//third_party/rust_crates:zerocopy",
  ]
}

rustc_test("zbi-rs-test") {
  sources = [
    "src/lib.rs",
    "src/zbi_format.rs",
  ]
  edition = "2024"
  link_deps = [ "//sdk/lib/zbi-format" ]
  deps = [
           "//third_party/rust_crates:bitflags",
           "//third_party/rust_crates:zerocopy",
         ] + [ "//third_party/rust_crates:hex" ]
  configs += [ "//build/config/rust/lints:deny_unused_results" ]
  output_name = "firmware_zbi_rs_test"
}

fuchsia_unittest_package("zbi-rs-lib-unit-tests") {
  package_name = "zbi-rs-lib-unit-tests-gn"
  component_name = "zbi-rs-lib-unit-tests"
  deps = [ ":zbi-rs-test" ]
}
