load("@rules_python//python:py_library.bzl", "py_library")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")

package(default_applicable_licenses = ["//:license"])

# Host-only Python library: depends on host-only //scripts/lib/async_utils and
# //scripts/lib/build_dir (was not gated by if (is_host) in GN). GN's explicit
# library_name = "fx_cmd" and source_root = "//scripts/lib/fx_cmd" are the
# python_library defaults, matched here by name = "fx_cmd" and imports = [".."].
py_library(
    name = "fx_cmd",
    srcs = [
        "__init__.py",
        "lib.py",
    ],
    imports = [".."],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//scripts/debug/zxdb_cli/cli:__pkg__",
        "//scripts/debug/zxdb_cli/daemon_manager:__pkg__",
        "//scripts/fxtest/python:__pkg__",
        "//scripts/lib/ffx_cmd:__pkg__",
        "//scripts/lib/package_server:__pkg__",
        "//tools/devshell/python/status:__pkg__",
        "//tools/devshell/python/test-category:__pkg__",
    ],
    deps = [
        "//scripts/lib/async_utils",
        "//scripts/lib/build_dir",
    ],
)
