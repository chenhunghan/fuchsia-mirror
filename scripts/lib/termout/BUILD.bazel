    name = "termout",
    srcs = [
        "__init__.py",
        "termout.py",
    ],
    imports = [".."],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//scripts/fxtest/python:__pkg__",
        "//tools/devshell/python/system-status:__pkg__",
    ],
    deps = ["//third_party/colorama"],
