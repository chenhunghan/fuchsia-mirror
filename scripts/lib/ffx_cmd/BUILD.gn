if (is_host) {
  python_library("ffx_cmd") {
    sources = [
      "__init__.py",
      "inspect.py",
      "lib.py",
      "version.py",
    ]
    imports = [ ".." ]
    visibility = [
      ":*",
      "//scripts/debug/zxdb_cli/daemon:*",
      "//scripts/lib/package_server:*",
      "//src/developer/debug/e2e_tests/dap_integration_tests:*",
      "//tools/devshell/python/system-status:*",
    ]
    deps = [
      "//scripts/lib/async_utils",
      "//scripts/lib/fx_cmd",
      "//src/lib/diagnostics/python/fuchsia_inspect",
    ]
    enable_mypy = false
  }
}
