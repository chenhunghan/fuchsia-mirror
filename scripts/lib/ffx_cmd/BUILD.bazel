load("@rules_python//python:py_library.bzl", "py_library")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")

package(default_applicable_licenses = ["//:license"])

py_library(
    name = "ffx_cmd",
    srcs = [
        "__init__.py",
        "inspect.py",
        "lib.py",
        "version.py",
    ],
    imports = [".."],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//scripts/debug/zxdb_cli/daemon:__pkg__",
        "//scripts/lib/package_server:__pkg__",
        "//src/developer/debug/e2e_tests/dap_integration_tests:__pkg__",
        "//tools/devshell/python/system-status:__pkg__",
    ],
    deps = [
        "//scripts/lib/async_utils",
        "//scripts/lib/fx_cmd",
        "//src/lib/diagnostics/python/fuchsia_inspect",
    ],
)
