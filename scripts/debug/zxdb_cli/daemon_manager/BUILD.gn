import("//build/tools/bazel2gn/bazel_migration.gni")

if (is_host) {
  python_library("daemon_manager") {
    sources = [
      "__init__.py",
      "manager.py",
    ]
    imports = [ ".." ]
    visibility = [
      ":*",
      "//scripts/debug/zxdb_cli/cli:*",
      "//scripts/fxtest/python:*",
    ]
    deps = [
      "//scripts/debug/zxdb_cli/shared:protocol_lib",
      "//scripts/lib/fx_cmd",
    ]
    enable_mypy = false
  }
}
