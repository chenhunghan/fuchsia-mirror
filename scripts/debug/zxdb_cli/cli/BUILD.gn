import("//build/python/python_host_test.gni")
import("//build/python/python_library.gni")

_cli_tests = [
  "tests/test_cli.py",
  "commands/tests/test_lifecycle_commands.py",
  "commands/tests/test_execution_commands.py",
  "commands/tests/test_inspection_commands.py",
  "commands/tests/test_breakpoint_commands.py",
]

if (is_host) {
  # Keep the GN host tests above the sentinel because bazel2gn does not
  # translate host_py_test.
  foreach(test_source, _cli_tests) {
    _test_name = get_path_info(test_source, "name")

    python_host_test(_test_name) {
      main_source = test_source
      libraries = [
        ":cli_lib",
        ":test_helpers",
      ]
      test_data_deps = [ "//prebuilt/third_party/pydantic-core:test_data" ]
    }
  }

  group("tests") {
    testonly = true
    deps = []
    foreach(test_source, _cli_tests) {
      _test_name = get_path_info(test_source, "name")
      deps += [ ":$_test_name" ]
    }
  }
} else {
  group("tests") {
    testonly = true
    deps = [ ":tests($host_toolchain)" ]
  }
}

