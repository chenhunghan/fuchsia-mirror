import("//build/python/python_host_test.gni")
import("//build/python/python_library.gni")

_protocol_tests = [
  {
    target_name = "protocol_test"
    source = "tests/test_protocol.py"
  },
  {
    target_name = "test_attach_detach_schemas"
    source = "protocol/tests/test_attach_detach_schemas.py"
  },
  {
    target_name = "test_breakpoint_schemas"
    source = "protocol/tests/test_breakpoint_schemas.py"
  },
  {
    target_name = "test_evaluate_and_console_schemas"
    source = "protocol/tests/test_evaluate_and_console_schemas.py"
  },
  {
    target_name = "test_event_and_state_schemas"
    source = "protocol/tests/test_event_and_state_schemas.py"
  },
  {
    target_name = "test_execution_schemas"
    source = "protocol/tests/test_execution_schemas.py"
  },
  {
    target_name = "test_lifecycle_schemas"
    source = "protocol/tests/test_lifecycle_schemas.py"
  },
  {
    target_name = "test_process_inspection_schemas"
    source = "protocol/tests/test_process_inspection_schemas.py"
  },
  {
    target_name = "test_stack_schemas"
    source = "protocol/tests/test_stack_schemas.py"
  },
  {
    target_name = "test_tracepoint_schemas"
    source = "protocol/tests/test_tracepoint_schemas.py"
  },
]

group("tests") {
  testonly = true
  deps = [ ":session_test($host_toolchain)" ]
  foreach(test, _protocol_tests) {
    deps += [ ":${test.target_name}($host_toolchain)" ]
  }
}

if (is_host) {
  group("pydantic_test_data") {
    testonly = true
    public_deps = [ "//prebuilt/third_party/pydantic-core:test_data" ]
  }

  # Keep the GN host tests above the sentinel because bazel2gn does not
  # translate host_py_test.
  foreach(test, _protocol_tests) {
    python_host_test(test.target_name) {
      main_source = test.source
      libraries = [
        ":protocol_lib",
        ":test_helpers",
      ]

      # Explicitly depend on pydantic-core's test_data. This is to ensure that
      # the module's DSO is bundled together with our test so the top-level
      # pydantic module loads correctly.
      test_data_deps = [ ":pydantic_test_data" ]
    }
  }

  python_host_test("session_test") {
    main_source = "tests/test_session.py"
    libraries = [ ":session_lib" ]
  }
}

