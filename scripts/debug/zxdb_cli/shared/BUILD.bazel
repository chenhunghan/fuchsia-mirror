# Enable mypy for the dual-built GN target so GN consumers (cli_lib,
# daemon_lib, daemon_manager, and GN host tests) that run mypy still receive
# type information.
# @bazel2gn:raw_attribute:enable_mypy = true
py_library(
    name = "protocol_lib",
    srcs = [
        "__init__.py",
        "protocol/__init__.py",
        "protocol/aspace.py",
        "protocol/async_backtrace.py",
        "protocol/attach.py",
        "protocol/base.py",
        "protocol/break_request.py",
        "protocol/console.py",
        "protocol/continue_request.py",
        "protocol/detach.py",
        "protocol/diagnose_hang.py",
        "protocol/driver_list.py",
        "protocol/evaluate.py",
        "protocol/finish.py",
        "protocol/get_state.py",
        "protocol/handles.py",
        "protocol/hello.py",
        "protocol/mem_read.py",
        "protocol/modules.py",
        "protocol/next_request.py",
        "protocol/pause.py",
        "protocol/stack_trace.py",
        "protocol/start.py",
        "protocol/step_in.py",
        "protocol/stop.py",
        "protocol/threads.py",
        "protocol/tracepoint.py",
        "protocol/variables.py",
        "protocol/wait_for_event.py",
        "protocol/watch_request.py",
    ],
    imports = [".."],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//scripts/debug/zxdb_cli/cli:__pkg__",
        "//scripts/debug/zxdb_cli/daemon:__pkg__",
        "//scripts/debug/zxdb_cli/daemon_manager:__pkg__",
    ],
    deps = [
        "//src/lib/debug/dap/python:lib",
        "//src/lib/debug/dap/python/zxdb:zxdb_dap",
        "//third_party/pylibs/pydantic",
    ],
)

# @bazel2gn:raw_attribute:enable_mypy = true
