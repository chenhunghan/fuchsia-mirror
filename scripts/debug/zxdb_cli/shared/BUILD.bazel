# Bazel-only entrypoint wrapper: generate_schema.py defines main() without an
# `if __name__ == "__main__"` block (GN python_binary invokes main_callable).
# @bazel2gn:skip
write_file(
    name = "generate_schema_main",
    out = "generate_schema_main.py",
    content = [
        "import sys",
        "from shared.generate_schema import main",
        "sys.exit(main())",
    ],
)

# Bazel-only helper binary for :generate_schema; uses py_binary instead of
# py_zipapp_binary because pydantic_core requires its native DSO in runfiles.
# @bazel2gn:skip
py_binary(
    name = "generate_schema_bin",
    srcs = [
        "generate_schema.py",
        ":generate_schema_main",
    ],
    main = "generate_schema_main.py",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [":protocol_lib"],
)

# @bazel2gn:skip
genrule(
    name = "generate_schema",
    outs = ["schema.json"],
    cmd = "$(execpath :generate_schema_bin) --output $@",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tools = [":generate_schema_bin"],
)

# @bazel2gn:skip
golden_test(
    name = "schema_golden_check",
    goldens = {
        "//scripts:debug/zxdb_cli/schema.json": ":generate_schema",
    },
)
