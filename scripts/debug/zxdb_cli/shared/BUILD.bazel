py_library(
    name = "test_helpers",
    testonly = True,
    srcs = [
        "tests/__init__.py",
        "tests/helpers.py",
    ],
    imports = [".."],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [":protocol_lib"],
)

# In Bazel, unlike GN, Python binaries are not zipped, so pydantic_core's
# DSO stays in runfiles via //third_party/pylibs/pydantic without a
# separate test_data target. Original GN comment:
# Explicitly depend on pydantic-core's test_data. This is to ensure that the
# module's DSO is bundled together with our test so the top-level pydantic
# module loads correctly.
host_py_test(
    name = "protocol_test",
    testonly = True,
    srcs = ["tests/test_protocol.py"],
    main = "tests/test_protocol.py",
    deps = [
        ":protocol_lib",
        ":test_helpers",
    ],
)

host_py_test(
    name = "session_test",
    testonly = True,
    srcs = ["tests/test_session.py"],
    main = "tests/test_session.py",
    deps = [":session_lib"],
)

