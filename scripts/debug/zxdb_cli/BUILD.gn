import("//build/python/host.gni")

if (is_host) {
  group("tests") {
    testonly = true
    deps = [
      "cli:tests",
      "daemon:tests",
      "daemon_manager:tests",
      "shared:tests",
      "tests",
      "//src/lib/debug/dap:tests",
    ]
  }

  group("install") {
    deps = [ "daemon:install" ]
  }
} else {
  group("tests") {
    testonly = true
    deps = [ ":tests($host_toolchain)" ]
  }
}
