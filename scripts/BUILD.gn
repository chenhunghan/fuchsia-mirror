import("//build/bazel/bazel_test_suite.gni")
import("//build/python/python_host_test.gni")

if (is_host) {
  python_host_test("build_id_conv_test") {
    main_source = "build_id_conv_test.py"
    sources = [ "build_id_conv.py" ]
  }
}

group("scripts") {
  testonly = true

  deps = [ ":tests" ]
}

bazel_test_suite("bazel_tests") {
  host_tests = [ "//scripts:host_tests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":build_id_conv_test($host_toolchain)",
    "debug:tests($host_toolchain)",
    "ffx_complete:tests",
    "fxtest:tests",
    "lib:tests",
    "shac/tests($host_toolchain)",
  ]
}
