load("@bazel_skylib//lib:selects.bzl", "selects")

package(default_applicable_licenses = ["//:license"])

selects.config_setting_group(
    name = "true",
    match_any = [
        "//build/bazel/config/variant_features/profile:true",
        "//build/bazel/config/variant_features/profile-rust:true",
    ],
    visibility = ["//:__subpackages__"],
)

selects.config_setting_group(
    name = "false",
    match_all = [
        "//build/bazel/config/variant_features/profile:false",
        "//build/bazel/config/variant_features/profile-rust:false",
    ],
    visibility = ["//:__subpackages__"],
)

alias(
    name = "is_profile",
    actual = ":true",
    visibility = ["//:__subpackages__"],
)
