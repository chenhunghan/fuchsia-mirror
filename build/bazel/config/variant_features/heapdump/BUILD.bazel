package(default_applicable_licenses = ["//:license"])

config_setting(
    name = "true",
    flag_values = {
        "//build/bazel/config/variant_features:heapdump": "True",
    },
    visibility = ["//:__subpackages__"],
)

config_setting(
    name = "false",
    flag_values = {
        "//build/bazel/config/variant_features:heapdump": "False",
    },
    visibility = ["//:__subpackages__"],
)

alias(
    name = "heapdump",
    actual = ":true",
    visibility = ["//:__subpackages__"],
)
