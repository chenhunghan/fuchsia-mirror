package(default_applicable_licenses = ["//:license"])

config_setting(
    name = "true",
    flag_values = {
        "//build/bazel/config/variant_features:fuzzer": "True",
    },
    visibility = [
        "//:__subpackages__",
        "@fuchsia_build_info//:__subpackages__",
    ],
)

config_setting(
    name = "false",
    flag_values = {
        "//build/bazel/config/variant_features:fuzzer": "False",
    },
    visibility = ["//:__subpackages__"],
)

alias(
    name = "fuzzer",
    actual = ":true",
    visibility = ["//:__subpackages__"],
)
