"""Providers for in-tree driver bind rules."""

visibility(["//build/bazel/rules/..."])

DriverBindBytecodeInfo = provider(
    doc = "A driver's bind rule sources, produced by `driver_bind_bytecode()`.",
    fields = {
        "src": "The `.bind` File with the bind rules, or `None` if the driver has none.",
        "bind_library_sources": "A depset of the `.bind` Files of the bind libraries that the rules use.",
    },
)

DriverDmlBindInfo = provider(
    doc = "Carries the `.bind` file generated by a `dml_outputs()` target to `driver_bind_bytecode()`.",
    fields = {
        "bind": "The generated `.bind` File, or `None` if `disable_autobind = True`.",
    },
)
