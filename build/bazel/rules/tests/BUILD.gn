import("//build/bazel/bazel_build_action.gni")
import("//build/bazel/bazel_test_suite.gni")
import("//build/bazel/bazel_tool_paths.gni")

visibility = [ ":*" ]

# Exports the Bazel device tests defined in this directory tree to `tests.json`,
# making them visible to `fx test` and infra builders.
bazel_test_suite("bazel_tests") {
  visibility += [ "//build/bazel:*" ]
  target_tests = [ "//build/bazel/rules/packages/tests:example_test" ]
}

# All the test targets defined in this file.
group("all") {
  testonly = true
  deps = [
    ":bazel_tool_paths_test($host_toolchain)",
    ":quick_tests",
    ":tests",
  ]
  visibility += [
    # Ensures the test targets are always available.
    "//:root_targets",

    # A small number of build bots build all the tests, accepting the bazel
    # action overhead. These bots should run all the GN build test targets even
    # if some underlying Bazel targets are subsets of others. Building all the
    # GN Bazel action targets ensures, for example, that they are configured
    # with all the necessary Bazel inputs.
    "//bundles/buildbot/*",
  ]
}

bazel_build_action("tests") {
  testonly = true
  bazel_target = ":tests"
  copy_outputs = [
    {
      bazel = "{{BAZEL_TARGET_OUT_DIR}}/tests.bazel_stamp"
      ninja = "tests.bazel_stamp"
    },
  ]
  bazel_config = "fuchsia_platform"
  deps = [
    # Needed by `//sdk/fidl/zbi:zbi.c.checked-in` via
    # `//build/bazel/bazel_idk/tests:test-source-library_idk` and
    # `//sdk/lib/zbi-format:zbi-format_idk`.
    # TODO(https://fxbug.dev/427976639): Remove once `zither_golden_files` is migrated to Bazel.
    "//sdk/fidl/zbi:zbi.c.checked-in.bazel_input",
  ]
}

bazel_build_action("quick_tests") {
  testonly = true
  bazel_target = ":quick_tests"
  copy_outputs = [
    {
      bazel = "{{BAZEL_TARGET_OUT_DIR}}/quick_tests.bazel_stamp"
      ninja = "quick_tests.bazel_stamp"
    },
  ]
  bazel_config = "fuchsia_platform"
  deps = [
    # Needed by `//sdk/fidl/zbi:zbi.c.checked-in` via
    # `//build/bazel/bazel_idk/tests:test-source-library_idk` and
    # `//sdk/lib/zbi-format:zbi-format_idk`.
    # TODO(https://fxbug.dev/427976639): Remove once `zither_golden_files` is migrated to Bazel.
    "//sdk/fidl/zbi:zbi.c.checked-in.bazel_input",
  ]
}

if (is_host) {
  bazel_tool_paths("test_bazel_tool_paths") {
    testonly = true
    tools = [
      {
        name = "bazel_tool_paths_test_go_bin"
        bazel_target = "//build/bazel/rules/host_tests/tests/go:lib_test_bin"
        is_go = true
      },
      {
        name = "bazel_tool_paths_test_cc_bin"
        bazel_target =
            "//build/bazel/rules/host_tests/tests/host_test_data:test_bin"
      },
    ]
  }

  _tool_paths_manifest = "$target_gen_dir/test_bazel_tool_paths.json"

  generated_file("test_bazel_tool_paths.json") {
    testonly = true
    data_keys = [ "tool_paths" ]
    walk_keys = [ "tool_barrier" ]
    output_conversion = "json"
    outputs = [ _tool_paths_manifest ]
    deps = [ ":test_bazel_tool_paths" ]
  }

  action("bazel_tool_paths_test") {
    testonly = true
    script = "verify_bazel_tool_paths.py"
    _go_bin = "${root_out_dir}/bazel_tool_paths_test_go_bin"
    _cc_bin = "${root_out_dir}/bazel_tool_paths_test_cc_bin"
    _stamp = "${target_out_dir}/bazel_tool_paths_test.stamp"
    inputs = [
      _tool_paths_manifest,
      _go_bin,
      _cc_bin,
    ]
    outputs = [ _stamp ]
    deps = [
      ":test_bazel_tool_paths",
      ":test_bazel_tool_paths.json",
    ]
    args = [
      "--manifest",
      rebase_path(_tool_paths_manifest, root_build_dir),
      "--cpu",
      current_cpu,
      "--os",
      current_os,
      "--expected-tool",
      "bazel_tool_paths_test_go_bin=" + rebase_path(_go_bin, root_build_dir) +
          "=" +
          get_label_info(":test_bazel_tool_paths.bazel_tool_paths_test_go_bin",
                         "label_with_toolchain"),
      "--expected-tool",
      "bazel_tool_paths_test_cc_bin=" + rebase_path(_cc_bin, root_build_dir) +
          "=" +
          get_label_info(":test_bazel_tool_paths.bazel_tool_paths_test_cc_bin",
                         "label_with_toolchain"),
      "--stamp",
      rebase_path(_stamp, root_build_dir),
    ]
  }
}
