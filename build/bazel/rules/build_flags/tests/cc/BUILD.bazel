# Verify direct and transitive dynamic_deps deduplication via CcSharedLibraryInfo.exports.
# shlib_private_backing_dep has hidden visibility and is supplied only to
# shlib_dyn_base via shlib_dyn_base_backing_holder (not in deps of
# shlib_dyn_exported_dep): if shlib_dyn_exported_dep were NOT deduplicated against
# dynamic_deps, --whole-archive would re-link it without shlib_private_backing_dep
# and fail with an undefined symbol error.
fx_cc_library(
    name = "shlib_private_backing_dep",
    srcs = ["shlib_link_deps_test_helpers.cc"],
    copts = ["-fvisibility=hidden"],
    local_defines = ["SHLIB_ROLE_PRIVATE_BACKING"],
)

fx_cc_library(
    name = "shlib_dyn_base_backing_holder",
    deps = [":shlib_private_backing_dep"],
)

fx_cc_library(
    name = "shlib_dyn_exported_dep",
    srcs = ["shlib_link_deps_test_helpers.cc"],
    local_defines = ["SHLIB_ROLE_DYN_EXPORTED"],
    alwayslink = True,
)

fx_cc_shared_library(
    name = "shlib_dyn_base",
    deps = [
        ":shlib_dyn_base_backing_holder",
        ":shlib_dyn_exported_dep",
    ],
)

fx_cc_library(
    name = "shlib_dyn_direct_caller",
    srcs = ["shlib_link_deps_test_helpers.cc"],
    local_defines = ["SHLIB_ROLE_DYN_DIRECT_CALLER"],
)

extra_linker_flags(
    name = "flags_shlib_dyn_exported_link_deps",
    link_deps = [":shlib_dyn_exported_dep"],
)

fx_cc_shared_library(
    name = "fx_cc_shared_library_with_direct_dyn_dedup",
    build_flags = [":flags_shlib_dyn_exported_link_deps"],
    dynamic_deps = [":shlib_dyn_base"],
    deps = [":shlib_dyn_direct_caller"],
)

