# --- py_data_package fixtures & provider analysis tests ---

# 1. Subpackage attached to an existing py_library, staging source files, an
#    untyped generated `.py` data file (skipped by `"no-pyrefly"`), and a
#    renamed C++ host binary.
cc_binary_host_tool(
    name = "echo_tool_bin",
    testonly = True,
    srcs = ["echo_tool.cc"],
)

write_file(
    name = "untyped_py_data",
    testonly = True,
    out = "gen_bad_data.py",
    content = ["x: int = 'bad'\n"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
)

py_data_package(
    name = "pkg_data",
    testonly = True,
    srcs = [
        "data/greeting.txt",
        ":untyped_py_data",
    ],
    package_dir = "lib/pkg_with_data/data",
    srcs_map = {
        "renamed_echo_tool": ":echo_tool_bin",
    },
)

py_data_package_providers_test(
    name = "subpackage_providers_test",
    expected_data_short_paths = [
        "build/bazel/rules/python/tests/lib/pkg_with_data/data/gen_bad_data.py",
        "build/bazel/rules/python/tests/lib/pkg_with_data/data/greeting.txt",
        "build/bazel/rules/python/tests/lib/pkg_with_data/data/renamed_echo_tool",
    ],
    expected_transitive_source_short_paths = [
        "build/bazel/rules/python/tests/lib/pkg_with_data/data/__init__.py",
    ],
    target_under_test = ":pkg_data",
)

py_library(
    name = "pkg_with_data_lib",
    testonly = True,
    srcs = [
        "lib/pkg_with_data/__init__.py",
        "lib/pkg_with_data/reader.py",
    ],
    imports = ["lib"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [":pkg_data"],
)

# 2. Multiple standalone `test_data` packages in one BUILD.bazel isolated under
#    distinct `package_dir` / `imports` prefixes (plus predeclared OutputFile
#    labels in `srcs` and `srcs_map`).
py_data_package(
    name = "host_test_isolated_data",
    testonly = True,
    srcs = [":gen_bad_data.py"],
    imports = ["host_test_isolated_data"],
    package_dir = "host_test_isolated_data/test_data",
    srcs_map = {
        "isolated.txt": "data/greeting.txt",
        "predeclared.py": ":gen_bad_data.py",
    },
)

py_data_package(
    name = "zipapp_isolated_data",
    testonly = True,
    srcs = ["data/extra.txt"],
    imports = ["zipapp_isolated_data"],
    package_dir = "zipapp_isolated_data/test_data",
)

# 3. Nested package path (`dotted_pkg.nested`) under a custom `imports` root.
py_data_package(
    name = "dotted_data",
    testonly = True,
    imports = ["dotted_data"],
    package_dir = "dotted_data/dotted_pkg/nested",
    srcs_map = {
        "custom.txt": "data/greeting.txt",
    },
)

py_data_package_providers_test(
    name = "dotted_package_providers_test",
    expected_data_short_paths = [
        "build/bazel/rules/python/tests/dotted_data/dotted_pkg/nested/custom.txt",
    ],
    expected_imports = [
        "_main/build/bazel/rules/python/tests/dotted_data",
    ],
    expected_transitive_source_short_paths = [
        "build/bazel/rules/python/tests/dotted_data/dotted_pkg/nested/__init__.py",
    ],
    target_under_test = ":dotted_data",
)

# 4. Default `package_dir` (`name`), `imports = ["."]`, and transitive
#    `default_runfiles` propagation from an executable target.
fx_cc_binary(
    name = "carrier_cc_bin",
    testonly = True,
    srcs = ["echo_tool.cc"],
    data = ["data/extra.txt"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
)

py_data_package(
    name = "runfiles_carrier_pkg",
    testonly = True,
    srcs = [":carrier_cc_bin"],
    imports = ["."],
)

# --- py_data_package negative analysis tests ---

py_data_package(
    name = "invalid_empty_inputs",
    testonly = True,
    tags = ["manual"],
)

analysis_failure_test(
    name = "invalid_empty_inputs_test",
    expected_message = "At least one of `srcs` or `srcs_map` must be non-empty.",
    target_under_test = ":invalid_empty_inputs",
)

py_data_package(
    name = "invalid_package_dir_dotdot",
    testonly = True,
    srcs = ["data/greeting.txt"],
    package_dir = "../escape",
    tags = ["manual"],
)

analysis_failure_test(
    name = "invalid_package_dir_dotdot_test",
    expected_message = "`package_dir` must not contain empty, '.', or '..' segments",
    target_under_test = ":invalid_package_dir_dotdot",
)

py_data_package(
    name = "invalid_package_dir_ident",
    testonly = True,
    srcs = ["data/greeting.txt"],
    package_dir = "sub/bad-name",
    tags = ["manual"],
)

analysis_failure_test(
    name = "invalid_package_dir_ident_test",
    expected_message = "Leaf directory of `package_dir` must be a valid Python identifier",
    target_under_test = ":invalid_package_dir_ident",
)

py_data_package(
    name = "invalid-default-name",
    testonly = True,
    srcs = ["data/greeting.txt"],
    tags = ["manual"],
)

analysis_failure_test(
    name = "invalid_default_name_ident_test",
    expected_message = "Leaf directory of `package_dir` must be a valid Python identifier",
    target_under_test = ":invalid-default-name",
)

py_data_package(
    name = "invalid_imports_escape",
    testonly = True,
    srcs = ["data/greeting.txt"],
    imports = ["../../../../../../escape"],
    tags = ["manual"],
)

analysis_failure_test(
    name = "invalid_imports_escape_test",
    expected_message = "escapes the repository root",
    target_under_test = ":invalid_imports_escape",
)

py_data_package(
    name = "invalid_init_dest",
    testonly = True,
    srcs_map = {"__init__.py": "data/greeting.txt"},
    tags = ["manual"],
)

analysis_failure_test(
    name = "invalid_init_dest_test",
    expected_message = "Data resource filename cannot be '__init__.py'",
    target_under_test = ":invalid_init_dest",
)

py_data_package(
    name = "invalid_slash_dest",
    testonly = True,
    srcs_map = {"sub/file.txt": "data/greeting.txt"},
    tags = ["manual"],
)

analysis_failure_test(
    name = "invalid_slash_dest_test",
    expected_message = "Data resource filename must be a plain filename without '/'",
    target_under_test = ":invalid_slash_dest",
)

py_data_package(
    name = "invalid_duplicate_dest",
    testonly = True,
    srcs = ["data/greeting.txt"],
    srcs_map = {"greeting.txt": "data/extra.txt"},
    tags = ["manual"],
)

analysis_failure_test(
    name = "invalid_duplicate_dest_test",
    expected_message = "Duplicate data resource filename",
    target_under_test = ":invalid_duplicate_dest",
)

