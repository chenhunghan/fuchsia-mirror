"""Macros for defining `host_test()` targets for Python binaries."""

load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_info.bzl", "PyInfo")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load(":host_test.bzl", "host_test")

def _host_py_test_info_impl(ctx):
    binary_label = ctx.attr.binary.label
    binary_repo = binary_label.repo_name
    binary_package = binary_label.package

    # The main import path corresponds to the runfiles sub-directory that contains
    # the test binary. This will be "_main" for targets defined in the main workspace,
    # or <canonical_repo_name> for targets defined in external repositories.
    main_import = binary_repo if binary_repo else "_main"

    # Use the main import path, with the import paths from all transitive dependencies.
    imports = depset([main_import], transitive = [ctx.attr.binary[PyInfo].imports]).to_list()

    output = ctx.actions.declare_file(ctx.label.name)
    output_json = {
        # The main module is always in the same package, but may use a different name
        # than the binary label.
        "binary": "{}/{}/{}".format(main_import, binary_package, ctx.attr.main),
        "imports": imports,
    }

    ctx.actions.write(output, json.encode(output_json))

    return [DefaultInfo(files = depset([output]))]

_host_py_test_info = rule(
    implementation = _host_py_test_info_impl,
    doc = """Generate information about a Python host test used to generate its wrapper script.

    This writes a single JSON file containing an object with following schema:

    # LINT.IfChange(bazel_host_py_test_info_schema)

      "binary": runfiles path of the test's py_binary module. E.g. "_main/src/foo/test.py".
      "imports": List of import paths for the test's py_binary, relative to the runfiles directory.

    # LINT.ThenChange(//scripts/fxtest/list_host_test/list_host_python_unittests.py:bazel_host_py_test_info_schema)
    """,
    attrs = {
        "binary": attr.label(mandatory = True, providers = [PyInfo]),
        "main": attr.string(mandatory = True),
    },
)

def _is_python_identifier(name):
    return bool(name) and (name[0].isalpha() or name[0] == "_") and name.replace("_", "a").isalnum()

def _host_py_test_main_impl(ctx):
    main_callable = ctx.attr.main_callable
    if not all([_is_python_identifier(part) for part in main_callable.split(".")]):
        fail("Invalid main_callable '{}', must be a dotted Python identifier.".format(main_callable))

    main_file = ctx.file.main
    main_module = main_file.basename.removesuffix(".py")
    if not _is_python_identifier(main_module):
        fail("main_callable requires the basename of `main` to be a valid Python module name, got: " +
             main_file.basename)

    # Only `unittest.xxx` callables get an explicit import of their module: other dotted
    # callables, like GN's python_host_test(), rely on the star import below to provide it.
    extra_import = "import unittest\n" if main_callable.startswith("unittest.") else ""

    # Keep this consistent with the __main__.py file that
    # //build/python/package_python_binary.py generates for GN python_host_test() targets.
    ctx.actions.write(
        output = ctx.outputs.out,
        content = """# Generated by host_py_test() from {label}. DO NOT EDIT.
# Use private aliases, which the star import below cannot shadow.
import asyncio as _asyncio
import inspect as _inspect
import os as _os
import sys as _sys
import typing as _typing
{extra_import}
# This file lives next to {main_module}.py in the runfiles directory. Do not resolve
# symlinks here, as that would point to the Bazel output directory instead.
_main_dir = _os.path.dirname(_os.path.abspath(__file__))
_sys.path.insert(0, _main_dir)

# Make sys.argv[0] (e.g. the default argparse program name) match running
# {main_module}.py directly.
_sys.argv[0] = _os.path.join(_main_dir, "{main_module}.py")

from {main_module} import *  # noqa: F401,F403

# Typed as Any, since the callable can return any value, or a coroutine.
_main_callable: _typing.Any = {main_callable}
if _inspect.iscoroutinefunction(_main_callable):
    _asyncio.run(_main_callable())
else:
    _sys.exit(_main_callable())
""".format(
            label = ctx.label,
            extra_import = extra_import,
            main_module = main_module,
            main_callable = main_callable,
        ),
    )
    return [DefaultInfo(files = depset([ctx.outputs.out]))]

host_py_test_main = rule(
    implementation = _host_py_test_main_impl,
    doc = """Generate a Python entry point that imports `main` and calls `main_callable`.

    This matches the behavior of GN python_host_test() targets, whose generated `__main__.py`
    star-imports the main source module, then calls `main_callable`.
    """,
    attrs = {
        "main": attr.label(
            doc = "The main source file of the test, whose module will be imported.",
            mandatory = True,
            allow_single_file = [".py"],
        ),
        "main_callable": attr.string(
            doc = "The callable to invoke, e.g. 'unittest.main' or 'main'.",
            mandatory = True,
        ),
        "out": attr.output(
            doc = "The generated entry point. Must be in the same directory as `main`.",
            mandatory = True,
        ),
    },
)

def legacy_host_py_test(
        name,
        binary_name = "",
        main = None,
        main_callable = "unittest.main",
        test_args = [],
        test_data = [],
        tags = [],
        target_compatible_with = None,
        visibility = None,
        **kwargs):
    """Define a host test wrapping a Python binary that can be used with Fuchsia test runners.

    This is a convenience macro to call py_binary() and host_test() together.

    Unlike py_test(), these tests will be usable with `fx test` and `botanist`, and can
    still be run locally using `fx bazel test --config=host <label>`.

    Args:
      name: The name of the host test.
      binary_name: Optional. The name of the py_binary target, defaults to 'name + "_bin"'.
      main: Optional. The main entry point for the py_binary, defaults to 'name + ".py"'.
      main_callable: Optional. The callable to invoke after star-importing the module of
        `main`, like GN's python_host_test(). Defaults to "unittest.main", which runs all
        unittest.TestCase classes (and `load_tests` hooks) of `main`, and fails when no
        tests are found. Use a function name such as "main" to call a custom entry point
        (async functions are run with asyncio.run()). Note that, in both cases, the
        `if __name__ == "__main__":` block of `main` is never executed, so scripts should
        define their entry point as a function, e.g. `def main() -> int`.
      test_args: Arguments to pass to the test binary. Do not use `args`.
      test_data: Optional. The data dependencies for the test target itself.
      tags: Optional. Tags applied to both the test target and inner `py_binary`.
      target_compatible_with: Optional. Platform constraints for the generated targets.
        Defaults to HOST_OS_CONSTRAINTS.
      visibility: Optional. Visibility of the generated host test target.
      **kwargs: Arguments to pass to `py_binary`.
    """
    if "args" in kwargs:
        fail("Use `test_args` to pass test arguments instead of `args`")

    binary_name = binary_name if binary_name else name + "_bin"
    host_py_test_info = name + ".host_py_test_info"
    if target_compatible_with == None:
        target_compatible_with = HOST_OS_CONSTRAINTS

    test_tags = list(tags or [])
    binary_tags = test_tags if "manual" in test_tags else test_tags + ["manual"]

    if not main:
        main = name + ".py"

    if not main_callable:
        fail("main_callable must be a non-empty string, got: {}".format(main_callable))
    if ":" in main:
        fail("`main` must be a file path relative to the package, got: " + main)
    srcs = kwargs.get("srcs", [])
    if type(srcs) == type([]) and main not in srcs:
        # py_binary() would catch this if `main` was its own main file.
        fail("`main` must be listed in `srcs`, got: " + main)

    # Generate the entry point next to `main`, so that its directory, which pyrefly
    # and Python use as an import search path, does not change.
    main_dir, _, _ = main.rpartition("/")
    binary_main = "{}{}_main_callable.py".format(
        main_dir + "/" if main_dir else "",
        name.replace("/", "_"),
    )
    host_py_test_main(
        name = name + ".main_callable",
        testonly = kwargs.get("testonly", False),
        main = main,
        main_callable = main_callable,
        out = binary_main,
        tags = binary_tags,
        target_compatible_with = target_compatible_with,
        visibility = ["//visibility:private"],
    )
    kwargs["srcs"] = srcs + [binary_main]

    py_binary(
        name = binary_name,
        main = binary_main,
        tags = binary_tags,
        target_compatible_with = target_compatible_with,
        visibility = ["//visibility:private"],
        **kwargs
    )

    _host_py_test_info(
        name = host_py_test_info,
        testonly = kwargs.get("testonly", False),
        binary = ":" + binary_name,
        main = main,
        tags = binary_tags,
        target_compatible_with = target_compatible_with,
        visibility = ["//visibility:private"],
    )

    test_data = test_data + [
        # The list_host_test tool is used to implement `fx test --list <test_name>`.
        "//scripts/fxtest/list_host_test:as_test_data",

        # The python_interpreter is used by the wrapper script directly.
        "//build/bazel/rules/python:python_interpreter_as_test_data",
    ]

    host_test(
        name = name,
        binary = binary_name,
        test_args = test_args,
        data = test_data,
        tags = test_tags,
        list_cases_argument = "list_host_python_unittests",
        host_test_wrapper_template = "//build/bazel:templates/template.host_py_test_wrapper.sh",
        host_test_wrapper_generator_deps = [
            ":" + host_py_test_info,
        ],
        host_test_wrapper_generator_args = [
            "--python-test-lister=test_data/list_host_python_unittests.py",
            "--python-test-interpreter=test_data/python3",
            "--python-test-info=$(location :{})".format(host_py_test_info),
        ],
        target_compatible_with = target_compatible_with,
        visibility = visibility,
    )

def _host_py_test_impl(
        name,
        visibility,
        binary_name = "",
        main = None,
        test_args = [],
        test_data = [],
        tags = [],
        target_compatible_with = None,
        **kwargs):
    legacy_host_py_test(
        name = name,
        binary_name = binary_name,
        main = main,
        test_args = test_args,
        test_data = test_data,
        tags = tags,
        target_compatible_with = target_compatible_with,
        visibility = visibility,
        **kwargs
    )

# This is a broken attempt to create a symbolic macro that would inherit all attributes,
# unfortunately, it requires an inherit_attrs line that fails with both py_binary and
# native.py_binary. Hopefully this could be fixed with a future Bazel upgrade.
broken_symbolic_host_py_test = macro(
    implementation = _host_py_test_impl,
    doc = """
Define a host test wrapping a Python binary that can be used with Fuchsia test runners.

This is a convenience macro to call py_binary() and host_test() together.

Unlike py_test(), these tests will be usable with `fx test` and `botanist`, and can
still be run locally using `fx bazel test --config=host <label>`.

Accepts all py_binary() attributes, plus `binary_name` and `test_xxx` ones.
""",
    # The inherit_attrs line below fails with **both** py_binary and native.py_binary with
    # an error message like:
    # ```
    # Error in macro: in call to macro(), parameter 'inherit_attrs' got value of type 'function', want 'rule, macro, string, or NoneType'
    # ```
    # inherit_attrs = native.py_binary,
    attrs = {
        "binary_name": attr.string(default = "", doc = "The name of the py_binary target, defaults to 'name + \"_bin\"'."),
        "test_args": attr.string_list(default = [], doc = "Arguments to pass to the test binary. Do not use `args`."),
        "test_data": attr.label_list(default = [], doc = "Data dependencies for the test target itself."),
    },
)

# Switch to symbolic macro once the inherit_attrs error is fixed.
host_py_test = legacy_host_py_test
