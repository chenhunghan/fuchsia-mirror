"""Macro for defining Mobly `host_test()` targets, like GN python_mobly_test()."""

load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load(":host_py_test.bzl", "host_py_test_main")
load(":host_test.bzl", "host_test")
load(":host_test_data.bzl", "host_test_data_map")

visibility(["//..."])

# The Mobly test runner, which runs the Mobly driver and parses the test
# results from its output.
_MOBLY_TEST_PARSER = "//tools/mobly_test_parser"

# host_test() runs its binary from the test's runtime directory, with
# RUNFILES_DIR set to `<binary basename>.runfiles`, where the runfiles of its
# `data` are also available. Keep this in sync with _MOBLY_TEST_PARSER.
_RUNFILES_DIR = "mobly_test_parser.runfiles"

# The Mobly driver, which wraps the execution of the Mobly test.
_MOBLY_DRIVER = "//src/testing/end_to_end/mobly_driver:mobly_driver_binary_target"

# The ffx binary and subtools, available under `host-tools/` at runtime.
_FFX_TEST_DATA = "//build/bazel/rules/host_tests:python_mobly_test_ffx_test_data"
_FFX_PATH = "host-tools/ffx"
_FFX_SUBTOOLS_PATH = "host-tools"

# The OpenSSH client, used by Honeydew to interact with auxiliary devices.
_SSH = "//build/prebuilt/cipd:ssh"

_VALID_TARGET_ADDRESS_TYPES = ("ip", "usb")

def python_mobly_test(
        name,
        main,
        srcs = [],
        libraries = [],
        data = [],
        main_callable = "test_runner.main",
        params = None,
        params_source = None,
        honeydew_config = None,
        local_config_source = None,
        ssh_key_path = None,
        test_data_deps = [],
        test_cases = [],
        extra_args = [],
        timeout_secs = None,
        cleanup_period_secs = None,
        multi_fuchsia_device = False,
        target_address_type = None,
        list_cases_argument = "list_mobly_tests",
        tags = [],
        target_compatible_with = None,
        visibility = None,
        **kwargs):
    """Defines a Mobly host test, like the GN python_mobly_test() template.

    This generates a `py_binary()` for the Mobly test, and a `host_test()`
    that runs it through the Mobly driver and //tools/mobly_test_parser, with
    ffx, its subtools and ssh available at runtime:

        mobly_test_parser <mobly_driver> <test> --hermetic --ffx-path ... [args]

    Unlike GN, no separate Python interpreter is needed: `py_binary()`
    launchers are executable, so the driver runs the test binary directly
    (`--hermetic`).

    Not supported yet (see https://fxbug.dev/585395922): hermetic test
    binaries (GN `enable_hermetic_exe`), and test environments (e.g. AEMU)
    and other infra metadata (GN `environments`, `isolated`,
    `needs_package_server`, `package_deps`, `produces_perf_results`).

    Args:
      name: The name of the host test.
      main: The main source file of the Mobly test, relative to the package.
      srcs: Optional. Other source files of the Mobly test.
      libraries: Optional. Python libraries used by the Mobly test, passed to
        the `deps` of its `py_binary()`. Mobly itself is always added.
      data: Optional. Runtime data of the Mobly test's `py_binary()`.
      main_callable: Optional. The callable to invoke after star-importing
        the module of `main`, like GN. Defaults to "test_runner.main".
      params: Optional. A dict of Mobly test params, written to a YAML (JSON)
        file. Mutually exclusive with `params_source`.
      params_source: Optional. A Mobly test params YAML file.
      honeydew_config: Optional. A dict of Honeydew configuration, written to
        a JSON file.
      local_config_source: Optional. A Mobly test config YAML file, used
        instead of the one generated by the Mobly driver.
      ssh_key_path: Optional. The SSH private key file for the Fuchsia device.
      test_data_deps: Optional. Other runtime data of the host test.
      test_cases: Optional. The Mobly test cases to run. Defaults to all.
      extra_args: Optional. Extra arguments passed to the Mobly driver.
      timeout_secs: Optional. The timeout of the Mobly test, in seconds.
      cleanup_period_secs: Optional. If set, the Mobly test is sent SIGTERM
        this many seconds before it times out. Requires `timeout_secs`.
      multi_fuchsia_device: Optional. Whether the test needs 2+ Fuchsia devices.
      target_address_type: Optional. Either "ip" or "usb".
      list_cases_argument: Optional. The argument used by `fx test` to list
        the test cases.
      tags: Optional. Tags applied to the host test and its private targets.
      target_compatible_with: Optional. Platform constraints for the
        generated targets. Defaults to HOST_OS_CONSTRAINTS.
      visibility: Optional. Visibility of the generated host test target.
      **kwargs: Other arguments passed to the Mobly test's `py_binary()`
        (e.g. `imports` or `pyi_deps`).
    """
    for arg in ("args", "deps", "binary", "test_args"):
        if arg in kwargs:
            fail("python_mobly_test() does not support `{}`.".format(arg))

    # Unlike GN, `testonly` is not supported: the host test and its private
    # targets are always testonly, and always use the testonly Mobly library.
    # Bazel should not use `testonly` except for actual tests, and rules
    # should not change their behavior based on it.
    if "testonly" in kwargs:
        fail("python_mobly_test() does not support `testonly`: Mobly tests are always testonly.")
    if params != None and params_source != None:
        fail("Only one of `params` or `params_source` can be set.")
    if target_address_type != None and target_address_type not in _VALID_TARGET_ADDRESS_TYPES:
        fail("`target_address_type` must be one of {}, got: {}".format(
            _VALID_TARGET_ADDRESS_TYPES,
            target_address_type,
        ))
    if cleanup_period_secs != None and timeout_secs == None:
        fail("`cleanup_period_secs` requires `timeout_secs`.")
    if ":" in main:
        fail("`main` must be a file path relative to the package, got: " + main)

    if target_compatible_with == None:
        target_compatible_with = HOST_OS_CONSTRAINTS
    test_tags = list(tags or [])
    private_tags = test_tags if "manual" in test_tags else test_tags + ["manual"]
    private_kwargs = {
        "tags": private_tags,
        "target_compatible_with": target_compatible_with,
        "testonly": True,
        "visibility": ["//visibility:private"],
    }

    # The Mobly test binary. Like GN, star-import the module of `main`, then
    # call `main_callable`. Generate the entry point next to `main`, so that
    # its directory, which Python and Pyrefly use as an import search path,
    # does not change.
    main_dir, _, _ = main.rpartition("/")
    binary_main = "{}{}_main_callable.py".format(
        main_dir + "/" if main_dir else "",
        name.replace("/", "_"),
    )
    host_py_test_main(
        name = name + ".main_callable",
        main = main,
        main_callable = main_callable,
        out = binary_main,
        **private_kwargs
    )

    if type(srcs) == type([]):
        # Avoid listing `main` twice. A select() is passed as is.
        srcs = [main] + [src for src in srcs if src != main]
    else:
        srcs = [main] + srcs

    binary_name = name + "_bin"
    py_binary(
        name = binary_name,
        srcs = srcs + [binary_main],
        main = binary_main,
        data = data,
        deps = libraries + [
            "//third_party/mobly",
        ],
        **(private_kwargs | kwargs)
    )

    # Runtime files of the host test, under a `<name>/` directory of its
    # runtime directory, like the GN `test_dir`. This avoids conflicts when
    # the runtime files of several Mobly tests are collected together.
    test_dir = name
    files_map = {}

    def add_runtime_file(basename, label):
        path = test_dir + "/" + basename
        files_map[path] = label
        return path

    driver_args = [
        "--ffx-path",
        _FFX_PATH,
        "--ffx-subtools-path",
        _FFX_SUBTOOLS_PATH,
        "--ssh-path",
        add_runtime_file("ssh", _SSH),
    ]

    if params != None:
        write_file(
            name = name + "_generated_params",
            out = name + "_params.json",
            content = [json.encode(params)],
            **private_kwargs
        )
        params_source = ":" + name + "_generated_params"
    if params_source != None:
        driver_args += ["--params-yaml-path", add_runtime_file("test_params.yaml", params_source)]

    if honeydew_config != None:
        write_file(
            name = name + "_generated_honeydew_config",
            out = name + "_honeydew_config.json",
            content = [json.encode(honeydew_config)],
            **private_kwargs
        )
        driver_args += [
            "--honeydew-config-json-path",
            add_runtime_file("honeydew_config.json", ":" + name + "_generated_honeydew_config"),
        ]

    if local_config_source != None:
        driver_args += ["--config-yaml-path", add_runtime_file("config.yaml", local_config_source)]

    if ssh_key_path != None:
        driver_args += ["--ssh-key", add_runtime_file("ssh_key", ssh_key_path)]

    if timeout_secs != None:
        driver_args += ["--test-timeout-sec", str(timeout_secs)]
    if cleanup_period_secs != None:
        driver_args += ["--cleanup-period-sec", str(cleanup_period_secs)]
    if multi_fuchsia_device:
        driver_args.append("--multi-device")
    if target_address_type != None:
        driver_args += ["--target-address-type", target_address_type]
    driver_args += extra_args
    if test_cases:
        driver_args += ["--test_cases"] + test_cases

    runtime_data_name = name + "_runtime_data"
    host_test_data_map(
        name = runtime_data_name,
        files_map = files_map,
        **private_kwargs
    )

    host_test(
        name = name,
        binary = _MOBLY_TEST_PARSER,
        data = [
            _MOBLY_DRIVER,
            ":" + binary_name,
            ":" + runtime_data_name,
            _FFX_TEST_DATA,
        ] + test_data_deps,
        test_args = [
            # Disable Python's output buffering, so that the Mobly test parser
            # gets the driver's output as soon as it is printed.
            "env PYTHONUNBUFFERED=1",
            "{}/$(rlocationpath {})".format(_RUNFILES_DIR, _MOBLY_DRIVER),
            "{}/$(rlocationpath :{})".format(_RUNFILES_DIR, binary_name),
            # The test binary is executable, no need for an interpreter.
            "--hermetic",
        ] + driver_args,
        list_cases_argument = list_cases_argument,
        tags = test_tags,
        target_compatible_with = target_compatible_with,
        # Like all test targets, the host test itself is implicitly testonly.
        visibility = visibility,
    )
