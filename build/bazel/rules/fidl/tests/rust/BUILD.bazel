"""Tests for FIDL Rust bindings."""

load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "test_executable_using_fidl_rust",
    testonly = True,
    srcs = ["fidl_test.rs"],
    edition = "2024",
    visibility = ["//build/bazel/rules/fidl/tests:__pkg__"],
    deps = [
        "//examples/fidl/fuchsia.examples:fuchsia.examples_rust",
        "//sdk/fidl/fuchsia.math:fuchsia.math_rust",
        # `fuchsia.math` only contains pure data types (no handles or protocols),
        # so its `_rust_next` bindings build on both Fuchsia (at all API levels)
        # and host.
        "//sdk/fidl/fuchsia.math:fuchsia.math_rust_next",
        "//sdk/fidl/fuchsia.math:fuchsia.math_rust_next_convert",
        "//sdk/fidl/fuchsia.sysmem2:fuchsia.sysmem2_rust",
    ] + select({
        # `fuchsia.examples` uses Zircon handles and protocols, which `_rust_next`
        # only supports on Fuchsia (across all API levels, but not on host).
        "@platforms//os:fuchsia": [
            "//examples/fidl/fuchsia.examples:fuchsia.examples_rust_next",
            "//examples/fidl/fuchsia.examples:fuchsia.examples_rust_next_convert",
        ],
        "//conditions:default": [],
    }) + select({
        # `_rust_fdomain_next` builds on both Fuchsia and host (where `api_level`
        # defaults to "PLATFORM"), but depends on `//src/lib/fdomain/client`,
        # which uses HEAD-only `fuchsia.fdomain` APIs and cannot be built at
        # individual IDK API levels.
        "//build/bazel/versioning:is_api_level_PLATFORM": [
            "//examples/fidl/fuchsia.examples:fuchsia.examples_rust_fdomain_next",
            "//sdk/fidl/fuchsia.math:fuchsia.math_rust_fdomain_next",
        ],
        "//conditions:default": [],
    }),
)
