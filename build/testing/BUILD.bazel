load("@rules_python//python:py_binary.bzl", "py_binary")

package(default_applicable_licenses = ["//:license"])

exports_files([
    "format_golden.sh",
])

py_binary(
    name = "verify_golden_files",
    srcs = [
        "verify_golden_files.py",
    ],
    main = "verify_golden_files.py",
    visibility = ["//build/bazel/rules:__subpackages__"],
)

py_binary(
    name = "golden_test",
    testonly = True,
    srcs = ["golden_test.py"],
    main = "golden_test.py",
    visibility = ["//build/bazel/rules/testing:__pkg__"],
)
