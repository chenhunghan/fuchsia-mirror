import("//build/bazel/bazel_test_suite.gni")
import("//build/python/python_library.gni")
import("//build/testing/python_build_time_tests.gni")

if (is_host) {
  group("tests") {
    testonly = true
    deps = [
      ":apt_test($host_toolchain)",
      ":auth_env_test($host_toolchain)",
      ":bazel_tests",
      ":gcloud_creds_test($host_toolchain)",
      ":gcloud_test($host_toolchain)",
      ":loas_test($host_toolchain)",
      ":select_auth_method_test($host_toolchain)",
    ]
  }

  bazel_test_suite("bazel_tests") {
    host_tests = [
      "//build/auth:apt_test",
      "//build/auth:auth_env_test",
      "//build/auth:gcloud_creds_test",
      "//build/auth:gcloud_test",
      "//build/auth:loas_test",
      "//build/auth:select_auth_method_test",
    ]
  }

  # GN copies of the host_py_test() targets in BUILD.bazel, which bazel2gn
  # can't translate yet. These run the same tests at build time.
  python_build_time_tests("auth_env_test") {
    tests = [ "auth_env_test.py" ]
    inputs = [ "auth_env.py" ]
    deps = [ ":auth_env" ]
  }

  python_build_time_tests("apt_test") {
    tests = [ "apt_test.py" ]
    inputs = [ "apt.py" ]
    deps = [ ":apt" ]
  }

  python_build_time_tests("gcloud_test") {
    tests = [ "gcloud_test.py" ]
    inputs = [ "gcloud.py" ]
    deps = [ ":gcloud" ]
  }

  python_build_time_tests("gcloud_creds_test") {
    tests = [ "gcloud_creds_test.py" ]
    inputs = [ "gcloud_creds.py" ]
    deps = [
      ":apt",
      ":gcloud",
      ":gcloud_creds",
    ]
  }

  python_build_time_tests("loas_test") {
    tests = [ "loas_test.py" ]
    inputs = [ "loas.py" ]
    deps = [ ":loas" ]
  }

  python_build_time_tests("select_auth_method_test") {
    tests = [ "select_auth_method_test.py" ]
    deps = [
      ":gcloud",
      ":loas",
      ":select_auth_method",
    ]
  }
} else {
  # If evaluated on the target toolchain (e.g. via fx add-test), redirect the
  # target's evaluation cleanly and safely to the host toolchain.
  group("tests") {
    testonly = true
    deps = [ ":tests($host_toolchain)" ]
  }
}

