load("@fuchsia_build_config//:defs.bzl", "build_config")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load(
    "//build/bazel/rules:cipd_prebuilt.bzl",
    "cipd_prebuilt_directory",
    "cipd_prebuilt_file",
)

package(default_applicable_licenses = ["//:license"])

# Centralized Bazel targets for CIPD-managed host prebuilts under //prebuilt/.

cipd_prebuilt_directory(
    name = "clang",
    path = "//prebuilt/third_party/clang/%s" % build_config.host_tag,
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//:__subpackages__"],
)

cipd_prebuilt_file(
    name = "gn",
    path = "//prebuilt/third_party/gn/%s/gn" % build_config.host_tag,
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//:__subpackages__"],
)

cipd_prebuilt_file(
    name = "jq",
    path = "//prebuilt/third_party/jq/%s/bin/jq" % build_config.host_tag,
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//:__subpackages__"],
)

cipd_prebuilt_file(
    name = "shac",
    path = "//prebuilt/tools/shac/shac",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//:__subpackages__"],
)
