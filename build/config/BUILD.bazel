        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)
# LINT.ThenChange(BUILD.gn:executable_config)

# LINT.IfChange(default_libs)
build_flags(
    name = "default_libs",
    visibility = ["//visibility:public"],
