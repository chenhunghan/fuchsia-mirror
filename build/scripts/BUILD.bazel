load("@rules_python//python:py_library.bzl", "py_library")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_py_test.bzl", "host_py_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "host_tests",
    tests = [],  # Include all tests in the package.
    visibility = ["//build:__pkg__"],
)

py_library(
    name = "lock_utils",
    srcs = ["lock_utils.py"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//build/rbe:__pkg__",
        "//tools/devshell/fx_cli:__pkg__",
    ],
    deps = ["//build/profile:procfs"],
)

host_py_test(
    name = "lock_utils_test",
    srcs = ["lock_utils_test.py"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        ":lock_utils",
        "//build/profile:procfs_test_utils",
    ],
)
