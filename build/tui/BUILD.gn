import("//build/python/python_library.gni")
import("//build/testing/python_build_time_tests.gni")

if (is_host) {
  python_library("build_tui_wrap") {
    sources = [ "build_tui_wrap.py" ]
  }

  python_build_time_tests("build_tui_wrap_test") {
    tests = [ "build_tui_wrap_test.py" ]
    deps = [ ":build_tui_wrap" ]
  }
}

group("tests") {
  testonly = true
  deps = [ ":build_tui_wrap_test($host_toolchain)" ]
}
