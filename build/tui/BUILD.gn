import("//build/python/python_library.gni")
import("//build/testing/python_build_time_tests.gni")

if (is_host) {
  # GN copy of the host_py_test() target in BUILD.bazel, which bazel2gn
  # can't translate yet. This runs the same test at build time.
  python_build_time_tests("build_tui_wrap_test") {
    tests = [ "build_tui_wrap_test.py" ]
    deps = [
      ":build_tui_wrap",
      "//build/bazel/scripts:build_utils",
    ]
  }
}

group("tests") {
  testonly = true
  deps = [ ":build_tui_wrap_test($host_toolchain)" ]
}

