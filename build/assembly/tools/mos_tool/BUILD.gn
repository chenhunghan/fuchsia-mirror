assert(is_host, "bazel_host_tool() can only be called in a host toolchain.")

import("//build/bazel/bazel_host_tool.gni")

bazel_host_tool("mos_tool") {
  bazel_target = ":mos_tool"
  bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/mos-tool"
  output_name = "mos-tool"
  install_host_tool = true
}

group("host") {
  deps = [ ":mos_tool" ]
}
