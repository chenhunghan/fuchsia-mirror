assert(is_host, "This tool is only applicable on the host toolchain")

import("//build/bazel/bazel_host_tool.gni")
import("//build/sdk/sdk_host_tool.gni")

bazel_host_tool("assembly_config") {
  bazel_target = ":assembly_config"
  bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/assembly_config"
}

# TODO(https://fxbug.dev/438572714): Remove once the IDK uses the Bazel atom.
sdk_host_tool("assembly_config_sdk") {
  category = "partner"
  output_name = "assembly_config"
  sdk_area = "Product Assembly"
  deps = [ ":assembly_config" ]
}
