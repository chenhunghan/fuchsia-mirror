load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/idk:idk_host_tool.bzl", "idk_rustc_binary_host_tool")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [":assembly_config_test"],
    visibility = ["//build:__pkg__"],
)

idk_rustc_binary_host_tool(
    name = "assembly_config",
    srcs = [
        "src/board_config.rs",
        "src/board_input_bundle.rs",
        "src/board_input_bundle_set.rs",
        "src/main.rs",
        "src/partitions_config.rs",
        "src/platform_artifacts.rs",
        "src/product_config.rs",
        "src/product_input_bundle.rs",
    ],
    api_area = "Product Assembly",
    category = "partner",
    edition = "2024",
    idk_name = "assembly_config",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//build/bazel/rules/assembly:__pkg__",
    ],
    deps = [
        "//src/lib/assembly/config_schema",
        "//src/lib/assembly/container",
        "//src/lib/assembly/partitions_config",
        "//src/lib/assembly/platform_artifacts",
        "//src/lib/assembly/product_input_bundle",
        "//src/lib/assembly/release_info",
        "//src/lib/assembly/util",
        "//src/lib/depfile",
        "//src/starnix/lib/starnix_container",
        "//src/sys/pkg/lib/far/rust:fuchsia-archive",
        "//src/sys/pkg/lib/fuchsia-pkg",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:camino",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:tempfile",
    ],
)

host_rustc_test(
    name = "assembly_config_test",
    crate = ":assembly_config",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        "//src/lib/fuchsia-url",
        "//src/lib/versioning/version-history/rust",
        "//third_party/rust_crates/vendor:itertools",
        "//third_party/rust_crates/vendor:serde_json",
    ],
)
