import("//build/python/python_host_test.gni")
import("//build/python/python_library.gni")
import("//build/testing/host_test_data.gni")

if (is_host) {
  # Planter runs the checks and tools in //build/beads/planter/machinery
  # directly from the source tree, not through the build. This target
  # declares their Python sources so that the opt-out from type checking is
  # explicit. They aren't annotated for mypy's strict mode yet.
  python_library("checks") {
    testonly = true
    enable_mypy = false
    sources = [
      "bazel_minimality_test.py",
      "planter_check_lib.py",
      "planter_check_lib_test.py",
      "planter_version_test.py",
      "rdeps_lib.py",
      "verify_tests_json_parity.py",
      "verify_tests_json_parity_test.py",
    ]
  }

  host_test_data("check_scripts_test_data") {
    sources = [
      "commit_message_format.sh",
      "cq_reachability.sh",
      "planter_check_lib.py",
    ]
    outputs = [ "$target_out_dir/check_scripts/{{source_file_part}}" ]
  }

  python_host_test("verify_tests_json_parity_test") {
    main_source = "verify_tests_json_parity_test.py"
    main_callable = "main"
    sources = [ "verify_tests_json_parity.py" ]
    extra_args =
        [ "--checks-dir=" +
          rebase_path("$target_out_dir/check_scripts", root_build_dir) ]
    test_data_deps = [ ":check_scripts_test_data" ]
  }
}

group("tests") {
  testonly = true
  deps = [ ":verify_tests_json_parity_test($host_toolchain)" ]
}
