import("//build/go/go_binary.gni")
import("//build/python/python_library.gni")
import("//build/testing/host_test_data.gni")

# LINT.IfChange

if (is_host) {
  # Python scripts in this directory that aren't part of any other GN Python
  # target because their test has been migrated to a Bazel host_py_test()
  # target. Listing them here makes them subject to GN mypy type checking as
  # required by //build/shac.star.
  python_library("type_checked_scripts") {
    testonly = true
    visibility = [ ":*" ]
    sources = [
      "verify_golden_go_proto_file.py",
      "verify_golden_go_proto_file_test.py",
    ]
  }

  go_binary("pprof") {
    gopackage = "cmd/pprof"
  }

  host_test_data("pprof_test_data") {
    sources = get_target_outputs(":pprof")
    deps = [ ":pprof" ]
  }
}

# LINT.ThenChange(BUILD.bazel)

# Used to restrict the set of `go_build` targets that can set `gopackages`.
# TODO(https://fxbug.dev/42153429): Enforce that only third-party libraries can use
# `gopackages` and recursive sources.
group("allow_gopackages") {
  # WARNING: Only third-party libraries should be added here.
  visibility = [
    ":pprof",
    "//src/testing/fuzzing/syzkaller:syz-sysgen",
    "//third_party/golibs/*",
  ]
}

group("tests") {
  testonly = true
  deps = [ ":type_checked_scripts($host_toolchain)" ]
}
