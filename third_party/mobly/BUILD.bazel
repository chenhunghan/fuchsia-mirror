load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:py_library.bzl", "py_library")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")

package(default_applicable_licenses = [":license"])

# Third-party license metadata is Bazel-only; GN tracks licensing via README.fuchsia.
license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
    license_text = "src/LICENSE",
)

# LINT.IfChange(mobly)
alias(
    name = "mobly",
    testonly = True,
    actual = ":mobly_no_testonly",
    visibility = ["//:__subpackages__"],
)

py_library(
    name = "mobly_no_testonly",
    srcs = [
        "src/mobly/__init__.py",
        "src/mobly/asserts.py",
        "src/mobly/base_instrumentation_test.py",
        "src/mobly/base_suite.py",
        "src/mobly/base_test.py",
        "src/mobly/config_parser.py",
        "src/mobly/controller_manager.py",
        "src/mobly/controllers/__init__.py",
        "src/mobly/controllers/android_device.py",
        "src/mobly/controllers/android_device_lib/__init__.py",
        "src/mobly/controllers/android_device_lib/adb.py",
        "src/mobly/controllers/android_device_lib/apk_utils.py",
        "src/mobly/controllers/android_device_lib/callback_handler_v2.py",
        "src/mobly/controllers/android_device_lib/errors.py",
        "src/mobly/controllers/android_device_lib/fastboot.py",
        "src/mobly/controllers/android_device_lib/jsonrpc_shell_base.py",
        "src/mobly/controllers/android_device_lib/logcat_processor.py",
        "src/mobly/controllers/android_device_lib/service_manager.py",
        "src/mobly/controllers/android_device_lib/services/__init__.py",
        "src/mobly/controllers/android_device_lib/services/base_service.py",
        "src/mobly/controllers/android_device_lib/services/logcat.py",
        "src/mobly/controllers/android_device_lib/services/snippet_management_service.py",
        "src/mobly/controllers/android_device_lib/snippet_client_v2.py",
        "src/mobly/controllers/attenuator.py",
        "src/mobly/controllers/attenuator_lib/__init__.py",
        "src/mobly/controllers/attenuator_lib/minicircuits.py",
        "src/mobly/controllers/attenuator_lib/telnet_scpi_client.py",
        "src/mobly/controllers/iperf_server.py",
        "src/mobly/controllers/sniffer.py",
        "src/mobly/controllers/sniffer_lib/__init__.py",
        "src/mobly/controllers/sniffer_lib/local/__init__.py",
        "src/mobly/controllers/sniffer_lib/local/local_base.py",
        "src/mobly/controllers/sniffer_lib/local/tcpdump.py",
        "src/mobly/controllers/sniffer_lib/local/tshark.py",
        "src/mobly/expects.py",
        "src/mobly/keys.py",
        "src/mobly/logger.py",
        "src/mobly/records.py",
        "src/mobly/runtime_test_info.py",
        "src/mobly/signals.py",
        "src/mobly/snippet/__init__.py",
        "src/mobly/snippet/callback_event.py",
        "src/mobly/snippet/callback_handler_base.py",
        "src/mobly/snippet/client_base.py",
        "src/mobly/snippet/errors.py",
        "src/mobly/suite_runner.py",
        "src/mobly/test_runner.py",
        "src/mobly/utils.py",
    ],
    imports = ["src"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    # In-tree-only tests should prefer ":mobly" because that enforces that only
    # testonly code uses regular Mobly. This target should be used for tests or
    # dependencies of tests that are packaged into the SDK, since they cannot be
    # testonly.
    visibility = [
        "//src/testing/end_to_end/mobly_base_tests/fuchsia_async_extension:__pkg__",
        "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test:__pkg__",
        "//src/testing/end_to_end/mobly_base_tests/mobly_logger_extension:__pkg__",
        "//src/testing/end_to_end/mobly_driver:__pkg__",

        # SDK-based test targets listed below.
        "//src/tests/end_to_end/rtc:__pkg__",
    ],
    pyi_deps = ["//src/testing/end_to_end/stubs:mobly"],
    deps = [
        "//third_party/python_portpicker:portpicker",
        "//third_party/pyyaml:yaml",
    ],
)
# LINT.ThenChange(BUILD.gn:mobly)
