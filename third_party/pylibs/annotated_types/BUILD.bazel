load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:py_library.bzl", "py_library")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")

package(default_applicable_licenses = [":license"])

# GN does not use per-package license() targets.
# @bazel2gn:skip
license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
    license_text = "src/LICENSE",
)

# GN python_library() lists py.typed in sources rather than data.
# @bazel2gn:raw_attribute:sources += [ "src/annotated_types/py.typed" ]
py_library(
    name = "annotated_types",
    srcs = [
        "src/annotated_types/__init__.py",
        "src/annotated_types/test_cases.py",
    ],
    # GN python_library() lists py.typed in sources rather than data.
    # @bazel2gn:skip
    data = ["src/annotated_types/py.typed"],
    imports = ["src"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//third_party/pylibs/pydantic:__pkg__",
    ],
)
