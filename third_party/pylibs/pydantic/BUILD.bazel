        "src/pydantic/type_adapter.py",
        "src/pydantic/types.py",
        "src/pydantic/typing.py",
        "src/pydantic/utils.py",
        "src/pydantic/validate_call_decorator.py",
        "src/pydantic/validators.py",
        "src/pydantic/version.py",
        "src/pydantic/warnings.py",
    ],
    # Non-.py files (py.typed) are passed via data in Bazel and added to GN sources via raw_attribute.
    # @bazel2gn:skip
    data = ["src/pydantic/py.typed"],
    imports = ["src"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//scripts/debug/zxdb_cli/shared:__pkg__",
        "//src/lib/debug/dap/python:__pkg__",
