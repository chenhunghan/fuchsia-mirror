load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:py_library.bzl", "py_library")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")

package(default_applicable_licenses = [":license"])

# License targets are Bazel-only and have no GN equivalent.
# @bazel2gn:skip
license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:0BSD",
        "@rules_license//licenses/spdx:PSF-2.0",
    ],
    license_text = "src/LICENSE",
)

# The upstream tests in src/src are not part of the library: with
# `imports = ["src/src"]`, they would be importable as top-level modules.
py_library(
    name = "typing_extensions",
    srcs = ["src/src/typing_extensions.py"],
    imports = ["src/src"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        # Generated by //tools/build/scripts/extract_pydantic_core_wheel.sh in
        # gitignored //prebuilt/third_party/pydantic-core/BUILD.gn.
        "//prebuilt/third_party/pydantic-core:__pkg__",
        "//third_party/pylibs/pydantic:__pkg__",
    ],
)
