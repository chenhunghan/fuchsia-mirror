load("@fuchsia_rules_common//build_flags:build_flags.bzl", "build_flags")
load("@rules_license//rules:license.bzl", "license")
load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")

package(default_applicable_licenses = [":license"])

# @bazel2gn:skip
license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Libpng"],
    license_text = "src/LICENSE",
)

# LINT.IfChange(clang_warnings)
# NOTE: This assumes is_gcc=false in Bazel.
# build_flags() definitions are hand-ported rather than synced by bazel2gn.
# @bazel2gn:skip
build_flags(
    name = "clang_warnings",
    cflags = [
        "-Wno-conversion",
        "-Wno-implicit-fallthrough",
        "-Wno-sign-compare",
        "-Wno-null-pointer-subtraction",

        # libpng checks that the width is not greater than PNG_SIZE_MAX.
        # On platforms where size_t is 64-bits, this comparison will always
        # be false.
        "-Wno-tautological-constant-out-of-range-compare",
        "-Wno-unused-but-set-parameter",
        "-Wno-unused-but-set-variable",
    ],
)
# LINT.ThenChange(BUILD.gn:clang_warnings)

# Bazel only targets 64-bit x86_64 and arm64 (where NEON is always enabled),
# whereas BUILD.gn preserves the 32-bit x86/arm and arm_use_neon conditions in
# case x86 or non-NEON support is needed later.
# @bazel2gn:raw_attribute:if (current_cpu == "x86" || current_cpu == "x64") { sources += [ "src/intel/filter_sse2_intrinsics.c", "src/intel/intel_init.c" ] defines += [ "PNG_INTEL_SSE_OPT=1" ] } else if ((current_cpu == "arm" || current_cpu == "arm64") && arm_use_neon) { sources += [ "src/arm/arm_init.c", "src/arm/filter_neon_intrinsics.c", "src/arm/palette_neon_intrinsics.c" ] defines += [ "PNG_ARM_NEON_OPT=2", "PNG_ARM_NEON_IMPLEMENTATION=1" ] }
fx_cc_library(
    name = "libpng",
    srcs = [
        "src/png.c",
        "src/pngerror.c",
        "src/pngget.c",
        "src/pngmem.c",
        "src/pngpread.c",
        "src/pngread.c",
        "src/pngrio.c",
        "src/pngrtran.c",
        "src/pngrutil.c",
        "src/pngset.c",
        "src/pngtrans.c",
        "src/pngwio.c",
        "src/pngwrite.c",
        "src/pngwtran.c",
        "src/pngwutil.c",
    ] + select({
        "@platforms//cpu:arm64": [
            "src/arm/arm_init.c",
            "src/arm/filter_neon_intrinsics.c",
            "src/arm/palette_neon_intrinsics.c",
        ],
        "@platforms//cpu:x86_64": [
            "src/intel/filter_sse2_intrinsics.c",
            "src/intel/intel_init.c",
        ],
        "//conditions:default": [],
        # CPU-specific sources are appended via the raw_attribute block in GN.
    }),  # @bazel2gn:raw_overwrite:[ "src/png.c", "src/pngerror.c", "src/pngget.c", "src/pngmem.c", "src/pngpread.c", "src/pngread.c", "src/pngrio.c", "src/pngrtran.c", "src/pngrutil.c", "src/pngset.c", "src/pngtrans.c", "src/pngwio.c", "src/pngwrite.c", "src/pngwtran.c", "src/pngwutil.c" ]
    hdrs = [
        "pnglibconf.h",
        "src/png.h",
        "src/pngconf.h",
        "src/pngdebug.h",
        "src/pnginfo.h",
        "src/pngpriv.h",
        "src/pngstruct.h",
    ],
    build_flags = [":clang_warnings"],
    defines = select({
        "@platforms//cpu:arm64": [
            "PNG_ARM_NEON_OPT=2",
            "PNG_ARM_NEON_IMPLEMENTATION=1",
        ],
        "@platforms//cpu:x86_64": [
            "PNG_INTEL_SSE_OPT=1",
        ],
        "//conditions:default": [],
        # CPU-specific defines are appended via the raw_attribute block in GN.
    }),  # @bazel2gn:raw_overwrite:[]
    includes = [
        ".",
        "src",
    ],
    public_configs = [":libpng_config"],
    visibility = [
        "//src/camera/bin/factory:__pkg__",
        "//src/ui/examples/simplest_sysmem:__pkg__",
        "//src/ui/scenic/lib/image-compression:__subpackages__",
        "//src/ui/testing/util:__pkg__",
        "//third_party/freetype2:__pkg__",
    ],
    deps = ["//third_party/zlib"],
    alwayslink = True,
)
