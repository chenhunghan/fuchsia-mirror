load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:py_library.bzl", "py_library")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")

package(default_applicable_licenses = [":license"])

# Bazel license metadata has no GN equivalent target.
# @bazel2gn:skip
license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
    license_text = "src/LICENSE",
)

# TODO(https://fxbug.dev/570694755): Verify whether tenacity should use target_compatible_with (was not gated by if (is_host) in GN).
py_library(
    name = "tenacity",
    srcs = [
        "src/tenacity/__init__.py",
        "src/tenacity/_utils.py",
        "src/tenacity/after.py",
        "src/tenacity/asyncio/__init__.py",
        "src/tenacity/asyncio/retry.py",
        "src/tenacity/before.py",
        "src/tenacity/before_sleep.py",
        "src/tenacity/nap.py",
        "src/tenacity/retry.py",
        "src/tenacity/stop.py",
        "src/tenacity/tornadoweb.py",
        "src/tenacity/wait.py",
    ],
    imports = ["src"],
    # Fuchsia Bazel only provides a host Python toolchain; the sole caller (legacy_access_point)
    # is also host-only (was not gated by if (is_host) in GN).
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//src/testing/end_to_end/mobly_controller/legacy_access_point:__pkg__",
    ],
)
