load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")

package(default_applicable_licenses = ["//:license"])

fx_cc_library(
    name = "vulkan_headers",
    hdrs = glob([
        "src/include/vk_video/*.h",
        "src/include/vulkan/*.h",
        "src/include/vulkan/*.hpp",
    ]),
    defines = (
        ["VULKAN_HPP_NO_EXCEPTIONS"] + select({
            "@platforms//os:fuchsia": ["VK_USE_PLATFORM_FUCHSIA"],
            "//conditions:default": [],
        })
    ),
    includes = ["src/include"],
    visibility = ["//:__subpackages__"],
)
