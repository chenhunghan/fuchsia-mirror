# The definitions in BUILD.gn are too complex for bazel2gn (due to the
# copy() target, target(default_library_type, ...), and package-local configs).
# Keep these files manually synchronized.
#
# GN builds `libpcap` as `default_library_type`: a shared library (libpcap.so)
# on Fuchsia and a static library on Linux. `:libpcap` mirrors this by
# resolving to `:libpcap_import` (wrapping `:libpcap_shared`) on Fuchsia and
# to `:libpcap_static` on Linux.

load("@fuchsia_rules_common//build_flags:build_flags.bzl", "build_flags")
load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_license//rules:license.bzl", "license")
load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//build/bazel/rules/cc:fx_cc_library_headers.bzl", "fx_cc_library_headers")
load("//build/bazel/rules/cc:fx_cc_shared_library.bzl", "fx_cc_shared_library")

package(default_applicable_licenses = [":license"])

license(
    name = "license",
    package_name = "libpcap",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
    license_text = "src/LICENSE",
)

# LINT.IfChange
_FUCHSIA_OR_LINUX_ONLY = select({
    "@platforms//os:fuchsia": [],
    "@platforms//os:linux": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

alias(
    name = "libpcap",
    actual = select({
        "@platforms//os:fuchsia": ":libpcap_import",
        "//conditions:default": ":libpcap_static",
    }),
    target_compatible_with = _FUCHSIA_OR_LINUX_ONLY,
    # Scoped to the current GN dependents of //third_party/libpcap.
    visibility = [
        "//src/connectivity/network/lib/pcap:__pkg__",
        "//third_party/libpcap/tests:__pkg__",
        "//third_party/tcpdump:__pkg__",
    ],
)

fx_cc_library(
    name = "libpcap_static",
    srcs = [
        "src/bpf_dump.c",
        "src/bpf_filter.c",
        "src/bpf_image.c",
        "src/etherent.c",
        "src/fad-getad.c",
        "src/fmtutils.c",
        "src/gencode.c",
        "src/grammar.c",
        "src/nametoaddr.c",
        "src/optimize.c",
        "src/pcap-common.c",
        "src/pcap-util.c",
        "src/pcap.c",
        "src/savefile.c",
        "src/scanner.c",
        "src/sf-pcap.c",
        "src/sf-pcapng.c",
        ":copy_config",
    ] + glob(["src/*.h"]) + select({
        "@platforms//os:fuchsia": [
            # To build for the null-platform, use `src/pcap-null.c` instead of
            # `pcap-fuchsia.{c,cc}`.
            "pcap-fuchsia.c",
            "pcap-fuchsia.cc",
            "pcap-fuchsia.h",
        ],
        "@platforms//os:linux": [
            "src/missing/strlcat.c",
            "src/missing/strlcpy.c",
            "src/pcap-linux.c",
        ],
        "//conditions:default": [],
    }),
    # NOTE: This assumes is_gcc=false in Bazel.
    copts = [
        # For config.h, which is generated by :copy_config.
        "-I$(BINDIR)/" + package_name(),
    ] + select({
        "@platforms//os:fuchsia": ["-I" + package_name()],
        "//conditions:default": [],
    }),
    build_flags = [":suppress_warnings"],
    local_defines = [
        "HAVE_CONFIG_H",
        "BUILDING_PCAP",
        "pcap_EXPORTS",
        # Use Clang-compatible syntax even with higher __GNUC__ predefine.
        # Bazel shell-tokenizes defines, so single-quote the value to keep the
        # double quotes around "undefined".
        "'no_sanitize_undefined=no_sanitize(\"undefined\")'",
    ] + select({
        "@platforms//os:linux": ["_GNU_SOURCE"],
        "//conditions:default": [],
    }),
    target_compatible_with = _FUCHSIA_OR_LINUX_ONLY,
    visibility = ["//visibility:private"],
    implementation_deps = ["//sdk/lib/fit"],
    deps = [":headers"],
    # Link every object into :libpcap_shared on Fuchsia; keep a plain static
    # library on Linux.
    alwayslink = select({
        "@platforms//os:fuchsia": True,
        "//conditions:default": False,
    }),
)

fx_cc_shared_library(
    name = "libpcap_shared",
    shared_lib_name = "libpcap.so",
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = ["//visibility:private"],
    deps = [":libpcap_static"],
)

# rules_cc and rules_rust `deps` / `link_deps` require `CcInfo`, which
# `cc_shared_library()` doesn't provide, so `:libpcap` uses this wrapper on
# Fuchsia.
cc_import(
    name = "libpcap_import",
    shared_library = ":libpcap_shared",
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = ["//visibility:private"],
    deps = [":headers"],
)

genrule(
    name = "copy_config",
    srcs = select({
        "@platforms//os:fuchsia": ["config.h.fuchsia"],
        "@platforms//os:linux": ["config.h.linux"],
    }),
    outs = ["config.h"],
    cmd = "cp $< $@",
    target_compatible_with = _FUCHSIA_OR_LINUX_ONLY,
)

fx_cc_library_headers(
    name = "headers",
    hdrs = [
        "src/pcap.h",
        "src/pcap/bpf.h",
        "src/pcap/can_socketcan.h",
        "src/pcap/compiler-tests.h",
        "src/pcap/dlt.h",
        "src/pcap/funcattrs.h",
        "src/pcap/ipnet.h",
        "src/pcap/namedb.h",
        "src/pcap/nflog.h",
        "src/pcap/pcap.h",
        "src/pcap/pcap-inttypes.h",
        "src/pcap/sll.h",
        "src/pcap/socket.h",
        "src/pcap/usb.h",
        "src/pcap/vlan.h",
    ],
    include_dir = "src",
)

build_flags(
    name = "suppress_warnings",
    cflags = [
        "-Wno-implicit-fallthrough",
        "-Wno-int-conversion",
        "-Wno-unused-but-set-variable",
        "-Wno-implicit-int-conversion",
    ] + select({
        "@platforms//os:linux": ["-Wno-macro-redefined"],
        "//conditions:default": [],
    }),
)
# LINT.ThenChange(BUILD.gn)
