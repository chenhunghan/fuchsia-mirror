load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:py_library.bzl", "py_library")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")

package(default_applicable_licenses = [":license"])

# Bazel license() metadata has no GN counterpart.
# @bazel2gn:skip
license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:BSD-2-Clause"],
    license_text = "src/LICENSE.txt",
)

# TODO(https://fxbug.dev/570694755): Verify whether parameterized should use target_compatible_with (was not gated by if (is_host) in GN).
py_library(
    name = "parameterized",
    srcs = [
        "src/parameterized/__init__.py",
        "src/parameterized/parameterized.py",
    ],
    imports = ["src"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//build/assembly/scripts:__pkg__",
        "//build/packages:__pkg__",
        "//scripts/fxtest/python:__pkg__",
        "//src/memory:__subpackages__",
        "//src/performance:__subpackages__",
        "//src/testing/end_to_end:__subpackages__",
        "//tools/devshell/python/status:__pkg__",
        "//vendor/google:__subpackages__",
    ],
)
