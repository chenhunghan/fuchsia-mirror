load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")

package(default_applicable_licenses = ["//:license"])

fx_cc_library(
    name = "volk_headers_only",
    hdrs = ["src/volk.h"],
    # In GN, VOLK_IMPLEMENTATION is provided by :volk_headers_only_config in public_configs.
    # @bazel2gn:skip
    defines = ["VOLK_IMPLEMENTATION"],
    includes = ["src"],
    public_configs = [":volk_headers_only_config"],
    # volk.h #includes "volk.c" when VOLK_IMPLEMENTATION is defined; GN discovers it via depfiles.
    # @bazel2gn:skip
    textual_hdrs = ["src/volk.c"],
    visibility = [":__subpackages__"],
    deps = ["//third_party/Vulkan-Headers:vulkan_headers"],
    alwayslink = True,
)

fx_cc_library(
    name = "volk",
    srcs = ["src/volk.c"],
    hdrs = ["src/volk.h"],
    includes = ["src"],
    public_configs = [":volk_config"],
    visibility = [":__subpackages__"],
    deps = ["//third_party/Vulkan-Headers:vulkan_headers"],
    alwayslink = True,
)
