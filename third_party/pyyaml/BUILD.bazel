load("@rules_license//rules:license.bzl", "license")
load("@rules_python//python:py_library.bzl", "py_library")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")

package(default_applicable_licenses = [":license"])

# Third-party license metadata is Bazel-only; GN tracks licensing via README.fuchsia.
# @bazel2gn:skip
license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
    license_text = "src/LICENSE",
)

py_library(
    name = "yaml",
    srcs = [
        "src/lib/yaml/__init__.py",
        "src/lib/yaml/composer.py",
        "src/lib/yaml/constructor.py",
        "src/lib/yaml/cyaml.py",
        "src/lib/yaml/dumper.py",
        "src/lib/yaml/emitter.py",
        "src/lib/yaml/error.py",
        "src/lib/yaml/events.py",
        "src/lib/yaml/loader.py",
        "src/lib/yaml/nodes.py",
        "src/lib/yaml/parser.py",
        "src/lib/yaml/reader.py",
        "src/lib/yaml/representer.py",
        "src/lib/yaml/resolver.py",
        "src/lib/yaml/scanner.py",
        "src/lib/yaml/serializer.py",
        "src/lib/yaml/tokens.py",
    ],
    imports = ["src/lib"],
    # Bazel only registers a host Python toolchain; GN python_library is not gated on is_host.
    target_compatible_with = HOST_OS_CONSTRAINTS,  # @bazel2gn:skip
    visibility = [
        "//build/dart:__pkg__",
        "//build/drivers:__pkg__",
        "//build/sdk/generate_prebuild_idk:__pkg__",
        "//build/sdk/sdk_common:__pkg__",
        "//scripts/skill_linter:__pkg__",
        "//sdk/lib/c/include:__pkg__",
        "//third_party/mesa-migrating/build/src/util/format:__pkg__",
        "//third_party/mobly:__pkg__",
        "//vendor/google:__subpackages__",
    ],
)
