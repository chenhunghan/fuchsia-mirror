load("@com_google_protobuf//bazel:proto_library.bzl", "proto_library")
load("@io_bazel_rules_go//proto:compiler.bzl", "go_proto_compiler")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")

package(default_applicable_licenses = ["//:license"])

proto_library(
    name = "resultsink_proto",
    srcs = [
        "location_tag.proto",
        "sink.proto",
        "test_exoneration.proto",
        "test_result.proto",
    ],
    strip_import_prefix = "/third_party/luci-go",
    deps = [
        "//third_party/luci-go/resultdb/proto/v1:resultdb_proto",
        "@com_google_protobuf//:duration_proto",
        "@com_google_protobuf//:empty_proto",
        "@com_google_protobuf//:field_mask_proto",
        "@com_google_protobuf//:struct_proto",
        "@com_google_protobuf//:timestamp_proto",
    ],
)

go_proto_compiler(
    name = "protoc-gen-go",
    plugin = "//third_party/golibs/vendor/google.golang.org/protobuf/cmd/protoc-gen-go",
)

# TODO: Sync back go_library to GN (b/540745047)
# @bazel2gn:skip
go_proto_library(
    name = "resultsink_proto_go",
    compilers = [":protoc-gen-go"],
    importpath = "go.chromium.org/luci/resultdb/sink/proto/v1",
    proto = ":resultsink_proto",
    target_compatible_with = HOST_CONSTRAINTS,
    visibility = ["//tools/testing/resultdb:__pkg__"],
    deps = [
        "//third_party/golibs/vendor/google.golang.org/protobuf/reflect/protoreflect",
        "//third_party/golibs/vendor/google.golang.org/protobuf/runtime/protoimpl",
        "//third_party/golibs/vendor/google.golang.org/protobuf/types/known/durationpb",
        "//third_party/golibs/vendor/google.golang.org/protobuf/types/known/emptypb",
        "//third_party/golibs/vendor/google.golang.org/protobuf/types/known/fieldmaskpb",
        "//third_party/golibs/vendor/google.golang.org/protobuf/types/known/structpb",
        "//third_party/golibs/vendor/google.golang.org/protobuf/types/known/timestamppb",
        "//third_party/luci-go/resultdb/proto/v1:resultdb_proto_go",
    ],
)
