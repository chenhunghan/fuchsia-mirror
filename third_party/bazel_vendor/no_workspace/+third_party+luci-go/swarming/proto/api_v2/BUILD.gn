import("//build/go/go_library.gni")
import("//third_party/protobuf/proto_library.gni")

_protos = [
  "swarming",
]

proto_library("swarming_proto") {
  sources = []
  foreach(name, _protos) {
    sources += [ "${name}.proto" ]
  }
  proto_in_dir = "//third_party/luci-go"
  import_protobuf_full = true
  generate_python = false
  generate_cc = false
  generate_go = true
}

go_library("swarming_proto_go") {
  name = "go.chromium.org/luci/swarming/proto/api_v2"
  here = rebase_path(".", "//")
  source_dir = "$root_gen_dir/go-proto-gen/src/$here"
  non_go_deps = [ ":swarming_proto" ]
  sources = []

  foreach(name, _protos) {
    sources += [ "${name}.pb.go" ]
  }
}
