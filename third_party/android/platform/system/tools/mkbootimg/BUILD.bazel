# Android provides a BUILD.bazel file in src/, but we override it with our own
# (via --deleted_packages in template.bazelrc) because the upstream file does
# not export gki/generate_gki_certificate.py, which mkbootimg.py imports.
exports_files(
    [
        "src/gki/generate_gki_certificate.py",
        "src/mkbootimg.py",
    ],
    visibility = ["//:__subpackages__"],
)
