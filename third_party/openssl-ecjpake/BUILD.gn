import("//build/tools/bazel2gn/bazel_migration.gni")

source_set("openssl-ecjpake") {
  sources = [
    "src/ecjpake.c",
    "src/ecjpake_err.c",
  ]
  public = [ "src/openssl/ecjpake.h" ]
  configs += [ ":openssl-ecjpake_warnings" ]
  public_configs = [ ":openssl-ecjpake_config" ]
  visibility = [
    ":*",
    "//third_party/openweave-core/src/include:*",
  ]
  public_deps = [ "//third_party/boringssl" ]
}

cc_test_executable("openssl-ecjpake_test") {
  sources = [ "src/ecjpaketest.c" ]
  configs += [ ":openssl-ecjpake_test_config" ]
  deps = [
    ":openssl-ecjpake",
    "//third_party/boringssl",
  ]
  deps += [ "//src/sys/testing/elftest" ]
  testonly = true
  emit_tool_path = false
}

fuchsia_unittest_package("openssl-ecjpake_tests") {
  package_name = "openssl-ecjpake_tests-gn"
  component_name = "openssl-ecjpake_tests"
  deps = [ ":openssl-ecjpake_test" ]
}
