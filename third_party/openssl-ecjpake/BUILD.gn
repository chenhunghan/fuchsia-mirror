# LINT.IfChange(openssl-ecjpake_warnings)
config("openssl-ecjpake_warnings") {
  # Suppress warnings in upstream code that are triggered by Fuchsia compilation
  # flags.
  cflags = [ "-Wno-conversion" ]
  visibility = [ ":*" ]
}

# LINT.ThenChange(BUILD.bazel:openssl-ecjpake_warnings)

config("openssl-ecjpake_config") {
  include_dirs = [
    "src",
    "src/openssl",
  ]
  configs = [ ":openssl-ecjpake_warnings" ]
  visibility = [ ":*" ]
}

# LINT.IfChange(openssl-ecjpake_test_config)
config("openssl-ecjpake_test_config") {
  configs = [ ":openssl-ecjpake_config" ]

  # Suppress warnings in upstream code that are triggered by Fuchsia compilation
  # flags.
  cflags = [
    "-Wno-error=sign-compare",
    "-Wno-conversion",
    "-Wno-incompatible-pointer-types-discards-qualifiers",
  ]
}

# LINT.ThenChange(BUILD.bazel:openssl-ecjpake_test_config)

group("tests") {
  testonly = true
  deps = [ ":openssl-ecjpake_tests" ]
}

