import("//build/tools/bazel2gn/bazel_migration.gni")

if (is_host) {
  python_library("jellyfish") {
    sources = [ "jellyfish/python/jellyfish/_jellyfish.py" ]
    imports = [ "jellyfish/python" ]
    visibility = [
      ":*",
      "//scripts/fxtest/python:*",
      "//scripts/fxtest/scripts:*",
      "//third_party/jellyfish/tests:*",
    ]
    enable_mypy = false
    stubs_root = "stubs"
    stubs = [
      "__init__.pyi",
      "_jellyfish.pyi",
    ]
  }
}
