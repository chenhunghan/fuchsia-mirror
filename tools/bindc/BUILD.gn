import("//build/bazel/bazel_host_tool.gni")
import("//build/sdk/sdk_host_tool.gni")

if (is_host) {
  bazel_host_tool("bin") {
    bazel_target = ":bin"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/bin"
    output_name = "bindc"
    install_host_tool = true
  }

  # Users of `${host_tools_dir}/bindc`, such as bind_host_test(), depend on this
  # target in their own host toolchain, which can be a variant toolchain (e.g.
  # host_x64-asan-ubsan). bazel_host_tool() only installs the tool in the base
  # host toolchain, so redirect there, like install_host_tools() does.
  group("host") {
    public_deps = [ ":bin(${toolchain_variant.base})" ]
  }

  sdk_host_tool("bindc_sdk") {
    category = "partner"
    output_name = "bindc"
    deps = [ ":bin" ]
  }
}

# The unit tests of bindc are in //tools:host_tests.
group("tests") {
  testonly = true
  deps = [ "./examples:tests" ]
}
