load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_py_test.bzl", "host_py_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [
        ":docsgen_transforms_test",
        ":gen_helpdocs_test",
    ],
    visibility = ["//tools:__pkg__"],
)

# LINT.IfChange(docsgen_tests)
host_py_test(
    name = "gen_helpdocs_test",
    srcs = [
        "gen_helpdocs_test.py",
        "//tools/docsgen:gen_helpdocs.py",
    ],
    imports = [".."],
    main = "gen_helpdocs_test.py",
    target_compatible_with = HOST_OS_CONSTRAINTS,
)

host_py_test(
    name = "docsgen_transforms_test",
    srcs = [
        "docsgen_transforms_test.py",
        "//tools/docsgen:docsgen_transforms.py",
    ],
    imports = [".."],
    main = "docsgen_transforms_test.py",
    target_compatible_with = HOST_OS_CONSTRAINTS,
)
# LINT.ThenChange(BUILD.gn:docsgen_tests)
