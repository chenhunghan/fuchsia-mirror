load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host:defs.bzl", "rustc_binary_host_tool")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")

package(default_applicable_licenses = ["//:license"])

rustc_binary_host_tool(
    name = "pbtool",
    srcs = [
        "src/build_archive.rs",
        "src/main.rs",
        "src/product_description.rs",
        "src/transfer_manifest.rs",
    ],
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        "//build/sdk/meta:rust",
        "//src/lib/assembly/assembled_system",
        "//src/lib/assembly/product_bundle",
        "//src/lib/assembly/release_info",
        "//src/lib/fuchsia",
        "//src/lib/product_description",
        "//src/lib/transfer_manifest",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:camino",
        "//third_party/rust_crates/vendor:flate2",
        "//third_party/rust_crates/vendor:pathdiff",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:walkdir",
    ],
)

host_rustc_test(
    name = "pbtool_test",
    crate = ":pbtool",
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    test_data = [
        "//src/developer/ffx/lib/pkg:empty-repo-keys",
        "//src/developer/ffx/lib/pkg:empty-repo-metadata",
    ],
    visibility = ["//tools:__pkg__"],
    deps = [
        "//src/lib/assembly/container",
        "//src/lib/assembly/partitions_config",
        "//src/sys/pkg/lib/fuchsia-repo",
        "//third_party/rust_crates/vendor:tempfile",
    ],
)
