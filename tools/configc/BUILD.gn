import("//build/bazel/bazel_host_tool.gni")
import("//build/sdk/sdk_host_tool.gni")

if (is_host) {
  bazel_host_tool("configc") {
    bazel_target = ":configc"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/configc"
    install_host_tool = true
  }

  # TODO(https://fxbug.dev/438572714): Remove once configc has a Bazel IDK
  # atom and the IDK uses it.
  sdk_host_tool("configc_sdk") {
    category = "partner"
    output_name = "configc"
    deps = [ ":configc" ]
  }

  group("install") {
    public_deps = [ ":configc" ]
  }
}

if (is_host) {
  group("host_tests") {
    testonly = true
    deps = [ "tests:fail_validate_without_config" ]
  }
}
