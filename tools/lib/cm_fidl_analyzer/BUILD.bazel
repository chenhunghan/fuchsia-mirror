load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "host_tests",
    tests = [":cm_fidl_analyzer_test"],
    visibility = ["//tools:__pkg__"],
)

rustc_library(
    name = "cm_fidl_analyzer",
    srcs = [
        "src/component_instance.rs",
        "src/component_model.rs",
        "src/component_sandbox.rs",
        "src/lib.rs",
        "src/route.rs",
    ],
    edition = "2024",
    proc_macro_deps = ["//third_party/rust_crates/vendor:async-trait"],
    visibility = [
        "//src/security/lib/scrutiny:__subpackages__",
        "//tools/lib/cm_fidl_analyzer:__subpackages__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
        "//sdk/fidl/fuchsia.component.runtime:fuchsia.component.runtime_rust",
        "//sdk/fidl/fuchsia.component.sandbox:fuchsia.component.sandbox_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust",
        # Depend on zx-status crate instead of zx so that this builds for host.
        "//sdk/rust/zx-status",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-sync",
        "//src/lib/fuchsia-url",
        "//src/sys/component_manager/lib/router_error",
        "//src/sys/lib/capability_source",
        "//src/sys/lib/cm_config",
        "//src/sys/lib/cm_rust",
        "//src/sys/lib/cm_types",
        "//src/sys/lib/component_id_index",
        "//src/sys/lib/config_encoder",
        "//src/sys/lib/moniker",
        "//src/sys/lib/routing",
        "//src/sys/lib/runtime_capabilities",
        "//src/sys/pkg/lib/fuchsia-merkle",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:thiserror",
        "//third_party/rust_crates/vendor:url",
    ],
)

host_rustc_test(
    name = "cm_fidl_analyzer_test",
    crate = ":cm_fidl_analyzer",
    deps = [
        "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust",
        "//sdk/fidl/fuchsia.component.internal:fuchsia.component.internal_rust",
        "//src/lib/fuchsia",
        "//src/sys/lib/cm_rust/testing",
        "//src/sys/lib/cm_types",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:maplit",
    ],
)
