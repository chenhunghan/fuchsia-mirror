import("//build/bazel/bazel_host_tool.gni")

# Group added to enable easy building.
group("doc_checker") {
  testonly = true
  deps = [ ":doc_checker_bin($host_toolchain)" ]
}

if (is_host) {
  bazel_host_tool("doc_checker_bin") {
    testonly = true
    bazel_target = ":doc_checker_bin"
    output_name = "doc-checker"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/doc-checker"
    install_host_tool = true
  }
}
