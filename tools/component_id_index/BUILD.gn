import("//build/bazel/bazel_host_tool.gni")

if (is_host) {
  bazel_host_tool("component_id_index") {
    bazel_target = ":component_id_index"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/component_id_index"
    install_host_tool = true
  }
}

group("install") {
  public_deps = [ ":component_id_index($host_toolchain)" ]
}

group("tests") {
  testonly = true

  deps = [ ":component_id_index_test($host_toolchain)" ]
}

