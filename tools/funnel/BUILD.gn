import("//build/bazel/bazel_host_tool.gni")
import("//build/sdk/sdk_host_tool.gni")

if (is_host) {
  bazel_host_tool("funnel") {
    bazel_target = ":funnel"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/funnel"
    install_host_tool = true
  }

  # TODO(https://fxbug.dev/438572714): Remove once the IDK uses the Bazel atom.
  sdk_host_tool("funnel_sdk") {
    category = "partner"
    output_name = "funnel"
    sdk_area = "Developer"
    deps = [ ":funnel" ]
  }
}

group("host") {
  deps = [ ":funnel($host_toolchain)" ]
}
