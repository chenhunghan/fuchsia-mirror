load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/idk:idk_host_tool.bzl", "idk_rustc_binary_host_tool")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [":funnel_bin_test"],
    visibility = ["//tools:__pkg__"],
)

idk_rustc_binary_host_tool(
    name = "funnel",
    srcs = [
        "src/errors.rs",
        "src/logging.rs",
        "src/main.rs",
        "src/metrics.rs",
        "src/ssh.rs",
        "src/target.rs",
        "src/update.rs",
    ],
    api_area = "Developer",
    category = "partner",
    compile_data = ["src/cleanup_command"],
    crate_root = "src/main.rs",
    edition = "2024",
    idk_name = "funnel",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        "//src/developer/ffx/config:lib",
        "//src/developer/ffx/lib/addr:lib",
        "//src/developer/ffx/lib/discovery:lib",
        "//src/developer/ffx/lib/logging:lib",
        "//src/developer/ffx/lib/timeout:lib",
        "//src/lib/analytics/rust:lib",
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:camino",
        "//third_party/rust_crates/vendor:chrono",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:home",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:rand",
        "//third_party/rust_crates/vendor:signal-hook",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

host_rustc_test(
    name = "funnel_bin_test",
    compile_data = ["src/cleanup_command"],
    crate = ":funnel",
    edition = "2024",
    deps = [
        "//sdk/fidl/fuchsia.net:fuchsia.net_rust",
        "//src/developer/ffx/fidl:fuchsia.developer.ffx_rust",
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:pretty_assertions",
    ],
)
