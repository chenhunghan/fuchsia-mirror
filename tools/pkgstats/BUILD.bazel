load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host:defs.bzl", "rustc_binary_host_tool")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [],
    visibility = ["//tools:__pkg__"],
)

rustc_binary_host_tool(
    name = "bin",
    srcs = [
        "src/html.rs",
        "src/main.rs",
        "src/print.rs",
        "src/process.rs",
        "src/types.rs",
    ],
    binary_name = "pkgstats",
    build_flags = ["//build/config:optimize_speed"],
    compile_data = [
        "templates/base_template.html.hbs",
        "templates/content.html.hbs",
        "templates/index.html.hbs",
        "templates/package.html.hbs",
        "templates/style.css",
    ],
    crate_name = "pkgstats",
    data = ["//tools/pkgstats/debugdump"],
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust_common",
        "//src/lib/assembly/assembled_system",
        "//src/lib/assembly/container",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-sync",
        "//src/lib/fuchsia-url",
        "//src/sys/pkg/lib/far/rust:fuchsia-archive",
        "//src/sys/pkg/lib/fuchsia-pkg",
        "//src/sys/pkg/lib/fuchsia-repo",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:camino",
        "//third_party/rust_crates/vendor:handlebars",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:rayon",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:serde_json",
    ],
)

host_rustc_test(
    name = "bin_test",
    build_flags = ["//build/config:optimize_speed"],
    crate = ":bin",
    edition = "2024",
)
