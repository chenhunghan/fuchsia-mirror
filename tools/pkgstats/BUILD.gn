import("//build/bazel/bazel_host_tool.gni")

if (is_host) {
  bazel_host_tool("bin") {
    bazel_target = ":bin"
    output_name = "pkgstats"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/pkgstats"
    install_host_tool = true
    deps = [ "//tools/pkgstats/debugdump" ]
  }
}

group("install") {
  deps = [ ":bin($host_toolchain)" ]
}

group("pkgstats") {
  deps = [ ":bin($host_toolchain)" ]
}
