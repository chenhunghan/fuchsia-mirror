import("//build/bazel/bazel_host_tool.gni")
import("//build/host.gni")

if (is_host) {
  bazel_host_tool("make-fuchsia-vol") {
    bazel_target = ":make-fuchsia-vol"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/make-fuchsia-vol"
    install_host_tool = true
  }
}

group("host") {
  deps = [
    ":install_mkfs_msdosfs",
    ":make-fuchsia-vol($host_toolchain)",

    # make-fuchsia-vol runs fvm and mkfs-msdosfs from the build directory.
    # This group is the tool's runtime closure, so depend on it rather than
    # on the tool alone.
    "//src/storage/bin/fvm($host_toolchain)",
  ]
}

install_host_tools("install_mkfs_msdosfs") {
  deps = [ "//zircon/third_party/uapp/mkfs-msdosfs" ]
  outputs = [ "mkfs-msdosfs" ]
}

