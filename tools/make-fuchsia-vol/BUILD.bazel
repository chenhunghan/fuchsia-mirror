load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host:defs.bzl", "rustc_binary_host_tool")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/host_tests:host_test_data.bzl", "host_test_data_files")
load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [":make_fuchsia_vol_lib_test"],
    visibility = ["//tools:__pkg__"],
)

rustc_library(
    name = "lib",
    srcs = [
        "src/args.rs",
        "src/lib.rs",
    ],
    crate_name = "make_fuchsia_vol",
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//src/developer/ffx:__subpackages__"],
    deps = [
        "//src/lib/assembly/assembled_system",
        "//src/lib/assembly/partitions_config",
        "//src/lib/assembly/product_bundle",
        "//src/storage/lib/sparse/rust:lib",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:byteorder",
        "//third_party/rust_crates/vendor:camino",
        "//third_party/rust_crates/vendor:crc",
        "//third_party/rust_crates/vendor:fatfs",
        "//third_party/rust_crates/vendor:gpt",
        "//third_party/rust_crates/vendor:rand",
        "//third_party/rust_crates/vendor:rand_xorshift",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:uuid",
        "//third_party/rust_crates/vendor:zerocopy",
    ],
)

# BUILD.gn wraps this binary with bazel_host_tool() instead.
# @bazel2gn:skip
rustc_binary_host_tool(
    name = "make-fuchsia-vol",
    srcs = ["src/main.rs"],
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        ":lib",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:argh",
    ],
)

host_test_data_files(
    name = "test_data",
    srcs = [
        "test_data/golden",
        "test_data/images.json",
        "test_data/product_bundle.json",
    ],
    dest_dir = "make-fuchsia-vol_test_data",
    target_compatible_with = HOST_OS_CONSTRAINTS,
)

host_test_data_files(
    name = "test_bin",
    srcs = ["//zircon/third_party/uapp/mkfs-msdosfs"],
    dest_dir = "make-fuchsia-vol_test_data",
    target_compatible_with = HOST_OS_CONSTRAINTS,
)

# TODO(https://fxbug.dev/586526935): Run in GN too once bazel2gn can translate
# `test_data`.
# @bazel2gn:skip
host_rustc_test(
    name = "make_fuchsia_vol_lib_test",
    crate = ":lib",
    link_deps = ["//third_party/zstd"],
    test_data = [
        ":test_bin",
        ":test_data",
    ],
    deps = [
        "//third_party/rust_crates/vendor:tempfile",
        "//third_party/rust_crates/vendor:zstd",
    ],
)
