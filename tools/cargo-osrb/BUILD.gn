import("//build/bazel/bazel_host_tool.gni")

if (is_host) {
  bazel_host_tool("cargo_osrb_bin") {
    bazel_target = ":cargo_osrb_bin"
    output_name = "cargo-osrb"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/cargo-osrb"
    install_host_tool = true
  }
}

group("install") {
  deps = [ ":cargo_osrb_bin($host_toolchain)" ]
}

group("cargo-osrb") {
  deps = [ ":cargo_osrb_bin($host_toolchain)" ]
}
