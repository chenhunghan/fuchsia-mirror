import("//build/bazel/bazel_host_tool.gni")
import("//build/host.gni")
import("//build/testing/host_test_data.gni")

if (is_host) {
  bazel_host_tool("test-pilot") {
    bazel_target = ":test-pilot"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/test-pilot"
    install_host_tool = true
  }

  host_test_data("test_deps") {
    testonly = true
    deps = [ ":test-pilot" ]
    sources = [ "${host_tools_dir}/test-pilot" ]
  }
}

group("tests") {
  testonly = true
  deps = [ "//tools/test_pilot/test_pilot_lib:tests" ]
}
