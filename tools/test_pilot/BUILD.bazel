load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host:defs.bzl", "rustc_binary_host_tool")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [":test-pilot_test"],
    visibility = ["//tools:__pkg__"],
)

rustc_binary_host_tool(
    name = "test-pilot",
    srcs = [
        "src/builder.rs",
        "src/env.rs",
        "src/errors.rs",
        "src/logger.rs",
        "src/main.rs",
        "src/name.rs",
        "src/parsers.rs",
        "src/run_tests.rs",
        "src/schema.rs",
        "src/std_writer.rs",
        "src/test_config.rs",
    ],
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:heck",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:serde_json5",
        "//third_party/rust_crates/vendor:thiserror",
        "//third_party/rust_crates/vendor:tokio",
        "//third_party/rust_crates/vendor:valico",
        "//tools/test_pilot/test_pilot_lib",
    ],
)

host_rustc_test(
    name = "test-pilot_test",
    crate = ":test-pilot",
    edition = "2024",
    deps = [
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:rand",
        "//third_party/rust_crates/vendor:tempfile",
    ],
)
