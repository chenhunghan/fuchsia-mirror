import("//build/bazel/bazel_host_tool.gni")

if (is_host) {
  bazel_host_tool("rfc_bin") {
    bazel_target = ":rfc_bin"
    output_name = "rfc"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/rfc"
    install_host_tool = true
  }
}

group("install") {
  deps = [ ":rfc_bin($host_toolchain)" ]
}
