load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host:defs.bzl", "rustc_binary_host_tool")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [":rfc_bin_test"],
    visibility = ["//tools:__pkg__"],
)

rustc_binary_host_tool(
    name = "rfc_bin",
    srcs = ["src/main.rs"],
    binary_name = "rfc",
    crate_name = "rfc",
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:serde_yaml",
    ],
)

host_rustc_test(
    name = "rfc_bin_test",
    compile_data = [
        "test_data/areas.yaml",
        "test_data/rfc.golden.md",
        "test_data/rfcs.before.yaml",
        "test_data/rfcs.golden.yaml",
        "test_data/toc.before.yaml",
        "test_data/toc.golden.yaml",
        "//docs/contribute/governance/rfcs:TEMPLATE.md",
    ],
    crate = ":rfc_bin",
    edition = "2024",
    deps = [
        "//third_party/rust_crates/vendor:pretty_assertions",
        "//third_party/rust_crates/vendor:tempfile",
    ],
)
