import("//build/bazel/bazel_host_tool.gni")

if (is_host) {
  bazel_host_tool("shush") {
    bazel_target = ":shush"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/shush"
    install_host_tool = true
  }

  group("install") {
    public_deps = [ ":shush" ]
  }
}
