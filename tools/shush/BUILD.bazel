load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host:defs.bzl", "rustc_binary_host_tool")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/host_tests:host_test_data.bzl", "host_test_data_files")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [":shush_test"],
    visibility = ["//tools:__pkg__"],
)

_DEPS = [
    "//third_party/rust_crates/vendor:anyhow",
    "//third_party/rust_crates/vendor:argh",
    "//third_party/rust_crates/vendor:once_cell",
    "//third_party/rust_crates/vendor:proc-macro2",
    "//third_party/rust_crates/vendor:regex",
    "//third_party/rust_crates/vendor:rustfix",
    "//third_party/rust_crates/vendor:serde",
    "//third_party/rust_crates/vendor:serde_json",
    "//third_party/rust_crates/vendor:syn",
]

_SRCS = [
    "src/allow.rs",
    "src/api.rs",
    "src/bugspec.rs",
    "src/command_ext.rs",
    "src/fix.rs",
    "src/issues.rs",
    "src/lint.rs",
    "src/main.rs",
    "src/mock.rs",
    "src/owners.rs",
    "src/rollout.rs",
    "src/span.rs",
]

rustc_binary_host_tool(
    name = "shush",
    srcs = _SRCS,
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = _DEPS,
)

host_test_data_files(
    name = "shush_rust_bin",
    testonly = True,
    srcs = ["@fuchsia_prebuilt_rust//:bin/clippy-driver"],
    dest_dir = "third_party/rust/bin",
    target_compatible_with = HOST_OS_CONSTRAINTS,
)

host_test_data_files(
    name = "shush_rust_lib",
    testonly = True,
    srcs = ["@fuchsia_prebuilt_rust//:rustc_lib"],
    dest_dir = "third_party/rust/lib",
    target_compatible_with = HOST_OS_CONSTRAINTS,
)

host_rustc_test(
    name = "shush_test",
    srcs = _SRCS,
    crate_root = "src/main.rs",
    edition = "2024",
    rustc_env = {
        "RUST_SYSROOT": "third_party/rust",
    },
    test_data = [
        ":shush_rust_bin",
        ":shush_rust_lib",
    ],
    deps = _DEPS,
)
