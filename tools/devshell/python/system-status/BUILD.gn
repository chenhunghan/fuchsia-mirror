import("//build/bazel/bazel_py_host_tool.gni")

if (is_host) {
  bazel_py_host_tool("system-status") {
    bazel_target = ":system-status"
    host_tool_name = "system-status"
  }
}

group("install") {
  deps = [ ":system-status($host_toolchain)" ]
}
