load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host:defs.bzl", "fx_script_host_tool")
load("//build/bazel/rules/host_tests:host_py_test.bzl", "host_py_test")

package(default_applicable_licenses = ["//:license"])

fx_script_host_tool(
    name = "get-main-pb-path",
    runtime_tools = ["//build/prebuilt/cipd:jq"],
    script = "get_main_pb_path.sh",
    visibility = ["//tools/devshell:__subpackages__"],
)

host_py_test(
    name = "get_main_pb_path_test",
    srcs = ["get_main_pb_path_test.py"],
    data = [":get-main-pb-path"],
    imports = ["."],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//tools:__subpackages__"],
)
