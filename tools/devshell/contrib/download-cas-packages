#### CATEGORY=Toolchain
#### PREBUILTS=${PREBUILT_BB} ${PREBUILT_CAS} ${PREBUILT_JQ}
### Download prebuilt CAS packages from CI

## usage: fx download-cas-packages <package>[:<target>] [...]
##
## Downloads one or more prebuilt CAS packages for the current host
## architecture (${HOST_PLATFORM}) into `//local/<package>` and prints the
## instructions needed to use them.
##
## Arguments:
##   <package>                Downloads the latest green build from CI
##                            for the current host architecture:
##                              - arm-trusted-firmware-qemu-bios (or atf)
##                              - clang
##                              - crosvm
##                              - edk2
##                              - fastboot
##                              - gcc
##                              - llvm
##                              - qemu
##                              - rust
##                              - rust-bindgen
##   <package>:<target>       Download `<package>` from a specific build or
##                            builder. `<target>` can be:
##                              - A LUCI / Milo build URL (e.g.
##                                https://ci.chromium.org/ui/p/fuchsia/builders/.../b8666755190352362065/overview
##                                or https://ci.chromium.org/b/8666755190352362065)
##                              - A Buildbucket build ID (e.g. b8666755190352362065
##                                or 8666755190352362065)
##                              - A CAS digest (e.g. <sha256>/<size_bytes>)
##                              - A LUCI builder URL or builder name (e.g.
##                                fuchsia/toolchain.ci/rust_llvm-linux-x64 or
##                                rust_llvm-linux-x64), which resolves to the
##                                latest green build on that builder.
##
## Examples:
##   fx download-cas-packages rust
##   fx download-cas-packages clang gcc llvm qemu rust rust-bindgen
##   fx download-cas-packages \
##     clang:https://ci.chromium.org/ui/p/fuchsia/builders/toolchain.ci/clang-linux-x64/b8666747240201415809/overview \
##     qemu:https://ci.chromium.org/ui/p/fuchsia/builders/ci/qemu-linux-x64/b8666747240201415809/overview \
##     rust:https://ci.chromium.org/ui/p/fuchsia/builders/toolchain.ci/rust_llvm-linux-x64/b8666927100188196401/overview \
##     rust-bindgen:https://ci.chromium.org/ui/p/fuchsia/builders/try.shadow/rust-bindgen-linux-x64/b8665837257839055009/overview

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"/../lib/vars.sh || exit $?

readonly SUPPORTED_PACKAGES_MSG="arm-trusted-firmware-qemu-bios, clang, crosvm, edk2, fastboot, gcc, llvm, qemu, rust, or rust-bindgen"

function usage {
  fx-command-help
  exit 1
}

if [[ $# -eq 0 ]]; then
  echo "Error: At least one package specification (${SUPPORTED_PACKAGES_MSG}) is required." >&2
  usage
fi

for arg in "$@"; do
  case "${arg}" in
    -h|--help)
      usage
      ;;
  esac
done

set -euo pipefail

# Resolve tool paths declared in the `#### PREBUILTS=` metadata header above.
readarray -t _declared_prebuilts < <(get_prebuilts_from_metadata "${BASH_SOURCE[0]}")
if [[ ${#_declared_prebuilts[@]} -gt 0 ]]; then
  fx-ensure-prebuilt "${_declared_prebuilts[@]}"
fi

BB_TOOL="${_declared_prebuilts[0]:-}"
CAS_TOOL="${_declared_prebuilts[1]:-}"
JQ_CANDIDATE="${_declared_prebuilts[2]:-${jq:-}}"

# Locate jq (prefer Fuchsia prebuilt jq, fall back to system PATH).
if [[ -n "${JQ_CANDIDATE}" && -x "${JQ_CANDIDATE}" ]]; then
  JQ_TOOL="${JQ_CANDIDATE}"
elif command -v jq >/dev/null 2>&1; then
  JQ_TOOL="$(command -v jq)"
else
  echo "jq could not be found at ${JQ_CANDIDATE} or in PATH." >&2
  exit 1
fi

if [[ -z "${BB_TOOL}" || ! -x "${BB_TOOL}" ]]; then
  echo "bb tool not found or not executable at ${BB_TOOL}" >&2
  exit 1
fi

if [[ -z "${CAS_TOOL}" || ! -x "${CAS_TOOL}" ]]; then
  echo "cas tool not found or not executable at ${CAS_TOOL}" >&2
  exit 1
fi

# Check authentication once up front.
if ! "${BB_TOOL}" auth-info >/dev/null 2>&1; then
  echo "Login required, run \`${BB_TOOL} auth-login\`" >&2
  exit 1
fi

if ! "${CAS_TOOL}" whoami >/dev/null 2>&1; then
  echo "Login required, run \`${CAS_TOOL} login\`" >&2
  exit 1
fi

function default_bucket_for_package {
  local package="$1"
  case "${package}" in
    arm-trusted-firmware-qemu-bios|fastboot)
      echo "fuchsia/try"
      ;;
    clang|gcc|rust)
      echo "fuchsia/toolchain.ci"
      ;;
    crosvm|edk2|qemu)
      echo "fuchsia/ci"
      ;;
    llvm|rust-bindgen)
      echo "fuchsia/prod"
      ;;
    *)
      echo "Error: Unknown package '${package}'. Must be one of: ${SUPPORTED_PACKAGES_MSG}." >&2
      return 1
      ;;
  esac
}

function default_builder_for_package {
  local package="$1"
  case "${package}" in
    arm-trusted-firmware-qemu-bios)
      echo "fuchsia/try/arm-trusted-firmware-qemu-bios"
      ;;
    clang)
      echo "fuchsia/toolchain.ci/clang-${HOST_PLATFORM}"
      ;;
    crosvm)
      echo "fuchsia/ci/crosvm-${HOST_PLATFORM}"
      ;;
    edk2)
      echo "fuchsia/ci/edk2"
      ;;
    fastboot)
      echo "fuchsia/try/fastboot-${HOST_PLATFORM}"
      ;;
    gcc)
      echo "fuchsia/toolchain.ci/gcc-${HOST_CPU}-${HOST_OS}"
      ;;
    llvm)
      echo "fuchsia/prod/llvm-${HOST_PLATFORM}"
      ;;
    qemu)
      echo "fuchsia/ci/qemu-${HOST_PLATFORM}"
      ;;
    rust)
      echo "fuchsia/toolchain.ci/rust-${HOST_PLATFORM}"
      ;;
    rust-bindgen)
      echo "fuchsia/prod/rust-bindgen-${HOST_PLATFORM}"
      ;;
    *)
      echo "Error: Unknown package '${package}'. Must be one of: ${SUPPORTED_PACKAGES_MSG}." >&2
      return 1
      ;;
  esac
}

function latest_green_build_id {
  local builder="$1"
  local build_info
  build_info="$("${BB_TOOL}" ls "${builder}" -status SUCCESS -n 1 -json)" || return 1
  if [[ -z "${build_info}" || "${build_info}" == "[]" ]]; then
    return 1
  fi
  local build_id
  build_id="$(printf '%s\n' "${build_info}" | "${JQ_TOOL}" -s -r '.[0].id // empty')"
  if [[ -z "${build_id}" || "${build_id}" == "null" ]]; then
    return 1
  fi
  echo "${build_id}"
}

function extract_cas_digest_from_build {
  local package="$1"
  local build_details="$2"

  case "${package}" in
    clang)
      printf '%s\n' "${build_details}" | "${JQ_TOOL}" -r '
        .input.properties["$fuchsia/checkout"].clang_toolchain.cas_digest
        // .output.properties.isolated
        // .output.properties.cas_digest
        // empty
      '
      ;;
    gcc)
      printf '%s\n' "${build_details}" | "${JQ_TOOL}" -r '
        .input.properties["$fuchsia/checkout"].gcc_toolchain.cas_digest
        // .output.properties.isolated
        // .output.properties.cas_digest
        // empty
      '
      ;;
    qemu)
      printf '%s\n' "${build_details}" | "${JQ_TOOL}" -r '
        .input.properties["$fuchsia/checkout"].qemu.cas_digest
        // .output.properties.isolated
        // .output.properties.cas_digest
        // empty
      '
      ;;
    rust)
      printf '%s\n' "${build_details}" | "${JQ_TOOL}" -r '
        .input.properties["$fuchsia/checkout"].rust_toolchain.cas_digest
        // .input.properties.rust_cas_digest
        // .output.properties.isolated
        // .output.properties.cas_digest
        // empty
      '
      ;;
    arm-trusted-firmware-qemu-bios|crosvm|edk2|fastboot|llvm|rust-bindgen)
      printf '%s\n' "${build_details}" | "${JQ_TOOL}" -r '
        .output.properties.isolated
        // .output.properties.cas_digest
        // empty
      '
      ;;
  esac
}

GN_ARGS_SUGGESTIONS=()
DOWNLOADED_ATF=0
DOWNLOADED_CROSVM=0
DOWNLOADED_EDK2=0
DOWNLOADED_QEMU=0

for spec in "$@"; do
  package="${spec%%:*}"
  if [[ "${spec}" == *:* ]]; then
    target="${spec#*:}"
  else
    target=""
  fi

  case "${package}" in
    atf|arm_trusted_firmware_qemu_bios)
      package="arm-trusted-firmware-qemu-bios"
      ;;
    rust_bindgen)
      package="rust-bindgen"
      ;;
  esac

  case "${package}" in
    arm-trusted-firmware-qemu-bios|clang|crosvm|edk2|fastboot|gcc|llvm|qemu|rust|rust-bindgen)
      ;;
    *)
      echo "Error: Invalid package '${package}' in argument '${spec}'. Must be one of: ${SUPPORTED_PACKAGES_MSG}." >&2
      usage
      ;;
  esac

  build_id=""
  cas_digest=""
  builder=""

  if [[ -z "${target}" ]]; then
    builder="$(default_builder_for_package "${package}")"
    echo "[${package}] Fetching latest green build for ${builder}..."
    if ! build_id="$(latest_green_build_id "${builder}")"; then
      if [[ -z "${build_id}" ]]; then
        echo "Error: No successful builds found for ${builder}." >&2
        exit 1
      fi
    fi
  elif [[ "${target}" =~ ^[0-9a-fA-F]{64}/[0-9]+$ ]]; then
    cas_digest="${target}"
  elif [[ "${target}" =~ ^b?([0-9]{15,})$ ]]; then
    build_id="${BASH_REMATCH[1]}"
  elif [[ "${target}" =~ /b/?([0-9]{15,}) ]]; then
    build_id="${BASH_REMATCH[1]}"
  elif [[ "${target}" =~ /p/([^/]+)/builders/([^/]+)/([^/?#]+) ]]; then
    builder="${BASH_REMATCH[1]}/${BASH_REMATCH[2]}/${BASH_REMATCH[3]}"
    echo "[${package}] Fetching latest green build for ${builder}..."
    if ! build_id="$(latest_green_build_id "${builder}")"; then
      echo "Error: No successful builds found for ${builder}." >&2
      exit 1
    fi
  elif [[ "${target}" == http://* || "${target}" == https://* ]]; then
    echo "Error: Unrecognized build/builder URL '${target}'." >&2
    exit 1
  else
    if [[ "${target}" == */*/* ]]; then
      builder="${target}"
    elif [[ "${target}" == */* ]]; then
      builder="fuchsia/${target}"
    else
      default_bucket="$(default_bucket_for_package "${package}")"
      builder="${default_bucket}/${target}"
    fi
    echo "[${package}] Fetching latest green build for ${builder}..."
    if ! build_id="$(latest_green_build_id "${builder}")"; then
      echo "Error: No successful builds found for ${builder}." >&2
      exit 1
    fi
  fi

  if [[ -z "${cas_digest}" ]]; then
    echo "[${package}] Fetching details for build ${build_id}..."
    build_details="$("${BB_TOOL}" get "${build_id}" -json -p)"
    cas_digest="$(extract_cas_digest_from_build "${package}" "${build_details}")"
    if [[ -z "${cas_digest}" || "${cas_digest}" == "null" ]]; then
      echo "Error: Could not find CAS digest for '${package}' in build ${build_id}." >&2
      exit 1
    fi
    echo "[${package}] Found build ID: ${build_id}"
  fi

  echo "[${package}] Found CAS digest: ${cas_digest}"

  download_dir="${FUCHSIA_DIR}/local/${package}"
  echo "[${package}] Cleaning up old artifacts in ${download_dir}..."
  rm -rf "${download_dir}"
  mkdir -p "${download_dir}"

  echo "[${package}] Downloading artifacts to ${download_dir}..."
  "${CAS_TOOL}" download \
    -cas-instance projects/chromium-swarm/instances/default_instance \
    -digest "${cas_digest}" \
    -dir "${download_dir}"

  # Record the CAS digest in .versions/<package>.cipd_version so Bazel
  # workspace content hashing hashes this single file instead of walking the
  # entire local package directory tree.
  mkdir -p "${download_dir}/.versions"
  printf '{"package_name":"%s","instance_id":"%s"}\n' \
    "${package}" "${cas_digest}" \
    > "${download_dir}/.versions/${package}.cipd_version"

  if [[ "${package}" == "llvm" ]]; then
    # //src/lib/llvm/BUILD.gn and //src/lib/llvm/llvm_library.gni expect
    # ${llvm_prefix}/${host_platform}/include and
    # ${llvm_prefix}/${current_platform}/lib, whereas the llvm CAS package has
    # include/ and lib/ at its root. Create a platform symlink so
    # llvm_prefix = "//local/llvm" works directly.
    ln -sfn . "${download_dir}/${HOST_PLATFORM}"
  fi

  echo "[${package}] Download complete."

  case "${package}" in
    arm-trusted-firmware-qemu-bios)
      DOWNLOADED_ATF=1
      ;;
    clang)
      GN_ARGS_SUGGESTIONS+=('  clang_prefix = "//local/clang/bin"')
      ;;
    crosvm)
      DOWNLOADED_CROSVM=1
      ;;
    edk2)
      DOWNLOADED_EDK2=1
      ;;
    fastboot)
      GN_ARGS_SUGGESTIONS+=('  prebuilt_fastboot = "//local/fastboot/fastboot"')
      ;;
    gcc)
      GN_ARGS_SUGGESTIONS+=('  gcc_tool_dir = "//local/gcc/bin"')
      ;;
    llvm)
      GN_ARGS_SUGGESTIONS+=('  llvm_prefix = "//local/llvm"')
      ;;
    qemu)
      DOWNLOADED_QEMU=1
      ;;
    rust)
      GN_ARGS_SUGGESTIONS+=('  rustc_prefix = "//local/rust"')
      ;;
    rust-bindgen)
      GN_ARGS_SUGGESTIONS+=('  rust_bindgen_prefix = "//local/rust-bindgen"')
      ;;
  esac
done

if [[ ${#GN_ARGS_SUGGESTIONS[@]} -gt 0 ]]; then
  echo ""
  echo "To use the downloaded package(s), modify your GN arguments (using fx args) to include:"
  for line in "${GN_ARGS_SUGGESTIONS[@]}"; do
    echo "${line}"
  done
  echo ""
  echo "Then run: fx build"
fi

if (( DOWNLOADED_ATF )); then
  echo ""
  echo "To use the downloaded arm-trusted-firmware-qemu-bios package with ffx emu:"
  echo "  fx ffx config set sdk.overrides.secure_bootloader_arm64 \"${FUCHSIA_DIR}/local/arm-trusted-firmware-qemu-bios/qemu_fw.bios\""
fi

if (( DOWNLOADED_CROSVM )); then
  echo ""
  echo "To use the downloaded crosvm package:"
  echo "  - With fx run-boot-test: fx run-boot-test --crosvm --crosvm-path \"${FUCHSIA_DIR}/local/crosvm/crosvm\" <test>"
  echo "  - With ffx emu:          fx ffx config set sdk.overrides.crosvm_internal \"${FUCHSIA_DIR}/local/crosvm/crosvm\""
fi

if (( DOWNLOADED_EDK2 )); then
  echo ""
  echo "To use the downloaded edk2 package with ffx emu:"
  echo "  - For x64:   fx ffx config set sdk.overrides.uefi_internal_x64 \"${FUCHSIA_DIR}/local/edk2/qemu-x64/OVMF_CODE.fd\""
  echo "  - For arm64: fx ffx config set sdk.overrides.uefi_internal_arm64 \"${FUCHSIA_DIR}/local/edk2/qemu-arm64/QEMU_EFI.fd\""
fi

if (( DOWNLOADED_QEMU )); then
  echo ""
  echo "To use the downloaded qemu package:"
  echo "  - With fx qemu:          fx qemu -q \"${FUCHSIA_DIR}/local/qemu/bin\""
  echo "  - With fx run-boot-test: fx run-boot-test --args=-q --args=\"${FUCHSIA_DIR}/local/qemu/bin\" <test>"
  echo "  - With ffx emu:          fx ffx config set sdk.overrides.qemu_internal \"${FUCHSIA_DIR}/local/qemu/bin/qemu-system-x86_64\""
fi
