{
    "cmc": {
        "category": "Build",
        "summary": "Component manifest compiler",
        "target": "//tools/cmc:fx_cmc"
    },
    "get-main-pb-path": {
        "category": "Build",
        "contrib": true,
        "summary": "get the output path to the provided product bundle",
        "target": "//tools/devshell/host_tools/get_main_pb_path:get-main-pb-path"
    },
    "get-src-dir": {
        "category": "Build",
        "script": "//tools/devshell/host_tools/get_src_dir/get_src_dir.sh",
        "summary": "print the Fuchsia source directory (checkout root, aka \"//\")"
    },
    "registry": {
        "category": "Source tree",
        "script": "//tools/devshell/fx_cli/registry.py",
        "summary": "Manage fx_host_tools.json command registrations."
    }
}
