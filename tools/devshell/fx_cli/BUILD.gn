import("//build/python/python_host_test.gni")

if (is_host) {
  python_host_test("locator_test") {
    main_source = "locator_test.py"
    sources = [
      "__init__.py",
      "locator.py",
      "registry.py",
    ]
  }

  python_host_test("registry_test") {
    main_source = "registry_test.py"
    sources = [
      "__init__.py",
      "registry.py",
    ]
  }

  python_host_test("builder_test") {
    main_source = "builder_test.py"
    sources = [
      "__init__.py",
      "builder.py",
      "registry.py",
    ]
  }
}

group("tests") {
  testonly = true
  deps = [
    ":builder_test($host_toolchain)",
    ":locator_test($host_toolchain)",
    ":registry_test($host_toolchain)",
  ]
}
