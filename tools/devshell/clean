#### CATEGORY=Build
#### PREBUILTS=${PREBUILT_GN}
### clean the current Fuchsia build artifacts

## Delete the contents of the output directory except for args.gn and
## create a Ninja build environment sufficient to regenerate the build.
##
## This is equivalent to running `gn clean` on FUCHSIA_BUILD_DIR, then
## invoking `fx gen` to regenerate critical build files.

# shellcheck source=/dev/null
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"/lib/vars.sh || exit $?

set -e

if [[ $# -gt 0 ]]; then
  case "$1" in
    -h|--help)
      fx-command-help
      exit 0
      ;;
    *)
      fx-error "Unknown argument: $1"
      fx-command-help
      exit 1
      ;;
  esac
fi

# Avoid writing Python bytecode during clean so that bytecode caches
# are not created after gn clean or during config loading/fx gen.
export PYTHONDONTWRITEBYTECODE=1

# Validate build directory and args.gn directly with fx-build-dir-require
# instead of calling fx-config-read, so that fx-build-config-load does not
# run fx-gen (build/regenerator) prior to gn clean when fx.config is missing.
fx-build-dir-require || exit $?

(set -x; fx-gn clean "$FUCHSIA_BUILD_DIR")

# Ensure //build/regenerator is invoked to regenerate a working Bazel workspace.
fx-command-run gen
