### Test expected behavior of fx clean

function read_host_platform() {
  source "$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)/../../lib/platform.sh" || exit $?
  echo "$HOST_PLATFORM"
}

BT_FILE_DEPS=(
  "scripts/fx"
  "tools/devshell/clean"
  "tools/devshell/lib/agent_session_ids.txt"
  "tools/devshell/lib/agents.txt"
  "tools/devshell/lib/fx-cmd-locator.sh"
  "tools/devshell/lib/fx-optional-features.sh"
  "tools/devshell/lib/generate-ssh-config.sh"
  "tools/devshell/lib/is_invoked_by_agent.sh"
  "tools/devshell/lib/platform.sh"
  "tools/devshell/lib/vars.sh"
)

BT_MOCKED_TOOLS=(
  "build/regenerator"
  "tools/devshell/gen"
  "prebuilt/third_party/gn/$(read_host_platform)/gn"
)

declare fx gn_mock gen_mock regenerator_mock

BT_SET_UP() {
  source "${BT_TEMP_DIR}/tools/devshell/tests/lib/fuchsia-mock.sh"
  fx="$(btf::setup_fx)"

  local host_platform="$(read_host_platform)"
  gn_mock="${BT_TEMP_DIR}/prebuilt/third_party/gn/${host_platform}/gn"
  gen_mock="${BT_TEMP_DIR}/tools/devshell/gen"
  regenerator_mock="${BT_TEMP_DIR}/build/regenerator"

  cat > "${gn_mock}.mock_side_effects" <<'EOF'
echo "gn $*" >> "${BT_TEMP_DIR}/call_order"
EOF

  cat > "${gen_mock}.mock_side_effects" <<'EOF'
echo "gen$([ $# -gt 0 ] && echo " $*")" >> "${BT_TEMP_DIR}/call_order"
EOF
}

TEST_clean() {
  local out="${BT_TEMP_DIR}/clean.out"
  BT_EXPECT "${fx}" clean > "${out}" 2>&1
  BT_ASSERT_FILE_EXISTS "${gn_mock}.mock_state"
  btf::expect-mock-args "${gn_mock}" clean "${BT_TEMP_DIR}/out/default"
  BT_ASSERT_FILE_EXISTS "${gen_mock}.mock_state"
  btf::expect-mock-args "${gen_mock}"

  BT_ASSERT_FILE_EXISTS "${BT_TEMP_DIR}/call_order"
  local expected_order="gn clean ${BT_TEMP_DIR}/out/default
gen"
  BT_EXPECT_FILE_CONTAINS "${BT_TEMP_DIR}/call_order" "${expected_order}"
}

TEST_clean_help() {
  local out="${BT_TEMP_DIR}/clean_help.out"
  BT_EXPECT "${fx}" clean --help > "${out}"
  BT_EXPECT_FILE_DOES_NOT_EXIST "${gn_mock}.mock_state"
  BT_EXPECT_FILE_DOES_NOT_EXIST "${gen_mock}.mock_state"
  BT_EXPECT_FILE_DOES_NOT_EXIST "${BT_TEMP_DIR}/call_order"
  BT_EXPECT_FILE_CONTAINS_SUBSTRING "$out" "Delete the contents of the output directory"
  BT_EXPECT_FILE_CONTAINS_SUBSTRING "$out" "This is equivalent to running \`gn clean\`"
}

TEST_clean_short_help() {
  local out="${BT_TEMP_DIR}/clean_short_help.out"
  BT_EXPECT "${fx}" clean -h > "${out}"
  BT_EXPECT_FILE_DOES_NOT_EXIST "${gn_mock}.mock_state"
  BT_EXPECT_FILE_DOES_NOT_EXIST "${gen_mock}.mock_state"
  BT_EXPECT_FILE_DOES_NOT_EXIST "${BT_TEMP_DIR}/call_order"
  BT_EXPECT_FILE_CONTAINS_SUBSTRING "$out" "Delete the contents of the output directory"
}

TEST_clean_unknown_argument() {
  local out="${BT_TEMP_DIR}/clean_unknown_arg.out"
  BT_EXPECT_FAIL "${fx}" clean --unknown-arg > "${out}" 2>&1
  BT_EXPECT_FILE_DOES_NOT_EXIST "${gn_mock}.mock_state"
  BT_EXPECT_FILE_DOES_NOT_EXIST "${gen_mock}.mock_state"
  BT_EXPECT_FILE_DOES_NOT_EXIST "${BT_TEMP_DIR}/call_order"
  BT_EXPECT_FILE_CONTAINS_SUBSTRING "$out" "Unknown argument: --unknown-arg"
}

TEST_clean_missing_build_dir() {
  rm -f "${BT_TEMP_DIR}/.fx-build-dir"
  local out="${BT_TEMP_DIR}/clean_missing_build_dir.out"
  BT_EXPECT_FAIL "${fx}" clean > "${out}" 2>&1
  BT_EXPECT_FILE_DOES_NOT_EXIST "${gn_mock}.mock_state"
  BT_EXPECT_FILE_DOES_NOT_EXIST "${gen_mock}.mock_state"
  BT_EXPECT_FILE_CONTAINS_SUBSTRING "$out" "No build directory found."
}

TEST_clean_missing_args_gn() {
  rm -f "${BT_TEMP_DIR}/out/default/args.gn"
  local out="${BT_TEMP_DIR}/clean_missing_args_gn.out"
  BT_EXPECT_FAIL "${fx}" clean > "${out}" 2>&1
  BT_EXPECT_FILE_DOES_NOT_EXIST "${gn_mock}.mock_state"
  BT_EXPECT_FILE_DOES_NOT_EXIST "${gen_mock}.mock_state"
  BT_EXPECT_FILE_CONTAINS_SUBSTRING "$out" "Build directory missing or removed"
}

TEST_clean_dir_overrides_parent_build_dir() {
  btf::make_out_dir "out/custom"

  cat >> "${gen_mock}.mock_side_effects" <<'EOF'
echo "${PYTHONPYCACHEPREFIX:-}" > "${BT_TEMP_DIR}/gen_override_prefix"
EOF

  local out="${BT_TEMP_DIR}/clean_override.out"
  local parent_build_dir="${BT_TEMP_DIR}/out/default"
  BT_EXPECT env \
    -u PYTHONPYCACHEPREFIX \
    FUCHSIA_BUILD_DIR="${parent_build_dir}" \
    "${fx}" --dir "out/custom" clean > "${out}" 2>&1
  BT_ASSERT_FILE_EXISTS "${BT_TEMP_DIR}/gen_override_prefix"
  BT_EXPECT_FILE_CONTAINS "${BT_TEMP_DIR}/gen_override_prefix" "${BT_TEMP_DIR}/out/_build_caches/__pycache__"
  btf::expect-mock-args "${gn_mock}" clean "${BT_TEMP_DIR}/out/custom"
}

TEST_clean_pythondontwritebytecode() {
  cat >> "${gn_mock}.mock_side_effects" <<'EOF'
echo "gn_pythondontwritebytecode=${PYTHONDONTWRITEBYTECODE:-}" >> "${BT_TEMP_DIR}/gen_env"
EOF

  cat >> "${gen_mock}.mock_side_effects" <<'EOF'
echo "gen_pythondontwritebytecode=${PYTHONDONTWRITEBYTECODE:-}" >> "${BT_TEMP_DIR}/gen_env"
EOF

  local out="${BT_TEMP_DIR}/clean_pythondontwritebytecode.out"
  BT_EXPECT env -u PYTHONDONTWRITEBYTECODE "${fx}" clean > "${out}" 2>&1
  BT_ASSERT_FILE_EXISTS "${BT_TEMP_DIR}/gen_env"
  local expected_env="gn_pythondontwritebytecode=1
gen_pythondontwritebytecode=1"
  BT_EXPECT_FILE_CONTAINS "${BT_TEMP_DIR}/gen_env" "${expected_env}"
}

TEST_clean_missing_config_no_premature_gen() {
  mkdir -p "${BT_TEMP_DIR}/out/custom2"
  touch "${BT_TEMP_DIR}/out/custom2/args.gn"

  cat >> "${gen_mock}.mock_side_effects" <<'EOF'
echo "${PYTHONPYCACHEPREFIX:-}" > "${BT_TEMP_DIR}/gen_pycache_prefix2"
EOF

  local out="${BT_TEMP_DIR}/clean_dir2.out"
  BT_EXPECT env -u FUCHSIA_BUILD_DIR -u PYTHONPYCACHEPREFIX "${fx}" --dir "out/custom2" clean > "${out}" 2>&1
  BT_ASSERT_FILE_EXISTS "${BT_TEMP_DIR}/gen_pycache_prefix2"
  BT_EXPECT_FILE_CONTAINS "${BT_TEMP_DIR}/gen_pycache_prefix2" "${BT_TEMP_DIR}/out/_build_caches/__pycache__"
  btf::expect-mock-args "${gn_mock}" clean "${BT_TEMP_DIR}/out/custom2"
  BT_ASSERT_FILE_EXISTS "${gen_mock}.mock_state"
  # Confirm build/regenerator was not redundantly invoked before fx-gn clean.
  BT_EXPECT_FILE_DOES_NOT_EXIST "${regenerator_mock}.mock_state"
}

TEST_clean_preserves_custom_pycache_prefix() {
  btf::make_out_dir "out/custom"

  cat >> "${gen_mock}.mock_side_effects" <<'EOF'
echo "${PYTHONPYCACHEPREFIX:-}" > "${BT_TEMP_DIR}/gen_custom_prefix"
EOF

  local out="${BT_TEMP_DIR}/clean_custom.out"
  local custom_cache="${BT_TEMP_DIR}/my_custom_cache/__pycache__"
  # Verify that specifying --dir does not override an explicit custom PYTHONPYCACHEPREFIX.
  BT_EXPECT env -u FUCHSIA_BUILD_DIR PYTHONPYCACHEPREFIX="${custom_cache}" "${fx}" --dir "out/custom" clean > "${out}" 2>&1
  BT_ASSERT_FILE_EXISTS "${BT_TEMP_DIR}/gen_custom_prefix"
  BT_EXPECT_FILE_CONTAINS "${BT_TEMP_DIR}/gen_custom_prefix" "${custom_cache}"
}

BT_RUN_TESTS "$@"
