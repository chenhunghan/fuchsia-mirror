TEST_metrics_sh_parity_guards() {
  # 1. Non-migrated internal user exits 0 from metrics-read-config (set -e safe).
  set_up_environment "N" "N" "N" "1"
  BT_EXPECT metrics-read-config

  # 2. Clearing debug logfile suppresses metrics-maybe-log instead of falling back.
  set_up_environment "1" "N" "N" "0"
  metrics-read-config
  rm -f "${metrics_log}"
  metrics-set-debug-logfile ""
  BT_EXPECT metrics-maybe-log "suppressed-entry"
  BT_EXPECT_FILE_DOES_NOT_EXIST "${metrics_log}"
  metrics-set-debug-logfile "${metrics_log}"
  BT_EXPECT metrics-maybe-log "logged-entry"
  local ts_match_rc=0
  grep -Eq '^[0-9]{8}_[0-9]{6}: logged-entry$' "${metrics_log}" || ts_match_rc=$?
  BT_EXPECT_EQ "${ts_match_rc}" "0"

  # 3. Failing _metrics_run does not abort set -e callers and still exports call stack.
  local errexit_rc=0
  (
    set -o errexit
    _metrics_run() { return 1; }
    unset FUCHSIA_METRICS_CALL_STACK
    metrics-read-and-validate 1
    metrics-init build
    [[ "${FUCHSIA_METRICS_CALL_STACK:-}" == "fx" ]]
  ) || errexit_rc=$?
  BT_EXPECT_EQ "${errexit_rc}" "0"

  # 4. track-build-event closes inherited FDs so backgrounded calls don't hang pipes.
  set_up_environment "1" "1" "N" "1"
  metrics-read-config
  local build_dir="${BT_TEMP_DIR}/out/pipe_test"
  mkdir -p "${build_dir}"
  local release="${BT_TEMP_DIR}/build_release"
  local counter_outcome="${BT_TEMP_DIR}/counter_outcome"
  local counter_script="${BT_TEMP_DIR}/tools/devshell/contrib/lib/count-ninja-actions.py"
  mkdir -p "$(dirname "${counter_script}")"
  cat > "${counter_script}" <<EOF
import pathlib, time
release = pathlib.Path("${release}")
outcome = "timed out"
for _ in range(200):
    if release.is_file():
        outcome = "released"
        break
    time.sleep(0.05)
pathlib.Path("${counter_outcome}").write_text(outcome, encoding="utf-8")
print("1")
EOF
  (
    track-build-event "1000000" "2000000" "0" "" "" "${build_dir}" 0 false false &
    echo "done"
  ) | cat >/dev/null
  touch "${release}"
  BT_EXPECT wait_for_logged_event "build"
  BT_EXPECT_FILE_CONTAINS "${counter_outcome}" "released"

  # 5. _metrics_run reuses _METRICS_RESOLVED_PYTHON from _metrics_can_run without probing twice.
  set_up_environment "1" "N" "N" "0"
  local probe_count_file="${BT_TEMP_DIR}/find_python_count"
  rm -f "${probe_count_file}"
  (
    eval "_orig_$(declare -f _metrics_find_python)"
    _metrics_find_python() {
      echo "1" >> "${probe_count_file}"
      _orig__metrics_find_python "$@"
    }
    _METRICS_RESOLVED_PYTHON=""
    metrics-read-config
  )
  BT_EXPECT_EQ "$(wc -l < "${probe_count_file}" | tr -d ' ')" "1"

  # 6. _enable_testing redirects logging without force-enabling opted-out configs,
  # tracks live on-disk config transitions without re-reading, and still rejects
  # disallowed custom event subcommands when METRICS_LEVEL=0.
  local test_cfg="${BT_TEMP_DIR}/enable_testing_cfg"
  local test_log="${BT_TEMP_DIR}/enable_testing.log"
  local testing_rc=0
  (
    export HOSTNAME="dev.example.com"
    _enable_testing "${test_log}" 0 "${test_cfg}"
    metrics-write-config 0 ""
    metrics-init shell "ls"
    [[ "${METRICS_LEVEL}" -eq 0 && "${METRICS_ENABLED}" -eq 0 ]] || exit 11
    (track-command-execution "shell" "ls")
    [[ ! -s "${test_log}" ]] || exit 12

    # Disallowed custom event still returns exit 1 when METRICS_LEVEL=0.
    local custom_rc=0
    (track-subcommand-custom-event "disallowed" "act") || custom_rc=$?
    [[ "${custom_rc}" -eq 1 ]] || exit 13

    # Writing enabled config without calling metrics-read-config still reports.
    metrics-write-config 1 "TESTING-UUID"
    (track-command-execution "shell" "ls")
    grep -q '"client_id":"TESTING-UUID"' "${test_log}" || exit 14

    # Disabling on disk without re-calling metrics-read-config stops reporting.
    metrics-read-config
    rm -f "${test_log}"
    metrics-write-config 0 ""
    (track-command-execution "shell" "ls")
    [[ ! -s "${test_log}" ]] || exit 15
  ) || testing_rc=$?
  BT_EXPECT_EQ "${testing_rc}" "0"

  # 7. metrics-write-config and metrics-write-config-internal fail loudly when !_metrics_can_run.
  local write_ext_err="${BT_TEMP_DIR}/write_ext_err"
  local write_int_err="${BT_TEMP_DIR}/write_int_err"
  local write_ext_rc=0
  local write_int_rc=0
  (
    _metrics_can_run() { return 1; }
    metrics-write-config 0 "" 2>"${write_ext_err}"
  ) || write_ext_rc=$?
  BT_EXPECT_EQ "${write_ext_rc}" "1"
  BT_EXPECT_FILE_CONTAINS_SUBSTRING "${write_ext_err}" "ERROR:"
  (
    _metrics_can_run() { return 1; }
    metrics-write-config-internal "SOME-UUID" 2>"${write_int_err}"
  ) || write_int_rc=$?
  BT_EXPECT_EQ "${write_int_rc}" "1"
  BT_EXPECT_FILE_CONTAINS_SUBSTRING "${write_int_err}" "ERROR:"
}

_unset_agent_env_vars() {
  local file var
  for file in \
    "${BT_TEMP_DIR}/tools/devshell/lib/agents.txt" \
    "${BT_TEMP_DIR}/tools/devshell/lib/agent_session_ids.txt"; do
    while IFS= read -r var || [[ -n "${var}" ]]; do
      [[ -z "${var}" || "${var}" == \#* ]] && continue
      unset "${var}"
    done < "${file}"
  done
}

