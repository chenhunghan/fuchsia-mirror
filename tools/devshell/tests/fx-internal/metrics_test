  BT_EXPECT_FILE_CONTAINS_SUBSTRING "${metrics_log}" '"internal":{"value":1}'
  BT_EXPECT_FILE_CONTAINS_SUBSTRING "${metrics_log}" '"shell":{"value":"bash"}'
  BT_EXPECT_FILE_CONTAINS_SUBSTRING "${metrics_log}" '"name":"finish"'
  BT_EXPECT_FILE_CONTAINS_SUBSTRING "${metrics_log}" '"exit_status":"4"'
  BT_EXPECT_FILE_CONTAINS_SUBSTRING "${metrics_log}" '"is_remote":"0"'

  # 4. Migrated Googler opted out (analytics-status-internal=0) ignores stale
  # METRICS_ENABLED=1 and emits zero events or notices.
  set_up_environment "1" "N" "0" "1"
  export HOSTNAME
  local optout_rc=0
  (
    _unset_agent_env_vars
    FX_PYTHON_CLI=1 "${fx}" get-src-dir >/dev/null 2>"${metrics_notice}"
  ) || optout_rc=$?
