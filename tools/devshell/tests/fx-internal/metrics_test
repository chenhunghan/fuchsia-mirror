  expect_not_show_notice
  BT_EXPECT wait_for_logged_event "invoke"
  BT_EXPECT wait_for_logged_event "finish"
  BT_EXPECT_FILE_CONTAINS_SUBSTRING "${metrics_log}" '"name":"feature"'
  BT_EXPECT_FILE_CONTAINS_SUBSTRING "${metrics_log}" '"name":"invoke"'
  BT_EXPECT_FILE_CONTAINS_SUBSTRING "${metrics_log}" '"subcommand":"py-metrics-cmd"'
  BT_EXPECT_FILE_CONTAINS_SUBSTRING "${metrics_log}" '"args":"$FUCHSIA_DIR/secret_arg"'
