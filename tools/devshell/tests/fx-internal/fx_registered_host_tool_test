_install_mock_bazel_wrapper() {
  local bazel_bin="${BT_TEMP_DIR}/out/default/gen/build/bazel/bazel"
  mkdir -p "$(dirname "${bazel_bin}")"
  cat > "${bazel_bin}" <<'EOF'
#!/bin/bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BUILD_DIR="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
STATE_FILE="${BUILD_DIR}/bazel.mock_state"
printf '%s\n' "$*" >> "${STATE_FILE}"

if [[ -f "${BUILD_DIR}/bazel.mock_side_effects" ]]; then
  source "${BUILD_DIR}/bazel.mock_side_effects"
fi

bep_file=""
target_label=""
for arg in "$@"; do
  case "${arg}" in
    --build_event_json_file=*)
      bep_file="${arg#--build_event_json_file=}"
      ;;
    @//*|//*)
      target_label="${arg#@}"
      ;;
  esac
done

if [[ -n "${bep_file}" && -n "${target_label}" ]]; then
  clean_rel="${target_label#//}"
  if [[ "${clean_rel}" == *:* ]]; then
    pkg_rel="${clean_rel%%:*}"
    tname="${clean_rel#*:}"
  else
    pkg_rel="${clean_rel}"
    tname="${pkg_rel##*/}"
  fi
  exec_bin_dir="${SCRIPT_DIR}/output_base/execroot/_main/bazel-out/x86_64-opt/bin/${pkg_rel}"
  out_bin=""
  for cand in "${exec_bin_dir}/${tname}" "${exec_bin_dir}"/*; do
    if [[ -f "${cand}" && "${cand}" != *.runtime_dir ]]; then
      out_bin="${cand}"
      break
    fi
  done
  if [[ -n "${out_bin}" ]]; then
    out_name="$(basename "${out_bin}")"
    encoded_out_bin="${out_bin// /%20}"
    cat > "${bep_file}" <<JSON
{"id":{"namedSet":{"id":"0"}},"namedSetOfFiles":{"files":[{"name":"${pkg_rel}/${out_name}","uri":"file://${encoded_out_bin}"}]}}
{"id":{"targetCompleted":{"label":"@@//${pkg_rel}:${tname}"}},"completed":{"success":true}}
JSON
  fi
fi
EOF
  chmod +x "${bazel_bin}"
}

_stage_fake_bazel_output() {
  local pkg_rel="$1"
  local out_name="$2"
  local message="$3"
  local always_build="${4:-0}"
  # Stage ONLY in output_base/execroot (NO workspace/bazel-bin symlink!)
  local bazel_pkg_bin="${BT_TEMP_DIR}/out/default/gen/build/bazel/output_base/execroot/_main/bazel-out/x86_64-opt/bin/${pkg_rel}"
  mkdir -p "${bazel_pkg_bin}/${out_name}.runtime_dir"
  cat > "${bazel_pkg_bin}/${out_name}.runtime_dir/payload.txt" <<EOF
${message}
EOF
  if [[ "${always_build}" == "1" ]]; then
    : > "${bazel_pkg_bin}/${out_name}.runtime_dir/.always_build"
  else
    rm -f "${bazel_pkg_bin}/${out_name}.runtime_dir/.always_build"
  fi
  cat > "${bazel_pkg_bin}/${out_name}" <<EOF
#!/bin/bash
set -euo pipefail
if [[ "\${1:-}" == "--help" || "\${1:-}" == "-h" ]]; then
  echo "usage: fx ${out_name} [--flag] (${message})"
  exit 0
fi
SCRIPT_DIR="\$(cd "\$(dirname "\${BASH_SOURCE[0]}")" && pwd)"
PAYLOAD="\$(cat "\${SCRIPT_DIR}/${out_name}.runtime_dir/payload.txt")"
echo "\${PAYLOAD}|cwd=\${PWD}|args=\$*"
EOF
  chmod +x "${bazel_pkg_bin}/${out_name}"
}

TEST_registry_lookup() {
  source "${BT_TEMP_DIR}/tools/devshell/lib/vars.sh"
  source "${BT_TEMP_DIR}/tools/devshell/lib/fx-cmd-locator.sh"

  if declare -f get_registered_host_tool_scope >/dev/null 2>&1; then
    BT_FAIL "get_registered_host_tool_scope should not exist; all tools live in \$FUCHSIA_BUILD_DIR/host-tools"
  fi

  local target
  target="$(get_registered_host_tool_target "my-reg-tool")"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_EQ "${target}" "//scripts/developer:my-reg-tool"

  target="$(get_registered_host_tool_target "other-tool")"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_EQ "${target}" "//tools/other:other_bin"

  BT_EXPECT_FAIL get_registered_host_tool_target "nonexistent-tool"

  mkdir -p "${BT_TEMP_DIR}/vendor/acme/scripts/devshell"
  cat > "${BT_TEMP_DIR}/vendor/acme/scripts/devshell/fx_host_tools.json" <<'EOF'
{
  "acme-tool": "//vendor/acme/tools:acme-tool"
}
EOF
  target="$(get_registered_host_tool_target "acme-tool" "acme")"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_EQ "${target}" "//vendor/acme/tools:acme-tool"

  rm -rf "${BT_TEMP_DIR}/out/_fx_host_tools"
  BT_EXPECT_EQ "$(get_registered_host_tool_install_path "my-reg-tool")" "${BT_TEMP_DIR}/out/_fx_host_tools/my-reg-tool"
}

