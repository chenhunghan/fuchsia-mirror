TEST_materialize_preserves_internal_symlinks_and_aborts_on_staging_failure() {
  rm -rf "${BT_TEMP_DIR}/out/_fx_host_tools" "${BT_TEMP_DIR}/out/default/bazel.mock_state"

  # 1. Stage a tool with:
  #    (a) an internal relative symlink (.bin/helper.runfiles -> ../my-reg-tool.runfiles)
  #    (b) an ephemeral bazel-out directory symlink containing multicall relative symlinks
  #        (bin/clang++ -> clang -> llvm) plus an external ephemeral file symlink.
  local bazel_pkg_bin="${BT_TEMP_DIR}/out/default/gen/build/bazel/output_base/execroot/_main/bazel-out/x86_64-opt/bin/scripts/developer"
  local eph_tc="${bazel_pkg_bin}/_ephemeral_tc"
  local eph_ext_file="${bazel_pkg_bin}/_ephemeral_ext.txt"
  mkdir -p "${bazel_pkg_bin}/my-reg-tool.runtime_dir/.bin" \
    "${bazel_pkg_bin}/my-reg-tool.runtime_dir/my-reg-tool.runfiles/_main" \
    "${eph_tc}/bin"
  echo "RUNFILE_OK" > "${bazel_pkg_bin}/my-reg-tool.runtime_dir/my-reg-tool.runfiles/_main/data.txt"
  ln -snf "../my-reg-tool.runfiles" "${bazel_pkg_bin}/my-reg-tool.runtime_dir/.bin/helper.runfiles"

  echo "EXT_FILE_OK" > "${eph_ext_file}"
  cat > "${eph_tc}/bin/llvm" <<'EOF'
#!/bin/bash
echo "mc:$(basename "$0")"
EOF
  chmod +x "${eph_tc}/bin/llvm"
  ln -snf "llvm" "${eph_tc}/bin/clang"
  ln -snf "clang" "${eph_tc}/bin/clang++"
  ln -snf "${eph_ext_file}" "${eph_tc}/ext_cfg.txt"
  ln -snf "${eph_tc}" "${bazel_pkg_bin}/my-reg-tool.runtime_dir/ephemeral_tc"

  cat > "${bazel_pkg_bin}/my-reg-tool" <<'EOF'
#!/bin/bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RT_DIR="${SCRIPT_DIR}/my-reg-tool.runtime_dir"
echo "$(cat "${RT_DIR}/.bin/helper.runfiles/_main/data.txt")|$("${RT_DIR}/ephemeral_tc/bin/clang++")|$(cat "${RT_DIR}/ephemeral_tc/ext_cfg.txt")"
EOF
  chmod +x "${bazel_pkg_bin}/my-reg-tool"

  local out
  out="$("${fx}" my-reg-tool 2>/dev/null)"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_EQ "${out}" "RUNFILE_OK|mc:clang++|EXT_FILE_OK"

  local staged_rt="${BT_TEMP_DIR}/out/_fx_host_tools/my-reg-tool.runtime_dir"
  # Internal relative symlink MUST stay a symlink (never duplicated via cp -RL).
  if [[ ! -L "${staged_rt}/.bin/helper.runfiles" ]]; then
    BT_FAIL "Expected .bin/helper.runfiles to remain a relative symlink"
  fi
  BT_EXPECT_EQ "$(readlink "${staged_rt}/.bin/helper.runfiles")" "../my-reg-tool.runfiles"

  # Ephemeral directory MUST be materialized as a directory, while preserving its internal
  # multicall relative symlinks (clang++ -> clang -> llvm) and materializing external ephemeral links.
  if [[ -L "${staged_rt}/ephemeral_tc" || ! -d "${staged_rt}/ephemeral_tc" ]]; then
    BT_FAIL "Expected ephemeral_tc directory symlink to be materialized as a real directory"
  fi
  if [[ ! -L "${staged_rt}/ephemeral_tc/bin/clang" || ! -L "${staged_rt}/ephemeral_tc/bin/clang++" ]]; then
    BT_FAIL "Expected multicall symlinks clang and clang++ inside ephemeral_tc to remain relative symlinks"
  fi
  BT_EXPECT_EQ "$(readlink "${staged_rt}/ephemeral_tc/bin/clang")" "llvm"
  BT_EXPECT_EQ "$(readlink "${staged_rt}/ephemeral_tc/bin/clang++")" "clang"
  if [[ -L "${staged_rt}/ephemeral_tc/ext_cfg.txt" ]]; then
    BT_FAIL "Expected external ephemeral file symlink inside ephemeral_tc to be materialized"
  fi

  # Wipe output_base (simulating `fx bazel clean`) and verify staged tool still runs.
  rm -rf "${BT_TEMP_DIR}/out/default/gen/build/bazel/output_base"
  out="$("${fx}" my-reg-tool 2>/dev/null)"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_EQ "${out}" "RUNFILE_OK|mc:clang++|EXT_FILE_OK"

  # 2. Simulate a copy failure during staging (e.g. unreadable file / ENOSPC):
  #    fx MUST fail closed without installing a corrupted binary or writing a .stamp file!
  cat > "${BT_TEMP_DIR}/tools/devshell/fx_host_tools.json" <<'EOF'
{
  "other-tool": "//tools/other:other_bin"
}
EOF
  local bad_pkg_bin="${BT_TEMP_DIR}/out/default/gen/build/bazel/output_base/execroot/_main/bazel-out/x86_64-opt/bin/tools/other"
  mkdir -p "${bad_pkg_bin}/other_bin.runtime_dir"
  echo "secret" > "${bad_pkg_bin}/other_bin.runtime_dir/unreadable.bin"
  chmod 000 "${bad_pkg_bin}/other_bin.runtime_dir/unreadable.bin"
  cat > "${bad_pkg_bin}/other_bin" <<'EOF'
#!/bin/bash
echo "SHOULD_NEVER_RUN"
EOF
  chmod +x "${bad_pkg_bin}/other_bin"

  local fail_out
  fail_out="$("${fx}" other-tool 2>&1)"
  local fail_rc=$?
  chmod 644 "${bad_pkg_bin}/other_bin.runtime_dir/unreadable.bin"

  if [[ "${fail_rc}" -eq 0 ]]; then
    BT_FAIL "Expected staging copy failure to return non-zero, got 0 (output: ${fail_out})"
  fi
  BT_ASSERT_FILE_DOES_NOT_EXIST "${BT_TEMP_DIR}/out/_fx_host_tools/.stamps/other-tool.stamp"
  BT_ASSERT_FILE_DOES_NOT_EXIST "${BT_TEMP_DIR}/out/_fx_host_tools/other-tool"
}

_git_blob_sha1() {
  "${_TEST_PY3}" -c 'import hashlib, pathlib, sys; d = pathlib.Path(sys.argv[1]).read_bytes(); print(hashlib.sha1(f"blob {len(d)}\0".encode() + d).hexdigest())' "$1"
}

TEST_sources_manifest_and_force_build_flag() {
  # Simulate LUCI Swarming test shard environment where git is not installed.
  git() { return 127; }
  rm -rf "${BT_TEMP_DIR}/out/_fx_host_tools" "${BT_TEMP_DIR}/out/default/bazel.mock_state"

  local src_pkg="${BT_TEMP_DIR}/tools/sample_tool"
  mkdir -p "${src_pkg}"
  echo 'print("hello-v1")' > "${src_pkg}/sample.py"

  cat > "${BT_TEMP_DIR}/tools/devshell/fx_host_tools.json" <<'EOF'
{
  "manifest-tool": "//tools/sample_tool:manifest-tool"
}
EOF

  local bazel_pkg_bin="${BT_TEMP_DIR}/out/default/gen/build/bazel/output_base/execroot/_main/bazel-out/x86_64-opt/bin/tools/sample_tool"
  mkdir -p "${bazel_pkg_bin}/manifest-tool.runtime_dir"
  : > "${bazel_pkg_bin}/manifest-tool.runtime_dir/.always_build"

  cat > "${bazel_pkg_bin}/manifest-tool" <<'EOF'
#!/bin/bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
echo "RUNNING:$(python3 "${SCRIPT_DIR}/manifest-tool.runtime_dir/tools/sample_tool/sample.py")"
EOF
  chmod +x "${bazel_pkg_bin}/manifest-tool"

  mkdir -p "${bazel_pkg_bin}/manifest-tool.runtime_dir/tools/sample_tool"
  cp -f "${src_pkg}/sample.py" "${bazel_pkg_bin}/manifest-tool.runtime_dir/tools/sample_tool/sample.py"

  # Write sources.manifest matching current source file
  local sha
  sha="$(_git_blob_sha1 "${src_pkg}/sample.py")"
  printf '%s  tools/sample_tool/sample.py
' "${sha}" > "${bazel_pkg_bin}/manifest-tool.runtime_dir/sources.manifest"

  # First run builds and installs
  local out1
  out1="$("${fx}" manifest-tool 2>/dev/null)"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_EQ "${out1}" "RUNNING:hello-v1"
  BT_ASSERT_FILE_EXISTS "${BT_TEMP_DIR}/out/default/bazel.mock_state"

  # Warm run with matching sources.manifest skips Bazel (even with .always_build present!)
  rm -f "${BT_TEMP_DIR}/out/default/bazel.mock_state"
  local out_warm
  out_warm="$("${fx}" manifest-tool 2>/dev/null)"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_EQ "${out_warm}" "RUNNING:hello-v1"
  BT_ASSERT_FILE_DOES_NOT_EXIST "${BT_TEMP_DIR}/out/default/bazel.mock_state"

  # Modifying the source file invalidates sources.manifest and triggers Bazel rebuild
  echo 'print("hello-v2")' > "${src_pkg}/sample.py"
  cp -f "${src_pkg}/sample.py" "${bazel_pkg_bin}/manifest-tool.runtime_dir/tools/sample_tool/sample.py"
  sha="$(_git_blob_sha1 "${src_pkg}/sample.py")"
  printf '%s  tools/sample_tool/sample.py
' "${sha}" > "${bazel_pkg_bin}/manifest-tool.runtime_dir/sources.manifest"

  local out_edit
  out_edit="$("${fx}" manifest-tool 2>/dev/null)"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_EQ "${out_edit}" "RUNNING:hello-v2"
  BT_ASSERT_FILE_EXISTS "${BT_TEMP_DIR}/out/default/bazel.mock_state"

  # fx --build forces Bazel rebuild even when sources.manifest is fresh
  rm -f "${BT_TEMP_DIR}/out/default/bazel.mock_state"
  local out_force
  out_force="$("${fx}" --build manifest-tool 2>/dev/null)"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_EQ "${out_force}" "RUNNING:hello-v2"
  BT_ASSERT_FILE_EXISTS "${BT_TEMP_DIR}/out/default/bazel.mock_state"

  # Multi-file sources.manifest validation: when all listed files match their
  # git blob SHA-1, _sources_manifest_check succeeds without rebuilding.
  echo 'HELPER = 1' > "${src_pkg}/helper.py"
  local sha2
  sha2="$(_git_blob_sha1 "${src_pkg}/helper.py")"
  printf '%s  tools/sample_tool/sample.py\n%s  tools/sample_tool/helper.py\n' "${sha}" "${sha2}" \
    > "${BT_TEMP_DIR}/out/_fx_host_tools/manifest-tool.runtime_dir/sources.manifest"

  rm -f "${BT_TEMP_DIR}/out/default/bazel.mock_state"
  local out_mixed
  out_mixed="$("${fx}" manifest-tool 2>/dev/null)"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_EQ "${out_mixed}" "RUNNING:hello-v2"
  BT_ASSERT_FILE_DOES_NOT_EXIST "${BT_TEMP_DIR}/out/default/bazel.mock_state"
}

TEST_concurrent_build_lock_runs_existing_binary_with_warning_and_waits_when_unbuilt() {
  rm -rf "${BT_TEMP_DIR}/out/_fx_host_tools" "${BT_TEMP_DIR}/out/default/bazel.mock_state"
  _stage_fake_bazel_output "scripts/developer" "my-reg-tool" "locked-v1" "1"
  "${fx}" my-reg-tool warmup >/dev/null 2>&1
  BT_EXPECT_EQ $? 0
  rm -f "${BT_TEMP_DIR}/out/default/bazel.mock_state"

  # Stage v2 in Bazel, then hold out/default.build_lock with a live background sleep PID.
  _stage_fake_bazel_output "scripts/developer" "my-reg-tool" "locked-v2" "1"
  sleep 30 &
  local holder_pid=$!
  printf '%s\n' "${holder_pid}" > "${BT_TEMP_DIR}/out/default.build_lock"

  local out_existing="${BT_TEMP_DIR}/_lock_out"
  local err_existing="${BT_TEMP_DIR}/_lock_err"
  "${fx}" my-reg-tool during-build >"${out_existing}" 2>"${err_existing}"
  local rc_existing=$?
  kill "${holder_pid}" 2>/dev/null || true
  wait "${holder_pid}" 2>/dev/null || true
  rm -f "${BT_TEMP_DIR}/out/default.build_lock"

  BT_EXPECT_EQ "${rc_existing}" 0
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "$(<"${out_existing}")" "locked-v1|"
  BT_EXPECT_FILE_CONTAINS_SUBSTRING "${err_existing}" "active fx build"
  BT_ASSERT_FILE_DOES_NOT_EXIST "${BT_TEMP_DIR}/out/default/bazel.mock_state"

  # When host-tools/<cmd> does NOT exist yet and .build_lock is held briefly,
  # fx prints a waiting notice to stderr, waits for the lock holder to exit, and builds!
  rm -rf "${BT_TEMP_DIR}/out/_fx_host_tools" "${BT_TEMP_DIR}/out/default/bazel.mock_state"
  (
    sleep 1
    rm -f "${BT_TEMP_DIR}/out/default.build_lock"
  ) &
  local short_pid=$!
  printf '%s\n' "${short_pid}" > "${BT_TEMP_DIR}/out/default.build_lock"

  local out_wait="${BT_TEMP_DIR}/_wait_out"
  local err_wait="${BT_TEMP_DIR}/_wait_err"
  "${fx}" my-reg-tool after-lock >"${out_wait}" 2>"${err_wait}"
  local rc_wait=$?
  wait "${short_pid}" 2>/dev/null || true
  rm -f "${BT_TEMP_DIR}/out/default.build_lock"

  BT_EXPECT_EQ "${rc_wait}" 0
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "$(<"${out_wait}")" "locked-v2|"
  BT_EXPECT_FILE_CONTAINS_SUBSTRING "${err_wait}" "Waiting for active fx build"
  BT_ASSERT_FILE_EXISTS "${BT_TEMP_DIR}/out/default/bazel.mock_state"

  # Missing fx.config during clean-build:
  # Existing staged tool runs via fast path without triggering fx-gen even if fx.config was wiped.
  _stage_fake_bazel_output "scripts/developer" "my-reg-tool" "locked-v2" "0"
  "${fx}" my-reg-tool warmup >/dev/null 2>&1
  rm -f "${BT_TEMP_DIR}/out/default/fx.config" "${BT_TEMP_DIR}/out/default/bazel.mock_state"
  local out_nocfg="${BT_TEMP_DIR}/_nocfg_out"
  local err_nocfg="${BT_TEMP_DIR}/_nocfg_err"
  "${fx}" my-reg-tool warm-nocfg >"${out_nocfg}" 2>"${err_nocfg}"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "$(<"${out_nocfg}")" "locked-v2|"
  BT_ASSERT_FILE_DOES_NOT_EXIST "${BT_TEMP_DIR}/out/default/bazel.mock_state"
}

