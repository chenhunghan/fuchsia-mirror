  chmod +x "${BT_TEMP_DIR}/out/default/host-tools/legacy-ht-bin"
  local out_legacy_ht err_legacy_ht
  out_legacy_ht="$(FX_OUTPUT_REGISTRY_ACTIONS=1 "${fx}" legacy-ht-bin 2>"${BT_TEMP_DIR}/_legacy_ht_err")"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_EQ "${out_legacy_ht}" "LEGACY_HT_BIN_OUTPUT"
  err_legacy_ht="$(<"${BT_TEMP_DIR}/_legacy_ht_err")"
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${err_legacy_ht}" "\[fx-registry\] lookup 'legacy-ht-bin': not in registry; falling back to legacy host-tools binary //out/default/host-tools/legacy-ht-bin"

  # 9. Staged host tool works with fx --no-build and fx help even when .fx-build-dir is absent.
  rm -f "${BT_TEMP_DIR}/.fx-build-dir"
  local out_no_bdir_nobuild
  out_no_bdir_nobuild="$("${fx}" --no-build my-reg-tool after-rm-bdir 2>"${BT_TEMP_DIR}/_no_bdir_err")"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${out_no_bdir_nobuild}" "v1|"
}

BT_RUN_TESTS "$@"
