{
  "reg-build-tool": {
    "category": "Build",
    "summary": "build widget from registry",
    "target": "//scripts/developer:reg-build-tool"
  },
  "reg-contrib-tool": {
    "category": "Testing",
    "contrib": true,
    "summary": "contrib widget from registry",
    "target": "//scripts/developer:reg-contrib-tool"
