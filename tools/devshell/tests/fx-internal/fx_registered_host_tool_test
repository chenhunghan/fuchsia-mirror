TEST_skips_legacy_path_injection_by_default_and_honors_incremental_opt_in() {
  local fake_clang_bin="${BT_TEMP_DIR}/pre""built/third_party/clang/linux-x64/bin"
  local fake_rt_bin="${BT_TEMP_DIR}/out/_fx_host_tools/parent.runtime_dir/.bin"
  mkdir -p "${fake_clang_bin}" "${fake_rt_bin}"
  touch "${fake_clang_bin}/clang" "${fake_rt_bin}/staged_tool"
  chmod +x "${fake_clang_bin}/clang" "${fake_rt_bin}/staged_tool"

  mkdir -p "${BT_TEMP_DIR}/tools/devshell/host_tools/path_test"
  cat > "${BT_TEMP_DIR}/tools/devshell/host_tools/path_test/clean_tool.sh" <<'EOF'
#!/bin/bash
echo "CLEAN|FLAG=${FX_INJECT_PREBUILT_PATHS:-unset}|PATH=${PATH}"
EOF
  chmod +x "${BT_TEMP_DIR}/tools/devshell/host_tools/path_test/clean_tool.sh"

  cat > "${BT_TEMP_DIR}/tools/devshell/host_tools/path_test/optin_tool.sh" <<'EOF'
#!/bin/bash
echo "OPTIN|FLAG=${FX_INJECT_PREBUILT_PATHS:-unset}|PATH=${PATH}"
EOF
  chmod +x "${BT_TEMP_DIR}/tools/devshell/host_tools/path_test/optin_tool.sh"

  cat > "${BT_TEMP_DIR}/tools/devshell/fx_host_tools.json" <<'EOF'
{
  "clean-reg-tool": {
    "category": "Build",
    "script": "//tools/devshell/host_tools/path_test/clean_tool.sh",
    "summary": "clean registered tool"
  },
  "optin-reg-tool": {
    "category": "Build",
    "inject_prebuilt_paths": true,
    "script": "//tools/devshell/host_tools/path_test/optin_tool.sh",
    "summary": "optin registered tool"
  }
}
EOF

  local out_clean
  out_clean="$(PATH="/usr/bin:/bin" "${fx}" clean-reg-tool 2>/dev/null)"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${out_clean}" "CLEAN|FLAG=0|"
  if [[ "${out_clean}" == *"/third_party/clang/"* ]]; then
    BT_FAIL "Expected clean-reg-tool to omit /third_party/clang/ from PATH, got: ${out_clean}"
  fi

  local out_optin
  out_optin="$(PATH="/usr/bin:/bin" "${fx}" optin-reg-tool 2>/dev/null)"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${out_optin}" "OPTIN|FLAG=1|"
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${out_optin}" "/third_party/clang/"

  cat > "${BT_TEMP_DIR}/tools/devshell/fx_host_tools.json" <<'EOF'
{
  "clean-reg-tool": {
    "script": "//tools/devshell/host_tools/path_test/clean_tool.sh"
  },
  "optin-reg-tool": {
    "inject_prebuilt_paths": true,
    "script": "//tools/devshell/host_tools/path_test/optin_tool.sh"
  },
  "hop-0-to-1": {
    "script": "//tools/devshell/hop_0_to_1.sh"
  },
  "hop-1-to-0": {
    "script": "//tools/devshell/hop_1_to_0.sh",
    "inject_prebuilt_paths": true
  }
}
EOF
  cat > "${BT_TEMP_DIR}/tools/devshell/hop_0_to_1.sh" <<EOF
#!/bin/bash
source "${BT_TEMP_DIR}/tools/devshell/lib/vars.sh" || exit \$?
echo "OUTER_0|FLAG=\${FX_INJECT_PREBUILT_PATHS}"
fx-command-run optin-reg-tool
EOF
  chmod +x "${BT_TEMP_DIR}/tools/devshell/hop_0_to_1.sh"

  cat > "${BT_TEMP_DIR}/tools/devshell/hop_1_to_0.sh" <<EOF
#!/bin/bash
source "${BT_TEMP_DIR}/tools/devshell/lib/vars.sh" || exit \$?
echo "OUTER_1|FLAG=\${FX_INJECT_PREBUILT_PATHS}"
fx-command-run clean-reg-tool
EOF
  chmod +x "${BT_TEMP_DIR}/tools/devshell/hop_1_to_0.sh"

  local hop_01 hop_10
  hop_01="$(PATH="/usr/bin:/bin" "${fx}" hop-0-to-1 2>/dev/null)"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${hop_01}" "OUTER_0|FLAG=0"
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${hop_01}" "FLAG=1"
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${hop_01}" "/third_party/clang/"

  hop_10="$(PATH="/usr/bin:/bin" "${fx}" hop-1-to-0 2>/dev/null)"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${hop_10}" "OUTER_1|FLAG=1"
  local inner_10_line
  inner_10_line="$(printf '%s\n' "${hop_10}" | tail -n 1)"
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${inner_10_line}" "FLAG=0"
  if [[ "${inner_10_line}" == *"/third_party/clang/"* ]]; then
    BT_FAIL "Expected hop 1->0 child clean-reg-tool to omit /third_party/clang/, got: ${inner_10_line}"
  fi

  local legacy_cmd="${BT_TEMP_DIR}/tools/devshell/legacy-path-cmd"
  cat > "${legacy_cmd}" <<'EOF'
#!/bin/bash
echo "PATH=${PATH}"
EOF
  chmod +x "${legacy_cmd}"
  local out_legacy
  out_legacy="$(PATH="/usr/bin:/bin" "${fx}" legacy-path-cmd 2>/dev/null)"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${out_legacy}" "/third_party/clang/"
}

