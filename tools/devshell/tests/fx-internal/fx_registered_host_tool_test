  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${out}" "v1|"
  BT_ASSERT_FILE_EXISTS "${BT_TEMP_DIR}/out/default/bazel.mock_state"

  # Remove mock_state; warm invocation at same lockfile/BUILD state should NOT rebuild.
  rm -f "${BT_TEMP_DIR}/out/default/bazel.mock_state"
  out="$("${fx}" my-reg-tool second 2>/dev/null)"
  BT_EXPECT_EQ $? 0
  BT_EXPECT_STRING_CONTAINS_SUBSTRING "${out}" "v1|"
  BT_ASSERT_FILE_DOES_NOT_EXIST "${BT_TEMP_DIR}/out/default/bazel.mock_state"

  # Updating manifests/jiri.lock invalidates the stamp and triggers a rebuild + reinstall.
  echo '[{"package":"updated-lock-v2"}]' > "${BT_TEMP_DIR}/manifests/jiri.lock"
  _stage_fake_bazel_output "scripts/developer" "my-reg-tool" "v2"
