  rm -f "${BT_TEMP_DIR}/out/default/bazel.mock_state"
  echo "# developer build v3" > "${BT_TEMP_DIR}/scripts/developer/BUILD.bazel"
  _stage_fake_bazel_output "scripts/developer" "my-reg-tool" "v3"
