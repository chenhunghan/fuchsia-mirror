load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host:defs.bzl", "rustc_binary_host_tool")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")

package(default_applicable_licenses = ["//:license"])

# Rust binary for analyzing GN target graphs.
rustc_binary_host_tool(
    name = "gn_desc",
    testonly = True,
    srcs = [
        "src/args.rs",
        "src/commands.rs",
        "src/commands/all_deps.rs",
        "src/commands/list.rs",
        "src/commands/selectors.rs",
        "src/commands/summarize.rs",
        "src/display.rs",
        "src/display/list.rs",
        "src/display/optional_line.rs",
        "src/main.rs",
    ],
    # This is compiled with optimizations enabled so that operations are as
    # performant as possible.  The JSON parsing itself is optimized in the
    # `gn_json` rlib, but this ensures that follow-on operations like graph
    # traversals are also optimized.
    build_flags = ["//build/config:optimize_speed"],
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:humansize",
        "//third_party/rust_crates/vendor:regex",
        "//third_party/rust_crates/vendor:serde_json",
        "//tools/gn_desc/gn_graph",
        "//tools/gn_desc/gn_json",
    ],
)

host_rustc_test(
    name = "gn_desc_test",
    crate = ":gn_desc",
    edition = "2024",
    visibility = ["//tools/gn_desc:__pkg__"],
    deps = ["//third_party/rust_crates/vendor:pretty_assertions"],
)
