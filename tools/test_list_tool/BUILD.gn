import("//build/bazel/bazel_host_tool.gni")

if (is_host) {
  bazel_host_tool("test_list_tool") {
    bazel_target = ":test_list_tool"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/test_list_tool"
    install_host_tool = true
  }
}

group("install") {
  deps = [ ":test_list_tool($host_toolchain)" ]
}
