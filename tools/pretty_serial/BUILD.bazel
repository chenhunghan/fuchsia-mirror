load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host:defs.bzl", "rustc_binary_host_tool")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [":pretty_serial_test"],
    visibility = ["//tools:__pkg__"],
)

rustc_binary_host_tool(
    name = "pretty_serial",
    srcs = ["src/main.rs"],
    edition = "2024",
    deps = [
        "//third_party/rust_crates/vendor:ansi_term",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:regex",
    ],
)

host_rustc_test(
    name = "pretty_serial_test",
    crate = ":pretty_serial",
    edition = "2024",
)
