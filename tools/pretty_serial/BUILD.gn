import("//build/bazel/bazel_host_tool.gni")

if (is_host) {
  bazel_host_tool("pretty_serial") {
    bazel_target = ":pretty_serial"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/pretty_serial"
    install_host_tool = true
  }
}
