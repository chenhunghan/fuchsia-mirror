import("//build/bazel/bazel_host_tool.gni")

if (is_host) {
  bazel_host_tool("auto_owners_bin") {
    bazel_target = ":auto_owners_bin"
    output_name = "auto_owners"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/auto_owners"
    install_host_tool = true
  }
}

group("install_auto_owners") {
  deps = [ ":auto_owners_bin($host_toolchain)" ]
}

group("auto_owners") {
  deps = [ ":auto_owners_bin($host_toolchain)" ]
}
