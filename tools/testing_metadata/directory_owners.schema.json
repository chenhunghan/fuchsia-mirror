{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Directory Owners Output",
    "description": "Schema for the aggregated directory_owners.json output file.",
    "type": "object",
    "required": [
        "directories",
        "version"
    ],
    "properties": {
        "directories": {
            "type": "object",
            "description": "Maps each repository directory to its Buganizer component_id and proximity-ranked list of owners.",
            "additionalProperties": {
                "type": "object",
                "properties": {
                    "component_id": {
                        "type": "integer",
                        "description": "The Buganizer issue tracker component ID for this directory."
                    },
                    "owners": {
                        "type": "array",
                        "minItems": 1,
                        "description": "Proximity-ordered list of structured owners for this directory.",
                        "items": {
                            "type": "object",
                            "required": [
                                "email",
                                "tier",
                                "owners_step",
                                "include_depth",
                                "dir_distance",
                                "owners_file"
                            ],
                            "properties": {
                                "email": {
                                    "type": "string",
                                    "description": "Owner email address."
                                },
                                "tier": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "description": "1-based sequential ownership tier ranked by proximity."
                                },
                                "owners_step": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "description": "1-based index of the ancestor OWNERS file walking up from the directory."
                                },
                                "include_depth": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "description": "0 for direct owners in the OWNERS file, 1+ for included OWNERS files."
                                },
                                "dir_distance": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "description": "Number of directory hops up from the directory to the ancestor OWNERS file."
                                },
                                "owners_file": {
                                    "type": "string",
                                    "description": "Repository-relative path to the OWNERS file that contributed this owner."
                                }
                            },
                            "additionalProperties": false
                        }
                    }
                },
                "additionalProperties": false
            }
        },
        "version": {
            "type": "integer",
            "minimum": 1
        }
    },
    "additionalProperties": false
}
