load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/host_tests:host_test_data.bzl", "host_test_data_files")
load("//build/bazel/rules/rust:defs.bzl", "rustc_binary", "rustc_library")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [],  # Include all tests in the package.
    visibility = ["//tools:__pkg__"],
)

rustc_library(
    name = "gtest_test_parser_lib",
    srcs = [
        "src/child_guard.rs",
        "src/lib.rs",
        "src/parser.rs",
        "src/schema.rs",
    ],
    crate_name = "gtest_test_parser",
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//visibility:public"],
    deps = [
        "//src/lib/fuchsia-sync",
        "//third_party/rust_crates/vendor:nix",
        "//third_party/rust_crates/vendor:regex",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:signal-hook",
    ],
)

host_rustc_test(
    name = "gtest_test_parser_lib_tests",
    crate = ":gtest_test_parser_lib",
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        "//third_party/rust_crates/vendor:serde_json",
    ],
)

rustc_binary(
    name = "signal_test_child",
    testonly = True,
    srcs = ["tests/signal_test_child.rs"],
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = [
        "//third_party/rust_crates/vendor:nix",
        "//third_party/rust_crates/vendor:signal-hook",
    ],
)

host_test_data_files(
    name = "gtest_test_parser_bin_data",
    testonly = True,
    srcs = [
        ":gtest_test_parser",
        ":signal_test_child",
    ],
    target_compatible_with = HOST_OS_CONSTRAINTS,
)

host_rustc_test(
    name = "gtest_test_parser_integration_test",
    srcs = ["tests/signal_handling.rs"],
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    test_data = [":gtest_test_parser_bin_data"],
    deps = [
        ":gtest_test_parser_lib",
        "//third_party/rust_crates/vendor:nix",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:tempfile",
    ],
)

rustc_binary(
    name = "gtest_test_parser",
    srcs = [
        "src/main.rs",
    ],
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//visibility:public"],
    deps = [
        ":gtest_test_parser_lib",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:serde_json",
    ],
)
