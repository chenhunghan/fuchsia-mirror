import("//build/bazel/bazel_fuchsia_test_package.gni")
import("//build/bazel/bazel_test_suite.gni")

group("goldens") {
  testonly = true
  deps = [
    ":tests",
    "my-component-test-cpp:tests",
    "my-component-test-rust:tests",
    "my-component-v2-cpp",
    "my-component-v2-rust",
    "my-devicetree-visitor:tests",
    "my-driver-cpp",
    "my-driver-rust",
  ]
}

bazel_test_suite("host_tests") {
  host_tests = [ "//tools/create/goldens:host_tests" ]
}

group("tests") {
  testonly = true
  deps = [ ":host_tests" ]
  if (is_fuchsia) {
    deps += [
      ":test_pkg",
      "my-component-test-cpp:tests",
      "my-component-test-rust:tests",
      "my-component-v2-cpp:tests",
      "my-component-v2-rust:tests",
      "my-devicetree-visitor:tests",
      "my-driver-cpp:tests",
      "my-driver-rust:tests",
    ]
  }
}

if (is_fuchsia) {
  # This isn't the best place for this, but this can't be in the goldens
  # BUILD.gn file as that is for a driver that's defined in GN. So this is
  # defined here to make sure that the golden file is processed and the driver
  # in question is built by Bazel.
  bazel_fuchsia_test_package("test_pkg") {
    bazel_target = "//tools/create/goldens/my-driver-cpp:test_pkg"
    test_package_name = "my_driver_cpp_test"
    test_component_names = [ "my_driver_cpp_test" ]
  }
}
