load("//build/bazel/rules/host:defs.bzl", "rustc_binary_host_tool")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")

package(
    default_applicable_licenses = ["//:license"],
)

rustc_binary_host_tool(
    name = "create_bin",
    srcs = [
        "src/main.rs",
        "src/template_helpers.rs",
        "src/test_util.rs",
        "src/util.rs",
    ],
    crate_name = "create",
    edition = "2024",
    visibility = ["//tools/create/goldens:__pkg__"],
    deps = [
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:chrono",
        "//third_party/rust_crates/vendor:handlebars",
        "//third_party/rust_crates/vendor:heck",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:termion",
    ],
)

host_rustc_test(
    name = "create_bin_test",
    # Read with include_str!() to test how real templates render.
    compile_data = [
        "//tools/create/templates:_copyright.tmpl",
        "//tools/create/templates:_generated.tmpl",
        "//tools/create/templates:driver-default/BUILD.bazel.tmpl-cpp",
        "//tools/create/templates:driver-default/BUILD.bazel.tmpl-rust",
    ],
    crate = ":create_bin",
    edition = "2024",
    visibility = ["//tools:__pkg__"],
    deps = [
        "//src/lib/fuchsia-sync",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:tempfile",
    ],
)
