load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host:defs.bzl", "rustc_binary_host_tool")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/host_tests:host_test_data.bzl", "host_test_data_files")

package(default_applicable_licenses = ["//:license"])

# @bazel2gn:transformer=deps
abi_compat_deps = [
    "//third_party/rust_crates/vendor:anyhow",
    "//third_party/rust_crates/vendor:argh",
    "//third_party/rust_crates/vendor:bitflags",
    "//third_party/rust_crates/vendor:flyweights",
    "//third_party/rust_crates/vendor:itertools",
    "//third_party/rust_crates/vendor:maplit",
    "//third_party/rust_crates/vendor:serde",
    "//third_party/rust_crates/vendor:serde_json",
]

abi_compat_sources = [
    "src/compare/handle.rs",
    "src/compare/mod.rs",
    "src/compare/path.rs",
    "src/compare/primitive.rs",
    "src/compare/problems.rs",
    "src/compare/types.rs",
    "src/convert.rs",
    "src/ir.rs",
    "src/main.rs",
]

# @bazel2gn:skip
rustc_binary_host_tool(
    name = "abi_compat_bin",
    srcs = abi_compat_sources,
    crate_name = "abi_compat",
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = abi_compat_deps,
)

host_test_data_files(
    name = "abi_compat_test_data",
    testonly = True,
    srcs = ["//tools/fidl/fidlc"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
)

# @bazel2gn:raw_attribute:data_deps = [ ":abi_compat_test_data" ]
host_rustc_test(
    name = "abi_compat_test",
    srcs = abi_compat_sources + [
        "src/compare/protocol_tests.rs",
        "src/compare/test.rs",
        "src/compare/types_tests.rs",
    ],
    crate_root = "src/main.rs",
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    # @bazel2gn:skip
    test_data = [":abi_compat_test_data"],
    visibility = ["//tools:__pkg__"],
    deps = abi_compat_deps + [
        "//third_party/rust_crates/vendor:tempfile",
    ],
)
