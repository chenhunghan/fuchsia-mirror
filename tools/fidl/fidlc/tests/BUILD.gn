import("//build/testing/host_test.gni")
import("//build/testing/host_test_data.gni")

group("tests") {
  testonly = true
  deps = [ ":fidlc-test($host_toolchain)" ]
}

host_test_data("errcat_fidl_bad") {
  _dir = "fidl/bad"
  _files = []
  foreach(_line, read_file("$_dir/files.txt", "list lines")) {
    if (_line != "" && string_replace(">>$_line", ">>#", "") == ">>$_line") {
      _files += [ _line ]
    }
  }
  sources = rebase_path(_files, ".", _dir)
  outputs = [ "$root_out_dir/fidlc-tests/bad/{{source_file_part}}" ]
}

host_test_data("errcat_fidl_good") {
  _dir = "fidl/good"
  _files = []
  foreach(_line, read_file("$_dir/files.txt", "list lines")) {
    if (_line != "" && string_replace(">>$_line", ">>#", "") == ">>$_line") {
      _files += [ _line ]
    }
  }
  sources = rebase_path(_files, ".", _dir)
  outputs = [ "$root_out_dir/fidlc-tests/good/{{source_file_part}}" ]
}

host_test_data("errcat_md") {
  _dir = "//docs/reference/fidl/language/error-catalog"
  _files = []
  foreach(_line, read_file("$_dir/_files.txt", "list lines")) {
    if (_line != "" && string_replace(">>$_line", ">>#", "") == ">>$_line") {
      _files += [ _line ]
    }
  }
  sources = rebase_path(_files, ".", _dir)
  outputs = [ "$root_out_dir/fidlc-tests/error-catalog/{{source_file_part}}" ]
}

host_test_data("errcat_other") {
  sources = [
    "//docs/error/_redirects.yaml",
    "//docs/reference/fidl/language/errcat.md",
    "errcat_good_tests.cc",
  ]
  outputs = [ "$root_out_dir/fidlc-tests/{{source_file_part}}" ]
}

relative_root_out_dir = rebase_path(root_out_dir, root_build_dir)

# The GN copy of the `fidlc-test` Bazel host test. bazel2gn doesn't
# translate `host_test()` yet (https://fxbug.dev/574121341), and the
# generated `cc_test_executable("fidlc-test_bin")` doesn't register a
# host test by itself.
if (is_host) {
  host_test("fidlc-test") {
    binary_path = "$root_out_dir/fidlc-test"
    target = get_label_info(":fidlc-test_bin", "label_with_toolchain")
    deps = [
      ":errcat_fidl_bad",
      ":errcat_fidl_good",
      ":errcat_md",
      ":errcat_other",
      ":fidlc-test_bin",
    ]
  }
}

