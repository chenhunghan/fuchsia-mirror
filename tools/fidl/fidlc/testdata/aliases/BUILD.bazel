load("//tools/fidl/fidlc/testdata:fidl_golden_library.bzl", "fidl_golden_library")

package(default_applicable_licenses = ["//:license"])

# LINT.IfChange
fidl_golden_library(
    name = "test.aliases",
    srcs = ["example.test.fidl"],
    excluded_checks = [
        "invalid-case-for-decl-name",
        "invalid-copyright-for-platform-source-library",
        "string-bounds-not-specified",
        "vector-bounds-not-specified",
    ],
    experimental_flags = ["output_index_json"],
    deps = [":test.someotherlibrary"],
