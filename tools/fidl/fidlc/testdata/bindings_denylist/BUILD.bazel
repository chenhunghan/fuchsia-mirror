load("//tools/fidl/fidlc/testdata:fidl_golden_library.bzl", "fidl_golden_library")

package(default_applicable_licenses = ["//:license"])

# LINT.IfChange
fidl_golden_library(
    name = "test.dependent",
    srcs = ["dependent.test.fidl"],
    excluded_checks = ["invalid-copyright-for-platform-source-library"],
)

fidl_golden_library(
    name = "test.bindingsdenylist",
    srcs = ["example.test.fidl"],
