load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load("//build/bazel/rules/fidl:fidl_library.bzl", "fidl_library")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

fidl_library(
    name = "fidl",
    srcs = ["calculator.fidl"],
    excluded_checks = ["wrong-prefix-for-platform-source-library"],
    library_name = "examples.calculator",
)

rustc_binary(
    name = "bin",
    srcs = ["src/main.rs"],
    crate_name = "calculator",
    edition = "2024",
    tags = ["manual"],
    deps = [
        ":fidl_rust_next",
        "//src/lib/fidl/rust_next/fidl_next",
        "//src/lib/fuchsia",
    ] + select({
        "@platforms//os:fuchsia": ["//sdk/rust/zx"],
        "//conditions:default": [],
    }),
)

fx_packaged_binary(
    name = "bin_packaged",
    binary = ":bin",
    binary_name = "calculator",
)

fx_component_manifest(
    name = "manifest",
    component_name = "rust_next_calculator",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/rust_next_calculator.cml",
)

fx_component(
    name = "component",
    compiled_manifest = ":manifest",
    deps = [":bin_packaged"],
)

fx_package(
    name = "rust_next_calculator",
    components = [":component"],
)

# Device unit tests, packaged as `rust_next_calculator_unittests` and
# exported via //tools:target_tests.
rustc_test(
    name = "calculator_bin_test",
    crate = ":bin",
    target_compatible_with = ["@platforms//os:fuchsia"],
)

fx_unittest_package(
    name = "rust_next_calculator_unittests",
    unit_tests = [":calculator_bin_test"],
    visibility = ["//tools:__pkg__"],
)

# Host unit tests, exported via //tools:host_tests.
host_rustc_test(
    name = "calculator_bin_host_test",
    crate = ":bin",
    visibility = ["//tools:__pkg__"],
)
