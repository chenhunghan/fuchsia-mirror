load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host:defs.bzl", "rustc_binary_host_tool")
load("//tools/fidl/fidlc/testdata:info.bzl", "fidl_testdata_info")
load(":golden_tests.bzl", "fidlgen_rust_next_convert_golden_tests")

package(default_applicable_licenses = ["//:license"])

rustc_binary_host_tool(
    name = "fidlgen_rust_next_convert",
    srcs = [
        "src/context.rs",
        "src/ident.rs",
        "src/main.rs",
        "src/templates/bits.rs",
        "src/templates/enum.rs",
        "src/templates/mod.rs",
    ],
    compile_data = [
        "askama.toml",
        "templates/bits.askama",
        "templates/enum.askama",
        "templates/library.askama",
    ],
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//build/bazel/rules:__subpackages__"],
    deps = [
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:askama",
        "//third_party/rust_crates/vendor:serde_json",
        "//tools/fidl/fidl_ir",
        "//tools/fidl/lib/fidlgen_rs",
    ],
)

fidlgen_rust_next_convert_golden_tests(
    name = "fidlgen_rust_next_convert_golden_tests",
    visibility = [
        "//build/bazel/rules/tests:__pkg__",
        "//tools/fidl:__subpackages__",
    ],
)

# LINT.IfChange(goldens)
filegroup(
    name = "goldens",
    testonly = True,
    srcs = select({
        "@platforms//os:fuchsia": [
            "%s_rust_next_convert" % info["target"]
            for info in fidl_testdata_info
            if "fidlgen_rust_next" not in info["device_build_denylist"]
        ],
        "//conditions:default": [
            "%s_rust_next_convert" % info["target"]
            for info in fidl_testdata_info
            if "fidlgen_rust_next" not in info["host_build_denylist"]
        ],
    }),
    visibility = [
        "//build/bazel/rules/tests:__pkg__",
        "//tools/fidl:__subpackages__",
    ],
)
# LINT.ThenChange(BUILD.gn:goldens)
