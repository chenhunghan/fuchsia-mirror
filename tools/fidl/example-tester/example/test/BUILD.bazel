load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")

package(default_applicable_licenses = ["//:license"])

exports_files(
    ["meta/runner.cml"],
    visibility = ["//tools/fidl/example-tester/example:__subpackages__"],
)

rustc_test(
    name = "runner_bin",
    srcs = ["src/main.rs"],
    crate_root = "src/main.rs",
    edition = "2024",
    visibility = ["//tools/fidl/example-tester/example:__subpackages__"],
    deps = [
        "//src/lib/diagnostics/data/rust",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component-test",
        "//src/sys/lib/cm_rust",
        "//third_party/rust_crates/vendor:anyhow",
        "//tools/fidl/example-tester:example_tester",
        "//tools/fidl/example-tester/example/fidl:test.exampletester_rust",
    ],
)
