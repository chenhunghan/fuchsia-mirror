import("//build/tools/bazel2gn/bazel_migration.gni")

if (is_host) {
  python_binary("sdk_ir") {
    sources = [
      "merge.py",
      "sdk_ir.py",
    ]
    main_source = "sdk_ir.py"
    deps = [ "//build/python/modules/depfile" ]
    enable_mypy = false
  }
}
