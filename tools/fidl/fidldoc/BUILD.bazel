load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules:compiled_action.bzl", "compiled_action")
load("//build/bazel/rules:golden_files.bzl", "verify_golden_files")
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//build/bazel/rules/rust:defs.bzl", "rustc_binary")
load("//tools/fidl/fidlc/testdata:info.bzl", "fidl_testdata_info")

package(default_applicable_licenses = ["//:license"])

common_sources = [
    "src/fidljson.rs",
    "src/main.rs",
    "src/templates/markdown/mod.rs",
    "src/templates/mod.rs",
]

common_compile_data = [
    "src/templates/markdown/partials/header.hbs",
    "src/templates/markdown/partials/types/filename.hbs",
    "src/templates/markdown/library.hbs",
    "src/templates/markdown/partials/header_dir.hbs",
    "src/templates/markdown/partials/declarations/tables.hbs",
    "src/templates/markdown/partials/declarations/enums.hbs",
    "src/templates/markdown/partials/declarations/constants.hbs",
    "src/templates/markdown/partials/declarations/aliases.hbs",
    "src/templates/markdown/partials/declarations/protocols.hbs",
    "src/templates/markdown/partials/types/doc.hbs",
    "src/templates/markdown/partials/declarations/bits.hbs",
    "src/templates/markdown/partials/declarations/unions.hbs",
    "src/templates/markdown/partials/declarations/services.hbs",
    "src/templates/markdown/main.hbs",
    "src/templates/markdown/toc.hbs",
    "src/templates/markdown/partials/types/type.hbs",
    "src/templates/markdown/partials/declarations/structs.hbs",
    "src/templates/markdown/style.css",
]

common_deps = [
    "//third_party/rust_crates/vendor:anyhow",
    "//third_party/rust_crates/vendor:argh",
    "//third_party/rust_crates/vendor:handlebars",
    "//third_party/rust_crates/vendor:heck",
    "//third_party/rust_crates/vendor:log",
    "//third_party/rust_crates/vendor:pulldown-cmark",
    "//third_party/rust_crates/vendor:rayon",
    "//third_party/rust_crates/vendor:regex",
    "//third_party/rust_crates/vendor:serde",
    "//third_party/rust_crates/vendor:serde_json",
    "//third_party/rust_crates/vendor:simplelog",
]

rustc_binary(
    name = "fidldoc",
    srcs = common_sources,
    compile_data = common_compile_data + [
        "src/templates/markdown/testdata/README.md",
        "src/templates/markdown/testdata/_toc.yaml",
    ],
    crate_name = "fidldoc",
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    deps = common_deps,
)

host_rustc_test(
    name = "fidldoc_bin_test",
    srcs = common_sources,
    compile_data = common_compile_data + [
        "src/templates/markdown/testdata/README.md",
        "src/templates/markdown/testdata/_toc.yaml",
        "src/fidldoc.config.json",
    ],
    crate_root = "src/main.rs",
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//tools:__pkg__"],
    deps = common_deps + [
        "//third_party/rust_crates/vendor:tempfile",
    ],
)

# LINT.IfChange(goldens)
_FIDL_TESTDATA_INFO_FILTERED = [
    info
    for info in fidl_testdata_info
    if "fidldoc" not in info["denylist"]
]

compiled_action(
    name = "generate_goldens",
    testonly = True,
    srcs = [
        "src/fidldoc.config.json",
    ] + [
        info["target"]
        for info in _FIDL_TESTDATA_INFO_FILTERED
    ],
    # do not sort
    outs = [
        "goldens/_toc.yaml",
        "goldens/README.md",
        "goldens/style.css",
    ] + [
        "goldens/%s/README.md" % info["library"]
        for info in _FIDL_TESTDATA_INFO_FILTERED
    ],
    args = [
        "--silent",
        "--config",
        "$(location src/fidldoc.config.json)",
        "--out",
        "$(RULEDIR)/goldens",
    ] + [
        "$(location %s)" % info["target"]
        for info in _FIDL_TESTDATA_INFO_FILTERED
    ],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tool = ":fidldoc",
)

verify_golden_files(
    name = "fidldoc_golden_tests",
    testonly = True,
    candidate_files = [":generate_goldens"],
    golden_files = [
        "goldens/_toc.yaml.golden",
        "goldens/README.md.golden",
        "goldens/style.css.golden",
    ] + [
        "goldens/%s.md.golden" % info["name"]
        for info in _FIDL_TESTDATA_INFO_FILTERED
    ],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//build/bazel/rules/tests:__pkg__",
        "//tools/fidl:__subpackages__",
    ],
)
# LINT.ThenChange(BUILD.gn:goldens)
