load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/host:defs.bzl", "go_binary_host_tool")
load("//tools/fidl/fidlc/testdata:info.bzl", "fidl_testdata_info")
load(":golden_tests.bzl", "fidlgen_rust_golden_tests")

package(default_applicable_licenses = ["//:license"])

go_binary_host_tool(
    name = "fidlgen_rust",
    srcs = ["main.go"],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//build/bazel/rules:__subpackages__",
    ],
    deps = [
        "//tools/fidl/fidlgen_rust/codegen",
        "//tools/fidl/lib/fidlgen",
    ],
)

fidlgen_rust_golden_tests(
    name = "fidlgen_rust_golden_tests",
    visibility = [
        "//build/bazel/rules/tests:__pkg__",
        "//tools/fidl:__subpackages__",
    ],
)

# LINT.IfChange(goldens)
filegroup(
    name = "goldens",
    testonly = True,
    srcs = select({
        "@platforms//os:fuchsia": [
            target
            for info in fidl_testdata_info
            if "fidlgen_rust" not in info["device_build_denylist"]
            for target in [
                "%s_rust" % info["target"],
                "%s_rust_common" % info["target"],
            ]
        ],
        "//conditions:default": [
            target
            for info in fidl_testdata_info
            if "fidlgen_rust" not in info["host_build_denylist"]
            for target in [
                "%s_rust" % info["target"],
                "%s_rust_common" % info["target"],
            ]
        ],
    }),
    visibility = [
        "//build/bazel/rules/tests:__pkg__",
        "//tools/fidl:__subpackages__",
    ],
)
# LINT.ThenChange(BUILD.gn:goldens)
