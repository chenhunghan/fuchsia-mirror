import("//build/bazel/bazel_test_suite.gni")
import("//build/components.gni")

bazel_test_suite("bazel_tests") {
  target_tests = [ "//tools/fidl/measure-tape/hlcpp-tests:hlcpp-tests-package" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":integration-tests",
    "rust-tests",
  ]
}

fuchsia_unittest_component("hlcpp-tests-comp") {
  deps = [ "hlcpp-tests" ]
}

fuchsia_test_package("integration-tests") {
  test_components = [ ":hlcpp-tests-comp" ]
}
