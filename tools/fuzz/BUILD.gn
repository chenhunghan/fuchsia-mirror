import("//build/bazel/bazel_host_tool.gni")

if (is_host) {
  bazel_host_tool("undercoat") {
    bazel_target = ":undercoat"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/undercoat_/undercoat"
    install_host_tool = true
  }
}

# A forwarding target to the Bazel-built undercoat host tool and its runtime
# host tool dependencies for infra/builders that request "//tools/fuzz".
group("fuzz") {
  deps = [
    ":undercoat($host_toolchain)",
    "//src/developer/ffx:host($host_toolchain)",
    "//src/developer/ffx/plugins/fuzz($host_toolchain)",
    "//src/storage/bin/fvm($host_toolchain)",
    "//tools/symbolizer($host_toolchain)",
    "//zircon/tools/zbi($host_toolchain)",
  ]
}
