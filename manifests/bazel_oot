<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!--
  A separate manifest for a pinned Bazel prebuilt for testing out-of-tree Bazel SDK compatibility.

  This is separated from manifest/prebuilts because it is routinely updated by automated
  rollers which update the Bazel version there, while it is desirable to keep the version
  in this file manually updated, as it should match the minimum version used by out-of-tree
  petals. It should only be updated when all petals have upgraded to a newer version.

  See https://fxbug.dev/555654162 for details.
  -->
  <packages>
    <package name="fuchsia/third_party/3pp/bazel/${platform}"
             version="version:2@8.5.1.8"
             platforms="linux-amd64,linux-arm64"
             path="prebuilt/third_party/bazel_oot/{{.OS}}-{{.Arch}}"/>
  </packages>
</manifest>
