# Gerrit CL Review Agent configuration exposing Fuchsia in-tree skills via the
# Code Review Agent Configuration Service (CRACS).
#
# Skills referenced without a "/" resolve under //.agents/skills/<name>/SKILL.md.
# Skills containing a "/" resolve relative to the fuchsia repository root.
#
# Entries invoked automatically by the Gerrit CL Review Agent must carry the
# "code-review-agent" tag. On-demand Gerrit Checks entries set automatic: false
# and omit "code-review-agent" so they run only when manually triggered.

# Default multi-perspective review agent for fuchsia CLs. Mirrors the
# "turquoise-code-review-agent" entry in vendor/google; ids
# must be unique across all repositories on a host (turquoise-internal serves
# both fuchsia and vendor/google).
configs: {
  id: "fuchsia-code-review-agent"
  display_name: "Code Review Agent"
  description: "Default multi-perspective review agent for fuchsia."
  tags: "code-review-agent"
  # Use the baseline gerrit_reviewer subagent bundled with CRACS. Because this
  # entry lists no skills, CRACS also attaches the default review skill; the
  # subsystem skill entries below still apply to matching files.
  use_default_subagents: true
  include_filters: {
    project: "fuchsia"
    path_regex: ".*"
  }
}

configs: {
  id: "fuchsia-rust-best-practices"
  display_name: "Fuchsia Rust Best Practices"
  description: "Fuchsia Rust coding conventions, edition 2024 rules, and official Rust rubric."
  tags: "code-review-agent"
  skills: "rust_best_practices"
  include_filters: {
    project: "fuchsia"
    project: "vendor/google"
    path_regex: ".*\\.rs"
  }
}

