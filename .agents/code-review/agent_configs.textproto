    path_regex: "(.*/)?(\\.agents|_agents)/(skills|workflows|plugins|agents|rules)\\.json"
  }
}

configs: {
  id: "fuchsia-bazel-guidelines"
  display_name: "Fuchsia Bazel Guidelines"
  description: "Fuchsia platform BUILD.bazel, target visibility, wrapper rules, host constraints, and test_suite() conventions."
  tags: "code-review-agent"
  skills: "build/bazel/.agents/skills/fuchsia-bazel-guidelines"
  include_filters: {
    project: "fuchsia"
    # TODO(https://fxbug.dev/585597432): Cover "vendor/google" after tuning for
    # Fuchsia Bazel SDK-using files.
    path_regex: ".*\\.(bazel|bzl)"
  }
  exclude_filters: {
    # TODO(https://fxbug.dev/585597432): Remove this exception after tuning.
    path_regex: "build/bazel_sdk/.*"
    # Vendored upstream repositories and sources.
    path_regex: "third_party/bazel_vendor/.*"
    path_regex: "third_party/bazel_registries/.*"
    path_regex: "third_party/(rust_crates|golibs)/vendor/.*"
    path_regex: "third_party/.*/src/.*"
    # In-tree generated files that do not yet conform to the style guide.
    # TODO(https://fxbug.dev/587131950): Clean up generated files and remove these exclusions.
    path_regex: "third_party/rust_crates/(ask2patch|empty|forks|intree)/.*"
    path_regex: "third_party/boringssl/BUILD\\.generated.*\\.bzl"
  }
}

