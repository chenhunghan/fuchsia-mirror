import("//build/bazel/bazel_host_tool.gni")
import("//build/bazel/bazel_test_suite.gni")

if (is_host) {
  bazel_host_tool("bin") {
    bazel_target = ":zpo_with_trace_processor"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/zpo"
    companion_files = [ "zpo_trace_processor_shell" ]
    output_name = "zpo"
    install_host_tool = true
  }
}

# The `zpo` host tool.
group("zpo") {
  deps = [ ":bin($host_toolchain)" ]
}

bazel_test_suite("host_tests") {
  host_tests = [ "//zircon/skills/zpo:host_tests" ]
}

group("tests") {
  testonly = true
  deps = [ ":host_tests" ]
}
