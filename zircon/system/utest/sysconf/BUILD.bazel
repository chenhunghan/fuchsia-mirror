load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":sysconf-test-pkg"],
    visibility = ["//zircon/system/utest:__pkg__"],
)

fx_cc_test_binary(
    name = "sysconf",
    srcs = ["sysconf.cc"],
    deps = [
        "//sdk/lib/fdio",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_package(
    name = "sysconf-test-pkg",
    package_name = "sysconf-test",
    unit_tests = [":sysconf"],
)
