load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":trace-static-engine-test-pkg"],
    visibility = ["//zircon/system/utest:__pkg__"],
)

# Common pieces.
fx_cc_library(
    name = "common",
    testonly = True,
    srcs = [
        "engine_tests.cc",
        "event_tests.c",
        "event_tests.cc",
        "event_tests_common.h",
        "event_tests_ntrace.c",
        "event_tests_ntrace.cc",
        "fields_tests.cc",
        "no_optimization.c",
        "record_tests.cc",
    ],
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = ["//visibility:private"],
    deps = [
        "//sdk/lib/async",
        "//sdk/lib/async:async-cpp",
        "//sdk/lib/async-default",
        "//sdk/lib/async-loop",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        # fdio is here so that things like printf work.
        # Otherwise they silently fail (output is dropped).
        "//sdk/lib/fdio",
        "//zircon/system/ulib/fbl",
        "//zircon/system/ulib/trace",
        # The engine is chosen by the binary, we just need engine headers here.
        "//zircon/system/ulib/trace-engine:trace-engine-headers-for-reader",
        "//zircon/system/ulib/trace-reader",
        "//zircon/system/ulib/trace-test-utils",
        "//zircon/system/ulib/zx",
        "//zircon/system/ulib/zxtest",
    ],
    alwayslink = True,
)

# Version of test that uses libtrace-engine.so.
# GN places this legacy Zircon binary under $root_out_dir/zircon-migrated, and
# bootfs_test() expects it at test/trace via distribution_entries metadata,
# which cc_test_executable() omits.
# @bazel2gn:raw_attribute:output_dir = "$root_out_dir/zircon-migrated"
# @bazel2gn:raw_attribute:metadata = { distribution_entries = [ { source = rebase_path("$root_out_dir/zircon-migrated/trace", root_build_dir) destination = "test/trace" label = get_label_info(":trace", "label_with_toolchain") } ] }
fx_cc_test_binary(
    name = "trace",
    data = [":trace-static-engine"],
    disable_build_flags = ["//build/config/fuchsia:fdio_config"],
    deps = [
        ":common",
        "//zircon/system/ulib/trace-engine",
    ],
)

# And again using libtrace-engine.a.
fx_cc_test_binary(
    name = "trace-static-engine",
    disable_build_flags = ["//build/config/fuchsia:fdio_config"],
    deps = [
        ":common",
        "//zircon/system/ulib/trace-engine",
    ],
)

fx_unittest_package(
    name = "trace-static-engine-test-pkg",
    package_name = "trace-static-engine",
    unit_tests = [":trace-static-engine"],
)
