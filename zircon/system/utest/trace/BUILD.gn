    ]
  }
}

cc_test_executable("trace") {
  data_deps = [ ":trace-static-engine" ]
  configs -= [ "//build/config/fuchsia:fdio_config" ]
  deps = [
    ":common",
    "//zircon/system/ulib/trace-engine",
  ]
  testonly = true
  emit_tool_path = false
  output_dir = "$root_out_dir/zircon-migrated"
  metadata = {
    distribution_entries = [
      {
        source =
            rebase_path("$root_out_dir/zircon-migrated/trace", root_build_dir)
        destination = "test/trace"
        label = get_label_info(":trace", "label_with_toolchain")
      },
    ]
  }
}

cc_test_executable("trace-static-engine") {
  configs -= [ "//build/config/fuchsia:fdio_config" ]
  deps = [
    ":common",
    "//zircon/system/ulib/trace-engine",
  ]
  testonly = true
  emit_tool_path = false
}

fuchsia_unittest_package("trace-static-engine-test-pkg") {
  package_name = "trace-static-engine-gn"
