load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")

package(default_applicable_licenses = ["//:license"])

# GN's bootfs_test() expects the binary at test/utc-procargs via distribution_entries metadata, which cc_test_executable() omits.
# @bazel2gn:raw_attribute:metadata = { distribution_entries = [ { source = rebase_path("$root_out_dir/utc-procargs", root_build_dir) destination = "test/utc-procargs" label = get_label_info(":utc-procargs", "label_with_toolchain") } ] }
fx_cc_test_binary(
    name = "utc-procargs",
    srcs = ["transfer-tests.cc"],
    disable_build_flags = ["//build/config/fuchsia:fdio_config"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//sdk/lib/fdio",
        "//zircon/system/ulib/fbl",
        "//zircon/system/ulib/zx",
        "//zircon/system/ulib/zxtest",
    ],
)
