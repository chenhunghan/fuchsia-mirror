load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":inspector-test-pkg"],
    visibility = ["//zircon/system/utest:__pkg__"],
)

fx_cc_test_binary(
    name = "inspector",
    srcs = ["print_debug_info.cc"],
    build_flags = ["//build/config:all_source"],
    gn_output_name = "inspector-test",
    deps = [
        "//sdk/lib/fdio",
        "//src/lib/debug:backtrace-request",
        "//zircon/system/ulib/inspector",
        "//zircon/system/ulib/zx",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_package(
    name = "inspector-test-pkg",
    package_name = "inspector-test",
    unit_tests = [":inspector"],
)
