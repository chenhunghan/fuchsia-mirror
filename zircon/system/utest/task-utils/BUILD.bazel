load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")

package(default_applicable_licenses = ["//:license"])

# GN's bootfs_test() expects the binary at test/task-utils-test via distribution_entries metadata, which cc_test_executable() omits.
# @bazel2gn:raw_attribute:metadata = { distribution_entries = [ { source = rebase_path("$root_out_dir/task-utils-test", root_build_dir) destination = "test/task-utils-test" label = get_label_info(":task-utils", "label_with_toolchain") } ] }
fx_cc_test_binary(
    name = "task-utils",
    srcs = ["walker.cc"],
    gn_output_name = "task-utils-test",
    deps = [
        "//sdk/lib/fdio",
        "//zircon/system/ulib/task-utils",
        "//zircon/system/ulib/zxtest",
    ],
)
