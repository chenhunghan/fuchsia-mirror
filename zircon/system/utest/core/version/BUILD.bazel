    name = "version",
    testonly = True,
    srcs = ["version-test.cc"],
    implementation_deps = ["//zircon/system/ulib/zxtest"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = ["//zircon/system/utest/core:__pkg__"],
    alwayslink = True,
