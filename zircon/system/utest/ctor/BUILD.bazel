load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//build/bazel/rules/cc:fx_cc_shared_library.bzl", "fx_cc_shared_library")
load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":ctor-test-pkg"],
    visibility = ["//zircon/system/utest:__pkg__"],
)

# cc_shared_library() does not compile sources or propagate CcInfo headers, so
# dso-ctor is split into a companion fx_cc_library() for compilation/headers
# and an fx_cc_shared_library() linked via dynamic_deps on :ctor.
fx_cc_library(
    name = "dso-ctor_lib",
    testonly = True,
    srcs = ["dso-ctor/dso-ctor.cc"],
    hdrs = ["dso-ctor/dso-ctor.h"],
    alwayslink = True,
)

fx_cc_shared_library(
    name = "dso-ctor",
    testonly = True,
    deps = [":dso-ctor_lib"],
)

fx_cc_test_binary(
    name = "ctor",
    srcs = ["ctor.cc"],
    dynamic_deps = [":dso-ctor"],
    deps = [
        ":dso-ctor_lib",
        "//sdk/lib/fdio",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_package(
    name = "ctor-test-pkg",
    package_name = "ctor-test",
    unit_tests = [":ctor"],
)
