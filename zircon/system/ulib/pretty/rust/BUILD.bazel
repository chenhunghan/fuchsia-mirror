load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":pretty-rust-tests"],
    visibility = ["//zircon/system/ulib:__pkg__"],
)

rustc_library(
    name = "pretty",
    srcs = [
        "src/hexdump.rs",
        "src/lib.rs",
        "src/sizes.rs",
    ],
    edition = "2024",
    visibility = ["//:__subpackages__"],
    deps = ["//src/lib/kprint"],
)

rustc_test(
    name = "pretty_test",
    crate = ":pretty",
)

fx_unittest_package(
    name = "pretty-rust-tests",
    unit_tests = [":pretty_test"],
)
