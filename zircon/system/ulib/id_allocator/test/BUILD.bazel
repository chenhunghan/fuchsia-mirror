load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":id-allocator-test-pkg"],
    visibility = ["//zircon/system/ulib:__pkg__"],
)

fx_cc_test_binary(
    name = "id_allocator-test",
    srcs = ["id_allocator.cc"],
    deps = [
        "//sdk/lib/fdio",
        "//zircon/system/ulib/fbl",
        "//zircon/system/ulib/id_allocator",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_package(
    name = "id-allocator-test-pkg",
    package_name = "id_allocator-test",
    unit_tests = [":id_allocator-test"],
)
