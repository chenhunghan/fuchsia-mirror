load("//build/bazel/rules/idk:idk_cc_source_library.bzl", "idk_cc_source_library_zx")

package(default_applicable_licenses = ["//:license"])

# fzl is in the IDK only so in-tree targets built with the Bazel SDK rules
# (e.g. drivers) can use it at HEAD.
# TODO(https://fxbug.dev/444521390): Stabilize or remove from the IDK.
idk_cc_source_library_zx(
    name = "fzl",
    srcs = [
        "memory-probe.cc",
        "owned-vmo-mapper.cc",
        "pinned-vmo.cc",
        "resizeable-vmo-mapper.cc",
        "time.cc",
        "vmar-manager.cc",
        "vmo-mapper.cc",
        "vmo-pool.cc",
    ],
    hdrs = [
        "include/lib/fzl/fifo.h",
        "include/lib/fzl/memory-probe.h",
        "include/lib/fzl/owned-vmo-mapper.h",
        "include/lib/fzl/pinned-vmo.h",
        "include/lib/fzl/resizeable-vmo-mapper.h",
        "include/lib/fzl/time.h",
        "include/lib/fzl/vmar-manager.h",
        "include/lib/fzl/vmo-mapper.h",
        "include/lib/fzl/vmo-pool.h",
    ],
    api_area = "Kernel",
    category = "partner",
    idk_name = "fzl",
    stable = False,
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = ["//:__subpackages__"],
    deps = [
        # Many public headers here use various fbl headers.
        "//zircon/system/ulib/fbl",
        # Many public headers here use various zx headers.
        "//zircon/system/ulib/zx",
    ],
)
