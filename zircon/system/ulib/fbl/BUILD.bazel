load("//build/bazel/rules/idk:idk_cc_source_library.bzl", "idk_cc_source_library_zx")

package(default_applicable_licenses = ["//:license"])

# Kept in sync with BUILD.gn via LINT.IfChange instead of bazel2gn because
# BUILD.gn has kernel-only conditions.
# TODO(https://fxbug.dev/456186319): Use bazel2gn once kernel builds are supported.
# LINT.IfChange
# fbl is in the IDK only so in-tree targets built with the Bazel SDK rules
# (e.g. drivers) can use it at HEAD. It must never be stabilized or used
# outside the Fuchsia tree, hence the `idk_name`.
# TODO(https://fxbug.dev/444521390): Remove fbl from the IDK.
