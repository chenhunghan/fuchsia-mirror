import("//build/testing/host_test.gni")

if (is_host) {
  # TODO(https://fxbug.dev/570694755): bazel2gn does not translate `host_test()`
  # yet, and the generated `cc_test_executable()` targets do not register host
  # tests by themselves.
  host_test("fbl_host_test") {
    binary_path = "$root_out_dir/fbl-test"
    target = get_label_info(":fbl", "label_with_toolchain")
    deps = [ ":fbl" ]
  }

  host_test("fbl-gmock-test_host_test") {
    binary_path = "$root_out_dir/fbl-gmock-test"
    target = get_label_info(":fbl-gmock-test", "label_with_toolchain")
    deps = [ ":fbl-gmock-test" ]
  }
}

group("tests") {
  testonly = true
  deps = [
    ":fbl-gmock-test_host_test($host_toolchain)",
    ":fbl-test-pkg",
    ":fbl_host_test($host_toolchain)",
  ]
}

