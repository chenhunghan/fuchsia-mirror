load("//build/bazel/rules:zx_library.bzl", "cc_source_library_zx")

package(default_applicable_licenses = ["//:license"])

cc_source_library_zx(
    name = "ram-crashlog",
    srcs = ["ram-crashlog.cc"],
    hdrs = ["include/ram-crashlog/ram-crashlog.h"],
    implementation_deps = [
        "//zircon/third_party/ulib/cksum",
    ],
    # zx_library() in GN adds "include" automatically and rejects `includes` in kernel toolchains.
    includes = ["include"],  # @bazel2gn:skip
    visibility = ["//:__subpackages__"],  # @bazel2gn:skip
)
