load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")

package(default_applicable_licenses = ["//:license"])

# Bazel device tests for libraries under //zircon/system/ulib, exported to GN
# by `bazel_test_suite("bazel_tests")` in BUILD.gn.
test_suite(
    name = "target_tests",
    target_compatible_with = ["@platforms//os:fuchsia"],
    tests = [
        "//zircon/system/ulib/affine/rust:tests",
        "//zircon/system/ulib/affine/test:tests",
        "//zircon/system/ulib/bitmap/test:tests",
        "//zircon/system/ulib/concurrent/tests",
        "//zircon/system/ulib/debugdata/test:tests",
        "//zircon/system/ulib/fbl/test:tests",
        "//zircon/system/ulib/ffl/test:ffl-test-pkg",
        "//zircon/system/ulib/fzl/tests",
        "//zircon/system/ulib/id_allocator/test:tests",
        "//zircon/system/ulib/image-format/test:tests",
        "//zircon/system/ulib/inspect/tests",
        "//zircon/system/ulib/mmio-ptr/test:tests",
        "//zircon/system/ulib/mock-function/test:mock-function-test-pkg",
        "//zircon/system/ulib/perftest/test:tests",
        "//zircon/system/ulib/pretty/rust:tests",
        "//zircon/system/ulib/pretty/test:tests",
        "//zircon/system/ulib/ram-crashlog/tests",
        "//zircon/system/ulib/refcount/test:tests",
        "//zircon/system/ulib/runtests-utils/test:tests",
        "//zircon/system/ulib/sysmem-version/test:sysmem-version-test-pkg",
        "//zircon/system/ulib/test-exceptions/test:tests",
        "//zircon/system/ulib/trace-engine/test:tests",
        "//zircon/system/ulib/trace-provider/test:tests",
        "//zircon/system/ulib/trace-test-utils:tests",
        "//zircon/system/ulib/zircon-internal/rust:tests",
        "//zircon/system/ulib/zx/test:tests",
        "//zircon/system/ulib/zxtest/test/integration:tests",
        "//zircon/third_party/ulib/safemath/test:tests",
    ],
)

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [
        "//zircon/system/ulib/concurrent/tests:host_tests",
        "//zircon/system/ulib/fbl/test:host_tests",
        "//zircon/system/ulib/perftest/test:host_tests",
        "//zircon/system/ulib/zxtest/test:host_tests",
        "//zircon/system/ulib/zxtest/test/integration:host_tests",
    ],
)
