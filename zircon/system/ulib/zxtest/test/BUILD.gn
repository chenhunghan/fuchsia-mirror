import("//build/testing/bootfs_test.gni")
import("//build/testing/host_test.gni")

# bazel2gn does not translate `host_test()` yet, and the generated
# `cc_test_executable()` target does not register a host test by itself.
if (is_host) {
  host_test("zxtest_host_test") {
    binary_path = "$root_out_dir/zxtest-test"
    target = get_label_info(":zxtest", "label_with_toolchain")
    deps = [ ":zxtest" ]
  }
}

group("tests") {
  testonly = true
  deps = [
    ":zxtest_host_test($host_toolchain)",
    "integration:tests",
    "regression:tests",
  ]
}

# bootfs_test() cannot be expressed in Bazel yet.
bootfs_test("zxtest-bootfs-test") {
  name = "zxtest-test"
  deps = [ ":zxtest" ]
}

