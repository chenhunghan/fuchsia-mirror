import("//build/tools/bazel2gn/bazel_migration.gni")

cc_test_executable("zxtest") {
  sources = []
  sources += [
    "assertion_test.cc",
    "event-broadcaster_test.cc",
    "main.cc",
    "parameterized-value_test.cc",
    "prod_test.cc",
    "reporter_test.cc",
    "runner_test.cc",
    "test-case_test.cc",
    "test-info_test.cc",
    "test-registry.h",
    "test_test.cc",
    "values_test.cc",
  ]
  if (is_fuchsia) {
    sources += [ "death-statement_test.cc" ]
  }
  if (is_fuchsia) {
    configs -= [ "//build/config/fuchsia:fdio_config" ]
  } else {
    configs -= []
  }
  output_name = "zxtest-test"
  deps = []
  deps += [
    "//src/zircon/lib/zircon:headers",
    "//zircon/system/ulib/zxtest",
    "//zircon/system/ulib/zxtest:prod",
  ]
  if (is_fuchsia) {
    deps += [
      "//sdk/lib/fdio",
      "//sdk/lib/fit",
      "//zircon/system/ulib/zx",
    ]
  }
  testonly = true
  emit_tool_path = false
  metadata = {
    distribution_entries = [
      {
        source = rebase_path("$root_out_dir/zxtest-test", root_build_dir)
        destination = "test/zxtest-test"
        label = get_label_info(":zxtest", "label_with_toolchain")
      },
    ]
  }
}
