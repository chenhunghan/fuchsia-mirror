load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/host_tests:host_test.bzl", "host_test")
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [
        ":zxtest-integration-stream-test",
        ":zxtest-integration-test",
    ],
    visibility = ["//zircon/system/ulib:__pkg__"],
)

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    tests = [
        ":zxtest-context_host_test",
        ":zxtest-integration-streams_host_test",
        ":zxtest-integration_host_test",
    ],
    visibility = ["//zircon/system/ulib:__pkg__"],
)

# @bazel2gn:transformer=deps
_COMMON_DEPS = select({
    "@platforms//os:fuchsia": [
        "//sdk/lib/fdio",
        "//zircon/system/ulib/zx",
    ],
    "//conditions:default": [],
})

fx_cc_test_binary(
    name = "zxtest-context",
    srcs = ["context_test.cc"],
    gn_output_name = "zxtest-context-test",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//visibility:private"],
    deps = ["//zircon/system/ulib/zxtest"],
)

host_test(
    name = "zxtest-context_host_test",
    binary = ":zxtest-context",
    target_compatible_with = HOST_OS_CONSTRAINTS,
)

fx_cc_test_binary(
    name = "zxtest-integration",
    srcs = [
        "assertions_test.c",
        "assertions_test.cc",
        "helper.cc",
        "helper.h",
        "main.cc",
        "print_test.c",
        "print_test.cc",
        "printvalue_test.cc",
        "register_test.c",
        "register_test.cc",
    ],
    # TODO(https://fxbug.dev/570694755): zxtest uses VLAs; GN propagates
    # //build/config:Wno-vla-cxx-extension via zxtest's public_configs.
    # @bazel2gn:skip
    copts = ["-Wno-vla-cxx-extension"],
    gn_output_name = "zxtest-integration-test",
    visibility = ["//visibility:private"],
    deps = [
        "//zircon/system/ulib/zxtest",
    ] + _COMMON_DEPS,
)

host_test(
    name = "zxtest-integration_host_test",
    binary = ":zxtest-integration",
    target_compatible_with = HOST_OS_CONSTRAINTS,
)

fx_packaged_binary(
    name = "zxtest-integration-test_packaged_bin",
    testonly = True,
    binary = ":zxtest-integration",
    binary_name = "zxtest-integration-test",
)

fx_component_manifest(
    name = "zxtest-integration-test-manifest",
    testonly = True,
    component_name = "zxtest-integration-test",
    includes = [
        "//sdk/lib/sys/testing:elf_test_runner",
        "//sdk/lib/syslog:use.shard",
    ],
    manifest = "meta/zxtest-integration-test.cml",
)

fx_test_component(
    name = "zxtest-integration-test-component",
    compiled_manifest = ":zxtest-integration-test-manifest",
    deps = [":zxtest-integration-test_packaged_bin"],
)

# Because this is testing lower-level zx test assertions, do not run as a
# normal zxtest with the gtest runner.
fx_package(
    name = "zxtest-integration-test-pkg",
    package_name = "zxtest-integration-test",
    testonly = True,
    test_components = [":zxtest-integration-test-component"],
)

fx_test(
    name = "zxtest-integration-test",
    package = ":zxtest-integration-test-pkg",
)

fx_cc_test_binary(
    name = "zxtest-integration-streams",
    srcs = [
        "assertions_streams_test.cc",
        "helper.cc",
        "helper.h",
        "main.cc",
    ],
    # TODO(https://fxbug.dev/570694755): zxtest uses VLAs; GN propagates
    # //build/config:Wno-vla-cxx-extension via zxtest-streams's public_configs.
    # @bazel2gn:skip
    copts = ["-Wno-vla-cxx-extension"],
    gn_output_name = "zxtest-integration-streams-test",
    visibility = ["//visibility:private"],
    deps = [
        "//zircon/system/ulib/zxtest:zxtest-streams",
    ] + _COMMON_DEPS,
)

host_test(
    name = "zxtest-integration-streams_host_test",
    binary = ":zxtest-integration-streams",
    target_compatible_with = HOST_OS_CONSTRAINTS,
)

fx_packaged_binary(
    name = "zxtest-integration-stream-test_packaged_bin",
    testonly = True,
    binary = ":zxtest-integration-streams",
    binary_name = "zxtest-integration-streams-test",
)

fx_component_manifest(
    name = "zxtest-integration-stream-test-manifest",
    testonly = True,
    component_name = "zxtest-integration-stream-test",
    includes = [
        "//sdk/lib/sys/testing:elf_test_runner",
        "//sdk/lib/syslog:use.shard",
    ],
    manifest = "meta/zxtest-integration-stream-test.cml",
)

fx_test_component(
    name = "zxtest-integration-stream-test-component",
    compiled_manifest = ":zxtest-integration-stream-test-manifest",
    deps = [":zxtest-integration-stream-test_packaged_bin"],
)

# Because this is testing lower-level zx test assertions, do not run as a
# normal zxtest with the gtest runner.
fx_package(
    name = "zxtest-integration-stream-test-pkg",
    package_name = "zxtest-integration-stream-test",
    testonly = True,
    test_components = [":zxtest-integration-stream-test-component"],
)

fx_test(
    name = "zxtest-integration-stream-test",
    package = ":zxtest-integration-stream-test-pkg",
)
