import("//build/tools/bazel2gn/bazel_migration.gni")

_COMMON_DEPS = []
if (is_fuchsia) {
  _COMMON_DEPS += [
    "//sdk/lib/fdio",
    "//zircon/system/ulib/zx",
  ]
}

# To avoid "Assignment had no effect" from GN.
# It's possible this variable is only used in if conditions (e.g. is_host).
not_needed([ "_COMMON_DEPS" ])

if (is_host) {
  cc_test_executable("zxtest-context") {
    sources = [ "context_test.cc" ]
    output_name = "zxtest-context-test"
    visibility = [ ":*" ]
    deps = [ "//zircon/system/ulib/zxtest" ]
    testonly = true
    emit_tool_path = false
  }
}

cc_test_executable("zxtest-integration") {
  sources = [
    "assertions_test.c",
    "assertions_test.cc",
    "helper.cc",
    "helper.h",
    "main.cc",
    "print_test.c",
    "print_test.cc",
    "printvalue_test.cc",
    "register_test.c",
    "register_test.cc",
  ]
  output_name = "zxtest-integration-test"
  visibility = [ ":*" ]
  deps = [
           "//zircon/system/ulib/fbl",
           "//zircon/system/ulib/zxtest",
         ] + _COMMON_DEPS
  testonly = true
  emit_tool_path = false
}

cc_test_executable("zxtest-integration-streams") {
  sources = [
    "assertions_streams_test.cc",
    "helper.cc",
    "helper.h",
    "main.cc",
  ]
  output_name = "zxtest-integration-streams-test"
  visibility = [ ":*" ]
  deps = [
           "//zircon/system/ulib/fbl",
           "//zircon/system/ulib/zxtest:zxtest-streams",
         ] + _COMMON_DEPS
  testonly = true
  emit_tool_path = false
}
