import("//build/components.gni")
import("//build/testing/host_test.gni")

# The GN copies of the Bazel host tests. bazel2gn doesn't translate
# `host_test()` yet (https://fxbug.dev/574121341), and the generated
# `cc_test_executable()` targets don't register host tests by themselves.
if (is_host) {
  host_test("zxtest-context_host_test") {
    binary_path = "$root_out_dir/zxtest-context-test"
    target = get_label_info(":zxtest-context", "label_with_toolchain")
    deps = [ ":zxtest-context" ]
  }

  host_test("zxtest-integration_host_test") {
    binary_path = "$root_out_dir/zxtest-integration-test"
    target = get_label_info(":zxtest-integration", "label_with_toolchain")
    deps = [ ":zxtest-integration" ]
  }

  host_test("zxtest-integration-streams_host_test") {
    binary_path = "$root_out_dir/zxtest-integration-streams-test"
    target =
        get_label_info(":zxtest-integration-streams", "label_with_toolchain")
    deps = [ ":zxtest-integration-streams" ]
  }
}

group("tests") {
  testonly = true
  deps = [
    ":zxtest-context_host_test($host_toolchain)",
    ":zxtest-integration-stream-test-pkg",
    ":zxtest-integration-streams_host_test($host_toolchain)",
    ":zxtest-integration-test-pkg",
    ":zxtest-integration_host_test($host_toolchain)",
  ]
}

fuchsia_unittest_package("zxtest-integration-test-pkg") {
  package_name = "zxtest-integration-test"
  deps = [ ":zxtest-integration" ]

  # Because this is testing lower-level zx test assertions, do not run as a
  # normal zxtest with the gtest runner.
  deprecated_legacy_test_execution = true
}

fuchsia_unittest_package("zxtest-integration-stream-test-pkg") {
  package_name = "zxtest-integration-stream-test"
  deps = [ ":zxtest-integration-streams" ]

  # Because this is testing lower-level zx test assertions, do not run as a
  # normal zxtest with the gtest runner.
  deprecated_legacy_test_execution = true
}

