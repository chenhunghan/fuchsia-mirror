load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":mmio-ptr-unittest"],
    visibility = ["//zircon/system/ulib:__pkg__"],
)

fx_cc_test_binary(
    name = "unittest",
    srcs = [
        "mmio-ptr-c.c",
        "mmio-ptr-c.h",
        "mmio-ptr-unittest.cc",
    ],
    gn_output_name = "mmio-ptr-unittest",
    deps = [
        "//sdk/lib/fdio",
        "//zircon/system/ulib/mmio-ptr",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_package(
    name = "mmio-ptr-unittest",
    unit_tests = [":unittest"],
)
