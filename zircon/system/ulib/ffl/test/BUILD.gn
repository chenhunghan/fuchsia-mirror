import("//build/bazel/bazel_test_suite.gni")

bazel_test_suite("bazel_tests") {
  host_tests = [ "//zircon/system/ulib/ffl/test:ffl_host_test" ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    ":ffl($host_toolchain)",
    ":ffl-test-pkg",
  ]
}

