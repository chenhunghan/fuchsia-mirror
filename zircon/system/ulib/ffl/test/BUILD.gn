import("//build/tools/bazel2gn/bazel_migration.gni")

cc_test_executable("ffl") {
  sources = [
    "assignment_tests.cc",
    "exponential_average_tests.cc",
    "ffl_tests.cc",
  ]
  output_name = "ffl-test"
  deps = []
  deps += [
    "//zircon/system/ulib/ffl",
    "//zircon/system/ulib/zxtest",
  ]
  if (is_fuchsia) {
    deps += [ "//sdk/lib/fdio" ]
  }
  testonly = true
  emit_tool_path = false
}

fuchsia_unittest_package("ffl-test-pkg") {
  package_name = "ffl-test-gn"
  component_name = "ffl-test"
  deps = [ ":ffl" ]
  visibility = [
    ":*",
    "//zircon/system/ulib:*",
  ]
}
