load("//build/bazel/rules/cc:fx_cc_source_library_zx.bzl", "fx_cc_source_library_zx")

package(default_applicable_licenses = ["//:license"])

fx_cc_source_library_zx(
    name = "runtests-utils",
    testonly = True,
    srcs = [
        "discover-and-run-tests.cc",
        "fuchsia-run-test.cc",
        "log-exporter.cc",
        "runtests-utils.cc",
        "service-proxy-dir.cc",
    ],
    hdrs = [
        "include/runtests-utils/fuchsia-run-test.h",
        "include/runtests-utils/log-exporter.h",
        "include/runtests-utils/runtests-utils.h",
        "include/runtests-utils/service-proxy-dir.h",
    ],
    # TODO(https://fxbug.dev/42085293): delete the below and fix compiler warnings
    copts = ["-Wno-vla-cxx-extension"],
    implementation_deps = [
        "//sdk/lib/async",
        "//sdk/lib/async-default",
        "//sdk/lib/async-loop",
        "//sdk/lib/component/incoming/cpp",
        "//sdk/lib/fdio",
        "//sdk/lib/fidl",
        "//zircon/system/ulib/fzl",
        "//zircon/system/ulib/zx",
    ],
    includes = ["include"],
    visibility = [
        "//src/testing/runtests:__pkg__",
        "//zircon/system/ulib/runtests-utils/test:__pkg__",
        "//zircon/system/utest/runtests-utils:__pkg__",
    ],
    deps = [
        # <runtests-utils/service-proxy-dir.h> uses fuchsia.io wire types.
        "//sdk/fidl/fuchsia.io:fuchsia.io_cpp",
        # <runtests-utils/log-exporter.h> has #include <fidl/fuchsia.logger/cpp/wire.h>.
        "//sdk/fidl/fuchsia.logger:fuchsia.logger_cpp",
        # <runtests-utils/log-exporter.h> has #include <lib/async/cpp/wait.h>.
        "//sdk/lib/async:async-cpp",
        # <runtests-utils/log-exporter.h> has #include <lib/async-loop/cpp/loop.h>.
        "//sdk/lib/async-loop:async-loop-cpp",
        # <runtests-utils/log-exporter.h> has #include <lib/async-loop/default.h>.
        "//sdk/lib/async-loop:async-loop-default",
        # <runtests-utils/service-proxy-dir.h> has #include "src/storage/lib/vfs/cpp/service.h".
        "//src/storage/lib/vfs/cpp",
        # <runtests-utils/runtests-utils.h> has #include <lib/debugdata/datasink.h>.
        "//zircon/system/ulib/debugdata",
        # Public headers have #include <fbl/string.h> and <fbl/vector.h>.
        "//zircon/system/ulib/fbl",
        # <runtests-utils/log-exporter.h> has #include
        # <lib/fidl/cpp/message_buffer.h>.
        # <runtests-utils/runtests-utils.h> has #include
        # <lib/zircon-internal/fnv1hash.h>.
        "//zircon/system/ulib/zircon-internal",
    ],
)
