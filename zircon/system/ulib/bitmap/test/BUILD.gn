import("//build/tools/bazel2gn/bazel_migration.gni")

cc_test_executable("bitmap") {
  sources = [
    "raw-bitmap-tests.cc",
    "rle-bitmap-tests.cc",
  ]
  if (is_fuchsia) {
    configs -= [ "//build/config/fuchsia:fdio_config" ]
  } else {
    configs -= []
  }
  output_name = "bitmap-test"
  deps = [
    "//sdk/lib/fdio",
    "//zircon/system/ulib/bitmap",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/zx",
    "//zircon/system/ulib/zxtest",
  ]
  testonly = true
  emit_tool_path = false
}

fuchsia_unittest_package("bitmap-test-pkg") {
  package_name = "bitmap-test-gn"
  component_name = "bitmap-test"
  deps = [ ":bitmap" ]
}
