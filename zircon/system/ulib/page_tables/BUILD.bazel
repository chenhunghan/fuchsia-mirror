load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//build/bazel/rules/cc:fx_cc_library_headers.bzl", "fx_cc_library_headers")

package(default_applicable_licenses = ["//:license"])

# Nothing outside of the kernel and - expediently - the VMM should have
# hard-coded assumptions around x86 paging decisions.
fx_cc_library_headers(
    name = "headers",
    hdrs = ["include/page_tables/x86/constants.h"],
    visibility = ["//:__subpackages__"],
)

fx_cc_library(
    name = "page_tables",
    visibility = ["//:__subpackages__"],
    deps = [":headers"],
    alwayslink = True,
)
