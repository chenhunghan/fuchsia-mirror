import("//build/tools/bazel2gn/bazel_migration.gni")

cc_test_executable("concurrent-test") {
  sources = [
    "chainlock.cc",
    "copy.cc",
    "seqlock.cc",
  ]
  output_name = "libconcurrent-test"
  deps = [
    "//zircon/system/ulib/concurrent",
    "//zircon/system/ulib/zxtest",
  ]
  testonly = true
  emit_tool_path = false
}

fuchsia_unittest_package("concurrent-test-pkg") {
  package_name = "concurrent-test-gn"
  component_name = "concurrent-test"
  deps = [ ":concurrent-test" ]
}
