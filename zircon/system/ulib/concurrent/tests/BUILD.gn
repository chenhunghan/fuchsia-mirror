import("//build/testing/host_test.gni")

# The GN copy of the `concurrent-test_host_test` Bazel host test. bazel2gn
# doesn't translate `host_test()` yet (https://fxbug.dev/574121341), and the
# generated `cc_test_executable("concurrent-test")` doesn't register a host test
# by itself.
if (is_host) {
  host_test("concurrent-test_host_test") {
    binary_path = "$root_out_dir/libconcurrent-test"
    target = get_label_info(":concurrent-test", "label_with_toolchain")
    deps = [ ":concurrent-test" ]
  }
}

group("tests") {
  testonly = true
  deps = [
    ":concurrent-test-pkg",
    ":concurrent-test_host_test($host_toolchain)",
  ]
}

