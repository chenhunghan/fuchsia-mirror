import("//build/tools/bazel2gn/bazel_migration.gni")

cc_test_executable("tftp-test") {
  sources = [
    "//zircon/system/ulib/tftp/internal.h",
    "tftp-file-test.cc",
    "tftp-test.cc",
  ]
  visibility = [ ":*" ]
  deps = [
    "//sdk/lib/fdio",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/tftp",
    "//zircon/system/ulib/zxtest",
  ]
  testonly = true
  emit_tool_path = false
  include_dirs = [ ".." ]
}

fuchsia_unittest_package("tftp-test-pkg") {
  package_name = "tftp-test-gn"
  component_name = "tftp-test"
  deps = [ ":tftp-test" ]
  visibility = [ ":*" ]
}
