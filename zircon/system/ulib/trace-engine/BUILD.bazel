load("//build/bazel/rules/cc:fx_cc_source_library_zx.bzl", "fx_cc_source_library_zx")
load("//build/bazel/rules/idk:idk_cc_prebuilt_library.bzl", "idk_cc_shared_library_zx")
load("//build/bazel/rules/idk:idk_cc_source_library.bzl", "idk_cc_source_library")

package(default_applicable_licenses = ["//:license"])

exports_files(
    [
        "buffer.cc",
        "buffer.h",
        "context_impl.h",
        "hash_table.h",
        "rolling_buffer.cc",
        "rolling_buffer.h",
    ],
    visibility = ["//zircon/system/ulib/trace-engine/test:__pkg__"],
)

idk_cc_shared_library_zx(
    name = "trace-engine",
    srcs = [
        "buffer.cc",
        "buffer.h",
        "context.cc",
        "context_api.cc",
        "context_impl.h",
        "engine.cc",
        "hash_table.h",
        "include/lib/trace-engine/buffer_internal.h",
        "nonce.cc",
        "rolling_buffer.cc",
        "rolling_buffer.h",
    ],
    hdrs = [
        "include/lib/trace-engine/context.h",
        "include/lib/trace-engine/fields.h",
        "include/lib/trace-engine/handler.h",
        "include/lib/trace-engine/instrumentation.h",
        "include/lib/trace-engine/types.h",
    ],
    api_area = "Diagnostics",
    api_file_path = "//sdk/lib/trace-engine:trace-engine.api",
    category = "partner",
    idk_name = "trace-engine",
    implementation_deps = [
        "//sdk/lib/async:async-cpp",
        "//zircon/system/ulib/zx",
    ],
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = [
        "//build/cpp:__pkg__",
        "//src/connectivity:__subpackages__",
        "//src/devices:__subpackages__",
        "//src/graphics:__subpackages__",
        "//src/lib/ddk:__pkg__",
        "//src/lib/trace/rust:__pkg__",
        "//src/performance:__subpackages__",
        "//src/storage:__subpackages__",
        "//src/zircon:__subpackages__",
        "//zircon/system:__subpackages__",
    ],
    deps = [
        ":trace-engine-headersonly",

        # <trace-engine/handler.h> has #include <lib/async/dispatcher.h>.
        "//sdk/lib/async",
    ],
)

# Header-only source package for use by trace-provider:handler,
# which is engine-agnostic.
idk_cc_source_library(
    name = "trace-engine-headersonly",
    srcs = ["include/lib/trace-engine/buffer_internal.h"],
    hdrs = [
        "include/lib/trace-engine/context.h",
        "include/lib/trace-engine/fields.h",
        "include/lib/trace-engine/handler.h",
        "include/lib/trace-engine/instrumentation.h",
        "include/lib/trace-engine/types.h",
    ],
    api_area = "Diagnostics",
    category = "partner",
    idk_name = "trace-engine-headersonly",
    stable = True,
    visibility = [
        "//zircon/system/ulib/trace:__pkg__",
        "//zircon/system/ulib/trace-provider:__pkg__",
        "//zircon/system/ulib/trace-reader:__pkg__",
        "//zircon/system/ulib/trace-vthread:__pkg__",
    ],
    deps = [
        # <trace-engine/handler.h> has #include <lib/async/dispatcher.h>.
        "//sdk/lib/async",
    ],
)

# Header-only source package for use by exported trace-reader package.
# This code also runs on the host.
# //zircon/system/ulib/trace-engine is not yet bazel2gn-synced; keep synced
# manually with BUILD.gn until the package is migrated.
# @bazel2gn:skip
fx_cc_source_library_zx(
    name = "trace-engine-headers-for-reader",
    hdrs = [
        "include/lib/trace-engine/buffer_internal.h",
        "include/lib/trace-engine/context.h",
        "include/lib/trace-engine/fields.h",
        "include/lib/trace-engine/types.h",
    ],
    includes = ["include"],
    visibility = ["//:__subpackages__"],
)
