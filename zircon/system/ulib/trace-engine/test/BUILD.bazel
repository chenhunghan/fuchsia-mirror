load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [
        ":buffer-test-pkg",
        ":hash-table-test-pkg",
        ":trace-engine-test-pkg",
    ],
    visibility = ["//zircon/system/ulib:__pkg__"],
)

fx_cc_test_binary(
    name = "hash-table-test",
    srcs = [
        "hash_table_test.cc",
        "//zircon/system/ulib/trace-engine:hash_table.h",
    ],
    disable_build_flags = select({
        "@platforms//os:fuchsia": ["//build/config/fuchsia:fdio_config"],
        "//conditions:default": [],
    }),
    gn_output_name = "trace-engine-hash-table-test",
    visibility = ["//visibility:private"],
    deps = [
        "//sdk/lib/fdio",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_cc_test_binary(
    name = "buffer_test",
    srcs = [
        "buffer_test.cc",
        "rolling_buffer_test.cc",
        "//zircon/system/ulib/trace-engine:buffer.cc",
        "//zircon/system/ulib/trace-engine:buffer.h",
        "//zircon/system/ulib/trace-engine:rolling_buffer.cc",
        "//zircon/system/ulib/trace-engine:rolling_buffer.h",
    ],
    visibility = ["//visibility:private"],
    deps = [
        "//src/lib/fxl/test:gtest_main",
        "//zircon/system/ulib/trace-reader",
    ],
)

fx_cc_test_binary(
    name = "trace_engine_test",
    srcs = [
        "trace_engine_test.cc",
        "trace_engine_writing_test.cc",
        "//zircon/system/ulib/trace-engine:buffer.h",
        "//zircon/system/ulib/trace-engine:context_impl.h",
        "//zircon/system/ulib/trace-engine:rolling_buffer.h",
    ],
    visibility = ["//visibility:private"],
    deps = [
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        "//sdk/lib/fit",
        "//src/lib/fxl/test:gtest_main",
        "//zircon/system/ulib/trace-engine",
        "//zircon/system/ulib/trace-engine:trace-engine-headers-for-reader",
        "//zircon/system/ulib/trace-reader",
    ],
)

fx_unittest_package(
    name = "hash-table-test-pkg",
    package_name = "trace-engine-hash-table-test",
    unit_tests = [":hash-table-test"],
)

fx_unittest_package(
    name = "trace-engine-test-pkg",
    package_name = "trace-engine-test",
    unit_tests = [":trace_engine_test"],
)

fx_unittest_package(
    name = "buffer-test-pkg",
    package_name = "buffer-test",
    unit_tests = [":buffer_test"],
)
