load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

fx_cc_binary(
    name = "sysmem-version-test",
    testonly = True,
    srcs = ["sysmem-version-test.cc"],
    # TODO(https://fxbug.dev/42176699): This target uses mutable tables which are deprecated,
    # rather than builders.
    build_flags = ["//build/cpp:fidl-wire-deprecated-mutable-tables"],
    tags = ["manual"],
    deps = [
        "//zircon/system/ulib/sysmem-version",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_package(
    name = "sysmem-version-test-pkg",
    package_name = "sysmem-version-test",
    unit_tests = [":sysmem-version-test"],
    visibility = ["//zircon/system/ulib:__pkg__"],
)
