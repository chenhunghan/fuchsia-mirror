import("//build/tools/bazel2gn/bazel_migration.gni")

cc_test_executable("perftest") {
  sources = [
    "results-test.cc",
    "runner-test.cc",
  ]
  output_name = "perf-test"
  deps = [
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/perftest",
    "//zircon/system/ulib/zxtest",
  ]
  testonly = true
  emit_tool_path = false
}

fuchsia_unittest_package("perftest-pkg") {
  package_name = "perf-test-gn"
  component_name = "perf-test"
  deps = [ ":perftest" ]
}
