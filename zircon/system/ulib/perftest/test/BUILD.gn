import("//build/testing/host_test.gni")

if (is_host) {
  host_test("perftest_host_test") {
    binary_path = "$root_out_dir/perf-test"
    target = get_label_info(":perftest", "label_with_toolchain")
    deps = [ ":perftest" ]
  }
}

group("tests") {
  testonly = true
  deps = [
    ":perftest-pkg",
    ":perftest_host_test($host_toolchain)",
  ]
}

