import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("affine") {
  sources = [
    "src/lib.rs",
    "src/ratio.rs",
    "src/transform.rs",
    "src/utils.rs",
  ]
  edition = "2024"
  visibility = [ "//*" ]
  deps = [
    "//src/lib/zr",
    "//third_party/rust_crates:zerocopy",
  ]
}

rustc_test("affine_test") {
  sources = [
    "src/lib.rs",
    "src/ratio.rs",
    "src/transform.rs",
    "src/utils.rs",
  ]
  edition = "2024"
  deps = [
    "//src/lib/zr",
    "//third_party/rust_crates:zerocopy",
  ]
}

fuchsia_unittest_package("affine-rust-test-pkg") {
  package_name = "affine-rust-test-gn"
  component_name = "affine-rust-test"
  deps = [ ":affine_test" ]
}
