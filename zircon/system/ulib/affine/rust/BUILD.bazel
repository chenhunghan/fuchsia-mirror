load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":affine-rust-test-pkg"],
    visibility = ["//zircon/system/ulib:__pkg__"],
)

rustc_library(
    name = "affine",
    srcs = [
        "src/lib.rs",
        "src/ratio.rs",
        "src/transform.rs",
        "src/utils.rs",
    ],
    edition = "2024",
    visibility = ["//:__subpackages__"],
    deps = [
        "//src/lib/zr",
        "//third_party/rust_crates/vendor:zerocopy",
    ],
)

rustc_test(
    name = "affine_test",
    crate = ":affine",
)

fx_unittest_package(
    name = "affine-rust-test-pkg",
    package_name = "affine-rust-test",
    unit_tests = [":affine_test"],
)
