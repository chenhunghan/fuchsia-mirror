cc_test_executable("affine") {
  sources = [
    "ratio.cc",
    "transform.cc",
    "utils.cc",
  ]
  output_name = "affine-test"
  visibility = [ ":*" ]
  deps = [
    "//sdk/lib/fdio",
    "//sdk/lib/fit",
    "//zircon/system/ulib/affine",
    "//zircon/system/ulib/zxtest",
  ]
  testonly = true
  emit_tool_path = false
}

fuchsia_unittest_package("affine-test-pkg") {
  package_name = "affine-test-pkg-gn"
  component_name = "affine-test-pkg"
  deps = [ ":affine" ]
  visibility = [ ":*" ]
}
