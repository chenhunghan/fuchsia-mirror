load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":provider-test-pkg"],
    visibility = ["//zircon/system/ulib:__pkg__"],
)

fx_cc_test_binary(
    name = "provider-test",
    srcs = [
        "provider_test.cc",
        "session_test.cc",
        "//zircon/system/ulib/trace-provider:session.h",
    ],
    disable_build_flags = select({
        "@platforms//os:fuchsia": ["//build/config/fuchsia:fdio_config"],
        "//conditions:default": [],
    }),
    gn_output_name = "trace-provider-test",
    visibility = ["//visibility:private"],
    deps = [
        "//sdk/fidl/fuchsia.tracing.provider:fuchsia.tracing.provider_cpp",
        "//sdk/lib/async:async-cpp",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        "//sdk/lib/fdio",
        "//sdk/lib/fidl",
        "//sdk/lib/fidl_base",
        "//zircon/system/ulib/trace",
        "//zircon/system/ulib/trace-provider",
        "//zircon/system/ulib/zx",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_package(
    name = "provider-test-pkg",
    package_name = "trace-provider-test",
    unit_tests = [":provider-test"],
)
