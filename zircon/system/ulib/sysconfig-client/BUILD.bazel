load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//build/bazel/rules/cc:fx_cc_library_headers.bzl", "fx_cc_library_headers")

package(default_applicable_licenses = ["//:license"])

fx_cc_library_headers(
    name = "sysconfig-sync-client-headers",
    hdrs = [
        "include/lib/sysconfig/abr-wear-leveling.h",
        "include/lib/sysconfig/sync-client.h",
        "include/lib/sysconfig/sysconfig-header.h",
    ],
    visibility = ["//:__subpackages__"],
    deps = [
        "//sdk/fidl/fuchsia.hardware.skipblock:fuchsia.hardware.skipblock_cpp",
        "//sdk/fidl/fuchsia.io:fuchsia.io_cpp",
        "//zircon/system/ulib/fzl",
        "//zircon/system/ulib/zx",
    ],
)

fx_cc_library(
    name = "sysconfig-sync-client",
    srcs = [
        "shared/abr-wear-leveling.c",
        "shared/sysconfig-header.c",
        "sync-client.cc",
    ],
    implementation_deps = [
        "//sdk/fidl/fuchsia.hardware.skipblock:fuchsia.hardware.skipblock_cpp",
        "//sdk/lib/component/incoming/cpp",
        "//sdk/lib/device-watcher/cpp",
        "//sdk/lib/fdio-caller",
        "//sdk/lib/fidl",
        "//zircon/system/ulib/fbl",
        "//zircon/system/ulib/fzl",
        "//zircon/system/ulib/zx",
        "//zircon/third_party/ulib/cksum",
    ],
    visibility = ["//:__subpackages__"],
    deps = [":sysconfig-sync-client-headers"],
    alwayslink = True,
)
