cc_test_executable("trace-reader-test") {
  sources = [
    "file_reader_tests.cc",
    "reader_tests.cc",
    "reader_tests.h",
    "records_tests.cc",
  ]
  if (is_fuchsia) {
    configs -= [ "//build/config/fuchsia:fdio_config" ]
  } else {
    configs -= []
  }
  output_name = "trace-reader-test-test"
  deps = []
  deps += [
    "//sdk/lib/fit",
    "//zircon/system/ulib/trace-engine:trace-engine-headers-for-reader",
    "//zircon/system/ulib/trace-reader",
    "//zircon/system/ulib/zxtest",
  ]
  if (is_fuchsia) {
    deps += [
      "//sdk/lib/fdio",
      "//zircon/system/ulib/zx",
    ]
  }
  testonly = true
  emit_tool_path = false
  metadata = {
    distribution_entries = [
      {
        source =
            rebase_path("$root_out_dir/trace-reader-test-test", root_build_dir)
        destination = "test/trace-reader-test-test"
        label = get_label_info(":trace-reader-test", "label_with_toolchain")
      },
    ]
  }
}
