import("//build/rust/rustc_library.gni")

rustc_library("arena") {
  name = "arena"
  edition = "2024"

  sources = [ "src/lib.rs" ]

  deps = [ "//zircon/kernel/phys/lib/memalloc:memalloc-rs" ]

  with_unit_tests = true
}

group("tests") {
  testonly = true
  deps = [ ":arena_test($host_toolchain)" ]
}
