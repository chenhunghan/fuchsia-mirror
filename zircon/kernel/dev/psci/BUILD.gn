import("//build/cpp/library_headers.gni")
import("//zircon/kernel/kernel_bindgen_crate.gni")
import("//zircon/kernel/kernel_rust_mod.gni")

library_headers("headers") {
  headers = [ "dev/psci.h" ]
  public_deps = [
    "//sdk/lib/zbi-format",
    "//zircon/kernel/lib/ktl:headers",
  ]
}

kernel_bindgen_crate("psci-bindings") {
  headers = [ "include/dev/psci.h" ]
  cpp = true
  non_rust_deps = [ ":headers" ]
  notice_year = 2026
  raw_lines = [ "#![no_std]" ]
  var_allowlist = [
    "PSCI64_.*",
    "PSCI_.*",
  ]
}

kernel_rust_mod("psci-rs") {
  sources = [ "psci.rs" ]
  deps = [
    ":psci-bindings",
    "//sdk/rust/zbi",
    "//sdk/rust/zx-status",
    "//src/lib/kprint",
    "//src/lib/zr",
    "//zircon/kernel/dev/pdev/power:power-rs",
    "//zircon/kernel/lib/counters:counters-rs",
    "//zircon/kernel/lib/debug",
  ]
  test_deps = [ "//zircon/kernel/lib/unittest:unittest-rs" ]
}

source_set("psci") {
  sources = [ "psci-suspend.S" ]
  public_deps = [ ":headers" ]
  deps = [
    ":psci-rs",
    "//zircon/kernel/lib/arch",
  ]
}
