import("//build/components.gni")
import("//build/cpp/library_headers.gni")
import("//zircon/kernel/kernel_rust_crate.gni")

group("coresight") {
  public_deps = [
    ":coresight-rs",
    ":headers",
  ]
}

library_headers("headers") {
  headers = [
    "dev/coresight/component.h",
    "dev/coresight/rom_table.h",
  ]

  public_deps = [
    # <dev/coresight/component.h> has #include <hwreg/bitfields.h>.
    # <dev/coresight/component.h> has #include <hwreg/mmio.h>.
    # <dev/coresight/rom_table.h> has #include <hwreg/mmio.h>.
    "//zircon/system/ulib/hwreg:headers",

    # <dev/coresight/rom_table.h> has #include <lib/fit/result.h>.
    "//sdk/lib/fit",
  ]
}

kernel_rust_crate("coresight-rs") {
  crate_name = "coresight"
  source_root = "src/lib.rs"
  sources = [
    "src/component.rs",
    "src/lib.rs",
    "src/rom_table.rs",
  ]
  deps = [
    "//src/lib/bitrs",
    "//src/lib/regio",
    "//src/lib/zr",
    "//third_party/rust_crates:zerocopy",
  ]

  if (!is_kernel) {
    with_unit_tests = true
  }
}

if (!is_kernel) {
  fuchsia_unittest_package("coresight-rust-test-pkg") {
    package_name = "coresight-rust-test"
    deps = [ ":coresight-rs_test" ]
  }
}

group("tests") {
  testonly = true
  if (!is_kernel) {
    deps = [
      ":coresight-rs_test($host_toolchain)",
      ":coresight-rust-test-pkg",
    ]
  }
}
