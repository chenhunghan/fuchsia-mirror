import("//build/cpp/library_headers.gni")
import("//zircon/kernel/kernel_rust_mod.gni")

kernel_rust_mod("arm_smmu_rs") {
  sources = [
    "arm_smmu_ffi.rs",
    "common/constants.rs",
    "common/device_aspace.rs",
    "common/env.rs",
    "common/irq.rs",
    "common/mmio.rs",
    "common/mod.rs",
    "common/page_cache.rs",
    "common/smmu_mode.rs",
    "common/translation_table.rs",
    "common/utils.rs",
    "common/vmsav8_64.rs",
    "mod.rs",
    "unit_tests.rs",
    "v2/console.rs",
    "v2/context_bank.rs",
    "v2/mod.rs",
    "v2/registers.rs",
    "v2/smmu.rs",
    "v2/smmu_bti.rs",
    "v2/smmu_pmt.rs",
    "v2/stream_match_reg.rs",
    "v2/unit_tests.rs",
    "v2/utils.rs",
  ]
  deps = [
    "//sdk/rust/zx-status",
    "//sdk/rust/zx-types",
    "//src/lib/kalloc",
    "//src/lib/ksync",
    "//src/lib/lazy_init:lazy_init_rs",
    "//src/lib/regio",
    "//src/lib/zr",
    "//third_party/rust_crates:pin-init",
    "//zircon/kernel/lib/boot-options:boot-options-rs",
    "//zircon/kernel/lib/debug",
    "//zircon/kernel/lib/init:init_rust",
    "//zircon/system/ulib/fbl/rust:fbl",
    "//zircon/system/ulib/region-alloc/rust:region-alloc",
  ]
  test_deps = [ "//zircon/kernel/lib/unittest:unittest-rs" ]
}

source_set("arm_smmu") {
  public_deps = [ ":headers" ]
  deps = [ ":arm_smmu_rs" ]
}

library_headers("headers") {
  headers = [ "dev/arm_smmu/init.h" ]
  public_deps = [ "//sdk/lib/zbi-format" ]
}
