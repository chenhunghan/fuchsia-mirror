import("//build/cpp/library_headers.gni")
import("//zircon/kernel/kernel_rust_mod.gni")

kernel_rust_mod("iommu_rs") {
  sources = [
    "bti.rs",
    "escaped_name.rs",
    "mod.rs",
  ]
  deps = [
    "//sdk/rust/zx-types",
    "//src/lib/zr",
    "//zircon/kernel/lib/debug",
  ]
}

static_library("iommu") {
  public_deps = [ ":headers" ]

  sources = [
    "bti_ffi.cc",
    "pmt_ffi.cc",
  ]

  deps = [
    ":iommu_rs",
    "//zircon/kernel/lib/fbl",
    "//zircon/kernel/lib/libc",
    "//zircon/kernel/vm:headers",
  ]
}

library_headers("headers") {
  headers = [
    "dev/iommu/bti.h",
    "dev/iommu/common.h",
    "dev/iommu/iommu.h",
    "dev/iommu/pmt.h",
  ]
}
