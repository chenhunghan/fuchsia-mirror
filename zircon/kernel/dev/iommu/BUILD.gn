import("//zircon/kernel/kernel_rust_mod.gni")

kernel_rust_mod("iommu_rs") {
  sources = [
    "bti.rs",
    "escaped_name.rs",
    "mod.rs",
    "stub.rs",
  ]
  deps = [
    "//sdk/rust/zx-status",
    "//sdk/rust/zx-types",
    "//src/lib/kalloc",
    "//src/lib/ksync",
    "//src/lib/zr",
    "//third_party/rust_crates:pin-init",
    "//zircon/kernel/lib/debug",
    "//zircon/kernel/lib/page:page-rs",
    "//zircon/system/ulib/fbl/rust:fbl",
  ]
}

# The generic IOMMU layer (dispatch across the stub IOMMU and the hardware
# drivers) is the Rust module above. Depending on this target is how it reaches
# the kernel.
group("iommu") {
  deps = [ ":iommu_rs" ]
}
