import("//build/zircon/zircon_cpu.gni")

group("boot-shim") {
  deps = [ "//zircon/kernel/arch/$zircon_cpu/phys/boot-shim" ]
}

group("tests") {
  testonly = true

  deps = [
    ":boot-shim",
    "//zircon/kernel/arch/$zircon_cpu/phys/boot-shim:tests",
  ]
}

group("boot_tests") {
  testonly = true
  deps = [ "//zircon/kernel/arch/$zircon_cpu/phys/boot-shim:boot_tests" ]
}
