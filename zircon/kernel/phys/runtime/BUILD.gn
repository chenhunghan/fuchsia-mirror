import("//build/cpp/library_headers.gni")
import("//build/toolchain/toolchain_environment.gni")
import("//build/zircon/zircon_cpu.gni")
import("//zircon/system/ulib/hwreg/hwreg_asm_header.gni")

library_headers("headers") {
  headers = [
    "phys/runtime/$zircon_cpu/early-boot.h",
    "phys/runtime/$zircon_cpu/info.h",
    "phys/runtime/early-boot.h",
    "phys/runtime/exception.h",
    "phys/runtime/info.h",
    "phys/runtime/main.h",
    "phys/runtime/stack.h",
  ]
  if (zircon_cpu == "arm64") {
    headers += [ "phys/runtime/arm64/smccc.h" ]
  }

  public_deps = [
    # <phys/runtime/arm64/early-boot.h> has #include <lib/arch/cache.h>
    # <phys/runtime/arm64/info.h> has #include <lib/arch/arm64/smccc.h>
    # <phys/runtime/main.h> has #include <lib/arch/ticks.h>
    # <phys/runtime/riscv64/info.h> has #include <lib/arch/riscv64/feature.h>
    # <phys/runtime/stack.h> has #include <lib/arch/backtrace.h>
    "//zircon/kernel/lib/arch:headers",

    # <phys/runtime/early-boot.h> has #include <lib/zbitl/view.h>
    "//src/lib/zbitl:headers",

    # <phys/runtime/main.h> has #include <lib/memalloc/range.h>
    "//zircon/kernel/phys/lib/memalloc:range.headers",
  ]

  if (is_kernel) {
    public_deps += [
      # <phys/runtime/early-boot.h> has #include <ktl/*.h>
      # <phys/runtime/main.h> has #include <ktl/*.h>
      # <phys/runtime/stack.h> has #include <ktl/*.h>
      "//zircon/kernel/lib/ktl:headers",
    ]
  }
}

if (toolchain_environment == "kernel.phys" ||
    toolchain_environment == "kernel.efi") {
  static_library("runtime") {
    complete_static_lib = true

    public_deps = [ ":headers" ]

    sources = [ "stack.cc" ]
    deps = [
      "//zircon/kernel/lib/arch",
      "//zircon/kernel/lib/ktl",
      "//zircon/kernel/lib/libc",
      "//zircon/kernel/phys:stdio",
    ]

    # EFI programs are loaded by the firmware and have their own entry point,
    # set-up, and exception/reset handling.
    if (toolchain_environment != "kernel.efi") {
      sources += [
        "$zircon_cpu/reset.cc",
        "$zircon_cpu/start.S",
        "exception.cc",
        "self-relocation.cc",
      ]
      deps += [
        "//sdk/lib/zbi-format",
        "//src/lib/elfldltl",
        "//src/lib/zbitl",
      ]

      if (zircon_cpu == "arm64") {
        sources += [
          "arm64/exception.S",
          "arm64/psci.S",
          "arm64/psci.cc",
          "arm64/psci.h",
          "arm64/regs.h",
          "arm64/setup.cc",
        ]
        deps += [
          ":arm64-info-asm",
          "//zircon/kernel/lib/boot-options",
          "//zircon/system/ulib/zircon-internal",
        ]
      } else if (zircon_cpu == "riscv64") {
        sources += [
          "riscv64/exception.S",
          "riscv64/exception.cc",
          "riscv64/riscv64.h",
          "riscv64/setup.cc",
        ]
        deps += [ ":riscv64-info-asm" ]
      } else if (zircon_cpu == "x86") {
        sources += [ "x86/gdt.cc" ]
        deps += [ "//sdk/lib/fit" ]
      }
    }
  }
}

foreach(cpu,
        [
          "arm64",
          "riscv64",
        ]) {
  # Provides "arch-phys-info-asm.h" for assembly.
  hwreg_asm_header("$cpu-info-asm") {
    visibility = [ ":*" ]
    output_name = "arch-phys-info-asm.h"
    sources = [ "$cpu/gen-arch-phys-info-asm.cc" ]
    deps = [ ":headers" ]
  }
}
