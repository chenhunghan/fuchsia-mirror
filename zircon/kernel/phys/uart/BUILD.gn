import("//build/cpp/library_headers.gni")

library_headers("headers") {
  headers = [ "phys/uart/driver.h" ]
  public_deps = [ "//zircon/system/ulib/uart" ]
}

source_set("uart") {
  public_deps = [ ":headers" ]
  sources = [ "driver.cc" ]
  deps = [
    "//zircon/kernel/lib/ktl",
    "//zircon/kernel/lib/libc",
  ]
}
