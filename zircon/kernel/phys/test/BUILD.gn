if (qemu_linuxboot_embed != []) {
  boot_test("linuxboot-embed-test") {
    qemu_kernel = ":linuxboot-embed-hello-world-test-packed($phys_toolchain)"
    foreach(qemu, qemu_linuxboot_embed) {
      timeout = qemu.timeout
      environments = qemu.supported_environments
      forward_variables_from(qemu, [ "disabled" ])
    }
  }

  if (toolchain_environment == "kernel.phys") {
    phys_executable("linuxboot-embed-hello-world-test") {
      testonly = true
      sources = [ "linuxboot-embed-hello-world-test.cc" ]
      deps = [
        ":qemu-test-main",
        "..:linuxboot-embed",
        "//zircon/kernel/lib/ktl",
        "//zircon/kernel/lib/libc",
        "//zircon/system/ulib/pretty",
      ]
      foreach(qemu, qemu_linuxboot_embed) {
        deps += qemu.deps
      }
    }

    generated_file("linuxboot-embed-hello-world-test-data1.txt") {
      visibility = [ ":*" ]
      testonly = true
      outputs = [ "$target_gen_dir/$target_name" ]
      output_conversion = "list lines"
      contents = [ "Hello, world!" ]
    }

    generated_file("linuxboot-embed-hello-world-test-data2.txt") {
      visibility = [ ":*" ]
      testonly = true
      outputs = [ "$target_gen_dir/$target_name" ]
      output_conversion = "list lines"
      contents = [ "Lorem ipsum" ]
    }

    linuxboot_embed("linuxboot-embed-hello-world-test-packed") {
      visibility = [ ":*" ]
      testonly = true
      shim_label = ":linuxboot-embed-hello-world-test"
      deps = [
        ":linuxboot-embed-hello-world-test-data1.txt",
        ":linuxboot-embed-hello-world-test-data2.txt",
      ]
      inputs = []
      foreach(label, deps) {
        inputs += get_target_outputs(label)
      }
      emulator_support_aib = true
    }
  }
}

# turkey
zbi_executable("trampoline-boot-test") {
  testonly = true
  sources = [ "trampoline-boot-test.cc" ]
  deps = [
    ":turducken",
    "..:new",
    "../boot-zbi",
    "//src/lib/zbitl",
    "//zircon/kernel/lib/boot-options",
    "//zircon/kernel/lib/libc",
    "//zircon/system/ulib/pretty",
    "//zircon/system/ulib/zx",
  ]
  data_deps = [ ":trampoline-cmdline" ]
}

kernel_cmdline("trampoline-cmdline") {
  testonly = true
  visibility = [ ":*" ]

  # Number of times to perform chain loading after initial bootstrapping.
  # Currently in x86(with kvm) it takes ~40 secs to chain load 100 times,
  # the biggest time consumption being printing to serial.
  # On arm64, 80 iterations occasionally takes over 5 minutes (boot
  # performance appears to have regressed since March 2023)
  # so 50 leaves a little headroom for variance in performance, with a
  # 5 min timeout leaves roughly 6 sec per iteration which should have
  # enough spare time per iteration.
  args = [ "trampoline.user_total_iters=50" ]
}

mobius_turducken_test("trampoline-boot-zbi-test") {
  kernel = ":trampoline-boot-test"
  timeout = 300  # 5min
}

turducken_cuckoo_test("turducken-boot-next-zbi-test") {
  boot_zbi = ":turducken-zbi-test.zbi"
  next_zbi = ":zbi-hello-world-test.zbi"
}

group("phys-test") {
  testonly = true
  deps = [
    ":backtrace-test",
    ":hello-world-test",
    ":phys-unittests",
    ":qemu-phys-exception-test",
    ":trampoline-boot-zbi-test",
    ":turducken-boot-next-zbi-test",
    ":turducken-zbi-test",
    ":zbi-boot-zbi-load-test",
    ":zbi-chain-load-core-tests",
    ":zbi-chain-load-hello-world-test",
    ":zbi-decompress-test",
    ":zbi-memory-test",
    ":zbi-phys-exception-test",
    "../handoff-prep:tests",
    "../physboot:tests",
    "code-patching",
    "elf-loading",
    "linux-boot-config:tests",
    "//zircon/kernel/arch/$zircon_cpu/phys:tests",
  ]

  if (have_devicetree) {
    deps += [ ":devicetree-memory-test" ]
  }

  if (current_cpu == "x64") {
    # Only x86 gets memory info directly from the legacy boot environments.
    deps += [ ":qemu-memory-test" ]
  }
}

if (current_toolchain == default_toolchain) {
  test_deps = []
  if (qemu_linuxboot_embed != []) {
    test_deps += [ ":linuxboot-embed-test" ]
  }

  group("test") {
    testonly = true
    deps = [
             ":phys-test($phys_toolchain)",

             # Debug Data propagation to userspace.
             "debugdata-propagation:early-boot-debugdata-zbi-test",
           ] + test_deps
  }
}

foreach(cpu, standard_fuchsia_cpus) {
  group(cpu) {
    testonly = true
    public_deps = [ ":test(//zircon/kernel/phys:kernel.phys_$cpu)" ]
  }
}
