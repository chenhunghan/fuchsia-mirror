qemu_linuxboot_embed = []
foreach(qemu, qemu_boot_formats) {
  if (qemu.name == "linuxboot" && qemu.has_embed) {
    qemu_linuxboot_embed += [ qemu ]
  }
}

# Used for turducken_cuckoo_test(), instructing tuducken tests, when the tests
# finishes successfully it should boot the next kernel item in the boot zbi.
kernel_cmdline("turducken-boot-next") {
  testonly = true
  args = [ "turducken.boot-next=true" ]
}

config("includes") {
  visibility = [ ":*" ]
  include_dirs = [ "." ]
}

