import("//build/cpp/library_headers.gni")
import("//build/rust/rustc_bindgen.gni")
import("//build/toolchain/toolchain_environment.gni")
import("//build/zircon/zircon_cpu.gni")
import("//zircon/kernel/kernel_rust_crate.gni")

library_headers("headers") {
  headers = [
    "phys/handoff/$zircon_cpu/handoff.h",
    "phys/handoff/$zircon_cpu/heap.h",
    "phys/handoff/boot-constants.h",
    "phys/handoff/handoff.h",
    "phys/handoff/heap.h",
    "phys/handoff/ptr.h",
    "phys/handoff/zircon-abi-spec.h",
  ]

  public_deps = [
    # $zircon_cpu/handoff.h has #include <lib/zbi-format/driver-config.h>
    # boot-constants.h has #include <lib/zbi-format/reboot.h>
    "//sdk/lib/zbi-format",

    # arm64/handoff.h has #include <lib/boot-options/arm64.h>
    "//zircon/kernel/lib/boot-options:headers",

    # handoff.h has #include <lib/arch/ticks.h>.
    "//zircon/kernel/lib/arch:headers",

    # handoff.h has #include <lib/memalloc/range.h>
    "//zircon/kernel/phys/lib/memalloc:range.headers",

    # handoff.h has #include <lib/uart/all.h>.
    "//zircon/system/ulib/uart",

    # handoff.h has #include <lib/crypto/entropy_pool.h>
    "//zircon/kernel/lib/crypto:crypto-entropy-src.headers",

    # handoff.h has #include <lib/elfldltl/layout.h>.
    "//src/lib/elfldltl:headers",

    # handoff.h has #include <lib/stdbind/optional.h>.
    "//src/lib/stdbind:headers",
  ]

  if (toolchain_environment == "kernel") {
    public_deps += [
      # handoff.h has #include <object/handle.h>
      "//zircon/kernel/object:headers",

      # handoff.h has #include <fbl/ref_ptr.h>
      "//zircon/system/ulib/fbl:headers",
    ]
  }

  if (!is_kernel) {
    public_deps += [ "//zircon/system/public" ]
  }
}

source_set("handoff") {
  public_deps = [ ":headers" ]
}

rustc_bindgen("handoff-rs.bindgen") {
  visibility = [ ":*" ]
  output_name = "handoff_bindings.rs"

  notice_year = "2026"

  cpp = true
  headers = [
    "include/phys/handoff/boot-constants.h",
    "include/phys/handoff/handoff.h",
    "include/phys/handoff/zircon-abi-spec.h",
  ]
  deps = [ ":handoff" ]

  # The layout of PhysHandoff is compilation-dependent and very load-bearing,
  # so these tests represent an important regression stop against drift.
  layout_tests = true

  # It's a big struct and so explicit padding can make it difficult to inspect.
  explicit_padding = false

  # No functions needed at this time.
  function_blocklist = [ ".*" ]

  type_allowlist = [
    "BootConstants",
    "PhysHandoff",

    # ZirconAbiSpec::Stack is used by //zircon/kernel/lib/thread-stack, whose
    # tests compare its constants against the kernel's kZirconAbiSpec.
    "ZirconAbiSpec",
    "ZirconAbiSpec::Stack",
  ]
  type_blocklist = [
    "arch::EarlyTicks",  # Provided by //zircon/kernel/lib/arch:arch-rs
    "stdbind::optional(_.*)?",  # Ready-made bindings swapped in instead
  ]

  # This is a ktl::string_view that only physboot uses.
  var_blocklist = [ "ZirconAbiSpec::kDebugBootSpinVariable" ]

  opaque_types = [
    "std::.*",
    "uart::.*",
    "crypto::.*",
    "elfldltl::.*",
  ]

  # Always better.
  rustified_enum = [ ".*" ]

  auto_derive_traits = [ [
        "PhysElfImage_Info",
        [
          "Debug",
          "Copy",
          "Clone",
        ],
      ] ]

  raw_lines = [
    "use libarch::EarlyTicks as arch_EarlyTicks;",
    "use stdbind::Optional as stdbind_optional;",
  ]

  replacements = [
    # PhysVmObject::Name is zero-initialized on construction (`Name name{};`).
    [
      "pub type PhysVmObject_Name = __BindgenOpaqueArray<\\[u8; ([0-9]+)usize\\]>;",
      "pub type PhysVmObject_Name = [u8; \\1];",
    ],

    # Wrap opaque C++ blobs (such as std::optional unions and padding) in
    # MaybeUninit so forming shared references is sound even when trailing or
    # disengaged bytes are uninitialized.
    [
      "#\\[derive\\(PartialEq, Eq, Copy, Clone, Debug, Hash\\)\\]\n#\\[repr\\(([^\n]+)\\)\\]\npub struct (__BindgenOpaqueArray[0-9]*)<T>\\(pub T\\);\nimpl<T: Copy \\+ Default, const N: usize> Default for __BindgenOpaqueArray[0-9]*<\\[T; N\\]> \\{\n    fn default\\(\\) -> Self \\{\n        Self\\(\\[<T as Default>::default\\(\\); N\\]\\)\n    \\}\n\\}",
      "#[derive(Debug, Copy, Clone)]\n#[repr(\\1)]\npub struct \\2<T: ::core::marker::Copy>(::core::mem::MaybeUninit<T>);\nimpl<T: ::core::marker::Copy> Default for \\2<T> {\n    fn default() -> Self {\n        Self(::core::mem::MaybeUninit::zeroed())\n    }\n}",
    ],
    [
      "pub _bindgen_opaque_blob: \\[([^;]+); ([0-9]+usize)\\],",
      "pub _bindgen_opaque_blob: [::core::mem::MaybeUninit<\\1>; \\2],",
    ],

    # `crypto::global_prng::EarlyBootSeed` moves out of `entropy_pool` in place
    # during early boot.
    [
      "pub entropy_pool: (__BindgenOpaqueArray[0-9]*<[^>]+>),",
      "pub entropy_pool: ::core::cell::UnsafeCell<\\1>,",
    ],

    # Drop "k" prefixes since that's a C++-ism that doesn't help with
    # readability on the Rust side.
    [
      "\bk([A-Z0-9])",
      "\\1",
    ],
  ]
}

kernel_rust_crate("handoff-rs") {
  crate_name = "handoff"
  _bindgen_outputs = get_target_outputs(":handoff-rs.bindgen")
  source_root = "handoff.rs"
  sources = [ "handoff.rs" ] + _bindgen_outputs
  inputs = _bindgen_outputs
  rustenv = [ "HANDOFF_BINDINGS_RS=" +
              rebase_path(_bindgen_outputs[0], root_build_dir) ]
  deps = [
    ":handoff-rs.bindgen",
    "//src/lib/stdbind:stdbind-rs",
    "//src/lib/zr",
    "//zircon/kernel/bin/rustenv_path",
    "//zircon/kernel/lib/arch:arch-rs",
  ]
}
