import("//build/cpp/library_headers.gni")

library_headers("headers") {
  headers = [ "phys/memory/init.h" ]

  public_deps = [
    "//zircon/kernel/lib/ktl:headers",

    # <phys/memory/init.h> has #include <lib/memalloc/range.h>.
    "//zircon/kernel/phys/lib/memalloc:range.headers",

    # <phys/memory/init.h> has #include <phys/runtime/early-boot.h>.
    "//zircon/kernel/phys/runtime:headers",
  ]
}

source_set("memory") {
  public_deps = [ ":headers" ]

  sources = [ "init.cc" ]
  deps = [
    "//zircon/kernel/lib/boot-options",
    "//zircon/kernel/lib/ktl",
    "//zircon/kernel/lib/libc",
    "//zircon/kernel/phys/address-space",
    "//zircon/kernel/phys/allocation",
    "//zircon/kernel/phys/lib/memalloc",
    "//zircon/kernel/phys/runtime",
  ]
}
