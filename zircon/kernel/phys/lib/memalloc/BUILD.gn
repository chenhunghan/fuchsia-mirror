import("//build/cpp/library_headers.gni")
import("//build/rust/rustc_library.gni")
import("//zircon/kernel/kernel_bindgen_crate.gni")

if (zircon_toolchain == false) {
  _headers = ""
} else {
  _headers = ":headers"
}

library_headers("range.headers") {
  headers = [ "lib/memalloc/range.h" ]
  public_deps = [
    # <lib/memalloc/range.h> has #include <lib/zbi-format/zbi.h>.
    "//sdk/lib/zbi-format",
  ]
}

kernel_bindgen_crate("bindings") {
  visibility = [ ":*" ]
  headers = [
    "include/lib/memalloc/pool.h",
    "include/lib/memalloc/range.h",
    "pool-ffi.h",
  ]
  non_rust_deps = [
    ":headers",
    ":range.headers",
  ]
  cpp = true
  layout_tests = false
  explicit_padding = false
  use_core = true
  raw_lines = [ "#![no_std]" ]
  type_allowlist = [
    "memalloc::Pool",
    "memalloc::PoolIteratorState",
    "memalloc::Range",
    "memalloc::Type",
    "memalloc::internal::RangeIterationContext",
  ]
  opaque_types = [
    "memalloc::Pool",
    "memalloc::PoolIteratorState",
    "memalloc::internal::RangeIterationContext",
  ]
  type_blocklist = [ "memalloc::Pool_.*" ]
  var_allowlist = [
    "memalloc::Pool_kBookkeepingChunkSize",
    "memalloc::Pool_kDefaultMaxAddr",
    "memalloc::Pool_kDefaultMinAddr",
    "memalloc::kMinAllocatedTypeValue",
  ]
  additional_bindgen_flags = [
    "--ignore-methods",
    "--no-recursive-allowlist",
  ]
  rustified_enum = [ "memalloc::Type" ]
  notice_year = 2026
  expect_lints = [
    "non_camel_case_types",
    "non_upper_case_globals",
  ]
}

static_library("range") {
  complete_static_lib = true

  public_deps = [ ":range.headers" ]

  sources = [ "range.cc" ]
  deps = [ "//zircon/system/ulib/pretty" ]
  if (is_kernel) {
    deps += [ "//zircon/kernel/lib/libc" ]
  }
}

library_headers("headers") {
  headers = [
    "lib/memalloc/pool-mem-config.h",
    "lib/memalloc/pool.h",
  ]

  public_deps = [
    ":range.headers",

    # <lib/memalloc/pool.h> has #include <lib/fit/function.h>.
    "//sdk/lib/fit$_headers",

    # <lib/memalloc/pool.h> has #include <fbl/intrusive_double_list.h>.
    "//zircon/system/ulib/fbl$_headers",

    # <lib/memalloc/pool.h> has #include <lib/fit/result.h>.
    "//zircon/system/ulib/zx$_headers",
  ]
}

rustc_library("memalloc-rs") {
  name = "memalloc"
  edition = "2024"

  sources = [
    "src/lib.rs",
    "src/pool.rs",
    "src/range.rs",
    "src/testing.rs",
  ]
  deps = [
    ":bindings",
    ":memalloc",
    "//sdk/rust/zbi",
    "//src/lib/zr",
    "//third_party/rust_crates:paste",
    "//third_party/rust_crates:pin-init",
  ]
  test_deps = [ ":pool-test-ffi" ]

  with_unit_tests = "host"
}

if (is_host) {
  static_library("pool-test-ffi") {
    testonly = true
    sources = [
      "pool-test-ffi.cc",
      "pool-test-ffi.h",
    ]
    deps = [ ":memalloc" ]
  }
}

static_library("memalloc") {
  complete_static_lib = true

  public_deps = [ ":headers" ]

  sources = [
    "algorithm.cc",
    "pool-ffi.cc",
    "pool-ffi.h",
    "pool.cc",
  ]

  deps = [
    ":range",
    "//sdk/lib/fit",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/zx",
  ]
  if (is_kernel) {
    deps += [ "//zircon/kernel/lib/libc" ]
  }
}

library_headers("testing") {
  testonly = true
  headers = [ "lib/memalloc/testing/range.h" ]
  public_deps = [
    ":range.headers",
    "//third_party/googletest:gtest",
  ]
}

if (!is_kernel) {
  import("//build/components.gni")
  import("//build/cpp/cpp_fuzzer.gni")
  import("//build/fuzz.gni")
  import("//build/test.gni")

  test("memalloc-test") {
    sources = [
      "algorithm-test.cc",
      "pool-mem-config-test.cc",
      "pool-test.cc",
      "range-test.cc",
    ]
    deps = [
      ":memalloc",
      ":testing",
      "//sdk/lib/fit",
      "//src/lib/fxl/test:gtest_main",
      "//third_party/googletest:gmock",
      "//third_party/googletest:gtest",
    ]
  }

  fuchsia_unittest_package("memalloc-test-package") {
    package_name = "memalloc-tests"
    deps = [
      ":memalloc-test",
      "//src/sys/test_runners:tmp_storage",
    ]
  }

  fuchsia_fuzzer_component("find-fuzzer-component") {
    manifest = "meta/find-fuzzer.cml"
    deps = [ ":find-fuzzer" ]
  }

  fuchsia_fuzzer_component("pool-fuzzer-component") {
    manifest = "meta/pool-fuzzer.cml"
    deps = [ ":pool-fuzzer" ]
  }

  if (is_fuchsia) {
    fuchsia_fuzzer_package("memalloc-fuzzers") {
      cpp_fuzzer_components = [
        ":find-fuzzer-component",
        ":pool-fuzzer-component",
      ]
    }
  } else {
    group("memalloc-fuzzers") {
      testonly = true
      deps = [
        ":find-fuzzer",
        ":pool-fuzzer",
      ]
    }
  }

  cpp_fuzzer("find-fuzzer") {
    sources = [ "find-fuzzer.cc" ]
    deps = [
      ":memalloc",
      ":testing",
    ]
  }

  cpp_fuzzer("pool-fuzzer") {
    sources = [ "pool-fuzzer.cc" ]
    deps = [
      ":memalloc",
      ":testing",
    ]
  }

  group("tests") {
    testonly = true
    deps = [
      ":memalloc-fuzzers",
      ":memalloc-rs_test($host_toolchain)",
      ":memalloc-test($host_toolchain)",
      ":memalloc-test-package",
    ]
  }
}
