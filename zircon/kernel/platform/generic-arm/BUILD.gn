import("//zircon/kernel/kernel_rust_mod.gni")

kernel_rust_mod("generic-arm-rs") {
  output_name = "generic_arm"
  source_root = "platform.rs"
  sources = [ "platform.rs" ]
  deps = [
    "//sdk/rust/zbi",
    "//sdk/rust/zx-status",
    "//sdk/rust/zx-types",
    "//src/lib/kprint",
    "//src/lib/lazy_init:lazy_init_rs",
    "//src/lib/zr",
    "//zircon/kernel/lib/arch:arch-rs",
    "//zircon/kernel/lib/boot-options:boot-options-rs",
    "//zircon/kernel/lib/debug",
    "//zircon/kernel/lib/init:init_rust",
    "//zircon/kernel/phys/lib/memalloc:memalloc-rs",
  ]
}

source_set("generic-arm") {
  sources = [ "dev-init.cc" ]

  deps = [
    ":generic-arm-rs",
    "//sdk/lib/zbi-format",
    "//zircon/kernel/dev/hdcp/amlogic_s912",
    "//zircon/kernel/dev/hw_rng/amlogic_rng",
    "//zircon/kernel/dev/hw_rng/qcom_rng",
    "//zircon/kernel/dev/hw_watchdog/generic32",
    "//zircon/kernel/dev/interrupt/gic/common",
    "//zircon/kernel/dev/interrupt/gic/v2",
    "//zircon/kernel/dev/interrupt/gic/v3",
    "//zircon/kernel/dev/iommu/arm_smmu",
    "//zircon/kernel/dev/power/iris",
    "//zircon/kernel/dev/power/moonflower",
    "//zircon/kernel/dev/power/motmot",
    "//zircon/kernel/dev/psci",
    "//zircon/kernel/dev/timer/arm_generic",
    "//zircon/kernel/dev/timer/armv7_mmio_timer",
    "//zircon/kernel/lib/boot-options",
    "//zircon/kernel/lib/ktl",
    "//zircon/kernel/phys/handoff",
    "//zircon/kernel/platform:headers",
    "//zircon/system/ulib/uart",
    "//zircon/system/ulib/zx",
  ]
}

group("kernel-tests") {
  testonly = true
}
