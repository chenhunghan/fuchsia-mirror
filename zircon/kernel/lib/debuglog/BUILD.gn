import("//build/cpp/library_headers.gni")
import("//zircon/kernel/kernel_bindgen_crate.gni")
import("//zircon/kernel/kernel_rust_mod.gni")

library_headers("headers") {
  headers = [
    "lib/debuglog.h",
    "lib/debuglog_types.h",
  ]
}

source_set("debuglog") {
  public_deps = [ ":headers" ]

  sources = [ "debuglog_ffi.cc" ]
  deps = [ ":debuglog-rs" ]
}

group("tests") {
  testonly = true
}

group("kernel-tests") {
  testonly = true
}

group("phys-tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}

kernel_bindgen_crate("debuglog-types") {
  cpp = true
  headers = [ "include/lib/debuglog_types.h" ]

  non_rust_deps = [ ":headers" ]
  deps = [ "//third_party/rust_crates:zerocopy" ]

  additional_bindgen_flags = [
    "--with-derive-default",
    "--with-derive-custom-struct=dlog_.*=zerocopy::FromBytes,zerocopy::IntoBytes,zerocopy::KnownLayout,zerocopy::Immutable",
  ]

  notice_year = 2026

  type_allowlist = [ "dlog_.*" ]
  var_allowlist = [ "DLOG_.*" ]

  expect_lints = [ "non_camel_case_types" ]

  raw_lines = [ "#![no_std]" ]
}

kernel_rust_mod("debuglog-rs") {
  sources = [ "debuglog.rs" ]
  deps = [
    ":debuglog-types",
    "//sdk/rust/zx-status",
    "//sdk/rust/zx-types",
    "//src/lib/kprint",
    "//src/lib/ksync",
    "//src/lib/lazy_init:lazy_init_rs",
    "//src/lib/zr",
    "//third_party/rust_crates:pin-init",
    "//third_party/rust_crates:zerocopy",
    "//zircon/kernel/lib/debug",
    "//zircon/kernel/lib/init:init_rust",
    "//zircon/kernel/lib/io:io-rs",
    "//zircon/kernel/lib/libc:rust",
    "//zircon/system/ulib/fbl/rust:fbl",
  ]
  test_deps = [
    "//src/lib/kalloc",
    "//zircon/kernel/lib/unittest:unittest-rs",
  ]
}
