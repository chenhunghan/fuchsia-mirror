import("//zircon/kernel/kernel_rust_mod.gni")

kernel_rust_mod("virtual_alloc-rs") {
  sources = [ "virtual_alloc.rs" ]
  deps = [
    "//sdk/rust/zx-status",
    "//sdk/rust/zx-types",
    "//src/lib/zr",
    "//third_party/rust_crates:pin-init",
    "//zircon/kernel/lib/debug",
    "//zircon/kernel/lib/page:page-rs",
    "//zircon/system/ulib/bitmap/rust:bitmap",
    "//zircon/system/ulib/fbl/rust:fbl",
  ]
  test_deps = [
    "//src/lib/kprint",
    "//zircon/kernel/lib/unittest:unittest-rs",
  ]
}

group("virtual_alloc") {
  public_deps = [ ":virtual_alloc-rs" ]
}

group("tests") {
  testonly = true
}

group("kernel-tests") {
  testonly = true
}

group("phys-tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}
