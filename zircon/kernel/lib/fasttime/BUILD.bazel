# Note: The GN targets below the sentinel in BUILD.gn are auto-generated from
# this file via `fx bazel2gn`. This library is used by the kernel build, which
# stays on GN. If the kernel build ever needs to express something in GN that
# bazel2gn cannot handle, either annotate the rule (or attribute) here with
# `@bazel2gn:skip` (placed on a `#` comment line immediately above it) and
# maintain its GN definition manually above the sentinel in BUILD.gn (using
# IfChange / ThenChange lint markers to keep them in sync), or emit the GN
# directly with a `@bazel2gn:raw_attribute` annotation.

load("//build/bazel/rules/cc:fx_cc_library_headers.bzl", "fx_cc_library_headers")

package(default_applicable_licenses = ["//:license"])

alias(
    name = "fasttime",
    actual = ":headers",
    visibility = [
        "//src/starnix/kernel:__subpackages__",
        "//zircon/kernel:__subpackages__",
    ],
)

# Note that //zircon/kernel/lib/arch is the full arch library in GN, whereas
# the Bazel target with the same label only provides <lib/arch/intrin.h>. GN
# consumers of these headers get the full library through `public_deps`.
fx_cc_library_headers(
    name = "headers",
    hdrs = [
        "include/lib/fasttime/clock.h",
        "include/lib/fasttime/internal/abi.h",
        "include/lib/fasttime/internal/time.h",
        "include/lib/fasttime/time.h",
    ],
    visibility = [
        "//src/starnix/kernel:__subpackages__",
        "//zircon/kernel:__subpackages__",
    ],
    deps = [
        "//zircon/kernel/lib/arch",
        "//zircon/system/public",
        "//zircon/system/ulib/affine",
    ],
)
