import("//build/rust/rustc_test.gni")
import("//zircon/kernel/kernel_rust_mod.gni")

if (is_kernel) {
  kernel_rust_mod("cmpctmalloc-rs") {
    sources = [
      "cmpctmalloc.rs",
      "mod.rs",
    ]
    deps = [
      "//src/lib/kprint",
      "//src/lib/ksync",
      "//src/lib/zr",
      "//third_party/rust_crates:bitflags",
      "//zircon/kernel/lib/counters",
      "//zircon/kernel/lib/debug",
      "//zircon/kernel/lib/instrumentation/asan:asan-rs",
      "//zircon/kernel/lib/ktrace:ktrace-rs",
      "//zircon/kernel/lib/page:page-rs",
      "//zircon/system/ulib/pretty/rust:pretty",
    ]
  }
} else if (is_host) {
  rustc_test("cmpctmalloc_test") {
    edition = "2024"
    source_root = "mod.rs"
    sources = [
      "cmpctmalloc.rs",
      "mod.rs",
      "tests/cmpctmalloc_test.rs",
      "tests/page_manager.rs",
    ]
    features = [ "userspace" ]
    configs += [ "//build/config/rust:debug_assertions" ]
    deps = [
      "//src/lib/ksync",
      "//src/lib/zr",
      "//third_party/rust_crates:bitflags",
      "//third_party/rust_crates:rand",
      "//zircon/kernel/lib/page:page-rs",
    ]
  }
}

group("tests") {
  testonly = true
  deps = [ ":cmpctmalloc_test($host_toolchain)" ]
}
