import("//zircon/kernel/kernel_rust_mod.gni")

source_set("tests") {
  testonly = true
  sources = [ "asan_tests_ffi.cc" ]
  deps = [ ":tests-rs" ]
}

kernel_rust_mod("tests-rs") {
  testonly = true
  sources = [ "asan_tests.rs" ]
  deps = [
    "//src/lib/kalloc",
    "//src/lib/zr",
    "//zircon/kernel/lib/instrumentation/asan:asan-rs",
    "//zircon/kernel/lib/page:page-rs",
    "//zircon/kernel/lib/unittest:unittest-rs",
    "//zircon/system/ulib/fbl/rust:fbl",
  ]
}
