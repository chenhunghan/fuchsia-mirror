import("//build/components/fuchsia_unittest_package.gni")
import("//build/cpp/library_headers.gni")
import("//build/rust/rustc_staticlib.gni")
import("//build/test.gni")
import("//zircon/kernel/kernel_rust_mod.gni")

library_headers("headers") {
  headers = [
    "lib/power-management/bandwidth-reservation-cache.h",
    "lib/power-management/energy-model.h",
    "lib/power-management/power-state.h",
    "lib/power-management/power-level-controller.h",
    "lib/power-management/types.h",
  ]

  public_deps = [
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/ffl",
    "//zircon/system/ulib/zx",
  ]

  if (is_kernel) {
    headers += [ "lib/power-management/pdev-power-level-controller.h" ]
  }
}

source_set("power-management") {
  public_deps = [ ":headers" ]
  if (is_kernel) {
    sources = [
      "energy_model_ffi.cc",
      "pdev_power_level_controller_ffi.cc",
    ]
    deps = [
      ":power-management-rs",
      "//zircon/kernel/dev/pdev/power",
      "//zircon/kernel/lib/ktl",
      "//zircon/system/ulib/fbl",
    ]
  } else {
    deps = [
      ":energy-model-ffi-cpp",
      ":power-management-userspace-rs",
    ]
  }
}

if (is_kernel) {
  kernel_rust_mod("power-management-rs") {
    sources = [
      "energy_model.rs",
      "energy_model_ffi.rs",
      "mod.rs",
      "pdev_power_level_controller.rs",
      "pdev_power_level_controller_ffi.rs",
      "power_level_controller.rs",
      "power_state.rs",
      "power_state_ffi.rs",
    ]
    deps = [
      "//sdk/rust/zx-status",
      "//sdk/rust/zx-types",
      "//src/lib/ffl",
      "//src/lib/kprint",
      "//src/lib/ksync",
      "//src/lib/zr",
      "//third_party/rust_crates:bitflags",
      "//zircon/kernel/lib/boot-options:boot-options-rs",
      "//zircon/kernel/lib/debug",
      "//zircon/system/ulib/fbl/rust:fbl",
    ]
    test_deps = [ "//zircon/kernel/lib/unittest:unittest-rs" ]
  }
} else {
  source_set("energy-model-ffi-cpp") {
    sources = [ "energy_model_ffi.cc" ]
    public_deps = [ ":headers" ]
    deps = [ "//zircon/system/ulib/fbl" ]
    if (is_fuchsia) {
      public_configs = [ "//build/config/fuchsia:dynamic_cpp_standard_library" ]
    }
  }

  rustc_staticlib("power-management-userspace-rs") {
    edition = "2024"
    source_root = "mod.rs"
    sources = [
      "energy_model.rs",
      "energy_model_ffi.rs",
      "mod.rs",
      "power_level_controller.rs",
      "power_state.rs",
      "power_state_ffi.rs",
    ]
    features = [ "userspace" ]
    with_unit_tests = true
    deps = [
      "//sdk/rust/zx-status",
      "//sdk/rust/zx-types",
      "//src/lib/ffl",
      "//src/lib/zr",
      "//third_party/rust_crates:bitflags",
      "//zircon/system/ulib/fbl/rust:fbl",
    ]
    test_deps = [ ":energy-model-ffi-cpp" ]
  }

  fuchsia_unittest_package("power-management-rust-unittests-package") {
    package_name = "power-management-rust-unittests"
    deps = [ ":power-management-userspace-rs_test" ]
  }
}

group("tests") {
  testonly = true
  deps = [
    ":power-management-rust-unittests-package($default_toolchain)",
    ":power-management-unittests($host_toolchain)",
    ":power-management-unittests-package",
    ":power-management-userspace-rs_test($host_toolchain)",
  ]
}

group("boot_tests") {
  testonly = true
}

if (is_kernel) {
  source_set("kernel-tests") {
    testonly = true
    sources = [ "power-management-tests.cc" ]
    deps = [
      ":power-management",
      "//zircon/kernel/lib/unittest",
    ]
  }

  group("phys-tests") {
    testonly = true
  }
}

test("power-management-unittests") {
  sources = [
    "bandwidth-reservation-cache-test.cc",
    "power-state-test.cc",
  ]
  deps = [
    ":power-management",
    "//src/lib/fxl/test:gtest_main",
    "//third_party/googletest:gtest",
  ]
}

fuchsia_unittest_package("power-management-unittests-package") {
  manifest = "meta/power-management-unittests.cml"
  package_name = "power-management-unittests"
  deps = [ ":power-management-unittests" ]
}
