import("//zircon/kernel/kernel_rust_mod.gni")

group("io") {
  public_deps = [ ":io-rs" ]
}

kernel_rust_mod("io-rs") {
  sources = [ "console.rs" ]
  deps = [
    "//src/lib/ksync",
    "//src/lib/zr",
    "//zircon/kernel/lib/libc:rust",
  ]
}

group("tests") {
  testonly = true
}

group("kernel-tests") {
  testonly = true
  deps = [ "tests" ]
}

group("phys-tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}
