import("//build/cpp/library_headers.gni")
import("//build/rust/rustc_library.gni")

# A specific choice of paging configuration, necessarily one of
# `supported_paging_configurations`.
if (current_cpu == "x64" || current_cpu == "arm64" ||
    current_cpu == "riscv64") {
  # LINT.IfChange
  supported_paging_configurations_by_cpu = {
    x64 = [ "4level" ]
    arm64 = [ "4k-48bit" ]
    riscv64 = [ "sv39" ]
  }

  # LINT.ThenChange(//zircon/kernel/lib/page/src/lib.rs)
  supported_paging_configurations =
      supported_paging_configurations_by_cpu[current_cpu]
  if (current_cpu == "x64") {
    paging_configuration = "4level"
  } else if (current_cpu == "arm64") {
    paging_configuration = "4k-48bit"
  } else if (current_cpu == "riscv64") {
    paging_configuration = "sv39"
  }
  assert(supported_paging_configurations + [ paging_configuration ] -
             [ paging_configuration ] != supported_paging_configurations,
         "Unsupported paging configuration: \"$paging_configuration\"")
} else {
  assert(is_host, "Unsupported CPU: \"$current_cpu\"")

  # In the host toolchain on CPUs without per-CPU <lib/arch/paging-traits.h>
  # headers, //zircon/kernel/lib/arch:headers falls back to its host stub,
  # which supports only the x86 4-level paging configuration.
  paging_configuration = "4level"
}

config("configuration") {
  visibility = [
    ":*",
    "//zircon/kernel/phys/address-space:headers",
  ]
  defines = [ "LIB_ARCH_PAGING_CONFIGURATION=\"$paging_configuration\"" ]
}

library_headers("headers") {
  visibility = [ "//zircon/kernel/*" ]
  headers = [ "lib/page/size.h" ]

  public_configs = [ ":configuration" ]
  public_deps = [
    # <lib/page/size.h> has #include <lib/arch/paging.h>
    # <lib/page/size.h> has #include <lib/arch/paging-traits.h>
    "//zircon/kernel/lib/arch:headers",
  ]
}

source_set("page") {
  visibility = [ "//zircon/kernel/*" ]
  public_deps = [ ":headers" ]
}

rustc_library("page-rs") {
  edition = "2024"
  name = "page"
  sources = [ "src/lib.rs" ]
  rustenv = [ "LIB_ARCH_PAGING_CONFIGURATION=$paging_configuration" ]
  with_unit_tests = is_host
}

group("tests") {
  testonly = true
  deps = [ ":page-rs_test($host_toolchain)" ]
}

group("kernel-tests") {
  testonly = true
}

group("phys-tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}
