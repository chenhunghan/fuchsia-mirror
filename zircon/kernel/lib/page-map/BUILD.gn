import("//build/cpp/library_headers.gni")
import("//zircon/kernel/kernel_rust_mod.gni")

kernel_rust_mod("page-map-rs") {
  sources = [
    "src/accessor.rs",
    "src/entry.rs",
    "src/ffi.rs",
    "src/lib.rs",
  ]
  deps = [
    "//sdk/rust/zx-status",
    "//src/lib/ksync",
    "//src/lib/lazy_init:lazy_init_rs",
    "//src/lib/zr",
    "//third_party/rust_crates:pin-init",
    "//third_party/rust_crates:zerocopy",
    "//zircon/kernel/lib/init:init_rust",
    "//zircon/kernel/lib/page:page-rs",
    "//zircon/system/ulib/fbl/rust:fbl",
  ]
  test_deps = [ "//zircon/kernel/lib/unittest:unittest-rs" ]
}

library_headers("headers") {
  headers = [ "lib/page-map/accessor.h" ]
  public_deps = [
    # <lib/page-map/accessor.h> has #include <lib/user_copy/internal.h>.
    "//zircon/kernel/lib/user_copy:headers",

    # <lib/page-map/accessor.h> has #include <ktl/utility.h>.
    "//zircon/kernel/lib/ktl:headers",
  ]
}

source_set("page-map") {
  public_deps = [ ":headers" ]
  deps = [ ":page-map-rs" ]
}

group("tests") {
  testonly = true
}

group("kernel-tests") {
  testonly = true
}

group("phys-tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}
