import("//build/cpp/library_headers.gni")
import("//zircon/kernel/kernel_rust_mod.gni")

group("backtrace") {
  public_deps = [ ":headers" ]
  deps = [ ":backtrace-rs" ]
}

source_set("ffi") {
  visibility = [ ":*" ]
  sources = [ "backtrace_ffi.cc" ]
  deps = [
    ":headers",
    "//zircon/kernel/lib/object-constants:headers",
  ]
}

kernel_rust_mod("backtrace-rs") {
  sources = [
    "src/backtrace_ffi.rs",
    "src/mod.rs",
    "src/tests.rs",
  ]
  deps = [
    ":ffi",
    "//src/lib/zr",

    # Provides crate `libc`, for libc::stdio::{FILE, fprintf, stdout}.
    "//zircon/kernel/lib/libc:rust",
    "//zircon/kernel/lib/object-constants:object-constants-rs",
  ]
  if (current_cpu == "x64") {
    sources += [ "src/cpu_context_exchange.rs" ]
    deps += [
      "//sdk/rust/zx-status",
      "//sdk/rust/zx-types",
    ]
  }
  test_deps = [ "//zircon/kernel/lib/unittest:unittest-rs" ]
}

library_headers("headers") {
  headers = []

  public_deps = [
    "//zircon/kernel/lib/arch:headers",
    "//zircon/kernel/lib/ktl:headers",

    # <lib/backtrace/cpu_context_exchange.h> has #include <lib/affine/ratio.h>.
    "//zircon/system/ulib/affine:headers",
  ]

  if (current_cpu == "x64") {
    # Needed by global_cpu_context_exchange.h.
    public_deps += [ "//zircon/kernel/arch/x86:headers" ]
  }
}

group("tests") {
  testonly = true
}

group("kernel-tests") {
  testonly = true
  deps = [ "tests" ]
}

group("phys-tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}
