import("//zircon/kernel/kernel_rust_mod.gni")

group("lockup_detector") {
  deps = [ ":lockup_detector-rs" ]
}

kernel_rust_mod("lockup_detector-rs") {
  sources = [
    "diagnostics.rs",
    "inline_impl.rs",
    "lockup_detector.rs",
    "state.rs",
    "tests.rs",
  ]
  deps = [
    "//sdk/rust/zx-status",
    "//sdk/rust/zx-types",
    "//src/lib/kprint",
    "//src/lib/ksync",
    "//src/lib/lazy_init:lazy_init_rs",
    "//src/lib/zr",
    "//third_party/rust_crates:rand",
    "//zircon/kernel/lib/arch:arch-rs",
    "//zircon/kernel/lib/backtrace:backtrace-rs",
    "//zircon/kernel/lib/boot-options:boot-options-rs",
    "//zircon/kernel/lib/console:console_rs",
    "//zircon/kernel/lib/debug",
    "//zircon/kernel/lib/libc:rust",
    "//zircon/kernel/lib/page:page-rs",
    "//zircon/system/ulib/affine/rust:affine",
  ]
  test_deps = [ "//zircon/kernel/lib/unittest:unittest-rs" ]
}

group("tests") {
  testonly = true
}

group("kernel-tests") {
  testonly = true
}

group("phys-tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}
