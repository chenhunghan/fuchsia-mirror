import("//zircon/kernel/kernel_rust_mod.gni")

source_set("lockdep") {
  sources = [
    "lock_dep_ffi.cc",
    "lock_dep_ffi.h",
  ]
  deps = [ "//zircon/kernel/lib/ktl" ]
  public_deps = [
    # The kernel lockdep library is just a slight augmentation of the
    # userland lockdep library, which supplies all the API headers.  So
    # kernel/lib/lockdep is used as if it were a library() itself and acts
    # as the kernel's drop-in replacement for system/ulib/lockdep.
    "//src/lib/lockdep",
  ]
}

kernel_rust_mod("lockdep-rs") {
  sources = [
    "lock_dep.rs",
    "lock_dep_ffi.rs",
  ]
  deps = [
    "//sdk/rust/zx-status",
    "//sdk/rust/zx-types",
    "//src/lib/kprint",
    "//src/lib/ksync",
    "//src/lib/lazy_init:lazy_init_rs",
    "//src/lib/lockdep/rust:lockdep",
    "//src/lib/zr",
    "//third_party/rust_crates:pin-init",
    "//zircon/kernel/lib/backtrace:backtrace-rs",
    "//zircon/kernel/lib/console:console_rs",
    "//zircon/kernel/lib/debug",
    "//zircon/kernel/lib/init:init_rust",
  ]
}

group("tests") {
  testonly = true
}

group("kernel-tests") {
  testonly = true
}

group("phys-tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}
