import("//zircon/kernel/kernel_rust_mod.gni")

group("cbuf") {
  public_deps = [ ":cbuf_rs" ]
}

kernel_rust_mod("cbuf_rs") {
  output_name = "cbuf"
  source_root = "src/mod.rs"
  sources = [ "src/mod.rs" ]
  deps = [
    "//sdk/rust/zx-status",
    "//src/lib/ksync",
    "//third_party/rust_crates:pin-init",
    "//zircon/kernel/lib/debug",
  ]
  test_deps = [ "//sdk/rust/zx-types" ]
}

group("tests") {
  testonly = true
  deps = []
}

group("kernel-tests") {
  testonly = true
}

group("phys-tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}
