import("//zircon/kernel/kernel_rust_mod.gni")

source_set("ksync") {
  sources = [
    "bindings.cc",
    "bindings.h",
  ]
  public = []
  deps = [ "//zircon/kernel/lib/lockdep" ]
}

# Re-exports of the kernel's raw lock implementations (`TrackedMutex` and
# `TrackedCriticalMutex` from //zircon/kernel/kernel/mutex.rs, `TrackedSpinlock`
# and `TrackedMonitoredSpinlock` from //zircon/kernel/kernel/spinlock.rs, and
# `TrackedBrwLockPi` and `TrackedBrwLockNoPi` from
# //zircon/kernel/kernel/brwlock.rs) for `//src/lib/ksync`. This is compiled
# directly into the kernel crate (mounted at `crate::ksync_kernel`) rather than
# into the `ksync` crate, so that only kernel code can name them directly.
# Generic code must instead be parameterized over its `ksync::RawLock` type.
kernel_rust_mod("ksync-rs") {
  sources = [ "mod.rs" ]
  deps = [
    ":ksync",
    "//src/lib/ksync",
  ]
}

group("tests") {
  testonly = true
}

group("kernel-tests") {
  testonly = true
}

group("phys-tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}
