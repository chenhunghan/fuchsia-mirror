import("//zircon/kernel/kernel_rust_mod.gni")

kernel_rust_mod("wake-vector-rs") {
  sources = [ "wake_vector.rs" ]
  deps = [
    "//sdk/rust/zx-status",
    "//sdk/rust/zx-types",
    "//src/lib/ksync",
    "//src/lib/zr",
    "//third_party/rust_crates:pin-init",
    "//zircon/kernel/lib/arch:arch-rs",
    "//zircon/system/ulib/fbl/rust:fbl",
  ]
}

group("wake-vector") {
  public_deps = [ ":wake-vector-rs" ]
}

group("tests") {
  testonly = true
}

group("kernel-tests") {
  testonly = true
}

group("phys-tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}
