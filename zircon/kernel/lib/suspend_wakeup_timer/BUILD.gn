import("//zircon/kernel/kernel_rust_mod.gni")

source_set("ffi") {
  visibility = [ ":*" ]
  sources = [ "suspend_wakeup_timer_ffi.cc" ]
  if (current_cpu == "arm64") {
    deps = [ "//zircon/kernel/dev/timer/armv7_mmio_timer" ]
  }
}

kernel_rust_mod("suspend_wakeup_timer-rs") {
  sources = [
    "suspend_wakeup_timer.rs",
    "suspend_wakeup_timer_ffi.rs",
  ]
  deps = [
    ":ffi",
    "//sdk/rust/zx-status",
    "//sdk/rust/zx-types",
    "//src/lib/ksync",
    "//src/lib/zr",
    "//third_party/rust_crates:pin-init",
    "//zircon/kernel/lib/debug",
  ]
  test_deps = [ "//zircon/kernel/lib/unittest:unittest-rs" ]
}

group("suspend_wakeup_timer") {
  public_deps = [ ":suspend_wakeup_timer-rs" ]
}

group("tests") {
  testonly = true
}

group("kernel-tests") {
  testonly = true
}

group("phys-tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}
