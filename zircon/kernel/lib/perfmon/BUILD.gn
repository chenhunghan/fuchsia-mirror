import("//zircon/kernel/kernel_bindgen_crate.gni")
import("//zircon/kernel/kernel_rust_mod.gni")

kernel_bindgen_crate("perfmon-bindings") {
  headers = [ "//zircon/system/ulib/zircon-internal/include/lib/zircon-internal/device/cpu-trace/perf-mon.h" ]
  cpp = true
  non_rust_deps = [ "//zircon/system/ulib/zircon-internal:headers" ]
  deps = [ "//sdk/rust/zx-types" ]
  notice_year = 2026
  raw_lines = [
    "#![no_std]",
    "pub use zx_types::{zx_instant_mono_ticks_t, zx_ticks_t};",
  ]
  function_blocklist = [ ".*" ]
  type_blocklist = [ "zx_.*" ]
  type_allowlist = [ "perfmon::.*" ]
  var_allowlist = [ "perfmon::.*" ]
  additional_bindgen_flags = [ "--no-recursive-allowlist" ]
  replacements = [
    [
      "\\bperfmon_([A-Za-z0-9_]+)",
      "\\1",
    ],
    [
      "#\\[repr\\(align\\(4\\)\\)\\]\n(#\\[derive\\([^\\n]+\\)\\]\npub struct RecordHeader \\{)",
      "\\1\n    pub _align: [u32; 0],",
    ],
  ]
  std_derives = [
    "default",
    "eq",
    "partialeq",
  ]
  expect_lints = [ "non_upper_case_globals" ]
}

kernel_rust_mod("perfmon_rs") {
  output_name = "perfmon"
  source_root = "src/mod.rs"
  sources = [ "src/mod.rs" ]
  deps = [
    ":perfmon-bindings",
    "//sdk/rust/zx-types",
    "//src/lib/zr",
    "//zircon/kernel/vm:vm-rs",
    "//zircon/system/ulib/fbl/rust:fbl",
  ]
  test_deps = [ "//zircon/kernel/lib/unittest:unittest-rs" ]
}

group("perfmon") {
  public_deps = [ ":perfmon_rs" ]
}

group("tests") {
  testonly = true
}

group("kernel-tests") {
  testonly = true
}

group("phys-tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}
