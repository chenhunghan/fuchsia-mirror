import("//build/config/compiler_config.gni")
import("//build/cpp/library_headers.gni")
import("//build/toolchain/toolchain_environment.gni")
import("//build/toolchain/zircon/zircon_toolchain_suite.gni")
import("//zircon/kernel/kernel_bindgen_crate.gni")
import("//zircon/kernel/kernel_rust_mod.gni")
import("//zircon/kernel/kernel_shell_script.gni")
import("//zircon/kernel/params.gni")

if (toolchain_environment == "kernel.phys" ||
    toolchain_environment == "kernel") {
  # These set the ABI contract between C++ and assembly code.
  # This is kept consistent between the kernel proper and phys
  # so (pure PIC) code should be callable from the kernel proper.
  compiler_config("abi") {
    compiler_configs = [
      ":integer-register-abi",
      ":percpu-abi",
      ":thread-pointer-abi",
    ]

    # Only the kernel proper links in the helper functions.
    if (toolchain_environment == "kernel") {
      compiler_configs += [ ":outline-atomics" ]
    } else {
      compiler_configs += [ "//build/config/arm64:no-outline-atomics" ]
    }
  }

  # Call the helper functions defined in outline-atomics/ for atomic
  # read-modify-write operations, rather than generating LL/SC loops inline.
  # Without LSE, the compiler expands those before register allocation, so a
  # spill or reload can land between the load-exclusive and the
  # store-exclusive, and then the loop isn't guaranteed to make progress.
  #
  # This doesn't cover everything: LLVM still expands atomic min, max, and
  # nand, and all 16-byte atomic operations except compare-and-swap, to LL/SC
  # loops in IR.
  compiler_config("outline-atomics") {
    cflags = [ "-moutline-atomics" ]
    rust_target_features = [ "+outline-atomics" ]
  }

  # Don't use any FP / vector registers in kernel code.  They usually still
  # hold the user-mode values while running in kernel mode.
  compiler_config("integer-register-abi") {
    c_family_flags = [ "-mgeneral-regs-only" ]
    rust_target_features = [
      "-fp-armv8",
      "-neon",
      "-sve",
      "-sve2",
      "-aes",
      "-sha2",
    ]
    if (rust_custom_target) {
      rust_target_edits = [
        {
          key = "abi"
          action = "set"
          value = "softfloat"
        },
        {
          key = "rustc-abi"
          action = "set"
          value = "softfloat"
        },
      ]
    }
  }

  # Reserve a register (x20) to be called percpu_ptr in <lib/arch/asm.h>.
  # The compiler must never touch it except via our inline assembly.
  compiler_config("percpu-abi") {
    c_family_flags = [ "-ffixed-x20" ]
    rust_target_features = [ "+reserve-x20" ]
  }

  # Use the right thread-pointer ABI for the kernel (TPIDR_EL1).  This affects
  # `__builtin_thread_pointer()`; would affect ELF TLS if it were used; and
  # affects the ABI implicitly used by stack-protector.
  compiler_config("thread-pointer-abi") {
    c_family_flags = [ "-mtp=el1" ]
    rust_target_features = [ "+tpidr-el1" ]
  }

  # This is used pervasively throughout the kernel on arm64.
  config("kernel") {
    defines = [ "ARCH_ARM64" ]

    # For #include <arch/foo.h>.
    include_dirs = [ "include" ]

    configs = [
      # <arch/arm64.h> has #include <lib/arch/intrin.h>.
      "//zircon/kernel/lib/arch/arm64:headers.config",
    ]
  }

  source_set("arm64") {
    public_deps = [ ":headers" ]

    sources = [
      "asm.S",
      "cache-ops.S",
      "exceptions.S",
      "fpu_asm.S",
      "secondary.S",
      "smccc.S",
      "uspace_entry.S",
    ]
    deps = [
      "user-copy",
      "//zircon/kernel/lib/arch",
      "//zircon/kernel/lib/code-patching",
      "//zircon/kernel/lib/syscalls",
      "//zircon/kernel/lib/userabi:headers",
    ]
    if (toolchain_environment == "kernel") {
      # Provide the functions called by code compiled with :outline-atomics.
      deps += [ "outline-atomics" ]
    }
  }

  library_headers("headers") {
    headers = [
      # <arch/arm64/hypervisor.h> has #include <lib/id_allocator.h>.
      "//zircon/kernel/lib/id_allocator:headers",

      # <arch/arm64/hypervisor/el2_state.h> has #include <lib/page/size.h>
      "//zircon/kernel/lib/page:headers",
    ]
  }

  kernel_bindgen_crate("arch-arm64-vm-bindings") {
    headers = [ "include/arch/vm.h" ]
    cpp = true
    non_rust_deps = [ ":headers" ]
    raw_lines = [ "#![no_std]" ]
    var_allowlist = [
      "kTbiBit",
      "kTbiMask",
      "kUserBitMask",
    ]
    expect_lints = [ "non_upper_case_globals" ]
    notice_year = 2026
  }

  kernel_bindgen_crate("arch-arm64-aspace-bindings") {
    headers = [
      "include/arch/kernel_aspace.h",
      "include/arch/arm64/aspace-constants.h",
      "include/arch/arm64/hypervisor/el2_state.h",
      "include/arch/arm64/mmu.h",
      "include/arch/aspace.h",
      "../../phys/handoff/include/phys/handoff/handoff.h",
      "../../vm/include/vm/physmap.h",
    ]
    cpp = true
    non_rust_deps = [
      ":headers",
      "//zircon/kernel/lib/ktl:headers",
      "//zircon/kernel/phys/handoff:headers",
      "//zircon/kernel/vm:headers",
    ]
    raw_lines = [ "#![no_std]" ]
    function_allowlist = [ "arm64_el2_tlbi_.*" ]
    type_allowlist = [
      "ArmAspaceRole",
      "ArmAspaceType",
    ]

    # `ArmAspaceRole` is internal to Rust; `ArmAspaceType` crosses FFI only in
    # `rust_arm64_aspace_construct` from the C++ constructor's typed enum
    # parameter (`kUser`, `kKernel`, `kGuest`).
    rustified_enum = [
      "ArmAspaceRole",
      "ArmAspaceType",
    ]
    std_derives = [
      "default",
      "eq",
      "partialeq",
    ]
    var_allowlist = [
      "KERNEL_ASPACE_BASE",
      "KERNEL_ASPACE_SIZE",
      "MMU_.*",
      "USER_ASPACE_BASE",
      "USER_ASPACE_SIZE",
      "USER_RESTRICTED_ASPACE_SIZE",
      "gPhysmapSize",
      "kArm64ArchVmAspaceStateAlign",
      "kArm64ArchVmAspaceStateSize",
      "kArm64VmICacheConsistencyManagerStateAlign",
      "kArm64VmICacheConsistencyManagerStateSize",
      "kHandoffVirtualAddress",
      "kMmu.*",
    ]
    expect_lints = [
      "non_camel_case_types",
      "non_upper_case_globals",
    ]
    notice_year = 2026
  }

  kernel_bindgen_crate("arm64-feature-bindings") {
    headers = [ "include/arch/arm64/feature.h" ]
    cpp = true
    non_rust_deps = [ ":headers" ]
    notice_year = 2026
    raw_lines = [ "#![no_std]" ]
    type_allowlist = [
      "arm64_asid_width",
      "arm64_cache_features",
      "arm64_microarch",
      "arm64_mmu_features",
    ]

    # Every value of these types that Rust reads was produced by Rust: the
    # width fields of arm64_mmu_features, and the arm64_microarch that
    # midr_to_microarch returns. C++ never stores into a location Rust reads
    # as these enums.
    rustified_enum = [
      "arm64_asid_width",
      "arm64_microarch",
    ]
    explicit_padding = false
    expect_lints = [ "non_camel_case_types" ]
  }

  kernel_bindgen_crate("arm64-mp-bindings") {
    headers = [ "include/arch/arm64/mp.h" ]
    cpp = true
    non_rust_deps = [
      ":headers",
      "//zircon/kernel/lib/ktl:headers",
    ]
    notice_year = 2026
    raw_lines = [ "#![no_std]" ]
    explicit_padding = false
    std_derives = [ "default" ]

    # arch_exception_context and ARM64_EXCEPTION_FLAG_LOWER_EL come from
    # arch/arm64.h, which mp.h includes.
    type_allowlist = [
      "arch_exception_context",
      "arm64_percpu",
    ]
    var_allowlist = [
      "ARM64_EXCEPTION_FLAG_LOWER_EL",
      "ARM64_MPIDR_MASK",
      "PERCPU_IN_RESTRICTED_MODE",
    ]
    expect_lints = [
      "non_camel_case_types",
      "non_upper_case_globals",
    ]
  }

  kernel_bindgen_crate("arm64-restricted-bindings") {
    headers = [ "include/arch/restricted.h" ]
    cpp = true
    non_rust_deps = [ ":headers" ]
    notice_year = 2026
    raw_lines = [ "#![no_std]" ]
    type_allowlist = [ "ArchSavedNormalState" ]
    explicit_padding = false
    std_derives = [
      "default",
      "eq",
      "partialeq",
    ]
    expect_lints = []
  }

  kernel_bindgen_crate("arm64-thread-bindings") {
    headers = [ "include/arch/arch_thread.h" ]
    cpp = true
    non_rust_deps = [ ":headers" ]
    notice_year = 2026
    raw_lines = [ "#![no_std]" ]
    type_allowlist = [
      "arch_thread",
      "zx_arm64_thread_state_debug_regs_t",
      "zx_arm64_thread_state_fp_regs_t",
      "zx_arm64_thread_state_sve_regs_t",
      "zx_arm64_thread_state_vector_regs_t",
    ]
    var_allowlist = [
      "ARM64_DFR_RUN_ACCESS_FAULT_HANDLER_BIT",
      "ARM64_DFR_RUN_FAULT_HANDLER_BIT",
      "ARM64_MAX_HW_BREAKPOINTS",
      "ARM64_MAX_HW_WATCHPOINTS",
      "CURRENT_MDSCR_OFFSET",
      "CURRENT_PERCPU_PTR_OFFSET",
      "FPSTATE_FFR_OFFSET",
      "FPSTATE_FPCR_OFFSET",
      "FPSTATE_FPSR_OFFSET",
      "FPSTATE_P_REGS_OFFSET",
      "FPSTATE_REGS_OFFSET",
      "MSDCR_EL1_INITIAL_VALUE",
    ]
    explicit_padding = false
    expect_lints = [ "non_camel_case_types" ]
  }

  kernel_bindgen_crate("arm64-user-copy-bindings") {
    headers = [ "user-copy/user-copy.h" ]
    cpp = true
    non_rust_deps = [ ":headers" ]
    deps = [ "//sdk/rust/zx-types" ]
    notice_year = 2026
    raw_lines = [
      "#![no_std]",
      "pub type zx_status_t = zx_types::zx_status_t;",
      "pub type zx_vaddr_t = zx_types::zx_vaddr_t;",
    ]
    type_blocklist = [ "zx_.*" ]
    type_allowlist = [
      "Arm64UserCopyCaptureFaultsRet",
      "Arm64UserCopyRet",
    ]
    explicit_padding = false
    expect_lints = [ "non_camel_case_types" ]
  }

  kernel_rust_mod("arch-arm64-rs") {
    output_name = "arch_arm64"
    source_root = "src/mod.rs"
    sources = [
      "src/arch.rs",
      "src/asid_allocator.rs",
      "src/cache.rs",
      "src/coresight.rs",
      "src/crashlog.rs",
      "src/dap.rs",
      "src/debugger.rs",
      "src/exceptions.rs",
      "src/feature.rs",
      "src/fpu.rs",
      "src/mmu.rs",
      "src/mmu_ffi.rs",
      "src/mod.rs",
      "src/mp.rs",
      "src/outline_atomics.rs",
      "src/periphmap.rs",
      "src/registers.rs",
      "src/restricted.rs",
      "src/secondary.rs",
      "src/smccc.rs",
      "src/spinlock.rs",
      "src/sysreg.rs",
      "src/thread.rs",
      "src/uarch.rs",
      "src/user_copy.rs",
      "src/vm.rs",
    ]
    deps = [
      ":arch-arm64-aspace-bindings",
      ":arch-arm64-vm-bindings",
      ":arm64-feature-bindings",
      ":arm64-mp-bindings",
      ":arm64-restricted-bindings",
      ":arm64-thread-bindings",
      ":arm64-user-copy-bindings",
      "//sdk/rust/zx-status",
      "//sdk/rust/zx-types",
      "//src/lib/kalloc",
      "//src/lib/kprint",
      "//src/lib/ksync",
      "//src/lib/lazy_init:lazy_init_rs",
      "//src/lib/lockdep/rust:lockdep",
      "//src/lib/regio",
      "//third_party/rust_crates:pin-init",
      "//third_party/rust_crates:zerocopy",
      "//zircon/kernel/arch:arch-types-bindings",
      "//zircon/kernel/dev/coresight:coresight-rs",
      "//zircon/kernel/lib/arch:arch-rs",
      "//zircon/kernel/lib/boot-options:boot-options-rs",
      "//zircon/kernel/lib/debug",
      "//zircon/kernel/lib/id_allocator:id-allocator-rs",
      "//zircon/kernel/lib/init:init_rust",
      "//zircon/kernel/lib/ktrace:ktrace-rs",
      "//zircon/kernel/lib/libc:rust",
      "//zircon/kernel/lib/page:page-rs",
      "//zircon/kernel/lib/user_copy",
      "//zircon/kernel/phys/handoff:handoff-rs",
      "//zircon/system/ulib/fbl/rust:fbl",
      "//zircon/system/ulib/mmio-ptr:mmio-ptr-rs",
      "//zircon/system/ulib/pretty/rust:pretty",
    ]
    test_deps = [ "//zircon/kernel/lib/unittest:unittest-rs" ]
  }

  group("kernel-tests") {
    testonly = true
  }
} else if (!is_efi_toolchain) {
  assert(current_cpu == "arm64")

  # Known arm64 hardware with no FEAT_LSE (ARMv8.0 Cortex-A53 / Cortex-A73).
  no_lse_envs = [
    astro_env,
    lilac_env,
    sherlock_env,
    sorrel_env,
    vim3_env,
  ]

  # Known arm64 hardware with FEAT_LSE where auto chooses the Cortex-A55
  # prefetch workaround (`lse-a55`).
  lse_a55_envs = [ nelson_env ]

  # Known arm64 hardware with FEAT_LSE that auto should use.  Under KVM, QEMU
  # and crosvm pass `-cpu host` (while TCG uses `-cpu max`), so generic
  # emulator environments depend on the host CPU; only emulator environments
  # whose `host_device_type` pins a known ARMv8.2+ server CPU are listed.
  wanted_lse_envs = [
    ampere_altra_env,
    ampere_one_env,
    c4a_env,
    crosvm_arm64_env,
    iris_env,
  ]

  # All hardware and emulators, deduplicated.
  all_envs = []
  foreach(env, all_fuchsia_envs + kernel_test_environments) {
    all_envs += [ env ]
    all_envs -= [ env ]
    all_envs += [ env ]
  }

  outline_atomics_boot_tests = [
    # Default `kernel.arm64.atomics=auto` picks LL/SC on hardware with no
    # FEAT_LSE.
    {
      name = "auto-llsc"
      expected = "llsc"
      environments = no_lse_envs
    },

    # Default `kernel.arm64.atomics=auto` picks `lse-a55` on Cortex-A55.
    {
      name = "auto-lse-a55"
      expected = "lse-a55"
      environments = lse_a55_envs
    },

    # Default `kernel.arm64.atomics=auto` picks LSE on hardware with
    # FEAT_LSE we want to use.
    {
      name = "auto-lse"
      expected = "lse"
      environments = wanted_lse_envs
    },

    # Forced `llsc` works on all hardware and emulators.
    {
      name = "llsc"
      args = [ "kernel.arm64.atomics=llsc" ]
      expected = "llsc"
      environments = all_envs
    },

    # Forced `lse` works on all known hardware with FEAT_LSE, including
    # Cortex-A55.
    {
      name = "lse"
      args = [ "kernel.arm64.atomics=lse" ]
      expected = "lse"
      environments = wanted_lse_envs + lse_a55_envs
    },

    # Forced `lse-a55` works on all known hardware with FEAT_LSE.
    {
      name = "lse-a55"
      args = [ "kernel.arm64.atomics=lse-a55" ]
      expected = "lse-a55"
      environments = wanted_lse_envs + lse_a55_envs
    },
  ]

  boot_test_deps = []
  foreach(test, outline_atomics_boot_tests) {
    test_target = "arm64-outline-atomics-${test.name}-boot-test"
    boot_test_deps += [ ":$test_target" ]

    kernel_shell_script_test(test_target) {
      forward_variables_from(test,
                             [
                               "args",
                               "environments",
                             ])
      script = [
        "outline_atomics ${test.expected}",
        "and ut arm64_outline_atomics",
        "boot-test-success",
        {
          cuckoo = false
          lines = [ "graceful-shutdown" ]
        },
      ]
    }
  }

  group("boot_tests") {
    testonly = true
    deps = boot_test_deps
  }
}
