kernel_bindgen_crate("mutex-bindings") {
  visibility = [ "//zircon/kernel/*" ]
  headers = [ "//zircon/kernel/include/kernel/mutex.h" ]
  non_rust_deps = [ ":kernel" ]
  cpp = true

  notice_year = 2026

  # Layout contract only: the Rust `Mutex` and `CriticalMutex` assert their
  # size, alignment, and constants against the C++ `Mutex` and `CriticalMutex`
  # facades.
  function_blocklist = [ ".*" ]
  var_allowlist = [
    "Mutex_SPIN_MAX_DURATION",
    "Mutex_DEFAULT_TIMESLICE_EXTENSION",
  ]
  type_allowlist = [
    "Mutex",
    "CriticalMutex",
  ]
  opaque_types = [
    "Mutex",
    "CriticalMutex",
  ]

  # bindgen still emits nested enums of allowlisted opaque classes.
  type_blocklist = [
    "zx_duration_t",
    "CriticalMutex_ShouldClear",
  ]
  additional_bindgen_flags = [ "--no-recursive-allowlist" ]
  deps = [ "//sdk/rust/zx-types" ]
  expect_lints = [ "non_upper_case_globals" ]
  raw_lines = [
    "#![no_std]",
    "pub use zx_types::zx_duration_t;",
  ]
}

