kernel_bindgen_crate("event-bindings") {
  visibility = [ "//zircon/kernel/*" ]
  headers = [ "//zircon/kernel/include/kernel/event_layout.h" ]
  non_rust_deps = [ ":kernel" ]
  output_name = "event_bindings.rs"
  cpp = true

  edition = "2024"
  notice_year = 2026

  # Layout contract only: the opaque `Event`/`AutounsignalEvent` types
  # (re-exported by other bindgen crates for pointer signatures) and the
  # `EventLayout` constants the Rust `Event` asserts its layout against.
  function_blocklist = [ ".*" ]
  var_allowlist = [ "EventLayout_k.*" ]
  type_allowlist = [
    "Event",
    "AutounsignalEvent",
  ]
  opaque_types = [
    "Event",
    "AutounsignalEvent",
  ]
  additional_bindgen_flags = [ "--no-recursive-allowlist" ]
  expect_lints = [
    "non_camel_case_types",
    "non_upper_case_globals",
  ]
  raw_lines = [ "#![no_std]" ]
}

