load("//build/bazel/rules/fidl:fidl_library.bzl", "fidl_library")

package(default_applicable_licenses = ["//:license"])

fidl_library(
    name = "fuchsia.hardware.camera.sensor",
    srcs = ["camera-sensor.fidl"],
    enable_banjo = True,
    visibility = [
        "//src/camera/drivers/sensors/imx227:__pkg__",
        "//src/camera/drivers/test_utils:__pkg__",
        "//vendor:__subpackages__",
    ],
    deps = [
        "//sdk/banjo/fuchsia.hardware.camera",
        "//zircon/vdso/zx",
    ],
)
