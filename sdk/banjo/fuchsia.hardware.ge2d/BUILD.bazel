load("//build/bazel/rules/fidl:fidl_library.bzl", "fidl_library")

package(default_applicable_licenses = ["//:license"])

fidl_library(
    name = "fuchsia.hardware.ge2d",
    srcs = ["ge2d.fidl"],
    enable_banjo = True,
    enable_cpp = False,
    enable_rust_next = False,
    visibility = [
        "//src/camera/drivers/controller:__subpackages__",
        "//src/camera/drivers/hw_accel/ge2d:__pkg__",
    ],
    deps = [
        "//sdk/banjo/fuchsia.hardware.camera",
        "//sdk/banjo/fuchsia.hardware.camerahwaccel",
        "//sdk/banjo/fuchsia.sysmem",
        "//zircon/vdso/zx",
    ],
)
