library fuchsia.hardware.pci;
using zx;

const READBAR_MAX_SIZE uint32 = 1024;
const MAX_NAME_LEN uint32 = 32;

type RootInfo = struct {
    name string:MAX_NAME_LEN;
    start_bus_number uint8;
    end_bus_number uint8;
    segment_group uint16;
};

type DeviceSnapshot = struct {
    bdf Bdf;
    /// The size of each BAR, or 0 if the BAR is unused.
    bar_sizes array<uint64, MAX_BAR_COUNT>;
    /// The device's configuration space. This is 4096 bytes for PCIe devices
    /// on an extended ECAM and 256 bytes otherwise.
    config vector<uint8>:EXTENDED_CONFIG_SIZE;
};

/// The Debug protocol provides information about devices on a particular bus.
/// It is used for tools like lspci and not for driver operations.
@discoverable
closed protocol Debug {
    /// Retrieve information about the root this bus is attached to.
    strict GetRootInfo() -> (struct {
        info RootInfo;
    });
    /// Starts an enumeration of all devices on the bus. Devices are read
    /// from |iterator|.
    strict GetDevices(resource struct {
        iterator server_end:DeviceIterator;
    });
    /// Read from a Device's base address register (BAR). The BAR must be an MMIO type.
    ///
    /// Parameters
    /// |device|: The address of the device to read from.
    /// |bar_id|: The ID of the BAR to read.
    /// |offset|: The offset, in bytes, to start the read (default: 0 bytes).
    /// |size|: The size of the read (default: 128 bytes). The max size for a
    /// read is |READBAR_MAX_SIZE|.
    ///
    /// Errors:
    /// |ZX_ERR_NOT_FOUND|: |device| was not found, or |bar_id| did not exist in |device|.
    /// |ZX_ERR_INVALID_ARGS|: |bar_id| is invalid,  or offset / size combined
    /// are invalid for the given BAR's size.
    /// |ZX_ERR_NOT_SUPPORTED|: The BAR specified by |bar_id| is not an MMIO BAR.
    /// |ZX_ERR_BAD_STATE|: The BAR is unallocated or memory decode is disabled
    /// for the device.
    strict ReadBar(struct {
        device Bdf;
        bar_id uint8;
        offset uint64;
        size uint64;
    }) -> (struct {
        buffer vector<uint8>:READBAR_MAX_SIZE;
    }) error zx.Status;
};

/// Iterates over the devices on a bus. The server closes the channel after
/// replying with an empty vector.
closed protocol DeviceIterator {
    /// Returns the next batch of devices, or an empty vector when all
    /// devices have been returned.
    strict GetNext() -> (struct {
        devices vector<DeviceSnapshot>:MAX;
    });
};

@available(added=HEAD)
service DebugService {
    debug client_end:Debug;
};
