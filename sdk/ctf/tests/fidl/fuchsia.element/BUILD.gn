import("//build/components.gni")
import("//sdk/ctf/build/ctf.gni")

group("tests") {
  testonly = true
  deps = [
    ":ctf-tests",
    ":fuchsia-element-tests-latest",
  ]
}

group("ctf-tests") {
  testonly = true
  deps = [ ":fuchsia-element-tests_archive" ]
}

# TODO(https://fxbug.dev/570694755): The test package is kept in GN while
# //sdk/ctf/tests/fidl/fuchsia.element/testing/realm-factory:realm-factory,
# which it subpackages, is a GN-only package. Its test root component stays
# in GN too, because fuchsia_test_package() calls get_target_outputs() on its
# test_components, which only works for targets defined earlier in this file.
fuchsia_component("test-root") {
  manifest = "meta/test-root.cml"
}

fuchsia_test_package("fuchsia-element-tests-latest") {
  test_components = [ ":test-root" ]
  subpackages = [
    "testing/realm-factory",
    ":fuchsia-element-tests",
  ]
}

