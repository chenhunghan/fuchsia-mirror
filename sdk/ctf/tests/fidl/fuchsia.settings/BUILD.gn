import("//build/components.gni")

group("tests") {
  testonly = true
  deps = [
    ":ctf-tests",
    ":fuchsia-settings-tests-package",
  ]
}

group("ctf-tests") {
  testonly = true
  deps = [ ":fuchsia-settings-tests_archive" ]
}

# The test root and its test package are not migrated to Bazel yet, because the
# package subpackages testing/realm-factory, which depends on GN-only targets
# (such as //src/settings/service:setui_service_v2).
fuchsia_test_component("test-root") {
  testonly = true
  manifest = "meta/test-root.cml"
  test_type = "ctf"
}

fuchsia_test_package("fuchsia-settings-tests-package") {
  test_components = [ ":test-root" ]
  subpackages = [
    ":fuchsia-settings-tests",
    "testing/realm-factory",
  ]
}

