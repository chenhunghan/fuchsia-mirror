# Retained above the sentinel in BUILD.gn because bazel2gn does not translate
# list comprehensions or gidl_hlcpp_conformance().
# @bazel2gn:skip
_GIDL_OUTPUT_PREFIX = "conformance_suite__"

# @bazel2gn:skip
_GIDL_DEPS = [
    ":%s%s" % (
        _GIDL_OUTPUT_PREFIX,
        gidl_file.rsplit(":", 1)[1].removesuffix(".gidl"),
    )
    for gidl_file in CONFORMANCE_SUITE_GIDL_FILES
]

# @bazel2gn:skip
[
    gidl_hlcpp_conformance(
        name = "%s%s" % (
            _GIDL_OUTPUT_PREFIX,
            gidl_file.rsplit(":", 1)[1].removesuffix(".gidl"),
        ),
        testonly = True,
        fidl = CONFORMANCE_SUITE_FIDL_TARGET,
        inputs = [gidl_file],
        deps = [
            ":test_util",
            "//zircon/system/ulib/zxtest",
        ] + select({
            "@platforms//os:fuchsia": [":handle_util"],
            "//conditions:default": [],
        }),
    )
    for gidl_file in CONFORMANCE_SUITE_GIDL_FILES
]

