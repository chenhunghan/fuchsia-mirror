rustc_binary("bin") {
  testonly = true
  sources = [ "src/main.rs" ]
  output_name = "ctf_example_realm_factory"
  edition = "2024"
  deps = [
    "//examples/fidl/fuchsia.examples:fuchsia.examples_rust",
    "//sdk/ctf/tests/examples/fidl/fuchsia.examples/testing/fidl:test.example_rust",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-component-test",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
}

fuchsia_component_manifest("echo-realm-factory_manifest") {
  testonly = true
  component_name = "echo-realm-factory"
  manifest = "meta/realm-factory.cml"
}

fuchsia_component("echo-realm-factory-component") {
  testonly = true
  cm_label = ":echo-realm-factory_manifest"
  deps = [ ":bin" ]
}
