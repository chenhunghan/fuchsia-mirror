# [START build]

import("//sdk/ctf/build/ctf.gni")

group("tests") {
  testonly = true
  deps = [ ":fuchsia-examples-rust-tests-package" ]
}

group("ctf-tests") {
  testonly = true
  deps = [ ":fuchsia-examples-rust-tests_archive" ]
}

# Kept in GN: the test package subpackages the Rust test runners
# (RUST_SUBPACKAGES), which have no Bazel package targets yet, so the Bazel
# test package can't be defined. bazel2gn only converts an
# fx_test_component() listed in a converted package's test_components, so the
# test root component stays in GN with it.
fuchsia_test_component("test-root") {
  testonly = true
  manifest = "meta/test-root.cml"
  test_type = "ctf"
}

fuchsia_test_package("fuchsia-examples-rust-tests-package") {
  test_components = [ ":test-root" ]
  subpackages = [
    "//sdk/ctf/tests/examples/fidl/fuchsia.examples/testing/realm-factory:echo-realm-factory",
    ":fuchsia-examples-rust-tests",
  ]
  subpackages += RUST_SUBPACKAGES
}

# [END build]

