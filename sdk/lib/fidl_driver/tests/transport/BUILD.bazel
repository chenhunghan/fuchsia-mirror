)

fidl_library(
    name = "test.transport",
    testonly = True,
    srcs = ["transport.test.fidl"],
    contains_drivers = True,
    excluded_checks = ["vector-bounds-not-specified"],
    deps = [
        "//sdk/fidl/fdf",
        "//zircon/vdso/zx",
    ],
)

