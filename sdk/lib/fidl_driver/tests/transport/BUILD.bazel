# This test uses gtest in order to exercise death conditions.
fx_cc_test_binary(
    name = "fidl_driver_api_test_bin",
    srcs = [
        "api_test.cc",
        "api_test_helper.h",
        "server_binding_group_test.cc",
        "server_binding_test.cc",
    ],
    deps = [
        ":test.transport_cpp",
        "//sdk/lib/async:async-cpp",
        "//sdk/lib/async_patterns/testing/cpp",
        "//sdk/lib/driver/runtime/testing/cpp",
        "//sdk/lib/driver/testing/cpp",
        "//sdk/lib/fidl_driver",
        "//sdk/lib/fidl_driver:fidl_driver_natural",
        "//src/lib/fxl/test:gtest_main",
        "//src/lib/testing/predicates",
        "//zircon/system/ulib/sync:sync-cpp",
        "@com_google_googletest//:gtest",
    ],
)

fx_packaged_binary(
    name = "fidl_driver_api_test_packaged_bin",
    testonly = True,
    binary = ":fidl_driver_api_test_bin",
    binary_name = "fidl_driver_api_test_bin",
    install_root = "test/",
)

# Use `fuchsia.process.Launcher` for death tests
fx_component_manifest(
    name = "fidl_driver_api_test_manifest",
    testonly = True,
    component_name = "fidl_driver_api_test",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/gtest:death_test.shard.cml",
        "//src/sys/test_runners/gtest:default.shard.cml",
    ],
    manifest = "meta/fidl_driver_api_test.cml",
)

