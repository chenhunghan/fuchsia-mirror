load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/fidl:fidl_library.bzl", "fidl_library")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [],  # Include all tests in the package.
    visibility = [
        "//sdk/lib:__pkg__",
        "//sdk/lib/fidl_driver/tests:__pkg__",
    ],
)

fidl_library(
    name = "test.driver.coding",
    testonly = True,
    srcs = ["coding.test.fidl"],
    contains_drivers = True,
    visibility = ["//sdk/lib/fidl_driver/tests/conversion:__pkg__"],
    deps = [
        "//sdk/fidl/fdf",
        "//zircon/vdso/zx",
    ],
)

fx_cc_test_binary(
    name = "fidl_driver_cpp_natural_coding_tests_bin",
    srcs = ["coding_test.cc"],
    deps = [
        ":test.driver.coding_cpp",
        "//sdk/lib/stdcompat",
        "//src/devices/bin/driver_runtime:driver_runtime_impl",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_package(
    name = "fidl_driver_cpp_natural_coding_tests",
    unit_tests = [":fidl_driver_cpp_natural_coding_tests_bin"],
)
