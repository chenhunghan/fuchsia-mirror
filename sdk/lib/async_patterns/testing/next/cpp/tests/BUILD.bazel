load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":async_patterns_testing_next_tests"],
    visibility = ["//sdk/lib:__pkg__"],
)

fx_cc_test_binary(
    name = "bin",
    srcs = ["sync_proxy_test.cc"],
    gn_output_name = "async_patterns_testing_next_unittests",
    # Packaged into :async_patterns_testing_next_tests; do not build bare in wildcard builds.
    tags = ["manual"],
    deps = [
        "//sdk/lib/async:async-cpp",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async_patterns/testing/next/cpp",
        "//src/lib/fxl/test:gtest_main",
        "@com_google_googletest//:gtest",
    ],
)

fx_unittest_package(
    name = "async_patterns_testing_next_tests",
    unit_tests = [":bin"],
)
