import("//build/bazel/bazel_test_suite.gni")

group("tests") {
  testonly = true

  deps = [
    ":bazel_tests",
    "async-loop-testing:tests",
    "async/rust:tests",
    "c:tests",
    "component:tests",
    "device-watcher:tests",
    "devicetree:tests",
    "diagnostics:tests",
    "driver:tests",
    "driver_test_realm:tests",
    "fdio:tests",
    "fdio-caller:tests",
    "fidl_driver/tests",
    "file-lock:tests",
    "fit-promise:tests",
    "fuchsia-mem-ext:tests",
    "fuzzing/cpp:tests",
    "inspect:tests",
    "iob:tests",
    "ld:tests",
    "memory_barriers:tests",
    "power:tests",
    "scheduler:tests",
    "sys/component:tests",
    "sys/service/cpp:tests",
    "syslog:tests",
    "utf-utils:tests",
    "vfs/cpp:tests",
    "zircon-assert/test",
    "zxio:tests",
  ]
}

bazel_test_suite("bazel_tests") {
  host_tests = [ "//sdk/lib:host_tests" ]
  target_tests = [ "//sdk/lib:target_tests" ]
}
