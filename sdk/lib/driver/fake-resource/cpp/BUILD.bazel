load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/idk:idk_cc_source_library.bzl", "idk_cc_source_library")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

idk_cc_source_library(
    name = "cpp",
    srcs = ["fake-resource.cc"],
    hdrs = ["fake-resource.h"],
    api_area = "Driver SDK",
    category = "partner",
    idk_name = "driver_fake_resource_cpp",
    implementation_deps = [
        "//sdk/lib/driver/fake-object/cpp",
        "//sdk/lib/fdio",
        "//zircon/system/ulib/zx",
    ],
    include_base = "//sdk",
    public_configs = ["//sdk/config"],
    stable = False,
    visibility = [
        "//sdk/lib/driver/fake-platform-device/cpp:__pkg__",
        "//sdk/lib/driver/fake-platform-device/rust:__pkg__",
        "//sdk/lib/driver/platform-device/cpp/tests:__pkg__",
        "//src/devices:__subpackages__",
        "//src/graphics:__subpackages__",
        "//vendor/google:__subpackages__",
    ],
)

fx_cc_test_binary(
    name = "fake_resource_test",
    srcs = ["fake-resource-test.cc"],
    deps = [
        ":cpp",
        "//sdk/lib/driver/fake-object/cpp",
        "//zircon/system/ulib/fbl",
        "//zircon/system/ulib/zx",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_package(
    name = "fake_resource_test_package",
    unit_tests = [":fake_resource_test"],
    visibility = ["//sdk/lib:__pkg__"],
)
