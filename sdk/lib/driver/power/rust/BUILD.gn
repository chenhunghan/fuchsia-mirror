import("//build/components.gni")
import("//build/rust/rustc_test.gni")

# The library is defined in BUILD.bazel. The unit tests stay in GN: they depend
# on //src/devices/bin/driver_runtime (via //sdk/lib/driver/component/rust),
# which is not built by Bazel yet.
rustc_test("rust_test") {
  sources = [ "src/lib.rs" ]
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.driver.framework:fuchsia.driver.framework_rust_next",
    "//sdk/fidl/fuchsia.hardware.power:fuchsia.hardware.power_rust",
    "//sdk/fidl/fuchsia.hardware.powerdomain:fuchsia.hardware.powerdomain_rust_next",
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/fidl/fuchsia.power.broker:fuchsia.power.broker_rust",
    "//sdk/fidl/fuchsia.power.system:fuchsia.power.system_rust",
    "//sdk/lib/driver/component/rust",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fidl/rust_next/fidl_next",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-sync",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
  output_name = "fdf_power_lib_test"
  lint_config = "//build/config/rust/lints:clippy_warn_all"
}

fuchsia_unittest_package("fdf_rust_power_tests") {
  deps = [ ":rust_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":fdf_rust_power_tests" ]
}

