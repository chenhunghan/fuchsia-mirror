import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("env") {
  sources = [
    "src/lib.rs",
    "src/test.rs",
  ]
  crate_name = "fdf_env"
  edition = "2024"
  link_deps = [ "//src/devices/bin/driver_runtime" ]
  lint_config = "//build/config/rust/lints:clippy_warn_all"
  visibility = [
    ":*",
    "//sdk/lib/async/rust/*",
    "//sdk/lib/driver/*",
    "//src/connectivity/wlan/drivers/wlan-virtio-hwsim:*",
    "//src/connectivity/wlan/drivers/wlanif:*",
    "//src/devices/bin/driver-host:*",
    "//src/devices/block/drivers/cqhci:*",
    "//src/sys/runners/dso:*",
    "//vendor/google/*",
  ]
  deps = [
    "//sdk/lib/async/rust/dispatcher",
    "//sdk/lib/driver/runtime/rust/core",
    "//sdk/lib/driver/runtime/rust/fdf_sys",
    "//sdk/rust/zx",
  ]
}
if (is_fuchsia) {
  rustc_test("env_test") {
    sources = [
      "src/lib.rs",
      "src/test.rs",
    ]
    edition = "2024"
    link_deps = [ "//src/devices/bin/driver_runtime" ]
    deps = [
      "//sdk/lib/async/rust/dispatcher",
      "//sdk/lib/driver/runtime/rust/core",
      "//sdk/lib/driver/runtime/rust/fdf_sys",
      "//sdk/rust/zx",
    ]
    lint_config = "//build/config/rust/lints:clippy_warn_all"
  }
}

fuchsia_unittest_package("fdf_rust_env_tests") {
  package_name = "fdf_rust_env_tests-gn"
  component_name = "fdf_rust_env_tests"
  deps = [ ":env_test" ]
  visibility = [
    ":*",
    "//sdk/lib/driver/runtime/rust:*",
  ]
}
