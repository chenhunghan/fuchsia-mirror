load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "env",
    srcs = [
        "src/lib.rs",
        "src/test.rs",
    ],
    crate_name = "fdf_env",
    edition = "2024",
    link_deps = [
        # Bazel links the driver runtime ABI stub; GN keeps the
        # sdk_shared_library in //src/devices/bin/driver_runtime.
        "//src/devices/lib/driver:driver_runtime",  # @bazel2gn:path_overwrite://src/devices/bin/driver_runtime
    ],
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    visibility = [
        "//sdk/lib/async/rust:__subpackages__",
        "//sdk/lib/driver:__subpackages__",
        "//src/connectivity/wlan/drivers/wlan-virtio-hwsim:__pkg__",
        "//src/connectivity/wlan/drivers/wlanif:__pkg__",
        "//src/devices/bin/driver-host:__pkg__",
        "//src/devices/block/drivers/cqhci:__pkg__",
        "//src/sys/runners/dso:__pkg__",
        "//vendor/google:__subpackages__",
    ],
    deps = [
        "//sdk/lib/async/rust/dispatcher",
        "//sdk/lib/driver/runtime/rust/core",
        "//sdk/lib/driver/runtime/rust/fdf_sys",
        "//sdk/rust/zx",
    ],
)

rustc_test(
    name = "env_test",
    crate = ":env",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    target_compatible_with = ["@platforms//os:fuchsia"],
)

fx_unittest_package(
    name = "fdf_rust_env_tests",
    unit_tests = [":env_test"],
    visibility = ["//sdk/lib/driver/runtime/rust:__pkg__"],
)
