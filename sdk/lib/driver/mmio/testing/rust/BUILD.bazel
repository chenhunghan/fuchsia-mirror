load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":fake-mmio-rust-unittests"],
    visibility = ["//sdk/lib:__pkg__"],
)

rustc_library(
    name = "rust",
    testonly = True,
    srcs = [
        "src/atomic.rs",
        "src/cached_vmo.rs",
        "src/device.rs",
        "src/inject.rs",
        "src/inject/after_store.rs",
        "src/inject/dispatch.rs",
        "src/inject/offset.rs",
        "src/inject/passthrough.rs",
        "src/inject/range_override.rs",
        "src/inject/registry.rs",
        "src/inject/w1c.rs",
        "src/lib.rs",
        "src/operand.rs",
    ],
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate_name = "fake_mmio",
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    deps = [
        "//sdk/lib/driver/mmio/rust:mmio",
        "//sdk/rust/zx",
    ],
)

rustc_test(
    name = "rust_test",
    build_flags = ["//build/config/rust/lints:deny_unused_results"],
    crate = ":rust",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    deps = [
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:bitfield",
        "//third_party/rust_crates/vendor:mockall",
    ],
)

# Run with `fx test fake-mmio-rust-unittests`
fx_unittest_package(
    name = "fake-mmio-rust-unittests",
    unit_tests = [":rust_test"],
)
