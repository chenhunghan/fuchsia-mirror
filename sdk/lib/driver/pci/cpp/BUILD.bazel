load("//build/bazel/rules/idk:idk_cc_source_library.bzl", "idk_cc_source_library")

package(default_applicable_licenses = ["//:license"])

idk_cc_source_library(
    name = "cpp",
    srcs = ["pci.cc"],
    hdrs = ["pci.h"],
    api_area = "Driver SDK",
    category = "partner",
    idk_name = "driver_pci_cpp",
    include_base = "//sdk",
    public_configs = ["//sdk/config"],
    stable = False,
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = [
        "//sdk/lib/driver:__subpackages__",
        "//src/connectivity:__subpackages__",
        "//src/devices:__subpackages__",
        "//src/graphics:__subpackages__",
        "//src/media:__subpackages__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.hardware.pci:fuchsia.hardware.pci_cpp",
        "//sdk/lib/driver/incoming/cpp",
        "//sdk/lib/driver/mmio/cpp",
        "//zircon/system/ulib/zx",
    ],
)
