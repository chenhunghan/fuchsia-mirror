load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":fake_pdev_rust_tests"],
    visibility = ["//sdk/lib:__pkg__"],
)

# fake_bti links C++, so Rust binaries that link fake_pdev in GN need the C++
# standard library linked dynamically; Bazel's C++ toolchain handles this
# automatically.
# @bazel2gn:raw_attribute:public_configs = [ "//build/config/fuchsia:dynamic_cpp_standard_library" ]
rustc_library(
    name = "rust",
    srcs = ["src/lib.rs"],
    crate_name = "fake_pdev",
    edition = "2024",
    visibility = ["//:__subpackages__"],
    deps = [
        "//sdk/fidl/fuchsia.driver.framework:fuchsia.driver.framework_rust",
        "//sdk/fidl/fuchsia.hardware.platform.device:fuchsia.hardware.platform.device_rust_next",
        "//sdk/fidl/fuchsia.hardware.power:fuchsia.hardware.power_rust_next",
        "//sdk/lib/driver/component/rust",
        "//sdk/lib/driver/fake-bti/rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust_next/fidl_next",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-sync",
    ],
)

# fake-resource and fake_bti are C++, so the GN test binary needs the C++
# standard library linked dynamically.
# @bazel2gn:raw_attribute:configs += [ "//build/config/fuchsia:dynamic_cpp_standard_library" ]
rustc_test(
    name = "fake_pdev_lib_test",
    crate = ":rust",
    link_deps = ["//sdk/lib/driver/fake-resource/cpp"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = ["//src/lib/fuchsia"],
)

fx_unittest_package(
    name = "fake_pdev_rust_tests",
    unit_tests = [":fake_pdev_lib_test"],
)
