load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":fdf-resource-rust-unittests"],
    visibility = ["//sdk/lib:__pkg__"],
)

rustc_library(
    name = "fdf_resource",
    srcs = ["src/lib.rs"],
    edition = "2024",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    visibility = [
        "//src/devices/spi/drivers/dw-spi:__pkg__",
        "//vendor/google:__subpackages__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.hardware.clock:fuchsia.hardware.clock_rust_next",
        "//sdk/fidl/fuchsia.hardware.gpio:fuchsia.hardware.gpio_rust_next",
        "//sdk/fidl/fuchsia.hardware.i2c:fuchsia.hardware.i2c_rust_next",
        "//sdk/fidl/fuchsia.hardware.mailbox:fuchsia.hardware.mailbox_rust_next",
        "//sdk/fidl/fuchsia.hardware.pci:fuchsia.hardware.pci_rust_next",
        "//sdk/fidl/fuchsia.hardware.reset:fuchsia.hardware.reset_rust_next",
        "//sdk/fidl/fuchsia.hardware.spi:fuchsia.hardware.spi_rust_next",
        "//sdk/lib/driver/component/rust",
        "//src/lib/fidl/rust_next/fidl_next",
    ],
)

rustc_test(
    name = "fdf_resource_test",
    crate = ":fdf_resource",
    lint_config = "//build/config/rust/lints:clippy_warn_all",
)

fx_unittest_package(
    name = "fdf-resource-rust-unittests",
    unit_tests = [":fdf_resource_test"],
)
