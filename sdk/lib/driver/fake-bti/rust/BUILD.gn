import("//build/tools/bazel2gn/bazel_migration.gni")

source_set("ffi-bridge") {
  sources = [
    "ffi.cc",
    "ffi.h",
  ]
  deps = [ "//sdk/lib/driver/fake-bti/cpp" ]
  visibility = [ ":*" ]
}

rustc_library("rust") {
  sources = [
    "src/ffi.rs",
    "src/lib.rs",
  ]
  crate_name = "fake_bti"
  edition = "2024"
  link_deps = [ ":ffi-bridge" ]
  visibility = [ "//*" ]
  deps = [
    "//sdk/rust/zx",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:zerocopy",
  ]
  public_configs = [ "//build/config/fuchsia:dynamic_cpp_standard_library" ]
}
if (is_fuchsia) {
  rustc_test("fake_bti_lib_test") {
    sources = [
      "src/ffi.rs",
      "src/lib.rs",
    ]
    edition = "2024"
    link_deps = [ ":ffi-bridge" ]
    deps = [
             "//sdk/rust/zx",
             "//third_party/rust_crates:anyhow",
             "//third_party/rust_crates:zerocopy",
           ] + [ "//src/lib/fuchsia" ]
    configs += [ "//build/config/fuchsia:dynamic_cpp_standard_library" ]
  }
}

fuchsia_unittest_package("fake_bti_rust_tests") {
  package_name = "fake_bti_rust_tests-gn"
  component_name = "fake_bti_rust_tests"
  deps = [ ":fake_bti_lib_test" ]
}
