load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "rust",
    srcs = ["src/lib.rs"],
    crate_name = "fake_clock",
    edition = "2024",
    visibility = ["//:__subpackages__"],
    deps = [
        "//sdk/fidl/fuchsia.driver.framework:fuchsia.driver.framework_rust",
        "//sdk/fidl/fuchsia.hardware.clock:fuchsia.hardware.clock_rust_next",
        "//sdk/lib/driver/component/rust",
        "//sdk/lib/driver/resource-vote/rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust_next/fidl_next",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-sync",
    ],
)

rustc_test(
    name = "driver_fake_clock_lib_test",
    crate = ":rust",
    deps = ["//src/lib/fuchsia"],
)

fx_unittest_package(
    name = "driver_fake_clock_tests",
    unit_tests = [":driver_fake_clock_lib_test"],
    visibility = ["//sdk/lib:__pkg__"],
)
