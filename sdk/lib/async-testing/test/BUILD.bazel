load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")
load("//build/bazel/rules/testing:fx_unittest_component.bzl", "fx_unittest_component")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":async-testing-pkg"],
    visibility = ["//sdk/lib:__pkg__"],
)

_TEST_DEPS = [
    "//sdk/lib/async",
    "//sdk/lib/async:async-cpp",
    "//sdk/lib/async-default",
    "//sdk/lib/async-testing",
    "//sdk/lib/fdio",
    "//sdk/lib/fit",
    "//src/lib/fxl/test:gtest_main",
    "//zircon/system/ulib/zx",
    "@com_google_googletest//:gtest",
]

# Compile and test against all SDK-supported C++ standard versions (C++17,
# C++20, C++23), matching GN `sdk_cpp_test("async-testing")`.
fx_cc_test_binary(
    name = "async-testing-cxx17",
    srcs = ["test_loop_tests.cc"],
    build_flags = ["//build/config:c++17"],
    # Packaged into :async-testing-pkg; do not build bare in wildcard builds.
    tags = ["manual"],
    deps = _TEST_DEPS,
)

fx_cc_test_binary(
    name = "async-testing-cxx20",
    srcs = ["test_loop_tests.cc"],
    build_flags = ["//build/config:c++20"],
    # Packaged into :async-testing-pkg; do not build bare in wildcard builds.
    tags = ["manual"],
    deps = _TEST_DEPS,
)

fx_cc_test_binary(
    name = "async-testing-cxx23",
    srcs = ["test_loop_tests.cc"],
    build_flags = ["//build/config:c++23"],
    # Packaged into :async-testing-pkg; do not build bare in wildcard builds.
    tags = ["manual"],
    deps = _TEST_DEPS,
)

# Preserve the component names generated by GN's `sdk_cpp_unittest_package()`
# so `tests.json` URLs and ResultDB test history remain unchanged.
fx_unittest_component(
    name = "async-testing-cxx17-component",
    binary = ":async-testing-cxx17",
    component_name = "_sdk_cpp_unittest_package.async-testing-pkg.component-cxx17",
)

fx_unittest_component(
    name = "async-testing-cxx20-component",
    binary = ":async-testing-cxx20",
    component_name = "_sdk_cpp_unittest_package.async-testing-pkg.component-cxx20",
)

fx_unittest_component(
    name = "async-testing-cxx23-component",
    binary = ":async-testing-cxx23",
    component_name = "_sdk_cpp_unittest_package.async-testing-pkg.component-cxx23",
)

fx_package(
    name = "async-testing-pkg_package",
    package_name = "async-testing-pkg",
    test_components = [
        ":async-testing-cxx17-component",
        ":async-testing-cxx20-component",
        ":async-testing-cxx23-component",
    ],
)

fx_test(
    name = "async-testing-pkg",
    package = ":async-testing-pkg_package",
)
