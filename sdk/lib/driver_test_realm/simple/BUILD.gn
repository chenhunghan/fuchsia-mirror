import("//build/components.gni")
import("//build/test.gni")
import("//tools/cmc/build/expect_includes.gni")

group("simple") {
  testonly = true
  deps = [
    ":client_includes",
    ":simple_component",
    "//sdk/lib/driver_test_realm:static",
    "//src/devices/misc/drivers/test-parent",
  ]
}

group("tests") {
  testonly = true
  deps = [ ":simple_driver_test_realm_test" ]
}

# Stays in GN because `:simple` depends on
# `//sdk/lib/driver_test_realm:static` and
# `//src/devices/misc/drivers/test-parent`, which have no Bazel build yet.
test("test") {
  output_name = "simple_driver_test_realm_test"
  sources = [ "test.cc" ]
  deps = [
    "//sdk/lib/device-watcher/cpp",
    "//sdk/lib/driver_test_realm/simple",
    "//src/lib/fxl/test:gtest_main",
    "//zircon/system/ulib/fbl",
  ]
}

fuchsia_unittest_package("simple_driver_test_realm_test") {
  deps = [ ":test" ]
}

