// This is a v2 component manifest.
{
    include: [
        "//src/sys/test_runners/gtest/default.shard.cml",
        "inspect/client.shard.cml",
        "syslog/client.shard.cml",
    ],
    program: {
        binary: "bin/inspect_service_llcpp_unittests_bin",
    },
    children: [
        {
            name: "inspector_publisher",
            url: "#meta/program.cm",
        },
        {
            name: "vmo_publisher",
            url: "#meta/program.cm",
        },
    ],
    capabilities: [
        // Enable Inspector publishing on #inspector_publisher while leaving
        // PublishVmo at its default (false).
        {
            config: "fuchsia.inspect.test.PublishInspector",
            type: "bool",
            value: true,
        },

        // Enable VMO publishing on #vmo_publisher while leaving
        // PublishInspector at its default (false).
        {
            config: "fuchsia.inspect.test.PublishVmo",
            type: "bool",
            value: true,
        },
    ],
    use: [
        {
            protocol: "fuchsia.component.Binder",
            from: "#inspector_publisher",
            path: "/svc/InspectorPublisherBinder",
            dependency: "weak",
        },
        {
            protocol: "fuchsia.component.Binder",
            from: "#vmo_publisher",
            path: "/svc/VmoPublisherBinder",
            dependency: "weak",
        },
        { protocol: "fuchsia.diagnostics.ArchiveAccessor" },
    ],
    offer: [
        {
            config: "fuchsia.inspect.test.PublishInspector",
            from: "self",
            to: "#inspector_publisher",
        },
        {
            config: "fuchsia.inspect.test.PublishVmo",
            from: "self",
            to: "#vmo_publisher",
        },
    ],
}
