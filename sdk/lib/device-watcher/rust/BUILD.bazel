load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":device_watcher_tests_package"],
    visibility = ["//sdk/lib:__pkg__"],
)

rustc_library(
    name = "rust",
    srcs = ["src/lib.rs"],
    crate_name = "device_watcher",
    edition = "2024",
    visibility = [
        "//examples/drivers:__subpackages__",
        "//sdk/lib/driver_test_realm/tests:__pkg__",
        "//src/connectivity:__subpackages__",
        "//src/devices:__subpackages__",
        "//src/diagnostics:__subpackages__",
        "//src/media:__subpackages__",
        "//src/power:__subpackages__",
        "//src/security:__subpackages__",
        "//src/starnix:__subpackages__",
        "//src/storage:__subpackages__",
        "//vendor/google:__subpackages__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.device:fuchsia.device_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/rust/zx-status",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-fs",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
    ],
)

rustc_test(
    name = "device_watcher_lib_test",
    crate = ":rust",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//src/lib/fuchsia",
        "//src/storage/lib/vfs/rust:vfs",
    ],
)

fx_unittest_package(
    name = "device_watcher_tests_package",
    package_name = "device_watcher_tests",
    unit_tests = [":device_watcher_lib_test"],
)
