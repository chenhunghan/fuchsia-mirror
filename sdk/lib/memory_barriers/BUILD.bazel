load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/idk:idk_cc_source_library.bzl", "idk_cc_source_library")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

idk_cc_source_library(
    name = "memory_barriers",
    hdrs = ["include/lib/memory_barriers/memory_barriers.h"],
    api_area = "Driver SDK",
    category = "partner",
    idk_name = "memory_barriers",
    public_configs = [":memory_barriers_include"],
    stable = False,
    visibility = [
        "//sdk/lib/driver:__subpackages__",
        "//src/connectivity:__subpackages__",
        "//src/devices:__subpackages__",
        "//src/graphics:__subpackages__",
        "//src/media:__subpackages__",
        "//src/sysmem:__subpackages__",
        "//vendor:__subpackages__",
        "//zircon/third_party/dev:__subpackages__",

        # TODO(https://fxbug.dev/428229472): Once Bazel-defined atoms are used
        # in the production build path, remove this atom from the IDK macro
        # tests and remove the following line.
        "//build/bazel/bazel_idk/tests:__subpackages__",
    ],
)

fx_cc_test_binary(
    name = "memory_barriers_tests",
    srcs = ["memory_barriers_tests.cc"],
    deps = [
        ":memory_barriers",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_package(
    name = "memory_barriers_test_package",
    unit_tests = [":memory_barriers_tests"],
    visibility = ["//sdk/lib:__pkg__"],
)
