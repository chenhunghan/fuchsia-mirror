load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

# test-parity-allow-manual: Fuchsia-only test binary wrapped by :fidl_cpp_formatter_tests (host-compatible deps do not mark it Fuchsia-only on --config=host).
fx_cc_test_binary(
    name = "fidl_cpp_formatter_tests_bin",
    srcs = ["formatter_tests.cc"],
    tags = ["manual"],
    deps = [
        "//sdk/testing/fidl/types_tests:test.types_cpp",
        "//src/lib/fxl/test:gtest_main",
        "@com_google_googletest//:gtest",
    ],
)

fx_unittest_package(
    name = "fidl_cpp_formatter_tests",
    unit_tests = [":fidl_cpp_formatter_tests_bin"],
    visibility = [
        "//sdk/lib:__pkg__",
        "//sdk/lib/fidl/cpp/tests:__pkg__",
    ],
)
