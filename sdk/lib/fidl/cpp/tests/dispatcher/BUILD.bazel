load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

fx_cc_test_binary(
    name = "fidl_cpp_dispatcher_tests_bin",
    srcs = ["client_test.cc"],
    deps = [
        "//sdk/lib/async:async-cpp",
        "//sdk/lib/async-loop",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        "//sdk/lib/fidl/cpp",
        "//src/lib/fidl/llcpp/tests/dispatcher:client_test_helpers",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_package(
    name = "fidl_cpp_dispatcher_tests",
    unit_tests = [":fidl_cpp_dispatcher_tests_bin"],
    visibility = ["//sdk/lib:__pkg__"],
)

# Tests the public API of the unified messaging layer, along with any generated
# bindings code.
fx_cc_test_binary(
    name = "fidl_cpp_messaging_public_api_tests_bin",
    srcs = ["request_response_wrapper_test.cc"],
    deps = [
        "//sdk/lib/fidl/cpp",
        "//sdk/testing/fidl/types_tests:test.types_cpp",
        "//zircon/system/ulib/zxtest",
    ],
)

fx_unittest_package(
    name = "fidl_cpp_messaging_public_api_tests",
    unit_tests = [":fidl_cpp_messaging_public_api_tests_bin"],
    visibility = ["//sdk/lib:__pkg__"],
)
