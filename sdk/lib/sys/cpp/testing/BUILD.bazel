load("//build/bazel/rules/idk:idk_cc_source_library.bzl", "idk_cc_source_library")

package(default_applicable_licenses = ["//:license"])

idk_cc_source_library(
    name = "cpp",
    srcs = [
        "component_context_provider.cc",
        "service_directory_provider.cc",
    ],
    hdrs = [
        "component_context_provider.h",
        "service_directory_provider.h",
    ],
    api_area = "Component Framework",
    category = "partner",
    idk_name = "sys_cpp_testing",
    implementation_deps = [
        "//sdk/lib/fdio",
        "//sdk/lib/vfs/cpp",
    ],
    include_base = "//sdk",
    public_configs = ["//sdk/config"],  # For bazel2gn.
    stable = True,
    # Narrowed to Fuchsia because dependencies (sys_cpp, fdio, vfs_cpp) and Zircon processargs are Fuchsia-only.
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//sdk/fidl/fuchsia.io:fuchsia.io_hlcpp",
        "//sdk/lib/fit",
        "//sdk/lib/sys/cpp",
        "//zircon/system/ulib/zx",
    ],
)
