source_set("cpp") {
  testonly = true
  sources = [ "fuzz_input.cc" ]
  public = [ "fuzz_input.h" ]
  public_configs = [ "//sdk/config" ]
}

source_set("traits") {
  testonly = true
  public = [ "traits.h" ]
  public_configs = [ "//sdk/config" ]
  public_deps = [
    ":cpp",
    "//sdk/lib/fidl/hlcpp",
    "//zircon/system/ulib/zx",
  ]
}

cc_test_executable("fuzzing_traits_unittests") {
  sources = [ "traits_unittest.cc" ]
  deps = [
    ":traits",
    "//src/lib/fxl/test:gtest_main",
  ]
  deps += [ "//src/sys/test_runners/gtest:death_test" ]
  testonly = true
  emit_tool_path = false
}

fuchsia_unittest_package("fuzzing_traits_tests") {
  package_name = "fuzzing_traits_tests-gn"
  component_name = "fuzzing_traits_tests"
  deps = [ ":fuzzing_traits_unittests" ]
}
