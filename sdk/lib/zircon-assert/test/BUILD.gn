import("//build/testing/bootfs_test.gni")
import("//build/testing/host_test.gni")

group("test") {
  testonly = true
  deps = [ ":tests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":zircon-assert-tests",
    ":zircon-assert-unittests_host_test($host_toolchain)",
  ]
}

if (is_host) {
  host_test("zircon-assert-unittests_host_test") {
    binary_path = "$root_out_dir/zircon-assert-unittests"
    target = get_label_info(":zircon-assert-unittests", "label_with_toolchain")
    deps = [ ":zircon-assert-unittests" ]
  }
}

# bootfs_test() cannot be expressed in Bazel yet.
bootfs_test("zircon-assert-bootfs-test") {
  name = "zircon-assert-unittests"
  deps = [ ":zircon-assert-unittests" ]
}

