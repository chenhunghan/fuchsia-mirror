import("//build/tools/bazel2gn/bazel_migration.gni")

cc_test_executable("zircon-assert-unittests") {
  sources = [ "zircon-assert-tests.cc" ]
  deps = [
    "//sdk/lib/zircon-assert",
    "//src/lib/fxl/test:gtest_main",
    "//third_party/googletest:gmock",
  ]
  deps += [ "//src/sys/test_runners/gtest:death_test" ]
  testonly = true
  emit_tool_path = false
  metadata = {
    distribution_entries = [
      {
        source =
            rebase_path("$root_out_dir/zircon-assert-unittests", root_build_dir)
        destination = "test/zircon-assert-unittests"
        label =
            get_label_info(":zircon-assert-unittests", "label_with_toolchain")
      },
    ]
    test_component_manifest_program = [
      {
        program = {
          binary = "test/zircon-assert-unittests"
        }
      },
    ]
    test_component_manifest_program_barrier = []
  }
}

fuchsia_unittest_package("zircon-assert-tests") {
  package_name = "zircon-assert-tests-gn"
  component_name = "zircon-assert-tests"
  deps = [ ":zircon-assert-unittests" ]
}
