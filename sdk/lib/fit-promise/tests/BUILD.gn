import("//build/tools/bazel2gn/bazel_migration.gni")

cc_test_executable("fit-promise-tests") {
  sources = [
    "barrier_tests.cc",
    "bridge_tests.cc",
    "examples/promise_example1.cc",
    "examples/promise_example1.h",
    "examples/promise_example2.cc",
    "examples/promise_example2.h",
    "examples/utils.cc",
    "examples/utils.h",
    "future_tests.cc",
    "pending_task_tests.cc",
    "promise_examples.cc",
    "promise_tests.cc",
    "result_examples.cc",
    "result_tests.cc",
    "scheduler_tests.cc",
    "scope_tests.cc",
    "sequencer_tests.cc",
    "single_threaded_executor_tests.cc",
    "suspended_task_tests.cc",
    "unittest_utils.h",
  ]
  configs += [ "//build/config:test_exercising_sdk_headers" ]
  deps = []
  deps += [
    "//sdk/lib/fit-promise",
    "//zircon/system/ulib/zxtest",
  ]
  if (is_fuchsia) {
    deps += [ "//sdk/lib/fdio" ]
  }
  testonly = true
  emit_tool_path = false
}

fuchsia_unittest_package("fit-promise-test-pkg") {
  package_name = "fit-promise-tests-gn"
  component_name = "fit-promise-tests"
  deps = [ ":fit-promise-tests" ]
}
