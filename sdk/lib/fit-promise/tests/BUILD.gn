import("//build/testing/host_test.gni")

if (is_host) {
  host_test("fit-promise-tests_host_test") {
    binary_path = "$root_out_dir/fit-promise-tests"
    target = get_label_info(":fit-promise-tests", "label_with_toolchain")
    deps = [ ":fit-promise-tests" ]
  }
}

group("tests") {
  testonly = true
  deps = [
    ":fit-promise-test-pkg",
    ":fit-promise-tests_host_test($host_toolchain)",
  ]
}

