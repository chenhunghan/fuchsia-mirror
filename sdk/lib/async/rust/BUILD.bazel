load("//build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":libasync_tests"],
    visibility = ["//sdk/lib:__pkg__"],
)

rustc_library(
    name = "rust",
    srcs = [
        "src/after_deadline.rs",
        "src/callback_state.rs",
        "src/lib.rs",
        "src/on_interrupt.rs",
        "src/on_signals.rs",
    ],
    crate_name = "libasync",
    edition = "2024",
    link_deps = ["//sdk/lib/async"],
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    version = "0.1.0",
    visibility = [
        "//sdk/lib/async:__subpackages__",
        "//sdk/lib/driver:__subpackages__",
        "//src/devices/bin/driver-host:__subpackages__",
        "//src/lib/trace/rust:__subpackages__",
        "//src/ui/lib/input_pipeline:__subpackages__",
        "//vendor:__subpackages__",
    ],
    deps = [
        "//sdk/lib/async/rust/dispatcher",
        "//sdk/lib/async/rust/sys",
        "//sdk/rust/zx",
        "//third_party/rust_crates/vendor:futures",
    ],
)

rustc_test(
    name = "rust_test",
    crate = ":rust",
    # Match the original GN output_name ("libasync_lib_test").
    crate_name = "libasync_lib_test",
    # In GN, //sdk/lib/driver/runtime/rust/env transitively provides
    # //src/devices/bin/driver_runtime via link_deps; in Bazel it uses the
    # system-provided stub //src/devices/lib/driver:driver_runtime.
    # @bazel2gn:skip
    link_deps = ["//src/devices/bin/driver_runtime"],
    lint_config = "//build/config/rust/lints:clippy_warn_all",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = ["//sdk/lib/driver/runtime/rust/env"],
)

fx_unittest_package(
    name = "libasync_tests",
    unit_tests = [":rust_test"],
)
