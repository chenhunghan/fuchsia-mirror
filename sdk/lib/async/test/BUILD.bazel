load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")
load("//build/bazel/rules/testing:fx_unittest_component.bzl", "fx_unittest_component")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":async-test-pkg"],
    visibility = ["//sdk/lib:__pkg__"],
)

_TEST_SRCS = [
    "default_tests.cc",
    "dispatcher_tests.cc",
    "executor_tests.cc",
    "irq_tests.cc",
    "paged_vmo_tests.cc",
    "receiver_tests.cc",
    "sequence_checker_tests.cc",
    "sequence_id_tests.cc",
    "task_tests.cc",
    "time_tests.cc",
    "trap_tests.cc",
    "wait_tests.cc",
]

_TEST_DEPS = [
    "//sdk/lib/async",
    "//sdk/lib/async:async-cpp",
    "//sdk/lib/async-default",
    "//sdk/lib/async-loop:async-loop-cpp",
    "//sdk/lib/async-loop:async-loop-default",
    "//sdk/lib/async-testing",
    "//sdk/lib/fdio",
    "//sdk/lib/fit",
    "//src/lib/fxl/test:gtest_main",
    "//zircon/system/ulib/zx",
    "@com_google_googletest//:gtest",
]

# Compile and test against all SDK-supported C++ standard versions (C++17,
# C++20, C++23), matching GN `sdk_cpp_test("async")`.
# `//src/sys/test_runners/gtest:death_test` adds `fuchsia.process.Launcher` to
# the generated component manifest for ASSERT_DEATH tests, replacing the GN
# `include-process-launcher` metadata group.
fx_cc_test_binary(
    name = "async-cxx17",
    srcs = _TEST_SRCS,
    aspect_hints = ["//src/sys/test_runners/gtest:death_test"],
    build_flags = ["//build/config:c++17"],
    deps = _TEST_DEPS,
)

fx_cc_test_binary(
    name = "async-cxx20",
    srcs = _TEST_SRCS,
    aspect_hints = ["//src/sys/test_runners/gtest:death_test"],
    build_flags = ["//build/config:c++20"],
    deps = _TEST_DEPS,
)

fx_cc_test_binary(
    name = "async-cxx23",
    srcs = _TEST_SRCS,
    aspect_hints = ["//src/sys/test_runners/gtest:death_test"],
    build_flags = ["//build/config:c++23"],
    deps = _TEST_DEPS,
)

# Preserve the component names generated by GN's `sdk_cpp_unittest_package()`
# so `tests.json` URLs and ResultDB test history remain unchanged.
fx_unittest_component(
    name = "async-cxx17-component",
    binary = ":async-cxx17",
    component_name = "_sdk_cpp_unittest_package.async-test-pkg.component-cxx17",
)

fx_unittest_component(
    name = "async-cxx20-component",
    binary = ":async-cxx20",
    component_name = "_sdk_cpp_unittest_package.async-test-pkg.component-cxx20",
)

fx_unittest_component(
    name = "async-cxx23-component",
    binary = ":async-cxx23",
    component_name = "_sdk_cpp_unittest_package.async-test-pkg.component-cxx23",
)

fx_package(
    name = "async-test-pkg_package",
    package_name = "async-test-pkg",
    test_components = [
        ":async-cxx17-component",
        ":async-cxx20-component",
        ":async-cxx23-component",
    ],
)

fx_test(
    name = "async-test-pkg",
    package = ":async-test-pkg_package",
)
