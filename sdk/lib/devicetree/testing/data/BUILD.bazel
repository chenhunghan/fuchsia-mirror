# Provides relative path from the executable to the repository directory.
# The expected path is platform specific.
# LINT.IfChange(data_path)
# @bazel2gn:skip
build_flags(
    name = "data_path",
    defines = select({
        "@platforms//os:fuchsia": ['LIB_DEVICETREE_DATA="data"'],
        "//conditions:default": ['LIB_DEVICETREE_DATA="test_data/devicetree"'],
    }),
    visibility = ["//sdk/lib/devicetree/testing:__pkg__"],
)
# LINT.ThenChange(BUILD.gn:data_path)

