{
    program: {
        runner: "elf",
        binary: "bin/to_configure",
    },

    // [START config]
    use: [
        {
            config: "fuchsia.example.EnableFoo",
            key: "enable_foo",
            type: "bool",
            availability: "transitional",
            default: false,
        },
    ],

    // [END config]
}
