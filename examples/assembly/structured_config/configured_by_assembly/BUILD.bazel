load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "bin",
    srcs = ["src/main.rs"],
    binary_name = "to_configure",
    edition = "2024",
)

fx_packaged_binary(
    name = "bin_packaged",
    binary = ":bin",
    binary_name = "to_configure",
)

fx_component_manifest(
    name = "to_configure_manifest",
    component_name = "to_configure",
    manifest = "meta/to_configure.cml",
)

fx_component(
    name = "to_configure",
    compiled_manifest = ":to_configure_manifest",
    deps = [":bin_packaged"],
)
