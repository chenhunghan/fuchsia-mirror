load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":rust-shared"],
    visibility = ["//examples/rust/dylib:__pkg__"],
)

rustc_test(
    name = "rust-bin",
    srcs = ["src/lib.rs"],
    edition = "2024",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//examples/rust/dylib/rust-shared",
        "//src/lib/fuchsia",
    ],
)

fx_unittest_package(
    name = "rust-shared",
    unit_tests = [":rust-bin"],
)
