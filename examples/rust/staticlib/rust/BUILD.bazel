load("@rules_rust//rust:rust_static_library.bzl", "rust_static_library")
load("//build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")

package(default_applicable_licenses = ["//:license"])

# C/C++ consumers use the header through `:crust_headers`.
rust_static_library(
    name = "crust",
    srcs = ["src/lib.rs"],
    crate_name = "crust_rust",
    edition = "2024",
)

fx_cc_library(
    name = "crust_headers",
    hdrs = ["crust.h"],
    visibility = ["//examples/rust/staticlib:__pkg__"],
    deps = [":crust"],
)
