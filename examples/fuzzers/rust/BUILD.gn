import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_library("helper") {
  sources = [ "helper/lib.rs" ]
  source_root = "helper/lib.rs"
  edition = "2024"
  proc_macro_deps = [ "//src/lib/fuzzing/rust:fuzz" ]
}

rustc_binary("toy_example_bin") {
  sources = [ "src/main.rs" ]
  output_name = "toy_example"
  edition = "2024"
  proc_macro_deps = [ "//src/lib/fuzzing/rust:fuzz" ]
  deps = [ ":helper" ]
}
