# NOTE: The comments that have [START/END ...] in them are used to identify code
# snippets that appear in the documentation. Please be aware that changes in
# these blocks will affect the
# documentation on fuchsia.dev.

load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load(
    "//build/bazel/rules/testing:fx_unittest_package.bzl",
    "fx_unittest_package",
)

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":hello-world-rust-tests"],
    visibility = ["//examples/hello_world:__pkg__"],
)

# [START rustc_tests]
# Generates the "bin_test" build target
rustc_binary(
    name = "bin",
    srcs = ["src/main.rs"],
    binary_name = "hello_world_rust",
    edition = "2024",
    tags = ["manual"],
)

# Needs reviewer attention (bazel2gn skip): packaged in Bazel via fx_unittest_package and wrapped in GN via bazel_fuchsia_package("hello-world-rust-tests") so honeydew package_deps resolves fuchsia-pkg://fuchsia.com/hello-world-rust-tests instead of a -gn duplicate.
# @bazel2gn:skip
rustc_test(
    name = "hello_world_rust_bin_test",
    crate = ":bin",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = ["//src/lib/fuchsia"],
)

# [END rustc_tests]

# [START fuchsia_component]
fx_packaged_binary(
    name = "bin_packaged",
    binary = ":bin",
    binary_name = "hello_world_rust",
)

fx_component_manifest(
    name = "hello-world-rust-manifest",
    # Defines the name given to the manifest when included in a fuchsia package.
    # In this case: "hello-world-rust.cm"
    component_name = "hello-world-rust",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/hello_world_rust.cml",
)

fx_component(
    name = "hello-world-rust-component",
    compiled_manifest = ":hello-world-rust-manifest",
    visibility = [
        "//src/sys/component_manager:__pkg__",
        "//src/sys/lib/elf_runner:__pkg__",
    ],
    deps = [":bin_packaged"],
)

fx_package(
    name = "hello-world-rust",
    components = [
        # component-url:
        # fuchsia-pkg://fuchsia.com/hello-world-rust#meta/hello-world-rust.cm
        ":hello-world-rust-component",
    ],
    visibility = ["//examples/hello_world:__pkg__"],
)

# [END fuchsia_component]

# [START fuchsia_test]
# Needs reviewer attention (bazel2gn skip): wrapped in GN via bazel_fuchsia_package("hello-world-rust-tests") so honeydew package_deps resolves fuchsia-pkg://fuchsia.com/hello-world-rust-tests instead of a -gn duplicate.
# @bazel2gn:skip
fx_unittest_package(
    name = "hello-world-rust-tests",
    unit_tests = [":hello_world_rust_bin_test"],
)
# [END fuchsia_test]
