import("//build/bazel/bazel_fuchsia_package.gni")

group("hermetic_tests") {
  testonly = true

  deps = [ ":hello-world-rust-tests" ]
}

bazel_fuchsia_package("hello-world-rust") {
  bazel_config = "fuchsia_platform"
}

bazel_fuchsia_package("hello-world-rust-tests") {
  testonly = true
  bazel_config = "fuchsia_platform"
  bazel_target = ":hello-world-rust-tests.package"
}

