import("//build/tools/bazel2gn/bazel_migration.gni")

rustc_binary("bin") {
  sources = [ "src/main.rs" ]
  output_name = "hello_world_rust"
  edition = "2024"
}

fuchsia_component_manifest("hello-world-rust-manifest") {
  component_name = "hello-world-rust"
  manifest = "meta/hello_world_rust.cml"
}

fuchsia_component("hello-world-rust-component") {
  cm_label = ":hello-world-rust-manifest"
  visibility = [
    ":*",
    "//src/sys/component_manager:*",
    "//src/sys/lib/elf_runner:*",
  ]
  deps = [ ":bin" ]
}
