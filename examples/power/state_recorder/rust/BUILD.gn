import("//build/bazel/bazel_fuchsia_package.gni")

# //examples/power/state_recorder still builds this package from GN.
bazel_fuchsia_package("package") {
  bazel_config = "fuchsia_platform"
  package_name = "state_recorder_rust_example"
}

group("rust") {
  testonly = true
  deps = [ ":package" ]
}
