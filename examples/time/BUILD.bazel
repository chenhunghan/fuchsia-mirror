load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")

package(default_applicable_licenses = ["//:license"])

# Package bundling the C, C++, and Rust time example components.
fx_package(
    name = "time-examples",
    components = [
        "//examples/time/c:c-time-example-component",
        "//examples/time/cpp:cpp-time-example-component",
        "//examples/time/rust:rust-time-example-component",
    ],
)
