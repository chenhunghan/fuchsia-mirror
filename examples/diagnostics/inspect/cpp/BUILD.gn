assert(is_fuchsia, "These targets are only compiled in the fuchsia toolchain.")

import("//build/bazel/bazel_fuchsia_package.gni")
import("//build/components.gni")

group("cpp") {
  testonly = true
  public_deps = [
    ":hermetic_tests",
    ":inspect-example-cpp",
  ]
}

group("hermetic_tests") {
  testonly = true
  public_deps = [ ":inspect-example-cpp-tests" ]
}

bazel_fuchsia_package("inspect-example-cpp") {
  bazel_config = "fuchsia_platform"
}

# Blocked on migrating //sdk/lib/inspect/testing/cpp to platform Bazel.
executable("test_bin") {
  testonly = true
  output_name = "example_test_bin"
  sources = [ "example_unittests.cc" ]
  deps = [
    ":lib",
    "//sdk/lib/async_patterns/testing/cpp",
    "//sdk/lib/inspect/testing/cpp",
    "//src/lib/fxl/test:gtest_main",
    "//src/lib/testing/loop_fixture",
  ]
}

fuchsia_unittest_package("inspect-example-cpp-tests") {
  deps = [ ":test_bin" ]
}

