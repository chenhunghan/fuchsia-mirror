        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/client_part_4.cml",
)

fx_component(
    name = "client_part_4",
    compiled_manifest = ":client_part_4_manifest",
    visibility = ["//examples/diagnostics/inspect/codelab/rust:__pkg__"],
    deps = [":bin.packaged"],
)

fx_component_manifest(
    name = "client_part_5_manifest",
    component_name = "client_part_5",
    includes = [
        "meta/common.shard.cml",
