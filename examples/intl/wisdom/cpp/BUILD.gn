import("//build/components.gni")

group("cpp") {
  deps = [ ":intl_wisdom" ]
}

group("tests") {
  testonly = true
  deps = [ ":cpp" ]
}

fuchsia_package("intl_wisdom") {
  deps = [
    ":intl_wisdom_client_cpp",
    ":intl_wisdom_server_cpp",
    "//examples/intl/wisdom:intl_wisdom_realm",
    "//src/intl:icudtl",
  ]
}

