# [START imports]
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

# [END imports]

package(default_applicable_licenses = ["//:license"])

# [START server]
rustc_binary(
    name = "bin",
    srcs = ["src/main.rs"],
    binary_name = "fidl_echo_rust_server",
    edition = "2024",
    tags = ["manual"],
    deps = [
        "//examples/fidl/fuchsia.examples:fuchsia.examples_rust",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
    ],
)

# [END server]

fx_packaged_binary(
    name = "bin_packaged_bin",
    binary = ":bin",
    binary_name = "fidl_echo_rust_server",
)

# [START rest]
# Declare a component for the server, which consists of the manifest and the
# binary that the component will run.
fx_component_manifest(
    name = "echo-server_manifest",
    component_name = "echo_server",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/server.cml",
)

fx_component(
    name = "echo-server",
    compiled_manifest = ":echo-server_manifest",
    visibility = [
        "//examples/fidl/echo-realm:__pkg__",
        "//examples/fidl/rust:__pkg__",
    ],
    deps = [":bin_packaged_bin"],
)

# Declare a package that contains a single component, our server.
fx_package(
    name = "echo-rust-server",
    components = [":echo-server"],
    visibility = ["//examples/fidl/rust:__pkg__"],
)
# [END rest]
