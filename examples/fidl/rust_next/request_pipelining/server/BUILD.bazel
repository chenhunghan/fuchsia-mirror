load("//build/bazel/rules/components:fx_component.bzl", "fx_component", "fx_component_manifest")
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "bin",
    srcs = ["src/main.rs"],
    # Preserve the GN output_name expected by meta/server.cml.
    binary_name = "fidl_echo_launcher_rust_next_server",
    edition = "2024",
    tags = ["manual"],
    deps = [
        # Generated by fidl_rust_next_library in //examples/fidl/fuchsia.examples.
        "//examples/fidl/fuchsia.examples:fuchsia.examples_rust_next",
        "//src/lib/diagnostics/inspect/runtime/rust",
        "//src/lib/diagnostics/inspect/rust",
        "//src/lib/fidl/rust_next/fidl_next",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)

fx_packaged_binary(
    name = "bin_packaged_bin",
    binary = ":bin",
    binary_name = "fidl_echo_launcher_rust_next_server",
)

fx_component_manifest(
    name = "echo-server_manifest",
    component_name = "echo_server",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/syslog:client.shard",
    ],
    manifest = "meta/server.cml",
)

fx_component(
    name = "echo-server",
    compiled_manifest = ":echo-server_manifest",
    visibility = [
        "//examples/fidl/echo-realm:__pkg__",
        "//examples/fidl/rust_next/request_pipelining:__pkg__",
    ],
    deps = [":bin_packaged_bin"],
)
