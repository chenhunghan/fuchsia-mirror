load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load(
    "//build/bazel/rules/testing:fx_unittest_package.bzl",
    "fx_unittest_package",
)

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "bin",
    srcs = ["src/main.rs"],
    binary_name = "fidl_echo_rust_next_service_server",
    edition = "2024",
    tags = ["manual"],
    deps = [
        "//examples/fidl/fuchsia.examples:fuchsia.examples_rust_next",
        "//src/lib/fidl/rust_next/fidl_next",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
    ],
)

rustc_test(
    name = "bin_test",
    crate = ":bin",
    edition = "2024",
    tags = ["manual"],
)

fx_packaged_binary(
    name = "bin_packaged_bin",
    binary = ":bin",
    binary_name = "fidl_echo_rust_next_service_server",
)

fx_component_manifest(
    name = "echo-server_manifest",
    component_name = "echo_server",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/server.cml",
)

fx_component(
    name = "echo-server",
    compiled_manifest = ":echo-server_manifest",
    visibility = [
        "//examples/fidl/echo-realm:__pkg__",
        "//examples/fidl/rust_next:__pkg__",
    ],
    deps = [":bin_packaged_bin"],
)

fx_unittest_package(
    name = "echo-server-rust-next-unittests",
    unit_tests = [":bin_test"],
    visibility = ["//examples/fidl/rust_next:__pkg__"],
)
