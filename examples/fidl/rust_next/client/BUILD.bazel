load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "bin",
    srcs = ["src/main.rs"],
    binary_name = "fidl_echo_rust_client_next",
    edition = "2024",
    tags = ["manual"],
    deps = [
        "//examples/fidl/fuchsia.examples:fuchsia.examples_rust_next",
        "//src/lib/fidl/rust_next/fidl_next",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//third_party/rust_crates/vendor:anyhow",
    ],
)

fx_packaged_binary(
    name = "bin_packaged_bin",
    binary = ":bin",
    binary_name = "fidl_echo_rust_client_next",
)

fx_component_manifest(
    name = "echo-client_manifest",
    component_name = "echo_client",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/client.cml",
)

fx_component(
    name = "echo-client",
    compiled_manifest = ":echo-client_manifest",
    visibility = [
        "//examples/fidl/echo-realm:__pkg__",
        "//examples/fidl/rust_next:__pkg__",
    ],
    deps = [":bin_packaged_bin"],
)
