load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load("//build/bazel/rules/components:fx_component.bzl", "fx_component", "fx_component_manifest")
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")

package(default_applicable_licenses = ["//:license"])

fx_cc_binary(
    name = "bin",
    srcs = ["main.cc"],
    gn_output_name = "calculator_server_cpp",
    tags = ["manual"],
    deps = [
        # This is the FIDL Calculator protocol we're implementing
        "//examples/fidl/calculator/fidl:calculator_cpp",

        # This library provides an the asynchronous event loop implementation.
        "//sdk/lib/async-loop:async-loop-cpp",

        # This library is used to publish capabilities, e.g. protocols,
        # to the component's outgoing directory.
        "//sdk/lib/component/outgoing/cpp",

        # This library is used to log messages.
        "//sdk/lib/syslog/cpp",
    ],
)

fx_packaged_binary(
    name = "bin_packaged_bin",
    binary = ":bin",
    binary_name = "calculator_server_cpp",
)

fx_component_manifest(
    name = "component-manifest",
    component_name = "server",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/server.cml",
)

fx_component(
    name = "component",
    compiled_manifest = ":component-manifest",
    visibility = ["//examples/fidl/calculator:__subpackages__"],
    deps = [":bin_packaged_bin"],
)
