load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":examples_fidl_canvas_clientrequesteddraw_rust_next_tests"],
    visibility = ["//examples/fidl/new/canvas/client_requested_draw:__pkg__"],
)

fx_packaged_binary(
    name = "runner_bin_packaged",
    testonly = True,
    binary = "//examples/fidl/new/canvas/client_requested_draw/test:runner_bin",
    binary_name = "runner_bin",
)

fx_component_manifest(
    name = "test_manifest",
    testonly = True,
    component_name = "test",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/sys/component:realm_builder.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "//examples/fidl/new/canvas/client_requested_draw/test:meta/runner.cml",
)

fx_test_component(
    name = "test",
    compiled_manifest = ":test_manifest",
    deps = [
        ":runner_bin_packaged",
        "//examples/fidl/new/canvas/client_requested_draw/test/goldens:resources",
    ],
)

fx_package(
    name = "examples_fidl_canvas_clientrequesteddraw_rust_next_tests_pkg",
    package_name = "examples_fidl_canvas_clientrequesteddraw_rust_next_tests",
    testonly = True,
    components = [
        "//examples/fidl/new/canvas/client_requested_draw/rust_next/client",
        "//examples/fidl/new/canvas/client_requested_draw/rust_next/server",
        "//examples/fidl/new/canvas/client_requested_draw/realm",
        "//src/lib/fuchsia-component-test/realm_builder_server:realm_builder_server_component",
    ],
    test_components = [":test"],
)

fx_test(
    name = "examples_fidl_canvas_clientrequesteddraw_rust_next_tests",
    package = ":examples_fidl_canvas_clientrequesteddraw_rust_next_tests_pkg",
)
