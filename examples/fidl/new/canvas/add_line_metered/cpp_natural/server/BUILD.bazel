load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")

package(default_applicable_licenses = ["//:license"])

fx_cc_binary(
    name = "bin",
    srcs = ["main.cc"],
    # main.cc uses angled `#include <src/lib/fxl/...>` headers, which GN
    # resolves via `//build/config:default_include_dirs` (`-I//`), whereas
    # Bazel defaults to `-iquote .`.
    # TODO(https://fxbug.dev/570694755): Replace angled `src/lib/fxl` includes
    # in `main.cc` with quoted includes in a source cleanup CL.
    copts = ["-I."],
    gn_output_name = "server_bin",
    visibility = ["//examples/fidl/new/canvas/add_line_metered/cpp_natural:__pkg__"],
    deps = [
        "//examples/fidl/new/canvas/add_line_metered/fidl:examples.canvas.addlinemetered_cpp",
        "//sdk/lib/async-loop",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/component/outgoing/cpp",
        "//sdk/lib/fdio",
        "//sdk/lib/sys/cpp",
        "//sdk/lib/syslog/cpp",
        "//src/lib/fxl",
    ],
)
