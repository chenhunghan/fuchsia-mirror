load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

# GN puts the binary in a per-target directory so the `server_bin` outputs
# of the sibling canvas examples don't collide.
# @bazel2gn:raw_attribute:output_dir = target_out_dir + "/rust"
rustc_binary(
    name = "bin",
    srcs = ["src/main.rs"],
    crate_name = "server_bin",
    edition = "2024",
    visibility = ["//examples/fidl/new/canvas/add_line_metered/rust:__pkg__"],
    deps = [
        "//examples/fidl/new/canvas/add_line_metered/fidl:examples.canvas.addlinemetered_rust",
        "//sdk/rust/zx",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-async",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-sync",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
    ],
)
