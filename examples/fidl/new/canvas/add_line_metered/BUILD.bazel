load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
)

package(default_applicable_licenses = ["//:license"])

exports_files(
    [
        "meta/client.cml",
        "meta/server.cml",
    ],
    visibility = ["//examples/fidl/new/canvas/add_line_metered:__subpackages__"],
)

fx_component_manifest(
    name = "client_manifest",
    component_name = "canvas_addlinemetered_client",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/client.cml",
)

filegroup(
    name = "all",
    testonly = True,
    srcs = [
        ":client_manifest",
        "//examples/fidl/new/canvas/add_line_metered/cpp_natural:examples_fidl_canvas_addlinemetered_cpp_natural",
        "//examples/fidl/new/canvas/add_line_metered/cpp_wire:examples_fidl_canvas_addlinemetered_cpp",
        "//examples/fidl/new/canvas/add_line_metered/rust:examples_fidl_canvas_addlinemetered_rust",
    ],
    visibility = ["//examples/fidl/new/canvas:__pkg__"],
)

test_suite(
    name = "hermetic_tests",
    tests = [
        "//examples/fidl/new/canvas/add_line_metered/cpp_natural:tests",
        "//examples/fidl/new/canvas/add_line_metered/cpp_wire:tests",
        "//examples/fidl/new/canvas/add_line_metered/rust:tests",
        "//examples/fidl/new/canvas/add_line_metered/rust_next:tests",
    ],
    visibility = ["//examples/fidl/new/canvas:__pkg__"],
)
