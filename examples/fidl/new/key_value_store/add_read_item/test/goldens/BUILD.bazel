load(
    "//build/bazel/rules/packages:resources.bzl",
    "fuchsia_package_resource_collection",
    "resource",
)

package(default_applicable_licenses = ["//:license"])

resource(
    name = "test_read_item_success_client",
    srcs = ["test_read_item_success_client.log.golden"],
    outputs = ["data/goldens/{{source_file_part}}"],
)

resource(
    name = "test_read_item_success_server",
    srcs = ["test_read_item_success_server.log.golden"],
    outputs = ["data/goldens/{{source_file_part}}"],
)

resource(
    name = "test_read_item_error_client",
    srcs = ["test_read_item_error_client.log.golden"],
    outputs = ["data/goldens/{{source_file_part}}"],
)

resource(
    name = "test_read_item_error_server",
    srcs = ["test_read_item_error_server.log.golden"],
    outputs = ["data/goldens/{{source_file_part}}"],
)

# These are files that are meant to be included with our test component. Each
# file represents a golden from a single process for a single test.
fuchsia_package_resource_collection(
    name = "resources",
    resources = [
        ":test_read_item_error_client",
        ":test_read_item_error_server",
        ":test_read_item_success_client",
        ":test_read_item_success_server",
    ],
    visibility = [
        "//examples/fidl/new/key_value_store/add_read_item/rust:__pkg__",
        "//examples/fidl/new/key_value_store/add_read_item/rust_next:__pkg__",
    ],
)
