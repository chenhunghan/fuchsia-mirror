{
    include: [ "syslog/client.shard.cml" ],
    program: {
        runner: "elf",
        binary: "bin/client_bin",
    },
    use: [
        { protocol: "examples.keyvaluestore.addreaditem.Store" },
        {
            config: "fuchsia.examples.keyvaluestore.addreaditem.WriteItems",
            key: "write_items",
            type: "vector",
            max_count: 16,
            element: {
                type: "string",
                max_size: 64,
            },
            availability: "transitional",
            default: [
                "verse_1",
                "verse_2",
                "verse_3",
                "verse_4",
            ],
        },

        // [START diff_1]
        {
            config: "fuchsia.examples.keyvaluestore.addreaditem.ReadItems",
            key: "read_items",
            type: "vector",
            max_count: 16,
            element: {
                type: "string",
                max_size: 64,
            },
            availability: "transitional",
            default: [],
        },

        // [END diff_1]
    ],
}
