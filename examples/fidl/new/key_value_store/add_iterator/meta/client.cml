{
    include: [ "syslog/client.shard.cml" ],
    program: {
        runner: "elf",
        binary: "bin/client_bin",
    },
    use: [
        { protocol: "examples.keyvaluestore.additerator.Store" },
        {
            config: "fuchsia.examples.keyvaluestore.additerator.WriteItems",
            key: "write_items",
            type: "vector",
            max_count: 16,
            element: {
                type: "string",
                max_size: 64,
            },
            availability: "transitional",
            default: [],
        },

        // [START diff_1]
        // A key to iterate from, after all items in `write_items` have been written.
        {
            config: "fuchsia.examples.keyvaluestore.additerator.IterateFrom",
            key: "iterate_from",
            type: "string",
            max_size: 64,
            availability: "transitional",
            default: "",
        },

        // [END diff_1]
    ],
}
