load(
    "//build/bazel/rules/packages:resources.bzl",
    "fuchsia_package_resource_collection",
    "resource",
)

package(default_applicable_licenses = ["//:license"])

resource(
    name = "test_export_empty_error_client",
    srcs = ["test_export_empty_error_client.log.golden"],
    outputs = ["data/goldens/{{source_file_part}}"],
)

resource(
    name = "test_export_empty_error_server",
    srcs = ["test_export_empty_error_server.log.golden"],
    outputs = ["data/goldens/{{source_file_part}}"],
)

resource(
    name = "test_export_storage_too_small_error_client",
    srcs = ["test_export_storage_too_small_error_client.log.golden"],
    outputs = ["data/goldens/{{source_file_part}}"],
)

resource(
    name = "test_export_storage_too_small_error_server",
    srcs = ["test_export_storage_too_small_error_server.log.golden"],
    outputs = ["data/goldens/{{source_file_part}}"],
)

resource(
    name = "test_export_success_client",
    srcs = ["test_export_success_client.log.golden"],
    outputs = ["data/goldens/{{source_file_part}}"],
)

resource(
    name = "test_export_success_server",
    srcs = ["test_export_success_server.log.golden"],
    outputs = ["data/goldens/{{source_file_part}}"],
)

# These are files that are meant to be included with our test component. Each
# file represents a golden from a single process for a single test.
fuchsia_package_resource_collection(
    name = "resources",
    resources = [
        ":test_export_empty_error_client",
        ":test_export_empty_error_server",
        ":test_export_storage_too_small_error_client",
        ":test_export_storage_too_small_error_server",
        ":test_export_success_client",
        ":test_export_success_server",
    ],
    visibility = [
        "//examples/fidl/new/key_value_store/support_exports/cpp_natural:__pkg__",
        "//examples/fidl/new/key_value_store/support_exports/cpp_wire:__pkg__",
        "//examples/fidl/new/key_value_store/support_exports/rust:__pkg__",
        "//examples/fidl/new/key_value_store/support_exports/rust_next:__pkg__",
    ],
)
