load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
)

package(default_applicable_licenses = ["//:license"])

exports_files(
    [
        "meta/client.cml",
        "meta/server.cml",
    ],
    visibility = ["//examples/fidl/new:__subpackages__"],
)

# Generate the manifest for the client component.
fx_component_manifest(
    name = "client_manifest",
    component_name = "calculator_baseline_client",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/client.cml",
    visibility = ["//examples/fidl/new:__subpackages__"],
)
