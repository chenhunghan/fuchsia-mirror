load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

# Realm component used to launch FIDL examples
fx_component_manifest(
    name = "echo_realm_manifest",
    component_name = "echo_realm",
    manifest = "meta/echo_realm.cml",
)

fx_component(
    name = "echo_realm",
    compiled_manifest = ":echo_realm_manifest",
    visibility = ["//examples/fidl:__subpackages__"],
)

# Integration testing components for FIDL examples
rustc_test(
    name = "bin",
    srcs = ["src/lib.rs"],
    crate_name = "fidl_examples_integration",
    edition = "2024",
    tags = ["manual"],
    deps = [
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component-test",
        "//src/sys/lib/component-events",
        "//third_party/rust_crates/vendor:anyhow",
    ],
)

fx_packaged_binary(
    name = "bin_packaged",
    testonly = True,
    binary = ":bin",
    binary_name = "fidl_examples_integration",
)

fx_component_manifest(
    name = "fidl_examples_test_manifest",
    testonly = True,
    component_name = "fidl_examples_test",
    includes = [
        "//sdk/lib/inspect:client.shard",
        "//sdk/lib/sys/component:realm_builder.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/integration_tests.cml",
)

fx_test_component(
    name = "fidl_examples_test",
    compiled_manifest = ":fidl_examples_test_manifest",
    deps = [":bin_packaged"],
)

test_suite(
    name = "hermetic_tests",
    tests = [
        ":echo-cpp-async-test",
        ":echo-cpp-client-sync-test",
        ":echo-cpp-client-test",
        ":echo-cpp-wire-client-shared-test",
        ":echo-cpp-wire-client-sync-test",
        ":echo-cpp-wire-client-test",
        ":echo-launcher-cpp-wire-test",
        ":echo-launcher-rust-next-test",
        ":echo-launcher-rust-test",
        ":echo-rust-client-sync-test",
        ":echo-rust-client-test",
        ":echo-rust-next-client-test",
        ":echo-service-cpp-wire-test",
        ":echo-service-rust-next-test",
        ":echo-service-rust-test",
    ],
    visibility = ["//examples/fidl:__subpackages__"],
)

# C++ natural example integration test packages
fx_package(
    name = "echo-cpp-client-test_package",
    package_name = "echo-cpp-client-test",
    components = [
        ":echo_realm",
        "//examples/fidl/cpp/client:echo-client",
        "//examples/fidl/cpp/server:echo-server",
        "//src/lib/fuchsia-component-test/realm_builder_server:realm_builder_server_component",
    ],
    test_components = [":fidl_examples_test"],
)

fx_test(
    name = "echo-cpp-client-test",
    package = ":echo-cpp-client-test_package",
    visibility = ["//examples/fidl:__subpackages__"],
)

