import("//build/bazel/bazel_test_suite.gni")

if (is_fuchsia) {
  group("fidl") {
    testonly = true
    deps = [ ":tests" ]
  }

  group("tests") {
    testonly = true
    deps = [
      ":bazel_target_tests",
      ":hermetic_tests",
    ]
  }

  group("hermetic_tests") {
    testonly = true
    deps = [ ":bazel_target_tests" ]
  }

  # The Bazel device tests, from the //examples/fidl:target_tests Bazel
  # test_suite().
  bazel_test_suite("bazel_target_tests") {
    target_tests = [ "//examples/fidl:target_tests" ]
  }
}

if (is_host) {
  # The Bazel host tests, from the //examples/fidl:host_tests Bazel
  # test_suite().
  bazel_test_suite("host_tests") {
    host_tests = [ "//examples/fidl:host_tests" ]
  }
}
