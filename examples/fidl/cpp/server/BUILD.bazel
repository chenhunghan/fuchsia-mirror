# [START imports]
load("//build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)

# [END imports]

package(default_applicable_licenses = ["//:license"])

# [START bin]
fx_cc_binary(
    name = "bin",
    srcs = ["main.cc"],
    gn_output_name = "fidl_echo_cpp_server",
    tags = ["manual"],
    deps = [
        "//examples/fidl/fuchsia.examples:fuchsia.examples_cpp",

        # This library provides an asynchronous event loop implementation.
        "//sdk/lib/async-loop:async-loop-cpp",

        # This library is used to publish capabilities, e.g. protocols,
        # to the component's outgoing directory.
        "//sdk/lib/component/outgoing/cpp",

        # This library is used to log messages.
        "//sdk/lib/syslog/cpp",
    ],
)

# [END bin]

fx_packaged_binary(
    name = "bin_packaged",
    binary = ":bin",
    binary_name = "fidl_echo_cpp_server",
)

# [START component]
fx_component_manifest(
    name = "echo-server_manifest",
    component_name = "echo_server",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/server.cml",
)

fx_component(
    name = "echo-server",
    compiled_manifest = ":echo-server_manifest",
    visibility = [
        "//examples/fidl:__subpackages__",
        "//sdk/ctf/tests/examples/fidl/fuchsia.examples/testing/realm-factory:__pkg__",
    ],
    deps = [":bin_packaged"],
)

# [END component]

# [START package]
# @bazel2gn:skip
fx_package(
    name = "echo-cpp-server",
    components = [":echo-server"],
    visibility = ["//examples/fidl/cpp:__pkg__"],
)
# [END package]
