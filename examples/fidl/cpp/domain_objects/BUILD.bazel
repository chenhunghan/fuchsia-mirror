load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load(
    "//build/bazel/rules/testing:fx_unittest_package.bzl",
    "fx_unittest_package",
)

package(default_applicable_licenses = ["//:license"])

# [START test]
fx_cc_test_binary(
    name = "test",
    srcs = [
        "advanced.cc",
        "main.cc",
    ],
    gn_output_name = "fidl_examples_domain_objects_cpp_test",
    tags = ["manual"],
    deps = [
        # [START binding-dep]
        "//examples/fidl/fuchsia.examples:fuchsia.examples_cpp",

        # [END binding-dep]
        "//src/lib/fxl/test:gtest_main",
        "@com_google_googletest//:gtest",
    ],
)

# [END test]

# [START package]
fx_unittest_package(
    name = "fidl-examples-domain-objects-cpp-test",
    unit_tests = [":test"],
    visibility = ["//examples/fidl/cpp:__pkg__"],
)
# [END package]
