import("//build/tools/bazel2gn/bazel_migration.gni")

if (is_fuchsia) {
  rustc_binary("bin") {
    sources = [
      "src/main.rs",
      "src/program.rs",
    ]
    output_name = "colocated_runner"
    edition = "2024"
    proc_macro_deps = [ "//third_party/rust_crates:async-trait" ]
    deps = [
      "//examples/components/runner/colocated/fidl:colocated_rust",
      "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
      "//sdk/fidl/fuchsia.component.runner:fuchsia.component.runner_rust",
      "//sdk/fidl/fuchsia.memory.attribution:fuchsia.memory.attribution_rust",
      "//sdk/fidl/fuchsia.process:fuchsia.process_rust",
      "//sdk/rust/zx",
      "//src/lib/fidl/rust/fidl",
      "//src/lib/fuchsia",
      "//src/lib/fuchsia-async",
      "//src/lib/fuchsia-component",
      "//src/lib/fuchsia-runtime",
      "//src/lib/fuchsia-sync",
      "//src/performance/memory/attribution/server",
      "//src/sys/lib/runner",
      "//third_party/rust_crates:anyhow",
      "//third_party/rust_crates:async-lock",
      "//third_party/rust_crates:futures",
      "//third_party/rust_crates:log",
      "//third_party/rust_crates:scopeguard",
    ]
  }
}
if (is_fuchsia) {
  rustc_test("bin_test") {
    sources = [
      "src/main.rs",
      "src/program.rs",
    ]
    edition = "2024"
    proc_macro_deps = [ "//third_party/rust_crates:async-trait" ]
    deps = [
             "//examples/components/runner/colocated/fidl:colocated_rust",
             "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
             "//sdk/fidl/fuchsia.component.runner:fuchsia.component.runner_rust",
             "//sdk/fidl/fuchsia.memory.attribution:fuchsia.memory.attribution_rust",
             "//sdk/fidl/fuchsia.process:fuchsia.process_rust",
             "//sdk/rust/zx",
             "//src/lib/fidl/rust/fidl",
             "//src/lib/fuchsia",
             "//src/lib/fuchsia-async",
             "//src/lib/fuchsia-component",
             "//src/lib/fuchsia-runtime",
             "//src/lib/fuchsia-sync",
             "//src/performance/memory/attribution/server",
             "//src/sys/lib/runner",
             "//third_party/rust_crates:anyhow",
             "//third_party/rust_crates:async-lock",
             "//third_party/rust_crates:futures",
             "//third_party/rust_crates:log",
             "//third_party/rust_crates:scopeguard",
           ] +
           [
             "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust",
             "//src/lib/fuchsia-fs",
           ]
    source_root = "src/main.rs"
    output_name = "colocated_runner_bin_test"
  }
}

fuchsia_component_manifest("colocated-runner_manifest") {
  component_name = "colocated-runner"
  manifest = "meta/colocated-runner.cml"
}

fuchsia_component("colocated-runner") {
  cm_label = ":colocated-runner_manifest"
  visibility = [ "//*" ]
  deps = [ ":bin" ]
}

fuchsia_component_manifest("colocated-runner-example-realm_manifest") {
  component_name = "colocated-runner-example"
  manifest = "meta/colocated-runner-example.cml"
}

fuchsia_component("colocated-runner-example-realm") {
  cm_label = ":colocated-runner-example-realm_manifest"
  visibility = [ "//*" ]
}

fuchsia_component_manifest("colocated-component_manifest") {
  component_name = "colocated-component"
  manifest = "meta/colocated-component.cml"
}

fuchsia_component("colocated-component") {
  cm_label = ":colocated-component_manifest"
  visibility = [ "//*" ]
}

fuchsia_unittest_component("colocated-runner-unittests-component") {
  deps = [ ":bin_test" ]
  component_name = "colocated-runner-unittests"
}

fuchsia_test_package("colocated-runner-unittests-package") {
  package_name = "colocated-runner-unittests-gn"
  test_components = [ ":colocated-runner-unittests-component" ]
  deps = [ ":colocated-component" ]
}
