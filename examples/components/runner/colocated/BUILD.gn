assert(is_fuchsia, "These targets are only compiled in the fuchsia toolchain.")

import("//build/bazel/bazel_fuchsia_package.gni")

group("colocated") {
  testonly = true

  deps = [
    ":colocated-runner",
    ":colocated-runner-example",
  ]
}

# group("colocated") still exposes this package in GN.
bazel_fuchsia_package("colocated-runner-example") {
  bazel_config = "fuchsia_platform"
  package_name = "colocated-runner-example"
}

group("hermetic_tests") {
  testonly = true
  deps = [
    ":colocated-runner-unittests-package",
    "integration_tests",
  ]
}

