{
    include: [ "syslog/client.shard.cml" ],
    program: {
        runner: "elf",
        binary: "bin/reverser_bin",
    },
    capabilities: [
        { protocol: "fuchsia.examples.reverser.Reverser" },
    ],
    use: [
        {
            protocol: "fuchsia.examples.reverser.Replacer",
            availability: "optional",
        },
        {
            config: "fuchsia.examples.reverser.SwitchCase",
            key: "switch_case",
            type: "bool",
            availability: "transitional",
            default: false,
        },
        {
            config: "fuchsia.examples.reverser.UseReplacer",
            key: "use_replacer",
            type: "bool",
            availability: "transitional",
            default: false,
        },
    ],
    expose: [
        {
            protocol: "fuchsia.examples.reverser.Reverser",
            from: "self",
        },
    ],
}
