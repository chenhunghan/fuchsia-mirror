load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/components:structured_config.bzl",
    "fuchsia_structured_config_rust_lib",
)
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load(
    "//build/bazel/rules/rust:rustc_binary.bzl",
    "rustc_binary",
)

package(default_applicable_licenses = ["//:license"])

fx_component_manifest(
    name = "reverser_manifest",
    component_name = "reverser",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/reverser.cml",
)

fuchsia_structured_config_rust_lib(
    name = "reverser_config",
    cm_label = ":reverser_manifest",
)

rustc_binary(
    name = "bin",
    srcs = ["src/main.rs"],
    binary_name = "reverser_bin",
    edition = "2024",
    tags = ["manual"],
    deps = [
        ":reverser_config",
        "//examples/components/reverser/fidl:fuchsia.examples.reverser_rust",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
    ],
)

fx_packaged_binary(
    name = "reverser_bin",
    binary = ":bin",
    binary_name = "reverser_bin",
)

fx_component(
    name = "reverser_component",
    compiled_manifest = ":reverser_manifest",
    visibility = ["//examples/components/reverser/tests:__pkg__"],
    deps = [":reverser_bin"],
)
