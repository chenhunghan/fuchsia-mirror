{
    include: [
        "inspect/client.shard.cml",
        "syslog/client.shard.cml",
    ],
    program: {
        runner: "elf",
        binary: "bin/config_example_rust",
    },

    // [START config]
    use: [
        // The greeting to log.
        {
            config: "fuchsia.example.config.Greeting",
            key: "greeting",
            type: "string",
            max_size: 512,
            availability: "transitional",
            default: "World",
        },

        // Delay in milliseconds before logging greeting.
        {
            config: "fuchsia.example.config.DelayMs",
            key: "delay_ms",
            type: "uint64",
            availability: "transitional",
            default: 100,
        },
    ],

    // [END config]
}
