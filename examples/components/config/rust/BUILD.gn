import("//build/components.gni")
import("//build/rust/rustc_binary.gni")

# [START binary]
rustc_binary("bin") {
  edition = "2024"

  # [START_EXCLUDE]
  output_name = "config_example_rust"
  sources = [ "src/main.rs" ]

  # [END_EXCLUDE]
  deps = [
    ":example_config",

    # [START_EXCLUDE]
    "//src/lib/diagnostics/inspect/runtime/rust",
    "//src/lib/diagnostics/inspect/rust",
    "//src/lib/fuchsia",
    "//third_party/rust_crates:log",

    # [END_EXCLUDE]
  ]
}

# [END binary]

# [START component]
fuchsia_component_manifest("manifest") {
  component_name = "config_example"
  manifest = "meta/config_example.cml"
}

fuchsia_component("component") {
  cm_label = ":manifest"
  deps = [ ":bin" ]
}

# [END component]

# [START library]
fuchsia_structured_config_rust_lib("example_config") {
  cm_label = ":manifest"
}

# [END library]

# [START package]
fuchsia_package("rust_config_example") {
  deps = [ ":component" ]
}

# [END package]

group("rust") {
  deps = [ ":rust_config_example" ]
}
