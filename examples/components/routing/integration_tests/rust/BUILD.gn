assert(is_fuchsia, "These targets are only compiled in the fuchsia toolchain.")

import("//build/bazel/bazel_fuchsia_test_package.gni")

# Wrapped for GN consumers in //examples/components/routing.
# LINT.IfChange
bazel_fuchsia_test_package("echo_integration_test_rust") {
  bazel_config = "fuchsia_platform"
  test_component_names = [ "echo_integration_test" ]
}

# Wrapped for GN consumers in //examples/components/routing/with_subpackages
# and //src/sys/test_manager/tests.
bazel_fuchsia_test_package("subpackaged_echo_integration_test_rust") {
  bazel_config = "fuchsia_platform"
  test_component_names = [ "default" ]
}

# LINT.ThenChange(BUILD.bazel)

group("hermetic_tests") {
  testonly = true
  deps = [
    ":echo_integration_test_rust",
    ":subpackaged_echo_integration_test_rust",
  ]
}
