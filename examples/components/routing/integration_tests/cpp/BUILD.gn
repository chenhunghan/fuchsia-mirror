assert(is_fuchsia, "These targets are only compiled in the fuchsia toolchain.")

import("//build/bazel/bazel_fuchsia_test_package.gni")

# LINT.IfChange(echo_integration_test_cpp)
bazel_fuchsia_test_package("echo_integration_test_cpp") {
  bazel_config = "fuchsia_platform"
  test_component_names = [ "echo_integration_test" ]
}

# LINT.ThenChange(BUILD.bazel:echo_integration_test_cpp)

# LINT.IfChange(subpackaged_echo_integration_test_cpp)
bazel_fuchsia_test_package("subpackaged_echo_integration_test_cpp") {
  bazel_config = "fuchsia_platform"
  test_component_names = [ "default" ]
}

# LINT.ThenChange(BUILD.bazel:subpackaged_echo_integration_test_cpp)

group("hermetic_tests") {
  testonly = true
  deps = [
    ":echo_integration_test_cpp",
    ":subpackaged_echo_integration_test_cpp",
  ]
}
