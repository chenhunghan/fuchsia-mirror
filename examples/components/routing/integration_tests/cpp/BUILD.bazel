# [START imports]
load("//build/bazel/rules/cc:fx_cc_test_binary.bzl", "fx_cc_test_binary")
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

# [END imports]

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [
        ":echo_integration_test_cpp_test",
        ":subpackaged_echo_integration_test_cpp_test",
    ],
    visibility = ["//examples:__pkg__"],
)

# LINT.IfChange(echo_integration_test_cpp)
# [START example_snippet]
# [START executable]
fx_cc_test_binary(
    name = "bin",
    srcs = ["echo_integration_test.cc"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//examples/components/routing/fidl:echo_hlcpp",
        "//sdk/lib/async-loop:async-loop-cpp",
        "//sdk/lib/async-loop:async-loop-default",
        "//sdk/lib/sys/cpp",
        "//sdk/lib/sys/cpp/testing:cpp",
        "//src/lib/fxl/test:gtest_main",
        "@com_google_googletest//:gtest",
    ],
)

# [END executable]

# [START component]
fx_packaged_binary(
    name = "bin_packaged",
    testonly = True,
    binary = ":bin",
    binary_name = "echo_integration_test_cpp",
)

fx_component_manifest(
    name = "echo_integration_test_manifest",
    testonly = True,
    component_name = "echo_integration_test",
    includes = [
        "//sdk/lib/inspect:offer.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/gtest:default.shard.cml",
    ],
    manifest = "meta/echo_integration_test.cml",
)

fx_test_component(
    name = "echo_integration_test_component",
    compiled_manifest = ":echo_integration_test_manifest",
    deps = [":bin_packaged"],
)

# [END component]

# [START test_package]
fx_package(
    name = "echo_integration_test_cpp",
    testonly = True,
    components = ["//examples/components/routing/cpp/echo_server:echo_server_cmp"],
    test_components = [":echo_integration_test_component"],
)

fx_test(
    name = "echo_integration_test_cpp_test",
    package = ":echo_integration_test_cpp",
)

# [END test_package]
# [END example_snippet]
# LINT.ThenChange(BUILD.gn:echo_integration_test_cpp)

# LINT.IfChange(subpackaged_echo_integration_test_cpp)
fx_component_manifest(
    name = "subpackaged_echo_integration_test_cpp_manifest",
    testonly = True,
    component_name = "default",
    includes = [
        "//sdk/lib/inspect:offer.shard",
        "//sdk/lib/syslog:client.shard",
        "//src/sys/test_runners/gtest:default.shard.cml",
    ],
    manifest = "meta/subpackaged_echo_integration_test.cml",
)

fx_test_component(
    name = "subpackaged_echo_integration_test_cpp_component",
    compiled_manifest = ":subpackaged_echo_integration_test_cpp_manifest",
    deps = [":bin_packaged"],
)

fx_package(
    name = "subpackaged_echo_integration_test_cpp",
    testonly = True,
    subpackages = ["//examples/components/routing/cpp/echo_server"],
    test_components = [":subpackaged_echo_integration_test_cpp_component"],
)
# LINT.ThenChange(BUILD.gn:subpackaged_echo_integration_test_cpp)

fx_test(
    name = "subpackaged_echo_integration_test_cpp_test",
    package = ":subpackaged_echo_integration_test_cpp",
)
