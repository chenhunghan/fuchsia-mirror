load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "bin",
    srcs = ["src/main.rs"],
    binary_name = "echo_client_rust",
    edition = "2024",
    tags = ["manual"],
    visibility = [
        "//examples/components/realm_builder:__pkg__",
        "//examples/components/subpackages:__pkg__",
    ],
    deps = [
        "//examples/components/routing/fidl:echo_rust",
        "//src/lib/fuchsia",
        "//src/lib/fuchsia-component",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:log",
    ],
)

fx_packaged_binary(
    name = "bin_packaged",
    binary = ":bin",
    binary_name = "echo_client_rust",
)

fx_component_manifest(
    name = "echo_client_cmp_manifest",
    component_name = "echo_client",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/echo_client.cml",
)

# Unpackaged component "#meta/echo_client.cm"
fx_component(
    name = "echo_client_cmp",
    compiled_manifest = ":echo_client_cmp_manifest",
    visibility = [
        "//examples/components/routing:__pkg__",
        "//examples/diagnostics/inspect/rust:__pkg__",
    ],
    deps = [":bin_packaged"],
)

fx_component_manifest(
    name = "echo_client_manifest",
    component_name = "default",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/echo_client.cml",
)

fx_component(
    name = "echo_client_component",
    compiled_manifest = ":echo_client_manifest",
    deps = [":bin_packaged"],
)

# Subpackaged component "echo_client#meta/default.cm"
fx_package(
    name = "echo_client",
    components = [":echo_client_component"],
)
