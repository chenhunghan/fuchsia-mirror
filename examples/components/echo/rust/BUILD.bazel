# [START imports]
load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component",
    "fx_component_manifest",
)
load(
    "//build/bazel/rules/packages:fx_packaged_binary.bzl",
    "fx_packaged_binary",
)
load("//build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")
load("//build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load(
    "//build/bazel/rules/testing:fx_unittest_package.bzl",
    "fx_unittest_package",
)
# [END imports]

package(default_applicable_licenses = ["//:license"])

test_suite(
    name = "tests",
    tests = [":echo-rust-unittests"],
    visibility = ["//examples:__pkg__"],
)

# [START executable]
# Generates a GN target for unit-tests with the label `bin_test`,
# and a binary named `echo_bin_test`.
rustc_binary(
    name = "bin",
    srcs = ["src/main.rs"],
    binary_name = "echo_example_rust",
    edition = "2024",
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:log",
    ],
)
# [END executable]

# [START component]
fx_packaged_binary(
    name = "bin_packaged",
    binary = ":bin",
    binary_name = "echo_example_rust",
)

fx_component_manifest(
    name = "manifest",
    component_name = "echo_rust",
    includes = ["//sdk/lib/syslog:client.shard"],
    manifest = "meta/echo.cml",
)

fx_component(
    name = "component",
    compiled_manifest = ":manifest",
    visibility = ["//examples/components/echo:__pkg__"],
    deps = [":bin_packaged"],
)
# [END component]

# [START unittest]
rustc_test(
    name = "echo_bin_test",
    crate = ":bin",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:fuchsia"],
)

fx_unittest_package(
    name = "echo-rust-unittests",
    unit_tests = [":echo_bin_test"],
)
# [END unittest]
