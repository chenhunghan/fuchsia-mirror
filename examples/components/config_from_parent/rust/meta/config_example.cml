{
    include: [
        "inspect/client.shard.cml",
        "syslog/client.shard.cml",
    ],
    program: {
        runner: "elf",
        binary: "bin/config_from_parent_example_rust",
    },
    capabilities: [
        { protocol: "fuchsia.component.Binder" },
    ],

    // [START config]
    use: [
        // The greeting to log.
        {
            config: "fuchsia.example.config.Greeting",
            key: "greeting",
            type: "string",
            max_size: 512,
            availability: "transitional",
            default: "World",
        },
    ],

    // [END config]
    expose: [
        {
            protocol: "fuchsia.component.Binder",
            from: "self",
        },
    ],
}
