{
    include: [
        "//src/sys/test_runners/gtest/default.shard.cml",
        "sys/component/realm_builder.shard.cml",
        "syslog/client.shard.cml",
    ],
    program: {
        binary: "bin/config_from_parent_integration_test_cpp",
    },
    collections: [
        {
            name: "realm_api_collection",
            durability: "transient",
            allowed_offers: "static_and_dynamic",
        },
    ],
    capabilities: [
        // Non-default greeting offered dynamically to verify parent overrides.
        {
            config: "fuchsia.example.config.Greeting",
            type: "string",
            max_size: 512,
            value: "parent component",
        },
    ],
    use: [
        { protocol: "fuchsia.diagnostics.ArchiveAccessor" },
        {
            protocol: "fuchsia.component.Realm",
            from: "framework",
        },
    ],
    offer: [
        {
            dictionary: "diagnostics",
            from: "parent",
            to: "#realm_api_collection",
        },
    ],
}
