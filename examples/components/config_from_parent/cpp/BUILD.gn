import("//build/bazel/bazel_fuchsia_package.gni")

bazel_fuchsia_package("cpp_config_from_parent_example") {
  bazel_config = "fuchsia_platform"
}

# //examples/components/config_from_parent still references :cpp from GN.
group("cpp") {
  deps = [ ":cpp_config_from_parent_example" ]
}

