import("//build/tools/bazel2gn/bazel_migration.gni")

executable("bin") {
  sources = [ "main.cc" ]
  output_name = "config_from_parent_example_cpp"
  deps = [
    ":example_config",
    "//sdk/lib/async-loop:async-loop-cpp",
    "//sdk/lib/async-loop:async-loop-default",
    "//sdk/lib/inspect/component/cpp",
    "//sdk/lib/sys/cpp",
    "//sdk/lib/syslog/cpp",
  ]
}

fuchsia_component_manifest("manifest") {
  component_name = "config_example"
  manifest = "meta/config_example.cml"
}

fuchsia_component("component") {
  cm_label = ":manifest"
  visibility = [
    ":*",
    "//examples/components/config_from_parent/integration_test:*",
  ]
  deps = [ ":bin" ]
}

fuchsia_structured_config_cpp_elf_lib("example_config") {
  cm_label = ":manifest"
}
