assert(is_fuchsia, "These targets are only compiled in the fuchsia toolchain.")

import("//build/components.gni")

# TODO(https://fxbug.dev/570694755): Migrate group and fuchsia_package targets once //examples/components is migrated.
group("storage") {
  testonly = true
  deps = [
    ":hermetic_tests",
    ":package",
  ]
}

group("hermetic_tests") {
  testonly = true
  deps = [ ":unittest_package" ]
}

fuchsia_package("package") {
  package_name = "storage_example"
  deps = [ ":component" ]
}

