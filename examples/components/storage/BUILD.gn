rustc_binary("bin") {
  sources = [ "src/main.rs" ]
  output_name = "storage_example"
  edition = "2024"
  deps = [
    "//src/lib/diagnostics/inspect/runtime/rust",
    "//src/lib/diagnostics/inspect/rust",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:byteorder",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
}

fuchsia_component_manifest("component_manifest") {
  component_name = "storage_example"
  manifest = "meta/storage_example.cml"
}

fuchsia_component("component") {
  cm_label = ":component_manifest"
  deps = [ ":bin" ]
}
if (is_fuchsia) {
  rustc_test("bin_test") {
    sources = [ "src/main.rs" ]
    edition = "2024"
    deps = [
             "//src/lib/diagnostics/inspect/runtime/rust",
             "//src/lib/diagnostics/inspect/rust",
             "//src/lib/fuchsia",
             "//src/lib/fuchsia-component",
             "//third_party/rust_crates:anyhow",
             "//third_party/rust_crates:byteorder",
             "//third_party/rust_crates:futures",
             "//third_party/rust_crates:log",
           ] + [
             "//src/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
             "//third_party/rust_crates:tempfile",
             "//third_party/rust_crates:test-case",
           ]
    source_root = "src/main.rs"
    output_name = "storage_example_bin_test"
  }
}

fuchsia_component_manifest("unittest_component_manifest") {
  testonly = true
  component_name = "storage_example_unittests"
  manifest = "meta/storage_example_unittests.cml"
}

fuchsia_test_component("unittest_component") {
  cm_label = ":unittest_component_manifest"
  deps = [ ":bin_test" ]
}

fuchsia_test_package("unittest_package") {
  package_name = "storage_example_unittests-gn"
  test_components = [ ":unittest_component" ]
}
